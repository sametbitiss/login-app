<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim & İmalat Analitiği Dashboard — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>

      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link active">📊 Üretim Analitiği</a>
      </div>

      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>

      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
      </div>

      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a>
      </div>
    </header>

    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Üretim ve İmalat Yönetimi Dashboard</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Açık iş emirleri, fabrika istasyon yükleri ve MRP ihtiyaç özetleri.</p>
        </div>
        <a href="/production/orders/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni İş Emri Başlat
        </a>
      </div>

      <!-- KPI Strip -->
      <div class="kpi-strip">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">📋</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Toplam İş Emri</span>
            <span class="kpi-chip-value"><%= stats.totalOrders %></span>
          </div>
        </div>

        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">⏳</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Planlanan İşler</span>
            <span class="kpi-chip-value"><%= stats.plannedOrders %></span>
          </div>
        </div>

        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--cyan">⚙️</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Üretimde Olanlar</span>
            <span class="kpi-chip-value"><%= stats.inProductionOrders %></span>
          </div>
        </div>

        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">✅</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Tamamlanan İşler</span>
            <span class="kpi-chip-value"><%= stats.completedOrders %></span>
          </div>
        </div>
      </div>

      <!-- Charts Section -->
      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 32px;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow-md);">
          <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin-bottom: 16px;">🏭 İş İstasyonları Doluluk ve Yük Oranları (%)</h3>
          <canvas id="capacityChart" height="130"></canvas>
        </div>

        <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow-md);">
          <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary); margin-bottom: 16px;">📊 İş Emri Durum Dağılımı</h3>
          <canvas id="statusChart" height="200"></canvas>
        </div>
      </div>

      <!-- MRP Critical Alerts Preview & Active Orders -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <!-- MRP Net Requirements Preview -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow-md);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--rose);">🚨 MRP Eksik Malzeme İhtiyaçları</h3>
            <a href="/production/mrp" style="color: var(--indigo); font-size: 0.85rem; font-weight: 600;">Tüm MRP Raporu →</a>
          </div>
          <% if (mrpResults.length === 0) { %>
            <div style="color: var(--text-muted); font-size: 0.9rem; text-align: center; padding: 2rem;">Tüm malzemeler ve hammadde stokları yeterli! ⚡</div>
          <% } else { %>
            <table class="data-table" style="font-size: 0.85rem;">
              <thead>
                <tr>
                  <th>Malzeme Kodu</th>
                  <th>Hammadde Adı</th>
                  <th>Gereksinim</th>
                  <th>Mevcut Stok</th>
                  <th>Net İhtiyaç</th>
                </tr>
              </thead>
              <tbody>
                <% mrpResults.forEach(item => { %>
                  <tr>
                    <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= item.stockCode %></strong></td>
                    <td><%= item.name %></td>
                    <td><%= item.grossRequirement %> <%= item.unit %></td>
                    <td><%= item.currentStock %> <%= item.unit %></td>
                    <td><strong style="color: var(--rose);">+<%= item.netRequirement %> <%= item.unit %></strong></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </div>

        <!-- Recent Work Orders -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow-md);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary);">⚡ Son İş Emirleri</h3>
            <a href="/production/orders" style="color: var(--indigo); font-size: 0.85rem; font-weight: 600;">Tüm İş Emirleri →</a>
          </div>
          <table class="data-table" style="font-size: 0.85rem;">
            <thead>
              <tr>
                <th>İş Emri No</th>
                <th>Üretim Başlığı</th>
                <th>Miktar</th>
                <th>İstasyon</th>
                <th>Durum</th>
              </tr>
            </thead>
            <tbody>
              <% orders.slice(0, 5).forEach(o => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= o.workOrderNo %></strong></td>
                  <td><%= o.productionTitle %></td>
                  <td><strong><%= o.plannedQuantity %> <%= o.unit %></strong></td>
                  <td style="font-size: 0.75rem; color: var(--text-muted);"><%= (o.workCenter && typeof o.workCenter === 'string') ? o.workCenter.split(' ')[0] : (o.workCenter || 'İstasyon') %></td>
                  <td>
                    <% if (o.status === 'Completed') { %>
                      <span class="status-pill status-active">● Tamamlandı</span>
                    <% } else if (o.status === 'In_Production') { %>
                      <span class="status-pill status-pending">● Üretimde</span>
                    <% } else { %>
                      <span class="status-pill status-approved">● <%= o.status %></span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    // Chart 1: Capacity Load Chart
    const capacityData = <%- JSON.stringify(capacityReport) %>;
    new Chart(document.getElementById('capacityChart'), {
      type: 'bar',
      data: {
        labels: capacityData.map(c => (c.workCenterName && typeof c.workCenterName === 'string') ? c.workCenterName.split(' ')[0] : (c.workCenterName || 'İstasyon')),
        datasets: [{
          label: 'Kapasite Yük Oranı (%)',
          data: capacityData.map(c => c.loadPercentage),
          backgroundColor: capacityData.map(c => c.isBottleneck ? '#f43f5e' : '#6366f1'),
          borderRadius: 8
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, max: 100 } }
      }
    });

    // Chart 2: Status Doughnut
    new Chart(document.getElementById('statusChart'), {
      type: 'doughnut',
      data: {
        labels: ['Planlanan', 'Üretimde', 'Tamamlanan'],
        datasets: [{
          data: [<%= stats.plannedOrders %>, <%= stats.inProductionOrders %>, <%= stats.completedOrders %>],
          backgroundColor: ['#f59e0b', '#06b6d4', '#10b981']
        }]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'bottom' } }
      }
    });
  </script>
</body>
</html>
