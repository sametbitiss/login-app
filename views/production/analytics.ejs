<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim & İmalat Analitiği Dashboard — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/sidebar.js" defer></script>
  <style>
    .analytics-kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .analytics-kpi-card {
      background: rgba(30, 41, 59, 0.45);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 16px;
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .analytics-kpi-card:hover {
      transform: translateY(-2px);
      border-color: rgba(99, 102, 241, 0.35);
    }
    .analytics-kpi-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      flex-shrink: 0;
    }
    .analytics-kpi-label {
      font-size: 0.76rem;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 2px;
    }
    .analytics-kpi-val {
      font-size: 1.45rem;
      font-weight: 900;
      color: #f8fafc;
      font-family: 'JetBrains Mono', monospace;
    }

    .analytics-grid-two {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }
    @media (max-width: 1024px) {
      .analytics-grid-two { grid-template-columns: 1fr; }
    }

    .analytics-card {
      background: rgba(15, 23, 42, 0.8);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 22px 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(16px);
    }
    .analytics-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }
    .analytics-card-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #f8fafc;
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 0;
    }

    .analytics-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.86rem;
    }
    .analytics-table th {
      background: rgba(30, 41, 59, 0.85);
      color: #94a3b8;
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 12px 14px;
      border-bottom: 1.5px solid rgba(255, 255, 255, 0.08);
    }
    .analytics-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      vertical-align: middle;
      color: #cbd5e1;
    }
    .analytics-table tr:last-child td { border-bottom: none; }
    .analytics-table tr:hover td { background: rgba(99, 102, 241, 0.04); }
  </style>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>

      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link active">📊 Üretim Analitiği</a>
      </div>

      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a>
      </div>
    </header>

    <main class="module-content">

      <!-- Page Header -->
      <div class="page-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 20px;">
        <div>
          <div style="font-size: 0.82rem; color: #818cf8; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px;">
            📊 FABRİKA YÖNETİMİ & VERİMLİLİK METRİKLERİ
          </div>
          <h1 style="margin: 0;">Üretim ve İmalat Yönetimi Dashboard</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            Açık iş emirleri, iş istasyonu kapasite dolulukları, MRP eksik hammadde alarmları ve saha ilerleme grafikleri.
          </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <a href="/production/mes" class="btn" style="background: rgba(99, 102, 241, 0.18); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.4); font-weight: 800; border-radius: 12px; display: inline-flex; align-items: center; gap: 8px;">
            <span>📱 MES Saha Terminali</span>
          </a>
          <a href="/production/mrp" class="btn" style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; font-weight: 800; border-radius: 12px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);">
            <span>⚡ MRP Motorunu Çalıştır</span>
          </a>
        </div>
      </div>

      <!-- KPI Strip -->
      <div class="analytics-kpi-grid">
        <div class="analytics-kpi-card">
          <div class="analytics-kpi-icon" style="background: rgba(99, 102, 241, 0.2); color: #818cf8;">📋</div>
          <div>
            <div class="analytics-kpi-label">Toplam İş Emri</div>
            <div class="analytics-kpi-val"><%= stats.totalOrders %> <span style="font-size: 0.85rem; color: #94a3b8;">Kayıt</span></div>
          </div>
        </div>

        <div class="analytics-kpi-card">
          <div class="analytics-kpi-icon" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc;">⏳</div>
          <div>
            <div class="analytics-kpi-label">Planlanan / Onaylı</div>
            <div class="analytics-kpi-val" style="color: #a5b4fc;"><%= stats.plannedOrders %> <span style="font-size: 0.85rem; color: #94a3b8;">Emir</span></div>
          </div>
        </div>

        <div class="analytics-kpi-card">
          <div class="analytics-kpi-icon" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24;">⚡</div>
          <div>
            <div class="analytics-kpi-label">Aktif İmalatta</div>
            <div class="analytics-kpi-val" style="color: #fbbf24;"><%= stats.inProductionOrders %> <span style="font-size: 0.85rem; color: #94a3b8;">İş</span></div>
          </div>
        </div>

        <div class="analytics-kpi-card">
          <div class="analytics-kpi-icon" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">✅</div>
          <div>
            <div class="analytics-kpi-label">Tamamlanan İşler</div>
            <div class="analytics-kpi-val" style="color: #34d399;"><%= stats.completedOrders %> <span style="font-size: 0.85rem; color: #94a3b8;">Emir</span></div>
          </div>
        </div>

        <div class="analytics-kpi-card">
          <div class="analytics-kpi-icon" style="background: rgba(244, 63, 94, 0.18); color: #fb7185;">🚨</div>
          <div>
            <div class="analytics-kpi-label">MRP Eksik Kalem</div>
            <div class="analytics-kpi-val" style="color: #fb7185;"><%= mrpResults.length %> <span style="font-size: 0.85rem; color: #94a3b8;">Malzeme</span></div>
          </div>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="analytics-grid-two">
        <!-- Station Capacity Load Bar Chart -->
        <div class="analytics-card">
          <div class="analytics-card-header">
            <h3 class="analytics-card-title">
              <span>🏭</span>
              <span>İş İstasyonları Kapasite Doluluk ve Yük Oranları (%)</span>
            </h3>
            <a href="/production/capacity" style="color: #818cf8; font-size: 0.82rem; font-weight: 700; text-decoration: none;">
              Kapasite Detayı ➔
            </a>
          </div>
          <div style="height: 220px; position: relative;">
            <canvas id="capacityChart"></canvas>
          </div>
        </div>

        <!-- Order Status Doughnut Chart -->
        <div class="analytics-card">
          <div class="analytics-card-header">
            <h3 class="analytics-card-title">
              <span>📊</span>
              <span>İş Emri Durum Dağılımı</span>
            </h3>
            <a href="/production/orders" style="color: #818cf8; font-size: 0.82rem; font-weight: 700; text-decoration: none;">
              İş Emirleri ➔
            </a>
          </div>
          <div style="height: 220px; position: relative;">
            <canvas id="statusChart"></canvas>
          </div>
        </div>
      </div>

      <!-- MRP Critical Alerts Preview & Active Orders Section -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        
        <!-- 1. MRP Net Requirements Preview -->
        <div class="analytics-card">
          <div class="analytics-card-header">
            <h3 class="analytics-card-title" style="color: #fb7185;">
              <span>🚨</span>
              <span>MRP Eksik Malzeme İhtiyaçları</span>
            </h3>
            <a href="/production/mrp" style="color: #818cf8; font-size: 0.84rem; font-weight: 700; text-decoration: none;">
              Tüm MRP Raporu ➔
            </a>
          </div>

          <% if (mrpResults.length === 0) { %>
            <div style="background: rgba(16, 185, 129, 0.08); border: 1px dashed rgba(16, 185, 129, 0.3); border-radius: 12px; padding: 2.5rem 1.5rem; text-align: center;">
              <div style="font-size: 2rem; margin-bottom: 6px;">🎉</div>
              <strong style="color: #34d399; font-size: 0.98rem; display: block;">Tüm Malzeme ve Hammaddeler Yeterli!</strong>
              <p style="color: #94a3b8; font-size: 0.82rem; margin: 4px 0 0 0;">
                Aktif üretim emirlerinin reçetelerinde eksik veya kritik stok uyarısı veren malzeme bulunmamaktadır.
              </p>
            </div>
          <% } else { %>
            <table class="analytics-table">
              <thead>
                <tr>
                  <th>Malzeme Kodu</th>
                  <th>Hammadde / Bileşen</th>
                  <th style="text-align: right;">Gereksinim</th>
                  <th style="text-align: right;">Mevcut Stok</th>
                  <th style="text-align: right;">Net Eksik</th>
                  <th style="text-align: center;">Tedarik</th>
                </tr>
              </thead>
              <tbody>
                <% mrpResults.forEach(item => { 
                  const gross = parseFloat(item.grossRequirement || item.grossQty || 0);
                  const curr = parseFloat(item.currentStock || 0);
                  const shortage = parseFloat(item.netShortage || item.netRequirement || Math.max(0, gross - curr));
                  const unit = item.unit || 'Adet';
                  const isPurchase = (item.procurementMethod === 'Satın Alma' || item.procurementMethod === 'Purchase');
                %>
                  <tr>
                    <td>
                      <strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace; font-size: 0.82rem;">
                        <%= item.stockCode %>
                      </strong>
                    </td>
                    <td>
                      <span style="font-weight: 700; color: #fff;"><%= item.name %></span>
                      <div style="font-size: 0.72rem; color: #94a3b8;"><%= item.category || 'Hammadde' %></div>
                    </td>
                    <td style="text-align: right; color: #cbd5e1; font-family: 'JetBrains Mono', monospace;">
                      <%= gross %> <%= unit %>
                    </td>
                    <td style="text-align: right; color: #94a3b8; font-family: 'JetBrains Mono', monospace;">
                      <%= curr %> <%= unit %>
                    </td>
                    <td style="text-align: right; font-weight: 900; color: #fb7185; font-family: 'JetBrains Mono', monospace;">
                      +<%= shortage %> <%= unit %>
                    </td>
                    <td style="text-align: center;">
                      <% if (isPurchase) { %>
                        <span style="background: rgba(244, 63, 94, 0.15); color: #fb7185; font-size: 0.72rem; font-weight: 800; padding: 2px 7px; border-radius: 6px;">
                          🛒 Satın Alma
                        </span>
                      <% } else { %>
                        <span style="background: rgba(99, 102, 241, 0.15); color: #a5b4fc; font-size: 0.72rem; font-weight: 800; padding: 2px 7px; border-radius: 6px;">
                          🏭 Yarı Mamul
                        </span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </div>

        <!-- 2. Recent Work Orders -->
        <div class="analytics-card">
          <div class="analytics-card-header">
            <h3 class="analytics-card-title">
              <span>⚡</span>
              <span>Son İş Emirleri ve Saha Durumu</span>
            </h3>
            <a href="/production/orders" style="color: #818cf8; font-size: 0.84rem; font-weight: 700; text-decoration: none;">
              Tüm İş Emirleri ➔
            </a>
          </div>

          <% if (orders.length === 0) { %>
            <div style="color: var(--text-muted); font-size: 0.9rem; text-align: center; padding: 2.5rem;">
              Henüz onaylanmış veya aktif üretimde olan iş emri bulunmamaktadır.
            </div>
          <% } else { %>
            <table class="analytics-table">
              <thead>
                <tr>
                  <th>İş Emri No</th>
                  <th>İmalat Başlığı</th>
                  <th>Miktar</th>
                  <th>İstasyon / Rota</th>
                  <th style="text-align: right;">Durum</th>
                </tr>
              </thead>
              <tbody>
                <% orders.slice(0, 6).forEach(o => { 
                  const orderNo = o.isEmriNo || o.workOrderNo || `ISEMRI-${o.id}`;
                  const title = o.uretimBasligi || o.productionTitle || 'İş Emri';
                  const plannedQty = parseFloat(o.planlananMiktar !== undefined ? o.planlananMiktar : (o.plannedQuantity || 1));
                  const unit = o.birim || o.unit || 'Adet';
                  const status = o.durum || o.status || 'Approved';
                  const ops = o.operasyonlar || [];
                  const activeOp = ops.find(op => op.durum === 'In_Production' || op.durum === 'Paused') || (ops.length > 0 ? ops[0] : null);
                  const stationName = activeOp ? activeOp.isMerkezi : (o.isMerkezi || 'İstasyon');
                %>
                  <tr>
                    <td>
                      <strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace; font-size: 0.82rem;">
                        <%= orderNo %>
                      </strong>
                    </td>
                    <td>
                      <span style="font-weight: 700; color: #fff;"><%= title %></span>
                    </td>
                    <td>
                      <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;"><%= plannedQty %> <%= unit %></strong>
                    </td>
                    <td style="font-size: 0.78rem; color: #cbd5e1;">
                      <% if (activeOp) { %>
                        <span>🛠️ [Adım #<%= activeOp.operasyonSira %>] <%= stationName %></span>
                      <% } else { %>
                        <span>🏢 <%= stationName %></span>
                      <% } %>
                    </td>
                    <td style="text-align: right;">
                      <% if (status === 'Completed') { %>
                        <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 6px;">
                          ✓ Tamamlandı
                        </span>
                      <% } else if (status === 'In_Production') { %>
                        <span style="background: rgba(245, 158, 11, 0.18); color: #fbbf24; font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 6px;">
                          ⚡ Üretimde
                        </span>
                      <% } else if (status === 'Quality_Check') { %>
                        <span style="background: rgba(59, 130, 246, 0.18); color: #60a5fa; font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 6px;">
                          🔍 Kalite Kontrol
                        </span>
                      <% } else { %>
                        <span style="background: rgba(99, 102, 241, 0.15); color: #a5b4fc; font-size: 0.72rem; font-weight: 800; padding: 2px 8px; border-radius: 6px;">
                          🟢 Onaylandı
                        </span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } %>
        </div>

      </div>

    </main>
  </div>

  <script>
    function updateClock() { 
      const now = new Date(); 
      const el = document.getElementById('liveTime'); 
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); 
    }
    updateClock(); 
    setInterval(updateClock, 1000);

    // Chart 1: Capacity Load Bar Chart
    const capacityData = <%- JSON.stringify(capacityReport || []) %>;
    if (document.getElementById('capacityChart')) {
      new Chart(document.getElementById('capacityChart'), {
        type: 'bar',
        data: {
          labels: capacityData.map(c => c.workCenterName || c.workCenterCode || 'İstasyon'),
          datasets: [{
            label: 'Kapasite Yük Oranı (%)',
            data: capacityData.map(c => c.loadPercentage || 0),
            backgroundColor: capacityData.map(c => c.isBottleneck ? 'rgba(244, 63, 94, 0.8)' : (c.loadPercentage > 50 ? 'rgba(245, 158, 11, 0.8)' : 'rgba(99, 102, 241, 0.85)')),
            borderColor: capacityData.map(c => c.isBottleneck ? '#f43f5e' : (c.loadPercentage > 50 ? '#f59e0b' : '#6366f1')),
            borderWidth: 1.5,
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { 
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  return ' Kapasite Doluluğu: %' + ctx.parsed.y;
                }
              }
            }
          },
          scales: { 
            y: { 
              beginAtZero: true, 
              max: 100,
              grid: { color: 'rgba(255, 255, 255, 0.06)' },
              ticks: { color: '#94a3b8', font: { family: 'JetBrains Mono' }, callback: v => '%' + v }
            },
            x: {
              grid: { display: false },
              ticks: { color: '#cbd5e1', font: { weight: '600', size: 11 } }
            }
          }
        }
      });
    }

    // Chart 2: Status Doughnut
    if (document.getElementById('statusChart')) {
      new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
          labels: ['Onaylı / Sırada', 'Üretimde', 'Tamamlanan'],
          datasets: [{
            data: [<%= stats.plannedOrders || 0 %>, <%= stats.inProductionOrders || 0 %>, <%= stats.completedOrders || 0 %>],
            backgroundColor: [
              'rgba(99, 102, 241, 0.85)',
              'rgba(245, 158, 11, 0.85)',
              'rgba(16, 185, 129, 0.85)'
            ],
            borderColor: '#0f172a',
            borderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { 
            legend: { 
              position: 'bottom',
              labels: { color: '#cbd5e1', font: { weight: '700', size: 11 }, padding: 14 }
            } 
          },
          cutout: '68%'
        }
      });
    }
