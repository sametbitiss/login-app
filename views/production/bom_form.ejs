<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim Reçetesi (BOM) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
  <style>
    .form-container-card {
      background: rgba(30, 41, 59, 0.45);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      max-width: 1200px;
      margin: 0 auto 40px auto;
    }

    .form-section-header {
      font-size: 1.05rem;
      font-weight: 800;
      color: #818cf8;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 12px;
    }

    /* Dynamic Component Card / Box */
    .comp-cards-wrapper {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 24px;
    }

    .comp-card-box {
      background: rgba(15, 23, 42, 0.85);
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      border-radius: 18px;
      padding: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      transition: all 0.2s ease;
      position: relative;
    }
    .comp-card-box:hover {
      border-color: rgba(99, 102, 241, 0.45);
      box-shadow: 0 6px 25px rgba(99, 102, 241, 0.2);
    }

    .comp-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 14px;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
      margin-bottom: 16px;
    }

    .btn-add-comp-action {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.18), rgba(5, 150, 105, 0.22));
      color: #34d399;
      border: 1.5px dashed rgba(16, 185, 129, 0.45);
      padding: 14px 24px;
      border-radius: 14px;
      font-weight: 800;
      font-size: 0.92rem;
      cursor: pointer;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.2s ease;
    }
    .btn-add-comp-action:hover {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(5, 150, 105, 0.35));
      border-color: #34d399;
      transform: translateY(-1px);
      box-shadow: 0 4px 18px rgba(16, 185, 129, 0.25);
    }

    /* Modal Styling */
    .component-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(10, 15, 30, 0.82);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 20px;
      box-sizing: border-box;
    }
    .component-modal-box {
      background: #0f172a;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      width: 100%;
      max-width: 850px;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
      overflow: hidden;
    }
    .component-modal-header {
      padding: 20px 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(30, 41, 59, 0.5);
    }
    .component-modal-body {
      padding: 20px 24px;
      overflow-y: auto;
      flex: 1;
    }
    .component-modal-footer {
      padding: 16px 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      background: rgba(30, 41, 59, 0.5);
    }

    .modal-filter-tab {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-weight: 700;
      font-size: 0.78rem;
      padding: 6px 12px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .modal-filter-tab.active {
      background: rgba(99, 102, 241, 0.25);
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.4);
    }

    .comp-table-row {
      cursor: pointer;
      transition: background 0.15s ease;
    }
    .comp-table-row:hover {
      background: rgba(99, 102, 241, 0.1);
    }
    .comp-table-row.selected {
      background: rgba(99, 102, 241, 0.2);
    }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link active">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link active">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <!-- Breadcrumb & Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 12px;">
        <div>
          <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/production/bom" style="color: var(--text-muted); text-decoration: none;">📜 Üretim Reçeteleri</a>
            <span>/</span>
            <span style="color: #818cf8; font-weight: 600;"><%= targetProduct ? `[${targetProduct.stokKodu}] ${targetProduct.ad}` : 'Reçete Oluştur' %></span>
          </div>
          <h1 style="font-size: 1.65rem; font-weight: 900; color: #fff; margin: 0; letter-spacing: -0.5px;">
            <%= isEditMode && targetProduct ? `📜 [${targetProduct.stokKodu}] Üretim Reçetesi Düzenleme` : (targetProduct ? `📜 [${targetProduct.stokKodu}] Yeni Üretim Reçetesi Tanımlama` : '📜 Yeni Üretim Reçetesi (BOM) Oluşturma') %>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            Ürünün imalatında kullanılacak hammadde, yarı mamul, ticari parça miktarları, fire oranları ve rota adım eşleştirmeleri.
          </p>
        </div>
        <a href="/production/bom" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; border-radius: 12px; padding: 10px 20px;">
          <span>←</span> Reçete Listesine Dön
        </a>
      </div>

      <!-- Main Form Container -->
      <div class="form-container-card">
        
        <form action="/production/bom/save" method="POST" id="bomForm">
          <input type="hidden" name="componentsJson" id="componentsJson" value="">

          <!-- Section 1: Recipe Header (5 Mandatory Fields) -->
          <div class="form-section-header">
            <span>📋</span> 1. Reçete Başlık Bilgileri
          </div>

          <div class="form-grid form-grid--3" style="margin-bottom: 1.5rem; gap: 16px;">
            
            <!-- 1. Ürün Kodu / Adı (Readonly) -->
            <div class="input-group" style="grid-column: span 2;">
              <label for="finishedStockItemId" style="font-weight: 700; font-size: 0.84rem;">
                1. Ürün Kodu / Adı <span style="color: #818cf8; font-size: 0.72rem; font-weight: 600;">(Değiştirilemez)</span> <span style="color: #f43f5e;">*</span>
              </label>
              <% if (targetProduct) { %>
                <input type="hidden" name="finishedStockItemId" id="finishedStockItemId" value="<%= targetProduct.id %>">
                <input type="text" readonly value="[<%= targetProduct.stokKodu %>] <%= targetProduct.ad %> (<%= targetProduct.kategori %>)"
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #34d399; background: rgba(15, 23, 42, 0.9); border: 1.5px solid rgba(52, 211, 153, 0.35); cursor: not-allowed;">
              <% } else { %>
                <select name="finishedStockItemId" id="finishedStockItemId" required onchange="onProductSelectChange(this.value)" style="font-weight: 700;">
                  <option value="">— Lütfen Bir Ürün Seçiniz —</option>
                  <% candidateProducts.forEach(p => { %>
                    <option value="<%= p.id %>" <%= p.hasRouting ? '' : 'disabled' %>>
                      [<%= p.stokKodu %>] <%= p.ad %> (<%= p.kategori %>) <%= p.hasRouting ? (p.hasBOM ? '— (✓ Reçete Var)' : '— (⚠️ Reçete Yok)') : '— (⚠️ Önce Rota Gerekli)' %>
                    </option>
                  <% }); %>
                </select>
              <% } %>
            </div>

            <!-- 2. Reçete Kodu / Numarası (Otomatik / Readonly) -->
            <div class="input-group">
              <label for="receteKodu" style="font-weight: 700; font-size: 0.84rem;">
                2. Reçete Kodu / No <span style="color: #818cf8; font-size: 0.72rem; font-weight: 600;">(Otomatik)</span> <span style="color: #f43f5e;">*</span>
              </label>
              <input type="text" id="receteKodu" name="receteKodu" value="<%= currentRecipeNo %>" readonly required
                style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #818cf8; background: rgba(15, 23, 42, 0.9); border: 1.5px solid rgba(99, 102, 241, 0.35); cursor: not-allowed;">
            </div>

          </div>

          <div class="form-grid form-grid--3" style="margin-bottom: 2rem; gap: 16px;">
            
            <!-- 3. Revizyon / Versiyon Numarası (Readonly / Otomatik) -->
            <div class="input-group">
              <label for="version" style="font-weight: 700; font-size: 0.84rem;">
                3. Versiyon / Revizyon <span style="color: #818cf8; font-size: 0.72rem; font-weight: 600;">(Otomatik)</span> <span style="color: #f43f5e;">*</span>
              </label>
              <input type="text" id="version" name="version" value="<%= currentVersion %>" readonly required
                style="font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #fbbf24; background: rgba(15, 23, 42, 0.9); border: 1.5px solid rgba(245, 158, 11, 0.35); cursor: not-allowed;">
            </div>

            <!-- 4. Geçerlilik Başlangıç Tarihi (Bugünden eski olamaz, Zorunlu) -->
            <% 
              const todayStr = new Date().toISOString().split('T')[0]; 
              const existingBaslangic = (existingBOMItems && existingBOMItems.length > 0 && existingBOMItems[0].gecerlilikBaslangic) ? existingBOMItems[0].gecerlilikBaslangic : todayStr;
            %>
            <div class="input-group">
              <label for="gecerlilikBaslangic" style="font-weight: 700; font-size: 0.84rem;">
                4. Geçerlilik Başlangıç Tarihi <span style="color: #f43f5e;">*</span>
              </label>
              <input type="date" id="gecerlilikBaslangic" name="gecerlilikBaslangic" min="<%= todayStr %>" value="<%= existingBaslangic %>" required
                style="font-weight: 600; color: #fff;">
            </div>

            <!-- 5. Durum (Aktif / Pasif, Zorunlu) -->
            <% 
              const existingDurum = (existingBOMItems && existingBOMItems.length > 0 && existingBOMItems[0].durum) ? existingBOMItems[0].durum : 'Active';
            %>
            <div class="input-group">
              <label for="durum" style="font-weight: 700; font-size: 0.84rem;">
                5. Durum <span style="color: #f43f5e;">*</span>
              </label>
              <select id="durum" name="durum" required style="font-weight: 700;">
                <option value="Active" <%= existingDurum === 'Active' ? 'selected' : '' %>>🟢 Aktif</option>
                <option value="Inactive" <%= existingDurum === 'Inactive' ? 'selected' : '' %>>⚪ Pasif</option>
              </select>
            </div>

          </div>

          <!-- Section 2: Component Items Builder -->
          <div class="form-section-header">
            <span>🧩</span> 2. Reçete Bileşenleri & Hammadde İhtiyaçları
            <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);" id="compCountBadge">
              <%= existingBOMItems ? existingBOMItems.length : 0 %> Bileşen Kalemi
            </span>
          </div>

          <!-- Dynamic Component Cards Container -->
          <div class="comp-cards-wrapper" id="compCardsContainer">
            <!-- Injected via JavaScript -->
          </div>

          <!-- Add Component Button -->
          <div style="margin-bottom: 2.5rem;">
            <button type="button" class="btn-add-comp-action" onclick="addNewComponentRow()">
              <span style="font-size: 1.2rem;">➕</span>
              <span>Yeni Reçete Bileşeni Ekle</span>
            </button>
          </div>

          <!-- Form Actions Bar -->
          <div style="display: flex; justify-content: flex-end; gap: 14px; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 20px;">
            <a href="/production/bom" class="btn btn-secondary" style="padding: 11px 24px; border-radius: 12px; font-weight: 700;">
              Vazgeç
            </a>
            <button type="submit" class="btn btn-primary" id="btnSubmitBOM" style="background: linear-gradient(135deg, #6366f1 0%, #10b981 100%); color: #fff; border: none; font-weight: 800; font-size: 0.95rem; padding: 11px 34px; border-radius: 12px; box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4); cursor: pointer;">
              💾 Reçeteyi Kaydet
            </button>
          </div>

        </form>
      </div>

    </main>
  </div>

  <!-- COMPONENT SELECTION MODAL -->
  <div class="component-modal-overlay" id="componentSelectModal">
    <div class="component-modal-box">
      
      <div class="component-modal-header">
        <div>
          <h3 style="margin: 0; color: #fff; font-size: 1.15rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
            <span>🔍</span> Reçete İçin Bileşen / Malzeme Seçimi
          </h3>
          <span style="font-size: 0.78rem; color: var(--text-muted); margin-top: 3px; display: block;">
            Listeden reçeteye eklenecek hammadde, yarı mamul veya ticari ürünü seçiniz.
          </span>
        </div>
        <button type="button" onclick="closeComponentSelectModal()" style="background: rgba(255,255,255,0.08); border: none; color: #fff; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-size: 1.1rem; display: flex; align-items: center; justify-content: center;">
          ✕
        </button>
      </div>

      <!-- Modal Filter Bar -->
      <div style="padding: 14px 24px; background: rgba(15, 23, 42, 0.9); border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;">
        
        <div style="display: flex; gap: 6px; background: rgba(30, 41, 59, 0.6); padding: 3px; border-radius: 10px;">
          <button type="button" class="modal-filter-tab active" onclick="filterModalCategory('all', this)">Tümü</button>
          <button type="button" class="modal-filter-tab" onclick="filterModalCategory('Hammadde', this)">Hammadde</button>
          <button type="button" class="modal-filter-tab" onclick="filterModalCategory('Yari_Mamul', this)">Yarı Mamul</button>
          <button type="button" class="modal-filter-tab" onclick="filterModalCategory('Mamul', this)">Mamul</button>
        </div>

        <div style="position: relative; flex: 1; min-width: 200px; max-width: 320px;">
          <span style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 0.85rem; color: var(--text-muted);">🔍</span>
          <input type="text" id="modalComponentSearch" placeholder="Bileşen Kodu veya Adı Ara..." oninput="renderModalComponents()"
            style="width: 100%; background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 7px 12px 7px 32px; font-size: 0.84rem; color: #fff; outline: none; box-sizing: border-box;">
        </div>

      </div>

      <!-- Modal Table Body -->
      <div class="component-modal-body">
        <table style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-muted); font-size: 0.76rem; text-transform: uppercase;">
              <th style="padding: 10px 12px; width: 45px; text-align: center;">Seç</th>
              <th style="padding: 10px 12px; width: 130px;">Ürün Kodu</th>
              <th style="padding: 10px 12px;">Ürün Adı</th>
              <th style="padding: 10px 12px; width: 110px;">Kategori</th>
              <th style="padding: 10px 12px; width: 70px; text-align: center;">Birim</th>
              <th style="padding: 10px 12px; width: 100px; text-align: right;">Mevcut Stok</th>
            </tr>
          </thead>
          <tbody id="modalComponentsTbody">
            <!-- Injected via JS -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div class="component-modal-footer">
        <button type="button" onclick="closeComponentSelectModal()" class="btn btn-secondary" style="padding: 8px 18px; border-radius: 10px; font-weight: 700; font-size: 0.85rem;">
          Vazgeç
        </button>
        <button type="button" onclick="applyModalSelection()" class="btn btn-primary" style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; padding: 8px 24px; border-radius: 10px; font-weight: 800; font-size: 0.85rem; border: none; cursor: pointer;">
          ✓ Seçimi Uygula
        </button>
      </div>

    </div>
  </div>

  <!-- Raw JSON Data Embeds -->
  <script id="allComponentStockItemsData" type="application/json">
    <%- JSON.stringify(allComponentStockItems || []) %>
  </script>
  <script id="targetRoutingOperationsData" type="application/json">
    <%- JSON.stringify(targetRoutingOperations || []) %>
  </script>
  <script id="existingBOMItemsData" type="application/json">
    <%- JSON.stringify(existingBOMItems || []) %>
  </script>

  <script>
    const componentsCatalog = JSON.parse(document.getElementById('allComponentStockItemsData').textContent || '[]');
    const routingOperations = JSON.parse(document.getElementById('targetRoutingOperationsData').textContent || '[]');
    const existingBOMList = JSON.parse(document.getElementById('existingBOMItemsData').textContent || '[]');

    let componentsData = [];
    let activeModalTargetIndex = null;
    let currentModalCategory = 'all';
    let tempModalSelectedId = null;

    // Initialize Component Rows
    if (existingBOMList && existingBOMList.length > 0) {
      componentsData = existingBOMList.map(b => ({
        bilesenStokId: b.bilesenStokId,
        bilesenKodu: b.bilesenUrun ? b.bilesenUrun.stokKodu : '',
        bilesenAdi: b.bilesenUrun ? b.bilesenUrun.ad : '',
        gerekliMiktar: b.gerekliMiktar,
        birim: b.birim || (b.bilesenUrun ? b.bilesenUrun.birim : 'Adet'),
        fireOrani: b.fireOrani !== undefined ? b.fireOrani : 0.0,
        operasyonKodu: b.operasyonKodu || (routingOperations.length > 0 ? String(routingOperations[0].operasyonSira) : ''),
        notlar: b.notlar || ''
      }));
    } else {
      // Initialize with 1 clean empty component row
      componentsData = [
        {
          bilesenStokId: '',
          bilesenKodu: '',
          bilesenAdi: '',
          gerekliMiktar: '',
          birim: '',
          fireOrani: '',
          operasyonKodu: routingOperations.length > 0 ? String(routingOperations[0].operasyonSira) : '',
          notlar: ''
        }
      ];
    }

    function renderComponentCards() {
      const container = document.getElementById('compCardsContainer');
      if (!container) return;

      document.getElementById('compCountBadge').textContent = `${componentsData.length} Bileşen Kalemi`;

      if (componentsData.length === 0) {
        container.innerHTML = `
          <div style="background: rgba(15, 23, 42, 0.6); border: 2px dashed rgba(255,255,255,0.1); border-radius: 16px; padding: 40px; text-align: center; color: var(--text-muted);">
            <div style="font-size: 2rem; margin-bottom: 8px;">🧩</div>
            <strong>Henüz bir reçete bileşeni eklenmedi.</strong><br>
            <span style="font-size: 0.84rem; margin-top: 4px; display: inline-block;">Aşağıdaki 'Yeni Reçete Bileşeni Ekle' butonuna basarak hammadde ve parçaları tanımlayabilirsiniz.</span>
          </div>
        `;
        return;
      }

      container.innerHTML = componentsData.map((comp, idx) => {
        const hasSelection = comp.bilesenStokId && comp.bilesenKodu;
        return `
          <div class="comp-card-box" data-index="${idx}">
            
            <!-- Card Header -->
            <div class="comp-card-header">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span style="background: rgba(99, 102, 241, 0.2); color: #818cf8; width: 30px; height: 30px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; font-family: 'JetBrains Mono', monospace;">
                  #${idx + 1}
                </span>
                <strong style="color: #fff; font-size: 0.95rem;">
                  ${hasSelection ? `[${escapeHtml(comp.bilesenKodu)}] ${escapeHtml(comp.bilesenAdi)}` : 'Lütfen Bir Bileşen / Malzeme Seçiniz'}
                </strong>
              </div>
              <div>
                <button type="button" onclick="removeComponentRow(${idx})" class="btn btn-danger btn-sm" style="padding: 6px 12px; border-radius: 8px; font-weight: 700; font-size: 0.78rem;" title="Bu Bileşeni Sil">
                  🗑️ Kalemi Sil
                </button>
              </div>
            </div>

            <!-- Card Inputs Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 12px;">
              
              <!-- 1. Bileşen Kodu / Adı & Modal Seç Butonu (Zorunlu) -->
              <div class="input-group" style="grid-column: span 2;">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  1. Bileşen Kodu / Adı <span style="color: #f43f5e;">*</span>
                </label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" readonly value="${hasSelection ? `[${comp.bilesenKodu}] ${comp.bilesenAdi}` : ''}" placeholder="— Malzeme Listesinden Seçiniz —" required
                    style="flex: 1; font-weight: 600; color: ${hasSelection ? '#818cf8' : 'var(--text-muted)'}; background: rgba(15, 23, 42, 0.95); border: 1.5px solid rgba(255,255,255,0.1); cursor: pointer;"
                    onclick="openComponentSelectModal(${idx})">
                  <button type="button" class="btn btn-secondary" onclick="openComponentSelectModal(${idx})" style="padding: 0 14px; font-weight: 700; font-size: 0.82rem; border-radius: 10px; white-space: nowrap;">
                    🔍 Seç
                  </button>
                </div>
              </div>

              <!-- 2. Miktar (Zorunlu, > 0) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  2. Miktar <span style="color: #f43f5e;">*</span>
                </label>
                <input type="number" step="0.0001" min="0.0001" value="${comp.gerekliMiktar !== undefined && comp.gerekliMiktar !== null ? comp.gerekliMiktar : ''}" placeholder="Örn: 1.5" required
                  class="comp-input-qty" data-index="${idx}" onchange="updateCompField(${idx}, 'gerekliMiktar', this.value)"
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #34d399;">
              </div>

              <!-- 3. Birim (Readonly) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  3. Birim <span style="color: #818cf8; font-size: 0.72rem; font-weight: 600;">(Otomatik)</span> <span style="color: #f43f5e;">*</span>
                </label>
                <input type="text" readonly value="${comp.birim || ''}" placeholder="Birim" required
                  class="comp-input-unit" data-index="${idx}"
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(15, 23, 42, 0.95); border: 1.5px solid rgba(255,255,255,0.1); color: #fff; cursor: not-allowed;">
              </div>

              <!-- 4. Fire Oranı (%) (Zorunlu, >= 0) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  4. Fire Oranı (%) <span style="color: #f43f5e;">*</span>
                </label>
                <div style="position: relative;">
                  <input type="number" step="0.1" min="0" value="${comp.fireOrani !== undefined && comp.fireOrani !== null ? comp.fireOrani : ''}" placeholder="0.0" required
                    class="comp-input-scrap" data-index="${idx}" onchange="updateCompField(${idx}, 'fireOrani', this.value)"
                    style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fbbf24; padding-right: 40px;">
                  <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">
                    %
                  </span>
                </div>
              </div>

              <!-- 5. Rota Adımı Numarası (Zorunlu) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  5. Kullanılacağı Rota Adımı <span style="color: #f43f5e;">*</span>
                </label>
                <select required class="comp-input-op" data-index="${idx}" onchange="updateCompField(${idx}, 'operasyonKodu', this.value)" style="font-weight: 700;">
                  <option value="">— Rota Adımı Seçiniz —</option>
                  ${routingOperations.map(r => {
                    const isSelected = String(comp.operasyonKodu) === String(r.operasyonSira) || String(comp.operasyonKodu) === String(r.operasyonKodu);
                    return `<option value="${r.operasyonSira}" ${isSelected ? 'selected' : ''}>[Adım #${r.operasyonSira}] ${escapeHtml(r.operasyonAdi)}</option>`;
                  }).join('')}
                </select>
              </div>

            </div>

            <!-- 6. Satır Açıklaması / Notlar (Opsiyonel) -->
            <div class="input-group">
              <label style="font-weight: 700; font-size: 0.82rem;">
                6. Satır Açıklaması / İmalat Notları <span style="color: var(--text-muted); font-size: 0.75rem; font-weight: normal;">(Opsiyonel)</span>
              </label>
              <input type="text" value="${escapeHtml(comp.notlar || '')}" placeholder="Bileşen kullanımı veya montaj sırası ile ilgili ek açıklama girilebilir..."
                class="comp-input-notes" data-index="${idx}" oninput="updateCompField(${idx}, 'notlar', this.value)"
                style="font-size: 0.85rem;">
            </div>

          </div>
        `;
      }).join('');
    }

    function addNewComponentRow() {
      componentsData.push({
        bilesenStokId: '',
        bilesenKodu: '',
        bilesenAdi: '',
        gerekliMiktar: '',
        birim: '',
        fireOrani: '',
        operasyonKodu: routingOperations.length > 0 ? String(routingOperations[0].operasyonSira) : '',
        notlar: ''
      });
      renderComponentCards();
    }

    function removeComponentRow(index) {
      if (componentsData.length <= 1) {
        if (!confirm('Bu son bileşen kalemini silmek istediğinize emin misiniz? Reçetede en az 1 bileşen bulunmalıdır.')) return;
      }
      componentsData.splice(index, 1);
      renderComponentCards();
    }

    function updateCompField(index, field, value) {
      if (componentsData[index]) {
        componentsData[index][field] = value;
      }
    }

    function openComponentSelectModal(index) {
      activeModalTargetIndex = index;
      tempModalSelectedId = componentsData[index] ? componentsData[index].bilesenStokId : null;
      document.getElementById('modalComponentSearch').value = '';
      currentModalCategory = 'all';
      document.querySelectorAll('.modal-filter-tab').forEach(b => b.classList.remove('active'));
      document.querySelector('.modal-filter-tab')?.classList.add('active');

      const modal = document.getElementById('componentSelectModal');
      if (modal) modal.style.display = 'flex';
      renderModalComponents();
      setTimeout(() => {
        document.getElementById('modalComponentSearch')?.focus();
      }, 100);
    }

    function closeComponentSelectModal() {
      const modal = document.getElementById('componentSelectModal');
      if (modal) modal.style.display = 'none';
      activeModalTargetIndex = null;
    }

    function filterModalCategory(cat, btn) {
      document.querySelectorAll('.modal-filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentModalCategory = cat;
      renderModalComponents();
    }

    function renderModalComponents() {
      const tbody = document.getElementById('modalComponentsTbody');
      if (!tbody) return;

      const query = (document.getElementById('modalComponentSearch')?.value || '').toLowerCase().trim();

      let items = (componentsCatalog || []).filter(c => {
        if (currentModalCategory !== 'all') {
          if (currentModalCategory === 'Yari_Mamul') {
            if (!['Yari_Mamul', 'Yarı_Mamul'].includes(c.kategori)) return false;
          } else if (c.kategori !== currentModalCategory) {
            return false;
          }
        }

        const code = (c.stokKodu || '').toLowerCase();
        const name = (c.ad || '').toLowerCase();
        return code.includes(query) || name.includes(query);
      });

      if (items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" style="padding: 30px; text-align: center; color: var(--text-muted);">
              🔍 Kriterlere uygun bileşen bulunamadı.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = items.map(c => {
        const isSelected = String(c.id) === String(tempModalSelectedId);
        return `
          <tr class="comp-table-row ${isSelected ? 'selected' : ''}" onclick="selectModalItem(${c.id})">
            <td style="padding: 10px 12px; text-align: center;">
              <input type="radio" name="modalCompRadio" value="${c.id}" ${isSelected ? 'checked' : ''}
                style="cursor: pointer; accent-color: #6366f1;" onclick="event.stopPropagation(); selectModalItem(${c.id})">
            </td>
            <td style="padding: 10px 12px; font-family: 'JetBrains Mono', monospace; font-size: 0.84rem; font-weight: 700; color: #818cf8;">
              ${escapeHtml(c.stokKodu)}
            </td>
            <td style="padding: 10px 12px; font-weight: 600; color: #fff; font-size: 0.88rem;">
              ${escapeHtml(c.ad)}
            </td>
            <td style="padding: 10px 12px; font-size: 0.78rem;">
              ${c.kategori === 'Hammadde' ? '<span style="color: #60a5fa; background: rgba(59,130,246,0.15); padding: 2px 8px; border-radius: 6px;">Hammadde</span>' : (['Yari_Mamul', 'Yarı_Mamul'].includes(c.kategori) ? '<span style="color: #fbbf24; background: rgba(245,158,11,0.15); padding: 2px 8px; border-radius: 6px;">Yarı Mamul</span>' : '<span style="color: #818cf8; background: rgba(99,102,241,0.15); padding: 2px 8px; border-radius: 6px;">Mamul</span>')}
            </td>
            <td style="padding: 10px 12px; text-align: center; font-size: 0.82rem; color: var(--text-secondary);">
              ${escapeHtml(c.birim || 'Adet')}
            </td>
            <td style="padding: 10px 12px; text-align: right; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #34d399; font-weight: 700;">
              ${c.mevcutStok || 0}
            </td>
          </tr>
        `;
      }).join('');
    }

    function selectModalItem(id) {
      tempModalSelectedId = id;
      renderModalComponents();
    }

    function applyModalSelection() {
      if (!tempModalSelectedId) {
        alert('Lütfen listeden bir bileşen seçiniz.');
        return;
      }

      const match = (componentsCatalog || []).find(c => String(c.id) === String(tempModalSelectedId));
      if (!match) return;

      if (activeModalTargetIndex !== null && componentsData[activeModalTargetIndex]) {
        componentsData[activeModalTargetIndex].bilesenStokId = match.id;
        componentsData[activeModalTargetIndex].bilesenKodu = match.stokKodu;
        componentsData[activeModalTargetIndex].bilesenAdi = match.ad;
        componentsData[activeModalTargetIndex].birim = match.birim || 'Adet';
      }

      closeComponentSelectModal();
      renderComponentCards();
    }

    function escapeHtml(text) {
      if (!text) return '';
      return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function onProductSelectChange(productId) {
      if (!productId) return;
      window.location.href = `/production/bom/edit/${productId}`;
    }

    // Strict Validation on Form Submission
    const form = document.getElementById('bomForm');
    if (form) {
      form.addEventListener('submit', function(e) {
        const finishedStockItemId = document.getElementById('finishedStockItemId').value;
        if (!finishedStockItemId) {
          e.preventDefault();
          alert('⚠️ Lütfen reçetesi oluşturulacak hedef mamul/yarı mamul ürünü seçiniz.');
          return false;
        }

        const gecerlilikBaslangic = document.getElementById('gecerlilikBaslangic').value;
        if (!gecerlilikBaslangic) {
          e.preventDefault();
          alert('⚠️ Lütfen geçerlilik başlangıç tarihini giriniz.');
          return false;
        }

        const todayStr = new Date().toISOString().split('T')[0];
        if (gecerlilikBaslangic < todayStr) {
          e.preventDefault();
          alert('⚠️ Geçerlilik başlangıç tarihi bugünden eski bir tarih olamaz.');
          return false;
        }

        if (!componentsData || componentsData.length === 0) {
          e.preventDefault();
          alert('⚠️ Lütfen en az 1 adet reçete bileşeni ekleyiniz.');
          return false;
        }

        // Validate all 10 mandatory fields
        for (let i = 0; i < componentsData.length; i++) {
          const comp = componentsData[i];

          if (!comp.bilesenStokId) {
            e.preventDefault();
            alert(`⚠️ Bileşen Kalemi #${i + 1}: Lütfen bir bileşen/hammadde seçiniz.`);
            return false;
          }

          if (String(comp.bilesenStokId) === String(finishedStockItemId)) {
            e.preventDefault();
            alert(`⚠️ Bileşen Kalemi #${i + 1}: Ürünün kendisi kendi reçetesine bileşen olarak eklenemez.`);
            return false;
          }

          const qty = parseFloat(comp.gerekliMiktar);
          if (isNaN(qty) || qty <= 0) {
            e.preventDefault();
            alert(`⚠️ Bileşen Kalemi #${i + 1}: Miktar 0'dan büyük pozitif bir sayı olmalıdır.`);
            return false;
          }

          if (!comp.birim || !comp.birim.trim()) {
            e.preventDefault();
            alert(`⚠️ Bileşen Kalemi #${i + 1}: Bileşen birimi gereklidir.`);
            return false;
          }

          const scrap = parseFloat(comp.fireOrani);
          if (isNaN(scrap) || scrap < 0) {
            e.preventDefault();
            alert(`⚠️ Bileşen Kalemi #${i + 1}: Fire oranı negatif olamaz (0 veya daha büyük girilmelidir).`);
            return false;
          }

          if (!comp.operasyonKodu || !comp.operasyonKodu.trim()) {
            e.preventDefault();
            alert(`⚠️ Bileşen Kalemi #${i + 1}: Lütfen bu bileşenin kullanılacağı Rota Adımını seçiniz.`);
            return false;
          }
        }

        document.getElementById('componentsJson').value = JSON.stringify(componentsData);
      });
    }

    // Initial render
    renderComponentCards();

    function updateClock() { 
      const now = new Date(); 
      const el = document.getElementById('liveTime'); 
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); 
    }
    updateClock(); 
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
