<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim Talepleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .btn-action-bom {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff !important;
      font-weight: 700;
      font-size: 0.825rem;
      padding: 6px 14px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
      box-shadow: 0 2px 10px rgba(99, 102, 241, 0.3);
    }
    .btn-action-bom:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.5);
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link active">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <div class="page-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div>
          <h1>📩 Üretim Talepleri</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Depodan gelen acil imalat ve kritik stok uyarısı talepleri ile satış siparişlerinden gelen üretim ihtiyaçları.</p>
        </div>
        <a href="/production/mrp" class="btn" style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; font-weight: 800; border-radius: 12px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);">
          <span>⚡ MRP İle Toplu Planla & Çalıştır ➔</span>
        </a>
      </div>

      <% const stockAlertsCount = productionRequisitions.filter(o => ((o.uretimBasligi && o.uretimBasligi.includes('Kritik Stok')) || (o.productionTitle && o.productionTitle.includes('Kritik Stok'))) && (o.durum === 'Planned' || o.status === 'Planned')).length; %>
      <% if (stockAlertsCount > 0) { %>
        <div style="background: rgba(99, 102, 241, 0.12); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; font-size: 0.95rem; display: flex; align-items: center; justify-content: space-between; font-weight: 600;">
          <span>⚙️ <strong>Stok & Depo Modülünden UYARI!</strong> Depoda kritik stok seviyesine düşen <%= stockAlertsCount %> adet Yarı Mamul/Mamul için acil üretim talebi açıldı!</span>
          <span style="background: #6366f1; color: #fff; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 800;"><%= stockAlertsCount %> ACİL İMALAT TALEBİ</span>
        </div>
      <% } %>

      <div class="kpi-strip">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">📋</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Toplam Üretim Talebi</span><span class="kpi-chip-value"><%= productionRequisitions.length %></span></div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--rose">🚨</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Kritik Stok Talepleri</span><span class="kpi-chip-value"><%= productionRequisitions.filter(o => (o.uretimBasligi && o.uretimBasligi.includes('Kritik Stok')) || (o.productionTitle && o.productionTitle.includes('Kritik Stok'))).length %></span></div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">⚡</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Bekleyen Talepler</span><span class="kpi-chip-value"><%= productionRequisitions.filter(o => o.durum === 'Planned' || o.status === 'Planned').length %></span></div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">⚙️</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Üretimdeki İşler</span><span class="kpi-chip-value"><%= productionRequisitions.filter(o => o.durum === 'In_Production' || o.status === 'In_Production').length %></span></div>
        </div>
      </div>

      <div class="table-wrapper" style="margin-top: 16px;">
        <table class="data-table">
          <thead>
            <tr>
              <th>Talep No</th>
              <th>Talep Tipi</th>
              <th>Talep Edilen Malzeme</th>
              <th>Miktar</th>
              <th>Aciliyet</th>
              <th>Açıklama / Not</th>
              <th>Talep Eden</th>
              <th>Durum</th>
              <th>Tarih</th>
              <th style="text-align: right;">Planlama Durumu</th>
            </tr>
          </thead>
          <tbody>
            <% if (productionRequisitions.length === 0) { %>
              <tr><td colspan="10" style="text-align: center; color: var(--text-muted); padding: 3rem;">Henüz üretim talebi bulunmamaktadır.</td></tr>
            <% } else { %>
              <% productionRequisitions.forEach(o => { %>
                <% 
                  const isEmriNo = o.isEmriNo || o.workOrderNo || '—';
                  const titleText = o.uretimBasligi || o.productionTitle || 'Üretim Talebi';
                  const stockObj = o.stokKarti || o.stockItem;
                  const productName = stockObj ? (stockObj.ad || stockObj.name) : titleText;
                  const stockCode = stockObj ? (stockObj.stokKodu || stockObj.stockCode || '') : '';
                  const category = stockObj ? (stockObj.kategori || stockObj.category || '') : '';
                  const plannedQty = o.planlananMiktar !== undefined ? o.planlananMiktar : (o.plannedQuantity !== undefined ? o.plannedQuantity : 1);
                  const unit = o.birim || o.unit || 'Adet';
                  const priority = o.oncelik || o.priority || 'Normal';
                  const notes = o.notlar || o.receteNotlari || o.notes || '—';
                  const creatorObj = o.olusturan || o.creator;
                  let creatorDisplay = 'Satış / Sistem Otomasyonu';
                  if (creatorObj) {
                    if (creatorObj.ad) creatorDisplay = creatorObj.ad + ' ' + (creatorObj.soyad || '');
                    else if (creatorObj.firstName) creatorDisplay = creatorObj.firstName + ' ' + (creatorObj.lastName || '');
                    else if (creatorObj.kullaniciAdi || creatorObj.username) creatorDisplay = creatorObj.kullaniciAdi || creatorObj.username;
                  }
                  const status = o.durum || o.status || 'Planned';
                %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= isEmriNo %></strong></td>
                  <td>
                    <span class="badge-status badge-cat-mamul">🏭 Üretim Talebi</span>
                  </td>
                  <td>
                    <strong style="color: var(--text-primary);"><%= productName %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-muted);"><%= stockCode ? (stockCode + (category ? ' (' + category + ')' : '')) : titleText %></div>
                  </td>
                  <td><strong><%= plannedQty %> <%= unit %></strong></td>
                  <td>
                    <% if (priority === 'Urgent' || priority === 'Acil') { %>
                      <span class="status-pill status-rejected">🚨 Acil</span>
                    <% } else if (priority === 'High' || priority === 'Yuksek') { %>
                      <span class="status-pill status-pending">⚠️ Yüksek</span>
                    <% } else { %>
                      <span class="status-pill status-approved">Normal</span>
                    <% } %>
                  </td>
                  <td style="font-size: 0.8rem; max-width: 260px; color: var(--text-secondary);">
                    <%= notes %>
                  </td>
                  <td><%= creatorDisplay %></td>
                  <td>
                    <% if (status === 'Completed') { %>
                      <span class="badge-status badge-has-bom" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.3);">✓ Tamamlandı</span>
                    <% } else if (status === 'In_Production') { %>
                      <span class="badge-status badge-has-bom" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border-color: rgba(59, 130, 246, 0.3);">● İmalatta / Üretimde</span>
                    <% } else if (status === 'Approved') { %>
                      <span class="badge-status badge-has-bom" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border-color: rgba(99, 102, 241, 0.3);">● Onaylandı</span>
                    <% } else if (status === 'Cancelled') { %>
                      <span class="badge-status badge-no-bom" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border-color: rgba(239, 68, 68, 0.3);">✕ İptal Edildi</span>
                    <% } else { %>
                      <span class="badge-status badge-no-bom" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3);">● Talep Bekliyor</span>
                    <% } %>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(o.createdAt).toLocaleDateString('tr-TR') %></td>
                  <td style="text-align: right;">
                    <% if (status === 'Planned') { %>
                      <span style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;">
                        ⚡ MRP Havuzunda
                      </span>
                    <% } else if (status === 'Approved') { %>
                      <span style="background: rgba(99, 102, 241, 0.18); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.35); font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;">
                        🟢 İş Emri Açıldı
                      </span>
                    <% } else if (status === 'In_Production') { %>
                      <span style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;">
                        ⚡ İmalata Alındı
                      </span>
                    <% } else if (status === 'Completed') { %>
                      <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-weight: 700; font-size: 0.75rem; padding: 4px 10px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px;">
                        ✓ Tamamlandı
                      </span>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.82rem;">İşlem Gördü</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
