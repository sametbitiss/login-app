<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Talepler (Üretim & Reçete Talepleri) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .tab-nav {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      border-bottom: 2px solid var(--border);
      padding-bottom: 2px;
    }
    .tab-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      font-size: 1rem;
      font-weight: 700;
      padding: 12px 20px;
      cursor: pointer;
      border-bottom: 3px solid transparent;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .tab-btn:hover {
      color: var(--text-primary);
    }
    .tab-btn.active {
      color: #818cf8;
      border-bottom-color: #6366f1;
    }
    .tab-badge {
      background: rgba(99, 102, 241, 0.15);
      color: #818cf8;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 0.8rem;
      font-weight: 800;
    }
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }
    .btn-action-bom {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff !important;
      font-weight: 700;
      font-size: 0.825rem;
      padding: 6px 14px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
      box-shadow: 0 2px 10px rgba(99, 102, 241, 0.3);
    }
    .btn-action-bom:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.5);
    }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link active">📩 Talepler</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/production/analytics" class="msn-link">📊 Analitik</a>
        <a href="/production/requisitions" class="msn-link active">📩 Talepler</a>
        <a href="/production/orders" class="msn-link">📋 İş Emirleri</a>
        <a href="/production/orders/add" class="msn-link">➕ İş Emri Ekle</a>
        <a href="/production/mrp" class="msn-link">⚡ MRP Hesaplama</a>
        <a href="/production/bom" class="msn-link">📜 Reçeteler (BOM)</a>
        <a href="/production/routing" class="msn-link">🛠️ Rotalama</a>
        <a href="/production/capacity" class="msn-link">🏭 Kapasite</a>
        <a href="/production/mes" class="msn-link">📱 MES Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>📩 Talepler Kartı (Üretim & Reçete Oluşturma Talepleri)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Depodan gelen acil imalat/stok uyarısı talepleri ile yeni eklenen Mamul ve Yarı Mamullar için otomatik oluşturulan reçete hazırlama talepleri.</p>
        </div>
      </div>

      <!-- Main Navigation Dual Tabs -->
      <div class="tab-nav">
        <button class="tab-btn <%= activeTab !== 'bom' ? 'active' : '' %>" onclick="switchRequisitionTab('production', this)">
          <span>📋 Üretim Talepleri</span>
          <span class="tab-badge"><%= productionRequisitions.length %></span>
        </button>
        <button class="tab-btn <%= activeTab === 'bom' ? 'active' : '' %>" onclick="switchRequisitionTab('bom', this)">
          <span>📜 Reçete Oluşturma Talepleri</span>
          <span class="tab-badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399;"><%= bomRequisitions.length %></span>
        </button>
      </div>

      <!-- TAB 1: ÜRETİM TALEPLERİ -->
      <div id="tab-production" class="tab-content <%= activeTab !== 'bom' ? 'active' : '' %>">
        <% const stockAlertsCount = productionRequisitions.filter(o => o.productionTitle && o.productionTitle.includes('Kritik Stok') && o.status === 'Planned').length; %>
        <% if (stockAlertsCount > 0) { %>
          <div style="background: rgba(99, 102, 241, 0.12); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; font-size: 0.95rem; display: flex; align-items: center; justify-content: space-between; font-weight: 600;">
            <span>⚙️ <strong>Stok & Depo Modülünden UYARI!</strong> Depoda kritik stok seviyesine düşen <%= stockAlertsCount %> adet Yarı Mamul/Mamul için acil üretim talebi açıldı!</span>
            <span style="background: #6366f1; color: #fff; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 800;"><%= stockAlertsCount %> ACİL İMALAT TALEBİ</span>
          </div>
        <% } %>

        <div class="kpi-strip">
          <div class="kpi-chip">
            <div class="kpi-chip-icon kpi-chip--indigo">📋</div>
            <div class="kpi-chip-data"><span class="kpi-chip-label">Toplam Üretim Talebi</span><span class="kpi-chip-value"><%= productionRequisitions.length %></span></div>
          </div>
          <div class="kpi-chip">
            <div class="kpi-chip-icon kpi-chip--rose">🚨</div>
            <div class="kpi-chip-data"><span class="kpi-chip-label">Kritik Stok Talepleri</span><span class="kpi-chip-value"><%= productionRequisitions.filter(o => o.productionTitle && o.productionTitle.includes('Kritik Stok')).length %></span></div>
          </div>
          <div class="kpi-chip">
            <div class="kpi-chip-icon kpi-chip--amber">⚡</div>
            <div class="kpi-chip-data"><span class="kpi-chip-label">Bekleyen Talepler</span><span class="kpi-chip-value"><%= productionRequisitions.filter(o => o.status === 'Planned').length %></span></div>
          </div>
          <div class="kpi-chip">
            <div class="kpi-chip-icon kpi-chip--emerald">⚙️</div>
            <div class="kpi-chip-data"><span class="kpi-chip-label">Üretimdeki İşler</span><span class="kpi-chip-value"><%= productionRequisitions.filter(o => o.status === 'In_Production').length %></span></div>
          </div>
        </div>

        <div class="table-wrapper" style="margin-top: 16px;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Talep No</th>
                <th>Kaynak Modül</th>
                <th>Talep Edilen Malzeme</th>
                <th>Miktar</th>
                <th>Aciliyet</th>
                <th>Açıklama / Sistem Uyarısı</th>
                <th>Talep Eden</th>
                <th>Durum</th>
                <th>Tarih</th>
                <th>Aksiyon</th>
              </tr>
            </thead>
            <tbody>
              <% if (productionRequisitions.length === 0) { %>
                <tr><td colspan="10" style="text-align: center; color: var(--text-muted); padding: 3rem;">Henüz üretim talebi bulunmamaktadır.</td></tr>
              <% } else { %>
                <% productionRequisitions.forEach(o => { %>
                  <% const isStockAlert = o.productionTitle && o.productionTitle.includes('Kritik Stok'); %>
                  <tr style="<%= isStockAlert ? 'background: rgba(99, 102, 241, 0.04);' : '' %>">
                    <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= o.workOrderNo %></strong></td>
                    <td>
                      <% if (isStockAlert) { %>
                        <span class="status-pill status-rejected" style="background: rgba(244, 63, 94, 0.15); color: #f43f5e; border-color: rgba(244, 63, 94, 0.3);">🚨 Stok Uyarısı</span>
                      <% } else { %>
                        <span class="status-pill status-approved">🏭 Planlama</span>
                      <% } %>
                    </td>
                    <td>
                      <strong style="color: var(--text-primary);"><%= o.stockItem ? o.stockItem.name : o.productionTitle %></strong>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= o.stockItem ? o.stockItem.stockCode + ' (' + o.stockItem.category + ')' : '' %></div>
                    </td>
                    <td><strong><%= o.plannedQuantity %> <%= o.unit %></strong></td>
                    <td>
                      <% if (o.priority === 'Urgent') { %>
                        <span class="status-pill status-rejected">🚨 Acil</span>
                      <% } else if (o.priority === 'High') { %>
                        <span class="status-pill status-pending">⚠️ Yüksek</span>
                      <% } else { %>
                        <span class="status-pill status-approved">Normal</span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.8rem; max-width: 260px;">
                      <% if (isStockAlert) { %>
                        <div style="color: #818cf8; font-weight: 600;"><%= o.notes %></div>
                      <% } else { %>
                        <div style="color: var(--text-muted);"><%= o.notes || '—' %></div>
                      <% } %>
                    </td>
                    <td><%= o.creator ? (o.creator.firstName ? o.creator.firstName + ' ' + o.creator.lastName : o.creator.username) : 'Depo Yöneticisi' %></td>
                    <td>
                      <% if (o.status === 'Completed') { %>
                        <span class="status-pill status-active">● Tamamlandı</span>
                      <% } else if (o.status === 'In_Production') { %>
                        <span class="status-pill status-pending">● Üretimde</span>
                      <% } else { %>
                        <span class="status-pill status-approved">● Beklemede</span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(o.createdAt).toLocaleDateString('tr-TR') %></td>
                    <td>
                      <form action="/production/orders/<%= o.id %>/status" method="POST" style="display: inline;">
                        <select name="status" onchange="this.form.submit()" class="filter-select" style="padding: 4px 8px; font-size: 0.8rem;">
                          <option value="Planned" <%= o.status === 'Planned' ? 'selected' : '' %>>Bekliyor</option>
                          <option value="In_Production" <%= o.status === 'In_Production' ? 'selected' : '' %>>⚙️ Üretime Al</option>
                          <option value="Quality_Check" <%= o.status === 'Quality_Check' ? 'selected' : '' %>>Kaliteye Gönder</option>
                          <option value="Completed" <%= o.status === 'Completed' ? 'selected' : '' %>>✅ Tamamla (Stokla)</option>
                          <option value="Cancelled" <%= o.status === 'Cancelled' ? 'selected' : '' %>>İptal Et</option>
                        </select>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 2: REÇETE OLUŞTURMA TALEPLERİ -->
      <div id="tab-bom" class="tab-content <%= activeTab === 'bom' ? 'active' : '' %>">
        <div style="background: rgba(16, 185, 129, 0.1); border: 1.5px solid rgba(16, 185, 129, 0.25); padding: 16px 20px; border-radius: 14px; margin-bottom: 20px; color: #a7f3d0; font-size: 0.9rem;">
          <strong>💡 Reçete Oluşturma Otomasyonu:</strong> Stok & Depo modülünden yeni eklenen her <strong>Mamul</strong> ve <strong>Yarı Mamul</strong> ürün için sistem otomatik olarak reçete oluşturma talebi açar. Reçeteyi oluşturduğunuzda talep otomatik olarak <strong>Tamamlandı</strong> durumuna geçer.
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Talep Kodu</th>
                <th>Kaynak Modül</th>
                <th>Reçete Yazılacak Ürün</th>
                <th>Ürün Kategorisi</th>
                <th>Talep Açıklaması</th>
                <th>Aciliyet</th>
                <th>Durum</th>
                <th>Talep Tarihi</th>
                <th style="text-align: right;">Aksiyon</th>
              </tr>
            </thead>
            <tbody>
              <% if (bomRequisitions.length === 0) { %>
                <tr><td colspan="9" style="text-align: center; color: var(--text-muted); padding: 3rem;">Bekleyen reçete oluşturma talebi bulunmamaktadır.</td></tr>
              <% } else { %>
                <% bomRequisitions.forEach(b => { %>
                  <tr>
                    <td><strong style="color: #34d399; font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= b.workOrderNo %></strong></td>
                    <td><span class="status-pill status-approved">📦 Stok & Depo</span></td>
                    <td>
                      <strong style="color: var(--text-primary);"><%= b.stockItem ? b.stockItem.name : b.productionTitle %></strong>
                      <div style="font-size: 0.75rem; color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= b.stockItem ? b.stockItem.stockCode : '' %></div>
                    </td>
                    <td>
                      <% if (b.stockItem && b.stockItem.category === 'Mamul') { %>
                        <span class="badge-status badge-cat-mamul">🏭 Mamul</span>
                      <% } else { %>
                        <span class="badge-status badge-cat-yarimamul">⚙️ Yarı Mamul</span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.82rem; color: var(--text-secondary); max-width: 280px;"><%= b.notes %></td>
                    <td><span class="status-pill status-pending">⚠️ Yüksek</span></td>
                    <td>
                      <% if (b.status === 'Completed') { %>
                        <span class="badge-status badge-has-bom">✓ Tamamlandı</span>
                      <% } else { %>
                        <span class="badge-status badge-no-bom">● Reçete Bekliyor</span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(b.createdAt).toLocaleDateString('tr-TR') %></td>
                    <td style="text-align: right;">
                      <% if (b.status === 'Completed') { %>
                        <a href="/production/bom/edit/<%= b.stockItemId %>" class="btn-action-edit">
                          ✏️ Reçeteyi Düzenle
                        </a>
                      <% } else { %>
                        <a href="/production/bom/add?productId=<%= b.stockItemId %>" class="btn-action-bom">
                          📜 Reçete Oluştur
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    function switchRequisitionTab(tabName, btnEl) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

      btnEl.classList.add('active');
      document.getElementById('tab-' + tabName).classList.add('active');
    }

    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
