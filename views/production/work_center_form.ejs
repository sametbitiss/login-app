<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isEditMode ? 'İş Merkezini Düzenle' : 'Yeni İş Merkezi Ekle' %> — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
  <style>
    .form-container-card {
      background: rgba(30, 41, 59, 0.45);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      max-width: 920px;
      margin: 0 auto;
    }
    .form-section-header {
      font-size: 1.05rem;
      font-weight: 800;
      color: #818cf8;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 12px;
    }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link active">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link active">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <!-- Breadcrumb & Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 12px;">
        <div>
          <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/production/work-centers" style="color: var(--text-muted); text-decoration: none;">⚙️ İş Merkezleri</a>
            <span>/</span>
            <span style="color: #818cf8; font-weight: 600;"><%= isEditMode ? 'İş Merkezini Düzenle' : 'Yeni İş Merkezi Ekle' %></span>
          </div>
          <h1 style="font-size: 1.65rem; font-weight: 900; color: #fff; margin: 0; letter-spacing: -0.5px;">
            <%= isEditMode ? `⚙️ [${workCenter.isMerkeziKodu}] ${workCenter.isMerkeziAdi} Düzenleme` : '⚙️ Yeni İş Merkezi / İstasyon Tanımlama' %>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            İmalat operasyonlarının yürütüldüğü makine, tezgah veya montaj istasyonunun kodu, adı, atölye bağlantısı ve çalışma kapasitesi.
          </p>
        </div>
        <a href="/production/work-centers" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; border-radius: 12px; padding: 10px 20px;">
          <span>←</span> İş Merkezleri Listesine Dön
        </a>
      </div>

      <!-- Work Center Form Card -->
      <div class="form-container-card">
        
        <form action="/production/work-centers/save" method="POST" id="workCenterForm">
          <% if (isEditMode && workCenter) { %>
            <input type="hidden" name="id" value="<%= workCenter.id %>">
          <% } %>

          <div class="form-section-header">
            <span>⚙️</span> İş Merkezi Tanım & Kapasite Bilgileri
          </div>

          <!-- Row 1: Code & Name (Zorunlu) -->
          <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
            
            <!-- 1. İş Merkezi Kodu (Zorunlu / Benzersiz) -->
            <div class="input-group">
              <label for="isMerkeziKodu" style="font-weight: 700;">
                1. İş Merkezi Kodu <span style="color: #f43f5e;">*</span>
              </label>
              <input type="text" id="isMerkeziKodu" name="isMerkeziKodu" 
                value="<%= isEditMode && workCenter ? workCenter.isMerkeziKodu : '' %>" 
                placeholder="Örn: WS-CNC-01 veya IST-TORNA-01" required 
                style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #818cf8;">
            </div>

            <!-- 2. İş Merkezi Adı (Zorunlu) -->
            <div class="input-group">
              <label for="isMerkeziAdi" style="font-weight: 700;">
                2. İş Merkezi Adı <span style="color: #f43f5e;">*</span>
              </label>
              <input type="text" id="isMerkeziAdi" name="isMerkeziAdi" 
                value="<%= isEditMode && workCenter ? workCenter.isMerkeziAdi : '' %>" 
                placeholder="Örn: 5 Eksen CNC Freze Tezgahı" required 
                style="font-weight: 600;">
            </div>

          </div>

          <!-- Row 2: Atölye & Günlük Çalışma Saati (Zorunlu) -->
          <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
            
            <!-- 3. Bağlı Olduğu Atölye (Zorunlu / Dropdown) -->
            <div class="input-group">
              <label for="atolyeId" style="font-weight: 700;">
                3. Bağlı Olduğu Atölye <span style="color: #f43f5e;">*</span>
              </label>
              <select id="atolyeId" name="atolyeId" required style="font-weight: 600;">
                <option value="">— İlgili Atölyeyi Seçiniz —</option>
                <% workshops.forEach(ws => { %>
                  <% const isSelected = isEditMode && workCenter && workCenter.atolyeId === ws.id; %>
                  <option value="<%= ws.id %>" <%= isSelected ? 'selected' : '' %>>
                    [<%= ws.atolyeKodu %>] <%= ws.atolyeAdi %> <%= ws.durum === 'Active' ? '(🟢 Aktif)' : '(⚪ Pasif)' %>
                  </option>
                <% }); %>
              </select>
              <% if (!workshops || workshops.length === 0) { %>
                <span style="font-size: 0.78rem; color: #fbbf24; margin-top: 4px;">
                  ⚠️ Sistemde kayıtlı atölye bulunmamaktadır. Lütfen önce <a href="/production/workshops/add" style="color: #818cf8; text-decoration: underline;">Atölye Kartı</a> oluşturunuz.
                </span>
              <% } %>
            </div>

            <!-- 4. Kapasite Vardiya Bilgisi: Günlük Çalışma Saati (Zorunlu) -->
            <div class="input-group">
              <label for="gunlukCalismaSaati" style="font-weight: 700;">
                4. Kapasite / Günlük Çalışma Saati (Saat) <span style="color: #f43f5e;">*</span>
              </label>
              <div style="position: relative;">
                <input type="number" step="0.5" min="0.5" max="24" id="gunlukCalismaSaati" name="gunlukCalismaSaati" 
                  value="<%= isEditMode && workCenter ? workCenter.gunlukCalismaSaati : '8.0' %>" 
                  placeholder="Örn: 8.0 veya 16.0" required 
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fbbf24; padding-right: 70px;">
                <span style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">
                  Saat/Gün
                </span>
              </div>
            </div>

          </div>

          <!-- Row 3: Durum (Zorunlu) & Varsayılan Personel / İşçi Sayısı (Opsiyonel) -->
          <div class="form-grid form-grid--2" style="margin-bottom: 2rem;">
            
            <!-- 5. Durum (Zorunlu) -->
            <div class="input-group">
              <label for="durum" style="font-weight: 700;">
                5. Çalışma Durumu <span style="color: #f43f5e;">*</span>
              </label>
              <% const currentDurum = isEditMode && workCenter ? workCenter.durum : 'Active'; %>
              <select id="durum" name="durum" required style="font-weight: 700;">
                <option value="Active" <%= currentDurum === 'Active' ? 'selected' : '' %>>🟢 Aktif (İmalat ve İş Emirlerine Açık)</option>
                <option value="Inactive" <%= currentDurum === 'Inactive' ? 'selected' : '' %>>⚪ Pasif (Bakımda / Geçici Olarak Kapalı)</option>
              </select>
            </div>

            <!-- 6. Varsayılan Personel / İşçi Sayısı (Opsiyonel) -->
            <div class="input-group">
              <label for="varsayilanIsciSayisi" style="font-weight: 700;">
                6. Varsayılan Personel / İşçi Sayısı <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: normal;">(Opsiyonel)</span>
              </label>
              <div style="position: relative;">
                <input type="number" min="0" step="1" id="varsayilanIsciSayisi" name="varsayilanIsciSayisi" 
                  value="<%= isEditMode && workCenter && workCenter.varsayilanIsciSayisi ? workCenter.varsayilanIsciSayisi : '' %>" 
                  placeholder="Örn: 2" 
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 600; padding-right: 70px;">
                <span style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">
                  Kişi
                </span>
              </div>
            </div>

          </div>

          <!-- Form Actions -->
          <div style="display: flex; justify-content: flex-end; gap: 14px; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 20px;">
            <a href="/production/work-centers" class="btn btn-secondary" style="padding: 11px 24px; border-radius: 12px; font-weight: 700;">
              Vazgeç
            </a>
            <button type="submit" class="btn btn-primary" id="btnSubmitWorkCenter" style="background: linear-gradient(135deg, #6366f1 0%, #10b981 100%); color: #fff; border: none; font-weight: 800; font-size: 0.95rem; padding: 11px 34px; border-radius: 12px; box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4); cursor: pointer;">
              💾 <%= isEditMode ? 'İş Merkezini Güncelle' : 'İş Merkezini Kaydet' %>
            </button>
          </div>

        </form>
      </div>

    </main>
  </div>

  <script>
    // Strict Validation Check for Fields
    const form = document.getElementById('workCenterForm');
    if (form) {
      form.addEventListener('submit', function(e) {
        const kod = document.getElementById('isMerkeziKodu').value.trim();
        const ad = document.getElementById('isMerkeziAdi').value.trim();
        const atolyeId = document.getElementById('atolyeId').value.trim();
        const saat = document.getElementById('gunlukCalismaSaati').value.trim();
        const durum = document.getElementById('durum').value.trim();
        const isci = document.getElementById('varsayilanIsciSayisi').value.trim();

        if (!kod) {
          e.preventDefault();
          alert('⚠️ Lütfen 1. İş Merkezi Kodunu giriniz.');
          document.getElementById('isMerkeziKodu').focus();
          return false;
        }

        if (!ad) {
          e.preventDefault();
          alert('⚠️ Lütfen 2. İş Merkezi Adını giriniz.');
          document.getElementById('isMerkeziAdi').focus();
          return false;
        }

        if (!atolyeId) {
          e.preventDefault();
          alert('⚠️ Lütfen 3. Bağlı Olduğu Atölyeyi seçiniz.');
          document.getElementById('atolyeId').focus();
          return false;
        }

        const parsedSaat = parseFloat(saat);
        if (!saat || isNaN(parsedSaat) || parsedSaat <= 0 || parsedSaat > 24) {
          e.preventDefault();
          alert('⚠️ Lütfen 4. Günlük Çalışma Saatini (Kapasite) 0 ile 24 saat arasında geçerli bir değer olarak giriniz.');
          document.getElementById('gunlukCalismaSaati').focus();
          return false;
        }

        if (!durum) {
          e.preventDefault();
          alert('⚠️ Lütfen 5. Çalışma Durumunu seçiniz.');
          document.getElementById('durum').focus();
          return false;
        }

        if (isci !== '') {
          const parsedIsci = parseInt(isci, 10);
          if (isNaN(parsedIsci) || parsedIsci < 0) {
            e.preventDefault();
            alert('⚠️ Varsayılan personel/işçi sayısı negatif (0\'dan küçük) olamaz. Lütfen 0 veya daha büyük bir tam sayı giriniz.');
            document.getElementById('varsayilanIsciSayisi').focus();
            return false;
          }
        }
      });
    }

    function updateClock() { 
      const now = new Date(); 
      const el = document.getElementById('liveTime'); 
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); 
    }
    updateClock(); 
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
