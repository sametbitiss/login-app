<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>İş Merkezi Kapasite & İstasyon Yük Yönetimi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .capacity-summary-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .cap-stat-card {
      background: rgba(30, 41, 59, 0.5);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 16px;
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }
    .cap-stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }
    .cap-stat-label { font-size: 0.78rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
    .cap-stat-val { font-size: 1.45rem; font-weight: 900; color: #f8fafc; font-family: 'JetBrains Mono', monospace; }

    .work-centers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
      gap: 22px;
    }

    .wc-capacity-card {
      background: rgba(15, 23, 42, 0.75);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      box-shadow: 0 6px 24px rgba(0,0,0,0.25);
      transition: transform 0.2s ease, border-color 0.2s ease;
      position: relative;
      overflow: hidden;
    }
    .wc-capacity-card:hover {
      transform: translateY(-2px);
      border-color: rgba(99, 102, 241, 0.35);
    }

    .wc-capacity-card--busy {
      border-left: 5px solid #6366f1;
    }
    .wc-capacity-card--idle {
      border-left: 5px solid #10b981;
    }
    .wc-capacity-card--maintenance {
      border-left: 5px solid #f43f5e;
      background: rgba(30, 20, 30, 0.7);
    }
    .wc-capacity-card--inactive {
      border-left: 5px solid #64748b;
      opacity: 0.8;
    }

    .wc-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
    }
    .wc-title-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .wc-code-badge {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      font-size: 0.85rem;
      color: #818cf8;
      background: rgba(99, 102, 241, 0.15);
      padding: 2px 8px;
      border-radius: 6px;
      display: inline-block;
      width: fit-content;
      border: 1px solid rgba(99, 102, 241, 0.3);
    }
    .wc-name {
      font-size: 1.15rem;
      font-weight: 900;
      color: #ffffff;
      margin: 2px 0 0 0;
    }
    .wc-workshop-sub {
      font-size: 0.8rem;
      color: #94a3b8;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Status Pills */
    .wc-status-badge {
      padding: 6px 12px;
      border-radius: 10px;
      font-size: 0.8rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      letter-spacing: 0.3px;
    }
    .wc-status--idle {
      background: rgba(16, 185, 129, 0.18);
      color: #34d399;
      border: 1.5px solid rgba(16, 185, 129, 0.4);
    }
    .wc-status--busy {
      background: rgba(99, 102, 241, 0.2);
      color: #a5b4fc;
      border: 1.5px solid rgba(99, 102, 241, 0.5);
      animation: pulseGlow 2s infinite;
    }
    .wc-status--maintenance {
      background: rgba(244, 63, 94, 0.2);
      color: #fb7185;
      border: 1.5px solid rgba(244, 63, 94, 0.5);
    }
    .wc-status--inactive {
      background: rgba(100, 116, 139, 0.2);
      color: #94a3b8;
      border: 1.5px solid rgba(100, 116, 139, 0.4);
    }

    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 8px rgba(99, 102, 241, 0.2); }
      50% { box-shadow: 0 0 16px rgba(99, 102, 241, 0.5); }
    }

    /* Progress & Load */
    .wc-load-section {
      background: rgba(30, 41, 59, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 14px;
      padding: 14px 18px;
    }
    .wc-load-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      margin-bottom: 8px;
    }
    .wc-progress-track {
      width: 100%;
      height: 10px;
      background: rgba(15, 23, 42, 0.8);
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .wc-progress-fill {
      height: 100%;
      border-radius: 6px;
      transition: width 0.4s ease;
    }

    .wc-load-meta-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      text-align: center;
    }
    .wc-load-meta-item { display: flex; flex-direction: column; gap: 2px; }
    .wc-load-meta-lbl { font-size: 0.72rem; color: #64748b; font-weight: 600; text-transform: uppercase; }
    .wc-load-meta-val { font-size: 0.88rem; color: #cbd5e1; font-weight: 800; font-family: 'JetBrains Mono', monospace; }

    /* Active Running Work Order Block */
    .active-order-box {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(30, 41, 59, 0.6));
      border: 1.5px solid rgba(99, 102, 241, 0.35);
      border-radius: 14px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .active-order-title {
      font-size: 0.76rem;
      font-weight: 800;
      color: #818cf8;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .active-order-body {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .active-order-name {
      font-size: 0.95rem;
      font-weight: 800;
      color: #ffffff;
    }
    .active-order-meta {
      font-size: 0.8rem;
      color: #94a3b8;
      display: flex;
      gap: 12px;
      margin-top: 4px;
    }

    .no-active-order-box {
      background: rgba(16, 185, 129, 0.06);
      border: 1px dashed rgba(16, 185, 129, 0.25);
      border-radius: 12px;
      padding: 14px;
      text-align: center;
      font-size: 0.85rem;
      color: #34d399;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    /* Queued Orders List */
    .queue-section {
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 14px;
      padding: 14px;
    }
    .queue-title {
      font-size: 0.78rem;
      font-weight: 800;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .queue-item {
      background: rgba(30, 41, 59, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 8px;
      padding: 8px 12px;
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.825rem;
    }
    .queue-item:last-child { margin-bottom: 0; }

    /* Personnel & Workers info */
    .wc-personnel-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1.5px solid rgba(255, 255, 255, 0.07);
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .wc-supervisor-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.825rem;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .wc-shift-workers-box {
      cursor: pointer;
      background: rgba(99, 102, 241, 0.08);
      border: 1.5px dashed rgba(99, 102, 241, 0.3);
      border-radius: 10px;
      padding: 10px 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: all 0.2s ease;
    }
    .wc-shift-workers-box:hover {
      background: rgba(99, 102, 241, 0.16);
      border-color: rgba(99, 102, 241, 0.6);
      transform: translateY(-1px);
    }

    .worker-chip {
      background: rgba(99, 102, 241, 0.2);
      color: #cbd5e1;
      border: 1px solid rgba(99, 102, 241, 0.35);
      border-radius: 6px;
      padding: 2px 8px;
      font-size: 0.76rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* Actions Footer */
    .wc-actions-bar {
      display: flex;
      gap: 10px;
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .btn-action-cap {
      flex: 1;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 0.825rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.2s ease;
      border: 1px solid transparent;
      outline: none;
    }
    .btn-action-cap--maintenance {
      background: rgba(244, 63, 94, 0.15);
      color: #fb7185;
      border-color: rgba(244, 63, 94, 0.35);
    }
    .btn-action-cap--maintenance:hover {
      background: rgba(244, 63, 94, 0.3);
      color: #fff;
    }
    .btn-action-cap--resume {
      background: rgba(16, 185, 129, 0.2);
      color: #34d399;
      border-color: rgba(16, 185, 129, 0.4);
    }
    .btn-action-cap--resume:hover {
      background: rgba(16, 185, 129, 0.35);
      color: #fff;
    }
    .btn-action-cap--release {
      background: rgba(148, 163, 184, 0.12);
      color: #cbd5e1;
      border-color: rgba(148, 163, 184, 0.25);
    }
    .btn-action-cap--release:hover {
      background: rgba(148, 163, 184, 0.25);
      color: #fff;
    }

    /* Modal styling */
    .personnel-modal-backdrop {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(14px);
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .personnel-modal-window {
      background: #0f172a;
      border: 1.5px solid rgba(99, 102, 241, 0.3);
      border-radius: 20px;
      width: 100%;
      max-width: 900px;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
      position: relative;
    }

    .modal-user-row {
      cursor: pointer;
      transition: background 0.15s ease;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    .modal-user-row:hover {
      background: rgba(99, 102, 241, 0.08);
    }
    .modal-user-row.selected-row {
      background: rgba(99, 102, 241, 0.18);
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link active">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <!-- Page Header -->
      <div class="page-header" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div style="font-size: 0.85rem; color: #818cf8; font-weight: 700; margin-bottom: 4px;">🏭 FABRİKA TEZGAH PARKURU & SAHA YÜK DENGELEME</div>
          <h1 style="display: flex; align-items: center; gap: 10px;">
            <span>⚙️ İş Merkezi Kapasite Planlaması & İstasyon Yük Dengesi</span>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.92rem; margin-top: 4px;">
            Sistemdeki tüm iş merkezlerinin anlık çalışma statüleri, aktif iş emirleri, sırasını bekleyen kuyruklar, vardiya personeli atamaları ve doluluk oranları.
          </p>
        </div>
        <div style="display: flex; gap: 10px;">
          <a href="/production/work-centers" class="btn-action-cap btn-action-cap--release" style="text-decoration: none; padding: 10px 18px;">
            ⚙️ İş Merkezlerini Yönet
          </a>
          <a href="/production/orders" class="btn-action-cap btn-action-cap--resume" style="text-decoration: none; padding: 10px 18px;">
            📋 İş Emirleri Listesi
          </a>
        </div>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div style="background: rgba(16, 185, 129, 0.15); border: 1.5px solid rgba(16, 185, 129, 0.4); color: #34d399; padding: 14px 20px; border-radius: 12px; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>✓</span> <%= success %>
        </div>
      <% } %>

      <!-- Top Summary Metrics -->
      <% 
        const totalCenters = capacityReport.length;
        const busyCenters = capacityReport.filter(c => c.operationalStatus === 'Busy').length;
        const idleCenters = capacityReport.filter(c => c.operationalStatus === 'Idle').length;
        const maintCenters = capacityReport.filter(c => c.operationalStatus === 'Maintenance').length;
        const totalAllocatedHours = capacityReport.reduce((sum, c) => sum + c.allocatedHours, 0).toFixed(1);
        const totalHorizonHours = capacityReport.reduce((sum, c) => sum + c.horizonCapacityHours, 0).toFixed(1);
        const avgLoad = totalHorizonHours > 0 ? Math.round((totalAllocatedHours / totalHorizonHours) * 100) : 0;
      %>
      <div class="capacity-summary-cards">
        <div class="cap-stat-card">
          <div class="cap-stat-icon" style="background: rgba(99, 102, 241, 0.2); color: #818cf8;">⚙️</div>
          <div>
            <div class="cap-stat-label">Toplam İş Merkezi</div>
            <div class="cap-stat-val"><%= totalCenters %> <span style="font-size: 0.85rem; color: #94a3b8;">İstasyon</span></div>
          </div>
        </div>

        <div class="cap-stat-card">
          <div class="cap-stat-icon" style="background: rgba(16, 185, 129, 0.2); color: #34d399;">🟢</div>
          <div>
            <div class="cap-stat-label">Müsait (Boş) İstasyon</div>
            <div class="cap-stat-val" style="color: #34d399;"><%= idleCenters %> <span style="font-size: 0.85rem; color: #94a3b8;">Adet</span></div>
          </div>
        </div>

        <div class="cap-stat-card">
          <div class="cap-stat-icon" style="background: rgba(99, 102, 241, 0.25); color: #a5b4fc;">⚡</div>
          <div>
            <div class="cap-stat-label">Aktif Üretimde (Meşgul)</div>
            <div class="cap-stat-val" style="color: #818cf8;"><%= busyCenters %> <span style="font-size: 0.85rem; color: #94a3b8;">Adet</span></div>
          </div>
        </div>

        <div class="cap-stat-card">
          <div class="cap-stat-icon" style="background: rgba(244, 63, 94, 0.2); color: #fb7185;">🛠️</div>
          <div>
            <div class="cap-stat-label">Bakımda / Arızalı</div>
            <div class="cap-stat-val" style="color: <%= maintCenters > 0 ? '#fb7185' : '#cbd5e1' %>;"><%= maintCenters %> <span style="font-size: 0.85rem; color: #94a3b8;">Adet</span></div>
          </div>
        </div>

        <div class="cap-stat-card">
          <div class="cap-stat-icon" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24;">📊</div>
          <div>
            <div class="cap-stat-label">Genel Parkur Yükü</div>
            <div class="cap-stat-val" style="color: #fbbf24;">%<%= avgLoad %> <span style="font-size: 0.85rem; color: #94a3b8;">Doluluk</span></div>
          </div>
        </div>
      </div>

      <!-- WORK CENTERS GRID -->
      <div class="work-centers-grid">
        <% if (capacityReport.length === 0) { %>
          <div style="grid-column: 1 / -1; background: var(--bg-surface); border: 1px dashed var(--border); border-radius: 16px; padding: 3rem; text-align: center; color: var(--text-muted);">
            Sistemde kayıtlı iş merkezi bulunmamaktadır. <a href="/production/work-centers/add" style="color: #818cf8; font-weight: 700;">Buradan yeni iş merkezi ekleyebilirsiniz.</a>
          </div>
        <% } else { %>
          <% capacityReport.forEach(c => { %>
            <div class="wc-capacity-card wc-capacity-card--<%= c.operationalStatus.toLowerCase() %>">
              
              <!-- 1. CARD HEADER: Code, Name, Workshop, Status -->
              <div class="wc-card-header">
                <div class="wc-title-group">
                  <span class="wc-code-badge"><%= c.workCenterCode %></span>
                  <h3 class="wc-name"><%= c.workCenterName %></h3>
                  <div class="wc-workshop-sub">
                    <span>🏢 <%= c.atolyeName %></span>
                    <span>•</span>
                    <span>👥 <%= c.workersCount %> Personel Kapasiteli</span>
                  </div>
                </div>

                <!-- Anlık Statü Rozeti -->
                <div>
                  <% if (c.operationalStatus === 'Idle') { %>
                    <span class="wc-status-badge wc-status--idle">🟢 Boş (Müsait)</span>
                  <% } else if (c.operationalStatus === 'Busy') { %>
                    <span class="wc-status-badge wc-status--busy">⚡ Meşgul (Üretimde)</span>
                  <% } else if (c.operationalStatus === 'Maintenance') { %>
                    <span class="wc-status-badge wc-status--maintenance">🛠️ Bakımda / Arızalı</span>
                  <% } else { %>
                    <span class="wc-status-badge wc-status--inactive">⛔ Pasif</span>
                  <% } %>
                </div>
              </div>

              <!-- 2. DOLULUK VE KAPASİTE BARI -->
              <div class="wc-load-section">
                <div class="wc-load-header">
                  <span style="color: #94a3b8; font-weight: 700; font-size: 0.8rem;">
                    📊 İstasyon Doluluk Oranı (5 Günlük Vade)
                  </span>
                  <span style="font-family: 'JetBrains Mono', monospace; font-weight: 900; font-size: 0.95rem; color: <%= c.loadPercentage > 85 ? '#fb7185' : (c.loadPercentage > 50 ? '#fbbf24' : '#34d399') %>;">
                    %<%= c.loadPercentage %> Doluluk
                  </span>
                </div>

                <div class="wc-progress-track">
                  <div class="wc-progress-fill" style="width: <%= c.loadPercentage %>%; background: <%= c.loadPercentage > 85 ? 'linear-gradient(90deg, #f43f5e, #e11d48)' : (c.loadPercentage > 50 ? 'linear-gradient(90deg, #f59e0b, #d97706)' : 'linear-gradient(90deg, #10b981, #059669)') %>;"></div>
                </div>

                <div class="wc-load-meta-grid">
                  <div class="wc-load-meta-item">
                    <span class="wc-load-meta-lbl">Günlük Kapasite</span>
                    <span class="wc-load-meta-val"><%= c.dailyCapacityHours %> Sa/Gün</span>
                  </div>
                  <div class="wc-load-meta-item">
                    <span class="wc-load-meta-lbl">5 Günlük Kapasite</span>
                    <span class="wc-load-meta-val"><%= c.horizonCapacityHours %> Saat</span>
                  </div>
                  <div class="wc-load-meta-item">
                    <span class="wc-load-meta-lbl">Atanan Toplam Yük</span>
                    <span class="wc-load-meta-val" style="color: #fbbf24;"><%= c.allocatedHours %> Saat</span>
                  </div>
                  <div class="wc-load-meta-item">
                    <span class="wc-load-meta-lbl">Kullanılabilir Boş</span>
                    <span class="wc-load-meta-val" style="color: #34d399;"><%= c.availableHours %> Saat</span>
                  </div>
                </div>
              </div>

              <!-- 3. AKTİF ÇALIŞAN İŞ EMRİ BÖLÜMÜ -->
              <div>
                <div style="font-size: 0.76rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                  ⚡ Aktif Çalışan İş Emri
                </div>

                <% if (c.activeRunningOrder) { %>
                  <div class="active-order-box">
                    <div class="active-order-title">
                      <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #34d399;">
                        📋 <%= c.activeRunningOrder.isEmriNo %>
                      </span>
                      <span class="status-pill status-completed" style="font-size: 0.72rem; padding: 2px 8px;">
                        ⚡ <%= c.activeRunningOrder.oncelik %> Öncelikli
                      </span>
                    </div>

                    <div class="active-order-body">
                      <div>
                        <div class="active-order-name">
                          [<%= c.activeRunningOrder.stokKarti ? c.activeRunningOrder.stokKarti.stokKodu : '—' %>] 
                          <%= c.activeRunningOrder.stokKarti ? c.activeRunningOrder.stokKarti.ad : c.activeRunningOrder.uretimBasligi %>
                        </div>
                        <div class="active-order-meta">
                          <span>Miktar: <strong style="color: #f8fafc;"><%= parseFloat(c.activeRunningOrder.tamamlananMiktar || 0) %> / <%= parseFloat(c.activeRunningOrder.planlananMiktar) %> <%= c.activeRunningOrder.birim %></strong></span>
                          <span>•</span>
                          <span>Tahmini: <strong style="color: #fbbf24;"><%= c.activeRunningOrder.tahminiSaat || 0 %> Saat</strong></span>
                          <span>•</span>
                          <span>Termin: <strong style="color: #cbd5e1;"><%= c.activeRunningOrder.planlananBitisTarihi %></strong></span>
                        </div>
                      </div>
                    </div>
                  </div>
                <% } else { %>
                  <div class="no-active-order-box">
                    <span>🟢 Bu iş merkezinde şu anda aktif çalışan bir iş emri bulunmamaktadır (İstasyon Boş & Müsait).</span>
                  </div>
                <% } %>
              </div>

              <!-- 4. KUYRUKTA / SIRADA BEKLEYEN İŞ EMİRLERİ LİSTESİ -->
              <div class="queue-section">
                <div class="queue-title">
                  <span>⏳ Kuyrukta Sırasını Bekleyen İşler</span>
                  <span style="font-family: 'JetBrains Mono', monospace; color: #818cf8; font-size: 0.78rem;">
                    <%= c.queuedOrders.length %> Adet İş Emri
                  </span>
                </div>

                <% if (c.queuedOrders.length === 0) { %>
                  <div style="font-size: 0.8rem; color: #64748b; font-style: italic; padding: 6px 4px;">
                    Bu istasyona atanmış bekleyen kuyruk kaydı bulunmamaktadır.
                  </div>
                <% } else { %>
                  <div style="display: flex; flex-direction: column; gap: 6px;">
                    <% c.queuedOrders.forEach((qo, idx) => { %>
                      <div class="queue-item">
                        <div style="display: flex; align-items: center; gap: 8px;">
                          <span style="background: rgba(99, 102, 241, 0.2); color: #818cf8; font-size: 0.72rem; font-weight: 800; padding: 2px 6px; border-radius: 4px; font-family: 'JetBrains Mono', monospace;">
                            #<%= idx + 1 %>
                          </span>
                          <div>
                            <strong style="color: #cbd5e1; font-family: 'JetBrains Mono', monospace;"><%= qo.isEmriNo %></strong>
                            <div style="font-size: 0.75rem; color: #94a3b8;">
                              <%= qo.stokKarti ? qo.stokKarti.ad : qo.uretimBasligi %> (<%= parseFloat(qo.planlananMiktar) %> <%= qo.birim %>)
                            </div>
                          </div>
                        </div>
                        <div style="text-align: right;">
                          <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: #fbbf24; font-weight: 700;">
                            <%= qo.tahminiSaat || 0 %> Sa
                          </span>
                          <div style="font-size: 0.7rem; color: #64748b;">
                            <%= qo.durum === 'Approved' ? 'Onaylı' : 'Planlandı' %>
                          </div>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              </div>

              <!-- 5. PERSONEL, SORUMLU & VARDİYA PERSONELİ BİLGİSİ (Açılır Modal Eventli) -->
              <div class="wc-personnel-card">
                <!-- Sorumlu Bilgisi -->
                <div class="wc-supervisor-row">
                  <div>
                    <span style="color: #64748b; font-size: 0.74rem; display: block; font-weight: 700; text-transform: uppercase;">
                      👤 İstasyon / Atölye Sorumlusu
                    </span>
                    <strong style="color: #818cf8; font-size: 0.9rem;"><%= c.stationSupervisor || 'Tanımlı Sorumlu Yok' %></strong>
                  </div>
                  <% if (c.activeRunningOrder && c.activeRunningOrder.uretimYonetici && c.activeRunningOrder.uretimYonetici !== c.stationSupervisor) { %>
                    <div style="text-align: right;">
                      <span style="color: #64748b; font-size: 0.74rem; display: block; font-weight: 700; text-transform: uppercase;">
                        ⚡ Aktif Operatör
                      </span>
                      <span style="color: #34d399; font-weight: 700; font-size: 0.85rem;"><%= c.activeRunningOrder.uretimYonetici %></span>
                    </div>
                  <% } %>
                </div>

                <!-- Vardiya Personeli Box (Tıklanabilir Event) -->
                <div class="wc-shift-workers-box" onclick="openShiftPersonnelModal('<%= c.id %>', '<%= c.workCenterCode %>', '<%= c.workCenterName.replace(/'/g, "\\'") %>', <%= c.workersCount %>, <%= JSON.stringify(c.assignedPersonnelIds || []) %>)" title="Vardiya personeli atamak veya düzenlemek için tıklayınız">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #94a3b8; font-size: 0.76rem; font-weight: 800; text-transform: uppercase; display: flex; align-items: center; gap: 6px;">
                      <span>👥 Vardiya Personeli:</span>
                      <span style="color: <%= (c.assignedPersonnelList.length === c.workersCount) ? '#34d399' : '#fbbf24' %>; font-family: 'JetBrains Mono', monospace;">
                        <%= c.assignedPersonnelList.length %> / <%= c.workersCount %> Personel
                      </span>
                    </span>
                    <span style="font-size: 0.74rem; color: #818cf8; font-weight: 700; background: rgba(99, 102, 241, 0.15); padding: 2px 8px; border-radius: 6px; border: 1px solid rgba(99, 102, 241, 0.3);">
                      ⚙️ <%= c.assignedPersonnelList.length > 0 ? 'Personelleri Düzenle' : 'Personel Ata' %> ➔
                    </span>
                  </div>

                  <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px;">
                    <% if (c.assignedPersonnelList && c.assignedPersonnelList.length > 0) { %>
                      <% c.assignedPersonnelList.forEach(p => { %>
                        <span class="worker-chip">
                          <span>👤</span> <%= p.fullName %>
                        </span>
                      <% }); %>
                    <% } else { %>
                      <span style="font-size: 0.78rem; color: #94a3b8; font-style: italic;">
                        ⚠️ Henüz vardiya personeli atanmadı. Atamak için tıklayınız (<%= c.workersCount %> personel gereklidir).
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- 6. AKSİYON BUTONLARI -->
              <div class="wc-actions-bar">
                <% if (c.operationalStatus === 'Maintenance') { %>
                  <form action="/production/capacity/<%= c.id %>/maintenance" method="POST" style="flex: 1; margin: 0;">
                    <button type="submit" class="btn-action-cap btn-action-cap--resume" style="width: 100%;">
                      <span>✅ Bakımdan Çıkar / Devreye Al</span>
                    </button>
                  </form>
                <% } else { %>
                  <form action="/production/capacity/<%= c.id %>/maintenance" method="POST" style="flex: 1; margin: 0;">
                    <button type="submit" class="btn-action-cap btn-action-cap--maintenance" style="width: 100%;">
                      <span>🛠️ Bakıma Al / Arıza Bildir</span>
                    </button>
                  </form>
                <% } %>

                <form action="/production/capacity/<%= c.id %>/release" method="POST" style="flex: 1; margin: 0;">
                  <button type="submit" class="btn-action-cap btn-action-cap--release" style="width: 100%;">
                    <span>🔄 Boşalt / Serbest Bırak</span>
                  </button>
                </form>
              </div>

            </div>
          <% }); %>
        <% } %>
      </div>

    </main>
  </div>

  <!-- ======================================================================= -->
  <!-- VARDİYA PERSONELİ ATAMA MODALI (ÇOKLU SEÇİM & KESİN SINIR KURALI)       -->
  <!-- ======================================================================= -->
  <div id="shiftPersonnelModal" class="personnel-modal-backdrop">
    <div class="personnel-modal-window">
      
      <!-- Modal Header -->
      <div style="padding: 20px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: space-between; background: rgba(15, 23, 42, 0.95);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 1.5rem; background: rgba(99, 102, 241, 0.15); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(99, 102, 241, 0.3);">👥</span>
          <div>
            <h2 style="font-size: 1.2rem; font-weight: 800; color: #fff; margin: 0;">
              [<span id="modalWcCode" style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"></span>] 
              <span id="modalWcName"></span> — Vardiya Personeli Seçimi
            </h2>
            <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 2px;">
              İstasyon Kapasitesi: <strong style="color: #fbbf24;" id="modalRequiredCountBadge">0 Personel</strong> • 
              Lütfen listeden <strong>tam olarak <span id="modalRequiredCountText">0</span> personel</strong> seçiniz (Daha az veya daha fazla seçilemez).
            </p>
          </div>
        </div>
        <button type="button" onclick="closeShiftPersonnelModal()" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: var(--text-muted); width: 36px; height: 36px; border-radius: 10px; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">✕</button>
      </div>

      <!-- Search & Sort Controls -->
      <div style="padding: 14px 24px; background: rgba(30, 41, 59, 0.5); border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
        <div style="flex: 1; min-width: 260px; position: relative;">
          <input type="text" id="modalPersonnelSearch" oninput="renderModalPersonnelList()" placeholder="🔍 Personel adı, kullanıcı adı veya departman ara..." style="width: 100%; padding: 10px 14px 10px 38px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.875rem; outline: none; box-sizing: border-box;">
          <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;">🔍</span>
        </div>

        <div style="width: 280px;">
          <select id="modalPersonnelSort" onchange="renderModalPersonnelList()" style="width: 100%; padding: 10px 14px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.85rem; outline: none; font-weight: 600;">
            <option value="name_asc" selected>🔤 İsme Göre: A'dan Z'ye</option>
            <option value="name_desc">🔤 İsme Göre: Z'den A'ya</option>
            <option value="dept_asc">🏢 Departmana Göre: A-Z</option>
            <option value="uname_asc">👤 Kullanıcı Adına Göre: A-Z</option>
          </select>
        </div>
      </div>

      <!-- Personnel Table List -->
      <div style="flex: 1; overflow-y: auto; padding: 16px 24px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;">
          <thead>
            <tr style="background: rgba(30, 41, 59, 0.8); border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; position: sticky; top: 0; z-index: 10;">
              <th style="padding: 12px 14px; width: 60px; text-align: center;">Seç</th>
              <th style="padding: 12px 14px;">Personel Adı Soyadı</th>
              <th style="padding: 12px 14px; width: 180px;">Kullanıcı Adı</th>
              <th style="padding: 12px 14px; width: 220px;">Departman</th>
              <th style="padding: 12px 14px; width: 160px;">Unvan / Görev</th>
            </tr>
          </thead>
          <tbody id="modalPersonnelTbody">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div style="padding: 16px 24px; border-top: 1px solid rgba(255, 255, 255, 0.1); background: rgba(15, 23, 42, 0.95); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div id="modalSelectionStatusText" style="font-size: 0.88rem; font-weight: 800;">
          <!-- Dynamic status -->
        </div>

        <form id="shiftPersonnelForm" method="POST" action="" style="display: flex; gap: 12px; margin: 0;">
          <input type="hidden" name="personnelIds" id="modalPersonnelIdsInput" value="[]">
          
          <button type="button" class="btn btn-secondary" onclick="closeShiftPersonnelModal()" style="padding: 10px 20px; border-radius: 10px; font-weight: 600;">
            İptal
          </button>
          
          <button type="submit" id="btnSaveShiftPersonnel" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 800; padding: 10px 26px; border-radius: 10px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35); cursor: pointer; transition: all 0.2s;">
            ✅ Vardiya Personellerini Kaydet
          </button>
        </form>
      </div>

    </div>
  </div>

  <!-- Master Employees JSON Data -->
  <script id="allEmployeesCatalogData" type="application/json">
    <%- JSON.stringify(allEmployees || []) %>
  </script>

  <script>
    function updateClock() { 
      const now = new Date(); 
      const el = document.getElementById('liveTime'); 
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); 
    }
    updateClock(); 
    setInterval(updateClock, 1000);

    const employeesCatalog = JSON.parse(document.getElementById('allEmployeesCatalogData').textContent || '[]');

    let activeWcId = null;
    let activeWcRequiredCount = 1;
    let selectedPersonnelSet = new Set();
    let initialAssignedSet = new Set();

    function openShiftPersonnelModal(wcId, wcCode, wcName, requiredCount, currentAssignedIds) {
      activeWcId = wcId;
      activeWcRequiredCount = parseInt(requiredCount, 10) || 1;
      
      const modal = document.getElementById('shiftPersonnelModal');
      if (!modal) return;

      document.getElementById('modalWcCode').textContent = wcCode;
      document.getElementById('modalWcName').textContent = wcName;
      document.getElementById('modalRequiredCountBadge').textContent = activeWcRequiredCount + ' Personel';
      document.getElementById('modalRequiredCountText').textContent = activeWcRequiredCount;
      document.getElementById('shiftPersonnelForm').action = '/production/capacity/' + wcId + '/personnel';

      document.getElementById('modalPersonnelSearch').value = '';
      document.getElementById('modalPersonnelSort').value = 'name_asc';

      // Load currently assigned IDs
      selectedPersonnelSet = new Set();
      initialAssignedSet = new Set();
      if (Array.isArray(currentAssignedIds)) {
        currentAssignedIds.forEach(id => {
          selectedPersonnelSet.add(Number(id));
          initialAssignedSet.add(Number(id));
        });
      }

      modal.style.display = 'flex';
      renderModalPersonnelList();

      setTimeout(() => {
        const inp = document.getElementById('modalPersonnelSearch');
        if (inp) inp.focus();
      }, 100);
    }

    function closeShiftPersonnelModal() {
      const modal = document.getElementById('shiftPersonnelModal');
      if (modal) modal.style.display = 'none';
      activeWcId = null;
    }

    function togglePersonnelSelection(empId) {
      empId = Number(empId);
      if (selectedPersonnelSet.has(empId)) {
        selectedPersonnelSet.delete(empId);
      } else {
        if (selectedPersonnelSet.size >= activeWcRequiredCount) {
          alert('⚠️ Bu iş merkezi için tanımlı kapasite sınırı (' + activeWcRequiredCount + ' personel) dolmuştur!\nYeni bir personel eklemek için lütfen önce seçili personellerden birini kaldırınız.');
          return;
        }
        selectedPersonnelSet.add(empId);
      }
      renderModalPersonnelList();
    }

    function renderModalPersonnelList() {
      const tbody = document.getElementById('modalPersonnelTbody');
      if (!tbody) return;

      const searchVal = (document.getElementById('modalPersonnelSearch')?.value || '').toLowerCase().trim();
      const sortVal = document.getElementById('modalPersonnelSort')?.value || 'name_asc';

      // 1. Filter by search query
      let filtered = (employeesCatalog || []).filter(p => {
        const fullName = (p.fullName || (p.ad ? p.ad + ' ' + (p.soyad || '') : p.kullaniciAdi)).toLowerCase();
        const username = (p.kullaniciAdi || '').toLowerCase();
        const dept = (p.departman || '').toLowerCase();
        const title = (p.unvan || '').toLowerCase();

        return fullName.includes(searchVal) || username.includes(searchVal) || dept.includes(searchVal) || title.includes(searchVal);
      });

      // 2. Sort: Assigned personnel on TOP, then according to sortVal
      filtered.sort((a, b) => {
        const aSelected = selectedPersonnelSet.has(Number(a.id));
        const bSelected = selectedPersonnelSet.has(Number(b.id));

        // Selected items always go to TOP
        if (aSelected && !bSelected) return -1;
        if (!aSelected && bSelected) return 1;

        const nameA = (a.fullName || a.kullaniciAdi).toLowerCase();
        const nameB = (b.fullName || b.kullaniciAdi).toLowerCase();
        const deptA = (a.departman || '').toLowerCase();
        const deptB = (b.departman || '').toLowerCase();
        const unameA = (a.kullaniciAdi || '').toLowerCase();
        const unameB = (b.kullaniciAdi || '').toLowerCase();

        if (sortVal === 'name_desc') return nameB.localeCompare(nameA, 'tr');
        if (sortVal === 'dept_asc') return deptA.localeCompare(deptB, 'tr');
        if (sortVal === 'uname_asc') return unameA.localeCompare(unameB, 'tr');
        return nameA.localeCompare(nameB, 'tr');
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="padding: 36px; text-align: center; color: var(--text-muted);">
              🔍 Arama kriterlerine uygun personel kaydı bulunamadı.
            </td>
          </tr>
        `;
        updateModalSelectionUI();
        return;
      }

      tbody.innerHTML = filtered.map(p => {
        const isSelected = selectedPersonnelSet.has(Number(p.id));
        const isPreviouslyAssigned = initialAssignedSet.has(Number(p.id));

        return `
          <tr class="modal-user-row ${isSelected ? 'selected-row' : ''}" onclick="togglePersonnelSelection(${p.id})">
            <td style="padding: 12px 14px; text-align: center;">
              <input type="checkbox" ${isSelected ? 'checked' : ''} style="width: 18px; height: 18px; cursor: pointer; accent-color: #6366f1;" onclick="event.stopPropagation(); togglePersonnelSelection(${p.id})">
            </td>
            <td style="padding: 12px 14px;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 32px; height: 32px; border-radius: 8px; background: ${isSelected ? '#6366f1' : 'rgba(255,255,255,0.08)'}; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem;">
                  ${(p.ad ? p.ad.charAt(0) : p.kullaniciAdi.charAt(0)).toUpperCase()}
                </div>
                <div>
                  <strong style="color: #fff; font-size: 0.9rem;">${p.fullName}</strong>
                  ${isPreviouslyAssigned ? '<span style="background: rgba(16, 185, 129, 0.2); color: #34d399; font-size: 0.7rem; font-weight: 800; padding: 1px 6px; border-radius: 4px; margin-left: 6px;">⭐ Mevcut Atanmış</span>' : ''}
                </div>
              </div>
            </td>
            <td style="padding: 12px 14px; font-family: 'JetBrains Mono', monospace; color: #818cf8; font-weight: 700;">
              @${p.kullaniciAdi}
            </td>
            <td style="padding: 12px 14px; color: #cbd5e1;">
              🏢 ${p.departman || 'Genel Personel'}
            </td>
            <td style="padding: 12px 14px; color: #94a3b8;">
              👤 ${p.unvan || 'Personel'}
            </td>
          </tr>
        `;
      }).join('');

      updateModalSelectionUI();
    }

    function updateModalSelectionUI() {
      const statusEl = document.getElementById('modalSelectionStatusText');
      const saveBtn = document.getElementById('btnSaveShiftPersonnel');
      const hiddenInput = document.getElementById('modalPersonnelIdsInput');

      const count = selectedPersonnelSet.size;
      const req = activeWcRequiredCount;

      hiddenInput.value = JSON.stringify(Array.from(selectedPersonnelSet));

      if (count === req) {
        statusEl.innerHTML = `<span style="color: #34d399;">✓ Tam ${req} personel seçildi (${count}/${req} Personel)</span>`;
        saveBtn.disabled = false;
        saveBtn.style.opacity = '1';
        saveBtn.style.cursor = 'pointer';
      } else if (count < req) {
        const remaining = req - count;
        statusEl.innerHTML = `<span style="color: #fbbf24;">⚠️ ${remaining} personel daha seçmelisiniz (${count}/${req} Personel)</span>`;
        saveBtn.disabled = true;
        saveBtn.style.opacity = '0.5';
        saveBtn.style.cursor = 'not-allowed';
      } else {
        statusEl.innerHTML = `<span style="color: #fb7185;">🚨 Kapasite aşıldı! En fazla ${req} personel seçebilirsiniz (${count}/${req})</span>`;
        saveBtn.disabled = true;
        saveBtn.style.opacity = '0.5';
        saveBtn.style.cursor = 'not-allowed';
      }
    }

    document.getElementById('shiftPersonnelForm').addEventListener('submit', function(e) {
      if (selectedPersonnelSet.size !== activeWcRequiredCount) {
        e.preventDefault();
        alert('⚠️ Bu iş merkezi için tam olarak ' + activeWcRequiredCount + ' personel seçilmelidir!\nŞu an ' + selectedPersonnelSet.size + ' personel seçili.');
      }
    });
  </script>
</body>
</html>
