<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim Rotası ve Operasyon Adımı Hazırlama — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .form-container-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      margin-bottom: 30px;
      box-shadow: var(--shadow-sm);
    }

    .form-section {
      background: rgba(30, 41, 59, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .section-title {
      font-size: 0.98rem;
      font-weight: 800;
      color: #818cf8;
      display: flex;
      align-items: center;
      gap: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-label {
      font-size: 0.84rem;
      font-weight: 700;
      color: #94a3b8;
    }
    .form-control {
      background: #090e1a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: all 0.2s;
      width: 100%;
      box-sizing: border-box;
    }
    .form-control:focus {
      border-color: #6366f1;
      box-shadow: 0 0 14px rgba(99, 102, 241, 0.3);
    }
    .form-control[readonly] {
      background: #111827;
      color: #cbd5e1;
      border-color: #1f2937;
    }

    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .form-row-4 { display: grid; grid-template-columns: 0.8fr 1.2fr 2fr 1.5fr; gap: 16px; }

    /* Operation Dynamic Cards List */
    .op-card-list { display: flex; flex-direction: column; gap: 18px; }
    .op-card {
      background: #090e1a;
      border: 1.5px solid #1e293b;
      border-radius: 16px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      transition: all 0.2s;
    }
    .op-card:hover {
      border-color: rgba(99, 102, 241, 0.4);
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
    }

    .op-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 12px;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
    }
    .op-card-title {
      font-size: 0.92rem;
      font-weight: 800;
      color: #818cf8;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-add-step {
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 10px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-add-step:hover { background: rgba(16, 185, 129, 0.25); transform: translateY(-1px); }

    .btn-del-card {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.3);
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }
    .btn-del-card:hover { background: rgba(239, 68, 68, 0.3); color: #fff; }

    .form-actions-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 10px;
    }

    .btn-save-routing {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff;
      font-weight: 800;
      font-size: 1rem;
      padding: 14px 32px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .btn-save-routing:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(99, 102, 241, 0.6); }

    .btn-back-link {
      background: rgba(148, 163, 184, 0.1);
      color: #94a3b8;
      border: 1px solid rgba(148, 163, 184, 0.25);
      padding: 10px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      text-decoration: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-back-link:hover { background: rgba(148, 163, 184, 0.2); color: #fff; }

    /* BOM Reference Card */
    .bom-reference-box {
      background: rgba(15, 23, 42, 0.9);
      border: 1.5px solid rgba(99, 102, 241, 0.25);
      border-radius: 14px;
      padding: 18px 22px;
      margin-top: 12px;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub"><a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a></div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Talepler</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link active">🛠️ Rotalama & Operasyonlar</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <!-- Page Header & Navigation Breadcrumb -->
      <div class="page-header" style="margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;">
        <div>
          <div style="font-size: 0.85rem; color: #818cf8; font-weight: 700; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/production/routing" style="color: #818cf8; text-decoration: none;">🛠️ Üretim Rotaları</a>
            <span>›</span>
            <span style="color: var(--text-secondary);"><%= targetProduct ? targetProduct.stockCode + ' — Rota Düzenleme' : 'Yeni Rota Tanımlama' %></span>
          </div>
          <h1><%= targetProduct ? '🛠️ Rota & Operasyonu Düzenle: ' + targetProduct.name : '➕ Yeni Ürün Üretim Rotası ve Operasyon Adımları Tanımlama' %></h1>
          <p style="color: var(--text-secondary); font-size: 0.92rem; margin-top: 4px;">Sadece reçetesi tanımlanmış ve rotası henüz yazılmamış ürünler için operasyon adımlarını, hazırlık/ayar ve birim işlem sürelerini belirleyin.</p>
        </div>
        <a href="/production/routing" class="btn-back-link">
          <span>← Rotalar Listesine Dön</span>
        </a>
      </div>

      <% 
        const safeCandidateProducts = (typeof candidateProducts !== 'undefined' && candidateProducts) ? candidateProducts : [];
        const safeExistingOperations = (typeof existingOperations !== 'undefined' && existingOperations) ? existingOperations : [];
        const safeTargetBOMComponents = (typeof targetBOMComponents !== 'undefined' && targetBOMComponents) ? targetBOMComponents : [];

        // Exclude products that already have a routing when creating a NEW routing
        const availableRoutingProducts = safeCandidateProducts.filter(p => {
          if (targetProduct && String(targetProduct.id) === String(p.id)) return true;
          return !p.hasRouting;
        });
      %>

      <form action="/production/routing/save" method="POST" id="routingFullForm" onsubmit="prepareFormSubmit(event)">
        <input type="hidden" name="stockItemId" id="stockItemId" value="<%= targetProduct ? targetProduct.id : '' %>">
        <input type="hidden" name="operationsJson" id="operationsJson">

        <div class="form-container-card">
          <!-- 1. Hedef Ürün Seçimi -->
          <div class="form-section">
            <div class="section-title">
              <span>1. Rota Tanımlanacak Hedef Ürün (Yalnızca Reçeteli ve Rotası Eksik Ürünler)</span>
            </div>
            <div class="form-group">
              <label class="form-label">Ürün Seçiniz (Mamul veya Yarı Mamul) *</label>
              <select id="stockItemIdSelect" class="form-control" onchange="onTargetProductSelectChange(this)" required style="cursor: pointer;">
                <option value="">-- Reçetesi Tanımlı ve Rotası Eksik Ürünü Seçiniz --</option>
                <% if (availableRoutingProducts.length === 0) { %>
                  <option value="" disabled style="color: #f87171;">(Sistemdeki tüm reçeteli ürünlerin rotası tanımlanmıştır)</option>
                <% } else { %>
                  <% availableRoutingProducts.forEach(p => { %>
                    <% const isSelected = targetProduct && String(targetProduct.id) === String(p.id); %>
                    <option value="<%= p.id %>" data-code="<%= p.stockCode %>" data-name="<%= p.name.replace(/"/g, '\\"') %>" data-cat="<%= p.category %>" <%= isSelected ? 'selected' : '' %>>
                      [<%= p.category === 'Mamul' ? 'Mamul' : 'Yarı Mamul' %>] <%= p.stockCode %> — <%= p.name %> (Mevcut Stok: <%= p.currentStock %> <%= p.unit %>)
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <!-- Target Product's BOM Components Visual Reference Box -->
            <div id="bomReferenceContainer">
              <% if (safeTargetBOMComponents.length > 0) { %>
                <div class="bom-reference-box">
                  <div style="font-size: 0.88rem; font-weight: 800; color: #818cf8; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                    <span>📜 Ürüne Ait Reçete Bileşenleri Listesi (Operasyon Mühendisliği Referansı):</span>
                  </div>
                  <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                    <% safeTargetBOMComponents.forEach(c => { %>
                      <div style="background: rgba(30, 41, 59, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); padding: 6px 12px; border-radius: 8px; font-size: 0.82rem; color: #cbd5e1;">
                        <strong style="color: #34d399;"><%= c.code %></strong> — <%= c.name %> (<%= c.qty %> <%= c.unit %>)
                      </div>
                    <% }); %>
                  </div>
                </div>
              <% } %>
            </div>
          </div>

          <!-- 2. Operasyon Adımları ve Süreleri -->
          <div class="form-section">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <div class="section-title" style="border-bottom: none; padding-bottom: 0;">
                <span>2. Operasyon Adımları (Rota Mühendislik Akışı)</span>
              </div>
              <button type="button" class="btn-add-step" onclick="addOperationCard()">
                ➕ Yeni Operasyon Adımı Ekle
              </button>
            </div>

            <div id="operationCardContainer" class="op-card-list">
              <!-- Dynamic operation cards inserted via JS -->
            </div>
          </div>

          <!-- 3. Süre ve Operatör Hesaplama Özeti -->
          <div class="form-section">
            <div class="section-title">
              <span>3. Toplam Rota Süresi ve Kapasite Özeti</span>
            </div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
              <div style="background: rgba(99, 102, 241, 0.1); border: 1.5px solid rgba(99, 102, 241, 0.3); padding: 16px 20px; border-radius: 12px;">
                <div style="font-size: 0.8rem; font-weight: 700; color: #818cf8; text-transform: uppercase;">Toplam Adım Sayısı</div>
                <div id="formTotalSteps" style="font-size: 1.5rem; font-weight: 800; color: #fff; margin-top: 4px;">0 Adım</div>
              </div>
              <div style="background: rgba(245, 158, 11, 0.1); border: 1.5px solid rgba(245, 158, 11, 0.3); padding: 16px 20px; border-radius: 12px;">
                <div style="font-size: 0.8rem; font-weight: 700; color: #fbbf24; text-transform: uppercase;">Toplam Ayar / Hazırlık Süresi</div>
                <div id="formTotalSetupTime" style="font-size: 1.5rem; font-weight: 800; color: #fbbf24; margin-top: 4px;">0 Dk</div>
              </div>
              <div style="background: rgba(16, 185, 129, 0.1); border: 1.5px solid rgba(16, 185, 129, 0.3); padding: 16px 20px; border-radius: 12px;">
                <div style="font-size: 0.8rem; font-weight: 700; color: #a7f3d0; text-transform: uppercase;">Birim Parça İşlem Süresi</div>
                <div id="formTotalRunTime" style="font-size: 1.5rem; font-weight: 800; color: #34d399; margin-top: 4px;">0 Dk / Adet</div>
              </div>
            </div>
          </div>

          <!-- Actions Bar -->
          <div class="form-actions-bar">
            <a href="/production/routing" class="btn-back-link">İptal ve Geri Dön</a>
            <button type="submit" class="btn-save-routing">
              💾 Rotayı Kaydet ve Yayınla
            </button>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script>
    const workCentersList = [
      "İstasyon-1 (Kesim & Büküm)",
      "İstasyon-2 (Kaynak & Sac İşleme)",
      "İstasyon-3 (CNC & Talaşlı İmalat)",
      "İstasyon-4 (Boya & Kaplama)",
      "İstasyon-5 (Montaj & Test)",
      "İstasyon-6 (Paketleme & Sevkiyat)"
    ];

    const bomComponentsMap = <%- JSON.stringify(typeof bomComponentsMap !== 'undefined' ? bomComponentsMap : {}) %>;
    const existingOperationsData = <%- JSON.stringify(safeExistingOperations) %>;
    let cardCounter = 0;

    window.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('operationCardContainer');
      container.innerHTML = '';
      cardCounter = 0;

      if (existingOperationsData && existingOperationsData.length > 0) {
        existingOperationsData.forEach(op => {
          addOperationCard({
            operationSeq: op.operationSeq,
            operationCode: op.operationCode,
            operationName: op.operationName,
            workCenter: op.workCenter,
            setupTimeMinutes: op.setupTimeMinutes,
            runTimeMinutesPerUnit: op.runTimeMinutesPerUnit,
            operatorCount: op.operatorCount,
            instructions: op.instructions
          });
        });
      } else {
        addOperationCard({ operationSeq: 10, operationName: 'Kesim & Şekillendirme Operasyonu', workCenter: 'İstasyon-1 (Kesim & Büküm)' });
        addOperationCard({ operationSeq: 20, operationName: 'Montaj & Birleştirme Operasyonu', workCenter: 'İstasyon-5 (Montaj & Test)' });
      }

      const selectEl = document.getElementById('stockItemIdSelect');
      if (selectEl && selectEl.value) {
        onTargetProductSelectChange(selectEl);
      }

      calculateRoutingTotals();
    });

    function getSelectedTargetProductId() {
      const selectEl = document.getElementById('stockItemIdSelect');
      return (selectEl && selectEl.value) ? selectEl.value : document.getElementById('stockItemId').value;
    }

    function renderOperationComponentsChecklist(prodId, preselectedCodes = []) {
      const components = bomComponentsMap[prodId] || [];
      if (!prodId || components.length === 0) {
        return '<div style="font-size: 0.82rem; color: #94a3b8; font-style: italic;">(Bu operasyon adımına reçeteden parça/bileşen bağlamak için yukarıdan hedef ürün seçiniz)</div>';
      }

      let html = '<div class="op-components-checklist" style="display: flex; flex-wrap: wrap; gap: 8px;">';
      components.forEach(c => {
        let isChecked = false;
        if (Array.isArray(preselectedCodes)) {
          isChecked = preselectedCodes.includes(c.code) || preselectedCodes.includes(String(c.id));
        } else if (typeof preselectedCodes === 'string') {
          isChecked = preselectedCodes.includes(c.code);
        }

        const isYari = c.category === 'Yarı_Mamul' || c.category === 'Yari_Mamul';
        const catBadge = c.category === 'Hammadde' ? '📦 Hammadde' : (isYari ? '⚙️ Yarı Mamul' : '🏷️ Ticari Mal');

        html += `
          <label class="comp-pill-label" style="background: rgba(30, 41, 59, 0.7); border: 1.5px solid rgba(255, 255, 255, 0.1); padding: 6px 12px; border-radius: 8px; font-size: 0.82rem; color: #f8fafc; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; user-select: none;">
            <input type="checkbox" class="op-comp-checkbox" value="${c.code}" ${isChecked ? 'checked' : ''} style="cursor: pointer; accent-color: #6366f1; width: 15px; height: 15px;">
            <span style="font-size: 0.72rem; color: #818cf8; font-weight: 700;">${catBadge}</span>
            <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;">${c.code}</strong>
            <span>${c.name}</span>
            <span style="color: #fbbf24; font-weight: 700;">(${c.qty} ${c.unit})</span>
          </label>
        `;
      });
      html += '</div>';
      return html;
    }

    function refreshAllOperationCardComponentChecklists() {
      const prodId = getSelectedTargetProductId();
      const cards = document.querySelectorAll('#operationCardContainer .op-card');
      cards.forEach(card => {
        const container = card.querySelector('.op-components-checklist-container');
        if (container) {
          // preserve existing checked values
          const checked = Array.from(card.querySelectorAll('.op-comp-checkbox:checked')).map(cb => cb.value);
          container.innerHTML = renderOperationComponentsChecklist(prodId, checked);
        }
      });
    }

    function onTargetProductSelectChange(selectEl) {
      const selectedOption = selectEl.options[selectEl.selectedIndex];
      const container = document.getElementById('bomReferenceContainer');

      if (selectedOption && selectedOption.value) {
        const prodId = selectedOption.value;
        document.getElementById('stockItemId').value = prodId;

        const components = bomComponentsMap[prodId] || [];
        if (components.length > 0) {
          let compsHtml = `
            <div class="bom-reference-box">
              <div style="font-size: 0.9rem; font-weight: 800; color: #818cf8; margin-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                <span>📜 Seçilen Ürünün Reçete Bileşenleri (${components.length} Kalem):</span>
              </div>
              <p style="font-size: 0.82rem; color: #94a3b8; margin: 0 0 12px 0;">
                💡 <strong>Mühendislik İpucu:</strong> Aşağıdaki reçete bileşenlerini (bükümlü parçalar, kaynaklı montaj grupları, civata vb.) girdi olarak kullanarak Kesim, Büküm, Kaynak, Montaj veya Kalite Kontrol operasyon adımlarını aşağıda sırasıyla tanımlayabilirsiniz.
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          `;
          components.forEach(c => {
            const isYari = c.category === 'Yarı_Mamul' || c.category === 'Yari_Mamul';
            const catBadge = c.category === 'Hammadde' ? '📦 Hammadde' : (isYari ? '⚙️ Yarı Mamul' : '🏷️ Ticari Mal');
            const badgeColor = c.category === 'Hammadde' ? 'rgba(59, 130, 246, 0.25)' : (isYari ? 'rgba(245, 158, 11, 0.25)' : 'rgba(16, 185, 129, 0.25)');
            const textColor = c.category === 'Hammadde' ? '#60a5fa' : (isYari ? '#fbbf24' : '#34d399');

            compsHtml += `
              <div style="background: #0f172a; border: 1.5px solid rgba(99, 102, 241, 0.3); padding: 8px 14px; border-radius: 10px; font-size: 0.84rem; color: #f8fafc; display: flex; align-items: center; gap: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.3);">
                <span style="font-size: 0.75rem; background: ${badgeColor}; color: ${textColor}; padding: 2px 6px; border-radius: 6px; font-weight: 700;">${catBadge}</span>
                <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;">${c.code}</strong>
                <span style="font-weight: 600;">${c.name}</span>
                <span style="color: #fbbf24; font-weight: 800; margin-left: 4px;">(${c.qty} ${c.unit})</span>
              </div>
            `;
          });
          compsHtml += `</div></div>`;
          container.innerHTML = compsHtml;
        } else {
          container.innerHTML = '<div style="margin-top: 10px; font-size: 0.85rem; color: #fbbf24;">⚠️ Bu ürünün reçetesinde kayıtlı bileşen bulunamadı.</div>';
        }
      } else {
        document.getElementById('stockItemId').value = '';
        container.innerHTML = '';
      }

      refreshAllOperationCardComponentChecklists();
    }

    function addOperationCard(data = {}) {
      cardCounter++;
      const container = document.getElementById('operationCardContainer');
      const card = document.createElement('div');
      card.className = 'op-card';

      const defaultSeq = data.operationSeq || (cardCounter * 10);
      const defaultCode = data.operationCode || `OPS-${String(defaultSeq).padStart(2, '0')}`;

      let opOptionsHtml = '<option value="">-- İstasyon Sınıfı / İş Merkezi Seçiniz --</option>';
      workCentersList.forEach(wc => {
        const selected = data.workCenter === wc ? 'selected' : '';
        opOptionsHtml += `<option value="${wc}" ${selected}>${wc}</option>`;
      });

      const currentTargetProdId = getSelectedTargetProductId();
      let preselectedUsedComponents = [];
      if (data.usedComponents) {
        try {
          preselectedUsedComponents = typeof data.usedComponents === 'string' ? JSON.parse(data.usedComponents) : data.usedComponents;
        } catch (e) {
          preselectedUsedComponents = [data.usedComponents];
        }
      }

      const compChecklistHtml = renderOperationComponentsChecklist(currentTargetProdId, preselectedUsedComponents);

      card.innerHTML = `
        <div class="op-card-header">
          <div class="op-card-title">
            <span>🛠️ Operasyon Adımı #${cardCounter}</span>
          </div>
          <button type="button" class="btn-del-card" onclick="removeOperationCard(this)">🗑️ Adımı Sil</button>
        </div>

        <div class="form-row-4">
          <div class="form-group">
            <label class="form-label">Sıra No (Seq) *</label>
            <input type="number" class="form-control op-seq" value="${defaultSeq}" min="1" step="5" required>
          </div>
          <div class="form-group">
            <label class="form-label">Operasyon Kodu *</label>
            <input type="text" class="form-control op-code" value="${defaultCode}" placeholder="Örn: OPS-10-KAYNAK" required>
          </div>
          <div class="form-group">
            <label class="form-label">Operasyon Adı *</label>
            <input type="text" class="form-control op-name" value="${data.operationName || ''}" placeholder="Örn: Gazaltı Kaynağı ve Sac Bükümü" required>
          </div>
          <div class="form-group">
            <label class="form-label">İstasyon Sınıfı / İş Merkezi *</label>
            <select class="form-control op-wc" required>
              ${opOptionsHtml}
            </select>
          </div>
        </div>

        <!-- Operation Step Component Assignment Checklist -->
        <div class="form-group" style="background: rgba(15, 23, 42, 0.6); padding: 12px 16px; border-radius: 12px; border: 1px dashed rgba(99, 102, 241, 0.25);">
          <label class="form-label" style="color: #818cf8; display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">
            <span>📦 Bu Operasyon Adımında İşlenen / Birleştirilen Reçete Bileşenleri (Çoklu Seçilebilir)</span>
          </label>
          <div class="op-components-checklist-container">
            ${compChecklistHtml}
          </div>
        </div>

        <div class="form-row-3">
          <div class="form-group">
            <label class="form-label">Hazırlık / Ayar Süresi (Dk) *</label>
            <input type="number" class="form-control op-setup" value="${data.setupTimeMinutes !== undefined ? data.setupTimeMinutes : 15.0}" min="0" step="1" oninput="calculateRoutingTotals()" required>
          </div>
          <div class="form-group">
            <label class="form-label">Operasyon / İşlem Süresi (Dk / Adet) *</label>
            <input type="number" class="form-control op-run" value="${data.runTimeMinutesPerUnit !== undefined ? data.runTimeMinutesPerUnit : 5.0}" min="0.01" step="0.1" oninput="calculateRoutingTotals()" required>
          </div>
          <div class="form-group">
            <label class="form-label">Gerekli Personel / Operatör Sayısı *</label>
            <input type="number" class="form-control op-operators" value="${data.operatorCount || 1}" min="1" step="1" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Açıklama / İş Talimatı Notları (SOP / Çalışma Kılavuzu)</label>
          <input type="text" class="form-control op-instructions" value="${data.instructions || ''}" placeholder="Örn: Kaynak yapılacak bölgede çapak bırakılmayacak, mikrometre ölçümü kontrol edilecek">
        </div>
      `;

      container.appendChild(card);
      calculateRoutingTotals();
    }

    function removeOperationCard(btn) {
      const card = btn.closest('.op-card');
      if (card) card.remove();
      calculateRoutingTotals();
    }

    function calculateRoutingTotals() {
      const cards = document.querySelectorAll('#operationCardContainer .op-card');
      let totalSetup = 0;
      let totalRun = 0;

      cards.forEach(card => {
        const setup = parseFloat(card.querySelector('.op-setup').value) || 0;
        const run = parseFloat(card.querySelector('.op-run').value) || 0;
        totalSetup += setup;
        totalRun += run;
      });

      document.getElementById('formTotalSteps').textContent = cards.length + ' Adım';
      document.getElementById('formTotalSetupTime').textContent = totalSetup.toLocaleString('tr-TR') + ' Dk';
      document.getElementById('formTotalRunTime').textContent = totalRun.toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 2 }) + ' Dk / Adet';
    }

    function prepareFormSubmit(event) {
      const productSelect = document.getElementById('stockItemIdSelect');
      const hiddenStockItemId = document.getElementById('stockItemId');

      if (!hiddenStockItemId.value && productSelect.value) {
        hiddenStockItemId.value = productSelect.value;
      }

      if (!hiddenStockItemId.value) {
        alert('Lütfen rotası oluşturulacak hedef ürünü seçiniz!');
        event.preventDefault();
        return false;
      }

      const cards = document.querySelectorAll('#operationCardContainer .op-card');
      const opsArr = [];

      cards.forEach(card => {
        const name = card.querySelector('.op-name').value;
        if (name) {
          const checkedCheckboxes = Array.from(card.querySelectorAll('.op-comp-checkbox:checked')).map(cb => cb.value);

          opsArr.push({
            operationSeq: parseInt(card.querySelector('.op-seq').value, 10) || 10,
            operationCode: card.querySelector('.op-code').value || 'OPS-01',
            operationName: name,
            workCenter: card.querySelector('.op-wc').value || 'İstasyon-1 (Kesim & Büküm)',
            setupTimeMinutes: parseFloat(card.querySelector('.op-setup').value) || 15.0,
            runTimeMinutesPerUnit: parseFloat(card.querySelector('.op-run').value) || 5.0,
            operatorCount: parseInt(card.querySelector('.op-operators').value, 10) || 1,
            instructions: card.querySelector('.op-instructions').value || null,
            usedComponents: checkedCheckboxes
          });
        }
      });

      document.getElementById('operationsJson').value = JSON.stringify(opsArr);
    }

    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
