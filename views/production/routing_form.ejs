<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim Rotası ve Operasyon Adımları — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
  <style>
    .form-container-card {
      background: rgba(30, 41, 59, 0.45);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      max-width: 1100px;
      margin: 0 auto 40px auto;
    }

    .form-section-header {
      font-size: 1.05rem;
      font-weight: 800;
      color: #818cf8;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 12px;
    }

    /* Operation Cards */
    .op-cards-wrapper {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-bottom: 24px;
    }

    .op-card-box {
      background: rgba(15, 23, 42, 0.85);
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      border-radius: 18px;
      padding: 22px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      transition: all 0.2s ease;
      position: relative;
    }
    .op-card-box:hover {
      border-color: rgba(99, 102, 241, 0.45);
      box-shadow: 0 6px 25px rgba(99, 102, 241, 0.2);
    }

    .op-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 14px;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
      margin-bottom: 16px;
    }

    .op-card-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #818cf8;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-add-step-action {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.18), rgba(5, 150, 105, 0.22));
      color: #34d399;
      border: 1.5px dashed rgba(16, 185, 129, 0.45);
      padding: 14px 24px;
      border-radius: 14px;
      font-weight: 800;
      font-size: 0.92rem;
      cursor: pointer;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.2s ease;
    }
    .btn-add-step-action:hover {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(5, 150, 105, 0.35));
      border-color: #34d399;
      transform: translateY(-1px);
      box-shadow: 0 4px 18px rgba(16, 185, 129, 0.25);
    }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link active">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link active">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <!-- Breadcrumb & Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 12px;">
        <div>
          <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/production/routing" style="color: var(--text-muted); text-decoration: none;">🛠️ Rotalama & Operasyonlar</a>
            <span>/</span>
            <span style="color: #818cf8; font-weight: 600;"><%= targetProduct ? `[${targetProduct.stokKodu}] ${targetProduct.ad}` : 'Rota Oluştur' %></span>
          </div>
          <h1 style="font-size: 1.65rem; font-weight: 900; color: #fff; margin: 0; letter-spacing: -0.5px;">
            <%= targetProduct ? `🛠️ [${targetProduct.stokKodu}] Üretim Rotası ve Operasyon Adımları` : '🛠️ Yeni Üretim Rotası Tanımlama' %>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            Ürünün imalat sahasında izleyeceği istasyon sırası, operasyon adımları, hazırlık ve işlem süreleri.
          </p>
        </div>
        <a href="/production/routing" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; border-radius: 12px; padding: 10px 20px;">
          <span>←</span> Rota Listesine Dön
        </a>
      </div>

      <!-- Main Form Container -->
      <div class="form-container-card">
        
        <form action="/production/routing/save" method="POST" id="routingForm">
          <input type="hidden" name="operationsJson" id="operationsJson" value="">

          <!-- Section 1: Product Selection Header -->
          <div class="form-section-header">
            <span>📦</span> Rotası Tanımlanacak Ürün Bilgisi
          </div>

          <div class="form-grid form-grid--2" style="margin-bottom: 2rem;">
            <div class="input-group">
              <label for="stockItemId" style="font-weight: 700;">
                Hedef Mamul / Yarı Mamul Ürün <span style="color: #f43f5e;">*</span>
              </label>
              <% if (targetProduct) { %>
                <input type="hidden" name="stockItemId" id="stockItemId" value="<%= targetProduct.id %>">
                <input type="text" readonly value="[<%= targetProduct.stokKodu %>] <%= targetProduct.ad %> (<%= targetProduct.kategori %>)"
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #34d399; background: rgba(15, 23, 42, 0.9); border: 1.5px solid rgba(52, 211, 153, 0.35); cursor: not-allowed;">
              <% } else { %>
                <select name="stockItemId" id="stockItemId" required onchange="onProductSelectChange(this.value)" style="font-weight: 700;">
                  <option value="">— Lütfen Reçeteli Bir Ürün Seçiniz —</option>
                  <% candidateProducts.forEach(p => { %>
                    <option value="<%= p.id %>">
                      [<%= p.stokKodu %>] <%= p.ad %> (<%= p.kategori %>) <%= p.hasRouting ? '— (✓ Rota Var)' : '— (⚠️ Rota Yok)' %>
                    </option>
                  <% }); %>
                </select>
              <% } %>
            </div>

            <div class="input-group">
              <label style="font-weight: 700;">Rota Kodu / Versiyon</label>
              <input type="text" readonly value="<%= targetProduct ? `ROT-${targetProduct.stokKodu}-v1` : 'Sistem Tarafından Otomatik Üretilir' %>" 
                style="font-family: 'JetBrains Mono', monospace; font-weight: 600; color: #818cf8; background: rgba(15, 23, 42, 0.8); border: 1.5px solid rgba(255,255,255,0.1); cursor: not-allowed;">
            </div>
          </div>

          <!-- Section 2: Operations Steps Builder -->
          <div class="form-section-header">
            <span>⚙️</span> Operasyon / Rotalama Adımları
            <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted);" id="stepCountBadge">
              <%= existingOperations ? existingOperations.length : 0 %> Adım Tanımlı
            </span>
          </div>

          <!-- Container for Dynamic Operation Cards -->
          <div class="op-cards-wrapper" id="opCardsContainer">
            <!-- Dynamic Cards Injected via JS or SSR -->
          </div>

          <!-- Add Step Action Button -->
          <div style="margin-bottom: 2.5rem;">
            <button type="button" class="btn-add-step-action" onclick="addNewOperationStep()">
              <span style="font-size: 1.2rem;">➕</span>
              <span>Yeni Operasyon Adımı Ekle (+10)</span>
            </button>
          </div>

          <!-- Form Actions Bar -->
          <div style="display: flex; justify-content: flex-end; gap: 14px; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 20px;">
            <a href="/production/routing" class="btn btn-secondary" style="padding: 11px 24px; border-radius: 12px; font-weight: 700;">
              Vazgeç
            </a>
            <button type="submit" class="btn btn-primary" id="btnSubmitRouting" style="background: linear-gradient(135deg, #6366f1 0%, #10b981 100%); color: #fff; border: none; font-weight: 800; font-size: 0.95rem; padding: 11px 34px; border-radius: 12px; box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4); cursor: pointer;">
              💾 Rota ve Operasyon Adımlarını Kaydet
            </button>
          </div>

        </form>
      </div>

    </main>
  </div>

  <!-- Raw Initial Data Embeds -->
  <script id="allWorkCentersData" type="application/json">
    <%- JSON.stringify(allWorkCenters || []) %>
  </script>
  <script id="existingOperationsData" type="application/json">
    <%- JSON.stringify(existingOperations || []) %>
  </script>

  <script>
    const workCentersCatalog = JSON.parse(document.getElementById('allWorkCentersData').textContent || '[]');
    const existingOpsList = JSON.parse(document.getElementById('existingOperationsData').textContent || '[]');

    let operationsData = [];

    // Automatic re-indexing (10, 20, 30, 40...)
    function reindexOperations() {
      operationsData.forEach((op, idx) => {
        op.operasyonSira = (idx + 1) * 10;
      });
    }

    // Initialize operations data
    if (existingOpsList && existingOpsList.length > 0) {
      operationsData = existingOpsList.map((op, idx) => ({
        operasyonSira: (idx + 1) * 10,
        operasyonAdi: op.operasyonAdi || '',
        isMerkezi: op.isMerkezi || '',
        isMerkeziId: op.isMerkeziId || '',
        hazirlikSuresiDakika: op.hazirlikSuresiDakika !== undefined && op.hazirlikSuresiDakika !== null ? op.hazirlikSuresiDakika : '',
        calismaSuresiDakikaBirim: op.calismaSuresiDakikaBirim !== undefined && op.calismaSuresiDakikaBirim !== null ? op.calismaSuresiDakikaBirim : '',
        operatorSayisi: op.operatorSayisi !== undefined && op.operatorSayisi !== null ? op.operatorSayisi : '',
        durum: op.durum || 'Active'
      }));
      reindexOperations();
    } else {
      // Clean initial step 10 with empty inputs (no prefilled dummy defaults)
      operationsData = [
        {
          operasyonSira: 10,
          operasyonAdi: '',
          isMerkezi: '',
          isMerkeziId: '',
          hazirlikSuresiDakika: '',
          calismaSuresiDakikaBirim: '',
          operatorSayisi: '',
          durum: 'Active'
        }
      ];
    }

    function renderOperationCards() {
      const container = document.getElementById('opCardsContainer');
      if (!container) return;

      document.getElementById('stepCountBadge').textContent = `${operationsData.length} Adım Tanımlı`;

      if (operationsData.length === 0) {
        container.innerHTML = `
          <div style="background: rgba(15, 23, 42, 0.6); border: 2px dashed rgba(255,255,255,0.1); border-radius: 16px; padding: 40px; text-align: center; color: var(--text-muted);">
            <div style="font-size: 2rem; margin-bottom: 8px;">⚙️</div>
            <strong>Henüz bir operasyon adımı eklenmedi.</strong><br>
            <span style="font-size: 0.84rem; margin-top: 4px; display: inline-block;">Aşağıdaki 'Yeni Operasyon Adımı Ekle' butonuna basarak ilk adımı tanımlayabilirsiniz.</span>
          </div>
        `;
        return;
      }

      container.innerHTML = operationsData.map((op, idx) => {
        const hasName = op.operasyonAdi && op.operasyonAdi.trim().length > 0;
        return `
          <div class="op-card-box" data-index="${idx}">
            
            <!-- Card Header -->
            <div class="op-card-header">
              <div class="op-card-title">
                <span style="background: rgba(99, 102, 241, 0.2); color: #818cf8; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.88rem; font-family: 'JetBrains Mono', monospace;">
                  #${op.operasyonSira}
                </span>
                <span>Adım ${op.operasyonSira}${hasName ? ': ' + escapeHtml(op.operasyonAdi) : ''}</span>
              </div>
              <div>
                <button type="button" onclick="removeOperationStep(${idx})" class="btn btn-danger btn-sm" style="padding: 6px 12px; border-radius: 8px; font-weight: 700; font-size: 0.78rem;" title="Bu Adımı Sil">
                  🗑️ Adımı Sil
                </button>
              </div>
            </div>

            <!-- Card Inputs Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
              
              <!-- 1. Operasyon Numarası (Adım Sırası - READONLY) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  1. Operasyon No (Adım Sırası) <span style="color: #818cf8; font-size: 0.72rem; font-weight: 600;">(Otomatik)</span>
                </label>
                <input type="number" value="${op.operasyonSira}" readonly required
                  class="op-input-seq" data-index="${idx}"
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #818cf8; background: rgba(15, 23, 42, 0.95); border: 1.5px solid rgba(99, 102, 241, 0.35); cursor: not-allowed;">
              </div>

              <!-- 2. Operasyon / İşlem Adı (Zorunlu) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  2. Operasyon / İşlem Adı <span style="color: #f43f5e;">*</span>
                </label>
                <input type="text" value="${escapeHtml(op.operasyonAdi || '')}" placeholder="İşlem Adı (Örn: Lazer Kesim)" required
                  class="op-input-name" data-index="${idx}" oninput="updateOpField(${idx}, 'operasyonAdi', this.value)"
                  style="font-weight: 600;">
              </div>

              <!-- 3. İş Merkezi / Tezgah (Zorunlu / Dropdown) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  3. İş Merkezi / Tezgah <span style="color: #f43f5e;">*</span>
                </label>
                <select required class="op-input-wc" data-index="${idx}" onchange="updateWorkCenterSelect(${idx}, this)" style="font-weight: 700;">
                  <option value="">— İş Merkezi Seçiniz —</option>
                  ${workCentersCatalog.map(wc => {
                    const valStr = `[${wc.isMerkeziKodu}] ${wc.isMerkeziAdi}`;
                    const isSelected = (op.isMerkeziId && String(op.isMerkeziId) === String(wc.id)) || (op.isMerkezi === valStr);
                    return `<option value="${wc.id}" data-name="${valStr}" ${isSelected ? 'selected' : ''}>[${wc.isMerkeziKodu}] ${wc.isMerkeziAdi}</option>`;
                  }).join('')}
                </select>
              </div>

              <!-- 4. Hazırlık Süresi (Zorunlu) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  4. Hazırlık Süresi (Dk) <span style="color: #f43f5e;">*</span>
                </label>
                <div style="position: relative;">
                  <input type="number" step="0.1" min="0" value="${op.hazirlikSuresiDakika !== undefined && op.hazirlikSuresiDakika !== null ? op.hazirlikSuresiDakika : ''}" placeholder="0.0" required
                    class="op-input-setup" data-index="${idx}" onchange="updateOpField(${idx}, 'hazirlikSuresiDakika', this.value)"
                    style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fbbf24; padding-right: 50px;">
                  <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 0.78rem; color: var(--text-muted); font-weight: 700;">
                    Dk
                  </span>
                </div>
              </div>

              <!-- 5. İşlem / Operasyon Süresi (Zorunlu) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  5. İşlem Süresi (Dk/Birim) <span style="color: #f43f5e;">*</span>
                </label>
                <div style="position: relative;">
                  <input type="number" step="0.1" min="0" value="${op.calismaSuresiDakikaBirim !== undefined && op.calismaSuresiDakikaBirim !== null ? op.calismaSuresiDakikaBirim : ''}" placeholder="0.0" required
                    class="op-input-run" data-index="${idx}" onchange="updateOpField(${idx}, 'calismaSuresiDakikaBirim', this.value)"
                    style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #34d399; padding-right: 75px;">
                  <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 0.78rem; color: var(--text-muted); font-weight: 700;">
                    Dk/Adet
                  </span>
                </div>
              </div>

              <!-- 6. İşçilik / Personel İhtiyacı (Zorunlu) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  6. Personel İhtiyacı <span style="color: #f43f5e;">*</span>
                </label>
                <div style="position: relative;">
                  <input type="number" step="1" min="1" value="${op.operatorSayisi !== undefined && op.operatorSayisi !== null ? op.operatorSayisi : ''}" placeholder="1" required
                    class="op-input-operators" data-index="${idx}" onchange="updateOpField(${idx}, 'operatorSayisi', this.value)"
                    style="font-family: 'JetBrains Mono', monospace; font-weight: 700; padding-right: 50px;">
                  <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 0.78rem; color: var(--text-muted); font-weight: 700;">
                    Kişi
                  </span>
                </div>
              </div>

              <!-- 7. Durum (Zorunlu) -->
              <div class="input-group">
                <label style="font-weight: 700; font-size: 0.82rem;">
                  7. Durum <span style="color: #f43f5e;">*</span>
                </label>
                <select required class="op-input-status" data-index="${idx}" onchange="updateOpField(${idx}, 'durum', this.value)" style="font-weight: 700;">
                  <option value="Active" ${op.durum === 'Active' ? 'selected' : ''}>🟢 Aktif</option>
                  <option value="Inactive" ${op.durum === 'Inactive' ? 'selected' : ''}>⚪ Pasif</option>
                </select>
              </div>

            </div>
          </div>
        `;
      }).join('');
    }

    function addNewOperationStep() {
      operationsData.push({
        operasyonSira: (operationsData.length + 1) * 10,
        operasyonAdi: '',
        isMerkezi: '',
        isMerkeziId: '',
        hazirlikSuresiDakika: '',
        calismaSuresiDakikaBirim: '',
        operatorSayisi: '',
        durum: 'Active'
      });

      reindexOperations();
      renderOperationCards();
    }

    function removeOperationStep(index) {
      if (operationsData.length <= 1) {
        if (!confirm('Bu son operasyon adımını silmek istediğinize emin misiniz? Rota için en az 1 adım gereklidir.')) return;
      }
      operationsData.splice(index, 1);
      reindexOperations();
      renderOperationCards();
    }

    function updateOpField(index, field, value) {
      if (operationsData[index]) {
        operationsData[index][field] = value;
      }
    }

    function updateWorkCenterSelect(index, selectEl) {
      const opt = selectEl.options[selectEl.selectedIndex];
      const wcId = selectEl.value;
      const wcName = opt ? opt.getAttribute('data-name') : '';

      if (operationsData[index]) {
        operationsData[index].isMerkeziId = wcId;
        operationsData[index].isMerkezi = wcName;
      }
    }

    function escapeHtml(text) {
      if (!text) return '';
      return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function onProductSelectChange(productId) {
      if (!productId) return;
      window.location.href = `/production/routing/edit/${productId}`;
    }

    // Strict Validation on Form Submission
    const form = document.getElementById('routingForm');
    if (form) {
      form.addEventListener('submit', function(e) {
        const stockItemId = document.getElementById('stockItemId').value;
        if (!stockItemId) {
          e.preventDefault();
          alert('⚠️ Lütfen rotası oluşturulacak hedef ürünü seçiniz.');
          return false;
        }

        if (!operationsData || operationsData.length === 0) {
          e.preventDefault();
          alert('⚠️ Lütfen en az 1 adet operasyon adımı ekleyiniz.');
          return false;
        }

        // Validate all 7 fields, uniqueness of step numbers, and non-negative constraints
        const seqSet = new Set();
        for (let i = 0; i < operationsData.length; i++) {
          const op = operationsData[i];
          const seq = parseInt(op.operasyonSira, 10);
          
          if (isNaN(seq) || seq <= 0) {
            e.preventDefault();
            alert(`⚠️ Adım #${i + 1}: Operasyon numarası 0'dan büyük geçerli bir sayı olmalıdır.`);
            return false;
          }

          if (seqSet.has(seq)) {
            e.preventDefault();
            alert(`⚠️ Mükerrer Adım Numarası: Rota içinde aynı operasyon numarası (${seq}) birden fazla kez kullanılamaz. Lütfen her adıma benzersiz bir numara veriniz.`);
            return false;
          }
          seqSet.add(seq);

          if (!op.operasyonAdi || !op.operasyonAdi.trim()) {
            e.preventDefault();
            alert(`⚠️ Adım ${seq}: Lütfen operasyon / işlem adını giriniz.`);
            return false;
          }

          if (!op.isMerkezi || !op.isMerkezi.trim()) {
            e.preventDefault();
            alert(`⚠️ Adım ${seq}: Lütfen bağlı olduğu İş Merkezini seçiniz.`);
            return false;
          }

          const setup = parseFloat(op.hazirlikSuresiDakika);
          if (isNaN(setup) || setup < 0) {
            e.preventDefault();
            alert(`⚠️ Adım ${seq}: Hazırlık süresi negatif (0'dan küçük) olamaz.`);
            return false;
          }

          const run = parseFloat(op.calismaSuresiDakikaBirim);
          if (isNaN(run) || run < 0) {
            e.preventDefault();
            alert(`⚠️ Adım ${seq}: İşlem / operasyon süresi negatif (0'dan küçük) olamaz.`);
            return false;
          }

          const opCount = parseInt(op.operatorSayisi, 10);
          if (isNaN(opCount) || opCount < 1) {
            e.preventDefault();
            alert(`⚠️ Adım ${seq}: İşçilik / personel ihtiyacı en az 1 kişi olmalıdır.`);
            return false;
          }

          if (!op.durum) {
            e.preventDefault();
            alert(`⚠️ Adım ${seq}: Lütfen durum seçiniz.`);
            return false;
          }
        }

        document.getElementById('operationsJson').value = JSON.stringify(operationsData);
      });
    }

    // Initial render
    renderOperationCards();

    function updateClock() { 
      const now = new Date(); 
      const el = document.getElementById('liveTime'); 
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); 
    }
    updateClock(); 
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
