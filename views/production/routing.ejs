<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim Rotaları ve Operasyon Mühendisliği — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .btn-indigo-gradient {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff !important;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 10px 20px;
      border-radius: 10px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
      transition: all 0.2s;
    }
    .btn-indigo-gradient:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5); }

    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 24px; }
    .kpi-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 20px; display: flex; align-items: center; gap: 16px; box-shadow: var(--shadow-sm); }
    .kpi-icon-box { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
    .kpi-title { font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; }
    .kpi-value { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin-top: 2px; }

    .badge-cat-mamul { background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); }
    .badge-cat-yarimamul { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .badge-has-routing { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .badge-no-routing { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

    .btn-action-edit { background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); padding: 6px 14px; border-radius: 8px; font-size: 0.825rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s; }
    .btn-action-edit:hover { background: rgba(99, 102, 241, 0.3); color: #fff; }

    .btn-action-view { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); padding: 6px 14px; border-radius: 8px; font-size: 0.825rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s; }
    .btn-action-view:hover { background: rgba(59, 130, 246, 0.3); color: #fff; }

    .btn-action-delete { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 6px 10px; border-radius: 8px; font-size: 0.825rem; font-weight: 700; cursor: pointer; transition: all 0.2s; }
    .btn-action-delete:hover { background: rgba(239, 68, 68, 0.3); color: #fff; }

    /* Modal Overlay */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; }
    .modal-overlay.active { display: flex; }
    .modal-box { background: #0f172a; border: 1.5px solid #1e293b; border-radius: 20px; width: 90%; max-width: 850px; max-height: 85vh; overflow-y: auto; padding: 28px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub"><a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a></div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Talepler</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link active">🛠️ Rotalama & Operasyonlar</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <div class="page-header" style="margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;">
        <div>
          <h1>🛠️ Üretim Rotaları ve Operasyon Adımları (Process Engineering)</h1>
          <p style="color: var(--text-secondary); font-size: 0.92rem; margin-top: 4px;">Reçeteli Mamul ve Yarı Mamul ürünlerin istasyon sırası, operasyon kodları, ayar/hazırlık ve birim işlem sürelerini yönetin.</p>
        </div>
        <a href="/production/routing/add" class="btn-indigo-gradient">
          <span>➕ Yeni Rota / Operasyon Ekle</span>
        </a>
      </div>

      <% 
        const safeRoutingList = (typeof productRoutingList !== 'undefined' && productRoutingList) ? productRoutingList : [];
        const routingDefinedOnly = safeRoutingList.filter(r => r.hasRouting);
        const safeStats = (typeof stats !== 'undefined' && stats) ? stats : {
          totalCandidateProducts: safeRoutingList.length,
          withRouting: routingDefinedOnly.length,
          withoutRouting: safeRoutingList.length - routingDefinedOnly.length
        };
      %>

      <!-- KPI Summary Cards -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-icon-box" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">🛠️</div>
          <div>
            <div class="kpi-title">Reçeteli Ürün Sayısı</div>
            <div class="kpi-value"><%= safeStats.totalCandidateProducts %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon-box" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">✓</div>
          <div>
            <div class="kpi-title">Rotası Tanımlanmış Ürünler</div>
            <div class="kpi-value" style="color: #34d399;"><%= safeStats.withRouting %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon-box" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">⚠️</div>
          <div>
            <div class="kpi-title">Rotası Eksik Ürünler</div>
            <div class="kpi-value" style="color: #fbbf24;"><%= safeStats.withoutRouting %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon-box" style="background: rgba(139, 92, 246, 0.15); color: #c084fc;">⚡</div>
          <div>
            <div class="kpi-title">Rota Tamamlanma Oranı</div>
            <div class="kpi-value" style="color: #c084fc;">
              <%= safeStats.totalCandidateProducts > 0 ? Math.round((safeStats.withRouting / safeStats.totalCandidateProducts) * 100) : 0 %>%
            </div>
          </div>
        </div>
      </div>

      <!-- Main Routings Table -->
      <div class="table-wrapper">
        <table class="data-table" id="routingTable">
          <thead>
            <tr>
              <th>Ürün Kodu</th>
              <th>Ürün Adı</th>
              <th>Kategori</th>
              <th>Adım Sayısı</th>
              <th>Toplam Ayar Süresi</th>
              <th>Birim İşlem Süresi</th>
              <th>Kullanılan İş Merkezleri</th>
              <th>Rota Durumu</th>
              <th style="text-align: right;">İşlemler</th>
            </tr>
          </thead>
          <tbody>
            <% if (routingDefinedOnly.length === 0) { %>
              <tr><td colspan="9" style="text-align: center; color: var(--text-muted); padding: 3rem;">Henüz tanımlanmış bir üretim rotası bulunmamaktadır. Ekranın sağ üstündeki <strong>'➕ Yeni Rota / Operasyon Ekle'</strong> butonuna basarak reçeteli ürünleriniz için operasyon adımları tanımlayabilirsiniz.</td></tr>
            <% } else { %>
              <% routingDefinedOnly.forEach(item => { %>
                <tr>
                  <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= item.product.stockCode %></strong></td>
                  <td><strong style="color: var(--text-primary);"><%= item.product.name %></strong></td>
                  <td>
                    <% if (item.product.category === 'Mamul') { %>
                      <span class="badge-status badge-cat-mamul">🏭 Mamul</span>
                    <% } else { %>
                      <span class="badge-status badge-cat-yarimamul">⚙️ Yarı Mamul</span>
                    <% } %>
                  </td>
                  <td><strong><%= item.totalOperations %> Adım</strong></td>
                  <td><strong><%= item.totalSetupTime %> Dk</strong></td>
                  <td><strong style="color: #34d399;"><%= item.totalRunTime %> Dk / Adet</strong></td>
                  <td style="font-size: 0.82rem; color: var(--text-secondary);">
                    <% if (item.workCenters.length > 0) { %>
                      <%= item.workCenters.join(' • ') %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                  <td><span class="badge-status badge-has-routing">✓ Rota Tanımlı</span></td>
                  <td style="text-align: right; white-space: nowrap;">
                    <a href="/production/routing/edit/<%= item.product.id %>" class="btn-action-edit">
                      ✏️ Rota / Operasyon Düzenle
                    </a>
                    <form action="/production/routing/delete/<%= item.product.id %>" method="POST" style="display: inline-block; margin-left: 6px;" onsubmit="return confirm('Bu ürünün tüm rotalama operasyon adımlarını silmek istediğinize emin misiniz?');">
                      <button type="submit" class="btn-action-delete" title="Rotayı Sil">🗑️</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
