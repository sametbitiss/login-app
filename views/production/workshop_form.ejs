<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isEditMode ? 'Atölye Kartını Düzenle' : 'Yeni Atölye Kartı Ekle' %> — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
  <style>
    .form-container-card {
      background: rgba(30, 41, 59, 0.45);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
      max-width: 920px;
      margin: 0 auto;
    }
    .form-section-header {
      font-size: 1.05rem;
      font-weight: 800;
      color: #818cf8;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 12px;
    }

    /* Selected Manager Profile Box */
    .manager-profile-card {
      background: rgba(15, 23, 42, 0.85);
      border: 1.5px solid rgba(99, 102, 241, 0.4);
      border-radius: 16px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      box-shadow: 0 4px 20px rgba(99, 102, 241, 0.15);
      transition: all 0.2s ease;
    }
    .manager-profile-card:hover {
      border-color: rgba(99, 102, 241, 0.7);
      box-shadow: 0 6px 25px rgba(99, 102, 241, 0.25);
    }
    .manager-avatar-badge {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      font-weight: 800;
      flex-shrink: 0;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
    }

    /* Modal Table Rows */
    .manager-table-row {
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      transition: background 0.15s ease;
      cursor: pointer;
    }
    .manager-table-row:hover {
      background: rgba(99, 102, 241, 0.08);
    }
    .manager-table-row.selected {
      background: rgba(99, 102, 241, 0.18) !important;
    }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link active">🏢 Atölye Kartları</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link active">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <!-- Breadcrumb & Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 12px;">
        <div>
          <div style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/production/workshops" style="color: var(--text-muted); text-decoration: none;">🏢 Atölye Kartları</a>
            <span>/</span>
            <span style="color: #818cf8; font-weight: 600;"><%= isEditMode ? 'Atölyeyi Düzenle' : 'Yeni Atölye Kartı Ekle' %></span>
          </div>
          <h1 style="font-size: 1.65rem; font-weight: 900; color: #fff; margin: 0; letter-spacing: -0.5px;">
            <%= isEditMode ? `🏢 [${workshop.atolyeKodu}] ${workshop.atolyeAdi} Düzenleme` : '🏢 Yeni Atölye Kartı Oluşturma' %>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            İmalat sahasında görev yapacak atölye kimliği, çalışma merkezi adı, sorumlu personel ataması ve durum yönetimi.
          </p>
        </div>
        <a href="/production/workshops" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; border-radius: 12px; padding: 10px 20px;">
          <span>←</span> Atölye Listesine Dön
        </a>
      </div>

      <!-- Workshop Form Card -->
      <div class="form-container-card">
        
        <form action="/production/workshops/save" method="POST" id="workshopForm">
          <% if (isEditMode && workshop) { %>
            <input type="hidden" name="id" value="<%= workshop.id %>">
          <% } %>

          <div class="form-section-header">
            <span>📋</span> Atölye Temel Bilgileri & Sorumlu Personel
          </div>

          <!-- Row 1: Code & Name -->
          <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
            
            <!-- 1. Atolye Kodu (Readonly / Otomatik Sistem Kimliği) -->
            <div class="input-group">
              <label for="atolyeKodu" style="font-weight: 700;">
                1. Atölye Kodu <span style="color: #f43f5e;">*</span>
              </label>
              <div style="position: relative;">
                <input type="text" id="atolyeKodu" name="atolyeKodu" value="<%= nextCode %>" readonly 
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399; background: rgba(15, 23, 42, 0.9); border: 1.5px solid rgba(52, 211, 153, 0.35); cursor: not-allowed; padding-right: 40px;" required>
                <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 0.95rem;" title="Sistem Tarafından Otomatik Üretilen Benzersiz Numara">🔒</span>
              </div>
            </div>

            <!-- 2. Atolye Adi (Zorunlu) -->
            <div class="input-group">
              <label for="atolyeAdi" style="font-weight: 700;">
                2. Atölye Adı <span style="color: #f43f5e;">*</span>
              </label>
              <input type="text" id="atolyeAdi" name="atolyeAdi" 
                value="<%= isEditMode && workshop ? workshop.atolyeAdi : '' %>" 
                placeholder="Örn: CNC & Talaşlı İmalat Atölyesi" required 
                style="font-weight: 600;">
            </div>

          </div>

          <!-- Row 2: Sorumlu Personel (Zorunlu + Modal) -->
          <div class="input-group" style="margin-bottom: 1.5rem;">
            <label style="font-weight: 700; display: flex; justify-content: space-between; align-items: center;">
              <span>3. Atölye Sorumlusu (Genel Personel) <span style="color: #f43f5e;">*</span></span>
              <span style="font-size: 0.76rem; color: #818cf8; font-weight: 600;">Sistemdeki personel çalışanları listelenir</span>
            </label>
            
            <% 
              const currentSorumlu = (isEditMode && workshop && workshop.sorumlu) ? workshop.sorumlu : null;
              const currentSorumluId = currentSorumlu ? currentSorumlu.id : '';
            %>
            <input type="hidden" name="sorumluId" id="sorumluId" value="<%= currentSorumluId %>" required>

            <!-- Sorumlu Display Container -->
            <div id="selectedManagerDisplay" style="display: <%= currentSorumlu ? 'block' : 'none' %>;">
              <div class="manager-profile-card">
                <div style="display: flex; align-items: center; gap: 14px;">
                  <div class="manager-avatar-badge" id="managerAvatar">
                    <%= currentSorumlu ? (currentSorumlu.ad ? currentSorumlu.ad.charAt(0) : currentSorumlu.kullaniciAdi.charAt(0)).toUpperCase() : '?' %>
                  </div>
                  <div>
                    <strong style="font-size: 1.05rem; color: #fff; display: block;" id="managerFullName">
                      <%= currentSorumlu ? (currentSorumlu.ad ? `${currentSorumlu.ad} ${currentSorumlu.soyad || ''}` : currentSorumlu.kullaniciAdi) : '' %>
                    </strong>
                    <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; gap: 8px; align-items: center; margin-top: 3px; flex-wrap: wrap;">
                      <span id="managerUsername" style="color: #818cf8; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
                        @<%= currentSorumlu ? currentSorumlu.kullaniciAdi : '' %>
                      </span>
                      <span>•</span>
                      <span id="managerDept" style="background: rgba(255,255,255,0.06); padding: 2px 8px; border-radius: 6px; font-weight: 600;">
                        🏢 <%= currentSorumlu ? (currentSorumlu.departman || 'Genel Personel') : '' %>
                      </span>
                      <span>•</span>
                      <span id="managerTitle" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 2px 8px; border-radius: 6px; font-weight: 700;">
                        👤 <%= currentSorumlu ? (currentSorumlu.unvan || 'Personel') : '' %>
                      </span>
                    </div>
                  </div>
                </div>

                <div>
                  <button type="button" onclick="openManagerSelectModal()" class="btn btn-secondary btn-sm" style="font-weight: 700; border-radius: 10px; padding: 8px 16px;">
                    🔄 Sorumluyu Değiştir
                  </button>
                </div>
              </div>
            </div>

            <!-- Empty Manager Placeholder / Modal Trigger Button -->
            <div id="emptyManagerButtonWrap" style="display: <%= currentSorumlu ? 'none' : 'block' %>;">
              <button type="button" onclick="openManagerSelectModal()" class="btn" 
                style="width: 100%; background: rgba(99, 102, 241, 0.1); border: 2px dashed rgba(99, 102, 241, 0.45); color: #818cf8; padding: 20px; border-radius: 16px; font-weight: 800; font-size: 0.96rem; display: flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer; transition: all 0.2s ease;"
                onmouseover="this.style.background='rgba(99, 102, 241, 0.18)'; this.style.borderColor='#818cf8';"
                onmouseout="this.style.background='rgba(99, 102, 241, 0.1)'; this.style.borderColor='rgba(99, 102, 241, 0.45)';">
                <span style="font-size: 1.3rem;">👤</span>
                <span>Personel Listesinden Atölye Sorumlusu Seç (Modal)</span>
              </button>
            </div>
          </div>

          <!-- Row 3: Durum (Zorunlu) -->
          <div class="input-group" style="margin-bottom: 1.5rem;">
            <label for="durum" style="font-weight: 700;">
              4. Atölye Çalışma Durumu <span style="color: #f43f5e;">*</span>
            </label>
            <% 
              const currentDurum = isEditMode && workshop ? workshop.durum : 'Active';
            %>
            <select id="durum" name="durum" required style="font-weight: 700;">
              <option value="Active" <%= currentDurum === 'Active' ? 'selected' : '' %>>🟢 Aktif (İmalat ve Operasyonlara Açık)</option>
              <option value="Inactive" <%= currentDurum === 'Inactive' ? 'selected' : '' %>>⚪ Pasif (Bakımda / Geçici Olarak Kapalı)</option>
            </select>
          </div>

          <!-- Row 4: Açıklama / Notlar (Opsiyonel) -->
          <div class="input-group" style="margin-bottom: 2rem;">
            <label for="aciklama" style="font-weight: 700;">
              5. Açıklama & Atölye Notları <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: normal;">(Opsiyonel)</span>
            </label>
            <textarea id="aciklama" name="aciklama" rows="3" 
              placeholder="Atölyenin fiziksel konumu, makine parkuru, çalışma saatleri veya özel emniyet kuralları..."><%= isEditMode && workshop ? (workshop.aciklama || '') : '' %></textarea>
          </div>

          <!-- Form Actions -->
          <div style="display: flex; justify-content: flex-end; gap: 14px; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 20px;">
            <a href="/production/workshops" class="btn btn-secondary" style="padding: 11px 24px; border-radius: 12px; font-weight: 700;">
              Vazgeç
            </a>
            <button type="submit" class="btn btn-primary" id="btnSubmitWorkshop" style="background: linear-gradient(135deg, #6366f1 0%, #10b981 100%); color: #fff; border: none; font-weight: 800; font-size: 0.95rem; padding: 11px 34px; border-radius: 12px; box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4); cursor: pointer;">
              💾 <%= isEditMode ? 'Atölyeyi Güncelle' : 'Atölye Kartını Kaydet' %>
            </button>
          </div>

        </form>
      </div>

    </main>
  </div>

  <!-- ======================================================================= -->
  <!-- PERSONNEL SELECTION MODAL (EXACT SALES QUOTE MODAL PARITY & DESIGN) -->
  <!-- ======================================================================= -->
  <div id="managerSelectModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(14px); z-index: 9999; display: none; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; width: 100%; max-width: 950px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7); position: relative;">
      
      <!-- Modal Header -->
      <div style="padding: 20px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: space-between; background: rgba(15, 23, 42, 0.95);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 1.5rem; background: rgba(99, 102, 241, 0.15); width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(99, 102, 241, 0.3);">👤</span>
          <div>
            <h2 style="font-size: 1.25rem; font-weight: 800; color: #fff; margin: 0;">Personel Listesinden Atölye Sorumlusu Seçimi</h2>
            <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 2px;">Atölye sorumlusu olarak atamak istediğiniz personeli arayabilir, sıralayabilir ve tekil seçim ile atayabilirsiniz.</p>
          </div>
        </div>
        <button type="button" onclick="closeManagerSelectModal()" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: var(--text-muted); width: 36px; height: 36px; border-radius: 10px; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">✕</button>
      </div>

      <!-- Modal Search & Filter Controls -->
      <div style="padding: 16px 24px; background: rgba(30, 41, 59, 0.5); border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
        <!-- Search Input -->
        <div style="flex: 1; min-width: 260px; position: relative;">
          <input type="text" id="modalManagerSearch" oninput="renderModalManagers()" placeholder="🔍 Personel adı, soyadı, kullanıcı adı veya departman ile arayın..." style="width: 100%; padding: 10px 14px 10px 38px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.875rem; outline: none; box-sizing: border-box;">
          <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;">🔍</span>
        </div>

        <!-- Sort Select Dropdown -->
        <div style="width: 300px;">
          <select id="modalManagerSort" onchange="renderModalManagers()" style="width: 100%; padding: 10px 14px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.85rem; outline: none; font-weight: 600;">
            <option value="name_asc" selected>🔤 İsme Göre: A'dan Z'ye</option>
            <option value="name_desc">🔤 İsme Göre: Z'den A'ya</option>
            <option value="dept_asc">🏢 Departmana Göre: A-Z</option>
            <option value="uname_asc">👤 Kullanıcı Adına Göre: A-Z</option>
          </select>
        </div>
      </div>

      <!-- Modal Personnel List Table -->
      <div style="flex: 1; overflow-y: auto; padding: 16px 24px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="modalManagersTable">
          <thead>
            <tr style="background: rgba(30, 41, 59, 0.8); border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; position: sticky; top: 0; z-index: 10;">
              <th style="padding: 12px 14px; width: 55px; text-align: center;">Seç</th>
              <th style="padding: 12px 14px;">Personel / İsim Soyad</th>
              <th style="padding: 12px 14px; width: 180px;">Kullanıcı Adı</th>
              <th style="padding: 12px 14px; width: 200px;">Çalıştığı Departman</th>
              <th style="padding: 12px 14px; width: 160px;">Unvan / Görev</th>
            </tr>
          </thead>
          <tbody id="modalManagersTbody">
            <!-- Rendered dynamically by renderModalManagers() -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div style="padding: 16px 24px; border-top: 1px solid rgba(255, 255, 255, 0.1); background: rgba(15, 23, 42, 0.95); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="font-size: 0.88rem; font-weight: 700;" id="modalSelectedManagerBadge">
          Lütfen listeden bir personel seçiniz
        </div>
        <div style="display: flex; gap: 12px;">
          <button type="button" class="btn btn-secondary" onclick="closeManagerSelectModal()" style="padding: 10px 20px; border-radius: 10px; font-weight: 600;">
            İptal
          </button>
          <button type="button" class="btn btn-primary" onclick="confirmAssignManager()" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 800; padding: 10px 26px; border-radius: 10px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35); cursor: pointer;">
            ✅ Seçilen Personeli Sorumlu Olarak Ata
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Personnel Master JSON Data -->
  <script id="eligibleManagersData" type="application/json">
    <%- JSON.stringify(eligibleManagers || []) %>
  </script>

  <script>
    const personnelCatalog = JSON.parse(document.getElementById('eligibleManagersData').textContent || '[]');
    let selectedManagerObj = null;

    // Load initial selection if in edit mode
    <% if (currentSorumlu) { %>
      selectedManagerObj = {
        id: <%= currentSorumlu.id %>,
        name: "<%= (currentSorumlu.ad ? `${currentSorumlu.ad} ${currentSorumlu.soyad || ''}` : currentSorumlu.kullaniciAdi).replace(/"/g, '\\"') %>",
        username: "<%= currentSorumlu.kullaniciAdi %>",
        dept: "<%= currentSorumlu.departman || 'Genel Personel' %>",
        title: "<%= currentSorumlu.unvan || 'Personel' %>"
      };
    <% } %>

    function openManagerSelectModal() {
      const modal = document.getElementById('managerSelectModal');
      if (!modal) return;
      document.getElementById('modalManagerSearch').value = '';
      document.getElementById('modalManagerSort').value = 'name_asc';
      modal.style.display = 'flex';
      renderModalManagers();
      setTimeout(() => {
        const inp = document.getElementById('modalManagerSearch');
        if (inp) inp.focus();
      }, 100);
    }

    function closeManagerSelectModal() {
      const modal = document.getElementById('managerSelectModal');
      if (modal) modal.style.display = 'none';
    }

    function renderModalManagers() {
      const tbody = document.getElementById('modalManagersTbody');
      if (!tbody) return;

      const searchVal = (document.getElementById('modalManagerSearch')?.value || '').toLowerCase().trim();
      const sortVal = document.getElementById('modalManagerSort')?.value || 'name_asc';

      let items = (personnelCatalog || []).filter(p => {
        const fullName = (p.ad ? `${p.ad} ${p.soyad || ''}` : p.kullaniciAdi).toLowerCase();
        const username = (p.kullaniciAdi || '').toLowerCase();
        const dept = (p.departman || '').toLowerCase();
        const title = (p.unvan || '').toLowerCase();

        return fullName.includes(searchVal) || username.includes(searchVal) || dept.includes(searchVal) || title.includes(searchVal);
      });

      items.sort((a, b) => {
        const nameA = (a.ad ? `${a.ad} ${a.soyad || ''}` : a.kullaniciAdi).toLowerCase();
        const nameB = (b.ad ? `${b.ad} ${b.soyad || ''}` : b.kullaniciAdi).toLowerCase();
        const deptA = (a.departman || '').toLowerCase();
        const deptB = (b.departman || '').toLowerCase();
        const unameA = (a.kullaniciAdi || '').toLowerCase();
        const unameB = (b.kullaniciAdi || '').toLowerCase();

        if (sortVal === 'name_desc') return nameB.localeCompare(nameA, 'tr');
        if (sortVal === 'dept_asc') return deptA.localeCompare(deptB, 'tr');
        if (sortVal === 'uname_asc') return unameA.localeCompare(unameB, 'tr');
        return nameA.localeCompare(nameB, 'tr');
      });

      if (items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="padding: 40px; text-align: center; color: var(--text-muted);">
              🔍 Arama kriterlerine uygun personel kaydı bulunamadı.
            </td>
          </tr>
        `;
        updateModalBadge();
        return;
      }

      const currentSelectedId = selectedManagerObj ? String(selectedManagerObj.id) : document.getElementById('sorumluId').value;

      tbody.innerHTML = items.map((p, idx) => {
        const isSelected = String(p.id) === String(currentSelectedId);
        const fullName = p.ad ? `${p.ad} ${p.soyad || ''}` : p.kullaniciAdi;
        const initial = (p.ad ? p.ad.charAt(0) : p.kullaniciAdi.charAt(0)).toUpperCase();
        const dept = p.departman || 'Genel Personel';
        const title = p.unvan || 'Personel';

        return `
          <tr class="manager-table-row ${isSelected ? 'selected' : ''}" 
              data-id="${p.id}" 
              data-name="${fullName}" 
              data-username="${p.kullaniciAdi}" 
              data-dept="${dept}" 
              data-title="${title}" 
              onclick="selectManagerItem(${p.id})">
            <td style="padding: 12px 14px; text-align: center;">
              <input type="radio" name="modalSelectedManagerRadio" value="${p.id}" ${isSelected ? 'checked' : ''} 
                style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;"
                onclick="event.stopPropagation(); selectManagerItem(${p.id})">
            </td>
            <td style="padding: 12px 14px;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <div class="user-avatar-badge" style="width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.82rem; font-weight: 800;">
                  ${initial}
                </div>
                <strong style="color: #fff; font-size: 0.9rem;">${fullName}</strong>
              </div>
            </td>
            <td style="padding: 12px 14px; font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: #818cf8; font-weight: 600;">
              @${p.kullaniciAdi}
            </td>
            <td style="padding: 12px 14px;">
              <span style="background: rgba(99, 102, 241, 0.12); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.2); padding: 3px 9px; border-radius: 8px; font-size: 0.76rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                🏢 ${dept}
              </span>
            </td>
            <td style="padding: 12px 14px; color: var(--text-secondary); font-size: 0.84rem; font-weight: 600;">
              ${title}
            </td>
          </tr>
        `;
      }).join('');

      updateModalBadge();
    }

    function selectManagerItem(id) {
      const match = (personnelCatalog || []).find(p => String(p.id) === String(id));
      if (!match) return;

      selectedManagerObj = {
        id: match.id,
        name: match.ad ? `${match.ad} ${match.soyad || ''}` : match.kullaniciAdi,
        username: match.kullaniciAdi,
        dept: match.departman || 'Genel Personel',
        title: match.unvan || 'Personel'
      };

      document.querySelectorAll('.manager-table-row').forEach(row => {
        const isTarget = String(row.dataset.id) === String(id);
        if (isTarget) {
          row.classList.add('selected');
          const radio = row.querySelector('input[type="radio"]');
          if (radio) radio.checked = true;
        } else {
          row.classList.remove('selected');
        }
      });

      updateModalBadge();
    }

    function updateModalBadge() {
      const badge = document.getElementById('modalSelectedManagerBadge');
      if (!badge) return;

      if (selectedManagerObj && selectedManagerObj.id) {
        badge.innerHTML = `<span style="color: #34d399;">✓ Seçildi: <strong>${selectedManagerObj.name}</strong> (@${selectedManagerObj.username})</span>`;
      } else {
        badge.innerHTML = `<span style="color: var(--text-muted);">Lütfen listeden bir personel seçiniz</span>`;
      }
    }

    function confirmAssignManager() {
      if (!selectedManagerObj || !selectedManagerObj.id) {
        alert('⚠️ Lütfen atölye sorumlusu olarak atamak istediğiniz personeli listeden seçiniz.');
        return;
      }

      document.getElementById('sorumluId').value = selectedManagerObj.id;
      document.getElementById('managerFullName').textContent = selectedManagerObj.name;
      document.getElementById('managerUsername').textContent = `@${selectedManagerObj.username}`;
      document.getElementById('managerDept').textContent = `🏢 ${selectedManagerObj.dept}`;
      document.getElementById('managerTitle').textContent = `👤 ${selectedManagerObj.title}`;
      document.getElementById('managerAvatar').textContent = selectedManagerObj.name.charAt(0).toUpperCase();

      document.getElementById('selectedManagerDisplay').style.display = 'block';
      document.getElementById('emptyManagerButtonWrap').style.display = 'none';

      closeManagerSelectModal();
    }

    // Strict Form Validation Check on Submit
    const form = document.getElementById('workshopForm');
    if (form) {
      form.addEventListener('submit', function(e) {
        const atolyeKodu = document.getElementById('atolyeKodu').value.trim();
        const atolyeAdi = document.getElementById('atolyeAdi').value.trim();
        const sorumluId = document.getElementById('sorumluId').value.trim();
        const durum = document.getElementById('durum').value.trim();

        if (!atolyeKodu) {
          e.preventDefault();
          alert('⚠️ Atölye kodu sistem tarafından oluşturulmalıdır.');
          return false;
        }

        if (!atolyeAdi) {
          e.preventDefault();
          alert('⚠️ Lütfen atölye adını giriniz.');
          document.getElementById('atolyeAdi').focus();
          return false;
        }

        if (!sorumluId) {
          e.preventDefault();
          alert('⚠️ Lütfen "Personel Listesinden Atölye Sorumlusu Seç" butonuna tıklayarak sorumlu personeli atayınız.');
          openManagerSelectModal();
          return false;
        }

        if (!durum) {
          e.preventDefault();
          alert('⚠️ Lütfen atölye çalışma durumunu seçiniz.');
          document.getElementById('durum').focus();
          return false;
        }
      });
    }

    function updateClock() { 
      const now = new Date(); 
      const el = document.getElementById('liveTime'); 
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); 
    }
    updateClock(); 
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
