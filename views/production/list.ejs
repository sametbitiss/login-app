<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim İş Emirleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#10b981"/><stop offset="100%" stop-color="#059669"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">ÜRETİM PLANLAMA</div>
      <a href="/production/orders" class="mss-link active">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M5 20V10l4-4 4 4v10"/><path d="M13 20V4l6 6v10"/></svg>
        Üretim Takibi
      </a>
      <div class="mss-sub">
        <a href="/production/orders" class="mss-sub-link active">📋 Üretim İş Emirleri Listesi</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/bom" class="mss-sub-link">📜 Reçeteler (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🔄 Rotalama & Operasyon</a>
        <a href="/production/capacity" class="mss-sub-link">📊 Kapasite Planlama</a>
        <a href="/production/mes" class="mss-sub-link">🏭 Üretim İzleme & MES</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= ALL_ROLES[user.role] || user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Stock_Manager') { %>
          <a href="/stock" class="mt-link">Stok & Depo</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Sales_Manager') { %>
          <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Purchase_Manager') { %>
          <a href="/purchase" class="mt-link">Satın Alma</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link active">Üretim Planlama</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">
      <!-- Module Sub-Nav -->
      <div class="module-subnav">
        <a href="/production/orders" class="msn-link active">📋 İş Emirleri</a>
        <a href="/production/bom" class="msn-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="msn-link">🔄 Rotalama & Operasyonlar</a>
        <a href="/production/capacity" class="msn-link">📊 Kapasite Planlaması</a>
        <a href="/production/mes" class="msn-link">🏭 Üretim İzleme & MES</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Üretim İş Emirleri Takibi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Fabrika üretim hatları, iş merkezleri, planlanan zamanlamalar ve imalat durumları.</p>
        </div>
        <a href="/production/orders/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni İş Emri Ekle
        </a>
      </div>

      <!-- KPI Summary Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-card-title">Toplam İş Emri</div>
          <div class="stat-card-value"><%= stats.totalOrders %></div>
          <div class="stat-card-desc">Sistemde tanımlı iş emirleri</div>
        </div>

        <div class="stat-card">
          <div class="stat-card-title">Üretimde Olanlar</div>
          <div class="stat-card-value" style="color: var(--amber);"><%= stats.inProductionOrders %></div>
          <div class="stat-card-desc">Aktif üretimdeki iş emirleri</div>
        </div>

        <div class="stat-card">
          <div class="stat-card-title">Planlanan İş Emirleri</div>
          <div class="stat-card-value" style="color: var(--indigo);"><%= stats.plannedOrders %></div>
          <div class="stat-card-desc">Başlamayı bekleyenler</div>
        </div>

        <div class="stat-card">
          <div class="stat-card-title">Tamamlananlar</div>
          <div class="stat-card-value" style="color: var(--emerald);"><%= stats.completedOrders %></div>
          <div class="stat-card-desc">İmalatı tamamlananlar</div>
        </div>
      </div>

      <!-- Filter Panel -->
      <div class="filter-panel" style="margin-bottom: 1.5rem;">
        <form action="/production/orders" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
          <div class="input-group" style="flex: 2; min-width: 200px;">
            <label for="search">Arama</label>
            <input type="text" id="search" name="search" value="<%= filterSearch %>" placeholder="İş Emri No, Üretim Başlığı veya İstasyon...">
          </div>

          <div class="input-group" style="flex: 1; min-width: 150px;">
            <label for="status">Üretim Durumu</label>
            <select id="status" name="status">
              <option value="">-- Tüm Durumlar --</option>
              <option value="Planned" <%= filterStatus === 'Planned' ? 'selected' : '' %>>Planlandı</option>
              <option value="Approved" <%= filterStatus === 'Approved' ? 'selected' : '' %>>Onaylandı</option>
              <option value="In_Production" <%= filterStatus === 'In_Production' ? 'selected' : '' %>>Üretimde</option>
              <option value="Quality_Check" <%= filterStatus === 'Quality_Check' ? 'selected' : '' %>>Kalite Kontrolde</option>
              <option value="Completed" <%= filterStatus === 'Completed' ? 'selected' : '' %>>Tamamlandı</option>
              <option value="Cancelled" <%= filterStatus === 'Cancelled' ? 'selected' : '' %>>İptal Edildi</option>
            </select>
          </div>

          <div class="input-group" style="flex: 1; min-width: 150px;">
            <label for="priority">Öncelik</label>
            <select id="priority" name="priority">
              <option value="">-- Tüm Öncelikler --</option>
              <option value="Low" <%= filterPriority === 'Low' ? 'selected' : '' %>>Düşük</option>
              <option value="Normal" <%= filterPriority === 'Normal' ? 'selected' : '' %>>Normal</option>
              <option value="High" <%= filterPriority === 'High' ? 'selected' : '' %>>Yüksek</option>
              <option value="Urgent" <%= filterPriority === 'Urgent' ? 'selected' : '' %>>Acil</option>
            </select>
          </div>

          <div class="input-group" style="flex: 1; min-width: 180px;">
            <label for="workCenter">İş Merkezi / İstasyon</label>
            <select id="workCenter" name="workCenter">
              <option value="">-- Tüm İstasyonlar --</option>
              <% WORK_CENTERS.forEach(wc => { %>
                <option value="<%= wc %>" <%= filterWorkCenter === wc ? 'selected' : '' %>><%= wc %></option>
              <% }); %>
            </select>
          </div>

          <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn">Filtrele</button>
            <a href="/production/orders" class="btn btn-secondary">Temizle</a>
          </div>
        </form>
      </div>

      <!-- Orders Table -->
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>İş Emri No</th>
              <th>Üretim Başlığı & Nihai Ürün</th>
              <th>İş Merkezi / İstasyon</th>
              <th>Miktar & İlerleme</th>
              <th>Zamanlama (Plan)</th>
              <th>Öncelik</th>
              <th>Durum</th>
              <th>Aksiyonlar</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(ord => { 
                const planned = parseFloat(ord.plannedQuantity) || 1;
                const completed = parseFloat(ord.completedQuantity) || 0;
                const progressPct = Math.min(100, Math.round((completed / planned) * 100));
              %>
                <tr>
                  <td>
                    <strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= ord.workOrderNo %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-muted);"><%= new Date(ord.createdAt).toLocaleDateString('tr-TR') %></div>
                  </td>
                  <td>
                    <div style="font-weight: 700; color: var(--text-main);"><%= ord.productionTitle %></div>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">
                      📦 <%= ord.stockItem ? ord.stockItem.name : '—' %>
                    </div>
                  </td>
                  <td>
                    <span style="font-size: 0.85rem; font-weight: 600;"><%= ord.workCenter %></span>
                    <% if (ord.productionManager) { %>
                      <div style="font-size: 0.75rem; color: var(--text-muted);">👨‍💼 Sorumlu: <%= ord.productionManager %></div>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-size: 0.85rem; font-weight: 700;">
                      <%= completed %> / <%= planned %> <%= ord.unit %>
                    </div>
                    <div style="margin-top: 4px; background: rgba(255,255,255,0.08); height: 6px; border-radius: 4px; overflow: hidden; width: 100px;">
                      <div style="width: <%= progressPct %>%; background: <%= progressPct === 100 ? 'var(--emerald)' : 'var(--indigo)' %>; height: 100%;"></div>
                    </div>
                    <span style="font-size: 0.725rem; color: var(--text-muted);"><%= progressPct %>% Tamamlandı</span>
                  </td>
                  <td>
                    <div style="font-size: 0.8rem;"> Başlangıç: <%= new Date(ord.plannedStartDate).toLocaleDateString('tr-TR') %></div>
                    <div style="font-size: 0.8rem; color: var(--text-muted);"> Bitiş: <%= new Date(ord.plannedEndDate).toLocaleDateString('tr-TR') %></div>
                  </td>
                  <td>
                    <% if (ord.priority === 'Urgent') { %>
                      <span class="status-pill status-rejected">🚨 Acil</span>
                    <% } else if (ord.priority === 'High') { %>
                      <span class="status-pill status-onleave">⚡ Yüksek</span>
                    <% } else if (ord.priority === 'Low') { %>
                      <span class="status-pill status-pending">Düşük</span>
                    <% } else { %>
                      <span class="status-pill status-approved">Normal</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (ord.status === 'Planned') { %>
                      <span class="status-pill status-pending">📋 Planlandı</span>
                    <% } else if (ord.status === 'Approved') { %>
                      <span class="status-pill status-approved">✓ Onaylandı</span>
                    <% } else if (ord.status === 'In_Production') { %>
                      <span class="status-pill status-onleave">⚙️ Üretimde</span>
                    <% } else if (ord.status === 'Quality_Check') { %>
                      <span class="status-pill status-active">🔍 Kalite Kontrolde</span>
                    <% } else if (ord.status === 'Completed') { %>
                      <span class="status-pill status-active">✅ Tamamlandı</span>
                    <% } else { %>
                      <span class="status-pill status-rejected">❌ İptal Edildi</span>
                    <% } %>
                  </td>
                  <td>
                    <form action="/production/orders/<%= ord.id %>/status" method="POST" style="display: flex; gap: 0.3rem;">
                      <% if (ord.status === 'Planned') { %>
                        <input type="hidden" name="status" value="Approved">
                        <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                      <% } else if (ord.status === 'Approved') { %>
                        <input type="hidden" name="status" value="In_Production">
                        <button type="submit" class="btn btn-sm btn-primary">Üretime Al</button>
                      <% } else if (ord.status === 'In_Production') { %>
                        <input type="hidden" name="status" value="Quality_Check">
                        <button type="submit" class="btn btn-sm btn-warning">Kaliteye Gönder</button>
                      <% } else if (ord.status === 'Quality_Check') { %>
                        <input type="hidden" name="status" value="Completed">
                        <button type="submit" class="btn btn-sm btn-success">Tamamla</button>
                      <% } %>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                  Henüz herhangi bir üretim iş emri bulunmamaktadır.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
