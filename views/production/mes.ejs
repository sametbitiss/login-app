<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üretim İzleme & MES — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#10b981"/><stop offset="100%" stop-color="#059669"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">ÜRETİM PLANLAMA</div>
      <a href="/production/orders" class="mss-link active">Üretim Özellikleri</a>
      <div class="mss-sub">
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri Listesi</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/bom" class="mss-sub-link">📜 Reçeteler (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🔄 Rotalama & Operasyon</a>
        <a href="/production/capacity" class="mss-sub-link">📊 Kapasite Planlama</a>
        <a href="/production/mes" class="mss-sub-link active">🏭 Üretim İzleme & MES</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= ALL_ROLES[user.role] || user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Stock_Manager') { %>
          <a href="/stock" class="mt-link">Stok & Depo</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Sales_Manager') { %>
          <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Purchase_Manager') { %>
          <a href="/purchase" class="mt-link">Satın Alma</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link active">Üretim Planlama</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav -->
      <div class="module-subnav">
        <a href="/production/orders" class="msn-link">📋 İş Emirleri</a>
        <a href="/production/bom" class="msn-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="msn-link">🔄 Rotalama & Operasyonlar</a>
        <a href="/production/capacity" class="msn-link">📊 Kapasite Planlaması</a>
        <a href="/production/mes" class="msn-link active">🏭 Üretim İzleme & MES</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Üretim İzleme & MES (Manufacturing Execution System)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">İmalat sahasından anlık gerçekleşen üretim miktarının, harcanan saatlerin ve Fire/Hurda oranlarının bildirilmesi.</p>
        </div>
      </div>

      <!-- MES Shop Floor Table -->
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>İş Emri No</th>
              <th>Üretim Tanımı</th>
              <th>İş Merkezi / İstasyon</th>
              <th>Planlanan / Gerçekleşen Miktar</th>
              <th>Harcanan İşçilik (Saat)</th>
              <th>Fire / Hurda Miktarı</th>
              <th>Fire Oranı (%)</th>
              <th>Saha Veri Güncelleme (MES)</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(ord => { 
                const completed = parseFloat(ord.completedQuantity) || 0;
                const scrap = parseFloat(ord.scrapQuantity) || 0;
                const totalProduced = completed + scrap;
                const scrapPct = totalProduced > 0 ? Math.round((scrap / totalProduced) * 1000) / 10 : 0;
              %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= ord.workOrderNo %></strong></td>
                  <td>
                    <strong style="color: var(--text-main);"><%= ord.productionTitle %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Ürün: <%= ord.stockItem ? ord.stockItem.name : '—' %></div>
                  </td>
                  <td><strong style="color: var(--emerald);"><%= ord.workCenter %></strong></td>
                  <td>
                    <strong><%= completed %> / <%= ord.plannedQuantity %> <%= ord.unit %></strong>
                  </td>
                  <td>
                    <strong><%= ord.actualHours || 0 %> / <%= ord.estimatedHours || 0 %> Sa.</strong>
                  </td>
                  <td>
                    <strong style="color: <%= scrap > 0 ? 'var(--rose)' : 'var(--text-muted)' %>;"><%= scrap %> <%= ord.unit %></strong>
                  </td>
                  <td>
                    <% if (scrapPct > 5) { %>
                      <span class="status-pill status-rejected">🚨 %<%= scrapPct %> Fire</span>
                    <% } else if (scrapPct > 0) { %>
                      <span class="status-pill status-onleave">%<%= scrapPct %> Fire</span>
                    <% } else { %>
                      <span class="status-pill status-approved">%0 Fire</span>
                    <% } %>
                  </td>
                  <td>
                    <form action="/production/mes/<%= ord.id %>" method="POST" style="display: flex; gap: 0.4rem; align-items: center;">
                      <input type="number" name="completedQuantity" step="1" value="<%= ord.completedQuantity || 0 %>" style="width: 70px; padding: 4px 6px; font-size: 0.8rem;" title="Üretilen Miktar">
                      <input type="number" name="scrapQuantity" step="1" value="<%= ord.scrapQuantity || 0 %>" style="width: 60px; padding: 4px 6px; font-size: 0.8rem;" title="Hurda/Fire Miktarı">
                      <input type="number" name="actualHours" step="0.5" value="<%= ord.actualHours || 0 %>" style="width: 65px; padding: 4px 6px; font-size: 0.8rem;" title="Harcanan Saat">
                      <button type="submit" class="btn btn-sm">Kaydet</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                  Saha kaydı yapılacak aktif iş emri bulunmamaktadır.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
