<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MES Saha Üretim Kontrol Terminali — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .mes-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow-md); transition: transform 0.2s, box-shadow 0.2s; }
    .mes-card:hover { border-color: var(--indigo); box-shadow: 0 8px 30px rgba(99, 102, 241, 0.15); }
    .mes-progress-bar { height: 8px; background: var(--bg-elevated); border-radius: 4px; overflow: hidden; margin: 12px 0; }
    .mes-progress-fill { height: 100%; background: linear-gradient(90deg, #6366f1, #10b981); border-radius: 4px; }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link active">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/production/analytics" class="msn-link">📊 Analitik</a>
        <a href="/production/orders" class="msn-link">📋 İş Emirleri</a>
        <a href="/production/orders/add" class="msn-link">➕ İş Emri Ekle</a>
        <a href="/production/mrp" class="msn-link">⚡ MRP Hesaplama</a>
        <a href="/production/bom" class="msn-link">📜 Reçeteler (BOM)</a>
        <a href="/production/routing" class="msn-link">🛠️ Rotalama</a>
        <a href="/production/capacity" class="msn-link">🏭 Kapasite</a>
        <a href="/production/mes" class="msn-link active">📱 MES Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>MES Saha Üretim Giriş Terminali (Shop Floor Data Collection)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tezgah başı imalat girişi, miktar bildirimi ve otomatik reçeteli hammadde düşümü (Backflushing).</p>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;">
        <% if (orders.length === 0) { %>
          <div style="grid-column: span 2; text-align: center; padding: 3rem; color: var(--text-muted);">Aktif iş emri bulunmamaktadır.</div>
        <% } else { %>
          <% orders.forEach(o => { %>
            <% const pct = Math.min(100, Math.round((parseFloat(o.completedQuantity) / (parseFloat(o.plannedQuantity) || 1)) * 100)); %>
            <div class="mes-card">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                <div>
                  <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--indigo); font-weight: 700;"><%= o.workOrderNo %></span>
                  <h4 style="font-size: 1.1rem; font-weight: 800; color: var(--text-primary); margin-top: 2px;"><%= o.productionTitle %></h4>
                </div>
                <span class="status-pill <%= o.status === 'Completed' ? 'status-active' : 'status-pending' %>">● <%= o.status %></span>
              </div>

              <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 8px;">
                İstasyon: <strong><%= o.workCenter %></strong> | Ürün: <strong><%= o.stockItem ? o.stockItem.name : '—' %></strong>
              </div>

              <div class="mes-progress-bar">
                <div class="mes-progress-fill" style="width: <%= pct %>%;"></div>
              </div>

              <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
                <span>Planlanan: <strong><%= o.plannedQuantity %> <%= o.unit %></strong></span>
                <span>Tamamlanan: <strong style="color: var(--emerald);"><%= o.completedQuantity %> <%= o.unit %></strong></span>
                <span>Fire: <strong style="color: var(--rose);"><%= o.scrapQuantity %></strong></span>
              </div>

              <form action="/production/mes/<%= o.id %>" method="POST" style="background: var(--bg-elevated); border: 1px solid var(--border); padding: 16px; border-radius: 12px;">
                <div style="font-size: 0.85rem; font-weight: 700; color: var(--indigo); margin-bottom: 10px;">📱 Operatör Miktar Bildirimi (Backflushing)</div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                  <div>
                    <label style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 4px;">Yeni Üretilen Miktar (+)</label>
                    <input type="number" name="completedQuantity" placeholder="10" min="0.01" step="0.01" class="form-control" required style="font-size: 0.9rem; padding: 6px 10px;">
                  </div>
                  <div>
                    <label style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 4px;">Fire / Hurda Miktarı</label>
                    <input type="number" name="scrapQuantity" placeholder="0" min="0" step="0.01" class="form-control" style="font-size: 0.9rem; padding: 6px 10px;">
                  </div>
                </div>
                <button type="submit" class="btn btn-sm btn-success" style="width: 100%;">
                  ⚙️ Üretimi Bildir & Reçete Stokunu Otomatik Düş (Backflush)
                </button>
              </form>
            </div>
          <% }); %>
        <% } %>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
