<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atölye Kartları — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .btn-indigo-gradient {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff !important;
      font-weight: 800;
      font-size: 0.95rem;
      padding: 12px 24px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 4px 18px rgba(99, 102, 241, 0.4);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-indigo-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(99, 102, 241, 0.6);
      color: #fff;
    }
    .btn-action-edit {
      background: rgba(99, 102, 241, 0.15);
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.4);
      font-weight: 700;
      font-size: 0.82rem;
      padding: 7px 14px;
      border-radius: 8px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-action-edit:hover {
      background: rgba(99, 102, 241, 0.3);
      color: #fff;
      transform: translateY(-1px);
    }
    .btn-action-delete {
      background: rgba(239, 68, 68, 0.1);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.3);
      font-weight: 700;
      font-size: 0.82rem;
      padding: 7px 12px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-action-delete:hover {
      background: rgba(239, 68, 68, 0.25);
      color: #fff;
    }
    .user-avatar-badge {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: linear-gradient(135deg, #6366f1, #8b5cf6);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 800;
      flex-shrink: 0;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link active">🏢 Atölye Kartları</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link active">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <!-- Header & New Button -->
      <div class="page-header" style="margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
        <div>
          <h1 style="font-size: 1.6rem; font-weight: 900; color: #fff; margin: 0; letter-spacing: -0.5px;">🏢 Atölye Kartları Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.92rem; margin-top: 4px;">Üretim ve imalat operasyonlarının yürütüldüğü atölye tanımları, kapasite merkezleri ve sorumlu atamaları.</p>
        </div>
        <a href="/production/workshops/add" class="btn-indigo-gradient">
          <span>➕ Yeni Atölye Ekle</span>
        </a>
      </div>

      <!-- KPI Summary Cards -->
      <div class="kpi-grid" style="margin-bottom: 24px;">
        <div class="kpi-card">
          <div class="kpi-icon-box" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">🏢</div>
          <div>
            <div class="kpi-title">Toplam Atölye Sayısı</div>
            <div class="kpi-value"><%= stats.total %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon-box" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">🟢</div>
          <div>
            <div class="kpi-title">Aktif Atölyeler</div>
            <div class="kpi-value" style="color: #34d399;"><%= stats.active %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon-box" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8;">⚪</div>
          <div>
            <div class="kpi-title">Pasif Atölyeler</div>
            <div class="kpi-value" style="color: #94a3b8;"><%= stats.inactive %></div>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon-box" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">👤</div>
          <div>
            <div class="kpi-title">Atölye Sorumluları</div>
            <div class="kpi-value" style="color: #fbbf24;"><%= stats.uniqueManagers %> Kişi</div>
          </div>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="filter-bar">
        <div class="filter-tabs">
          <button class="filter-tab active" onclick="filterWorkshopCategory('all', this)">Tüm Atölyeler (<%= workshops.length %>)</button>
          <button class="filter-tab" onclick="filterWorkshopCategory('Active', this)">Aktif Atölyeler (<%= stats.active %>)</button>
          <button class="filter-tab" onclick="filterWorkshopCategory('Inactive', this)">Pasif Atölyeler (<%= stats.inactive %>)</button>
        </div>
        <div class="search-box">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="workshopSearchInput" class="search-input" placeholder="Atölye Kodu, Adı veya Sorumlu Ara..." onkeyup="filterWorkshopTable()">
        </div>
      </div>

      <!-- Workshops Data Table -->
      <div class="table-wrapper">
        <table class="data-table" id="workshopsTable">
          <thead>
            <tr>
              <th style="width: 140px;">Atölye Kodu</th>
              <th style="min-width: 200px;">Atölye Adı</th>
              <th style="min-width: 220px;">Atölye Sorumlusu</th>
              <th style="width: 120px;">Durum</th>
              <th style="min-width: 220px;">Açıklama / Notlar</th>
              <th style="width: 130px;">Kayıt Tarihi</th>
              <th style="text-align: right; width: 140px;">İşlemler</th>
            </tr>
          </thead>
          <tbody>
            <% if (workshops.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                  🏢 Henüz tanımlanmış bir atölye kartı bulunmamaktadır.<br>
                  <span style="font-size: 0.82rem; margin-top: 6px; display: inline-block; color: #818cf8;">Sağ üst köşedeki <strong>'➕ Yeni Atölye Ekle'</strong> butonuna tıklayarak ilk atölyeyi kaydedebilirsiniz.</span>
                </td>
              </tr>
            <% } else { %>
              <% workshops.forEach(w => { %>
                <tr data-status="<%= w.durum %>">
                  <td>
                    <strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;"><%= w.atolyeKodu %></strong>
                  </td>
                  <td>
                    <strong style="color: var(--text-primary); font-size: 0.92rem;"><%= w.atolyeAdi %></strong>
                  </td>
                  <td>
                    <% if (w.sorumlu) { %>
                      <div style="display: flex; align-items: center; gap: 10px;">
                        <div class="user-avatar-badge">
                          <%= (w.sorumlu.ad ? w.sorumlu.ad.charAt(0) : w.sorumlu.kullaniciAdi.charAt(0)).toUpperCase() %>
                        </div>
                        <div>
                          <div style="font-weight: 700; color: #fff; font-size: 0.85rem;">
                            <%= w.sorumlu.ad ? `${w.sorumlu.ad} ${w.sorumlu.soyad || ''}` : w.sorumlu.kullaniciAdi %>
                          </div>
                          <div style="font-size: 0.72rem; color: var(--text-muted); display: flex; gap: 6px; align-items: center; margin-top: 1px;">
                            <span>@<%= w.sorumlu.kullaniciAdi %></span>
                            <span>•</span>
                            <span style="color: #818cf8;"><%= w.sorumlu.departman || 'Genel Personel' %></span>
                          </div>
                        </div>
                      </div>
                    <% } else { %>
                      <span style="color: var(--text-muted);">— Sorumlu Atanmamış —</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (w.durum === 'Active') { %>
                      <span class="badge-status badge-has-bom">🟢 Aktif</span>
                    <% } else { %>
                      <span class="badge-status badge-no-bom">⚪ Pasif</span>
                    <% } %>
                  </td>
                  <td style="font-size: 0.82rem; color: var(--text-secondary); max-width: 260px;">
                    <%= w.aciklama || '—' %>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">
                    <%= new Date(w.createdAt).toLocaleDateString('tr-TR') %>
                  </td>
                  <td style="text-align: right; white-space: nowrap;">
                    <a href="/production/workshops/edit/<%= w.id %>" class="btn-action-edit">
                      ✏️ Düzenle
                    </a>
                    <form action="/production/workshops/delete/<%= w.id %>" method="POST" style="display: inline-block; margin-left: 4px;" onsubmit="return confirm('Bu atölye kartını silmek istediğinize emin misiniz?');">
                      <button type="submit" class="btn-action-delete" title="Atölyeyi Sil">🗑️</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

    </main>
  </div>

  <script>
    function filterWorkshopTable() {
      const query = (document.getElementById('workshopSearchInput').value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('#workshopsTable tbody tr');
      rows.forEach(tr => {
        const text = tr.textContent.toLowerCase();
        tr.style.display = text.includes(query) ? '' : 'none';
      });
    }

    function filterWorkshopCategory(cat, btn) {
      document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const rows = document.querySelectorAll('#workshopsTable tbody tr');
      rows.forEach(tr => {
        if (cat === 'all') {
          tr.style.display = '';
        } else {
          tr.style.display = tr.dataset.status === cat ? '' : 'none';
        }
      });
    }

    function updateClock() { 
      const now = new Date(); 
      const el = document.getElementById('liveTime'); 
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); 
    }
    updateClock(); 
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
