<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni İş Emri Hazırlama & Onaylama — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .order-wizard-nav {
      display: flex;
      gap: 6px;
      background: rgba(15, 23, 42, 0.7);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 6px;
      margin-bottom: 24px;
      overflow-x: auto;
    }
    .wizard-tab-btn {
      flex: 1;
      min-width: 170px;
      background: transparent;
      border: 1px solid transparent;
      outline: none;
      padding: 12px 16px;
      color: #94a3b8;
      font-size: 0.86rem;
      font-weight: 700;
      cursor: pointer;
      border-radius: 12px;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      white-space: nowrap;
    }
    .wizard-tab-btn:hover {
      color: #f8fafc;
      background: rgba(255, 255, 255, 0.04);
    }
    .wizard-tab-btn.active {
      color: #ffffff;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.35), rgba(79, 70, 229, 0.2));
      border-color: rgba(99, 102, 241, 0.5);
      box-shadow: 0 4px 16px rgba(99, 102, 241, 0.25);
    }

    .wizard-tab-content { display: none; }
    .wizard-tab-content.active { display: block; animation: wizardFadeIn 0.25s ease; }

    @keyframes wizardFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .tab-badge {
      background: rgba(255, 255, 255, 0.1);
      padding: 2px 7px;
      border-radius: 12px;
      font-size: 0.72rem;
      font-family: 'JetBrains Mono', monospace;
    }
    .wizard-tab-btn.active .tab-badge {
      background: rgba(99, 102, 241, 0.4);
      color: #ffffff;
    }

    .form-section-card {
      background: rgba(30, 41, 59, 0.4);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      padding: 24px;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

    .section-title {
      font-size: 0.96rem;
      font-weight: 800;
      color: #818cf8;
      display: flex;
      align-items: center;
      gap: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: 0.84rem; font-weight: 700; color: #94a3b8; }
    .form-control {
      background: #090e1a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: all 0.2s;
      width: 100%;
      box-sizing: border-box;
    }
    .form-control:focus { border-color: #6366f1; box-shadow: 0 0 14px rgba(99, 102, 241, 0.3); }
    .form-control[readonly] { background: #0f172a; color: #cbd5e1; border-color: #1e293b; cursor: default; }

    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .form-row-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; }

    .info-box-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
    }
    .info-box {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 14px 18px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .info-box-label { font-size: 0.76rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; }
    .info-box-value { font-size: 1.1rem; font-weight: 800; color: #f8fafc; font-family: 'JetBrains Mono', monospace; }

    .wizard-footer-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(15, 23, 42, 0.85);
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 16px 24px;
      margin-top: 24px;
      backdrop-filter: blur(12px);
    }

    .btn-step-nav {
      background: rgba(255, 255, 255, 0.08);
      color: #f8fafc;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 10px 20px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }
    .btn-step-nav:hover { background: rgba(255, 255, 255, 0.16); transform: translateY(-1px); }

    .btn-submit-order {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff !important;
      font-weight: 900;
      font-size: 1rem;
      padding: 12px 28px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .btn-submit-order:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(16, 185, 129, 0.55); }

    .btn-back-link {
      background: rgba(148, 163, 184, 0.1);
      color: #94a3b8;
      border: 1px solid rgba(148, 163, 184, 0.25);
      padding: 10px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      text-decoration: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-back-link:hover { background: rgba(148, 163, 184, 0.2); color: #fff; }

    .delay-alert-box {
      border-radius: 16px;
      padding: 16px 20px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      font-weight: 700;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }
    .delay-alert-box--danger {
      background: linear-gradient(135deg, rgba(244, 63, 94, 0.2), rgba(225, 29, 72, 0.1));
      border: 1.5px solid rgba(244, 63, 94, 0.5);
      color: #fecdd3;
    }
    .delay-alert-box--success {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.18), rgba(5, 150, 105, 0.1));
      border: 1.5px solid rgba(16, 185, 129, 0.4);
      color: #a7f3d0;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub"><a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a></div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <!-- Page Header -->
      <div class="page-header" style="margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between;">
        <div>
          <div style="font-size: 0.85rem; color: #818cf8; font-weight: 700; margin-bottom: 4px;">🏭 PROCESS & OPERASYON PLANLAMA SİHİRBAZI</div>
          <h1 style="display: flex; align-items: center; gap: 12px;">
            <span>📋 Yeni İş Emri Hazırlama & Onaylama</span>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.92rem; margin-top: 4px;">
            MRP motorundan hesaplanan net ihtiyaç miktarı, operasyon süreleri ve fireli bileşenler sekmeler halinde incelenerek onaylanır.
          </p>
        </div>
        <div style="display: flex; gap: 10px;">
          <a href="/production/mrp" class="btn-back-link">
            <span>⚡ MRP Önerilerine Dön</span>
          </a>
          <a href="/production/orders" class="btn-back-link">
            <span>📋 İş Emirleri Listesi</span>
          </a>
        </div>
      </div>

      <!-- 10. TERMİN TARİHİ GECİKME KONTROL UYARI BANNER'I -->
      <% if (hasDeliveryDate) { %>
        <% if (isDeliveryDelayed) { %>
          <div class="delay-alert-box delay-alert-box--danger">
            <div style="font-size: 1.8rem;">⚠️</div>
            <div>
              <div style="font-size: 1rem; font-weight: 900; color: #fb7185; margin-bottom: 2px;">
                DİKKAT: Termin Gecikmesi Riski Bulunmaktadır!
              </div>
              <div style="font-size: 0.86rem; line-height: 1.4;">
                Hesaplanan tahmini üretim bitiş tarihi (<strong style="color: #ffffff;"><%= projectedEndDate %></strong>), 
                ilişkili siparişin teslim termin tarihinden (<strong style="color: #ffffff;"><%= deliveryDate %></strong>) 
                <strong style="color: #fb7185;"><%= delayDays %> GÜN</strong> sonradır. Lütfen iş merkezi vardiyasını veya kapasitesini artırmayı değerlendiriniz.
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="delay-alert-box delay-alert-box--success">
            <div style="font-size: 1.8rem;">✅</div>
            <div>
              <div style="font-size: 1rem; font-weight: 900; color: #34d399; margin-bottom: 2px;">
                Termin Uygun: Üretim Süresi Zamanında Yetişmektedir
              </div>
              <div style="font-size: 0.86rem; line-height: 1.4;">
                Hesaplanan tahmini üretim bitiş tarihi (<strong style="color: #ffffff;"><%= projectedEndDate %></strong>), 
                ilişkili siparişin teslim termin tarihine (<strong style="color: #ffffff;"><%= deliveryDate %></strong>) tamamen uygundur.
              </div>
            </div>
          </div>
        <% } %>
      <% } %>

      <!-- Selected Product Header Strip -->
      <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.18), rgba(16, 185, 129, 0.12)); border: 1.5px solid rgba(99, 102, 241, 0.4); border-radius: 16px; padding: 18px 22px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 4px 20px rgba(0,0,0,0.25);">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="width: 50px; height: 50px; border-radius: 14px; background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);">
            🏭
          </div>
          <div>
            <div style="font-size: 0.75rem; font-weight: 800; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 2px;">
              📦 HEDEF İMALAT ÜRÜNÜ (MRP KAYNAKLI)
            </div>
            <div style="font-size: 1.2rem; font-weight: 900; color: #ffffff; display: flex; align-items: center; gap: 10px;">
              <span style="color: #34d399; font-family: 'JetBrains Mono', monospace;">[<%= targetProduct.stokKodu %>]</span>
              <span><%= targetProduct.ad %></span>
            </div>
            <div style="font-size: 0.825rem; color: #cbd5e1; margin-top: 4px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
              <span>Kategori: <strong style="color: #fbbf24;"><%= targetProduct.kategori === 'Mamul' ? 'Mamul' : 'Yarı Mamul' %></strong></span>
              <span style="color: #475569;">•</span>
              <span>Birim: <strong><%= targetProduct.birim || 'Adet' %></strong></span>
              <span style="color: #475569;">•</span>
              <span>Mevcut Depo Stoğu: <strong style="color: #34d399;"><%= parseFloat(targetProduct.mevcutStok || 0) %> <%= targetProduct.birim || 'Adet' %></strong></span>
              <span style="color: #475569;">•</span>
              <span>Varsayılan Depo: <strong><%= targetProduct.depoLokasyonu || 'Ana Depo' %></strong></span>
            </div>
          </div>
        </div>
      </div>

      <!-- TABLI MENÜ NAVİGASYONU -->
      <nav class="order-wizard-nav">
        <button type="button" class="wizard-tab-btn active" onclick="switchWizardTab('tab-order-info', 1, event)">
          <span>📋 1. Temel Parametreler</span>
        </button>
        <button type="button" class="wizard-tab-btn" onclick="switchWizardTab('tab-recipe-routing', 2, event)">
          <span>📜 2. Reçete & Rota</span>
        </button>
        <button type="button" class="wizard-tab-btn" onclick="switchWizardTab('tab-operations', 3, event)">
          <span>⏱️ 3. Operasyonlar & Süre</span>
          <span class="tab-badge"><%= routingOperations.length %> Adım</span>
        </button>
        <button type="button" class="wizard-tab-btn" onclick="switchWizardTab('tab-components', 4, event)">
          <span>📦 4. Fireli Bileşenler</span>
          <span class="tab-badge"><%= calculatedComponents.length %> Kalem</span>
        </button>
        <button type="button" class="wizard-tab-btn" onclick="switchWizardTab('tab-instructions', 5, event)">
          <span>✍️ 5. Talimatlar & Onay</span>
        </button>
      </nav>

      <!-- MAIN FORM -->
      <form action="/production/orders/add" method="POST" id="workOrderForm">
        <input type="hidden" name="stockId" value="<%= targetProduct.id %>">
        <input type="hidden" name="stockItemId" value="<%= targetProduct.id %>">
        <input type="hidden" name="demandRef" value="<%= effectiveDemandRef %>">
        <input type="hidden" name="workCenter" value="<%= primaryWorkCenter %>">
        <input type="hidden" name="estimatedHours" value="<%= totalDurationHours %>">

        <!-- ======================================================== -->
        <!-- SEKME 1: 📋 1. İŞ EMRİ TEMEL BİLGİLERİ                   -->
        <!-- ======================================================== -->
        <div id="tab-order-info" class="wizard-tab-content active">
          <div class="form-section-card">
            <div class="section-title">
              <span>📋 1. İş Emri Temel Parametreleri</span>
            </div>

            <div class="form-row-4">
              <!-- 1. İş Emri No (Sistem tarafından atanır, değiştirilemez) -->
              <div class="form-group">
                <label class="form-label">İş Emri No <span style="color: #34d399;">(Otomatik & Salt Okunur)</span></label>
                <input type="text" name="isEmriNo" value="<%= nextWorkOrderNo %>" readonly class="form-control" style="font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399; letter-spacing: 0.5px;">
              </div>

              <!-- 2. Öncelik Seviyesi -->
              <div class="form-group">
                <label class="form-label">Öncelik Seviyesi</label>
                <select name="priority" class="form-control" style="font-weight: 700;">
                  <option value="Low" <%= effectivePriority === 'Low' ? 'selected' : '' %>>Düşük (Low)</option>
                  <option value="Normal" <%= effectivePriority === 'Normal' ? 'selected' : '' %>>Normal (Standart)</option>
                  <option value="High" <%= effectivePriority === 'High' ? 'selected' : '' %>>Yüksek / Acil (High)</option>
                  <option value="Urgent" <%= effectivePriority === 'Urgent' ? 'selected' : '' %>>🚨 Çok Acil (Urgent)</option>
                </select>
              </div>

              <!-- 4. Sipariş / Üretim Miktarı (Değiştirilemez - Salt Okunur) -->
              <div class="form-group">
                <label class="form-label">Net Üretim Miktarı <span style="color: #34d399;">(MRP Net İhtiyaç - Değiştirilemez)</span></label>
                <input type="number" name="plannedQuantity" id="inputPlannedQty" value="<%= effectiveQty %>" readonly class="form-control" style="font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 1rem; color: #34d399;" title="MRP tarafından hesaplanan net ihtiyaç miktarıdır">
              </div>

              <!-- Birim -->
              <div class="form-group">
                <label class="form-label">Birim</label>
                <input type="text" name="unit" value="<%= targetProduct.birim || 'Adet' %>" readonly class="form-control" style="font-weight: 700;">
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Ürün Kodu & Adı (DB Kaydı)</label>
                <input type="text" value="[<%= targetProduct.stokKodu %>] <%= targetProduct.ad %>" readonly class="form-control" style="color: #cbd5e1; font-weight: 700;">
              </div>
              <div class="form-group">
                <label class="form-label">İlişkili Sipariş / Talep No (Kaynak)</label>
                <input type="text" value="<%= effectiveDemandRef || 'Doğrudan Üretim Planı' %>" readonly class="form-control" style="font-family: 'JetBrains Mono', monospace; color: #818cf8; font-weight: 800;">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">İş Emri Başlığı</label>
              <input type="text" name="uretimBasligi" value="🏭 [İş Emri] <%= targetProduct.ad %> (<%= effectiveQty %> <%= targetProduct.birim || 'Adet' %>)" class="form-control" style="font-weight: 700;">
            </div>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- SEKME 2: 📜 2. AKTİF REÇETE VE ROTA BİLGİSİ              -->
        <!-- ======================================================== -->
        <div id="tab-recipe-routing" class="wizard-tab-content">
          <div class="form-section-card">
            <div class="section-title">
              <span>📜 2. Aktif Reçete & Rota Mühendisliği</span>
            </div>

            <div class="form-row-2">
              <div class="info-box" style="border-left: 4px solid #6366f1; padding: 18px 22px;">
                <span class="info-box-label">📜 Tanımlı Aktif Reçete</span>
                <span class="info-box-value" style="color: #818cf8; font-size: 1.25rem;"><%= activeRecipeCode %></span>
                <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 6px;">
                  Versiyon: <strong style="color: #f8fafc;"><%= activeRecipeVersion %></strong> • Durum: <span style="color: #34d399; font-weight: 700;">✓ Aktif</span>
                </div>
              </div>

              <div class="info-box" style="border-left: 4px solid #f59e0b; padding: 18px 22px;">
                <span class="info-box-label">🛠️ Tanımlı Aktif Rota</span>
                <span class="info-box-value" style="color: #fbbf24; font-size: 1.25rem;"><%= activeRoutingCode %></span>
                <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 6px;">
                  Toplam Operasyon: <strong style="color: #f8fafc;"><%= routingOperations.length %> Adım</strong>
                </div>
              </div>
            </div>

            <div class="info-box-grid" style="margin-top: 8px;">
              <div class="info-box">
                <span class="info-box-label">Ürün Stok Kodu</span>
                <span class="info-box-value" style="color: #34d399;"><%= targetProduct.stokKodu %></span>
              </div>
              <div class="info-box">
                <span class="info-box-label">Ürün Kategorisi</span>
                <span class="info-box-value"><%= targetProduct.kategori %></span>
              </div>
              <div class="info-box">
                <span class="info-box-label">Mevcut Fiziksel Stok</span>
                <span class="info-box-value"><%= parseFloat(targetProduct.mevcutStok || 0) %> <%= targetProduct.birim %></span>
              </div>
              <div class="info-box">
                <span class="info-box-label">Varsayılan Depo Lokasyonu</span>
                <span class="info-box-value" style="font-size: 0.95rem;"><%= targetProduct.depoLokasyonu || 'Ana Depo' %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- SEKME 3: ⏱️ 3. ROTA OPERASYONLARI & KAPASİTE PLANI        -->
        <!-- ======================================================== -->
        <div id="tab-operations" class="wizard-tab-content">
          <div class="form-section-card">
            <div class="section-title">
              <span>⏱️ 3. Rota Operasyon Adımları & Bileşen Bazlı Süre Projeksiyonu</span>
            </div>

            <div class="table-wrapper">
              <table class="data-table">
                <thead>
                  <tr>
                    <th style="width: 70px; text-align: center;">Adım</th>
                    <th>Operasyon Kodu & Adı</th>
                    <th>Hedef İş Merkezi (İstasyon)</th>
                    <th>İşlenen / Tüketilen Bileşen</th>
                    <th style="text-align: right;">Hazırlık Süresi</th>
                    <th style="text-align: right;">Birim Süre</th>
                    <th style="text-align: right;">Çalışma Süresi Hesabı</th>
                    <th style="text-align: right;">Toplam Adım Süresi</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (routingOperations.length === 0) { %>
                    <tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">Bu ürün için tanımlı rota operasyonu bulunamadı. Genel montaj süresi uygulanacaktır.</td></tr>
                  <% } else { %>
                    <% routingOperations.forEach(op => { %>
                      <tr>
                        <td style="text-align: center;"><span style="background: rgba(99, 102, 241, 0.2); color: #818cf8; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">#<%= op.operasyonSira %></span></td>
                        <td>
                          <strong style="color: var(--text-primary);"><%= op.operasyonAdi %></strong>
                          <div style="color: #94a3b8; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">[<%= op.operasyonKodu %>]</div>
                        </td>
                        <td style="font-size: 0.85rem; color: #cbd5e1;"><%= op.isMerkezi %></td>
                        <td style="font-size: 0.85rem; color: #a5b4fc; font-weight: 600;"><%= op.matchedComponentsText %></td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;"><%= op.hazirlikSuresiDakika %> Dk</td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;"><%= op.calismaSuresiDakikaBirim %> Dk</td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; color: #fbbf24;"><%= op.formulaText %></td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399;"><%= op.formattedDuration %></td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Süre ve Tarih Özeti -->
            <div class="info-box-grid" style="margin-top: 10px;">
              <div class="info-box">
                <span class="info-box-label">Toplam Hazırlık Süresi</span>
                <span class="info-box-value"><%= totalSetupMins %> Dk (<%= (totalSetupMins/60).toFixed(2) %> Sa)</span>
              </div>
              <div class="info-box">
                <span class="info-box-label">Toplam Çalışma Süresi</span>
                <span class="info-box-value"><%= totalRunMins.toFixed(1) %> Dk (<%= (totalRunMins/60).toFixed(2) %> Sa)</span>
              </div>
              <div class="info-box">
                <span class="info-box-label">Toplam İmalat Süresi</span>
                <span class="info-box-value" style="color: #fbbf24; font-size: 1.15rem;"><%= totalTimePretty %></span>
              </div>
            </div>

            <!-- Başlangıç ve Bitiş Zamanı Form Alanları (Başlangıç readonly, Bitiş min=Başlangıç) -->
            <div class="form-row-2" style="margin-top: 10px;">
              <div class="form-group">
                <label class="form-label">Planlanan Başlangıç Tarihi <span style="color: #34d399;">(İstasyon Kuyruğuna Göre - Değiştirilemez)</span></label>
                <input type="date" name="plannedStartDate" id="inputPlannedStartDate" value="<%= projectedStartDate %>" readonly class="form-control" style="font-weight: 800; font-family: 'JetBrains Mono', monospace; color: #34d399;">
              </div>

              <div class="form-group">
                <label class="form-label">Planlanan Bitiş Tarihi <span style="color: #fbbf24;">(Tahmini Kapasiteye Göre)</span></label>
                <input type="date" name="plannedEndDate" id="inputPlannedEndDate" value="<%= projectedEndDate %>" min="<%= projectedStartDate %>" class="form-control" style="font-weight: 800; font-family: 'JetBrains Mono', monospace; color: #fbbf24;" onchange="validateEndDate(this)">
              </div>
            </div>

            <div style="background: rgba(15, 23, 42, 0.6); padding: 12px 18px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.05); font-size: 0.85rem; color: #cbd5e1;">
              📌 <strong>İş İstasyonu Kuyruk Durumu:</strong> <%= workCenterStatusText %>
            </div>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- SEKME 4: 📦 4. TÜKETİLECEK BİLEŞENLER & FİRE PLANI       -->
        <!-- ======================================================== -->
        <div id="tab-components" class="wizard-tab-content">
          <div class="form-section-card">
            <div class="section-title">
              <span>📦 4. Tüketilecek Bileşenler & Fireli Harcama Planı</span>
            </div>

            <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 4px;">
              Reçetedeki her bileşenin hangi adımda, hangi operasyonda harcanacağı ve <strong><%= effectiveQty %> <%= targetProduct.birim || 'Adet' %></strong> net üretim için fire oranı eklenerek <strong>Math.ceil</strong> ile yuvarlanmış gereksinimleri aşağıda listelenmiştir.
            </div>

            <div class="table-wrapper">
              <table class="data-table">
                <thead>
                  <tr>
                    <th style="width: 70px; text-align: center;">Adım</th>
                    <th>Operasyon Adı</th>
                    <th>Bileşen Kodu & Adı</th>
                    <th>Kategori</th>
                    <th style="text-align: right;">Birim Katsayı</th>
                    <th style="text-align: right;">Fire Oranı</th>
                    <th style="text-align: right;">Brüt İhtiyaç</th>
                    <th style="text-align: right;">Net Harcama İhtiyacı</th>
                    <th style="text-align: right;">Depo Stoğu</th>
                    <th style="text-align: center;">Stok Yeterliliği</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (calculatedComponents.length === 0) { %>
                    <tr><td colspan="10" style="text-align: center; color: var(--text-muted); padding: 2rem;">Bu ürün için tanımlı reçete bileşeni bulunamadı.</td></tr>
                  <% } else { %>
                    <% calculatedComponents.forEach(comp => { %>
                      <tr>
                        <td style="text-align: center;">
                          <span style="background: rgba(99, 102, 241, 0.2); color: #818cf8; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">
                            #<%= comp.operasyonKodu %>
                          </span>
                        </td>
                        <td><strong style="color: #cbd5e1;"><%= comp.operasyonAdi %></strong></td>
                        <td>
                          <% if (comp.isLabor) { %>
                            <span style="color: #a5b4fc; font-weight: 700;">⚙️ <%= comp.bilesenAdi %></span>
                          <% } else { %>
                            <strong style="color: var(--text-primary);"><%= comp.bilesenAdi %></strong>
                            <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #94a3b8;">[<%= comp.bilesenKodu %>]</div>
                          <% } %>
                        </td>
                        <td>
                          <% if (comp.kategori === 'Hammadde') { %>
                            <span class="status-pill status-approved">🟦 Hammadde</span>
                          <% } else if (['Yari_Mamul', 'Yarı_Mamul'].includes(comp.kategori)) { %>
                            <span class="status-pill status-pending">🟧 Yarı Mamul</span>
                          <% } else { %>
                            <span class="status-pill status-completed">⚙️ <%= comp.kategori %></span>
                          <% } %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;">
                          <%= comp.isLabor ? '—' : `${comp.gerekliMiktar} ${comp.birim}` %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;">
                          <%= comp.fireOrani > 0 ? `%${comp.fireOrani}` : '—' %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; color: #cbd5e1;">
                          <%= comp.isLabor ? '—' : `${comp.hesaplananBrutMiktar.toFixed(2)} ${comp.birim}` %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 900; font-size: 0.95rem; color: #fbbf24;">
                          <%= comp.isLabor ? '—' : `${comp.yuvarlanmisMiktar} ${comp.birim}` %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;">
                          <%= comp.isLabor ? '—' : `${parseFloat(comp.mevcutStok || 0)} ${comp.birim}` %>
                        </td>
                        <td style="text-align: center;">
                          <% if (comp.isLabor) { %>
                            <span style="color: #94a3b8; font-size: 0.78rem;">Saf İşçilik</span>
                          <% } else if (comp.stokYeterli) { %>
                            <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">✓ Yeterli</span>
                          <% } else { %>
                            <span style="background: rgba(244, 63, 94, 0.15); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">🚨 Eksik</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- SEKME 5: ✍️ 5. SAHA TALİMATLARI & ONAY                     -->
        <!-- ======================================================== -->
        <div id="tab-instructions" class="wizard-tab-content">
          <div class="form-section-card">
            <div class="section-title">
              <span>✍️ 5. Saha Talimatları, Görevlendirme & Onay</span>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Üretim Yöneticisi / Sorumlu Mühendis</label>
                <input type="text" name="productionManager" value="<%= user ? (user.firstName ? user.firstName + ' ' + (user.lastName || '') : user.username) : 'Üretim Mühendisi' %>" class="form-control" style="font-weight: 700;">
              </div>

              <div class="form-group">
                <label class="form-label">Reçete / Mühendislik Notları</label>
                <input type="text" name="receteNotlari" value="Aktif Reçete: <%= activeRecipeCode %> • Rota: <%= activeRoutingCode %>" class="form-control">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Saha Notları / İmalat Açıklaması</label>
              <textarea name="notlar" rows="3" class="form-control" placeholder="İmalat sahasına iletilecek özel talimatlar...">[MRP Onaylı İş Emri] <%= targetProduct.ad %> için <%= effectiveQty %> <%= targetProduct.birim %> imalat iş emridir. <%= effectiveDemandRef ? 'Kaynak: ' + effectiveDemandRef : '' %></textarea>
            </div>
          </div>
        </div>

        <!-- WIZARD STEPPER FOOTER (Sekmeler Arası Geçiş & Hızlı Aksiyon) -->
        <div class="wizard-footer-bar">
          <div style="display: flex; gap: 10px;">
            <button type="button" class="btn-step-nav" id="btnPrevTab" onclick="navigateWizard(-1)" style="display: none;">
              <span>← Önceki Adım</span>
            </button>
            <button type="button" class="btn-step-nav" id="btnNextTab" onclick="navigateWizard(1)">
              <span>Sonraki Adım →</span>
            </button>
          </div>

          <div style="display: flex; align-items: center; gap: 14px;">
            <a href="/production/mrp" class="btn-back-link" style="padding: 10px 18px;">
              ✕ İptal
            </a>
            <button type="submit" class="btn-submit-order" id="btnConfirmWorkOrder">
              <span>✅ İş Emrini Onayla ve Başlat</span>
            </button>
          </div>
        </div>

      </form>

    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    let currentStepIndex = 1;
    const tabIds = [
      'tab-order-info',
      'tab-recipe-routing',
      'tab-operations',
      'tab-components',
      'tab-instructions'
    ];

    function switchWizardTab(tabId, stepIdx, ev) {
      document.querySelectorAll('.wizard-tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.wizard-tab-content').forEach(c => c.classList.remove('active'));

      currentStepIndex = stepIdx;

      const buttons = document.querySelectorAll('.wizard-tab-btn');
      if (buttons[stepIdx - 1]) {
        buttons[stepIdx - 1].classList.add('active');
      }

      const target = document.getElementById(tabId);
      if (target) target.classList.add('active');

      const btnPrev = document.getElementById('btnPrevTab');
      const btnNext = document.getElementById('btnNextTab');
      if (btnPrev) btnPrev.style.display = currentStepIndex === 1 ? 'none' : 'inline-flex';
      if (btnNext) btnNext.style.display = currentStepIndex === tabIds.length ? 'none' : 'inline-flex';
    }

    function navigateWizard(direction) {
      const nextIdx = currentStepIndex + direction;
      if (nextIdx >= 1 && nextIdx <= tabIds.length) {
        switchWizardTab(tabIds[nextIdx - 1], nextIdx);
      }
    }

    function validateEndDate(input) {
      const startDateInput = document.getElementById('inputPlannedStartDate');
      if (startDateInput && input.value && startDateInput.value) {
        if (input.value < startDateInput.value) {
          alert('Bitiş tarihi, başlangıç tarihinden (' + startDateInput.value + ') önce olamaz!');
          input.value = startDateInput.value;
        }
      }
    }
  </script>
</body>
</html>
