<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni İş Emri Oluştur — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link active">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/production/analytics" class="msn-link">📊 Analitik</a>
        <a href="/production/orders" class="msn-link">📋 İş Emirleri</a>
        <a href="/production/orders/add" class="msn-link active">➕ İş Emri Ekle</a>
        <a href="/production/mrp" class="msn-link">⚡ MRP Hesaplama</a>
        <a href="/production/bom" class="msn-link">📜 Reçeteler (BOM)</a>
        <a href="/production/routing" class="msn-link">🛠️ Rotalama</a>
        <a href="/production/capacity" class="msn-link">🏭 Kapasite</a>
        <a href="/production/mes" class="msn-link">📱 MES Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Yeni Üretim İş Emri Aç</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Mamul veya yarı mamul imalatı için fabrikayı yetkilendirin.</p>
        </div>
        <a href="/production/orders" class="btn btn-secondary">← İş Emirleri Listesi</a>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; box-shadow: var(--shadow-md);">
        <form action="/production/orders/add" method="POST">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label">İş Emri Numarası</label>
              <input type="text" name="workOrderNo" value="<%= nextWorkOrderNo %>" class="form-control" readonly style="background: var(--bg-elevated); font-family: 'JetBrains Mono', monospace; font-weight: 700; color: var(--indigo);">
            </div>
            <div class="form-group">
              <label class="form-label">Üretim Başlığı / Açıklama *</label>
              <input type="text" name="productionTitle" placeholder="Örn: 50 Adet CNC Gövde Seri İmalatı" class="form-control" required>
            </div>
            <div class="form-group">
              <label class="form-label">Üretilecek Ürün / Mamul *</label>
              <select name="stockItemId" class="form-control" required>
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>"><%= item.stockCode %> — <%= item.name %> (Mevcut: <%= item.currentStock %> <%= item.unit %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Hedeflenen Üretim Miktarı *</label>
              <input type="number" name="plannedQuantity" value="10" min="1" step="0.01" class="form-control" required>
            </div>
            <div class="form-group">
              <label class="form-label">Birim</label>
              <input type="text" name="unit" value="Adet" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Atanacak İş İstasyonu / İstasyon</label>
              <select name="workCenter" class="form-control">
                <% WORK_CENTERS.forEach(wc => { %>
                  <option value="<%= wc %>"><%= wc %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Öncelik Seviyesi</label>
              <select name="priority" class="form-control">
                <option value="Normal">Normal</option>
                <option value="High">⚡ Yüksek Öncelikli</option>
                <option value="Urgent">🚨 Acil Üretim</option>
                <option value="Low">Düşük Öncelikli</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Tahmini Süre (Saat)</label>
              <input type="number" name="estimatedHours" value="12" min="0" step="0.5" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Planlanan Başlangıç Tarihi *</label>
              <input type="date" name="plannedStartDate" value="<%= new Date().toISOString().split('T')[0] %>" class="form-control" required>
            </div>
            <div class="form-group">
              <label class="form-label">Planlanan Bitiş Tarihi *</label>
              <input type="date" name="plannedEndDate" value="<%= new Date(Date.now() + 7*24*60*60*1000).toISOString().split('T')[0] %>" class="form-control" required>
            </div>
            <div class="form-group">
              <label class="form-label">Üretim Mühendisi / Sorumlu</label>
              <input type="text" name="productionManager" value="<%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %>" class="form-control">
            </div>
          </div>
          <div class="form-group" style="margin-top: 16px;">
            <label class="form-label">Üretim Notları & Özel İmalat Talimatları</label>
            <textarea name="notes" class="form-control" rows="2" placeholder="Teknik resim revizyon no, özel toleranslar..."></textarea>
          </div>
          <div style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="submit" class="btn">⚙️ İş Emrini Kaydet ve Başlat</button>
            <a href="/production/orders" class="btn btn-secondary">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
