<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni İş Emri Hazırlama & Onaylama — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .form-container-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      margin-bottom: 30px;
      box-shadow: var(--shadow-sm);
    }

    .form-section {
      background: rgba(30, 41, 59, 0.4);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      padding: 24px;
      margin-bottom: 24px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

    .section-title {
      font-size: 1rem;
      font-weight: 800;
      color: #818cf8;
      display: flex;
      align-items: center;
      gap: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: 0.84rem; font-weight: 700; color: #94a3b8; }
    .form-control {
      background: #090e1a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: all 0.2s;
      width: 100%;
      box-sizing: border-box;
    }
    .form-control:focus { border-color: #6366f1; box-shadow: 0 0 14px rgba(99, 102, 241, 0.3); }
    .form-control[readonly] { background: #0f172a; color: #cbd5e1; border-color: #1e293b; cursor: default; }

    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .form-row-4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; }

    .info-box-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
    }
    .info-box {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 14px 18px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .info-box-label { font-size: 0.76rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; }
    .info-box-value { font-size: 1.1rem; font-weight: 800; color: #f8fafc; font-family: 'JetBrains Mono', monospace; }

    .btn-submit-order {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff !important;
      font-weight: 900;
      font-size: 1.05rem;
      padding: 16px 36px;
      border-radius: 14px;
      border: none;
      cursor: pointer;
      box-shadow: 0 8px 25px rgba(16, 185, 129, 0.45);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .btn-submit-order:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(16, 185, 129, 0.6); }

    .btn-back-link {
      background: rgba(148, 163, 184, 0.1);
      color: #94a3b8;
      border: 1px solid rgba(148, 163, 184, 0.25);
      padding: 10px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      text-decoration: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-back-link:hover { background: rgba(148, 163, 184, 0.2); color: #fff; }

    .delay-alert-box {
      border-radius: 16px;
      padding: 18px 22px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 16px;
      font-weight: 700;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }
    .delay-alert-box--danger {
      background: linear-gradient(135deg, rgba(244, 63, 94, 0.2), rgba(225, 29, 72, 0.1));
      border: 1.5px solid rgba(244, 63, 94, 0.5);
      color: #fecdd3;
    }
    .delay-alert-box--success {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.18), rgba(5, 150, 105, 0.1));
      border: 1.5px solid rgba(16, 185, 129, 0.4);
      color: #a7f3d0;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub"><a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a></div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link active">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <!-- Page Header -->
      <div class="page-header" style="margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;">
        <div>
          <div style="font-size: 0.85rem; color: #818cf8; font-weight: 700; margin-bottom: 4px;">🏭 PROCESS & OPERASYON PLANLAMA</div>
          <h1 style="display: flex; align-items: center; gap: 12px;">
            <span>📋 Yeni İş Emri Hazırlama & Onaylama</span>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.92rem; margin-top: 4px;">
            Seçilen mamul veya yarı mamulün operasyon adımları, süre/kapasite projeksiyonu ve fireli bileşen ihtiyaçları incelenerek imalat iş emri onaylanır.
          </p>
        </div>
        <div style="display: flex; gap: 10px;">
          <a href="/production/mrp" class="btn-back-link">
            <span>⚡ MRP Önerilerine Dön</span>
          </a>
          <a href="/production/orders" class="btn-back-link">
            <span>📋 İş Emirleri Listesi</span>
          </a>
        </div>
      </div>

      <!-- 10. TERMİN TARİHİ GECİKME KONTROL UYARI BANNER'I -->
      <% if (hasDeliveryDate) { %>
        <% if (isDeliveryDelayed) { %>
          <div class="delay-alert-box delay-alert-box--danger">
            <div style="font-size: 2rem;">⚠️</div>
            <div>
              <div style="font-size: 1.05rem; font-weight: 900; color: #fb7185; margin-bottom: 2px;">
                DİKKAT: Termin Gecikmesi Riski Bulunmaktadır!
              </div>
              <div style="font-size: 0.88rem; line-height: 1.4;">
                Hesaplanan tahmini üretim bitiş tarihi (<strong style="color: #ffffff;"><%= projectedEndDate %></strong>), 
                ilişkili siparişin teslim termin tarihinden (<strong style="color: #ffffff;"><%= deliveryDate %></strong>) 
                <strong style="color: #fb7185;"><%= delayDays %> GÜN</strong> sonradır. Lütfen iş merkezi vardiyasını veya kapasitesini artırmayı değerlendiriniz.
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="delay-alert-box delay-alert-box--success">
            <div style="font-size: 2rem;">✅</div>
            <div>
              <div style="font-size: 1.05rem; font-weight: 900; color: #34d399; margin-bottom: 2px;">
                Termin Uygun: Üretim Süresi Zamanında Yetişmektedir
              </div>
              <div style="font-size: 0.88rem; line-height: 1.4;">
                Hesaplanan tahmini üretim bitiş tarihi (<strong style="color: #ffffff;"><%= projectedEndDate %></strong>), 
                ilişkili siparişin teslim termin tarihine (<strong style="color: #ffffff;"><%= deliveryDate %></strong>) tamamen uygundur.
              </div>
            </div>
          </div>
        <% } %>
      <% } %>

      <!-- PRODUCT SELECTOR (Ürün seçilmemişse dropdown, seçildiyse rozetli kart) -->
      <% if (!targetProduct) { %>
        <div class="form-section">
          <div class="section-title">📦 Üretilecek Ürünü Seçiniz</div>
          <div class="form-group">
            <label class="form-label">Hedef İmalat Ürünü (Mamul veya Yarı Mamul)</label>
            <select class="form-control" onchange="if(this.value) window.location='/production/orders/add?stockId=' + this.value;">
              <option value="">-- Üretilecek Ürünü Seçiniz --</option>
              <% stockItems.forEach(s => { %>
                <option value="<%= s.id %>">[<%= s.stokKodu %>] <%= s.ad %> (<%= s.kategori %>)</option>
              <% }); %>
            </select>
          </div>
        </div>
      <% } else { %>
        <!-- Locked / Selected Product Card -->
        <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.18), rgba(16, 185, 129, 0.12)); border: 1.5px solid rgba(99, 102, 241, 0.4); border-radius: 16px; padding: 20px 24px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 4px 24px rgba(0,0,0,0.3);">
          <div style="display: flex; align-items: center; gap: 18px;">
            <div style="width: 54px; height: 54px; border-radius: 14px; background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);">
              🏭
            </div>
            <div>
              <div style="font-size: 0.78rem; font-weight: 800; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 2px;">
                📦 HEDEF İMALAT ÜRÜNÜ
              </div>
              <div style="font-size: 1.25rem; font-weight: 900; color: #ffffff; display: flex; align-items: center; gap: 10px;">
                <span style="color: #34d399; font-family: 'JetBrains Mono', monospace;">[<%= targetProduct.stokKodu %>]</span>
                <span><%= targetProduct.ad %></span>
              </div>
              <div style="font-size: 0.85rem; color: #cbd5e1; margin-top: 6px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                <span>Kategori: <strong style="color: #fbbf24;"><%= targetProduct.kategori === 'Mamul' ? 'Mamul' : 'Yarı Mamul' %></strong></span>
                <span style="color: #475569;">•</span>
                <span>Birim: <strong><%= targetProduct.birim || 'Adet' %></strong></span>
                <span style="color: #475569;">•</span>
                <span>Mevcut Depo Stoğu: <strong style="color: #34d399;"><%= targetProduct.mevcutStok %> <%= targetProduct.birim || 'Adet' %></strong></span>
              </div>
            </div>
          </div>
          <div>
            <select class="form-control" style="font-size: 0.82rem; padding: 8px 12px; width: auto;" onchange="if(this.value) window.location='/production/orders/add?stockId=' + this.value + '&qty=<%= effectiveQty %>&demandRef=<%= encodeURIComponent(effectiveDemandRef) %>';">
              <option value="">Farklı Ürün Seç...</option>
              <% stockItems.forEach(s => { %>
                <option value="<%= s.id %>" <%= s.id === targetProduct.id ? 'selected' : '' %>>[<%= s.stokKodu %>] <%= s.ad %></option>
              <% }); %>
            </select>
          </div>
        </div>

        <!-- MAIN FORM -->
        <form action="/production/orders/add" method="POST" id="workOrderForm">
          <input type="hidden" name="stockId" value="<%= targetProduct.id %>">
          <input type="hidden" name="demandRef" value="<%= effectiveDemandRef %>">

          <!-- SECTION 1: İŞ EMRİ TEMEL BİLGİLERİ -->
          <div class="form-section">
            <div class="section-title">
              <span>📋 1. İş Emri Temel Parametreleri</span>
            </div>

            <div class="form-row-4">
              <!-- 1. İş Emri No (Sistem tarafından atanır, değiştirilemez) -->
              <div class="form-group">
                <label class="form-label">1. İş Emri No <span style="color: #34d399;">(Otomatik & Salt Okunur)</span></label>
                <input type="text" name="isEmriNo" value="<%= nextWorkOrderNo %>" readonly class="form-control" style="font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399; letter-spacing: 0.5px;">
              </div>

              <!-- 2. Öncelik Seviyesi -->
              <div class="form-group">
                <label class="form-label">2. Öncelik Seviyesi</label>
                <select name="priority" class="form-control" style="font-weight: 700;">
                  <option value="Low" <%= effectivePriority === 'Low' ? 'selected' : '' %>>Düşük (Low)</option>
                  <option value="Normal" <%= effectivePriority === 'Normal' ? 'selected' : '' %>>Normal (Standart)</option>
                  <option value="High" <%= effectivePriority === 'High' ? 'selected' : '' %>>Yüksek / Acil (High)</option>
                  <option value="Urgent" <%= effectivePriority === 'Urgent' ? 'selected' : '' %>>🚨 Çok Acil (Urgent)</option>
                </select>
              </div>

              <!-- 4. Sipariş / Üretim Miktarı -->
              <div class="form-group">
                <label class="form-label">4. Üretim Miktarı</label>
                <input type="number" name="plannedQuantity" id="inputPlannedQty" value="<%= effectiveQty %>" step="1" min="1" class="form-control" style="font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 1rem; color: #f8fafc;" onchange="updateQtyParam(this.value)">
              </div>

              <!-- Birim -->
              <div class="form-group">
                <label class="form-label">Birim</label>
                <input type="text" name="unit" value="<%= targetProduct.birim || 'Adet' %>" readonly class="form-control" style="font-weight: 700;">
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">3. Ürün Kodu & Adı (DB Kaydı)</label>
                <input type="text" value="[<%= targetProduct.stokKodu %>] <%= targetProduct.ad %>" readonly class="form-control" style="color: #cbd5e1; font-weight: 700;">
              </div>
              <div class="form-group">
                <label class="form-label">İlişkili Sipariş / Talep No (Kaynak)</label>
                <input type="text" value="<%= effectiveDemandRef || 'Doğrudan Üretim Planı' %>" readonly class="form-control" style="font-family: 'JetBrains Mono', monospace; color: #818cf8; font-weight: 800;">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">İş Emri Başlığı</label>
              <input type="text" name="uretimBasligi" value="🏭 [İş Emri] <%= targetProduct.ad %> (<%= effectiveQty %> <%= targetProduct.birim || 'Adet' %>)" class="form-control" style="font-weight: 700;">
            </div>
          </div>

          <!-- SECTION 2: AKTİF REÇETE VE ROTA BİLGİSİ -->
          <div class="form-section">
            <div class="section-title">
              <span>📜 5. Aktif Reçete & Rota Bilgisi</span>
            </div>

            <div class="form-row-2">
              <div class="info-box" style="border-left: 3px solid #6366f1;">
                <span class="info-box-label">📜 Aktif Reçete Kodu & Versiyon</span>
                <span class="info-box-value" style="color: #818cf8;"><%= activeRecipeCode %> (<%= activeRecipeVersion %>)</span>
              </div>
              <div class="info-box" style="border-left: 3px solid #f59e0b;">
                <span class="info-box-label">🛠️ Aktif Rota Kodu & İstasyonlar</span>
                <span class="info-box-value" style="color: #fbbf24;"><%= activeRoutingCode %> (<%= routingOperations.length %> Operasyon Adımı)</span>
              </div>
            </div>
          </div>

          <!-- SECTION 3: ROTA OPERASYON ADIMLARI & SÜRE/KAPASİTE PLANI -->
          <div class="form-section">
            <div class="section-title">
              <span>⏱️ 8. Rota Operasyon Adımları & Süre / Kapasite Projeksiyonu</span>
            </div>

            <div class="table-wrapper">
              <table class="data-table">
                <thead>
                  <tr>
                    <th style="width: 70px; text-align: center;">Adım</th>
                    <th>Operasyon Kodu</th>
                    <th>Operasyon Adı</th>
                    <th>Hedef İş Merkezi (İstasyon)</th>
                    <th style="text-align: right;">Hazırlık (Dk)</th>
                    <th style="text-align: right;">Birim Süre (Dk)</th>
                    <th style="text-align: right;">Toplam Süre (Dk)</th>
                    <th style="text-align: right;">Toplam Süre (Saat)</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (routingOperations.length === 0) { %>
                    <tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">Bu ürün için tanımlı rota operasyonu bulunamadı. Genel montaj süresi uygulanacaktır.</td></tr>
                  <% } else { %>
                    <% routingOperations.forEach(op => { %>
                      <tr>
                        <td style="text-align: center;"><span style="background: rgba(99, 102, 241, 0.2); color: #818cf8; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">#<%= op.operasyonSira %></span></td>
                        <td><strong style="color: #cbd5e1; font-family: 'JetBrains Mono', monospace;">[<%= op.operasyonKodu %>]</strong></td>
                        <td><strong style="color: var(--text-primary);"><%= op.operasyonAdi %></strong></td>
                        <td style="font-size: 0.85rem; color: #cbd5e1;"><%= op.isMerkezi %></td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;"><%= op.hazirlikSuresiDakika %> Dk</td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;"><%= op.calismaSuresiDakikaBirim %> Dk</td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; color: #fbbf24;"><%= op.toplamDakika %> Dk</td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399;"><%= op.toplamSaat %> Saat</td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Süre ve Tarih Özeti -->
            <div class="info-box-grid" style="margin-top: 10px;">
              <div class="info-box">
                <span class="info-box-label">Toplam Hazırlık Süresi</span>
                <span class="info-box-value"><%= totalSetupMins %> Dk</span>
              </div>
              <div class="info-box">
                <span class="info-box-label">Toplam Çalışma Süresi</span>
                <span class="info-box-value"><%= totalRunMins %> Dk</span>
              </div>
              <div class="info-box">
                <span class="info-box-label">Toplam İmalat Süresi</span>
                <span class="info-box-value" style="color: #fbbf24;"><%= totalDurationHours %> Saat</span>
              </div>
            </div>

            <!-- Başlangıç ve Bitiş Zamanı Form Alanları -->
            <div class="form-row-3" style="margin-top: 10px;">
              <div class="form-group">
                <label class="form-label">8. Başlangıç Tarihi <span style="color: #34d399;">(İş Merkezi Kuyruk Durumuna Göre)</span></label>
                <input type="date" name="plannedStartDate" value="<%= projectedStartDate %>" class="form-control" style="font-weight: 800; font-family: 'JetBrains Mono', monospace; color: #34d399;">
              </div>

              <div class="form-group">
                <label class="form-label">8. Bitiş Tarihi <span style="color: #fbbf24;">(Kapasiteye Göre Hesaplanmış)</span></label>
                <input type="date" name="plannedEndDate" value="<%= projectedEndDate %>" class="form-control" style="font-weight: 800; font-family: 'JetBrains Mono', monospace; color: #fbbf24;">
              </div>

              <div class="form-group">
                <label class="form-label">Ana İş İstasyonu</label>
                <select name="workCenter" class="form-control">
                  <% WORK_CENTERS.forEach(wc => { %>
                    <option value="<%= wc %>" <%= primaryWorkCenter === wc ? 'selected' : '' %>><%= wc %></option>
                  <% }); %>
                </select>
              </div>
            </div>

            <div style="background: rgba(15, 23, 42, 0.6); padding: 10px 16px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.05); font-size: 0.85rem; color: #cbd5e1;">
              📌 <strong>İş İstasyonu Kuyruk Durumu:</strong> <%= workCenterStatusText %>
            </div>
          </div>

          <!-- SECTION 4: TÜKETİLECEK BİLEŞENLER & FİRELİ HARCAMA PLANI -->
          <div class="form-section">
            <div class="section-title">
              <span>📦 6, 7 & 9. Tüketilecek Bileşenler & Fireli Harcama Planı (MRP Yuvarlanmış)</span>
            </div>

            <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 4px;">
              Reçetedeki her bileşenin hangi adımda, hangi operasyonda harcanacağı ve MRP katmanında fire oranı eklenerek <strong>Math.ceil</strong> ile yuvarlanmış net gereksinimleri aşağıda listelenmiştir.
            </div>

            <div class="table-wrapper">
              <table class="data-table">
                <thead>
                  <tr>
                    <th style="width: 70px; text-align: center;">Adım</th>
                    <th>Operasyon Adı</th>
                    <th>Bileşen Kodu & Adı</th>
                    <th>Kategori</th>
                    <th style="text-align: right;">Birim Katsayı</th>
                    <th style="text-align: right;">Fire Oranı</th>
                    <th style="text-align: right;">Brüt İhtiyaç</th>
                    <th style="text-align: right;">9. Yuvarlanmış İhtiyaç</th>
                    <th style="text-align: right;">Depo Stoğu</th>
                    <th style="text-align: center;">Stok Yeterliliği</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (calculatedComponents.length === 0) { %>
                    <tr><td colspan="10" style="text-align: center; color: var(--text-muted); padding: 2rem;">Bu ürün için tanımlı reçete bileşeni bulunamadı.</td></tr>
                  <% } else { %>
                    <% calculatedComponents.forEach(comp => { %>
                      <tr>
                        <td style="text-align: center;">
                          <span style="background: rgba(99, 102, 241, 0.2); color: #818cf8; padding: 2px 8px; border-radius: 6px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">
                            #<%= comp.operasyonKodu %>
                          </span>
                        </td>
                        <td><strong style="color: #cbd5e1;"><%= comp.operasyonAdi %></strong></td>
                        <td>
                          <% if (comp.isLabor) { %>
                            <span style="color: #a5b4fc; font-weight: 700;">⚙️ <%= comp.bilesenAdi %></span>
                          <% } else { %>
                            <strong style="color: var(--text-primary);"><%= comp.bilesenAdi %></strong>
                            <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #94a3b8;">[<%= comp.bilesenKodu %>]</div>
                          <% } %>
                        </td>
                        <td>
                          <% if (comp.kategori === 'Hammadde') { %>
                            <span class="status-pill status-approved">🟦 Hammadde</span>
                          <% } else if (['Yari_Mamul', 'Yarı_Mamul'].includes(comp.kategori)) { %>
                            <span class="status-pill status-pending">🟧 Yarı Mamul</span>
                          <% } else { %>
                            <span class="status-pill status-completed">⚙️ <%= comp.kategori %></span>
                          <% } %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;">
                          <%= comp.isLabor ? '—' : `${comp.gerekliMiktar} ${comp.birim}` %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;">
                          <%= comp.fireOrani > 0 ? `%${comp.fireOrani}` : '—' %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; color: #cbd5e1;">
                          <%= comp.isLabor ? '—' : `${comp.hesaplananBrutMiktar.toFixed(2)} ${comp.birim}` %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 900; font-size: 0.95rem; color: #fbbf24;">
                          <%= comp.isLabor ? '—' : `${comp.yuvarlanmisMiktar} ${comp.birim}` %>
                        </td>
                        <td style="text-align: right; font-family: 'JetBrains Mono', monospace;">
                          <%= comp.isLabor ? '—' : `${comp.mevcutStok} ${comp.birim}` %>
                        </td>
                        <td style="text-align: center;">
                          <% if (comp.isLabor) { %>
                            <span style="color: #94a3b8; font-size: 0.78rem;">Saf İşçilik</span>
                          <% } else if (comp.stokYeterli) { %>
                            <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">✓ Yeterli</span>
                          <% } else { %>
                            <span style="background: rgba(244, 63, 94, 0.15); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">🚨 Eksik</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- SECTION 5: NOTLAR & SAHA TALİMATLARI -->
          <div class="form-section">
            <div class="section-title">
              <span>✍️ Saha Talimatları & Sorumlu Personel</span>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Üretim Yöneticisi / Sorumlu Mühendis</label>
                <input type="text" name="productionManager" value="<%= user ? (user.firstName ? user.firstName + ' ' + (user.lastName || '') : user.username) : 'Üretim Mühendisi' %>" class="form-control" style="font-weight: 700;">
              </div>

              <div class="form-group">
                <label class="form-label">Reçete / Mühendislik Notları</label>
                <input type="text" name="receteNotlari" value="Aktif Reçete: <%= activeRecipeCode %> • Rota: <%= activeRoutingCode %>" class="form-control">
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Saha Notları / İmalat Açıklaması</label>
              <textarea name="notlar" rows="2" class="form-control" placeholder="İmalat sahasına iletilecek özel talimatlar...">[MRP Onaylı İş Emri] <%= targetProduct.ad %> için <%= effectiveQty %> <%= targetProduct.birim %> imalat iş emridir. <%= effectiveDemandRef ? 'Kaynak: ' + effectiveDemandRef : '' %></textarea>
            </div>
          </div>

          <!-- SECTION 6: ACTIONS & CONFIRMATION -->
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px 0; margin-top: 10px;">
            <a href="/production/mrp" class="btn-back-link" style="padding: 14px 24px; font-size: 0.95rem;">
              ✕ İptal Et / MRP Ekranına Dön
            </a>

            <button type="submit" class="btn-submit-order" id="btnConfirmWorkOrder">
              <span>✅ İş Emrini Onayla ve Başlat</span>
            </button>
          </div>

        </form>
      <% } %>

    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    function updateQtyParam(newQty) {
      if (!newQty || parseFloat(newQty) <= 0) return;
      const url = new URL(window.location.href);
      url.searchParams.set('qty', newQty);
      url.searchParams.set('plannedQty', newQty);
      window.location.href = url.toString();
    }
  </script>
</body>
</html>
