<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni İş Emri Oluştur — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .form-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      box-shadow: var(--shadow-md);
      margin-bottom: 28px;
      position: relative;
      overflow: hidden;
    }
    .form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #6366f1, #8b5cf6);
    }

    .form-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }
    .form-card-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      background: rgba(99, 102, 241, 0.15);
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .form-card-title { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); }
    .form-card-sub { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }

    .aesthetic-group { margin-bottom: 16px; }
    .aesthetic-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 6px;
      display: block;
    }
    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      padding: 12px 14px;
      border-radius: 10px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }
    .aesthetic-input[readonly] {
      background: #090d16;
      border-color: #334155;
      color: #818cf8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      cursor: not-allowed;
    }
    .aesthetic-input::placeholder { color: #475569; }

    .btn-indigo-gradient {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 12px 28px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-indigo-gradient:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5); }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link active">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/production/analytics" class="msn-link">📊 Analitik</a>
        <a href="/production/requisitions" class="msn-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="msn-link">📋 İş Emirleri</a>
        <a href="/production/orders/add" class="msn-link active">➕ İş Emri Ekle</a>
        <a href="/production/mrp" class="msn-link">⚡ MRP Hesaplama</a>
        <a href="/production/bom" class="msn-link">📜 Reçeteler (BOM)</a>
        <a href="/production/routing" class="msn-link">🛠️ Rotalama</a>
        <a href="/production/capacity" class="msn-link">🏭 Kapasite</a>
        <a href="/production/mes" class="msn-link">📱 MES Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Yeni Üretim İş Emri Aç</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Mamul veya yarı mamul imalatı için fabrikayı yetkilendirin.</p>
        </div>
        <a href="/production/orders" class="btn btn-secondary" style="border-radius: 10px;">← İş Emirleri Listesi</a>
      </div>

      <div class="form-card">
        <div class="form-card-header">
          <div class="form-card-icon">⚙️</div>
          <div>
            <div class="form-card-title">Üretim İş Emri Başlatma Formu</div>
            <div class="form-card-sub">Fabrika üretim hedefi, iş istasyonu, öncelik ve planlanan imalat süreleri</div>
          </div>
        </div>

        <form action="/production/orders/add" method="POST">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px;">
            <div class="aesthetic-group">
              <label class="aesthetic-label">İş Emri Numarası (Otomatik)</label>
              <input type="text" name="workOrderNo" value="<%= nextWorkOrderNo %>" class="aesthetic-input" readonly>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Üretim Başlığı / Açıklama *</label>
              <input type="text" name="productionTitle" placeholder="Örn: 50 Adet CNC Gövde Seri İmalatı" class="aesthetic-input" required>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Üretilecek Ürün / Mamul *</label>
              <select name="stockItemId" class="aesthetic-input" required style="cursor: pointer;">
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>"><%= item.stockCode %> — <%= item.name %> (Mevcut: <%= item.currentStock %> <%= item.unit %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Hedeflenen Üretim Miktarı *</label>
              <input type="number" name="plannedQuantity" value="10" min="1" step="0.01" class="aesthetic-input" required>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Birim</label>
              <input type="text" name="unit" value="Adet" class="aesthetic-input">
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Atanacak İş İstasyonu / Tezgah Parkuru</label>
              <select name="workCenter" class="aesthetic-input" style="cursor: pointer;">
                <% WORK_CENTERS.forEach(wc => { %>
                  <option value="<%= wc %>"><%= wc %></option>
                <% }); %>
              </select>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Öncelik Seviyesi</label>
              <select name="priority" class="aesthetic-input" style="cursor: pointer;">
                <option value="Normal">Normal</option>
                <option value="High">⚡ Yüksek Öncelikli</option>
                <option value="Urgent">🚨 Acil Üretim</option>
                <option value="Low">Düşük Öncelikli</option>
              </select>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Tahmini Süre (Saat)</label>
              <input type="number" name="estimatedHours" value="12" min="0" step="0.5" class="aesthetic-input">
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Planlanan Başlangıç Tarihi *</label>
              <input type="date" name="plannedStartDate" value="<%= new Date().toISOString().split('T')[0] %>" class="aesthetic-input" required>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Planlanan Bitiş Tarihi *</label>
              <input type="date" name="plannedEndDate" value="<%= new Date(Date.now() + 7*24*60*60*1000).toISOString().split('T')[0] %>" class="aesthetic-input" required>
            </div>
            <div class="aesthetic-group" style="grid-column: span 2;">
              <label class="aesthetic-label">Üretim Mühendisi / Sorumlu Personel</label>
              <input type="text" name="productionManager" value="<%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %>" class="aesthetic-input">
            </div>
          </div>
          <div class="aesthetic-group" style="margin-top: 6px;">
            <label class="aesthetic-label">Üretim Notları & Özel İmalat Talimatları</label>
            <textarea name="notes" class="aesthetic-input" rows="3" placeholder="Teknik resim revizyon no, toleranslar, özel kalite kontrol şartları..."></textarea>
          </div>
          <div style="display: flex; gap: 14px; margin-top: 14px;">
            <button type="submit" class="btn-indigo-gradient">⚙️ İş Emrini Kaydet ve Başlat</button>
            <a href="/production/orders" class="btn btn-secondary" style="border-radius: 10px; padding: 12px 20px;">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
