<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Çok Seviyeli Rota & İş Emri Hazırlama — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .form-container-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      margin-bottom: 30px;
      box-shadow: var(--shadow-sm);
    }

    .form-section {
      background: rgba(30, 41, 59, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .section-title {
      font-size: 0.98rem;
      font-weight: 800;
      color: #818cf8;
      display: flex;
      align-items: center;
      gap: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: 0.84rem; font-weight: 700; color: #94a3b8; }
    .form-control {
      background: #090e1a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: all 0.2s;
      width: 100%;
      box-sizing: border-box;
    }
    .form-control:focus { border-color: #6366f1; box-shadow: 0 0 14px rgba(99, 102, 241, 0.3); }
    .form-control[readonly] { background: #111827; color: #cbd5e1; border-color: #1f2937; }

    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .form-row-4 { display: grid; grid-template-columns: 1.2fr 1.2fr 1fr 1fr; gap: 16px; }

    /* Hierarchy Stage Card */
    .stage-card {
      background: #090e1a;
      border: 1.5px solid #1e293b;
      border-radius: 18px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
    }
    .stage-card.sub-assembly {
      border-color: rgba(245, 158, 11, 0.4);
      background: linear-gradient(180deg, rgba(245, 158, 11, 0.05), #090e1a);
    }
    .stage-card.main-assembly {
      border-color: rgba(99, 102, 241, 0.4);
      background: linear-gradient(180deg, rgba(99, 102, 241, 0.05), #090e1a);
    }

    .stage-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 14px;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.12);
    }

    /* Operation Row Card */
    .op-step-row {
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid #1e293b;
      border-radius: 14px;
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: all 0.2s;
    }
    .op-step-row:hover {
      border-color: rgba(99, 102, 241, 0.4);
      background: rgba(15, 23, 42, 0.95);
    }

    .component-badge {
      background: #1e293b;
      border: 1px solid #334155;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 0.82rem;
      color: #cbd5e1;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-submit-workorders {
      background: linear-gradient(135deg, #10b981, #059669);
      color: #ffffff;
      font-weight: 800;
      font-size: 1rem;
      padding: 14px 32px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .btn-submit-workorders:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(16, 185, 129, 0.6); }

    .btn-back-link {
      background: rgba(148, 163, 184, 0.1);
      color: #94a3b8;
      border: 1px solid rgba(148, 163, 184, 0.25);
      padding: 10px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      text-decoration: none;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-back-link:hover { background: rgba(148, 163, 184, 0.2); color: #fff; }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub"><a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a></div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Talepler</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link active">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <!-- Page Header -->
      <div class="page-header" style="margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;">
        <div>
          <div style="font-size: 0.85rem; color: #818cf8; font-weight: 700; margin-bottom: 4px;">🏭 PROCESS MÜHENDİSLİĞİ VE ÇOK SEVİYELİ ROTA PLANLAMA</div>
          <h1>📋 Entegre İş Emri Hazırlama ve Operasyon Rota Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.92rem; margin-top: 4px;">Hedef ürünün ve reçetede bulunan alt yarı mamullerin operasyon adımları adım adım sıraya konularak imalat iş emri oluşturulur.</p>
        </div>
        <a href="/production/orders" class="btn-back-link">
          <span>← İş Emirleri Listesine Dön</span>
        </a>
      </div>

      <% 
        const safeStockItems = (typeof stockItems !== 'undefined' && stockItems) ? stockItems : [];
        const safePlan = (typeof multiLevelPlan !== 'undefined' && multiLevelPlan) ? multiLevelPlan : [];
        const safeRequisition = (typeof sourceRequisition !== 'undefined' && sourceRequisition) ? sourceRequisition : null;
        const defaultQty = (typeof effectiveQty !== 'undefined' && effectiveQty) ? effectiveQty : 100;
        const defaultOrderSource = (typeof effectiveOrderSource !== 'undefined' && effectiveOrderSource) ? effectiveOrderSource : `SOP-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`;
        const isLocked = typeof isLockedProduct !== 'undefined' ? isLockedProduct : false;
        const mainMinStock = typeof minStockLimit !== 'undefined' ? minStockLimit : 0;
        const reqMinQty = safeRequisition ? parseFloat(safeRequisition.plannedQuantity || 0) : 0;
        const mainQtyFloor = Math.max(mainMinStock, reqMinQty, 1);
      %>

      <!-- Prominent Selected / Locked Target Product Info Banner -->
      <% if (targetProduct) { %>
        <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.18), rgba(16, 185, 129, 0.12)); border: 1.5px solid rgba(99, 102, 241, 0.4); border-radius: 16px; padding: 20px 24px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 4px 24px rgba(0,0,0,0.3);">
          <div style="display: flex; align-items: center; gap: 18px;">
            <div style="width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);">
              🏭
            </div>
            <div>
              <div style="font-size: 0.78rem; font-weight: 800; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 2px;">
                <%= isLocked ? '🔒 TALEP EDİLEN İMALAT ÜRÜNÜ (SABİTLENDİ)' : '📦 SEÇİLEN HEDEF İMALAT ÜRÜNÜ' %>
              </div>
              <div style="font-size: 1.3rem; font-weight: 900; color: #ffffff; display: flex; align-items: center; gap: 10px;">
                <span style="color: #34d399; font-family: 'JetBrains Mono', monospace;">[<%= targetProduct.stockCode %>]</span>
                <span><%= targetProduct.name %></span>
              </div>
              <div style="font-size: 0.85rem; color: #cbd5e1; margin-top: 6px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                <span>Kategori: <strong style="color: #fbbf24;"><%= targetProduct.category === 'Mamul' ? 'Mamul' : 'Yarı Mamul' %></strong></span>
                <span style="color: #475569;">•</span>
                <span>Birim: <strong><%= targetProduct.unit || 'Adet' %></strong></span>
                <span style="color: #475569;">•</span>
                <span>Varsayılan Depo: <strong><%= targetProduct.warehouseLocation || 'Ana Depo' %></strong></span>
                <span style="color: #475569;">•</span>
                <span>Minimum Stok Alt Sınırı: <strong style="color: #34d399;"><%= mainMinStock %> <%= targetProduct.unit || 'Adet' %></strong></span>
              </div>
            </div>
          </div>
          <% if (isLocked) { %>
            <div style="background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); padding: 10px 18px; border-radius: 12px; font-weight: 800; font-size: 0.88rem; display: flex; align-items: center; gap: 8px; white-space: nowrap;">
              🔒 Ürün Sabitlendi (Değiştirilemez)
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- 1. Hedef Ürün & Sipariş Kaynağı Seçimi Formu -->
      <div class="form-container-card" style="margin-bottom: 20px;">
        <form action="/production/orders/add" method="GET" id="selectProductForm">
          <% if (safeRequisition) { %>
            <input type="hidden" name="requisitionId" value="<%= safeRequisition.id %>">
          <% } %>
          <% if (isLocked && targetProduct) { %>
            <input type="hidden" name="stockItemId" value="<%= targetProduct.id %>">
          <% } %>
          <div class="form-section" style="margin-bottom: 0;">
            <div class="section-title">
              <span>1. Üretim Talebi / Hedef Ürün ve Sipariş Kaynağı Tespiti</span>
            </div>
            <div class="form-row-3">
              <div class="form-group">
                <label class="form-label">
                  İmal Edilecek Hedef Ürün *
                  <% if (isLocked) { %>
                    <span style="color: #fbbf24; font-size: 0.8rem; margin-left: 6px;">🔒 (Kilitli)</span>
                  <% } %>
                </label>
                <select name="stockItemId" id="stockItemIdSelect" class="form-control" onchange="document.getElementById('selectProductForm').submit()" required <%= isLocked ? 'disabled' : '' %> style="cursor: pointer; <%= isLocked ? 'background: #0f172a; color: #60a5fa; border-color: #3b82f6; font-weight: 700;' : '' %>">
                  <option value="">-- Üretilecek Ürünü Seçiniz --</option>
                  <% safeStockItems.forEach(item => { %>
                    <% const isSelected = targetProduct && String(targetProduct.id) === String(item.id); %>
                    <option value="<%= item.id %>" <%= isSelected ? 'selected' : '' %>>
                      [<%= item.category === 'Mamul' ? 'Mamul' : 'Yarı Mamul' %>] <%= item.stockCode %> — <%= item.name %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label">Sipariş Kaynağı / Talep Kodu *</label>
                <input type="text" name="requisitionNo" class="form-control" value="<%= defaultOrderSource %>" placeholder="Örn: SOP-2026-054">
              </div>

              <div class="form-group">
                <label class="form-label">
                  Ana Üretim Miktarı *
                  <span style="color: #34d399; font-size: 0.78rem; margin-left: 6px;">🔒 Min Alt Sınır: <%= mainQtyFloor %> <%= targetProduct ? targetProduct.unit : 'Adet' %> (Düşürülemez)</span>
                </label>
                <input type="number" name="plannedQty" id="mainPlannedQtyInput" class="form-control" value="<%= Math.max(defaultQty, mainQtyFloor) %>" min="<%= mainQtyFloor %>" step="1" data-floor="<%= mainQtyFloor %>" oninput="clampFloorQty(this, <%= mainQtyFloor %>)" onchange="onMainQtyChangeSubmit(this, <%= mainQtyFloor %>)" onblur="clampFloorQty(this, <%= mainQtyFloor %>)" onkeydown="preventFloorDown(event, this, <%= mainQtyFloor %>)" required style="border-color: #10b981; font-weight: 700;">
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- 2. Multi-Stage Operational Work Order Hierarchy -->
      <% if (targetProduct && safePlan.length > 0) { %>
        <form action="/production/orders/add" method="POST" id="batchWorkOrderForm" onsubmit="prepareBatchOrderSubmit(event)">
          <input type="hidden" name="ordersJson" id="ordersJson">
          <% if (safeRequisition) { %>
            <input type="hidden" name="requisitionId" value="<%= safeRequisition.id %>">
          <% } %>

          <div class="form-container-card">
            <div class="form-section">
              <div class="section-title">
                <span>2. Ürün Reçetesi ve Alt Yarı Mamul İmalat Aşamaları (Sıralı Operasyonel Rota Girişleri)</span>
              </div>
              
              <div style="background: rgba(99, 102, 241, 0.1); border: 1.5px solid rgba(99, 102, 241, 0.25); padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; color: #a5b4fc; font-size: 0.88rem;">
                📌 <strong>İmalat Mantığı:</strong> Nihai montajın (A Mamulü) gerçekleşebilmesi için reçetede bulunan alt yarı mamulün (B Yarı Mamulü) gerekli hammaddeleri (D & E) işlenerek önce alt imalat adımları (Aşama 1) tamamlanacak, ardından nihai birleştirme (Aşama 2) yapılacaktır.
              </div>

              <!-- Stage Cards Container -->
              <div id="woCardsContainer" style="display: flex; flex-direction: column; gap: 24px;">
                <% safePlan.forEach((planItem, idx) => { %>
                  <% 
                    const isSubAssembly = planItem.level > 1;
                    const cardClass = isSubAssembly ? 'stage-card sub-assembly' : 'stage-card main-assembly';
                    const itemMinStock = parseFloat(planItem.product.minStock || 0);
                    const cardFloorLimit = Math.max(itemMinStock, planItem.plannedQuantity, 1);
                    const effectiveCardQty = Math.max(planItem.plannedQuantity, cardFloorLimit);
                    
                    const today = new Date();
                    const startDateObj = new Date(today);
                    startDateObj.setDate(today.getDate() + (isSubAssembly ? 0 : 2));
                    const endDateObj = new Date(startDateObj);
                    endDateObj.setDate(startDateObj.getDate() + (isSubAssembly ? 2 : 2));

                    const startDateStr = startDateObj.toISOString().split('T')[0];
                    const endDateStr = endDateObj.toISOString().split('T')[0];
                  %>

                  <div class="<%= cardClass %>" data-stockid="<%= planItem.product.id %>" data-code="<%= planItem.product.stockCode %>" data-name="<%= planItem.product.name %>" data-unit="<%= planItem.product.unit %>" data-level="<%= planItem.level %>">
                    <!-- Stage Card Header -->
                    <div class="stage-header">
                      <div style="display: flex; align-items: center; gap: 14px;">
                        <% if (isSubAssembly) { %>
                          <span style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); padding: 6px 14px; border-radius: 10px; font-weight: 800; font-size: 0.85rem;">
                            ⚙️ AŞAMA 1: ALT PARÇA İMALATI (Seviye <%= planItem.level %> Yarı Mamul)
                          </span>
                        <% } else { %>
                          <span style="background: rgba(99, 102, 241, 0.2); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.4); padding: 6px 14px; border-radius: 10px; font-weight: 800; font-size: 0.85rem;">
                            🏁 AŞAMA 2: NİHAİ ÜRÜN MONTAJI (Seviye 1 Main Assembly)
                          </span>
                        <% } %>
                        <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace; font-size: 1rem;">[<%= planItem.product.stockCode %>]</strong>
                        <strong style="color: #fff; font-size: 1.1rem;"><%= planItem.product.name %></strong>
                      </div>
                      <div style="font-size: 0.88rem; color: #cbd5e1;">
                        Gerekli İmalat Miktarı: <strong style="color: #34d399; font-size: 1rem;"><%= effectiveCardQty %> <%= planItem.product.unit %></strong>
                      </div>
                    </div>

                    <!-- Component Requirements Badge Card -->
                    <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255,255,255,0.08); padding: 14px 18px; border-radius: 12px;">
                      <div style="font-size: 0.82rem; font-weight: 800; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
                        📥 Bu Aşamada Kullanılacak Reçete Bileşenleri & Hammaddeler:
                      </div>
                      <% if (planItem.bomItems && planItem.bomItems.length > 0) { %>
                        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                          <% planItem.bomItems.forEach(b => { %>
                            <% const compQty = effectiveCardQty * (parseFloat(b.quantityRequired || 1) / parseFloat(b.baseQuantity || 1)); %>
                            <div class="component-badge">
                              <strong style="color: #60a5fa;">[<%= b.componentItem ? b.componentItem.stockCode : 'BOM' %>]</strong>
                              <span><%= b.componentItem ? b.componentItem.name : 'Bileşen' %></span>
                              <span style="color: #fbbf24; font-weight: 700;">(<%= compQty %> <%= b.unit %>)</span>
                              <span style="color: #94a3b8; font-size: 0.75rem;">— <%= b.componentItem ? (b.componentItem.category === 'Hammadde' ? '🛒 Satın Alma' : '🏭 Alt Üretim') : '' %></span>
                            </div>
                          <% }); %>
                        </div>
                      <% } else { %>
                        <div style="color: #94a3b8; font-size: 0.82rem;">Reçete bileşeni bulunmuyor.</div>
                      <% } %>
                    </div>

                    <!-- Operations & Routing Steps Table/Cards -->
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                      <div style="font-size: 0.88rem; font-weight: 800; color: #818cf8; display: flex; align-items: center; justify-content: space-between;">
                        <span>🛠️ Bu Aşamanın Operasyonel Rota Adımları ve İşlem Detayları:</span>
                        <span style="font-size: 0.78rem; color: #64748b; font-weight: 600;"><%= planItem.routingOperations.length %> Adım Tanımlı</span>
                      </div>

                      <% if (planItem.routingOperations && planItem.routingOperations.length > 0) { %>
                        <% planItem.routingOperations.forEach((op, opIdx) => { %>
                          <div class="op-step-row">
                            <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.06);">
                              <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="background: #312e81; color: #a5b4fc; padding: 3px 10px; border-radius: 6px; font-weight: 800; font-size: 0.8rem;">
                                  ADIM <%= op.operationSeq %>
                                </span>
                                <strong style="color: #f8fafc; font-size: 0.95rem;"><%= op.operationName %></strong>
                                <span style="color: #64748b; font-size: 0.8rem;">(<%= op.operationCode || 'OPS' %>)</span>
                              </div>
                              <div style="font-size: 0.82rem; color: #34d399; font-weight: 700;">
                                ⏱️ Standart İşlem Süresi: <%= op.runTimeMinutesPerUnit || 5 %> Dk/Adet
                              </div>
                            </div>

                            <div class="form-row-3">
                              <div class="form-group">
                                <label class="form-label">Atanan İş Merkezi / Tezgah *</label>
                                <select class="form-control op-workcenter" required>
                                  <% WORK_CENTERS.forEach(wc => { %>
                                    <% const isSelectedWc = op.workCenter === wc; %>
                                    <option value="<%= wc %>" <%= isSelectedWc ? 'selected' : '' %>><%= wc %></option>
                                  <% }); %>
                                </select>
                              </div>
                              <div class="form-group">
                                <label class="form-label">Planlanan Başlangıç Tarihi *</label>
                                <input type="date" class="form-control op-start-date" value="<%= startDateStr %>" required>
                              </div>
                              <div class="form-group">
                                <label class="form-label">Planlanan Bitiş Tarihi *</label>
                                <input type="date" class="form-control op-end-date" value="<%= endDateStr %>" required>
                              </div>
                            </div>

                            <div class="form-group">
                              <label class="form-label">Operasyon Talimatı / İşlem Notu</label>
                              <input type="text" class="form-control op-notes" value="<%= op.instructions || (isSubAssembly ? 'Alt montaj operasyonu: ' + op.operationName : 'Nihai birleştirme operasyonu: ' + op.operationName) %>" placeholder="Operatör için işlem detayları...">
                            </div>
                          </div>
                        <% }); %>
                      <% } else { %>
                        <div class="op-step-row" style="border-color: rgba(245, 158, 11, 0.3);">
                          <div style="color: #fbbf24; font-size: 0.85rem; font-weight: 700;">
                            ⚠️ Bu ürünün özel rotası henüz tanımlanmamış. Varsayılan Genel İmalat İş Merkezi atanacaktır.
                          </div>
                          <div class="form-row-3">
                            <div class="form-group">
                              <label class="form-label">Varsayılan İş Merkezi *</label>
                              <select class="form-control op-workcenter" required>
                                <% WORK_CENTERS.forEach(wc => { %>
                                  <option value="<%= wc %>"><%= wc %></option>
                                <% }); %>
                              </select>
                            </div>
                            <div class="form-group">
                              <label class="form-label">Başlangıç Tarihi *</label>
                              <input type="date" class="form-control op-start-date" value="<%= startDateStr %>" required>
                            </div>
                            <div class="form-group">
                              <label class="form-label">Bitiş Tarihi *</label>
                              <input type="date" class="form-control op-end-date" value="<%= endDateStr %>" required>
                            </div>
                          </div>
                        </div>
                      <% } %>
                    </div>

                    <!-- General Inputs Grid for Stage -->
                    <div class="form-row-4">
                      <div class="form-group">
                        <label class="form-label">Ürün Adı (Otomatik)</label>
                        <input type="text" class="form-control" value="[<%= planItem.product.stockCode %>] <%= planItem.product.name %>" readonly style="color: #38bdf8; font-weight: 700;">
                      </div>
                      <div class="form-group">
                        <label class="form-label">Sipariş Kaynağı (Otomatik)</label>
                        <input type="text" class="form-control wo-source" value="<%= defaultOrderSource %>" readonly>
                      </div>
                      <div class="form-group">
                        <label class="form-label">
                          Üretim Miktarı *
                          <span style="color: #34d399; font-size: 0.75rem;">(Min Alt Sınır: <%= cardFloorLimit %>)</span>
                        </label>
                        <input type="number" class="form-control wo-qty" value="<%= effectiveCardQty %>" min="<%= cardFloorLimit %>" data-floor="<%= cardFloorLimit %>" data-prodname="<%= planItem.product.name %>" oninput="clampCardFloorQty(this)" onchange="clampCardFloorQty(this)" onblur="clampCardFloorQty(this)" onkeydown="preventFloorDown(event, this, parseFloat(this.dataset.floor))" step="1" required style="border-color: #10b981; font-weight: 700;">
                      </div>
                      <div class="form-group">
                        <label class="form-label">Öncelik Seviyesi *</label>
                        <select class="form-control wo-priority" required>
                          <option value="Normal" <%= isSubAssembly ? '' : 'selected' %>>Normal</option>
                          <option value="High" <%= isSubAssembly ? 'selected' : '' %>>⚠️ Yüksek</option>
                          <option value="Urgent">🚨 Acil</option>
                          <option value="Low">Düşük</option>
                        </select>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>

            <!-- Submit Action -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 10px;">
              <a href="/production/orders" class="btn-back-link">İptal ve Geri Dön</a>
              <button type="submit" class="btn-submit-workorders">
                🚀 Tüm Rota Aşamaları İçin İş Emirlerini Yayınla (<%= safePlan.length %> Aşama)
              </button>
            </div>
          </div>
        </form>
      <% } else if (targetProduct) { %>
        <div class="form-container-card">
          <p style="color: var(--text-muted); text-align: center; padding: 2rem;">Seçilen ürün için imalat planı oluşturulamadı.</p>
        </div>
      <% } %>
    </main>
  </div>

  <script>
    function clampFloorQty(inputEl, floorVal) {
      let val = parseFloat(inputEl.value);
      if (isNaN(val) || val < floorVal) {
        inputEl.value = floorVal;
      }
    }

    function preventFloorDown(e, inputEl, floorVal) {
      if (e.key === 'ArrowDown') {
        let val = parseFloat(inputEl.value) || 0;
        if (val <= floorVal) {
          e.preventDefault();
          inputEl.value = floorVal;
        }
      }
    }

    function clampCardFloorQty(inputEl) {
      const floorVal = parseFloat(inputEl.dataset.floor || 1);
      const prodName = inputEl.dataset.prodname || 'Ürün';
      let val = parseFloat(inputEl.value);

      if (isNaN(val) || val < floorVal) {
        alert(`⚠️ [${prodName}] için imalat miktarı belirlenen minimum stok / talep alt sınırı olan ${floorVal} altına inemez! Miktar ${floorVal} seviyesine sabitlendi.`);
        inputEl.value = floorVal;
      }
    }

    function onMainQtyChangeSubmit(inputEl, floorVal) {
      clampFloorQty(inputEl, floorVal);
      document.getElementById('selectProductForm').submit();
    }

    function prepareBatchOrderSubmit(event) {
      const cards = document.querySelectorAll('#woCardsContainer .stage-card');
      const ordersArr = [];

      cards.forEach(card => {
        const qtyInput = card.querySelector('.wo-qty');
        const floorVal = parseFloat(qtyInput.dataset.floor || 1);
        let qtyVal = parseFloat(qtyInput.value);

        if (isNaN(qtyVal) || qtyVal < floorVal) {
          qtyVal = floorVal;
          qtyInput.value = floorVal;
        }

        // Collect primary work center from the first operation step input
        const firstWcSelect = card.querySelector('.op-workcenter');
        const primaryWorkCenter = firstWcSelect ? firstWcSelect.value : 'İstasyon-1';

        const firstStartDateInput = card.querySelector('.op-start-date');
        const primaryStartDate = firstStartDateInput ? firstStartDateInput.value : new Date().toISOString().split('T')[0];

        const firstEndDateInput = card.querySelector('.op-end-date');
        const primaryEndDate = firstEndDateInput ? firstEndDateInput.value : new Date().toISOString().split('T')[0];

        const firstNoteInput = card.querySelector('.op-notes');
        const stageNotes = firstNoteInput ? firstNoteInput.value : '';

        ordersArr.push({
          stockItemId: parseInt(card.dataset.stockid, 10),
          productCode: card.dataset.code,
          productName: card.dataset.name,
          unit: card.dataset.unit || 'Adet',
          level: parseInt(card.dataset.level, 10) || 1,
          orderSource: card.querySelector('.wo-source').value,
          plannedQuantity: qtyVal,
          priority: card.querySelector('.wo-priority').value || 'Normal',
          plannedStartDate: primaryStartDate,
          plannedEndDate: primaryEndDate,
          workCenter: primaryWorkCenter,
          notes: stageNotes || `Sipariş Kaynağı: ${card.querySelector('.wo-source').value}`,
          productionTitle: `[Aşama ${card.dataset.level}] İmalat Rota İş Emri — ${card.dataset.name}`
        });
      });

      if (ordersArr.length === 0) {
        alert('Oluşturulacak iş emri bulunamadı!');
        event.preventDefault();
        return false;
      }

      document.getElementById('ordersJson').value = JSON.stringify(ordersArr);
    }

    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
