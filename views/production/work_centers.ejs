<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>İş Merkezleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .btn-create-workcenter {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #ffffff !important;
      font-weight: 800;
      font-size: 0.92rem;
      padding: 11px 22px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 4px 18px rgba(99, 102, 241, 0.35);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-create-workcenter:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(99, 102, 241, 0.55);
      background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
    }

    /* KPI Grid */
    .wc-kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
      margin-bottom: 24px;
    }
    .wc-kpi-card {
      background: rgba(30, 41, 59, 0.5);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      transition: all 0.2s ease;
    }
    .wc-kpi-card:hover {
      border-color: rgba(99, 102, 241, 0.3);
      transform: translateY(-2px);
    }
    .wc-kpi-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      flex-shrink: 0;
    }

    /* Filter Bar */
    .filter-bar-container {
      background: rgba(30, 41, 59, 0.45);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 12px 16px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .custom-filter-tabs {
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(15, 23, 42, 0.7);
      padding: 4px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .custom-filter-tab {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-weight: 700;
      font-size: 0.84rem;
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .custom-filter-tab:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.04);
    }
    .custom-filter-tab.active {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.9), rgba(79, 70, 229, 0.9));
      color: #ffffff;
      box-shadow: 0 2px 10px rgba(99, 102, 241, 0.3);
    }
    .filter-pill-badge {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 1px 7px;
      border-radius: 20px;
    }
    .custom-filter-tab.active .filter-pill-badge {
      background: rgba(255, 255, 255, 0.25);
    }

    .custom-search-wrap {
      position: relative;
      flex: 1;
      min-width: 240px;
      max-width: 360px;
    }
    .custom-search-input {
      width: 100%;
      background: rgba(15, 23, 42, 0.85);
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 9px 14px 9px 38px;
      color: #ffffff;
      font-size: 0.86rem;
      outline: none;
      box-sizing: border-box;
      transition: all 0.2s ease;
    }
    .custom-search-input:focus {
      border-color: #6366f1;
      box-shadow: 0 0 14px rgba(99, 102, 241, 0.3);
      background: rgba(15, 23, 42, 0.95);
    }
    .custom-search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 0.9rem;
      pointer-events: none;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/mrp" class="mss-sub-link">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link active">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link active">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <!-- Header & New Button -->
      <div class="page-header" style="margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
        <div>
          <h1 style="font-size: 1.6rem; font-weight: 900; color: #fff; margin: 0; letter-spacing: -0.5px;">⚙️ İş Merkezleri Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">İmalat operasyonlarının yürütüldüğü makineler, tezgahlar, montaj istasyonları ve kapasite/vardiya tanımları.</p>
        </div>
        <a href="/production/work-centers/add" class="btn-create-workcenter">
          <span>➕ Yeni İş Merkezi Ekle</span>
        </a>
      </div>

      <!-- KPI Summary Cards -->
      <div class="wc-kpi-grid">
        <div class="wc-kpi-card">
          <div class="wc-kpi-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">⚙️</div>
          <div>
            <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Toplam İş Merkezi</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #fff; margin-top: 2px;"><%= stats.total %></div>
          </div>
        </div>
        <div class="wc-kpi-card">
          <div class="wc-kpi-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">🟢</div>
          <div>
            <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Aktif Merkezler</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #34d399; margin-top: 2px;"><%= stats.active %></div>
          </div>
        </div>
        <div class="wc-kpi-card">
          <div class="wc-kpi-icon" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8;">⚪</div>
          <div>
            <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Pasif Merkezler</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #94a3b8; margin-top: 2px;"><%= stats.inactive %></div>
          </div>
        </div>
        <div class="wc-kpi-card">
          <div class="wc-kpi-icon" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">⚡</div>
          <div>
            <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Nominal Günlük Kapasite</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #fbbf24; margin-top: 2px;"><%= Number(stats.totalCapacityHours).toFixed(1) %> Saat / Gün</div>
          </div>
        </div>
      </div>

      <!-- Modern Filter Bar (Status Tabs, Workshop Dropdown & Search) -->
      <div class="filter-bar-container">
        <div class="custom-filter-tabs">
          <button type="button" class="custom-filter-tab active" onclick="filterWorkCenterCategory('all', this)">
            <span>Tüm Merkezler</span>
            <span class="filter-pill-badge"><%= workCenters.length %></span>
          </button>
          <button type="button" class="custom-filter-tab" onclick="filterWorkCenterCategory('Active', this)">
            <span>🟢 Aktif Merkezler</span>
            <span class="filter-pill-badge"><%= stats.active %></span>
          </button>
          <button type="button" class="custom-filter-tab" onclick="filterWorkCenterCategory('Inactive', this)">
            <span>⚪ Pasif Merkezler</span>
            <span class="filter-pill-badge"><%= stats.inactive %></span>
          </button>
        </div>

        <div style="display: flex; gap: 12px; align-items: center; flex: 1; justify-content: flex-end; flex-wrap: wrap;">
          <div style="min-width: 180px;">
            <select id="workshopFilterSelect" onchange="filterWorkCenterTable()" style="width: 100%; padding: 9px 12px; background: rgba(15, 23, 42, 0.85); border: 1.5px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: #ffffff; font-size: 0.85rem; outline: none; font-weight: 600;">
              <option value="">— Tüm Atölyeler —</option>
              <% workshops.forEach(ws => { %>
                <option value="<%= ws.id %>">[<%= ws.atolyeKodu %>] <%= ws.atolyeAdi %></option>
              <% }); %>
            </select>
          </div>

          <div class="custom-search-wrap">
            <span class="custom-search-icon">🔍</span>
            <input type="text" id="workCenterSearchInput" class="custom-search-input" placeholder="İş Merkezi Kodu, Adı veya Atölye Ara..." oninput="filterWorkCenterTable()">
          </div>
        </div>
      </div>

      <!-- Work Centers Data Table -->
      <div class="table-wrapper" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
        <table class="data-table" id="workCentersTable" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: rgba(30, 41, 59, 0.85); border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px;">
              <th style="padding: 14px 16px; width: 140px;">İş Merkezi Kodu</th>
              <th style="padding: 14px 16px; min-width: 200px;">İş Merkezi Adı</th>
              <th style="padding: 14px 16px; min-width: 220px;">Bağlı Olduğu Atölye</th>
              <th style="padding: 14px 16px; width: 150px; text-align: center;">Günlük Çalışma Saati</th>
              <th style="padding: 14px 16px; width: 130px; text-align: center;">Varsayılan Personel</th>
              <th style="padding: 14px 16px; width: 120px; text-align: center;">Durum</th>
              <th style="padding: 14px 16px; width: 130px;">Kayıt Tarihi</th>
              <th style="padding: 14px 16px; text-align: right; width: 140px;">İşlemler</th>
            </tr>
          </thead>
          <tbody>
            <% if (!workCenters || workCenters.length === 0) { %>
              <tr id="emptyWorkCentersRow">
                <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 3.5rem 1rem;">
                  <div style="font-size: 2.2rem; margin-bottom: 8px;">⚙️</div>
                  <strong style="color: #fff; font-size: 1rem;">Henüz tanımlanmış bir iş merkezi bulunmamaktadır.</strong><br>
                  <span style="font-size: 0.84rem; margin-top: 6px; display: inline-block; color: #818cf8;">
                    Yukarıdaki <strong>'➕ Yeni İş Merkezi Ekle'</strong> butonuna tıklayarak ilk istasyonu kaydedebilirsiniz.
                  </span>
                </td>
              </tr>
            <% } else { %>
              <% workCenters.forEach(wc => { %>
                <tr data-status="<%= wc.durum %>" data-atolye-id="<%= wc.atolyeId %>" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05); transition: background 0.15s ease;">
                  <td style="padding: 12px 16px;">
                    <strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; background: rgba(99, 102, 241, 0.12); padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(99, 102, 241, 0.25);">
                      <%= wc.isMerkeziKodu %>
                    </strong>
                  </td>
                  <td style="padding: 12px 16px;">
                    <strong style="color: #ffffff; font-size: 0.94rem;"><%= wc.isMerkeziAdi %></strong>
                  </td>
                  <td style="padding: 12px 16px;">
                    <% if (wc.atolye) { %>
                      <div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                          <span style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-weight: 700; font-size: 0.78rem; padding: 2px 8px; border-radius: 6px; border: 1px solid rgba(99, 102, 241, 0.3);">
                            🏢 <%= wc.atolye.atolyeAdi %>
                          </span>
                        </div>
                        <% if (wc.atolye.sorumlu) { %>
                          <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">
                            Sorumlu: <span style="color: #cbd5e1;"><%= wc.atolye.sorumlu.ad ? `${wc.atolye.sorumlu.ad} ${wc.atolye.sorumlu.soyad || ''}` : wc.atolye.sorumlu.kullaniciAdi %></span>
                          </div>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span style="color: var(--text-muted);">— Atölye Bağlantısı Yok —</span>
                    <% } %>
                  </td>
                  <td style="padding: 12px 16px; text-align: center;">
                    <span style="font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #fbbf24; background: rgba(245, 158, 11, 0.12); padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(245, 158, 11, 0.25);">
                      ⚡ <%= Number(wc.gunlukCalismaSaati).toFixed(1) %> Saat / Gün
                    </span>
                  </td>
                  <td style="padding: 12px 16px; text-align: center; color: var(--text-secondary); font-size: 0.85rem; font-weight: 600;">
                    <% if (wc.varsayilanIsciSayisi) { %>
                      <span>👤 <%= wc.varsayilanIsciSayisi %> Personel</span>
                    <% } else { %>
                      <span style="color: var(--text-muted);">—</span>
                    <% } %>
                  </td>
                  <td style="padding: 12px 16px; text-align: center;">
                    <% if (wc.durum === 'Active') { %>
                      <span class="badge-status badge-has-bom" style="font-weight: 700;">🟢 Aktif</span>
                    <% } else { %>
                      <span class="badge-status badge-no-bom" style="font-weight: 700;">⚪ Pasif</span>
                    <% } %>
                  </td>
                  <td style="padding: 12px 16px; font-size: 0.82rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">
                    <%= new Date(wc.createdAt).toLocaleDateString('tr-TR') %>
                  </td>
                  <td style="padding: 12px 16px; text-align: right; white-space: nowrap;">
                    <a href="/production/work-centers/edit/<%= wc.id %>" class="btn btn-secondary btn-sm" style="font-weight: 700; font-size: 0.8rem; padding: 6px 12px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                      ✏️ Düzenle
                    </a>
                    <form action="/production/work-centers/delete/<%= wc.id %>" method="POST" style="display: inline-block; margin-left: 4px;" onsubmit="return confirm('Bu iş merkezini silmek istediğinize emin misiniz?');">
                      <button type="submit" class="btn btn-danger btn-sm" style="font-weight: 700; font-size: 0.8rem; padding: 6px 10px; border-radius: 8px; cursor: pointer;" title="İş Merkezini Sil">🗑️</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

    </main>
  </div>

  <script>
    let activeFilterStatus = 'all';

    function filterWorkCenterTable() {
      const query = (document.getElementById('workCenterSearchInput').value || '').toLowerCase().trim();
      const atolyeFilter = document.getElementById('workshopFilterSelect').value;
      const rows = document.querySelectorAll('#workCentersTable tbody tr:not(#emptyWorkCentersRow)');
      
      rows.forEach(tr => {
        const text = tr.textContent.toLowerCase();
        const matchesQuery = text.includes(query);
        const matchesStatus = (activeFilterStatus === 'all') || (tr.dataset.status === activeFilterStatus);
        const matchesAtolye = !atolyeFilter || (tr.dataset.atolyeId === atolyeFilter);

        tr.style.display = (matchesQuery && matchesStatus && matchesAtolye) ? '' : 'none';
      });
    }

    function filterWorkCenterCategory(status, btn) {
      document.querySelectorAll('.custom-filter-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilterStatus = status;
      filterWorkCenterTable();
    }

    function updateClock() { 
      const now = new Date(); 
      const el = document.getElementById('liveTime'); 
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); 
    }
    updateClock(); 
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
