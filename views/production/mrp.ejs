<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Malzeme İhtiyaç Planlaması (MRP) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .mrp-tabs-nav {
      display: flex; gap: 8px; border-bottom: 1.5px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 20px; padding-bottom: 2px; overflow-x: auto;
    }
    .mrp-tab-btn {
      background: transparent; border: none; outline: none; padding: 12px 20px;
      color: #94a3b8; font-size: 0.9rem; font-weight: 700; cursor: pointer;
      border-radius: 12px 12px 0 0; transition: all 0.2s ease; display: inline-flex;
      align-items: center; gap: 8px; white-space: nowrap; border-bottom: 2.5px solid transparent;
    }
    .mrp-tab-btn:hover { color: #f8fafc; background: rgba(255, 255, 255, 0.03); }
    .mrp-tab-btn.active {
      color: #6366f1; border-bottom-color: #6366f1; background: rgba(99, 102, 241, 0.08);
    }
    .mrp-tab-content { display: none; }
    .mrp-tab-content.active { display: block; animation: fadeIn 0.25s ease; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    .badge-count {
      padding: 2px 8px; border-radius: 20px; font-size: 0.75rem; font-weight: 800;
      font-family: 'JetBrains Mono', monospace;
    }
    .badge-count--green { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .badge-count--amber { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .badge-count--rose { background: rgba(244, 63, 94, 0.2); color: #fb7185; }
    .badge-count--indigo { background: rgba(99, 102, 241, 0.2); color: #818cf8; }

    .tree-card {
      background: rgba(15, 23, 42, 0.65); border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px; padding: 18px 22px; margin-bottom: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }
    .tree-header {
      display: flex; justify-content: space-between; align-items: center;
      cursor: pointer; user-select: none;
    }
    .tree-node-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px; margin: 6px 0; border-radius: 10px;
      background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255, 255, 255, 0.04);
      font-size: 0.875rem;
    }
    .tree-level-1 { margin-left: 20px; border-left: 3px solid #6366f1; }
    .tree-level-2 { margin-left: 45px; border-left: 3px solid #f59e0b; }
    .tree-level-3 { margin-left: 70px; border-left: 3px solid #10b981; }

    .btn-mrp-trigger {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #ffffff !important; font-size: 0.95rem; font-weight: 800; padding: 12px 24px;
      border-radius: 14px; border: none; cursor: pointer; text-decoration: none;
      box-shadow: 0 8px 25px rgba(99, 102, 241, 0.45);
      display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;
    }
    .btn-mrp-trigger:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(99, 102, 241, 0.6); }

    .btn-quick-action {
      background: rgba(255, 255, 255, 0.08); color: #f8fafc; font-size: 0.78rem; font-weight: 700;
      padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.12);
      cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;
    }
    .btn-quick-action:hover { background: rgba(255, 255, 255, 0.18); transform: translateY(-1px); }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link active">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <!-- PAGE HEADER & MRP BUTTON -->
      <div class="page-header" style="margin-bottom: 24px;">
        <div>
          <h1 style="display: flex; align-items: center; gap: 12px;">
            <span>⚡ Malzeme İhtiyaç Planlaması (MRP Engine)</span>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            Satış siparişleri ve üretim taleplerine göre çok seviyeli reçete (BOM) patlatması, fire oranları ve depo stoğuna göre dinamik iş emri ve tedarik öneri motoru.
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px;">
          <a href="/production/mrp" class="btn-mrp-trigger" id="btnRunMRP">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span>⚡ MRP Oluştur / Analiz Et</span>
          </a>
        </div>
      </div>

      <% if (successMsg) { %>
        <div style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1.5px solid rgba(16, 185, 129, 0.35); padding: 14px 20px; border-radius: 14px; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>✅</span> <%= successMsg %>
        </div>
      <% } %>

      <% if (errorMsg) { %>
        <div style="background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1.5px solid rgba(244, 63, 94, 0.35); padding: 14px 20px; border-radius: 14px; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= errorMsg %>
        </div>
      <% } %>

      <!-- KPI METRIC STRIP -->
      <div class="kpi-strip" style="margin-bottom: 24px;">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">📋</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Analiz Edilen Talep</span>
            <span class="kpi-chip-value" style="font-family: 'JetBrains Mono', monospace;"><%= kpiSummary.totalDemandsCount %> Sipariş</span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">🟢</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Hazır İş Emirleri</span>
            <span class="kpi-chip-value" style="color: #34d399; font-family: 'JetBrains Mono', monospace;"><%= kpiSummary.readyWorkOrdersCount %> Öneri</span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">🟡</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Durdurulan Kanatlar</span>
            <span class="kpi-chip-value" style="color: #fbbf24; font-family: 'JetBrains Mono', monospace;"><%= kpiSummary.gatedProductionReqsCount %> İmalat</span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--rose">🔴</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Satın Alma İhtiyaçları</span>
            <span class="kpi-chip-value" style="color: #fb7185; font-family: 'JetBrains Mono', monospace;"><%= kpiSummary.purchaseReqsCount %> Kalem</span>
          </div>
        </div>
      </div>

      <!-- MRP TABS NAVIGATION -->
      <nav class="mrp-tabs-nav">
        <button type="button" class="mrp-tab-btn active" onclick="switchMRPTab('tab-work-orders', event)">
          <span>📋 1. İş Emri Önerileri</span>
          <span class="badge-count badge-count--green"><%= workOrderSuggestions.length %></span>
        </button>
        <button type="button" class="mrp-tab-btn" onclick="switchMRPTab('tab-gated-production', event)">
          <span>🟡 2. Durdurulan İmalat Kanatları</span>
          <span class="badge-count badge-count--amber"><%= productionRequisitionSuggestions.length %></span>
        </button>
        <button type="button" class="mrp-tab-btn" onclick="switchMRPTab('tab-purchase-reqs', event)">
          <span>🛒 3. Satın Alma Talebi Önerileri</span>
          <span class="badge-count badge-count--rose"><%= purchaseRequisitionSuggestions.length %></span>
        </button>
        <button type="button" class="mrp-tab-btn" onclick="switchMRPTab('tab-tree-view', event)">
          <span>🌳 4. Hiyerarşik Reçete & İhtiyaç Ağacı</span>
          <span class="badge-count badge-count--indigo"><%= orderAnalysisTrees.length %></span>
        </button>
        <button type="button" class="mrp-tab-btn" onclick="switchMRPTab('tab-raw-components', event)">
          <span>📦 5. Tüm Bileşenler & Stok Dengesi</span>
          <span class="badge-count badge-count--indigo"><%= mrpResults.length %></span>
        </button>
      </nav>

      <!-- TAB 1: İŞ EMRİ ÖNERİLERİ (Bileşenleri %100 Tam - Üretime Hazır) -->
      <div id="tab-work-orders" class="mrp-tab-content active">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
          <div>
            <h3 style="font-size: 1rem; font-weight: 800; color: #34d399; margin: 0;">🟢 Üretime Hazır İş Emri Önerileri</h3>
            <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">Reçetesindeki tüm doğrudan bileşenleri depoda mevcut olan ve derhal imalata başlanabilecek mamul/yarı mamuller.</p>
          </div>
          <% if (workOrderSuggestions.length > 0) { %>
            <form action="/production/mrp/execute" method="POST">
              <input type="hidden" name="actionType" value="create_work_orders">
              <button type="submit" class="btn-quick-action" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(16, 185, 129, 0.4);">
                ⚡ Tüm Hazır İş Emirlerini Başlat (<%= workOrderSuggestions.length %> Adet)
              </button>
            </form>
          <% } %>
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Kaynak Talep / Sipariş</th>
                <th>Ürün Kodu & Adı</th>
                <th>Kategori</th>
                <th>Önerilen Miktar</th>
                <th>Hedef İş İstasyonu</th>
                <th>Tahmini Süre</th>
                <th>Bileşen Durumu</th>
                <th style="text-align: right;">Aksiyon</th>
              </tr>
            </thead>
            <tbody>
              <% if (workOrderSuggestions.length === 0) { %>
                <tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Şu anda üretime hazır bekleyen iş emri önerisi bulunmamaktadır (veya tüm bileşenler eksiksiz üretilmiştir).</td></tr>
              <% } else { %>
                <% workOrderSuggestions.forEach((wo, idx) => { %>
                  <tr>
                    <td>
                      <strong style="color: #818cf8;"><%= wo.demandSource %></strong>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= wo.customerName %></div>
                    </td>
                    <td>
                      <strong style="color: var(--text-primary);"><%= wo.name %></strong>
                      <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: #94a3b8;">[<%= wo.stockCode %>]</div>
                    </td>
                    <td><span class="status-pill status-approved"><%= wo.category %></span></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace; font-size: 0.95rem; color: #f8fafc;"><%= wo.suggestedQty %> <%= wo.unit %></strong></td>
                    <td style="font-size: 0.825rem; color: #cbd5e1;"><%= wo.targetWorkCenter %></td>
                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: #fbbf24;"><%= wo.estimatedHours %> Saat</td>
                    <td><span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 4px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78rem; border: 1px solid rgba(16, 185, 129, 0.3);">✓ %100 Hazır</span></td>
                    <td style="text-align: right;">
                      <form action="/production/mrp/execute" method="POST" style="display: inline-block;">
                        <input type="hidden" name="actionType" value="create_work_orders">
                        <input type="hidden" name="stockId" value="<%= wo.stockId %>">
                        <button type="submit" class="btn-quick-action" style="background: rgba(99, 102, 241, 0.2); color: #818cf8; border-color: rgba(99, 102, 241, 0.4);">
                          ➕ İş Emri Aç
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 2: DURDURULAN İMALAT KANATLARI (Alt Bileşen Eksik / Üretim Beklemede) -->
      <div id="tab-gated-production" class="mrp-tab-content">
        <div style="margin-bottom: 14px;">
          <h3 style="font-size: 1rem; font-weight: 800; color: #fbbf24; margin: 0;">🟡 Durdurulan İmalat Kanatları (Alt Bileşen Eksikliği)</h3>
          <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">Tedarik yöntemi Üretim olan ancak kendi alt reçetesindeki hammadde/yarı mamuller eksik olduğu için iş emri verilmeyen durdurulmuş üretim dalları.</p>
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Kaynak Talep</th>
                <th>Yarı Mamul / Ürün</th>
                <th>Kategori</th>
                <th>Talep Miktarı</th>
                <th>İmalat Engeli (Eksik Bileşenler)</th>
                <th>Hedef İstasyon</th>
                <th>Durum</th>
              </tr>
            </thead>
            <tbody>
              <% if (productionRequisitionSuggestions.length === 0) { %>
                <tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Alt bileşen eksiği nedeniyle durdurulan imalat kanadı bulunmamaktadır. 🎉</td></tr>
              <% } else { %>
                <% productionRequisitionSuggestions.forEach((pr, idx) => { %>
                  <tr>
                    <td><strong style="color: #818cf8;"><%= pr.demandSource %></strong></td>
                    <td>
                      <strong style="color: var(--text-primary);"><%= pr.name %></strong>
                      <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: #94a3b8;">[<%= pr.stockCode %>]</div>
                    </td>
                    <td><span class="status-pill status-pending"><%= pr.category %></span></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace;"><%= pr.suggestedQty %> <%= pr.unit %></strong></td>
                    <td>
                      <div style="font-size: 0.8rem; color: #fb7185; background: rgba(244, 63, 94, 0.1); padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(244, 63, 94, 0.25);">
                        ⚠️ <%= pr.missingComponentsSummary %>
                      </div>
                    </td>
                    <td style="font-size: 0.825rem; color: #cbd5e1;"><%= pr.targetWorkCenter %></td>
                    <td>
                      <span style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; padding: 4px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78rem; border: 1px solid rgba(245, 158, 11, 0.3);">
                        🔒 İmalat Beklemede
                      </span>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 3: SATIN ALMA TALEBİ ÖNERİLERİ -->
      <div id="tab-purchase-reqs" class="mrp-tab-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
          <div>
            <h3 style="font-size: 1rem; font-weight: 800; color: #fb7185; margin: 0;">🛒 Satın Alma Talebi Önerileri (Eksik Hammaddeler)</h3>
            <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">Üretim planının aksamaması için tedarik yöntemi Satın Alma olan ve depo stoğu yetersiz kalan malzemeler.</p>
          </div>
          <% if (purchaseRequisitionSuggestions.length > 0) { %>
            <form action="/production/mrp/execute" method="POST">
              <input type="hidden" name="actionType" value="create_purchase_reqs">
              <button type="submit" class="btn-quick-action" style="background: rgba(244, 63, 94, 0.2); color: #fb7185; border-color: rgba(244, 63, 94, 0.4);">
                🛒 Otomatik Satın Alma Talepleri Aç (<%= purchaseRequisitionSuggestions.length %> Kalem)
              </button>
            </form>
          <% } %>
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Malzeme Kodu</th>
                <th>Malzeme Adı</th>
                <th>Kategori</th>
                <th>Depo Stoğu</th>
                <th>Açık Talepler</th>
                <th>Brüt İhtiyaç (Fireli)</th>
                <th>Net Eksik Miktar</th>
                <th>Öncelik</th>
                <th>Kaynak Reçete Yolları</th>
                <th style="text-align: right;">Aksiyon</th>
              </tr>
            </thead>
            <tbody>
              <% if (purchaseRequisitionSuggestions.length === 0) { %>
                <tr><td colspan="10" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Depoda eksik hammadde bulunmamaktadır. Tüm satın alma stokları yeterli! 🎉</td></tr>
              <% } else { %>
                <% purchaseRequisitionSuggestions.forEach((pr, idx) => { %>
                  <tr>
                    <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;">[<%= pr.stockCode %>]</strong></td>
                    <td><strong style="color: var(--text-primary);"><%= pr.name %></strong></td>
                    <td><span class="status-pill status-approved"><%= pr.category %></span></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace;"><%= pr.currentStock %> <%= pr.unit %></strong></td>
                    <td style="font-family: 'JetBrains Mono', monospace;"><%= pr.openReqQty %> <%= pr.unit %></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace; color: #fbbf24;"><%= pr.grossRequirement %> <%= pr.unit %></strong></td>
                    <td>
                      <strong style="font-family: 'JetBrains Mono', monospace; color: #fb7185; font-size: 1rem;">
                        🚨 +<%= pr.netShortage %> <%= pr.unit %>
                      </strong>
                    </td>
                    <td>
                      <% if (pr.urgency === 'Critical') { %>
                        <span class="status-pill status-rejected">🚨 KRİTİK (Stok 0)</span>
                      <% } else if (pr.urgency === 'High') { %>
                        <span class="status-pill status-pending">⚡ Yüksek</span>
                      <% } else { %>
                        <span class="status-pill status-approved">Normal</span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.75rem; color: var(--text-muted); max-width: 260px;"><%= pr.references %></td>
                    <td style="text-align: right;">
                      <form action="/production/mrp/execute" method="POST" style="display: inline-block;">
                        <input type="hidden" name="actionType" value="create_purchase_reqs">
                        <input type="hidden" name="stockId" value="<%= pr.stockId %>">
                        <button type="submit" class="btn-quick-action" style="background: rgba(244, 63, 94, 0.15); color: #fb7185; border-color: rgba(244, 63, 94, 0.3);">
                          🛒 Talep Aç
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 4: HİYERARŞİK REÇETE & İHTİYAÇ AĞACI (Interactive Tree) -->
      <div id="tab-tree-view" class="mrp-tab-content">
        <div style="margin-bottom: 14px;">
          <h3 style="font-size: 1rem; font-weight: 800; color: #818cf8; margin: 0;">🌳 Çok Seviyeli İhtiyaç & Reçete Ağacı</h3>
          <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">Satış siparişi bazında mamulden en alt hammaddeye kadar fire oranları, birim katsayılar ve depo yeterlilik haritası.</p>
        </div>

        <% if (orderAnalysisTrees.length === 0) { %>
          <div class="tree-card" style="text-align: center; color: var(--text-muted); padding: 3rem;">
            Analiz edilecek açık satış siparişi veya üretim talebi bulunmamaktadır.
          </div>
        <% } else { %>
          <% orderAnalysisTrees.forEach((ot, otIdx) => { %>
            <div class="tree-card">
              <div class="tree-header" onclick="toggleTree('tree-body-<%= otIdx %>')">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span style="font-size: 1.2rem;">🏭</span>
                  <div>
                    <strong style="color: #f8fafc; font-size: 1rem;"><%= ot.demand.sourceRef %></strong>
                    <span style="font-size: 0.8rem; color: #94a3b8; margin-left: 8px;">Müşteri: <%= ot.demand.customerName %></span>
                  </div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <span class="status-pill status-approved" style="font-family: 'JetBrains Mono', monospace;"><%= ot.demand.quantity %> <%= ot.demand.unit %> <%= ot.demand.productName %></span>
                  <span style="font-size: 0.8rem; color: #818cf8;">▼ Detaylar</span>
                </div>
              </div>

              <div id="tree-body-<%= otIdx %>" style="margin-top: 14px;">
                <% if (ot.tree && ot.tree.children && ot.tree.children.length > 0) { %>
                  <% ot.tree.children.forEach(c1 => { %>
                    <div class="tree-node-row tree-level-1">
                      <div>
                        <span style="font-weight: 700; color: #f8fafc;">[<%= c1.stockCode %>] <%= c1.name %></span>
                        <span style="font-size: 0.75rem; color: #94a3b8; margin-left: 8px;">(<%= c1.category %> • Tedarik: <%= c1.procurementMethod %>)</span>
                        <% if (c1.scrapRate > 0) { %>
                          <span style="font-size: 0.72rem; color: #fbbf24; background: rgba(245, 158, 11, 0.15); padding: 2px 6px; border-radius: 4px; margin-left: 6px;">Fire: %<%= c1.scrapRate %></span>
                        <% } %>
                      </div>
                      <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #e2e8f0;">
                          İhtiyaç: <strong><%= c1.grossRequiredQty %> <%= c1.unit %></strong> | Depo: <strong><%= c1.currentStock %> <%= c1.unit %></strong>
                        </span>
                        <% if (c1.isStockSufficient) { %>
                          <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">✓ Yeterli</span>
                        <% } else { %>
                          <span style="background: rgba(244, 63, 94, 0.2); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">🚨 Eksik: -<%= c1.shortageQty %></span>
                        <% } %>
                      </div>
                    </div>

                    <% if (c1.subTree && c1.subTree.children && c1.subTree.children.length > 0) { %>
                      <% c1.subTree.children.forEach(c2 => { %>
                        <div class="tree-node-row tree-level-2">
                          <div>
                            <span style="font-weight: 700; color: #cbd5e1;">↳ [<%= c2.stockCode %>] <%= c2.name %></span>
                            <span style="font-size: 0.75rem; color: #64748b; margin-left: 8px;">(<%= c2.category %> • Tedarik: <%= c2.procurementMethod %>)</span>
                            <% if (c2.scrapRate > 0) { %>
                              <span style="font-size: 0.72rem; color: #fbbf24; background: rgba(245, 158, 11, 0.15); padding: 2px 6px; border-radius: 4px; margin-left: 6px;">Fire: %<%= c2.scrapRate %></span>
                            <% } %>
                          </div>
                          <div style="display: flex; align-items: center; gap: 12px;">
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #cbd5e1;">
                              İhtiyaç: <strong><%= c2.grossRequiredQty %> <%= c2.unit %></strong> | Depo: <strong><%= c2.currentStock %> <%= c2.unit %></strong>
                            </span>
                            <% if (c2.isStockSufficient) { %>
                              <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">✓ Yeterli</span>
                            <% } else { %>
                              <span style="background: rgba(244, 63, 94, 0.2); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">🚨 Eksik: -<%= c2.shortageQty %></span>
                            <% } %>
                          </div>
                        </div>

                        <% if (c2.subTree && c2.subTree.children && c2.subTree.children.length > 0) { %>
                          <% c2.subTree.children.forEach(c3 => { %>
                            <div class="tree-node-row tree-level-3">
                              <div>
                                <span style="font-weight: 700; color: #94a3b8;">↳↳ [<%= c3.stockCode %>] <%= c3.name %></span>
                                <span style="font-size: 0.75rem; color: #64748b; margin-left: 8px;">(<%= c3.category %> • Tedarik: <%= c3.procurementMethod %>)</span>
                              </div>
                              <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #94a3b8;">
                                  İhtiyaç: <strong><%= c3.grossRequiredQty %> <%= c3.unit %></strong> | Depo: <strong><%= c3.currentStock %> <%= c3.unit %></strong>
                                </span>
                                <% if (c3.isStockSufficient) { %>
                                  <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">✓ Yeterli</span>
                                <% } else { %>
                                  <span style="background: rgba(244, 63, 94, 0.2); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">🚨 Eksik: -<%= c3.shortageQty %></span>
                                <% } %>
                              </div>
                            </div>
                          <% }); %>
                        <% } %>

                      <% }); %>
                    <% } %>

                  <% }); %>
                <% } else { %>
                  <div style="font-size: 0.85rem; color: var(--text-muted); padding: 10px;">Bu ürün için tanımlı aktif reçete bulunamadı.</div>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <!-- TAB 5: TÜM BİLEŞENLER & STOK DENGESİ -->
      <div id="tab-raw-components" class="mrp-tab-content">
        <div style="margin-bottom: 14px;">
          <h3 style="font-size: 1rem; font-weight: 800; color: #818cf8; margin: 0;">📦 Tüm Bileşenler & Stok Dengesi Tablosu</h3>
          <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">Tüm açık imalat ve satış siparişlerinin toplam brüt ihtiyaçları ve net açık durumları.</p>
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Malzeme Kodu</th>
                <th>Bileşen / Malzeme Adı</th>
                <th>Kategori</th>
                <th>Tedarik Yöntemi</th>
                <th>Depo Stoğu</th>
                <th>Açık Talepler</th>
                <th>Brüt İhtiyaç</th>
                <th>Net İhtiyaç</th>
                <th>Öncelik</th>
                <th>Kaynak Siparişler</th>
              </tr>
            </thead>
            <tbody>
              <% if (mrpResults.length === 0) { %>
                <tr><td colspan="10" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Analiz edilecek bileşen kaydı bulunmamaktadır.</td></tr>
              <% } else { %>
                <% mrpResults.forEach(item => { %>
                  <tr>
                    <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= item.stockCode %></strong></td>
                    <td><strong style="color: var(--text-primary);"><%= item.name %></strong></td>
                    <td><span class="status-pill status-approved"><%= item.category %></span></td>
                    <td><span class="status-pill status-pending"><%= item.procurementMethod %></span></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace;"><%= item.currentStock %> <%= item.unit %></strong></td>
                    <td style="font-family: 'JetBrains Mono', monospace;"><%= item.openReqQty %> <%= item.unit %></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace; color: #fbbf24;"><%= item.grossRequirement %> <%= item.unit %></strong></td>
                    <td>
                      <% if (item.netRequirement > 0) { %>
                        <strong style="font-family: 'JetBrains Mono', monospace; color: #fb7185; font-size: 0.95rem;">🚨 +<%= item.netRequirement %> <%= item.unit %></strong>
                      <% } else { %>
                        <span style="color: #34d399; font-weight: 700;">✓ Yeterli (0)</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (item.urgency === 'Critical') { %>
                        <span class="status-pill status-rejected">🚨 KRİTİK</span>
                      <% } else if (item.urgency === 'High') { %>
                        <span class="status-pill status-pending">⚡ Yüksek</span>
                      <% } else { %>
                        <span class="status-pill status-approved">Normal</span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.75rem; color: var(--text-muted); max-width: 250px;"><%= item.references %></td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    function switchMRPTab(tabId, ev) {
      document.querySelectorAll('.mrp-tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.mrp-tab-content').forEach(c => c.classList.remove('active'));

      if (ev && ev.currentTarget) {
        ev.currentTarget.classList.add('active');
      }
      const target = document.getElementById(tabId);
      if (target) target.classList.add('active');
    }

    function toggleTree(id) {
      const el = document.getElementById(id);
      if (el) {
        el.style.display = el.style.display === 'none' ? 'block' : 'none';
      }
    }
  </script>
</body>
</html>
