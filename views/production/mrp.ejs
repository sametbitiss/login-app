<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Malzeme İhtiyaç Planlaması (MRP) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/orders/add" class="mss-sub-link">➕ Yeni İş Emri Ekle</a>
        <a href="/production/mrp" class="mss-sub-link active">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/production/analytics" class="msn-link">📊 Analitik</a>
        <a href="/production/orders" class="msn-link">📋 İş Emirleri</a>
        <a href="/production/orders/add" class="msn-link">➕ İş Emri Ekle</a>
        <a href="/production/mrp" class="msn-link active">⚡ MRP Hesaplama</a>
        <a href="/production/bom" class="msn-link">📜 Reçeteler (BOM)</a>
        <a href="/production/routing" class="msn-link">🛠️ Rotalama</a>
        <a href="/production/capacity" class="msn-link">🏭 Kapasite</a>
        <a href="/production/mes" class="msn-link">📱 MES Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Malzeme İhtiyaç Planlaması (MRP Engine)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Açık iş emirleri ve satış siparişlerine göre hammadde reçete patlatması ve net gereksinim hesabı.</p>
        </div>
        <% if (mrpResults.filter(i => i.netRequirement > 0).length > 0) { %>
          <form action="/production/mrp/execute" method="POST">
            <button type="submit" class="btn btn-success">
              ⚡ Otomatik Satın Alma Talepleri Oluştur (<%= mrpResults.filter(i => i.netRequirement > 0).length %> Kalem)
            </button>
          </form>
        <% } %>
      </div>

      <% if (successMsg) { %>
        <div style="background: var(--emerald-soft); color: var(--emerald); border: 1px solid var(--emerald); padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-weight: 600;">✅ <%= successMsg %></div>
      <% } %>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Malzeme Kodu</th>
              <th>Hammadde / Bileşen Adı</th>
              <th>Kategori</th>
              <th>Mevcut Stok</th>
              <th>Açık Talepler</th>
              <th>Brüt İhtiyaç</th>
              <th>Net Eksik İhtiyaç</th>
              <th>Öncelik</th>
              <th>Kaynak Siparişler</th>
            </tr>
          </thead>
          <tbody>
            <% if (mrpResults.length === 0) { %>
              <tr><td colspan="9" style="text-align: center; color: var(--text-muted); padding: 3rem;">Açık iş emri veya hammadde eksiği bulunmamaktadır. Tüm stoklar yeterli! 🎉</td></tr>
            <% } else { %>
              <% mrpResults.forEach(item => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= item.stockCode %></strong></td>
                  <td><strong style="color: var(--text-primary);"><%= item.name %></strong></td>
                  <td><span class="status-pill status-approved"><%= item.category %></span></td>
                  <td><strong><%= item.currentStock %> <%= item.unit %></strong></td>
                  <td><%= item.openReqQty %> <%= item.unit %></td>
                  <td><strong style="color: var(--amber);"><%= item.grossRequirement %> <%= item.unit %></strong></td>
                  <td>
                    <% if (item.netRequirement > 0) { %>
                      <strong style="color: var(--rose); font-size: 1rem;">🚨 +<%= item.netRequirement %> <%= item.unit %></strong>
                    <% } else { %>
                      <span style="color: var(--emerald); font-weight: 600;">✓ Yeterli (0)</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (item.urgency === 'Critical') { %>
                      <span class="status-pill status-rejected">🚨 KRİTİK</span>
                    <% } else if (item.urgency === 'High') { %>
                      <span class="status-pill status-pending">⚡ Yüksek</span>
                    <% } else { %>
                      <span class="status-pill status-approved">Normal</span>
                    <% } %>
                  </td>
                  <td style="font-size: 0.75rem; color: var(--text-muted); max-width: 250px;"><%= item.references %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
