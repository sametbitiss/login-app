<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Malzeme İhtiyaç Planlaması (MRP) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .mrp-tabs-nav {
      display: flex; gap: 8px; border-bottom: 1.5px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 20px; padding-bottom: 2px; overflow-x: auto;
    }
    .mrp-tab-btn {
      background: transparent; border: none; outline: none; padding: 12px 20px;
      color: #94a3b8; font-size: 0.9rem; font-weight: 700; cursor: pointer;
      border-radius: 12px 12px 0 0; transition: all 0.2s ease; display: inline-flex;
      align-items: center; gap: 8px; white-space: nowrap; border-bottom: 2.5px solid transparent;
    }
    .mrp-tab-btn:hover { color: #f8fafc; background: rgba(255, 255, 255, 0.03); }
    .mrp-tab-btn.active {
      color: #6366f1; border-bottom-color: #6366f1; background: rgba(99, 102, 241, 0.08);
    }
    .mrp-tab-content { display: none; }
    .mrp-tab-content.active { display: block; animation: fadeIn 0.25s ease; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    .badge-count {
      padding: 2px 8px; border-radius: 20px; font-size: 0.75rem; font-weight: 800;
      font-family: 'JetBrains Mono', monospace;
    }
    .badge-count--green { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .badge-count--amber { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .badge-count--rose { background: rgba(244, 63, 94, 0.2); color: #fb7185; }
    .badge-count--indigo { background: rgba(99, 102, 241, 0.2); color: #818cf8; }
    .badge-count--slate { background: rgba(148, 163, 184, 0.2); color: #94a3b8; }

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .kpi-card {
      background: rgba(15, 23, 42, 0.65);
      border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }
    .kpi-icon {
      width: 44px; height: 44px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; flex-shrink: 0;
    }
    .kpi-icon--indigo { background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); }
    .kpi-icon--emerald { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .kpi-icon--amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .kpi-icon--rose { background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3); }
    .kpi-icon--cyan { background: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3); }
    .kpi-icon--purple { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }

    .kpi-info { display: flex; flex-direction: column; }
    .kpi-label { font-size: 0.78rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
    .kpi-value { font-size: 1.25rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; color: #f8fafc; margin-top: 2px; }

    .tree-card {
      background: rgba(15, 23, 42, 0.65); border: 1.5px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px; padding: 18px 22px; margin-bottom: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }
    .tree-header {
      display: flex; justify-content: space-between; align-items: center;
      cursor: pointer; user-select: none;
    }
    .tree-node-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px; margin: 6px 0; border-radius: 10px;
      background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255, 255, 255, 0.04);
      font-size: 0.875rem;
    }
    .tree-level-1 { margin-left: 20px; border-left: 3px solid #6366f1; }
    .tree-level-2 { margin-left: 45px; border-left: 3px solid #f59e0b; }
    .tree-level-3 { margin-left: 70px; border-left: 3px solid #10b981; }

    .btn-mrp-trigger {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #ffffff !important; font-size: 0.95rem; font-weight: 800; padding: 12px 24px;
      border-radius: 14px; border: none; cursor: pointer; text-decoration: none;
      box-shadow: 0 8px 25px rgba(99, 102, 241, 0.45);
      display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease;
    }
    .btn-mrp-trigger:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(99, 102, 241, 0.6); }

    .btn-quick-action {
      background: rgba(255, 255, 255, 0.08); color: #f8fafc; font-size: 0.78rem; font-weight: 700;
      padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.12);
      cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;
    }
    .btn-quick-action:hover { background: rgba(255, 255, 255, 0.18); transform: translateY(-1px); }

    .priority-badge {
      display: inline-flex; align-items: center; justify-content: center;
      width: 28px; height: 28px; border-radius: 8px; font-weight: 900;
      font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;
    }
    .priority-badge--top { background: rgba(99, 102, 241, 0.25); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.5); }
    .priority-badge--normal { background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); }

    .blocker-tag {
      font-size: 0.75rem; color: #fb7185; background: rgba(244, 63, 94, 0.12);
      padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(244, 63, 94, 0.25);
      margin-top: 4px; display: inline-block;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🏭 ÜRETİM & İMALAT YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & PERFORMANS</div>
      <div class="mss-sub">
        <a href="/production/analytics" class="mss-sub-link">📊 Üretim Analitiği</a>
      </div>
      <div class="mss-group-title">⚙️ İMALAT & SİPARİŞ KONTROLÜ</div>
      <div class="mss-sub">
        <a href="/production/requisitions" class="mss-sub-link">📩 Üretim Talepleri</a>
        <a href="/production/orders" class="mss-sub-link">📋 Üretim İş Emirleri</a>
        <a href="/production/mrp" class="mss-sub-link active">⚡ Malzeme İhtiyaç (MRP)</a>
      </div>
      <div class="mss-group-title">📜 REÇETE & PROCESS MÜHENDİSLİĞİ</div>
      <div class="mss-sub">
        <a href="/production/bom" class="mss-sub-link">📜 Üretim Reçeteleri (BOM)</a>
        <a href="/production/routing" class="mss-sub-link">🛠️ Rotalama & Operasyonlar</a>
        <a href="/production/workshops" class="mss-sub-link">🏢 Atölye Kartları</a>
        <a href="/production/work-centers" class="mss-sub-link">⚙️ İş Merkezleri</a>
      </div>
      <div class="mss-group-title">🏭 KAPASİTE & SAHA TAKİBİ (MES)</div>
      <div class="mss-sub">
        <a href="/production/capacity" class="mss-sub-link">🏭 Kapasite Planlaması</a>
        <a href="/production/mes" class="mss-sub-link">📱 MES Saha Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a><a href="/production" class="mt-link active">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <!-- PAGE HEADER & MRP BUTTON -->
      <div class="page-header" style="margin-bottom: 24px;">
        <div>
          <h1 style="display: flex; align-items: center; gap: 12px;">
            <span>⚡ Malzeme İhtiyaç Planlaması (MRP Engine)</span>
          </h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            Aktif üretim taleplerine göre çok seviyeli hiyerarşik reçete (BOM) patlatması, küsürat yuvarlaması, fiziksel stok kontrolü ve aşağıdan yukarı iş emri planlama motoru.
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px;">
          <a href="/production/mrp" class="btn-mrp-trigger" id="btnRunMRP">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span>⚡ MRP Oluştur / Analiz Et</span>
          </a>
        </div>
      </div>

      <% if (successMsg) { %>
        <div style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1.5px solid rgba(16, 185, 129, 0.35); padding: 14px 20px; border-radius: 14px; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>✅</span> <%= successMsg %>
        </div>
      <% } %>

      <% if (errorMsg) { %>
        <div style="background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1.5px solid rgba(244, 63, 94, 0.35); padding: 14px 20px; border-radius: 14px; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= errorMsg %>
        </div>
      <% } %>

      <!-- KPI METRIC GRID -->
      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-icon kpi-icon--indigo">📋</div>
          <div class="kpi-info">
            <span class="kpi-label">Analiz Edilen Talep</span>
            <span class="kpi-value"><%= kpiSummary.totalDemandsCount || 0 %> Talep</span>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon kpi-icon--emerald">🟢</div>
          <div class="kpi-info">
            <span class="kpi-label">Hazır İş Emirleri</span>
            <span class="kpi-value" style="color: #34d399;"><%= kpiSummary.activeWorkOrdersCount || 0 %> Öneri</span>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon kpi-icon--amber">🟡</div>
          <div class="kpi-info">
            <span class="kpi-label">Bekleyen / Pasif İş Emri</span>
            <span class="kpi-value" style="color: #fbbf24;"><%= kpiSummary.passiveWorkOrdersCount || 0 %> Beklemede</span>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon kpi-icon--rose">🛒</div>
          <div class="kpi-info">
            <span class="kpi-label">Satın Alma İhtiyacı</span>
            <span class="kpi-value" style="color: #fb7185;"><%= kpiSummary.purchaseSuggestionsCount || 0 %> Kalem</span>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon kpi-icon--purple">🏭</div>
          <div class="kpi-info">
            <span class="kpi-label">Üretim Talebi İhtiyacı</span>
            <span class="kpi-value" style="color: #c084fc;"><%= kpiSummary.productionReqSuggestionsCount || 0 %> Kalem</span>
          </div>
        </div>
        <div class="kpi-card">
          <div class="kpi-icon kpi-icon--cyan">📦</div>
          <div class="kpi-info">
            <span class="kpi-label">Toplam Malzeme Türü</span>
            <span class="kpi-value" style="color: #22d3ee;"><%= kpiSummary.totalMaterialTypesCount || 0 %> Kalem</span>
          </div>
        </div>
      </div>

      <!-- MRP TABS NAVIGATION -->
      <nav class="mrp-tabs-nav">
        <button type="button" class="mrp-tab-btn active" onclick="switchMRPTab('tab-work-orders', event)">
          <span>📋 1. İş Emri Önerileri (Hiyerarşik Sıralı)</span>
          <span class="badge-count badge-count--green"><%= workOrderSuggestions.length %></span>
        </button>
        <button type="button" class="mrp-tab-btn" onclick="switchMRPTab('tab-purchase-reqs', event)">
          <span>🛒 2. Satın Alma Talebi Önerileri</span>
          <span class="badge-count badge-count--rose"><%= purchaseSuggestions.length %></span>
        </button>
        <button type="button" class="mrp-tab-btn" onclick="switchMRPTab('tab-production-reqs', event)">
          <span>🏭 3. Üretim Talebi Önerileri</span>
          <span class="badge-count badge-count--amber"><%= productionReqSuggestions.length %></span>
        </button>
        <button type="button" class="mrp-tab-btn" onclick="switchMRPTab('tab-tree-view', event)">
          <span>🌳 4. Hiyerarşik Reçete & İhtiyaç Ağacı</span>
          <span class="badge-count badge-count--indigo"><%= demandAnalyses.length %></span>
        </button>
        <button type="button" class="mrp-tab-btn" onclick="switchMRPTab('tab-raw-components', event)">
          <span>📦 5. Toplam Malzeme İhtiyaç & Stok Dengesi</span>
          <span class="badge-count badge-count--slate"><%= materialRequirements.length %></span>
        </button>
      </nav>

      <!-- TAB 1: İŞ EMRİ ÖNERİLERİ (Aşağıdan Yukarı Bağımlılık Hiyerarşisi) -->
      <div id="tab-work-orders" class="mrp-tab-content active">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
          <div>
            <h3 style="font-size: 1rem; font-weight: 800; color: #34d399; margin: 0;">📋 İş Emri Önerileri (Aşağıdan Yukarı Planlama)</h3>
            <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">
              Önce alt seviye yarı mamullerin iş emirleri, ardından alt bileşenleri tam olan mamullerin iş emirleri listelenir. Alt bileşeni eksik olan üst seviye mamuller "Pasif / Beklemede" olarak işaretlenir.
            </p>
          </div>
          <% const activeWOs = workOrderSuggestions.filter(w => w.status === 'Active'); %>
          <% if (activeWOs.length > 0) { %>
            <form action="/production/mrp/execute" method="POST">
              <input type="hidden" name="actionType" value="create_work_orders">
              <button type="submit" class="btn-quick-action" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(16, 185, 129, 0.4);">
                ⚡ Tüm Hazır İş Emirlerini Başlat (<%= activeWOs.length %> Adet)
              </button>
            </form>
          <% } %>
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th style="width: 50px; text-align: center;">Sıra</th>
                <th>Kaynak Talep / Sipariş</th>
                <th>Ürün Kodu & Adı</th>
                <th>Seviye / Tür</th>
                <th>Planlanan Miktar</th>
                <th>Hedef İş İstasyonu</th>
                <th>Tahmini Süre</th>
                <th>Bileşen & Bağımlılık Durumu</th>
                <th style="text-align: right;">Aksiyon</th>
              </tr>
            </thead>
            <tbody>
              <% if (workOrderSuggestions.length === 0) { %>
                <tr><td colspan="9" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Şu anda aktif üretim talebi veya reçeteli ürün bulunmamaktadır.</td></tr>
              <% } else { %>
                <% workOrderSuggestions.forEach((wo) => { %>
                  <tr style="<%= wo.status === 'Passive' ? 'opacity: 0.85; background: rgba(245, 158, 11, 0.03);' : '' %>">
                    <td style="text-align: center;">
                      <span class="priority-badge <%= wo.status === 'Active' ? 'priority-badge--top' : 'priority-badge--normal' %>">
                        #<%= wo.priorityOrder %>
                      </span>
                    </td>
                    <td>
                      <strong style="color: #818cf8;"><%= wo.demandSources || '—' %></strong>
                    </td>
                    <td>
                      <strong style="color: var(--text-primary);"><%= wo.name %></strong>
                      <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: #94a3b8;">[<%= wo.stockCode %>]</div>
                    </td>
                    <td>
                      <% if (wo.isTopLevel) { %>
                        <span style="background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; border: 1px solid rgba(99, 102, 241, 0.3);">🔷 Mamul (Üst Seviye)</span>
                      <% } else { %>
                        <span style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; border: 1px solid rgba(245, 158, 11, 0.3);">🔶 Yarı Mamul (Öncelikli)</span>
                      <% } %>
                    </td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace; font-size: 0.95rem; color: #f8fafc;"><%= wo.quantity %> <%= wo.unit %></strong></td>
                    <td style="font-size: 0.825rem; color: #cbd5e1;"><%= wo.workCenter %></td>
                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: #fbbf24;"><%= wo.estimatedHours %> Saat</td>
                    <td>
                      <% if (wo.hasExistingOrder) { %>
                        <span style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; padding: 4px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78rem; border: 1px solid rgba(245, 158, 11, 0.3); display: inline-flex; align-items: center; gap: 4px;">
                          ⚠️ İş Emri Mevcut (<%= wo.existingWorkOrderNo %>)
                        </span>
                      <% } else if (wo.status === 'Active') { %>
                        <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 4px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78rem; border: 1px solid rgba(16, 185, 129, 0.3); display: inline-flex; align-items: center; gap: 4px;">
                          🟢 Bileşenler Hazır — İş Emri Açılabilir
                        </span>
                      <% } else { %>
                        <span style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; padding: 4px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78rem; border: 1px solid rgba(245, 158, 11, 0.3); display: inline-flex; align-items: center; gap: 4px;">
                          🟡 Beklemede — Alt Bileşen Eksik
                        </span>
                        <% if (wo.blockers && wo.blockers.length > 0) { %>
                          <div>
                            <% wo.blockers.forEach(b => { %>
                              <div class="blocker-tag">
                                ⛔ <%= b.blockerLabel %> (Eksik: <%= b.shortage %> <%= b.name %>)
                              </div>
                            <% }); %>
                          </div>
                        <% } %>
                      <% } %>
                    </td>
                    <td style="text-align: right;">
                      <% if (wo.hasExistingOrder) { %>
                        <button type="button" class="btn-quick-action" style="background: rgba(255, 255, 255, 0.04); color: #94a3b8; border-color: rgba(255, 255, 255, 0.1); cursor: not-allowed;" title="Bu ürün için zaten sistemde aktif veya tamamlanmış bir iş emri bulunmaktadır ([<%= wo.existingWorkOrderNo %>]). Mükerrer iş emri açılamaz." disabled>
                          🔒 İş Emri Mevcut
                        </button>
                      <% } else if (wo.status === 'Active') { %>
                        <a href="/production/orders/add?stockId=<%= wo.stockId %>&plannedQty=<%= wo.quantity %>&priority=<%= encodeURIComponent(wo.priority || 'Normal') %>&requisitionNo=<%= encodeURIComponent(wo.demandSources || '') %>" class="btn-quick-action" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border-color: rgba(16, 185, 129, 0.4); text-decoration: none;">
                          ➕ İş Emri Aç & İncele
                        </a>
                      <% } else { %>
                        <button type="button" class="btn-quick-action" style="background: rgba(255, 255, 255, 0.04); color: #64748b; border-color: rgba(255, 255, 255, 0.08); cursor: not-allowed;" title="Alt bileşenleri tamamlanmadan iş emri açılamaz" disabled>
                          🔒 Bağımlılık Bekliyor
                        </button>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 2: SATIN ALMA TALEBİ ÖNERİLERİ (Eksik Hammaddeler) -->
      <div id="tab-purchase-reqs" class="mrp-tab-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
          <div>
            <h3 style="font-size: 1rem; font-weight: 800; color: #fb7185; margin: 0;">🛒 Satın Alma Talebi Önerileri (Eksik Hammaddeler)</h3>
            <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">Tedarik yöntemi Satın Alma olan ve fiziksel depo stoğu toplam brüt ihtiyacı karşılamayan hammaddeler.</p>
          </div>
          <% if (purchaseSuggestions.length > 0) { %>
            <form action="/production/mrp/execute" method="POST">
              <input type="hidden" name="actionType" value="create_purchase_reqs">
              <button type="submit" class="btn-quick-action" style="background: rgba(244, 63, 94, 0.2); color: #fb7185; border-color: rgba(244, 63, 94, 0.4);">
                🛒 Tüm Satın Alma Taleplerini Oluştur (<%= purchaseSuggestions.length %> Kalem)
              </button>
            </form>
          <% } %>
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Malzeme Kodu</th>
                <th>Malzeme Adı</th>
                <th>Kategori</th>
                <th>Depo Stoğu</th>
                <th>Brüt İhtiyaç</th>
                <th>Net Eksik Miktar</th>
                <th>İhtiyaç Tarihi (En Geç)</th>
                <th>Hedef Depo</th>
                <th>Kaynak / Tedarikçi</th>
                <th style="text-align: right;">Aksiyon</th>
              </tr>
            </thead>
            <tbody>
              <% if (purchaseSuggestions.length === 0) { %>
                <tr><td colspan="10" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Depoda eksik hammadde bulunmamaktadır. Tüm satın alma stokları yeterli! 🎉</td></tr>
              <% } else { %>
                <% purchaseSuggestions.forEach((pr) => { %>
                  <tr>
                    <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;">[<%= pr.stockCode %>]</strong></td>
                    <td><strong style="color: var(--text-primary);"><%= pr.name %></strong></td>
                    <td><span class="status-pill status-approved"><%= pr.category %></span></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace;"><%= pr.currentStock %> <%= pr.unit %></strong></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace; color: #fbbf24;"><%= pr.grossRequirement %> <%= pr.unit %></strong></td>
                    <td>
                      <strong style="font-family: 'JetBrains Mono', monospace; color: #fb7185; font-size: 1rem;">
                        🚨 +<%= pr.netShortage %> <%= pr.unit %>
                      </strong>
                    </td>
                    <td>
                      <% if (pr.requiredDate) { %>
                        <div style="font-weight: 700; color: #38bdf8; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 4px;">
                          📅 <%= new Date(pr.requiredDate).toLocaleDateString('tr-TR') %>
                        </div>
                        <div style="font-size: 0.7rem; color: var(--text-muted);">
                          (Termin: <%= pr.deliveryDate ? new Date(pr.deliveryDate).toLocaleDateString('tr-TR') : '—' %> - <%= pr.productionDays %> Gün İmalat)
                        </div>
                      <% } else { %>
                        <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
                      <% } %>
                    </td>
                    <td>
                      <div style="font-size: 0.8rem; font-weight: 600; color: #cbd5e1; display: inline-flex; align-items: center; gap: 4px;">
                        🏢 <%= pr.targetWarehouse %>
                      </div>
                    </td>
                    <td>
                      <div style="font-size: 0.8rem; color: var(--text-primary); font-weight: 600;"><%= pr.demandSources %></div>
                      <div style="font-size: 0.72rem; color: var(--text-muted);"><%= pr.suggestedSupplier %></div>
                    </td>
                    <td style="text-align: right;">
                      <form action="/production/mrp/execute" method="POST" style="display: inline-block;">
                        <input type="hidden" name="actionType" value="create_purchase_reqs">
                        <input type="hidden" name="stockId" value="<%= pr.stockId %>">
                        <button type="submit" class="btn-quick-action" style="background: rgba(244, 63, 94, 0.15); color: #fb7185; border-color: rgba(244, 63, 94, 0.3);">
                          🛒 Talep Aç
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 3: ÜRETİM TALEBİ ÖNERİLERİ (Eksik Yarı Mamuller) -->
      <div id="tab-production-reqs" class="mrp-tab-content">
        <div style="margin-bottom: 14px;">
          <h3 style="font-size: 1rem; font-weight: 800; color: #c084fc; margin: 0;">🏭 Üretim Talebi Önerileri (Eksik Yarı Mamuller)</h3>
          <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">Tedarik yöntemi Üretim olan ancak depo stoğu brüt ihtiyacı karşılamadığı için imalatı gereken yarı mamuller.</p>
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Ürün Kodu</th>
                <th>Yarı Mamul / Ürün Adı</th>
                <th>Kategori</th>
                <th>Mevcut Depo Stoğu</th>
                <th>Brüt İhtiyaç</th>
                <th>Net Eksik Miktar</th>
                <th>Kaynak Talepler</th>
                <th style="text-align: right;">Aksiyon / Durum</th>
              </tr>
            </thead>
            <tbody>
              <% if (productionReqSuggestions.length === 0) { %>
                <tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Tüm yarı mamullerin depo stoğu yeterlidir. Üretim talebi açılması gereken eksik yarı mamul bulunmamaktadır. 🎉</td></tr>
              <% } else { %>
                <% productionReqSuggestions.forEach((pr) => { %>
                  <tr>
                    <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;">[<%= pr.stockCode %>]</strong></td>
                    <td><strong style="color: var(--text-primary);"><%= pr.name %></strong></td>
                    <td><span class="status-pill status-pending"><%= pr.category %></span></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace;"><%= pr.currentStock %> <%= pr.unit %></strong></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace; color: #fbbf24;"><%= pr.grossRequirement %> <%= pr.unit %></strong></td>
                    <td>
                      <strong style="font-family: 'JetBrains Mono', monospace; color: #c084fc; font-size: 1rem;">
                        🚨 +<%= pr.netShortage %> <%= pr.unit %>
                      </strong>
                    </td>
                    <td style="font-size: 0.75rem; color: var(--text-muted);"><%= pr.demandSources %></td>
                    <td style="text-align: right;">
                      <span style="background: rgba(168, 85, 247, 0.15); color: #c084fc; padding: 4px 10px; border-radius: 8px; font-weight: 700; font-size: 0.78rem; border: 1px solid rgba(168, 85, 247, 0.3);">
                        🏭 İş Emri Planına Dahil Edildi
                      </span>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 4: HİYERARŞİK REÇETE & İHTİYAÇ AĞACI (Interactive Tree) -->
      <div id="tab-tree-view" class="mrp-tab-content">
        <div style="margin-bottom: 14px;">
          <h3 style="font-size: 1rem; font-weight: 800; color: #818cf8; margin: 0;">🌳 Hiyerarşik Reçete & İhtiyaç Patlatma Ağacı</h3>
          <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">Üretim talebi bazında mamulden en alt hammaddeye kadar fire oranları, çarpanlar ve depo stok yeterliliği.</p>
        </div>

        <% if (demandAnalyses.length === 0) { %>
          <div class="tree-card" style="text-align: center; color: var(--text-muted); padding: 3rem;">
            Analiz edilecek aktif üretim talebi bulunmamaktadır.
          </div>
        <% } else { %>
          <% demandAnalyses.forEach((ot, otIdx) => { %>
            <div class="tree-card">
              <div class="tree-header" onclick="toggleTree('tree-body-<%= otIdx %>')">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span style="font-size: 1.2rem;">🏭</span>
                  <div>
                    <strong style="color: #f8fafc; font-size: 1rem;"><%= ot.demand.demandRef %>: <%= ot.demand.productName %></strong>
                    <span style="font-size: 0.8rem; color: #94a3b8; margin-left: 8px;">(Miktar: <%= ot.demand.quantity %> <%= ot.demand.unit %> • Öncelik: <%= ot.demand.priority %>)</span>
                  </div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                  <span class="status-pill status-approved" style="font-family: 'JetBrains Mono', monospace;"><%= ot.demand.quantity %> <%= ot.demand.unit %></span>
                  <span style="font-size: 0.8rem; color: #818cf8;">▼ Ağacı Göster / Gizle</span>
                </div>
              </div>

              <div id="tree-body-<%= otIdx %>" style="margin-top: 14px;">
                <% if (ot.tree && ot.tree.children && ot.tree.children.length > 0) { %>
                  <% ot.tree.children.forEach(c1 => { %>
                    <div class="tree-node-row tree-level-1">
                      <div>
                        <% const c1Icon = c1.category === 'Hammadde' ? '🟦' : (['Yari_Mamul', 'Yarı_Mamul'].includes(c1.category) ? '🟧' : '🟥'); %>
                        <span style="font-weight: 700; color: #f8fafc;"><%= c1Icon %> [<%= c1.stockCode %>] <%= c1.name %></span>
                        <span style="font-size: 0.75rem; color: #94a3b8; margin-left: 8px;">(<%= c1.category %> • <%= c1.procurementMethod %>)</span>
                        <% if (c1.scrapRate > 0) { %>
                          <span style="font-size: 0.72rem; color: #fbbf24; background: rgba(245, 158, 11, 0.15); padding: 2px 6px; border-radius: 4px; margin-left: 6px;">Fire: %<%= c1.scrapRate %></span>
                        <% } %>
                      </div>
                      <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #e2e8f0;">
                          İhtiyaç: <strong><%= c1.grossRequired %> <%= c1.unit %></strong> | Depo: <strong><%= c1.currentStock %> <%= c1.unit %></strong>
                        </span>
                        <% if (c1.currentStock >= c1.grossRequired) { %>
                          <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">✓ Yeterli</span>
                        <% } else { %>
                          <span style="background: rgba(244, 63, 94, 0.2); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">🚨 Eksik: -<%= (c1.grossRequired - c1.currentStock).toFixed(2) %></span>
                        <% } %>
                      </div>
                    </div>

                    <% if (c1.subTree && c1.subTree.children && c1.subTree.children.length > 0) { %>
                      <% c1.subTree.children.forEach(c2 => { %>
                        <div class="tree-node-row tree-level-2">
                          <div>
                            <% const c2Icon = c2.category === 'Hammadde' ? '🟦' : (['Yari_Mamul', 'Yarı_Mamul'].includes(c2.category) ? '🟧' : '🟥'); %>
                            <span style="font-weight: 700; color: #cbd5e1;">↳ <%= c2Icon %> [<%= c2.stockCode %>] <%= c2.name %></span>
                            <span style="font-size: 0.75rem; color: #64748b; margin-left: 8px;">(<%= c2.category %> • <%= c2.procurementMethod %>)</span>
                            <% if (c2.scrapRate > 0) { %>
                              <span style="font-size: 0.72rem; color: #fbbf24; background: rgba(245, 158, 11, 0.15); padding: 2px 6px; border-radius: 4px; margin-left: 6px;">Fire: %<%= c2.scrapRate %></span>
                            <% } %>
                          </div>
                          <div style="display: flex; align-items: center; gap: 12px;">
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #cbd5e1;">
                              İhtiyaç: <strong><%= c2.grossRequired %> <%= c2.unit %></strong> | Depo: <strong><%= c2.currentStock %> <%= c2.unit %></strong>
                            </span>
                            <% if (c2.currentStock >= c2.grossRequired) { %>
                              <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">✓ Yeterli</span>
                            <% } else { %>
                              <span style="background: rgba(244, 63, 94, 0.2); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">🚨 Eksik: -<%= (c2.grossRequired - c2.currentStock).toFixed(2) %></span>
                            <% } %>
                          </div>
                        </div>

                        <% if (c2.subTree && c2.subTree.children && c2.subTree.children.length > 0) { %>
                          <% c2.subTree.children.forEach(c3 => { %>
                            <div class="tree-node-row tree-level-3">
                              <div>
                                <% const c3Icon = c3.category === 'Hammadde' ? '🟦' : (['Yari_Mamul', 'Yarı_Mamul'].includes(c3.category) ? '🟧' : '🟥'); %>
                                <span style="font-weight: 700; color: #94a3b8;">↳↳ <%= c3Icon %> [<%= c3.stockCode %>] <%= c3.name %></span>
                                <span style="font-size: 0.75rem; color: #64748b; margin-left: 8px;">(<%= c3.category %> • <%= c3.procurementMethod %>)</span>
                              </div>
                              <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #94a3b8;">
                                  İhtiyaç: <strong><%= c3.grossRequired %> <%= c3.unit %></strong> | Depo: <strong><%= c3.currentStock %> <%= c3.unit %></strong>
                                </span>
                                <% if (c3.currentStock >= c3.grossRequired) { %>
                                  <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">✓ Yeterli</span>
                                <% } else { %>
                                  <span style="background: rgba(244, 63, 94, 0.2); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">🚨 Eksik: -<%= (c3.grossRequired - c3.currentStock).toFixed(2) %></span>
                                <% } %>
                              </div>
                            </div>
                          <% }); %>
                        <% } %>

                      <% }); %>
                    <% } %>

                  <% }); %>
                <% } else { %>
                  <div style="font-size: 0.85rem; color: var(--text-muted); padding: 10px;">Bu ürün için tanımlı aktif reçete bulunamadı.</div>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <!-- TAB 5: TOPLAM MALZEME İHTİYAÇ & STOK DENGESİ -->
      <div id="tab-raw-components" class="mrp-tab-content">
        <div style="margin-bottom: 14px;">
          <h3 style="font-size: 1rem; font-weight: 800; color: #818cf8; margin: 0;">📦 Toplam Malzeme İhtiyaç & Stok Dengesi Tablosu (Aggregated)</h3>
          <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 2px 0 0 0;">
            Tüm üretim taleplerinden ve alt reçetelerden gelen ortak malzemelerin toplam brüt ihtiyaçları, yuvarlanmış miktarları ve fiziksel stok dengesi.
          </p>
        </div>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Malzeme Kodu</th>
                <th>Bileşen / Malzeme Adı</th>
                <th>Kategori</th>
                <th>Tedarik Yöntemi</th>
                <th>Birim</th>
                <th>Fiziksel Depo Stoğu</th>
                <th>Brüt İhtiyaç (Fireli & Yuvarlanmış)</th>
                <th>Net Eksik Miktar</th>
                <th>Stok Yeterliliği</th>
                <th>Kaynak Talepler</th>
              </tr>
            </thead>
            <tbody>
              <% if (materialRequirements.length === 0) { %>
                <tr><td colspan="10" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Analiz edilecek bileşen kaydı bulunmamaktadır.</td></tr>
              <% } else { %>
                <% materialRequirements.forEach(item => { %>
                  <tr>
                    <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= item.stockCode %></strong></td>
                    <td><strong style="color: var(--text-primary);"><%= item.name %></strong></td>
                    <td>
                      <% if (item.category === 'Hammadde') { %>
                        <span class="status-pill status-approved">🟦 Hammadde</span>
                      <% } else if (['Yari_Mamul', 'Yarı_Mamul'].includes(item.category)) { %>
                        <span class="status-pill status-pending">🟧 Yarı Mamul</span>
                      <% } else { %>
                        <span class="status-pill status-completed">🟥 Mamul</span>
                      <% } %>
                    </td>
                    <td><span class="status-pill <%= item.procurementMethod === 'Satın Alma' ? 'status-approved' : 'status-pending' %>"><%= item.procurementMethod %></span></td>
                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;"><%= item.unit %></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace;"><%= item.currentStock %> <%= item.unit %></strong></td>
                    <td><strong style="font-family: 'JetBrains Mono', monospace; color: #fbbf24;"><%= item.grossRequirement %> <%= item.unit %></strong></td>
                    <td>
                      <% if (item.netShortage > 0) { %>
                        <strong style="font-family: 'JetBrains Mono', monospace; color: #fb7185; font-size: 0.95rem;">🚨 +<%= item.netShortage %> <%= item.unit %></strong>
                      <% } else { %>
                        <span style="color: #34d399; font-weight: 700;">0 <%= item.unit %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (item.isStockSufficient) { %>
                        <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; border: 1px solid rgba(16, 185, 129, 0.3);">✓ Yeterli</span>
                      <% } else { %>
                        <span style="background: rgba(244, 63, 94, 0.15); color: #fb7185; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; border: 1px solid rgba(244, 63, 94, 0.3);">🚨 Eksik</span>
                      <% } %>
                    </td>
                    <td style="font-size: 0.75rem; color: var(--text-muted); max-width: 250px;">
                      <%= (item.sources || []).map(s => s.demandRef).filter((v, i, a) => a.indexOf(v) === i).join(', ') %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    function switchMRPTab(tabId, ev) {
      document.querySelectorAll('.mrp-tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.mrp-tab-content').forEach(c => c.classList.remove('active'));

      if (ev && ev.currentTarget) {
        ev.currentTarget.classList.add('active');
      }
      const target = document.getElementById(tabId);
      if (target) target.classList.add('active');
    }

    function toggleTree(id) {
      const el = document.getElementById(id);
      if (el) {
        el.style.display = el.style.display === 'none' ? 'block' : 'none';
      }
    }
  </script>
</body>
</html>
