<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistem Logları & İşlem Günlüğü — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">📊 KONTROL PANELİ & ANALİTİK</div>
      <div class="mss-sub">
        <a href="/admin" class="mss-sub-link">📊 Yönetim Özeti</a>
      </div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/settings" class="mss-sub-link">⚙️ Sistem Parametreleri</a>
        <a href="/admin/logs" class="mss-sub-link active">📜 İşlem Günlüğü (Audit Log)</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link active">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Sistem Logları & Güvenlik İşlem Günlüğü</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tüm ERP modüllerinde kullanıcılar tarafından gerçekleştirilen ekleme, güncelleme ve silme işlemlerinin canlı izleme kaydı.</p>
        </div>
      </div>

      <!-- KPI Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; display: flex; align-items: center; gap: 16px;">
          <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(99, 102, 241, 0.15); color: #818cf8; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">📜</div>
          <div>
            <div style="font-size: 1.4rem; font-weight: 800; color: var(--text-main);"><%= logs.length %></div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Toplam Kayıtlı İşlem Logu</div>
          </div>
        </div>

        <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; display: flex; align-items: center; gap: 16px;">
          <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(16, 185, 129, 0.15); color: #34d399; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">🟢</div>
          <div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #34d399;"><%= logs.filter(l => (l.islem || l.action) === 'CREATE').length %></div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Veri Ekleme (CREATE)</div>
          </div>
        </div>

        <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; display: flex; align-items: center; gap: 16px;">
          <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(14, 165, 233, 0.15); color: #38bdf8; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">✏️</div>
          <div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #38bdf8;"><%= logs.filter(l => (l.islem || l.action) === 'UPDATE').length %></div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Veri Güncelleme (UPDATE)</div>
          </div>
        </div>

        <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; display: flex; align-items: center; gap: 16px;">
          <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(244, 63, 94, 0.15); color: #fb7185; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">🗑️</div>
          <div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #fb7185;"><%= logs.filter(l => (l.islem || l.action) === 'DELETE').length %></div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Silme (DELETE) İşlemleri</div>
          </div>
        </div>
      </div>

      <!-- Filter Bar -->
      <form action="/admin/logs" method="GET" style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; padding: 16px 20px; margin-bottom: 20px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 200px;">
          <input type="text" name="search" value="<%= searchQuery %>" placeholder="Kullanıcı adı, modül veya işlem detayı ara..." style="width: 100%; padding: 10px 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; color: var(--text-main); font-size: 0.88rem;">
        </div>

        <div style="width: 180px;">
          <select name="action" style="width: 100%; padding: 10px 12px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; color: var(--text-main); font-size: 0.88rem;">
            <option value="">Tüm İşlem Tipleri</option>
            <option value="CREATE" <%= queryAction === 'CREATE' ? 'selected' : '' %>>CREATE (Ekleme)</option>
            <option value="UPDATE" <%= queryAction === 'UPDATE' ? 'selected' : '' %>>UPDATE (Güncelleme)</option>
            <option value="DELETE" <%= queryAction === 'DELETE' ? 'selected' : '' %>>DELETE (Silme)</option>
            <option value="READ" <%= queryAction === 'READ' ? 'selected' : '' %>>READ (Görüntüleme)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary btn-sm" style="padding: 10px 18px; font-weight: 600;">🔍 Filtrele</button>
        <% if (searchQuery || queryAction) { %>
          <a href="/admin/logs" class="btn btn-secondary btn-sm" style="padding: 10px 18px;">Sıfırla</a>
        <% } %>
      </form>

      <!-- Log Timeline Cards -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <% if (logs.length === 0) { %>
          <div style="background: var(--bg-surface); border: 1px dashed var(--border); border-radius: 14px; padding: 40px; text-align: center; color: var(--text-muted);">
            📜 Kriterlere uygun sistem işlem logu bulunamadı.
          </div>
        <% } else { %>
          <% logs.forEach(log => { 
            const uName = log.kullaniciAdi || log.username || (log.kullanici ? log.kullanici.kullaniciAdi : 'System');
            const uObj = log.kullanici || log.user;
            const action = log.islem || log.action || 'READ';
            const entity = log.varlik || log.entity || 'General';
            const entityId = log.varlikId || log.entityId || '';
            const details = log.detaylar || log.details || `${action} işlemi gerçekleştirildi (${entity})`;
            const ip = log.ipAdresi || log.ipAddress || '';

            let fullName = uName;
            if (uObj && uObj.ad) {
              fullName = `${uObj.ad} ${uObj.soyad || ''}`.trim();
            } else if (uObj && uObj.firstName) {
              fullName = `${uObj.firstName} ${uObj.lastName || ''}`.trim();
            }
          %>
            <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; transition: transform 0.15s ease, border-color 0.15s ease;" onmouseover="this.style.borderColor='var(--indigo)'" onmouseout="this.style.borderColor='var(--border)'">
              
              <!-- Left: User Avatar & Details -->
              <div style="display: flex; align-items: center; gap: 14px; flex: 1;">
                <div style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: white; font-weight: 800; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; box-shadow: 0 4px 10px rgba(99, 102, 241, 0.25);">
                  <%= uName.charAt(0).toUpperCase() %>
                </div>

                <div style="flex: 1;">
                  <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <strong style="color: var(--text-main); font-size: 0.95rem;">
                      <%= fullName %>
                    </strong>
                    <span style="font-size: 0.78rem; color: var(--indigo); font-family: 'JetBrains Mono', monospace; background: rgba(99, 102, 241, 0.1); padding: 2px 8px; border-radius: 6px;">@<%= uName %></span>
                    
                    <% if (uObj && (uObj.departman || uObj.department)) { %>
                      <span style="background: rgba(99, 102, 241, 0.12); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.2); padding: 2px 8px; border-radius: 10px; font-weight: 600; font-size: 0.73rem;">
                        🏢 <%= uObj.departman || uObj.department %>
                      </span>
                    <% } %>

                    <% if (ip) { %>
                      <span style="font-size: 0.72rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">
                        📍 IP: <%= ip %>
                      </span>
                    <% } %>
                  </div>

                  <!-- Human Readable Event Description -->
                  <div style="font-size: 0.88rem; color: var(--text-secondary); margin-top: 6px; line-height: 1.45; font-weight: 500;">
                    <%= details %>
                  </div>
                </div>
              </div>

              <!-- Right: Action Tag & Timestamp -->
              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 6px; flex-shrink: 0;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <% 
                    let actionLabel = '👁️ Görüntülendi';
                    let actionCss = 'background: rgba(14, 165, 233, 0.15); color: #38bdf8; border: 1px solid rgba(14, 165, 233, 0.3);';
                    if (action === 'CREATE') { actionLabel = '✨ Yeni Kayıt Eklendi'; actionCss = 'background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);'; }
                    else if (action === 'UPDATE') { actionLabel = '✏️ Bilgi Güncellendi'; actionCss = 'background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3);'; }
                    else if (action === 'DELETE') { actionLabel = '🗑️ Kayıt Silindi'; actionCss = 'background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3);'; }

                    const entityMap = {
                      'User': '👥 Kullanıcı Hesabı',
                      'Kullanici': '👥 Kullanıcı Hesabı',
                      'StockItem': '📦 Stok Kartı',
                      'StokKarti': '📦 Stok Kartı',
                      'StockLot': '🏷️ Lot Partisi',
                      'StokPartisi': '🏷️ Lot Partisi',
                      'StockMovement': '🔄 Stok Hareketi',
                      'StokHareketi': '🔄 Stok Hareketi',
                      'StockCounting': '📋 Stok Sayımı',
                      'StokSayimi': '📋 Stok Sayımı',
                      'Warehouse': '🏭 Depo / Ambar',
                      'Depo': '🏭 Depo / Ambar',
                      'SaleOrder': '🛍️ Satış Siparişi',
                      'SatisSiparisi': '🛍️ Satış Siparişi',
                      'SaleQuote': '📄 Satış Teklifi',
                      'SatisTeklifi': '📄 Satış Teklifi',
                      'Customer': '👤 Müşteri Cari',
                      'MusteriHesabi': '👤 Müşteri Cari',
                      'PurchaseOrder': '💳 Satın Alma Siparişi',
                      'SatinAlmaSiparisi': '💳 Satın Alma Siparişi',
                      'PurchaseRfq': '📑 Teklif Talebi (RFQ)',
                      'SatinAlmaTeklifTalebi': '📑 Teklif Talebi (RFQ)',
                      'Supplier': '🏢 Tedarikçi Kartı',
                      'Tedarikci': '🏢 Tedarikçi Kartı',
                      'GoodsReceipt': '📥 Mal Kabul',
                      'MalKabul': '📥 Mal Kabul',
                      'ProductionOrder': '🏭 İş Emri',
                      'UretimEmri': '🏭 İş Emri',
                      'BOMItem': '🧪 Ürün Reçetesi (BOM)',
                      'UrunRecetesi': '🧪 Ürün Reçetesi (BOM)',
                      'RoutingOperation': '⚙️ Rotalama Operasyonu',
                      'RotaOperasyon': '⚙️ Rotalama Operasyonu',
                      'QualityInspection': '🔬 Kalite Muayenesi',
                      'KaliteMuayene': '🔬 Kalite Muayenesi',
                      'QualityNonConformance': '⚠️ Uygunsuzluk (NCR)',
                      'KaliteUygunsuzluk': '⚠️ Uygunsuzluk (NCR)',
                      'QualityCapa': '🛡️ Aksiyon (CAPA)',
                      'KaliteDof': '🛡️ Aksiyon (CAPA)',
                      'QualityEquipment': '📐 Ölçüm Ekipmanı',
                      'KaliteEkipmani': '📐 Ölçüm Ekipmanı',
                      'QualityDocument': '📄 Kalite Dokümanı',
                      'KaliteDokumani': '📄 Kalite Dokümanı',
                      'SystemSetting': '⚙️ Sistem Ayarı',
                      'SistemAyari': '⚙️ Sistem Ayarı'
                    };
                    const entityLabel = entityMap[entity] || entity;
                  %>
                  <span style="font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 12px; <%= actionCss %>">
                    <%= actionLabel %>
                  </span>
                  
                  <span style="background: rgba(255,255,255,0.06); color: var(--text-secondary); padding: 3px 10px; border-radius: 8px; font-size: 0.75rem; font-weight: 600;">
                    <%= entityLabel %> <%= entityId ? `#${entityId}` : '' %>
                  </span>
                </div>

                <div style="font-size: 0.76rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">
                  <%= new Date(log.createdAt).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }) %> • <%= new Date(log.createdAt).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) %>
                </div>
              </div>

            </div>
          <% }) %>
        <% } %>
      </div>

    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
