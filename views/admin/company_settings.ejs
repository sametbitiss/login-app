<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Şirket & Firma Profili Ayarları — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
  <style>
    .company-tabs-nav {
      display: flex;
      gap: 10px;
      border-bottom: 2px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 1.75rem;
      overflow-x: auto;
    }

    .comp-tab-btn {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border);
      border-bottom: none;
      border-radius: 12px 12px 0 0;
      color: var(--text-muted);
      padding: 14px 22px;
      font-size: 0.875rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.25s ease;
      white-space: nowrap;
    }

    .comp-tab-btn:hover {
      color: #fff;
      background: rgba(30, 41, 59, 0.8);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .comp-tab-btn.active {
      color: #818cf8;
      background: rgba(30, 41, 59, 0.95);
      border-color: rgba(99, 102, 241, 0.5);
      box-shadow: 0 -4px 15px rgba(99, 102, 241, 0.2);
      border-bottom: 2px solid #6366f1;
      margin-bottom: -2px;
    }

    .comp-tab-panel {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .comp-tab-panel.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">📊 KONTROL PANELİ & ANALİTİK</div>
      <div class="mss-sub">
        <a href="/admin" class="mss-sub-link">📊 Yönetim Özeti</a>
      </div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/company-settings" class="mss-sub-link active">🏢 Şirket & Firma Profili</a>
        <a href="/admin/logs" class="mss-sub-link">📜 İşlem Günlüğü (Audit Log)</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <h1 class="mt-title">🏢 Şirket & Firma Profili Ayarları</h1>
        <p class="mt-subtitle">Teklifler, faturalar ve resmi belgelerde basılacak kurumsal şirket bilgilerinizi yönetin.</p>
      </div>
      <div class="mt-right">
        <span id="liveTime" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--text-muted);"></span>
      </div>
    </header>

    <main class="module-content">
      <% if (success) { %>
        <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #10b981; padding: 1rem 1.25rem; border-radius: 12px; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;">
          <span>✓</span> <%= success %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); color: #f43f5e; padding: 1rem 1.25rem; border-radius: 12px; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= error %>
        </div>
      <% } %>

      <!-- TABBED SYSTEM CONTAINER -->
      <div class="card" style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(16px); border: 1px solid var(--border); border-radius: 16px; padding: 2rem;">
        
        <!-- Tab Navigation Buttons -->
        <div class="company-tabs-nav">
          <button type="button" class="comp-tab-btn active" onclick="switchCompanyTab('comp-tab-1', this)">
            <span>📜</span> 1. Kurumsal Kimlik & Unvan
          </button>
          <button type="button" class="comp-tab-btn" onclick="switchCompanyTab('comp-tab-2', this)">
            <span>🏛️</span> 2. Vergi & Sicil Numaraları
          </button>
          <button type="button" class="comp-tab-btn" onclick="switchCompanyTab('comp-tab-3', this)">
            <span>📍</span> 3. İletişim & Adres Bilgileri
          </button>
          <button type="button" class="comp-tab-btn" onclick="switchCompanyTab('comp-tab-4', this)">
            <span>🏦</span> 4. Banka & Teklif Dipnotları
          </button>
        </div>

        <form action="/admin/company-settings" method="POST" id="companySettingsForm">

          <!-- TAB CONTENT 1: KURUMSAL KİMLİK VE UNVAN -->
          <div class="comp-tab-panel active" id="comp-tab-1">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #818cf8; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
              <span>📜</span> Kurumsal Kimlik & Ticari Unvan Bilgileri
            </h3>
            
            <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
              <div class="input-group">
                <label for="unvan">Resmi Şirket Unvanı <span class="req-star">*</span></label>
                <input type="text" id="unvan" name="unvan" value="<%= profile.unvan || '' %>" required placeholder="Örn: ENTERPRISE ERP YAZILIM VE SANAYİ A.Ş.">
              </div>
              <div class="input-group">
                <label for="markaAdi">Marka / Kısa Ad</label>
                <input type="text" id="markaAdi" name="markaAdi" value="<%= profile.markaAdi || '' %>" placeholder="Örn: ENTERPRISE ERP">
              </div>
            </div>

            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="webSitesi">Kurumsal Web Sitesi</label>
              <input type="text" id="webSitesi" name="webSitesi" value="<%= profile.webSitesi || '' %>" placeholder="Örn: www.enterprise-erp.com.tr">
            </div>
          </div>

          <!-- TAB CONTENT 2: VERGİ VE SİCİL NUMARALARI -->
          <div class="comp-tab-panel" id="comp-tab-2">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #38bdf8; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
              <span>🏛️</span> Vergi Dairesi & Resmi Sicil Numaraları
            </h3>

            <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
              <div class="input-group">
                <label for="vergiDairesi">Vergi Dairesi</label>
                <input type="text" id="vergiDairesi" name="vergiDairesi" value="<%= profile.vergiDairesi || '' %>" placeholder="Örn: Nilüfer Vergi Dairesi">
              </div>
              <div class="input-group">
                <label for="vergiNo">Vergi Numarası</label>
                <input type="text" id="vergiNo" name="vergiNo" value="<%= profile.vergiNo || '' %>" placeholder="10 Haneli Vergi No" style="font-family: 'JetBrains Mono', monospace;">
              </div>
            </div>

            <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
              <div class="input-group">
                <label for="mersisNo">Mersis Numarası</label>
                <input type="text" id="mersisNo" name="mersisNo" value="<%= profile.mersisNo || '' %>" placeholder="16 Haneli Mersis No" style="font-family: 'JetBrains Mono', monospace;">
              </div>
              <div class="input-group">
                <label for="ticaretSicilNo">Ticaret Sicil No</label>
                <input type="text" id="ticaretSicilNo" name="ticaretSicilNo" value="<%= profile.ticaretSicilNo || '' %>" placeholder="Ticaret Sicil No" style="font-family: 'JetBrains Mono', monospace;">
              </div>
            </div>
          </div>

          <!-- TAB CONTENT 3: İLETİŞİM VE ADRES BİLGİLERİ -->
          <div class="comp-tab-panel" id="comp-tab-3">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #34d399; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
              <span>📍</span> Kurumsal İletişim & Şirket Adresi
            </h3>

            <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
              <div class="input-group">
                <label for="telefon">Telefon Numarası</label>
                <input type="text" id="telefon" name="telefon" value="<%= profile.telefon || '' %>" placeholder="Örn: +90 (224) 444 0 377" style="font-family: 'JetBrains Mono', monospace;">
              </div>
              <div class="input-group">
                <label for="eposta">Kurumsal E-Posta Adresi</label>
                <input type="email" id="eposta" name="eposta" value="<%= profile.eposta || '' %>" placeholder="Örn: satis@enterprise-erp.com.tr">
              </div>
            </div>

            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="adres">Açık Şirket Adresi</label>
              <textarea id="adres" name="adres" rows="4" placeholder="Tekliflerin üst bilgisinde görünecek resmi şirket adresi..."><%= profile.adres || '' %></textarea>
            </div>
          </div>

          <!-- TAB CONTENT 4: BANKA VE TEKLİF DİPNOTLARI -->
          <div class="comp-tab-panel" id="comp-tab-4">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #fbbf24; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
              <span>🏦</span> Kurumsal Banka & Teklif Dipnotları
            </h3>

            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="bankaBilgileri">Banka & IBAN Hesap Bilgileri <small style="color: var(--text-muted);">(Teklif notlarında veya alt bilgide görüntülenir)</small></label>
              <textarea id="bankaBilgileri" name="bankaBilgileri" rows="3" placeholder="Örn: Garanti BBVA TR12 0006 2000 0000 1234 5678 90 (TL / USD / EUR)" style="font-family: 'JetBrains Mono', monospace;"><%= profile.bankaBilgileri || '' %></textarea>
            </div>

            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="notlar">Şirket Genel Notları & Varsayılan Şartlar</label>
              <textarea id="notlar" name="notlar" rows="3" placeholder="Tekliflerde veya belgelerde otomatik dipnot olarak eklemek istediğiniz genel şartlar..."><%= profile.notlar || '' %></textarea>
            </div>
          </div>

          <!-- Global Form Submit Action Bar -->
          <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1.5rem; margin-top: 1rem;">
            <div style="font-size: 0.8rem; color: var(--text-muted);">
              💡 Değişiklik yaptıktan sonra kaydet butonuna basarak veritabanında güncelleyebilirsiniz.
            </div>
            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border: none; font-weight: 700; padding: 12px 28px; border-radius: 10px; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);">
              💾 Şirket Bilgilerini Kaydet
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function switchCompanyTab(tabId, btnEl) {
      document.querySelectorAll('.comp-tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.comp-tab-btn').forEach(b => b.classList.remove('active'));

      const targetPanel = document.getElementById(tabId);
      if (targetPanel) targetPanel.classList.add('active');
      if (btnEl) btnEl.classList.add('active');
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
