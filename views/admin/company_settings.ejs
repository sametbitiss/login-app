<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Şirket & Firma Profili Ayarları — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
  <style>
    .company-tabs-nav {
      display: flex;
      gap: 10px;
      border-bottom: 2px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 1.75rem;
      overflow-x: auto;
    }

    .comp-tab-btn {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border);
      border-bottom: none;
      border-radius: 12px 12px 0 0;
      color: var(--text-muted);
      padding: 14px 22px;
      font-size: 0.875rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.25s ease;
      white-space: nowrap;
    }

    .comp-tab-btn:hover {
      color: #fff;
      background: rgba(30, 41, 59, 0.8);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .comp-tab-btn.active {
      color: #818cf8;
      background: rgba(30, 41, 59, 0.95);
      border-color: rgba(99, 102, 241, 0.5);
      box-shadow: 0 -4px 15px rgba(99, 102, 241, 0.2);
      border-bottom: 2px solid #6366f1;
      margin-bottom: -2px;
    }

    .comp-tab-panel {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .comp-tab-panel.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .field-hint {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 4px;
      display: block;
    }

    .inline-error-msg {
      font-size: 0.8rem;
      color: #f43f5e;
      font-weight: 600;
      margin-top: 5px;
      display: none;
      align-items: center;
      gap: 5px;
    }

    .input-group.has-error input {
      border-color: #f43f5e !important;
      box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.2) !important;
    }

    .input-group.has-error .inline-error-msg {
      display: flex;
    }

    .invalid-input {
      border-color: #f43f5e !important;
      color: #f43f5e !important;
    }
  </style>
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">📊 KONTROL PANELİ & ANALİTİK</div>
      <div class="mss-sub">
        <a href="/admin" class="mss-sub-link">📊 Yönetim Özeti</a>
      </div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/company-settings" class="mss-sub-link active">🏢 Şirket & Firma Profili</a>
        <a href="/admin/logs" class="mss-sub-link">📜 İşlem Günlüğü (Audit Log)</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <h1 class="mt-title">🏢 Şirket & Firma Profili Ayarları</h1>
        <p class="mt-subtitle">Teklifler, faturalar ve resmi belgelerde basılacak kurumsal şirket bilgilerinizi yönetin.</p>
      </div>
      <div class="mt-right">
        <span id="liveTime" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--text-muted);"></span>
      </div>
    </header>

    <main class="module-content">
      <% if (success) { %>
        <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #10b981; padding: 1rem 1.25rem; border-radius: 12px; font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;">
          <span>✓</span> <%= success %>
        </div>
      <% } %>

      <div id="validationAlert" style="display: none; background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); color: #f43f5e; padding: 1rem 1.25rem; border-radius: 12px; font-weight: 600; margin-bottom: 1.5rem; align-items: center; gap: 10px;">
        <span>⚠️</span> <span id="validationErrorText"><%= error || '' %></span>
      </div>

      <% if (error) { %>
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const el = document.getElementById('validationAlert');
            if (el) el.style.display = 'flex';
          });
        </script>
      <% } %>

      <!-- TABBED SYSTEM CONTAINER -->
      <div class="card" style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(16px); border: 1px solid var(--border); border-radius: 16px; padding: 2rem;">
        
        <!-- Tab Navigation Buttons -->
        <div class="company-tabs-nav">
          <button type="button" class="comp-tab-btn active" id="btn-tab-1" onclick="switchCompanyTab('comp-tab-1', this)">
            <span>📜</span> 1. Kurumsal Kimlik & Unvan
          </button>
          <button type="button" class="comp-tab-btn" id="btn-tab-2" onclick="switchCompanyTab('comp-tab-2', this)">
            <span>🏛️</span> 2. Vergi & Sicil Numaraları
          </button>
          <button type="button" class="comp-tab-btn" id="btn-tab-3" onclick="switchCompanyTab('comp-tab-3', this)">
            <span>📍</span> 3. İletişim & Adres Bilgileri
          </button>
          <button type="button" class="comp-tab-btn" id="btn-tab-4" onclick="switchCompanyTab('comp-tab-4', this)">
            <span>🏦</span> 4. Banka & Teklif Dipnotları
          </button>
        </div>

        <form action="/admin/company-settings" method="POST" id="companySettingsForm" novalidate>

          <!-- TAB CONTENT 1: KURUMSAL KİMLİK VE UNVAN -->
          <div class="comp-tab-panel active" id="comp-tab-1">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #818cf8; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
              <span>📜</span> Kurumsal Kimlik & Ticari Unvan Bilgileri
            </h3>
            
            <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
              <div class="input-group">
                <label for="unvan">Resmi Şirket Unvanı <span class="req-star">*</span></label>
                <input type="text" id="unvan" name="unvan" value="<%= profile.unvan || '' %>" required minlength="3" placeholder="Örn: ENTERPRISE ERP YAZILIM VE SANAYİ A.Ş.">
                <span class="field-hint">En az 3 karakter olmalıdır.</span>
                <span class="inline-error-msg" id="err-unvan"></span>
              </div>
              <div class="input-group">
                <label for="markaAdi">Marka / Kısa Ad</label>
                <input type="text" id="markaAdi" name="markaAdi" value="<%= profile.markaAdi || '' %>" placeholder="Örn: ENTERPRISE ERP">
              </div>
            </div>

            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="webSitesi">Kurumsal Web Sitesi</label>
              <input type="text" id="webSitesi" name="webSitesi" value="<%= profile.webSitesi || '' %>" placeholder="Örn: www.enterprise-erp.com.tr veya enterprise-erp.com">
              <span class="field-hint">Geçerli bir web sitesi veya domain adresi giriniz.</span>
              <span class="inline-error-msg" id="err-webSitesi"></span>
            </div>
          </div>

          <!-- TAB CONTENT 2: VERGİ VE SİCİL NUMARALARI -->
          <div class="comp-tab-panel" id="comp-tab-2">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #38bdf8; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
              <span>🏛️</span> Vergi Dairesi & Resmi Sicil Numaraları
            </h3>

            <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
              <div class="input-group">
                <label for="vergiDairesi">Vergi Dairesi</label>
                <input type="text" id="vergiDairesi" name="vergiDairesi" value="<%= profile.vergiDairesi || '' %>" placeholder="Örn: Nilüfer Vergi Dairesi">
              </div>
              <div class="input-group">
                <label for="vergiNo">Vergi Numarası <small style="color: var(--text-muted);">(Sadece Rakam)</small></label>
                <input type="text" id="vergiNo" name="vergiNo" value="<%= profile.vergiNo || '' %>" maxlength="10" oninput="this.value = this.value.replace(/\D/g, '')" placeholder="10 Haneli Vergi No (Örn: 1234567890)" style="font-family: 'JetBrains Mono', monospace;">
                <span class="field-hint">Sadece 10 haneli rakam girilebilir.</span>
                <span class="inline-error-msg" id="err-vergiNo"></span>
              </div>
            </div>

            <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
              <div class="input-group">
                <label for="mersisNo">Mersis Numarası <small style="color: var(--text-muted);">(Sadece Rakam)</small></label>
                <input type="text" id="mersisNo" name="mersisNo" value="<%= profile.mersisNo || '' %>" maxlength="16" oninput="this.value = this.value.replace(/\D/g, '')" placeholder="16 Haneli Mersis No (Örn: 0123456789000015)" style="font-family: 'JetBrains Mono', monospace;">
                <span class="field-hint">Sadece 16 haneli rakam girilebilir.</span>
                <span class="inline-error-msg" id="err-mersisNo"></span>
              </div>
              <div class="input-group">
                <label for="ticaretSicilNo">Ticaret Sicil No <small style="color: var(--text-muted);">(Sadece Rakam)</small></label>
                <input type="text" id="ticaretSicilNo" name="ticaretSicilNo" value="<%= profile.ticaretSicilNo || '' %>" maxlength="12" oninput="this.value = this.value.replace(/\D/g, '')" placeholder="Sicil No (Sadece Rakam: 123456)" style="font-family: 'JetBrains Mono', monospace;">
                <span class="field-hint">Sadece 4 ile 12 haneli rakam girilebilir.</span>
                <span class="inline-error-msg" id="err-ticaretSicilNo"></span>
              </div>
            </div>
          </div>

          <!-- TAB CONTENT 3: İLETİŞİM VE ADRES BİLGİLERİ -->
          <div class="comp-tab-panel" id="comp-tab-3">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #34d399; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
              <span>📍</span> Kurumsal İletişim & Şirket Adresi
            </h3>

            <div class="form-grid form-grid--2" style="margin-bottom: 1.5rem;">
              <div class="input-group">
                <label for="telefon">Telefon Numarası <small style="color: var(--text-muted);">(Kesinlikle Sadece Rakam)</small></label>
                <input type="text" id="telefon" name="telefon" value="<%= profile.telefon || '' %>" maxlength="11" oninput="this.value = this.value.replace(/\D/g, '')" placeholder="Örn: 02244440377 veya 4440377 (Sadece Rakam)" style="font-family: 'JetBrains Mono', monospace;">
                <span class="field-hint">Sadece rakam girilebilir (7-11 haneli. Örn: 02244440377 veya 4440377).</span>
                <span class="inline-error-msg" id="err-telefon"></span>
              </div>
              <div class="input-group">
                <label for="eposta">Kurumsal E-Posta Adresi</label>
                <input type="email" id="eposta" name="eposta" value="<%= profile.eposta || '' %>" placeholder="Örn: satis@enterprise-erp.com.tr">
                <span class="field-hint">Geçerli ve eksiksiz e-posta formatı (satis@domain.com).</span>
                <span class="inline-error-msg" id="err-eposta"></span>
              </div>
            </div>

            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="adres">Açık Şirket Adresi</label>
              <textarea id="adres" name="adres" rows="4" placeholder="Tekliflerin üst bilgisinde görünecek resmi şirket adresi..."><%= profile.adres || '' %></textarea>
            </div>
          </div>

          <!-- TAB CONTENT 4: BANKA VE TEKLİF DİPNOTLARI -->
          <div class="comp-tab-panel" id="comp-tab-4">
            <h3 style="font-size: 1.05rem; font-weight: 800; color: #fbbf24; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
              <span>🏦</span> Kurumsal Banka & Teklif Dipnotları
            </h3>

            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="bankaBilgileri">Banka & IBAN Hesap Bilgileri <small style="color: var(--text-muted);">(Teklif notlarında veya alt bilgide görüntülenir)</small></label>
              <textarea id="bankaBilgileri" name="bankaBilgileri" rows="3" placeholder="Örn: Garanti BBVA TR12 0006 2000 0000 1234 5678 90 (TL / USD / EUR)" style="font-family: 'JetBrains Mono', monospace;"><%= profile.bankaBilgileri || '' %></textarea>
            </div>

            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="notlar">Şirket Genel Notları & Varsayılan Şartlar</label>
              <textarea id="notlar" name="notlar" rows="3" placeholder="Tekliflerde veya belgelerde otomatik dipnot olarak eklemek istediğiniz genel şartlar..."><%= profile.notlar || '' %></textarea>
            </div>
          </div>

          <!-- Global Form Submit Action Bar -->
          <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1.5rem; margin-top: 1rem;">
            <div style="font-size: 0.8rem; color: var(--text-muted);">
              💡 Değişiklik yaptıktan sonra kaydet butonuna basarak veritabanında güncelleyebilirsiniz.
            </div>
            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border: none; font-weight: 700; padding: 12px 28px; border-radius: 10px; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);">
              💾 Şirket Bilgilerini Kaydet
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function switchCompanyTab(tabId, btnEl) {
      document.querySelectorAll('.comp-tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.comp-tab-btn').forEach(b => b.classList.remove('active'));

      const targetPanel = document.getElementById(tabId);
      if (targetPanel) targetPanel.classList.add('active');
      if (btnEl) btnEl.classList.add('active');
    }

    // Individual Field Real-Time Live Validation Functions
    function validateField(id, errId, checkFn, errorMsg, isRequired = false) {
      const inputEl = document.getElementById(id);
      const errEl = document.getElementById(errId);
      if (!inputEl || !errEl) return true;

      const group = inputEl.closest('.input-group');
      const val = inputEl.value.trim();

      if (val === '') {
        if (isRequired) {
          errEl.textContent = `❌ ${errorMsg}`;
          group.classList.add('has-error');
          return false;
        } else {
          errEl.textContent = '';
          group.classList.remove('has-error');
          return true;
        }
      }

      if (!checkFn(val)) {
        errEl.textContent = `❌ ${errorMsg}`;
        group.classList.add('has-error');
        return false;
      }

      errEl.textContent = '';
      group.classList.remove('has-error');
      return true;
    }

    // Field Rules Definition
    const corporateEmailRegex = /^(?!\.)(?!.*\.\.)[a-zA-Z0-9._%+-]{2,64}@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,10}$/;
    const domainRegex = /^(https?:\/\/)?(www\.)?[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)+(\/.*)?$/;

    // Attach Real-Time Blur and Input Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      const epostaEl = document.getElementById('eposta');
      if (epostaEl) {
        epostaEl.addEventListener('blur', () => {
          validateField('eposta', 'err-eposta', v => corporateEmailRegex.test(v), 'Lütfen geçerli ve eksiksiz bir e-posta adresi giriniz (Örn: satis@enterprise-erp.com.tr).', false);
        });
        epostaEl.addEventListener('input', () => {
          if (epostaEl.closest('.input-group').classList.contains('has-error') || epostaEl.value.trim() !== '') {
            validateField('eposta', 'err-eposta', v => corporateEmailRegex.test(v), 'Lütfen geçerli ve eksiksiz bir e-posta adresi giriniz (Örn: satis@enterprise-erp.com.tr).', false);
          }
        });
      }

      const webEl = document.getElementById('webSitesi');
      if (webEl) {
        webEl.addEventListener('blur', () => {
          validateField('webSitesi', 'err-webSitesi', v => domainRegex.test(v), 'Geçerli bir web sitesi giriniz (Örn: www.enterprise-erp.com.tr).', false);
        });
        webEl.addEventListener('input', () => {
          if (webEl.closest('.input-group').classList.contains('has-error')) {
            validateField('webSitesi', 'err-webSitesi', v => domainRegex.test(v), 'Geçerli bir web sitesi giriniz (Örn: www.enterprise-erp.com.tr).', false);
          }
        });
      }

      const telEl = document.getElementById('telefon');
      if (telEl) {
        telEl.addEventListener('blur', () => {
          validateField('telefon', 'err-telefon', v => /^\d{7,11}$/.test(v), 'Telefon 7-11 haneli sadece rakam olmalıdır (Örn: 02244440377).', false);
        });
        telEl.addEventListener('input', () => {
          if (telEl.closest('.input-group').classList.contains('has-error')) {
            validateField('telefon', 'err-telefon', v => /^\d{7,11}$/.test(v), 'Telefon 7-11 haneli sadece rakam olmalıdır (Örn: 02244440377).', false);
          }
        });
      }

      const vNoEl = document.getElementById('vergiNo');
      if (vNoEl) {
        vNoEl.addEventListener('blur', () => {
          validateField('vergiNo', 'err-vergiNo', v => /^\d{10}$/.test(v), 'Vergi Numarası tam 10 haneli rakam olmalıdır.', false);
        });
        vNoEl.addEventListener('input', () => {
          if (vNoEl.closest('.input-group').classList.contains('has-error')) {
            validateField('vergiNo', 'err-vergiNo', v => /^\d{10}$/.test(v), 'Vergi Numarası tam 10 haneli rakam olmalıdır.', false);
          }
        });
      }

      const mersisEl = document.getElementById('mersisNo');
      if (mersisEl) {
        mersisEl.addEventListener('blur', () => {
          validateField('mersisNo', 'err-mersisNo', v => /^\d{16}$/.test(v), 'Mersis Numarası tam 16 haneli rakam olmalıdır.', false);
        });
        mersisEl.addEventListener('input', () => {
          if (mersisEl.closest('.input-group').classList.contains('has-error')) {
            validateField('mersisNo', 'err-mersisNo', v => /^\d{16}$/.test(v), 'Mersis Numarası tam 16 haneli rakam olmalıdır.', false);
          }
        });
      }

      const sicilEl = document.getElementById('ticaretSicilNo');
      if (sicilEl) {
        sicilEl.addEventListener('blur', () => {
          validateField('ticaretSicilNo', 'err-ticaretSicilNo', v => /^\d{4,12}$/.test(v), 'Ticaret Sicil No 4-12 haneli rakam olmalıdır.', false);
        });
        sicilEl.addEventListener('input', () => {
          if (sicilEl.closest('.input-group').classList.contains('has-error')) {
            validateField('ticaretSicilNo', 'err-ticaretSicilNo', v => /^\d{4,12}$/.test(v), 'Ticaret Sicil No 4-12 haneli rakam olmalıdır.', false);
          }
        });
      }

      const unvanEl = document.getElementById('unvan');
      if (unvanEl) {
        unvanEl.addEventListener('blur', () => {
          validateField('unvan', 'err-unvan', v => v.length >= 3, 'Resmi Şirket Unvanı en az 3 karakter olmalıdır.', true);
        });
        unvanEl.addEventListener('input', () => {
          if (unvanEl.closest('.input-group').classList.contains('has-error')) {
            validateField('unvan', 'err-unvan', v => v.length >= 3, 'Resmi Şirket Unvanı en az 3 karakter olmalıdır.', true);
          }
        });
      }
    });

    // Form Submission Validation Guard
    document.getElementById('companySettingsForm').addEventListener('submit', function (e) {
      const isUnvanValid = validateField('unvan', 'err-unvan', v => v.length >= 3, 'Resmi Şirket Unvanı zorunludur ve en az 3 karakter olmalıdır.', true);
      const isWebValid = validateField('webSitesi', 'err-webSitesi', v => domainRegex.test(v), 'Geçerli bir web sitesi veya domain adresi olmalıdır.', false);
      const isVergiValid = validateField('vergiNo', 'err-vergiNo', v => /^\d{10}$/.test(v), 'Vergi Numarası tam 10 haneli rakam olmalıdır.', false);
      const isMersisValid = validateField('mersisNo', 'err-mersisNo', v => /^\d{16}$/.test(v), 'Mersis Numarası tam 16 haneli rakam olmalıdır.', false);
      const isSicilValid = validateField('ticaretSicilNo', 'err-ticaretSicilNo', v => /^\d{4,12}$/.test(v), 'Ticaret Sicil Numarası 4-12 haneli rakam olmalıdır.', false);
      const isTelValid = validateField('telefon', 'err-telefon', v => /^\d{7,11}$/.test(v), 'Telefon 7-11 haneli sadece rakam olmalıdır.', false);
      const isEmailValid = validateField('eposta', 'err-eposta', v => corporateEmailRegex.test(v), 'Lütfen geçerli ve eksiksiz bir e-posta adresi giriniz.', false);

      if (!isUnvanValid || !isWebValid || !isVergiValid || !isMersisValid || !isSicilValid || !isTelValid || !isEmailValid) {
        e.preventDefault();
        
        let targetTabId = 'comp-tab-1';
        if (!isUnvanValid || !isWebValid) targetTabId = 'comp-tab-1';
        else if (!isVergiValid || !isMersisValid || !isSicilValid) targetTabId = 'comp-tab-2';
        else if (!isTelValid || !isEmailValid) targetTabId = 'comp-tab-3';

        const tabBtnId = targetTabId.replace('comp-tab-', 'btn-tab-');
        switchCompanyTab(targetTabId, document.getElementById(tabBtnId));
      }
    });

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
