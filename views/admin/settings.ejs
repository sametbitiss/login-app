<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistem Ayarları — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">📊 KONTROL PANELİ & ANALİTİK</div>
      <div class="mss-sub">
        <a href="/admin" class="mss-sub-link">📊 Yönetim Özeti</a>
      </div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/settings" class="mss-sub-link active">⚙️ Sistem Parametreleri</a>
        <a href="/admin/logs" class="mss-sub-link">📜 İşlem Günlüğü (Audit Log)</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link active">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Kurumsal Sistem Ayarları & Parametreler</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Kurum geneli güvenlik, oturum ve uygulama çalışma parametrelerini yönetin.</p>
        </div>
      </div>

      <% if (successMessage) { %>
        <div style="padding: 14px 20px; background: rgba(16, 185, 129, 0.12); border: 1px solid var(--emerald); color: var(--emerald); border-radius: var(--radius-md); font-weight: 600; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
          <%= successMessage %>
        </div>
      <% } %>

      <form action="/admin/settings" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;">

        <!-- Group 1: General & Corporate -->
        <div class="form-panel">
          <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 1rem; display: flex; align-items: center; gap: 8px;">
            🏢 Kurumsal & Genel Uygulama Ayarları
          </h3>
          
          <div class="form-grid form-grid--2">
            <% 
              const labelMap = {
                'company_name': 'Firma / Kurum Ticari Ünvanı',
                'system_title': 'Uygulama Sistem Başlığı',
                'maintenance_mode': 'Bakım Modu Durumu',
                'session_timeout_hours': 'Kullanıcı Oturum Zaman Aşımı (Saat)',
                'min_password_length': 'Minimum Parola Uzunluğu (Karakter)',
                'max_login_attempts': 'Maksimum Hatalı Giriş Denemesi',
                'audit_log_retention_days': 'İşlem Günlüğü (Audit Log) Saklama Süresi (Gün)'
              };

              settings.forEach(s => { 
                const sKey = s.anahtar || s.key;
                const sVal = s.deger !== undefined ? s.deger : s.value;
                const sDesc = s.aciklama || s.description || labelMap[sKey] || sKey;
                const sCat = s.kategori || s.category || 'General';
            %>
              <div class="input-group">
                <label for="<%= sKey %>">
                  <%= labelMap[sKey] || sDesc %>
                  <span style="font-size: 0.72rem; color: var(--indigo); margin-left: 6px; font-weight: 500;">[<%= sKey %>]</span>
                </label>

                <% if (sKey === 'maintenance_mode') { %>
                  <select id="<%= sKey %>" name="<%= sKey %>" style="width: 100%; padding: 10px 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; color: var(--text-main); font-weight: 600;">
                    <option value="false" <%= String(sVal) === 'false' ? 'selected' : '' %>>🟢 Devre Dışı (Normal Çalışma Modu)</option>
                    <option value="true" <%= String(sVal) === 'true' ? 'selected' : '' %>>🔴 Aktif (Bakım Modu - Yalnızca Admin Girişi)</option>
                  </select>
                <% } else if (['session_timeout_hours', 'min_password_length', 'max_login_attempts', 'audit_log_retention_days'].includes(sKey)) { %>
                  <input type="number" id="<%= sKey %>" name="<%= sKey %>" value="<%= sVal %>" required style="width: 100%; padding: 10px 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; color: var(--text-main); font-family: 'JetBrains Mono', monospace; font-weight: 600;">
                <% } else { %>
                  <input type="text" id="<%= sKey %>" name="<%= sKey %>" value="<%= sVal %>" required style="width: 100%; padding: 10px 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; color: var(--text-main); font-weight: 600;">
                <% } %>
                <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px; display: block;"><%= sDesc %></span>
              </div>
            <% }); %>
          </div>
        </div>

        <div style="display: flex; gap: 12px; align-items: center;">
          <button type="submit" class="btn btn-lg" style="padding: 12px 28px; font-weight: 700;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
            Sistem Parametrelerini Kaydet
          </button>
          <a href="/admin" class="btn btn-secondary btn-lg">İptal</a>
        </div>

      </form>

    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
