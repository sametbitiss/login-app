<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rol ve Yetki Matrisi Yönetimi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* UX Control Toolbar */
    .matrix-toolbar {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px 20px;
      margin-bottom: 24px;
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      justify-content: space-between;
      box-shadow: var(--shadow-sm);
    }
    .mt-search {
      flex: 1;
      min-width: 280px;
      position: relative;
    }
    .mt-search input {
      width: 100%;
      background: #090e1a;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 14px 10px 38px;
      color: var(--text-primary);
      font-size: 0.88rem;
      outline: none;
      transition: all 0.2s ease;
    }
    .mt-search input:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    }
    .mt-search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
    }

    .view-switcher {
      display: flex;
      background: #090e1a;
      padding: 4px;
      border-radius: 10px;
      border: 1px solid var(--border);
    }
    .vs-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      padding: 8px 16px;
      font-size: 0.82rem;
      font-weight: 700;
      border-radius: 7px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .vs-btn.active {
      background: #6366f1;
      color: #ffffff;
      box-shadow: 0 2px 10px rgba(99, 102, 241, 0.4);
    }

    /* Role Quick Cards Strip */
    .role-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      margin-bottom: 24px;
    }
    .role-quick-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
    }
    .role-quick-card:hover, .role-quick-card.selected {
      border-color: #6366f1;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.2);
    }
    .rqc-name { font-size: 0.88rem; font-weight: 800; color: var(--text-primary); }
    .rqc-key { font-size: 0.72rem; color: #818cf8; font-family: 'JetBrains Mono', monospace; margin-top: 2px; }
    .rqc-count { font-size: 0.78rem; font-weight: 700; color: #34d399; margin-top: 6px; }

    /* Matrix Table Design */
    .matrix-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 24px;
      box-shadow: var(--shadow-md);
      margin-bottom: 30px;
    }
    .matrix-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }

    .matrix-table-wrapper {
      overflow-x: auto;
      max-height: 680px;
      position: relative;
      border-radius: 12px;
      border: 1px solid var(--border);
    }

    .matrix-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }
    .matrix-table th {
      position: sticky;
      top: 0;
      z-index: 12;
      background: #0b1120;
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--text-primary);
      padding: 14px 10px;
      text-align: center;
      border-bottom: 2px solid var(--border);
    }
    .matrix-table th:first-child {
      text-align: left;
      padding-left: 20px;
      min-width: 320px;
      z-index: 13;
    }
    .matrix-table td {
      padding: 12px 10px;
      font-size: 0.84rem;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      vertical-align: middle;
      text-align: center;
      transition: background 0.15s ease;
    }
    .matrix-table td:first-child {
      text-align: left;
      padding-left: 20px;
    }

    /* Column & Row Highlight */
    .matrix-table tr:hover td {
      background: rgba(99, 102, 241, 0.08) !important;
    }
    .matrix-table td.col-hover {
      background: rgba(99, 102, 241, 0.05);
    }

    .module-heading-row td {
      background: #111827 !important;
      font-size: 0.92rem;
      font-weight: 800;
      color: #a78bfa;
      padding: 12px 20px;
      border-top: 2px solid var(--border);
      position: sticky;
      z-index: 5;
    }

    /* Toggle Switch */
    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 42px;
      height: 24px;
    }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: #334155;
      transition: .2s ease;
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 18px; width: 18px;
      left: 2px; bottom: 2px;
      background-color: white;
      transition: .2s ease;
      border-radius: 50%;
    }
    input:checked + .toggle-slider {
      background-color: #10b981;
      border-color: #10b981;
    }
    input:checked + .toggle-slider:before {
      transform: translateX(18px);
    }

    /* Role Detailed View Cards */
    .role-detail-cards {
      display: none;
    }
    .rd-role-picker {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 12px;
      margin-bottom: 24px;
    }
    .rd-role-tab {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 18px;
      font-weight: 700;
      font-size: 0.88rem;
      color: var(--text-secondary);
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .rd-role-tab.active {
      background: #6366f1;
      color: #ffffff;
      border-color: #6366f1;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    }

    .rd-module-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .rd-module-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #a78bfa;
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
    }
    .rd-perm-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      border-radius: 10px;
      background: #090e1a;
      border: 1px solid rgba(255,255,255,0.04);
      margin-bottom: 8px;
    }
    .rd-perm-item:hover {
      border-color: rgba(99, 102, 241, 0.3);
    }

    .btn-indigo-gradient {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff;
      font-weight: 800;
      font-size: 0.95rem;
      padding: 12px 28px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-indigo-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(99, 102, 241, 0.55);
    }

    .btn-secondary {
      background: #1e293b;
      color: #cbd5e1;
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-secondary:hover {
      background: #334155;
      color: #fff;
    }
  </style>
</head>
<body class="module-body">
  <!-- Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link active">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/settings" class="mss-sub-link">⚙️ Sistem Parametreleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link active">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/admin/users" class="msn-link">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="msn-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="msn-link active">🔐 Rol & Yetki Matrisi</a>
        <a href="/admin/settings" class="msn-link">⚙️ Sistem Ayarları</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Rol ve Erişim Yetki Matrisi</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Sistem rollerinin hangi modüllere, ekranlara ve yönetsel kartlara erişebileceğini yapılandırın.</p>
        </div>
      </div>

      <% if (successMessage) { %>
        <div style="background: rgba(16,185,129,0.15); color: #34d399; border: 1px solid rgba(16,185,129,0.3); padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
          <span>✅</span> <%= successMessage %>
        </div>
      <% } %>

      <!-- Role Summary Quick Cards -->
      <div class="role-cards-grid">
        <% roleKeys.forEach(r => { %>
          <% const rolePerms = matrix[r] || {}; %>
          <% const activeCount = Object.values(rolePerms).filter(Boolean).length; %>
          <div class="role-quick-card" onclick="selectRoleView('<%= r %>')">
            <div class="rqc-name"><%= ALL_ROLES[r] || r %></div>
            <div class="rqc-key"><%= r %></div>
            <div class="rqc-count">✓ <%= activeCount %> / 23 İzin Aktif</div>
          </div>
        <% }); %>
      </div>

      <!-- Control Toolbar -->
      <div class="matrix-toolbar">
        <div class="mt-search">
          <span class="mt-search-icon">🔍</span>
          <input type="text" id="matrixSearch" onkeyup="filterMatrix()" placeholder="Yetki, ekran veya açıklama ara (ör: Reçete, Fatura, Sayım)...">
        </div>

        <div class="view-switcher">
          <button type="button" class="vs-btn active" id="btnTableView" onclick="switchViewMode('table')">📊 Tablo Matrisi</button>
          <button type="button" class="vs-btn" id="btnCardView" onclick="switchViewMode('cards')">👤 Rol Detay Kartları</button>
        </div>
      </div>

      <!-- Form Wrap -->
      <form action="/admin/roles" method="POST" id="matrixForm">
        <!-- 1. TABLE MATRIX VIEW -->
        <div class="matrix-card" id="tableViewContainer">
          <div class="matrix-header">
            <div>
              <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-primary); margin: 0;">Genel Rol & İzin Matris Tablosu</h3>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">Kolon ve satır üzerine gelindiğinde ilgili rol ve yetki vurgulanır. Anahtarlarla erişimleri kolayca değiştirin.</p>
            </div>
            <button type="submit" class="btn-indigo-gradient">
              💾 Matrisi Kaydet ve Güncelle
            </button>
          </div>

          <div class="matrix-table-wrapper">
            <table class="matrix-table" id="matrixTable">
              <thead>
                <tr>
                  <th>Modül & Ekran İzni</th>
                  <% roleKeys.forEach((r, colIdx) => { %>
                    <th data-col="<%= colIdx + 1 %>">
                      <div style="font-size: 0.82rem; font-weight: 800;"><%= ALL_ROLES[r] || r %></div>
                      <div style="font-size: 0.7rem; color: #818cf8; font-weight: 600;"><%= r %></div>
                    </th>
                  <% }); %>
                </tr>
              </thead>
              <tbody>
                <% PERMISSION_MODULES.forEach(mod => { %>
                  <tr class="module-heading-row" data-mod-title="<%= mod.name.toLowerCase() %>">
                    <td colspan="<%= roleKeys.length + 1 %>">
                      <%= mod.name %>
                    </td>
                  </tr>
                  <% mod.permissions.forEach(p => { %>
                    <tr class="perm-row" data-search="<%= (p.label + ' ' + p.desc + ' ' + mod.name).toLowerCase() %>">
                      <td>
                        <div style="font-weight: 700; color: var(--text-primary);"><%= p.label %></div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= p.desc %></div>
                      </td>
                      <% roleKeys.forEach((role, colIdx) => { %>
                        <% const isAllowed = matrix[role] && matrix[role][p.key]; %>
                        <td data-col="<%= colIdx + 1 %>">
                          <label class="toggle-switch">
                            <input type="checkbox" name="perm_<%= role %>_<%= p.key %>" class="perm-check-<%= role %>" <%= isAllowed ? 'checked' : '' %>>
                            <span class="toggle-slider"></span>
                          </label>
                        </td>
                      <% }); %>
                    </tr>
                  <% }); %>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. ROLE DETAILED CARDS VIEW -->
        <div class="role-detail-cards" id="cardViewContainer">
          <div class="matrix-header" style="background: var(--bg-surface); padding: 20px; border-radius: 16px; border: 1px solid var(--border); margin-bottom: 20px;">
            <div>
              <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-primary); margin: 0;">Rol Bazlı İzin Detayları</h3>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">Seçili rol için modül izinlerini detaylı inceleyin ve tek tıkla toplu güncelleme yapın.</p>
            </div>
            <button type="submit" class="btn-indigo-gradient">
              💾 Değişiklikleri Kaydet
            </button>
          </div>

          <!-- Role Selector Tabs -->
          <div class="rd-role-picker">
            <% roleKeys.forEach((r, idx) => { %>
              <div class="rd-role-tab <%= idx === 0 ? 'active' : '' %>" id="tab_<%= r %>" onclick="activateRoleTab('<%= r %>')">
                <%= ALL_ROLES[r] || r %>
              </div>
            <% }); %>
          </div>

          <!-- Role Cards Body -->
          <% roleKeys.forEach((r, idx) => { %>
            <div class="role-card-pane" id="pane_<%= r %>" style="<%= idx === 0 ? '' : 'display: none;' %>">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h2 style="font-size: 1.2rem; font-weight: 800; color: var(--text-primary);"><%= ALL_ROLES[r] || r %> — İzin Listesi</h2>
                <div style="display: flex; gap: 10px;">
                  <button type="button" class="btn-secondary" onclick="toggleAllRolePerms('<%= r %>', true)">⚡ Tüm İzinleri Ver</button>
                  <button type="button" class="btn-secondary" onclick="toggleAllRolePerms('<%= r %>', false)">🧹 Tüm İzinleri Kaldır</button>
                </div>
              </div>

              <% PERMISSION_MODULES.forEach(mod => { %>
                <div class="rd-module-card">
                  <div class="rd-module-title">
                    <span><%= mod.name %></span>
                  </div>
                  <% mod.permissions.forEach(p => { %>
                    <% const isAllowed = matrix[r] && matrix[r][p.key]; %>
                    <div class="rd-perm-item">
                      <div>
                        <div style="font-weight: 700; color: var(--text-primary); font-size: 0.9rem;"><%= p.label %></div>
                        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;"><%= p.desc %></div>
                      </div>
                      <label class="toggle-switch">
                        <input type="checkbox" class="perm-card-check-<%= r %>" data-sync="perm_<%= r %>_<%= p.key %>" <%= isAllowed ? 'checked' : '' %> onchange="syncFromCard(this, 'perm_<%= r %>_<%= p.key %>')">
                        <span class="toggle-slider"></span>
                      </label>
                    </div>
                  <% }); %>
                </div>
              <% }); %>
            </div>
          <% }); %>
        </div>
      </form>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    // Switch View Mode
    function switchViewMode(mode) {
      const tblView = document.getElementById('tableViewContainer');
      const cardView = document.getElementById('cardViewContainer');
      const btnTbl = document.getElementById('btnTableView');
      const btnCrd = document.getElementById('btnCardView');

      if (mode === 'table') {
        tblView.style.display = 'block';
        cardView.style.display = 'none';
        btnTbl.classList.add('active');
        btnCrd.classList.remove('active');
      } else {
        tblView.style.display = 'none';
        cardView.style.display = 'block';
        btnCrd.classList.add('active');
        btnTbl.classList.remove('active');
      }
    }

    // Role Tab Selector in Card View
    function activateRoleTab(roleKey) {
      document.querySelectorAll('.rd-role-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.role-card-pane').forEach(p => p.style.display = 'none');

      const activeTab = document.getElementById('tab_' + roleKey);
      const activePane = document.getElementById('pane_' + roleKey);
      if (activeTab) activeTab.classList.add('active');
      if (activePane) activePane.style.display = 'block';
    }

    function selectRoleView(roleKey) {
      switchViewMode('cards');
      activateRoleTab(roleKey);
    }

    // Bulk Toggle
    function toggleAllRolePerms(roleKey, state) {
      const checks = document.querySelectorAll('.perm-check-' + roleKey);
      checks.forEach(c => c.checked = state);
      const cardChecks = document.querySelectorAll('.perm-card-check-' + roleKey);
      cardChecks.forEach(c => c.checked = state);
    }

    function syncFromCard(cardElem, mainInputName) {
      const mainInput = document.querySelector(`input[name="${mainInputName}"]`);
      if (mainInput) mainInput.checked = cardElem.checked;
    }

    // Matrix Search Filter
    function filterMatrix() {
      const q = document.getElementById('matrixSearch').value.toLowerCase().trim();
      const rows = document.querySelectorAll('.perm-row');
      rows.forEach(r => {
        const text = r.getAttribute('data-search') || '';
        r.style.display = text.includes(q) ? '' : 'none';
      });
    }

    // Column Hover Effect
    const table = document.getElementById('matrixTable');
    if (table) {
      table.querySelectorAll('td[data-col], th[data-col]').forEach(cell => {
        cell.addEventListener('mouseenter', () => {
          const colIdx = cell.getAttribute('data-col');
          table.querySelectorAll(`td[data-col="${colIdx}"]`).forEach(c => c.classList.add('col-hover'));
        });
        cell.addEventListener('mouseleave', () => {
          const colIdx = cell.getAttribute('data-col');
          table.querySelectorAll(`td[data-col="${colIdx}"]`).forEach(c => c.classList.remove('col-hover'));
        });
      });
    }
  </script>
</body>
</html>
