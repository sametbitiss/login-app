<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistem Yönetim Özeti — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/sidebar.js" defer></script>
  <style>
    .exec-kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 24px;
    }

    .exec-kpi-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      gap: 16px;
      position: relative;
      overflow: hidden;
      transition: all 0.25s ease;
    }

    .exec-kpi-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: rgba(99, 102, 241, 0.35);
    }

    .exec-kpi-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 3px;
    }

    .exec-kpi-card--indigo::before { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
    .exec-kpi-card--emerald::before { background: linear-gradient(90deg, #10b981, #34d399); }
    .exec-kpi-card--purple::before { background: linear-gradient(90deg, #a855f7, #c084fc); }
    .exec-kpi-card--amber::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }

    .exec-kpi-icon {
      width: 46px; height: 46px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
    }

    .exec-kpi-icon--indigo { background: rgba(99, 102, 241, 0.12); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.2); }
    .exec-kpi-icon--emerald { background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.2); }
    .exec-kpi-icon--purple { background: rgba(168, 85, 247, 0.12); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.2); }
    .exec-kpi-icon--amber { background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.2); }

    .exec-kpi-val { font-size: 1.6rem; font-weight: 900; color: var(--text-primary); line-height: 1; letter-spacing: -0.5px; }
    .exec-kpi-lbl { font-size: 0.775rem; color: var(--text-muted); font-weight: 600; margin-top: 4px; }

    .dash-charts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    .dash-chart-box {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
      box-shadow: var(--shadow-sm);
    }

    .dash-chart-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .ops-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 14px;
      margin-bottom: 28px;
    }

    .op-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px 16px;
      box-shadow: var(--shadow-sm);
      text-decoration: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: all 0.2s ease;
      position: relative;
    }

    .op-card:hover {
      transform: translateY(-3px);
      border-color: #6366f1;
      box-shadow: 0 10px 25px rgba(99, 102, 241, 0.15);
    }

    .op-card-icon {
      width: 38px; height: 38px;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem;
      background: rgba(99, 102, 241, 0.12);
      color: #818cf8;
    }

    .op-card-title { font-size: 0.9rem; font-weight: 800; color: var(--text-primary); }
    .op-card-desc { font-size: 0.775rem; color: var(--text-muted); line-height: 1.35; }

    .fancy-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
      box-shadow: var(--shadow-sm);
    }

    .fancy-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 6px;
    }

    .fancy-table th {
      font-size: 0.725rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 8px 14px;
      text-align: left;
      border: none;
    }

    .fancy-table tbody tr {
      background: var(--bg-elevated);
      border-radius: 10px;
      transition: all 0.2s ease;
    }

    .fancy-table tbody tr:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    .fancy-table td {
      padding: 12px 14px;
      font-size: 0.85rem;
      border: none;
      vertical-align: middle;
    }

    .action-badge {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 6px;
      display: inline-block;
      text-transform: uppercase;
    }

    .badge-CREATE { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.25); }
    .badge-UPDATE { background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.25); }
    .badge-DELETE { background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.25); }
    .badge-LOGIN { background: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.25); }
    .badge-OTHER { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.25); }

    @media (max-width: 1200px) {
      .exec-kpi-grid { grid-template-columns: repeat(2, 1fr); }
      .ops-grid { grid-template-columns: repeat(3, 1fr); }
      .dash-charts-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .exec-kpi-grid { grid-template-columns: 1fr; }
      .ops-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">📊 KONTROL PANELİ & ANALİTİK</div>
      <div class="mss-sub">
        <a href="/admin" class="mss-sub-link active">📊 Yönetim Özeti</a>
      </div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/settings" class="mss-sub-link">⚙️ Sistem Parametreleri</a>
        <a href="/admin/logs" class="mss-sub-link">📜 İşlem Günlüğü (Audit Log)</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link active">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="module-content">

      <!-- Hero Header -->
      <div class="page-header" style="margin-bottom: 24px;">
        <div>
          <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--text-primary);">Sistem Yönetimi & Güvenlik Özeti</h1>
          <p style="color: var(--text-secondary); font-size: 0.875rem; margin-top: 4px;">
            Kurumsal ERP kullanıcı erişim yetkileri, rol matrisleri, sistem parametreleri ve güvenlik denetim kayıtları.
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
          <% if (isMaintenance) { %>
            <span style="background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3); padding: 6px 12px; border-radius: 20px; font-size: 0.775rem; font-weight: 700;">
              ⚠️ BAKIM MODU AKTİF
            </span>
          <% } else { %>
            <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 6px 12px; border-radius: 20px; font-size: 0.775rem; font-weight: 700;">
              🟢 SİSTEM ÇALIŞIYOR (NORMAL)
            </span>
          <% } %>
          <a href="/admin/users/add" class="btn" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); border: none; color: #fff; padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 0.85rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            ➕ Yeni Kullanıcı
          </a>
        </div>
      </div>

      <!-- Executive KPI Cards -->
      <div class="exec-kpi-grid">
        <div class="exec-kpi-card exec-kpi-card--indigo">
          <div class="exec-kpi-icon exec-kpi-icon--indigo">👥</div>
          <div>
            <div class="exec-kpi-val"><%= userCount %></div>
            <div class="exec-kpi-lbl">Toplam Kullanıcı</div>
          </div>
        </div>

        <div class="exec-kpi-card exec-kpi-card--emerald">
          <div class="exec-kpi-icon exec-kpi-icon--emerald">🟢</div>
          <div>
            <div class="exec-kpi-val"><%= activeUsersCount %></div>
            <div class="exec-kpi-lbl">Aktif Personel</div>
          </div>
        </div>

        <div class="exec-kpi-card exec-kpi-card--purple">
          <div class="exec-kpi-icon exec-kpi-icon--purple">🔐</div>
          <div>
            <div class="exec-kpi-val"><%= Object.keys(roleCounts).length %></div>
            <div class="exec-kpi-lbl">Rol & Yetki Grubu</div>
          </div>
        </div>

        <div class="exec-kpi-card exec-kpi-card--amber">
          <div class="exec-kpi-icon exec-kpi-icon--amber">📜</div>
          <div>
            <div class="exec-kpi-val"><%= logs.length %></div>
            <div class="exec-kpi-lbl">Denetim İzi (Audit Log)</div>
          </div>
        </div>
      </div>

      <!-- Quick Operations Grid -->
      <div class="ops-grid">
        <a href="/admin/users" class="op-card">
          <div class="op-card-icon">👥</div>
          <div class="op-card-title">Kullanıcı Hesapları</div>
          <div class="op-card-desc">Personel listesi, unvan, departman ve aktiflik durumları</div>
        </a>

        <a href="/admin/users/add" class="op-card">
          <div class="op-card-icon" style="background: rgba(16, 185, 129, 0.12); color: #34d399;">➕</div>
          <div class="op-card-title">Yeni Kullanıcı Ekle</div>
          <div class="op-card-desc">Sisteme yeni personel ekleyin ve başlangıç rolünü atayın</div>
        </a>

        <a href="/admin/roles" class="op-card">
          <div class="op-card-icon" style="background: rgba(168, 85, 247, 0.12); color: #c084fc;">🔐</div>
          <div class="op-card-title">Rol & Yetki Matrisi</div>
          <div class="op-card-desc">Modül bazlı okuma/yazma/silme RBAC erişim matrisi</div>
        </a>

        <a href="/admin/settings" class="op-card">
          <div class="op-card-icon" style="background: rgba(245, 158, 11, 0.12); color: #fbbf24;">⚙️</div>
          <div class="op-card-title">Sistem Ayarları</div>
          <div class="op-card-desc">Bakım modu, parola politikası ve genel parametreler</div>
        </a>

        <a href="/admin/logs" class="op-card">
          <div class="op-card-icon" style="background: rgba(6, 182, 212, 0.12); color: #22d3ee;">📜</div>
          <div class="op-card-title">İşlem Günlüğü</div>
          <div class="op-card-desc">Tüm modüllerdeki ekleme, düzenleme ve silme logları</div>
        </a>
      </div>

      <!-- Interactive Charts Row -->
      <div class="dash-charts-grid">
        <div class="dash-chart-box">
          <div class="dash-chart-title">
            <span>🏢 Departman Dağılımı</span>
            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted);">Personel Sayısı</span>
          </div>
          <div style="height: 240px; position: relative;">
            <canvas id="deptChart"></canvas>
          </div>
        </div>

        <div class="dash-chart-box">
          <div class="dash-chart-title">
            <span>🔐 Rol & Yetki Dağılımı</span>
            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted);">RBAC Rolleri</span>
          </div>
          <div style="height: 240px; position: relative;">
            <canvas id="roleChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Live Recent Audit Log Activity Table -->
      <div class="fancy-card">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;">
          <div>
            <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-primary);">📜 Son Güvenlik & Denetim Kayıtları</h3>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">Sistem genelinde gerçekleştirilen son 15 güvenlik işlemi</p>
          </div>
          <a href="/admin/logs" style="font-size: 0.8rem; font-weight: 700; color: var(--indigo); text-decoration: none;">Tüm Logları İncele →</a>
        </div>

        <div style="overflow-x: auto;">
          <table class="fancy-table">
            <thead>
              <tr>
                <th>Tarih & Saat</th>
                <th>İşlemi Yapan</th>
                <th>İşlem Türü</th>
                <th>İlgili Modül / Nesne</th>
                <th>IP Adresi</th>
                <th>Detay</th>
              </tr>
            </thead>
            <tbody>
              <% if (logs && logs.length > 0) { %>
                <% logs.forEach(log => { %>
                  <tr>
                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.775rem; color: var(--text-secondary);">
                      <%= new Date(log.createdAt).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </td>
                    <td>
                      <strong style="color: var(--text-primary); font-size: 0.85rem;"><%= log.user ? log.user.username : 'Sistem' %></strong>
                    </td>
                    <td>
                      <% 
                        let bClass = 'badge-OTHER';
                        if (log.action === 'CREATE') bClass = 'badge-CREATE';
                        else if (log.action === 'UPDATE') bClass = 'badge-UPDATE';
                        else if (log.action === 'DELETE') bClass = 'badge-DELETE';
                        else if (log.action === 'LOGIN') bClass = 'badge-LOGIN';
                      %>
                      <span class="action-badge <%= bClass %>"><%= log.action %></span>
                    </td>
                    <td style="font-weight: 600; color: #a5b4fc;"><%= log.entityName %></td>
                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.775rem; color: var(--text-muted);"><%= log.ipAddress || '127.0.0.1' %></td>
                    <td style="font-size: 0.8rem; color: var(--text-secondary); max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      <%= log.details ? (typeof log.details === 'object' ? JSON.stringify(log.details) : log.details) : '—' %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 24px;">Henüz kaydedilmiş işlem logu bulunmuyor.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <script>
    // Live Clock
    function updateClock() {
      const now = new Date();
      const opts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
      const dateOpts = { day: 'numeric', month: 'long', year: 'numeric' };
      const timeEl = document.getElementById('liveTime');
      if (timeEl) {
        timeEl.textContent = now.toLocaleDateString('tr-TR', dateOpts) + '  •  ' + now.toLocaleTimeString('tr-TR', opts);
      }
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Dynamic Charts
    const deptData = <%- JSON.stringify(deptCounts) %>;
    const roleData = <%- JSON.stringify(roleCounts) %>;

    // Dept Chart
    const deptCtx = document.getElementById('deptChart');
    if (deptCtx) {
      new Chart(deptCtx, {
        type: 'doughnut',
        data: {
          labels: Object.keys(deptData),
          datasets: [{
            data: Object.values(deptData),
            backgroundColor: ['#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#a855f7', '#f43f5e', '#64748b'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right', labels: { color: '#8896b0', font: { family: 'Inter', size: 11 } } }
          },
          cutout: '68%'
        }
      });
    }

    // Role Chart
    const roleCtx = document.getElementById('roleChart');
    if (roleCtx) {
      const roleLabels = {
        'Admin': '🛡️ Admin',
        'Stock_Manager': '📦 Stok Yöneticisi',
        'Sales_Manager': '🛍️ Satış Yöneticisi',
        'Purchase_Manager': '💳 Satın Alma Yrn.',
        'Production_Manager': '🏭 Üretim Müdürü',
        'Quality_Manager': '🔬 Kalite Kontrol',
        'Employee': '👤 Personel'
      };

      const keys = Object.keys(roleData);
      const labels = keys.map(k => roleLabels[k] || k);
      const values = keys.map(k => roleData[k]);

      new Chart(roleCtx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: 'Kullanıcı Sayısı',
            data: values,
            backgroundColor: '#818cf8',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: { ticks: { color: '#8896b0', font: { family: 'Inter', size: 10 } }, grid: { display: false } },
            y: { ticks: { color: '#8896b0', font: { family: 'Inter', size: 11 }, stepSize: 1 }, grid: { color: 'rgba(255,255,255,0.05)' } }
          }
        }
      });
    }
  </script>
</body>
</html>
