<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sistem Yönetimi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">SİSTEM YÖNETİMİ</div>
      <a href="/admin" class="mss-link active">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Admin Paneli
      </a>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link">👥 Kullanıcı Yönetimi</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı</a>
        <a href="/admin/settings" class="mss-sub-link">🛠️ Sistem Ayarları</a>
        <a href="/admin/logs" class="mss-sub-link">📜 Sistem Logları</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link active">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">
      <div class="page-header">
        <div>
          <h1>Sistem Yönetim Paneli</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Kurumsal kullanıcılar, güvenlik ilkeleri, sistem ayarları ve canlı audit loglar.</p>
        </div>
      </div>

      <!-- Admin KPI Cards -->
      <div class="kpi-strip">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">👥</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Kayıtlı Kullanıcılar</span>
            <span class="kpi-chip-value"><%= userCount %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">✅</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Aktif Kullanıcı</span>
            <span class="kpi-chip-value"><%= activeUsersCount %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">🛡️</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Güvenlik</span>
            <span class="kpi-chip-value">JWT + RBAC</span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--rose">🛠️</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Sistem Ayarları</span>
            <span class="kpi-chip-value"><%= settings ? settings.length : 0 %></span>
          </div>
        </div>
      </div>

      <!-- Operations Grid -->
      <h3 style="margin: 1.5rem 0 1rem; font-size: 1.1rem;">Sistem Yönetim İşlemleri</h3>
      <div class="modules-grid">
        <a href="/admin/users" class="mod-card mod-card--active">
          <div class="mod-card-glow mod-card-glow--indigo"></div>
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--indigo">👥</div>
          </div>
          <h3 class="mod-card-title">Kullanıcı & Rol Yönetimi</h3>
          <p class="mod-card-desc">Hesapları aktifleştirin/dondurun, şifre sıfırlayın ve sistem rollerini düzenleyin.</p>
        </a>

        <a href="/admin/settings" class="mod-card mod-card--active">
          <div class="mod-card-glow mod-card-glow--emerald"></div>
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--emerald">🛠️</div>
          </div>
          <h3 class="mod-card-title">Kurumsal Sistem Ayarları</h3>
          <p class="mod-card-desc">Şirket unvanı, oturum zaman aşımı periyodu, şifre kuralları ve bakım modunu yönetin.</p>
        </a>

        <a href="/admin/logs" class="mod-card mod-card--active">
          <div class="mod-card-glow mod-card-glow--cyan"></div>
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--cyan">📜</div>
          </div>
          <h3 class="mod-card-title">Canlı Audit & Güvenlik Logları</h3>
          <p class="mod-card-desc">Veritabanında gerçekleşen tüm ekleme, silme, güncelleme ve erişim kayıtlarını süzün.</p>
        </a>

        <a href="/stock" class="mod-card mod-card--active">
          <div class="mod-card-glow mod-card-glow--rose"></div>
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--rose">📦</div>
          </div>
          <h3 class="mod-card-title">Stok & Depo Yönetimi</h3>
          <p class="mod-card-desc">Stok kartları ekleyin, güncelleyin ve envanter stok miktarlarını izleyin.</p>
        </a>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
