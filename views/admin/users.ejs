<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kullanıcı Yönetimi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link active">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/settings" class="mss-sub-link">⚙️ Sistem Parametreleri</a>
        <a href="/admin/logs" class="mss-sub-link">📜 İşlem Günlüğü (Audit Log)</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link active">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/admin/users" class="msn-link active">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="msn-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="msn-link">🔐 Rol & Yetki Matrisi</a>
        <a href="/admin/settings" class="msn-link">⚙️ Sistem Ayarları</a>
        <a href="/admin/logs" class="msn-link">📜 İşlem Günlüğü (Audit Log)</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Kullanıcı Hesabı & Profil Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Sistem kullanıcılarının departman, unvan, iletişim ve modül rol yetkilerini yönetin.</p>
        </div>
        <a href="/admin/users/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Kullanıcı Ekle
        </a>
      </div>

      <!-- Quick Admin Cards Grid featuring Log Card -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 24px;">
        
        <a href="/admin/users" style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; text-decoration: none; transition: all 0.2s;">
          <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(99, 102, 241, 0.15); color: #818cf8; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">👥</div>
          <div>
            <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">Kullanıcı Hesapları</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);"><%= users.length %> Kayıtlı Personel</div>
          </div>
        </a>

        <a href="/admin/users/add" style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; text-decoration: none; transition: all 0.2s;">
          <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(16, 185, 129, 0.15); color: #34d399; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">➕</div>
          <div>
            <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">Yeni Kullanıcı Ekle</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Personel Hesabı Aç</div>
          </div>
        </a>

        <a href="/admin/roles" style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; text-decoration: none; transition: all 0.2s;">
          <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(139, 92, 246, 0.15); color: #a78bfa; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">🔐</div>
          <div>
            <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">Rol & Yetki Matrisi</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">RBAC İzin Modeli</div>
          </div>
        </a>

        <a href="/admin/settings" style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; text-decoration: none; transition: all 0.2s;">
          <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(245, 158, 11, 0.15); color: #fbbf24; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">⚙️</div>
          <div>
            <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">Sistem Ayarları</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Güvenlik & Parametreler</div>
          </div>
        </a>

        <a href="/admin/logs" style="background: var(--bg-surface); border: 1.5px solid rgba(99, 102, 241, 0.4); border-radius: 12px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; text-decoration: none; transition: all 0.2s; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.1);">
          <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(99, 102, 241, 0.2); color: #818cf8; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">📜</div>
          <div>
            <div style="font-weight: 700; font-size: 0.88rem; color: var(--indigo);">Sistem Log Kartı</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Canlı Audit Günlüğü</div>
          </div>
        </a>

      </div>

      <div class="table-wrapper" style="overflow-x: auto; max-width: 100%; border-radius: 16px; background: var(--bg-surface); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
        <table class="data-table" style="width: 100%; border-collapse: collapse; font-size: 0.83rem;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border); background: rgba(255,255,255,0.02);">
              <th style="padding: 12px 8px; width: 45px; text-align: center;">ID</th>
              <th style="padding: 12px 10px;">Kullanıcı / Personel</th>
              <th style="padding: 12px 10px;">Çalıştığı Departman</th>
              <th style="padding: 12px 10px;">Unvan</th>
              <th style="padding: 12px 10px;">İletişim Bilgileri</th>
              <th style="padding: 12px 10px;">ERP Rol Yetkisi</th>
              <th style="padding: 12px 8px; text-align: center;">Hesap Durumu</th>
              <th style="padding: 12px 8px; text-align: center;">Kayıt Tarihi</th>
              <th style="padding: 12px 8px; text-align: center; width: 150px;">Aksiyonlar</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                <td style="padding: 10px 8px; text-align: center; font-weight: 700; color: var(--text-muted);">#<%= u.id %></td>
                <td style="padding: 10px 10px;">
                  <div style="font-weight: 700; color: var(--text-main); line-height: 1.2;"><%= u.firstName ? u.firstName + ' ' + u.lastName : u.username %></div>
                  <div style="font-size: 0.75rem; color: var(--indigo); font-family: 'JetBrains Mono', monospace; margin-top: 2px;">@<%= u.username %></div>
                </td>
                <td style="padding: 10px 10px;">
                  <span style="background: rgba(99, 102, 241, 0.12); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.25); padding: 4px 8px; border-radius: 10px; font-weight: 700; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;">
                    🏢 <%= u.department || 'Genel' %>
                  </span>
                </td>
                <td style="padding: 10px 10px;">
                  <span style="font-weight: 600; color: var(--text-main); font-size: 0.82rem;"><%= u.title || 'Personel' %></span>
                </td>
                <td style="padding: 10px 10px;">
                  <div style="font-size: 0.8rem; word-break: break-all;"><%= u.email || '—' %></div>
                  <div style="font-size: 0.73rem; color: var(--text-muted); margin-top: 2px;"><%= u.phone || '—' %></div>
                </td>
                <td style="padding: 10px 10px;">
                  <% if (u.role === 'Admin') { %>
                    <span class="status-pill status-approved" style="font-size: 0.75rem; padding: 3px 8px; white-space: nowrap;">🛡️ Sistem Yöneticisi</span>
                  <% } else if (u.role === 'Stock_Manager') { %>
                    <span class="status-pill status-onleave" style="font-size: 0.75rem; padding: 3px 8px; white-space: nowrap;">📦 Stok Yöneticisi</span>
                  <% } else if (u.role === 'Sales_Manager') { %>
                    <span class="status-pill status-active" style="font-size: 0.75rem; padding: 3px 8px; white-space: nowrap;">🛍️ Satış Yöneticisi</span>
                  <% } else if (u.role === 'Purchase_Manager') { %>
                    <span class="status-pill status-approved" style="font-size: 0.75rem; padding: 3px 8px; white-space: nowrap;">💳 Satın Alma Yöneticisi</span>
                  <% } else { %>
                    <span class="status-pill status-pending" style="font-size: 0.75rem; padding: 3px 8px; white-space: nowrap;">👤 <%= ALL_ROLES[u.role] || u.role %></span>
                  <% } %>
                </td>
                <td style="padding: 10px 8px; text-align: center;">
                  <% if (u.status === 'Active') { %>
                    <span class="status-pill status-active" style="font-size: 0.75rem; padding: 3px 8px; white-space: nowrap;">● Aktif</span>
                  <% } else if (u.status === 'Suspended') { %>
                    <span class="status-pill status-rejected" style="font-size: 0.75rem; padding: 3px 8px; white-space: nowrap;">● Donduruldu</span>
                  <% } else { %>
                    <span class="status-pill status-pending" style="font-size: 0.75rem; padding: 3px 8px; white-space: nowrap;">● Pasif</span>
                  <% } %>
                </td>
                <td style="padding: 10px 8px; text-align: center; font-size: 0.78rem; color: var(--text-muted); white-space: nowrap;"><%= new Date(u.createdAt).toLocaleDateString('tr-TR') %></td>
                <td style="padding: 10px 8px; text-align: center;">
                  <div style="display: flex; gap: 4px; justify-content: center; align-items: center; flex-wrap: nowrap;">
                    <a href="/admin/users/<%= u.id %>" class="btn btn-sm btn-secondary" style="padding: 4px 8px; font-size: 0.75rem; font-weight: 700; white-space: nowrap;" title="Detaylı Düzenle">
                      ✏️ Düzenle
                    </a>
                    
                    <% if (u.id !== user.id) { %>
                      <form action="/admin/users/<%= u.id %>/status" method="POST" style="display:inline; margin:0;">
                        <input type="hidden" name="status" value="<%= u.status === 'Active' ? 'Inactive' : 'Active' %>">
                        <button type="submit" class="btn btn-sm <%= u.status === 'Active' ? 'btn-danger' : 'btn-success' %>" style="padding: 4px 8px; font-size: 0.75rem; font-weight: 700; white-space: nowrap;">
                          <%= u.status === 'Active' ? 'Pasifleştir' : 'Aktifleştir' %>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
