<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kullanıcı Yönetimi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link active">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/settings" class="mss-sub-link">⚙️ Sistem Parametreleri</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link active">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/admin/users" class="msn-link active">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="msn-link">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="msn-link">🔐 Rol & Yetki Matrisi</a>
        <a href="/admin/settings" class="msn-link">⚙️ Sistem Ayarları</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Kullanıcı Hesabı & Profil Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Sistem kullanıcılarının departman, unvan, iletişim ve modül rol yetkilerini yönetin.</p>
        </div>
        <a href="/admin/users/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Kullanıcı Ekle
        </a>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Kullanıcı / Personel</th>
              <th>Departman & Unvan</th>
              <th>İletişim Bilgileri</th>
              <th>ERP Rol Yetkisi</th>
              <th>Hesap Durumu</th>
              <th>Kayıt Tarihi</th>
              <th>Aksiyonlar</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td>#<%= u.id %></td>
                <td>
                  <div style="font-weight: 700; color: var(--text-main);"><%= u.firstName ? u.firstName + ' ' + u.lastName : u.username %></div>
                  <div style="font-size: 0.775rem; color: var(--indigo); font-family: 'JetBrains Mono', monospace;">@<%= u.username %></div>
                </td>
                <td>
                  <span style="font-weight: 600; display: block;"><%= u.department || 'Genel' %></span>
                  <span style="font-size: 0.775rem; color: var(--text-muted);"><%= u.title || 'Personel' %></span>
                </td>
                <td>
                  <div style="font-size: 0.825rem;"><%= u.email || '—' %></div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);"><%= u.phone || '—' %></div>
                </td>
                <td>
                  <% if (u.role === 'Admin') { %>
                    <span class="status-pill status-approved">🛡️ Sistem Yöneticisi</span>
                  <% } else if (u.role === 'Stock_Manager') { %>
                    <span class="status-pill status-onleave">📦 Stok Yöneticisi</span>
                  <% } else if (u.role === 'Sales_Manager') { %>
                    <span class="status-pill status-active">🛍️ Satış Yöneticisi</span>
                  <% } else if (u.role === 'Purchase_Manager') { %>
                    <span class="status-pill status-approved">💳 Satın Alma Yöneticisi</span>
                  <% } else { %>
                    <span class="status-pill status-pending">👤 <%= ALL_ROLES[u.role] || u.role %></span>
                  <% } %>
                </td>
                <td>
                  <% if (u.status === 'Active') { %>
                    <span class="status-pill status-active">● Aktif</span>
                  <% } else if (u.status === 'Suspended') { %>
                    <span class="status-pill status-rejected">● Donduruldu</span>
                  <% } else { %>
                    <span class="status-pill status-pending">● Pasif</span>
                  <% } %>
                </td>
                <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(u.createdAt).toLocaleDateString('tr-TR') %></td>
                <td>
                  <div style="display: flex; gap: 0.4rem; align-items: center;">
                    <a href="/admin/users/<%= u.id %>" class="btn btn-sm btn-secondary" title="Detaylı Düzenle">
                      ✏️ Düzenle
                    </a>
                    
                    <% if (u.id !== user.id) { %>
                      <form action="/admin/users/<%= u.id %>/status" method="POST" style="display:inline;">
                        <input type="hidden" name="status" value="<%= u.status === 'Active' ? 'Inactive' : 'Active' %>">
                        <button type="submit" class="btn btn-sm <%= u.status === 'Active' ? 'btn-danger' : 'btn-success' %>">
                          <%= u.status === 'Active' ? 'Pasifleştir' : 'Aktifleştir' %>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
