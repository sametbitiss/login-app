<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Kullanıcı Ekle — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ SİSTEM YÖNETİMİ & GÜVENLİK</div>

      <div class="mss-group-title">📊 KONTROL PANELİ & ANALİTİK</div>
      <div class="mss-sub">
        <a href="/admin" class="mss-sub-link">📊 Yönetim Özeti</a>
      </div>

      <div class="mss-group-title">👥 KULLANICI & ROL YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/admin/users" class="mss-sub-link">👥 Kullanıcı Hesapları</a>
        <a href="/admin/users/add" class="mss-sub-link active">➕ Yeni Kullanıcı Ekle</a>
        <a href="/admin/roles" class="mss-sub-link">🔐 Rol & Yetki Matrisi</a>
      </div>

      <div class="mss-group-title">⚙️ SİSTEM & GÜVENLİK AYARLARI</div>
      <div class="mss-sub">
        <a href="/admin/settings" class="mss-sub-link">⚙️ Sistem Parametreleri</a>
        <a href="/admin/logs" class="mss-sub-link">📜 İşlem Günlüğü (Audit Log)</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link active">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Yeni Kullanıcı Hesabı Ekle</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Sisteme erişebilecek kurumsal personel hesabını sekmelerden tanımlayın (* zorunludur).</p>
        </div>
        <a href="/admin/users" class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Listeye Dön
        </a>
      </div>

      <% if (error) { %>
        <div class="error" id="serverErrorBanner"><%= error %></div>
      <% } %>

      <!-- Dynamic Client Error Banner -->
      <div class="error" id="clientErrorBanner" style="display: none; margin-bottom: 1.25rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span id="clientErrorMessage">Lütfen zorunlu (*) alanları eksiksiz doldurunuz.</span>
      </div>

      <!-- Form Container with Tab Navigation -->
      <form action="/admin/users/add" method="POST" class="stock-form-container" id="userAddForm" novalidate>

        <!-- Tab Header Bar -->
        <div class="form-tabs-header">
          <button type="button" class="tab-btn active" data-tab="tab-login" id="tab-btn-login">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>1. Kimlik & Giriş</span>
            <span class="tab-badge tab-badge--req">*</span>
          </button>

          <button type="button" class="tab-btn" data-tab="tab-personal" id="tab-btn-personal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>2. Kişisel Bilgiler</span>
          </button>

          <button type="button" class="tab-btn" data-tab="tab-role" id="tab-btn-role">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>3. Kurumsal & Rol Yetkisi</span>
            <span class="tab-badge tab-badge--req">*</span>
          </button>
        </div>

        <!-- Tab Body Panes -->
        <div class="form-tabs-body">

          <!-- Tab 1: Kimlik & Giriş Bilgileri -->
          <div class="tab-pane active" id="tab-login">
            <div class="tab-pane-title">🔑 Kullanıcı Hesabı & Giriş Bilgileri</div>
            <div class="form-grid form-grid--3">
              <div class="input-group">
                <label for="username">Kullanıcı Adı <span class="req-star">*</span></label>
                <input type="text" id="username" name="username" required placeholder="kullanici_adi">
                <span class="field-error-msg">Kullanıcı adı zorunludur.</span>
              </div>

              <div class="input-group">
                <label for="password">İlk Şifre <span class="req-star">*</span></label>
                <input type="password" id="password" name="password" required placeholder="••••••••">
                <span class="field-error-msg">Şifre en az 6 karakter olmalıdır.</span>
              </div>

              <div class="input-group">
                <label for="email">E-Posta Adresi <span class="req-star">*</span></label>
                <input type="email" id="email" name="email" required placeholder="ornek@enterprise-erp.com">
                <span class="field-error-msg">Geçerli bir e-posta adresi giriniz.</span>
              </div>
            </div>
          </div>

          <!-- Tab 2: Kişisel Bilgiler -->
          <div class="tab-pane" id="tab-personal">
            <div class="tab-pane-title">👤 Ad, Soyad ve İletişim</div>
            <div class="form-grid form-grid--3">
              <div class="input-group">
                <label for="firstName">Ad</label>
                <input type="text" id="firstName" name="firstName" placeholder="Ahmet">
              </div>

              <div class="input-group">
                <label for="lastName">Soyad</label>
                <input type="text" id="lastName" name="lastName" placeholder="Yılmaz">
              </div>

              <div class="input-group">
                <label for="phone">Telefon Numarası</label>
                <input type="text" id="phone" name="phone" placeholder="+90 (5xx) xxx xx xx">
              </div>
            </div>
          </div>

          <!-- Tab 3: Kurumsal & Rol Yetkisi -->
          <div class="tab-pane" id="tab-role">
            <div class="tab-pane-title">🏢 Departman, Unvan & ERP Rol Yetkisi</div>
            <div class="form-grid form-grid--3">
              <div class="input-group">
                <label for="department">Departman <span class="req-star">*</span></label>
                <select id="department" name="department" required>
                  <option value="" disabled selected>-- Departman Seçiniz --</option>
                  <% DEPARTMENTS.forEach(dept => { %>
                    <option value="<%= dept %>"><%= dept %></option>
                  <% }); %>
                </select>
                <span class="field-error-msg">Departman seçilmesi zorunludur.</span>
              </div>

              <div class="input-group">
                <label for="title">Unvan / Pozisyon <span class="req-star">*</span></label>
                <select id="title" name="title" required>
                  <option value="" disabled selected>-- Önce Departman Seçiniz --</option>
                </select>
                <span class="field-error-msg">Unvan seçilmesi zorunludur.</span>
              </div>

              <div class="input-group">
                <label for="role">ERP Modül Rol Yetkisi <span class="req-star">*</span></label>
                <select id="role" name="role" required>
                  <option value="" disabled selected>-- Rol Yetkisi Seçiniz --</option>
                  <% Object.keys(ALL_ROLES).forEach(rKey => { %>
                    <option value="<%= rKey %>">
                      <%= ALL_ROLES[rKey] %> (<%= rKey %>)
                    </option>
                  <% }); %>
                </select>
                <span class="field-error-msg">Rol yetkisi seçilmesi zorunludur.</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Form Actions Footer -->
        <div class="form-tabs-footer">
          <div class="tab-step-btns">
            <button type="button" class="btn btn-secondary btn-sm" id="btnPrevTab" style="display: none;">
              ← Önceki Sekme
            </button>
            <button type="button" class="btn btn-secondary btn-sm" id="btnNextTab">
              Sonraki Sekme →
            </button>
          </div>

          <div class="form-submit-btns">
            <button type="submit" class="btn btn-lg" id="btnSubmitForm">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              Kullanıcıyı Kaydet
            </button>
            <a href="/admin/users" class="btn btn-secondary btn-lg">İptal</a>
          </div>
        </div>

      </form>
    </main>
  </div>

  <script>
    // Live Clock
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Elements & State
    const form = document.getElementById('userAddForm');
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');
    const btnPrev = document.getElementById('btnPrevTab');
    const btnNext = document.getElementById('btnNextTab');
    const clientErrorBanner = document.getElementById('clientErrorBanner');
    const clientErrorMessage = document.getElementById('clientErrorMessage');

    let currentTabIndex = 0;

    function switchTab(index) {
      if (index < 0 || index >= tabBtns.length) return;
      currentTabIndex = index;

      tabBtns.forEach((btn, i) => {
        btn.classList.toggle('active', i === index);
      });

      tabPanes.forEach((pane, i) => {
        pane.classList.toggle('active', i === index);
      });

      btnPrev.style.display = index === 0 ? 'none' : 'inline-flex';
      btnNext.style.display = index === tabBtns.length - 1 ? 'none' : 'inline-flex';
    }

    tabBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => switchTab(idx));
    });

    btnPrev.addEventListener('click', () => switchTab(currentTabIndex - 1));

    function validateTab(paneIndex) {
      const pane = tabPanes[paneIndex];
      if (!pane) return true;

      const requiredInputs = pane.querySelectorAll('[required]');
      let isValid = true;

      requiredInputs.forEach(input => {
        const val = input.value ? input.value.trim() : '';
        if (!val) {
          isValid = false;
          input.classList.add('is-invalid');
        } else {
          input.classList.remove('is-invalid');
        }
      });

      return isValid;
    }

    function updateTabBadges() {
      tabPanes.forEach((pane, i) => {
        const requiredInputs = pane.querySelectorAll('[required]');
        if (requiredInputs.length === 0) return;

        let paneValid = true;
        requiredInputs.forEach(input => {
          if (!input.value || !input.value.trim()) paneValid = false;
        });

        const badge = tabBtns[i].querySelector('.tab-badge');
        if (badge) {
          if (paneValid) {
            badge.classList.remove('tab-badge--err');
            badge.classList.add('tab-badge--ok');
            badge.textContent = '✓';
          } else {
            badge.classList.remove('tab-badge--ok');
            badge.classList.add('tab-badge--err');
            badge.textContent = '!';
          }
        }
      });
    }

    form.querySelectorAll('input, select, textarea').forEach(input => {
      input.addEventListener('input', () => {
        if (input.value && input.value.trim()) {
          input.classList.remove('is-invalid');
        }
        updateTabBadges();
      });
      input.addEventListener('change', () => {
        if (input.value && input.value.trim()) {
          input.classList.remove('is-invalid');
        }
        updateTabBadges();
      });
    });

    btnNext.addEventListener('click', () => {
      const isCurrentValid = validateTab(currentTabIndex);
      if (!isCurrentValid) {
        clientErrorMessage.textContent = 'Lütfen bu sekmedeki zorunlu (*) alanları doldurunuz.';
        clientErrorBanner.style.display = 'flex';
        return;
      }
      clientErrorBanner.style.display = 'none';
      switchTab(currentTabIndex + 1);
    });

    form.addEventListener('submit', (e) => {
      form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

      let firstInvalidPaneIndex = -1;
      let firstInvalidInput = null;
      let missingFieldLabels = [];

      tabPanes.forEach((pane, paneIndex) => {
        const requiredInputs = pane.querySelectorAll('[required]');
        requiredInputs.forEach(input => {
          const val = input.value ? input.value.trim() : '';
          if (!val) {
            input.classList.add('is-invalid');
            if (firstInvalidPaneIndex === -1) {
              firstInvalidPaneIndex = paneIndex;
              firstInvalidInput = input;
            }
            const label = input.closest('.input-group') ? input.closest('.input-group').querySelector('label') : null;
            if (label) {
              const labelClean = label.textContent.replace('*', '').trim();
              if (!missingFieldLabels.includes(labelClean)) {
                missingFieldLabels.push(labelClean);
              }
            }
          }
        });
      });

      updateTabBadges();

      if (firstInvalidPaneIndex !== -1) {
        e.preventDefault(); // STOP form submission!
        switchTab(firstInvalidPaneIndex);
        clientErrorMessage.textContent = `Kayıt Yapılamadı! Lütfen eksik olan zorunlu (*) alanları doldurunuz: ${missingFieldLabels.join(', ')}`;
        clientErrorBanner.style.display = 'flex';

        if (firstInvalidInput) {
          setTimeout(() => firstInvalidInput.focus(), 150);
        }
      } else {
        clientErrorBanner.style.display = 'none';
      }
    });

    updateTabBadges();

    // Dynamic Department ➔ Titles & Allowed ERP Roles dropdown filtering
    const deptTitlesMap = <%- JSON.stringify(DEPARTMENT_TITLES) %>;
    const deptRolesMap = <%- JSON.stringify(DEPARTMENT_ROLES) %>;
    const deptSelect = document.getElementById('department');
    const titleSelect = document.getElementById('title');
    const roleSelect = document.getElementById('role');

    if (deptSelect) {
      deptSelect.addEventListener('change', function() {
        const selectedDept = this.value;

        // 1. Update Title Select Options
        if (titleSelect) {
          titleSelect.innerHTML = '<option value="" disabled selected>-- Unvan Seçiniz --</option>';
          const titles = deptTitlesMap[selectedDept] || ['Uzman Personel', 'Yönetici', 'Sorumlu'];
          titles.forEach(t => {
            const opt = document.createElement('option');
            opt.value = t;
            opt.textContent = t;
            titleSelect.appendChild(opt);
          });
        }

        // 2. Update Role Select Options (Strictly Correlated to Department!)
        if (roleSelect) {
          roleSelect.innerHTML = '<option value="" disabled selected>-- Rol Yetkisi Seçiniz --</option>';
          const roles = deptRolesMap[selectedDept] || [{ key: 'Employee', label: '👤 Personel' }];
          roles.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.key;
            opt.textContent = r.label;
            roleSelect.appendChild(opt);
          });
        }
      });
    }
  </script>
</body>
</html>
