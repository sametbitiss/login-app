<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lot & Seri No İzlenebilirliği — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#4f46e5"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">STOK & DEPO</div>
      <a href="/stock" class="mss-link active">Stok Yönetimi</a>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link active">🏷️ Lot & Seri Numaraları</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max Uyarısı</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= ALL_ROLES[user.role] || user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/stock/items" class="msn-link">📦 Malzeme Kartları</a>
        <a href="/stock/warehouses" class="msn-link">🏬 Depolar & Lokasyonlar</a>
        <a href="/stock/lots" class="msn-link active">🏷️ Lot / Parti & Seri No</a>
        <a href="/stock/transfers" class="msn-link">🔄 Transferler & Hareketler</a>
        <a href="/stock/goods-receipt" class="msn-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="msn-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/counting" class="msn-link">📋 Envanter Sayımı</a>
        <a href="/stock/alerts" class="msn-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="msn-link">💰 Stok Maliyetlendirme (FIFO)</a>
        <a href="/stock/terminal" class="msn-link">📱 RF El Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Lot / Parti & Seri Numarası İzlenebilirliği</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Geri çağırma, kalite güvencesi, üretim ve son kullanma tarihi (SKT) takip sistemi.</p>
        </div>
      </div>

      <!-- Add Lot Form Panel -->
      <div class="form-panel" style="margin-bottom: 1.75rem;">
        <h3 style="color: var(--indigo); font-size: 1.05rem; margin-bottom: 1rem;">🏷️ Yeni Parti / Seri Numaralı Ürün Kaydı</h3>
        
        <form action="/stock/lots/add" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="stockItemId">Malzeme / Stok Kartı <span class="req-star">*</span></label>
              <select id="stockItemId" name="stockItemId" required>
                <option value="" disabled selected>-- Malzeme Seçiniz --</option>
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>">[<%= item.stockCode %>] <%= item.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="input-group">
              <label for="warehouseId">Bulunduğu Depo <span class="req-star">*</span></label>
              <select id="warehouseId" name="warehouseId" required>
                <option value="" disabled selected>-- Depo Seçiniz --</option>
                <% warehouses.forEach(wh => { %>
                  <option value="<%= wh.id %>">[<%= wh.warehouseCode %>] <%= wh.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="input-group">
              <label for="lotNumber">Lot / Parti Numarası <span class="req-star">*</span></label>
              <input type="text" id="lotNumber" name="lotNumber" required placeholder="Örn: LOT-2026-08-001">
            </div>
          </div>

          <div class="form-grid form-grid--4">
            <div class="input-group">
              <label for="serialNumber">Benzersiz Seri No (Varsa)</label>
              <input type="text" id="serialNumber" name="serialNumber" placeholder="Örn: SN-99882233">
            </div>

            <div class="input-group">
              <label for="quantity">Parti Miktarı <span class="req-star">*</span></label>
              <input type="number" id="quantity" name="quantity" step="0.01" min="1" value="100" required>
            </div>

            <div class="input-group">
              <label for="productionDate">Üretim Tarihi</label>
              <input type="date" id="productionDate" name="productionDate">
            </div>

            <div class="input-group">
              <label for="expirationDate">Son Kullanma Tarihi (SKT)</label>
              <input type="date" id="expirationDate" name="expirationDate">
            </div>
          </div>

          <button type="submit" class="btn" style="align-self: flex-start;">
            Lot Kaydını Oluştur
          </button>
        </form>
      </div>

      <!-- Lots Table -->
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Lot / Parti No</th>
              <th>Seri Numarası</th>
              <th>Malzeme Kodu & Adı</th>
              <th>Depo</th>
              <th>Miktar</th>
              <th>Üretim Tarihi</th>
              <th>Son Kullanma Tarihi (SKT)</th>
              <th>Kalite Durumu</th>
            </tr>
          </thead>
          <tbody>
            <% if (lots && lots.length > 0) { %>
              <% lots.forEach(l => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= l.lotNumber %></strong></td>
                  <td><span style="font-family: 'JetBrains Mono', monospace;"><%= l.serialNumber || '—' %></span></td>
                  <td>
                    <strong style="color: var(--text-main);"><%= l.stockItem ? l.stockItem.name : '—' %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-muted);"><%= l.stockItem ? l.stockItem.stockCode : '' %></div>
                  </td>
                  <td><strong style="color: var(--emerald);"><%= l.warehouse ? l.warehouse.name : '—' %></strong></td>
                  <td><strong><%= l.quantity %> <%= l.stockItem ? l.stockItem.unit : 'Adet' %></strong></td>
                  <td><%= l.productionDate ? new Date(l.productionDate).toLocaleDateString('tr-TR') : '—' %></td>
                  <td>
                    <% if (l.expirationDate) { %>
                      <strong style="color: var(--amber);"><%= new Date(l.expirationDate).toLocaleDateString('tr-TR') %></strong>
                    <% } else { %>
                      <span style="color: var(--text-muted);">Süresiz</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (l.qualityStatus === 'Approved') { %>
                      <span class="status-pill status-active">✓ Onaylı Kalite</span>
                    <% } else if (l.qualityStatus === 'Quarantine') { %>
                      <span class="status-pill status-onleave">⚠️ Karantinada</span>
                    <% } else { %>
                      <span class="status-pill status-rejected">❌ Reddedildi</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                  Henüz kaydedilmiş lot/parti numaralı stok bulunmamaktadır.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
