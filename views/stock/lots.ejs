<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lot / Parti ve Seri Numarası İzlenebilirliği — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* High-End Form Card Styling */
    .form-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      box-shadow: var(--shadow-md);
      margin-bottom: 28px;
      position: relative;
      overflow: hidden;
    }
    .form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #6366f1, #8b5cf6);
    }

    .form-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }
    .form-card-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      background: rgba(99, 102, 241, 0.15);
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .form-card-title { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); }
    .form-card-sub { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }

    /* Ultra Aesthetic Inputs */
    .aesthetic-group { margin-bottom: 16px; }
    .aesthetic-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 6px;
      display: block;
    }
    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      padding: 12px 14px;
      border-radius: 10px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }
    .aesthetic-input::placeholder { color: #475569; }

    .btn-indigo-gradient {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 12px 28px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-indigo-gradient:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5); }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>
      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link active">🏷️ Lot & Seri Numaraları</a>
      </div>
      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/stock/analytics" class="msn-link">📊 Analitik</a>
        <a href="/stock/alerts" class="msn-link">🚨 Kritik Stok</a>
        <a href="/stock/valuation" class="msn-link">💰 Maliyetlendirme</a>
        <a href="/stock/items" class="msn-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="msn-link">🏬 Depolar</a>
        <a href="/stock/lots" class="msn-link active">🏷️ Lot & Seri No</a>
        <a href="/stock/goods-receipt" class="msn-link">📥 Mal Kabul</a>
        <a href="/stock/dispatch" class="msn-link">📤 Sevkiyat</a>
        <a href="/stock/transfers" class="msn-link">🔄 Transferler</a>
        <a href="/stock/counting" class="msn-link">📋 Sayım</a>
        <a href="/stock/terminal" class="msn-link">📱 RF El Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Lot / Parti ve Seri Numarası İzlenebilirliği</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Geri çağırma, son kullanma tarihi ve kalite güvencesi için lot/seri no takibi.</p>
        </div>
      </div>

      <!-- Add Lot Form -->
      <div class="form-card">
        <div class="form-card-header">
          <div class="form-card-icon">🏷️</div>
          <div>
            <div class="form-card-title">Yeni Lot / Parti veya Seri No Tanımla</div>
            <div class="form-card-sub">Geri çağırma, kalite sertifikasyonu ve SKT izlenebilirliği tanımı</div>
          </div>
        </div>

        <form action="/stock/lots/add" method="POST">
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;">
            <div class="aesthetic-group">
              <label class="aesthetic-label">Stok Kalemi *</label>
              <select name="stockItemId" class="aesthetic-input" required style="cursor: pointer;">
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>"><%= item.stockCode %> — <%= item.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Bulunduğu Depo *</label>
              <select name="warehouseId" class="aesthetic-input" required style="cursor: pointer;">
                <% warehouses.forEach(w => { %>
                  <option value="<%= w.id %>"><%= w.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Lot / Parti Numarası *</label>
              <input type="text" name="lotNumber" placeholder="Örn: LOT-2026-08A" class="aesthetic-input" required>
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Seri Numarası (Varsa)</label>
              <input type="text" name="serialNumber" placeholder="Örn: SN-994821034" class="aesthetic-input">
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Parti Miktarı *</label>
              <input type="number" name="quantity" value="100" min="1" step="0.01" class="aesthetic-input" required>
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Üretim Tarihi</label>
              <input type="date" name="productionDate" class="aesthetic-input">
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Son Kullanma Tarihi (SKT)</label>
              <input type="date" name="expirationDate" class="aesthetic-input">
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Kalite Durumu</label>
              <select name="qualityStatus" class="aesthetic-input" style="cursor: pointer;">
                <option value="Approved">Approved (Kalite Onaylı)</option>
                <option value="Pending">Pending (Karantinada / İncelemede)</option>
                <option value="Rejected">Rejected (Hatalı / Red)</option>
              </select>
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Kalite Sertifika No / Notlar</label>
              <input type="text" name="notes" placeholder="ISO / Kalite sertifika no..." class="aesthetic-input">
            </div>
          </div>

          <div style="margin-top: 12px;">
            <button type="submit" class="btn-indigo-gradient">
              🏷️ Lot / Seri Numarasını Kaydet
            </button>
          </div>
        </form>
      </div>

      <!-- Lot Table -->
      <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin-bottom: 16px;">📋 Tanımlı Lot ve Seri Numaraları Listesi</h3>
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Lot / Parti No</th>
              <th>Seri No</th>
              <th>Malzeme</th>
              <th>Bulunduğu Depo</th>
              <th>Miktar</th>
              <th>Üretim Tarihi</th>
              <th>Son Kullanma Tarihi</th>
              <th>Kalite Durumu</th>
            </tr>
          </thead>
          <tbody>
            <% if (lots.length === 0) { %>
              <tr><td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">Henüz kayıtlı lot/parti numarası bulunmamaktadır.</td></tr>
            <% } else { %>
              <% lots.forEach(lot => { %>
                <tr>
                  <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace; background: rgba(99,102,241,0.1); padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(99,102,241,0.2);"><%= lot.lotNumber %></strong></td>
                  <td><%= lot.serialNumber ? `<span style="font-family: 'JetBrains Mono', monospace;">${lot.serialNumber}</span>` : '—' %></td>
                  <td><strong style="color: var(--text-primary);"><%= lot.stockItem ? lot.stockItem.name : '—' %></strong></td>
                  <td><%= lot.warehouse ? lot.warehouse.name : '—' %></td>
                  <td><strong><%= lot.quantity %> <%= lot.stockItem ? lot.stockItem.unit : '' %></strong></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= lot.productionDate ? new Date(lot.productionDate).toLocaleDateString('tr-TR') : '—' %></td>
                  <td style="font-size: 0.8rem; color: var(--rose);"><%= lot.expirationDate ? new Date(lot.expirationDate).toLocaleDateString('tr-TR') : '—' %></td>
                  <td>
                    <% if (lot.qualityStatus === 'Approved') { %>
                      <span class="status-pill status-active">● Kalite Onaylı</span>
                    <% } else if (lot.qualityStatus === 'Pending') { %>
                      <span class="status-pill status-pending">● Karantinada</span>
                    <% } else { %>
                      <span class="status-pill status-rejected">● Reddedildi</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
