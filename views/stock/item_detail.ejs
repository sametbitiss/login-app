<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stok Kartı Detayı & Parametre Yönetimi (<%= item.stockCode %>) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --accent-indigo: #6366f1;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;
      --accent-rose: #f43f5e;
    }

    /* Hero Header */
    .item-detail-hero {
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.98) 0%, rgba(30, 41, 59, 0.95) 100%);
      backdrop-filter: blur(25px);
      border: 1.5px solid rgba(99, 102, 241, 0.3);
      border-radius: 24px;
      padding: 2.25rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      position: relative;
      overflow: hidden;
    }
    .item-detail-hero::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, #6366f1 0%, #3b82f6 50%, #10b981 100%);
    }

    .hero-header-bar {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 1.5rem; border-bottom: 1px dashed rgba(255, 255, 255, 0.12);
      padding-bottom: 1.25rem;
    }

    .hero-badge-group {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px;
    }

    .code-pill {
      font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 1.15rem;
      color: #818cf8; background: rgba(99, 102, 241, 0.15); padding: 5px 14px;
      border-radius: 10px; border: 1.5px solid rgba(99, 102, 241, 0.35);
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    .lock-tag {
      background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);
      font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 8px;
      display: inline-flex; align-items: center; gap: 5px;
    }

    .hero-title { font-size: 1.75rem; font-weight: 900; color: #ffffff; margin: 0; letter-spacing: -0.5px; }

    /* Hero KPIs Grid */
    .hero-kpis-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 1.5rem;
    }
    @media (max-width: 900px) { .hero-kpis-grid { grid-template-columns: 1fr 1fr; } }

    .kpi-card {
      background: rgba(15, 23, 42, 0.65); border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px; padding: 14px 18px; position: relative;
    }
    .kpi-card-label { font-size: 0.725rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.6px; }
    .kpi-card-value { font-size: 1.35rem; font-weight: 900; font-family: 'JetBrains Mono', monospace; margin-top: 4px; }
    .kpi-card-sub { font-size: 0.725rem; color: #64748b; margin-top: 2px; }

    /* TAB MENU NAVIGATION */
    .glass-tabs-nav {
      display: flex; gap: 8px; margin-bottom: 1.5rem;
      background: rgba(15, 23, 42, 0.65); border: 1.5px solid rgba(255, 255, 255, 0.1);
      border-radius: 18px; padding: 6px; overflow-x: auto;
    }

    .glass-tab-btn {
      flex: 1; min-width: 170px; background: transparent; border: none;
      color: #94a3b8; font-size: 0.85rem; font-weight: 700; padding: 12px 18px;
      border-radius: 14px; cursor: pointer; transition: all 0.25 ease;
      display: flex; align-items: center; justify-content: center; gap: 8px; white-space: nowrap;
    }
    .glass-tab-btn:hover { color: #ffffff; background: rgba(255, 255, 255, 0.05); }
    .glass-tab-btn.active {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.25) 0%, rgba(79, 70, 229, 0.35) 100%);
      color: #ffffff; border: 1px solid rgba(99, 102, 241, 0.4);
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.25);
    }

    /* TAB CONTENT PANES */
    .tab-content {
      display: none;
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(15px);
      border: 1.5px solid rgba(255, 255, 255, 0.09);
      border-radius: 20px;
      padding: 2rem;
      margin-bottom: 1.75rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      animation: fadeIn 0.25s ease-in-out;
    }
    .tab-content.active { display: block; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .section-header {
      font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;
      margin-bottom: 1.5rem; padding-bottom: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex; justify-content: space-between; align-items: center;
    }

    .glass-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 18px; }
    .glass-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 18px; }
    @media (max-width: 850px) { .glass-grid-2, .glass-grid-3 { grid-template-columns: 1fr; } }

    .field-wrap { margin-bottom: 4px; }
    .field-label { display: block; font-size: 0.825rem; font-weight: 700; color: #94a3b8; margin-bottom: 6px; }
    .field-label--locked { color: #64748b; }
    
    .field-input {
      width: 100%; background: rgba(15, 23, 42, 0.85); border: 1.5px solid rgba(255, 255, 255, 0.14);
      border-radius: 12px; padding: 11px 16px; color: #ffffff; font-size: 0.9rem; font-weight: 600;
      outline: none; transition: all 0.2s ease; box-sizing: border-box;
    }
    .field-input:focus {
      border-color: #6366f1; background: rgba(30, 41, 59, 0.95);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
    }
    .field-input:disabled, .field-input[readonly] {
      background: rgba(15, 23, 42, 0.4) !important;
      border-color: rgba(255, 255, 255, 0.06) !important;
      color: #64748b !important;
      cursor: not-allowed;
      opacity: 0.85;
    }

    .action-bar {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.25rem 2rem; background: rgba(15, 23, 42, 0.85);
      border: 1.5px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4); margin-bottom: 3rem;
    }

    .btn-save-master {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #ffffff; font-size: 1rem; font-weight: 800; padding: 14px 36px;
      border-radius: 16px; border: none; cursor: pointer;
      box-shadow: 0 12px 30px rgba(99, 102, 241, 0.45);
      display: inline-flex; align-items: center; gap: 10px; transition: all 0.2s ease;
    }
    .btn-save-master:hover { transform: translateY(-2px); box-shadow: 0 16px 35px rgba(99, 102, 241, 0.55); }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>
      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link active">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/stock/items" class="mt-link">← Stok Kartları Listesine Dön</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span></div>
    </header>

    <main class="module-content">
      <!-- HERO HEADER CARD -->
      <div class="item-detail-hero">
        <div class="hero-header-bar">
          <div>
            <div class="hero-badge-group">
              <span class="code-pill"><%= item.stockCode %></span>
              <span class="lock-tag">🔒 TEMEL KİMLİK KİLİTLİ</span>
              <span class="status-pill status-approved"><%= item.category %></span>
              <% if (item.status === 'Active') { %>
                <span class="status-pill status-active">● Aktif</span>
              <% } else if (item.status === 'Passive') { %>
                <span class="status-pill status-rejected">● Pasif</span>
              <% } else { %>
                <span class="status-pill status-onleave">● Durduruldu</span>
              <% } %>
            </div>
            <h1 class="hero-title"><%= item.name %></h1>
            <% if (item.barcode) { %>
              <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 6px;">
                Barkod / EAN No: <strong style="font-family: 'JetBrains Mono', monospace; color: #e2e8f0;"><%= item.barcode %></strong>
              </div>
            <% } %>
          </div>
          <div>
            <a href="/stock/items" class="btn btn-secondary" style="font-weight: 700;">← Listeye Dön</a>
          </div>
        </div>

        <% 
          const curr = parseFloat(item.currentStock || 0);
          const resv = parseFloat(item.reservedStock || 0);
          const avail = Math.max(0, curr - resv);
          const pPrice = parseFloat(item.purchasePrice || 0);
          const sPrice = parseFloat(item.salePrice || 0);
          const margin = pPrice > 0 ? (((sPrice - pPrice) / pPrice) * 100).toFixed(1) : 0;
          const minStk = parseFloat(item.minStock || 0);
          const isLow = avail <= minStk;
        %>
        <div class="hero-kpis-grid">
          <div class="kpi-card">
            <div class="kpi-card-label">Fiziksel Stok</div>
            <div class="kpi-card-value" style="color: #38bdf8;"><%= curr.toLocaleString('tr-TR', {minimumFractionDigits: 0, maximumFractionDigits: 2}) %> <span style="font-size: 0.85rem;"><%= item.unit %></span></div>
            <div class="kpi-card-sub">Depodaki toplam miktar</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-card-label">Rezerve Stok</div>
            <div class="kpi-card-value" style="color: #fb7185;"><%= resv.toLocaleString('tr-TR', {minimumFractionDigits: 0, maximumFractionDigits: 2}) %> <span style="font-size: 0.85rem;"><%= item.unit %></span></div>
            <div class="kpi-card-sub">Siparişlere ayrılan</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-card-label">Kullanılabilir Stok</div>
            <% if (isLow) { %>
              <div class="kpi-card-value" style="color: #fb7185;">⚠️ <%= avail.toLocaleString('tr-TR', {minimumFractionDigits: 0, maximumFractionDigits: 2}) %> <span style="font-size: 0.85rem;"><%= item.unit %></span></div>
              <div class="kpi-card-sub" style="color: #f43f5e; font-weight: 700;">Asgari seviyenin altında!</div>
            <% } else { %>
              <div class="kpi-card-value" style="color: #34d399;">✓ <%= avail.toLocaleString('tr-TR', {minimumFractionDigits: 0, maximumFractionDigits: 2}) %> <span style="font-size: 0.85rem;"><%= item.unit %></span></div>
              <div class="kpi-card-sub" style="color: #34d399;">Güvenli stok seviyesi</div>
            <% } %>
          </div>
          <div class="kpi-card">
            <div class="kpi-card-label">Birim Brüt Kar Marjı</div>
            <div class="kpi-card-value" style="color: #fbbf24;"><%= margin %>%</div>
            <div class="kpi-card-sub">Alış/Satış Fiyat Oranı</div>
          </div>
        </div>
      </div>

      <% if (successMsg) { %>
        <div style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1.5px solid rgba(16, 185, 129, 0.35); padding: 14px 20px; border-radius: 14px; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>✅</span> <%= successMsg %>
        </div>
      <% } %>

      <% if (errorMsg) { %>
        <div style="background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1.5px solid rgba(244, 63, 94, 0.35); padding: 14px 20px; border-radius: 14px; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= errorMsg %>
        </div>
      <% } %>

      <!-- MASTER FORM WRAPPER -->
      <form action="/stock/items/<%= item.id %>/update" method="POST">

        <!-- TAB NAVIGATION MENU -->
        <nav class="glass-tabs-nav">
          <button type="button" class="glass-tab-btn active" onclick="switchTab('tab-identity', event)">
            <span>🔒 1. Temel Kimlik & Tedarik</span>
          </button>
          <button type="button" class="glass-tab-btn" onclick="switchTab('tab-stock-limits', event)">
            <span>📊 2. Stok Limitleri & Depo</span>
          </button>
          <button type="button" class="glass-tab-btn" onclick="switchTab('tab-pricing', event)">
            <span>💰 3. Fiyatlandırma & KDV</span>
          </button>
          <button type="button" class="glass-tab-btn" onclick="switchTab('tab-supplier-notes', event)">
            <span>🏢 4. Tedarikçi & Notlar</span>
          </button>
        </nav>

        <!-- TAB 1: TEMEL KİMLİK & TEDARİK -->
        <div id="tab-identity" class="tab-content active">
          <div class="section-header" style="color: #818cf8;">
            <span>🔒 1. TEMEL KİMLİK VE TEDARİK YÖNTEMİ</span>
            <span style="font-size: 0.75rem; color: #64748b; text-transform: none; font-weight: 600;">Temel kimlik alanları sistem kilitlidir</span>
          </div>

          <div style="background: rgba(15, 23, 42, 0.45); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 18px; margin-bottom: 20px;">
            <div style="font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.5px;">🔒 Kilitli Tanım Bilgileri</div>
            <div class="glass-grid-3">
              <div class="field-wrap">
                <label class="field-label field-label--locked">Stok Kodu 🔒</label>
                <input type="text" value="<%= item.stockCode %>" class="field-input" disabled style="font-family: 'JetBrains Mono', monospace; font-weight: 700;">
              </div>
              <div class="field-wrap">
                <label class="field-label field-label--locked">Malzeme / Ürün Adı 🔒</label>
                <input type="text" value="<%= item.name %>" class="field-input" disabled>
              </div>
              <div class="field-wrap">
                <label class="field-label field-label--locked">Barkod / EAN Numarası 🔒</label>
                <input type="text" value="<%= item.barcode || '—' %>" class="field-input" disabled style="font-family: 'JetBrains Mono', monospace;">
              </div>
            </div>

            <div class="glass-grid-2">
              <div class="field-wrap">
                <label class="field-label field-label--locked">Kategori 🔒</label>
                <input type="text" value="<%= item.category %>" class="field-input" disabled>
              </div>
              <div class="field-wrap">
                <label class="field-label field-label--locked">Ölçü Birimi 🔒</label>
                <input type="text" value="<%= item.unit %>" class="field-input" disabled>
              </div>
            </div>
          </div>

          <div style="font-size: 0.75rem; font-weight: 800; color: #818cf8; text-transform: uppercase; margin-bottom: 12px; letter-spacing: 0.5px;">✏️ Düzenlenebilir Yöntem & Durum</div>
          <div class="glass-grid-2">
            <div class="field-wrap">
              <label class="field-label">Tedarik Yöntemi *</label>
              <% if (item.category === 'Mamul') { %>
                <select name="procurementMethod" class="field-input" required>
                  <option value="Üretim" selected>⚙️ Üretim (İç İmalat / İş Emri Talebi)</option>
                </select>
                <div style="font-size: 0.72rem; color: #818cf8; margin-top: 4px;">🔒 Mamul ürünler yalnızca Üretim tedarik yöntemine sahiptir.</div>
              <% } else if (item.category === 'Hammadde' || item.category === 'Ticari_Mal' || item.category === 'Ticari Mal') { %>
                <select name="procurementMethod" class="field-input" required>
                  <option value="Satın Alma" selected>🛒 Satın Alma (Dış Tedarik / Satın Alma Talebi)</option>
                </select>
                <div style="font-size: 0.72rem; color: #818cf8; margin-top: 4px;">🔒 Hammadde/Ticari mallar yalnızca Satın Alma tedarik yöntemine sahiptir.</div>
              <% } else { %>
                <select name="procurementMethod" class="field-input" required>
                  <option value="Satın Alma" <%= item.procurementMethod === 'Satın Alma' ? 'selected' : '' %>>🛒 Satın Alma (Dış Tedarik / Satın Alma Talebi)</option>
                  <option value="Üretim" <%= item.procurementMethod === 'Üretim' ? 'selected' : '' %>>⚙️ Üretim (İç İmalat / İş Emri Talebi)</option>
                </select>
              <% } %>
            </div>
            <div class="field-wrap">
              <label class="field-label">Kart Durumu *</label>
              <% if (typeof passiveComponents !== 'undefined' && passiveComponents && passiveComponents.length > 0) { %>
                <select name="status" class="field-input" required style="border-color: #f43f5e;">
                  <option value="Active" disabled style="color: #64748b; background: #0f172a;">● Aktif (Reçetede pasif bileşen var - Kilitli)</option>
                  <option value="Passive" <%= (item.status === 'Passive' || item.durum === 'Passive' || item.status === 'Active' || item.durum === 'Active') ? 'selected' : '' %>>● Pasif (İşlemlere Kapalı)</option>
                  <option value="Discontinued" <%= (item.status === 'Discontinued' || item.durum === 'Discontinued') ? 'selected' : '' %>>● Durduruldu (Üretim/Satış Yapılmaz)</option>
                </select>
                <div style="font-size: 0.75rem; color: #fb7185; margin-top: 6px; background: rgba(244, 63, 94, 0.12); padding: 9px 13px; border-radius: 10px; border: 1px solid rgba(244, 63, 94, 0.3);">
                  ⚠️ <strong>Reçetede Pasif Bileşen Var:</strong><br>
                  Bu ürünün reçetesindeki <% passiveComponents.forEach((pc, idx) => { %>
                    <span style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fff;">[<%= pc.stokKodu %>] <%= pc.ad %></span><%= idx < passiveComponents.length - 1 ? ', ' : '' %>
                  <% }) %> pasif durumda olduğu için bu mamulün durumu <u>Aktif yapılamaz</u>. Önce ilgili bileşenin durumu Aktif yapılmalıdır.
                </div>
              <% } else { %>
                <select name="status" class="field-input" required>
                  <option value="Active" <%= (item.status === 'Active' || item.durum === 'Active') ? 'selected' : '' %>>● Aktif (İşlemlere Açık)</option>
                  <option value="Passive" <%= (item.status === 'Passive' || item.durum === 'Passive') ? 'selected' : '' %>>● Pasif (İşlemlere Kapalı)</option>
                  <option value="Discontinued" <%= (item.status === 'Discontinued' || item.durum === 'Discontinued') ? 'selected' : '' %>>● Durduruldu (Üretim/Satış Yapılmaz)</option>
                </select>
              <% } %>
            </div>
          </div>
        </div>

        <!-- TAB 2: STOK LİMİTLERİ & DEPO -->
        <div id="tab-stock-limits" class="tab-content">
          <div class="section-header" style="color: #34d399;">
            <span>📊 2. ASGARİ VE AZAMİ STOK EŞİK LİMLERİ</span>
          </div>

          <div class="glass-grid-2">
            <div class="field-wrap">
              <label class="field-label">Asgari (Min) Stok Eşiği *</label>
              <input type="number" step="0.01" min="0" name="minStock" value="<%= item.minStock || 0 %>" class="field-input" required style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fb7185;">
              <div style="font-size: 0.725rem; color: #64748b; margin-top: 6px;">Kullanılabilir stok bu seviyenin altına düştüğünde sistem otomatik Kritik Stok Uyarısı verir.</div>
            </div>
            <div class="field-wrap">
              <label class="field-label">Azami (Max) Stok Eşiği</label>
              <input type="number" step="0.01" min="0" name="maxStock" value="<%= item.maxStock || '' %>" class="field-input" placeholder="Limitsiz" style="font-family: 'JetBrains Mono', monospace; font-weight: 700;">
              <div style="font-size: 0.725rem; color: #64748b; margin-top: 6px;">Depolama alanında bulundurulabilecek maksimum ürün adedi.</div>
            </div>
          </div>

          <div class="glass-grid-2" style="margin-top: 14px;">
            <div class="field-wrap">
              <label class="field-label">
                <span>Varsayılan Depo *</span>
                <span style="color: #34d399; font-size: 0.72rem; margin-left: 8px;">🏬 DİNAMİK DEPO LİSTESİ</span>
              </label>
              <select id="editWarehouseSelect" name="warehouseSelect" class="field-input" onchange="onEditWarehouseChange()" required>
                <option value="">-- Depolar Kartından Varsayılan Depoyu Seçiniz --</option>
                <% if (typeof warehouses !== 'undefined' && warehouses && warehouses.length > 0) { %>
                  <% warehouses.forEach(wh => { %>
                    <option value="<%= wh.id %>" data-code="<%= wh.depoKodu || wh.warehouseCode %>" data-name="<%= wh.ad || wh.name %>">
                      [<%= wh.depoKodu || wh.warehouseCode %>] <%= wh.ad || wh.name %> (<%= wh.tur || wh.type %> — <%= wh.sehir || wh.city || 'İstanbul' %>)
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <div class="field-wrap">
              <label class="field-label">
                <span>Depo İçi Lokasyon / Raf / Göz</span>
                <span style="color: #818cf8; font-size: 0.72rem; margin-left: 8px;">📍 LOKASYON HARİTASI</span>
              </label>
              <select id="editLocationSelect" name="locationSelect" class="field-input" onchange="onEditLocationChange()">
                <option value="">-- Önce Depo Seçiniz --</option>
              </select>
              <input type="hidden" id="editWarehouseLocation" name="warehouseLocation" value="<%= item.warehouseLocation || item.depoLokasyonu || '' %>">
              <input type="hidden" id="editDepoLokasyonu" name="depoLokasyonu" value="<%= item.depoLokasyonu || item.warehouseLocation || '' %>">
            </div>
          </div>
        </div>

        <!-- TAB 3: FİYATLANDIRMA & KDV -->
        <div id="tab-pricing" class="tab-content">
          <div class="section-header" style="color: #fbbf24;">
            <span>💰 3. FİYATLANDIRMA, PARA BİRİMİ VE KDV PARAMETRELERİ</span>
          </div>

          <div class="glass-grid-2">
            <div class="field-wrap">
              <label class="field-label">Tedarik / Alış Fiyatı (KDV Hariç)</label>
              <input type="number" step="0.01" min="0" name="purchasePrice" value="<%= item.purchasePrice || 0 %>" class="field-input" style="font-family: 'JetBrains Mono', monospace;">
            </div>
            <div class="field-wrap">
              <label class="field-label">Birim Satış Fiyatı (KDV Hariç)</label>
              <input type="number" step="0.01" min="0" name="salePrice" value="<%= item.salePrice || 0 %>" class="field-input" style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #34d399;">
            </div>
          </div>

          <div class="glass-grid-2">
            <div class="field-wrap">
              <label class="field-label">Para Birimi *</label>
              <select name="currency" class="field-input" required>
                <option value="TRY" <%= item.currency === 'TRY' ? 'selected' : '' %>>Türk Lirası (TRY ₺)</option>
                <option value="USD" <%= item.currency === 'USD' ? 'selected' : '' %>>Amerikan Doları (USD $)</option>
                <option value="EUR" <%= item.currency === 'EUR' ? 'selected' : '' %>>Euro (EUR €)</option>
              </select>
            </div>
            <div class="field-wrap">
              <label class="field-label">KDV Oranı (%) *</label>
              <input type="number" step="1" min="0" max="100" name="taxRate" value="<%= item.taxRate || 20 %>" class="field-input" placeholder="Örn: 20" required style="font-family: 'JetBrains Mono', monospace;">
            </div>
          </div>
        </div>

        <!-- TAB 4: TEDARİKÇİ & NOTLAR -->
        <div id="tab-supplier-notes" class="tab-content">
          <div class="section-header" style="color: #e0e7ff;">
            <span>🏢 4. TEDARİKÇİ VE ÖZEL NOTLAR</span>
          </div>

          <div class="glass-grid-2">
            <div class="field-wrap">
              <label class="field-label">Ana Tedarikçi Firma</label>
              <select name="supplier" class="field-input">
                <option value="">Seçiniz / Belirtilmemiş</option>
                <% if (suppliers && suppliers.length > 0) { %>
                  <% suppliers.forEach(sup => { %>
                    <option value="<%= sup.companyName %>" <%= item.supplier === sup.companyName ? 'selected' : '' %>><%= sup.companyName %></option>
                  <% }); %>
                <% } %>
              </select>
            </div>
            <div class="field-wrap">
              <label class="field-label">Marka / Model</label>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <input type="text" name="brand" value="<%= item.brand || '' %>" placeholder="Marka..." class="field-input">
                <input type="text" name="model" value="<%= item.model || '' %>" placeholder="Model..." class="field-input">
              </div>
            </div>
          </div>

          <div class="field-wrap" style="margin-top: 10px;">
            <label class="field-label">Özel Notlar & Teknik Açıklamalar</label>
            <textarea name="notes" class="field-input" rows="4" placeholder="Depolama koşulları, tedarikçi detayları veya özel açıklamalar..."><%= item.notes || '' %></textarea>
          </div>
        </div>

        <!-- STICKY ACTION BAR -->
        <div class="action-bar">
          <a href="/stock/items" class="btn btn-secondary" style="padding: 12px 26px; font-weight: 700;">← İptal / Listeye Dön</a>
          <button type="submit" class="btn-save-master">
            <span>💾 Güncellenmiş Parametreleri Kaydet</span>
          </button>
        </div>
      </form>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    const warehousesData = <%- JSON.stringify(typeof warehouses !== 'undefined' && warehouses ? warehouses : []) %>;
    const currentLocString = <%- JSON.stringify(item.warehouseLocation || item.depoLokasyonu || '') %>;

    function onEditWarehouseChange() {
      const whSelect = document.getElementById('editWarehouseSelect');
      const locSelect = document.getElementById('editLocationSelect');
      if (!whSelect || !locSelect) return;

      const targetWhId = parseInt(whSelect.value, 10);
      locSelect.innerHTML = '';

      if (!targetWhId) {
        locSelect.innerHTML = '<option value="">-- Önce Depo Seçiniz --</option>';
        updateEditCompositeLocation();
        return;
      }

      const selectedWh = warehousesData.find(w => w.id === targetWhId);
      if (!selectedWh) {
        locSelect.innerHTML = '<option value="Genel Raf">Genel Depo Alanı / Raf</option>';
        updateEditCompositeLocation();
        return;
      }

      const locs = selectedWh.lokasyonlar || selectedWh.locations || [];

      // Add default general shelf
      const defaultOpt = document.createElement('option');
      defaultOpt.value = 'Genel Raf';
      defaultOpt.textContent = `[${selectedWh.depoKodu || selectedWh.warehouseCode || 'DEP'}] Genel Depo Alanı / Raf`;
      locSelect.appendChild(defaultOpt);

      if (Array.isArray(locs) && locs.length > 0) {
        locs.forEach(loc => {
          const opt = document.createElement('option');
          const code = loc.lokasyonKodu || loc.locationCode;
          const detailParts = [];
          if (loc.koridor || loc.aisle) detailParts.push(loc.koridor || loc.aisle);
          if (loc.raf || loc.shelf) detailParts.push(loc.raf || loc.shelf);
          if (loc.goz || loc.bin) detailParts.push(loc.goz || loc.bin);
          const detailStr = detailParts.join(' / ');

          opt.value = code;
          opt.textContent = `📍 [${code}] ${detailStr ? detailStr + ' ' : ''}(Kapasite: ${loc.kapasite || loc.capacity || 1000})`;
          locSelect.appendChild(opt);
        });
      }

      updateEditCompositeLocation();
    }

    function onEditLocationChange() {
      updateEditCompositeLocation();
    }

    function updateEditCompositeLocation() {
      const whSelect = document.getElementById('editWarehouseSelect');
      const locSelect = document.getElementById('editLocationSelect');
      const hidden1 = document.getElementById('editWarehouseLocation');
      const hidden2 = document.getElementById('editDepoLokasyonu');

      if (!whSelect || !locSelect) return;

      const selectedOption = whSelect.options[whSelect.selectedIndex];
      if (!whSelect.value || !selectedOption || !selectedOption.value) {
        if (hidden1) hidden1.value = '';
        if (hidden2) hidden2.value = '';
        return;
      }

      const whCode = selectedOption.getAttribute('data-code') || '';
      const whName = selectedOption.getAttribute('data-name') || selectedOption.textContent.trim();
      const locVal = locSelect.value || 'Genel Raf';

      const compositeString = `${whCode ? '[' + whCode + '] ' : ''}${whName} / ${locVal}`;
      if (hidden1) hidden1.value = compositeString;
      if (hidden2) hidden2.value = compositeString;
    }

    function switchTab(tabId, event) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.glass-tab-btn').forEach(btn => btn.classList.remove('active'));
      
      const target = document.getElementById(tabId);
      if (target) target.classList.add('active');
      if (event && event.currentTarget) event.currentTarget.classList.add('active');
    }

    window.addEventListener('DOMContentLoaded', () => {
      // Try to match initial warehouse and location from currentLocString
      const whSelect = document.getElementById('editWarehouseSelect');
      if (whSelect && currentLocString) {
        for (let i = 0; i < whSelect.options.length; i++) {
          const opt = whSelect.options[i];
          const code = opt.getAttribute('data-code');
          const name = opt.getAttribute('data-name');
          if (code && currentLocString.includes(code)) {
            whSelect.selectedIndex = i;
            break;
          }
          if (name && currentLocString.includes(name)) {
            whSelect.selectedIndex = i;
            break;
          }
        }
        if (whSelect.selectedIndex > 0) {
          onEditWarehouseChange();
          const locSelect = document.getElementById('editLocationSelect');
          if (locSelect) {
            for (let j = 0; j < locSelect.options.length; j++) {
              const lOpt = locSelect.options[j];
              if (lOpt.value && currentLocString.includes(lOpt.value)) {
                locSelect.selectedIndex = j;
                break;
              }
            }
          }
        }
      }
    });
  </script>
</body>
</html>
