<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Stok Kartı Ekle — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Tab Container & Aesthetics */
    .form-tabs-container {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
    }

    .form-tabs-header {
      display: flex;
      gap: 12px;
      border-bottom: 2px solid var(--border);
      padding-bottom: 12px;
      margin-bottom: 28px;
    }

    .form-tab-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .form-tab-btn:hover {
      color: var(--text-primary);
      background: rgba(255, 255, 255, 0.05);
    }
    .form-tab-btn.active {
      color: #ffffff;
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
    }

    .tab-content {
      display: none;
      animation: fadeIn 0.3s ease;
    }
    .tab-content.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Ultra Aesthetic Input Styling */
    .aesthetic-group {
      margin-bottom: 22px;
    }
    .aesthetic-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      padding: 14px 16px;
      border-radius: 12px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }
    .aesthetic-input::placeholder {
      color: #475569;
    }
    .aesthetic-input[readonly] {
      background: #090d16;
      border-color: #334155;
      color: #818cf8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      cursor: not-allowed;
    }

    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .form-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

    /* Footer Buttons */
    .tab-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 32px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .btn-nav-secondary {
      background: #1e293b;
      color: #94a3b8;
      border: 1px solid #334155;
      padding: 12px 22px;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-nav-secondary:hover {
      color: #fff;
      background: #334155;
    }
    .btn-submit-glow {
      background: linear-gradient(135deg, #10b981, #059669);
      color: #ffffff;
      font-weight: 800;
      font-size: 1rem;
      padding: 14px 32px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .btn-submit-glow:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(16, 185, 129, 0.55);
    }

    /* Supplier Selector Card & Modal Styles */
    .supplier-selector-box {
      background: #0f172a;
      border: 1.5px solid #1e293b;
      border-radius: 14px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      cursor: pointer;
      transition: all 0.25s ease;
    }
    .supplier-selector-box:hover {
      border-color: #6366f1;
      background: #131d38;
      box-shadow: 0 4px 20px rgba(99, 102, 241, 0.25);
    }
    .ss-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(99, 102, 241, 0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      flex-shrink: 0;
    }
    .ss-details {
      flex: 1;
    }
    .ss-title {
      font-size: 0.98rem;
      font-weight: 800;
      color: #f8fafc;
      margin-bottom: 2px;
    }
    .ss-sub {
      font-size: 0.82rem;
      color: #94a3b8;
    }
    .ss-btn {
      background: #1e293b;
      border: 1px solid #334155;
      color: #818cf8;
      padding: 9px 16px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 6px;
      pointer-events: none;
    }

    /* Modal Overlay & Card */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.78);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      animation: fadeIn 0.2s ease;
    }
    .modal-card {
      background: #0f172a;
      border: 1.5px solid #334155;
      border-radius: 20px;
      width: 92%;
      max-width: 840px;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
      overflow: hidden;
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 24px 28px 16px 28px;
      border-bottom: 1px solid #1e293b;
    }
    .modal-close-btn {
      background: #1e293b;
      border: 1px solid #334155;
      color: #94a3b8;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      font-size: 1.1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .modal-close-btn:hover {
      color: #ffffff;
      background: #ef4444;
      border-color: #ef4444;
    }
    .modal-search-wrap {
      padding: 16px 28px 10px 28px;
    }
    .supplier-modal-list {
      flex: 1;
      overflow-y: auto;
      padding: 10px 28px 20px 28px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .supplier-item-card {
      background: #131d38;
      border: 1.5px solid #1e293b;
      border-radius: 14px;
      padding: 14px 16px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .supplier-item-card:hover {
      border-color: #4f46e5;
      background: #1a264a;
    }
    .supplier-item-card.selected {
      border-color: #10b981;
      background: rgba(16, 185, 129, 0.09);
      box-shadow: 0 0 16px rgba(16, 185, 129, 0.25);
    }
    .sic-radio-wrap {
      padding-top: 3px;
    }
    .sic-checkbox {
      width: 20px;
      height: 20px;
      accent-color: #10b981;
      cursor: pointer;
      pointer-events: none;
    }
    .sic-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }
    .sic-content {
      flex: 1;
    }
    .sic-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .sic-title-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .sic-code {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      color: #818cf8;
      font-size: 0.85rem;
    }
    .sic-title {
      font-size: 0.95rem;
      color: #f8fafc;
      font-weight: 800;
    }
    .sic-official {
      font-size: 0.8rem;
      color: #94a3b8;
    }
    .sic-desc {
      font-size: 0.8rem;
      color: #94a3b8;
      margin-top: 4px;
      line-height: 1.4;
    }
    .sic-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;
    }
    .sic-badge {
      background: rgba(15, 23, 42, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.74rem;
      color: #cbd5e1;
      font-weight: 500;
    }
    .modal-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 28px;
      border-top: 1px solid #1e293b;
      background: #090e1a;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>

      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>

      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link active">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>

      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a>
      </div>
    </header>

    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Yeni Stok Kartı Oluştur</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Sisteme yeni malzeme, hammadde veya mamul ürün tanımlayın.</p>
        </div>
        <a href="/stock/items" class="btn btn-secondary" style="border-radius: 10px;">← Stok Kartları Listesi</a>
      </div>

      <% if (error) { %>
        <div style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3); padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= error %>
        </div>
      <% } %>

      <form action="/stock/items/add" method="POST" id="addStockForm">
        <div class="form-tabs-container">
          <!-- Interactive Tab Buttons Header -->
          <div class="form-tabs-header">
            <button type="button" class="form-tab-btn active" id="tabBtn-1" onclick="switchTab(1)">
              <span>📦</span> 1. Temel Tanım
            </button>
            <button type="button" class="form-tab-btn" id="tabBtn-2" onclick="switchTab(2)">
              <span>📊</span> 2. Stok Seviyeleri
            </button>
            <button type="button" class="form-tab-btn" id="tabBtn-3" onclick="switchTab(3)">
              <span>💰</span> 3. Fiyat & Tedarik
            </button>
            <button type="button" class="form-tab-btn" id="tabBtn-4" onclick="switchTab(4)">
              <span>📝</span> 4. Notlar & Açıklama
            </button>
          </div>

          <!-- TAB 1: TEMEL TANIM -->
          <div class="tab-content active" id="tabContent-1">
            <div class="form-grid-3">
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Stok Kodu (Otomatik)</span>
                  <span style="color: #6366f1; font-size: 0.72rem;">🔒 KİLİTLİ KOD</span>
                </label>
                <input type="text" name="stockCode" value="<%= nextCode %>" class="aesthetic-input" readonly>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Barkod Numarası</label>
                <input type="text" name="barcode" placeholder="Örn: 8690123456789" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Malzeme / Ürün Adı *</label>
                <input type="text" name="name" placeholder="Örn: Paslanmaz Çelik Cıvata M8x50" class="aesthetic-input" required>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Kategori *</label>
                <select name="category" id="categorySelect" class="aesthetic-input" onchange="handleCategoryChange(this)" required style="cursor: pointer;">
                  <% CATEGORIES.forEach(cat => { %>
                    <% const val = typeof cat === 'object' ? cat.value : cat; %>
                    <% const lbl = typeof cat === 'object' ? cat.label : cat; %>
                    <option value="<%= val %>"><%= lbl %></option>
                  <% }); %>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Ölçü Birimi *</label>
                <select name="unit" class="aesthetic-input" required style="cursor: pointer;">
                  <option value="Adet">Adet</option>
                  <option value="Kg">Kilogram (Kg)</option>
                  <option value="Lt">Litre (Lt)</option>
                  <option value="Mt">Metre (Mt)</option>
                  <option value="M2">Metrekare (M²)</option>
                  <option value="M3">Metreküp (M³)</option>
                  <option value="Paket">Paket</option>
                  <option value="Koli">Koli</option>
                  <option value="Ton">Ton</option>
                  <option value="Set">Set</option>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Tedarik Yöntemi *</span>
                  <span id="procurementHint" style="color: #818cf8; font-size: 0.72rem;">🔄 SÜREÇ TÜRÜ</span>
                </label>
                <select name="procurementMethod" id="procurementMethodSelect" class="aesthetic-input" required style="cursor: pointer;">
                  <option value="Satın Alma" id="optProcurementSatinalma" <%= (formData && formData.procurementMethod === 'Satın Alma') ? 'selected' : '' %>>🛒 Satın Alma (Dış Tedarikçiden Alınır)</option>
                  <option value="Üretim" id="optProcurementUretim" <%= (formData && formData.procurementMethod === 'Üretim') ? 'selected' : '' %>>⚙️ Üretim (Fabrikada İmal Edilir)</option>
                </select>
              </div>

              <!-- MODAL CHECKBOX TEDARİKÇİ & ÜRETİCİ SEÇİCİ KARTI -->
              <div class="aesthetic-group" style="grid-column: span 3;">
                <label class="aesthetic-label">
                  <span>Ana Tedarikçi / Üretici Kaynağı *</span>
                  <span style="color: #818cf8; font-size: 0.72rem;">🏢 KİLİTLİ TEDARİKÇİ & İMALAT KARTI</span>
                </label>
                
                <div class="supplier-selector-box" onclick="openSupplierModal()" id="supplierBoxBtn">
                  <div class="ss-icon" id="selectedSupplierIcon">🏢</div>
                  <div class="ss-details">
                    <div class="ss-title" id="selectedSupplierTitle">Tedarikçi / Üretici Seçiniz...</div>
                    <div class="ss-sub" id="selectedSupplierSub">Sistemdeki aktif tedarikçi kartlarından birini veya Fabrika İçi Üretim seçeneğini belirleyin.</div>
                  </div>
                  <button type="button" class="ss-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Tedarikçi Seç (Modal)
                  </button>
                </div>

                <!-- Hidden form inputs -->
                <input type="hidden" name="tedarikciId" id="inputTedarikciId" value="">
                <input type="hidden" name="supplier" id="inputSupplierName" value="">
                <input type="hidden" name="tedarikci" id="inputTedarikciName" value="">
                <input type="hidden" name="brand" id="inputBrandName" value="">
              </div>
            </div>
          </div>

          <!-- TAB 2: STOK SEVİYELERİ -->
          <div class="tab-content" id="tabContent-2">
            <div class="form-grid-2">
              <div class="aesthetic-group">
                <label class="aesthetic-label">Başlangıç Mevcut Stok Miktarı</label>
                <input type="number" name="currentStock" value="0" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Asgari Stok Seviyesi (Min Alert) *</span>
                  <span style="color: #f43f5e; font-size: 0.72rem;">🚨 UYARI LİMİTİ</span>
                </label>
                <input type="number" name="minStock" value="10" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Azami Stok Seviyesi (Max Limit)</label>
                <input type="number" name="maxStock" value="1000" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Varsayılan Depo *</span>
                  <span style="color: #34d399; font-size: 0.72rem;">🏬 DİNAMİK DEPO LİSTESİ</span>
                </label>
                <select id="warehouseSelect" name="warehouseSelect" class="aesthetic-input" style="cursor: pointer;" onchange="onWarehouseChange()" required>
                  <option value="">-- Depolar Kartından Varsayılan Depoyu Seçiniz --</option>
                  <% if (typeof warehouses !== 'undefined' && warehouses && warehouses.length > 0) { %>
                    <% warehouses.forEach(wh => { %>
                      <option value="<%= wh.id %>" data-code="<%= wh.depoKodu || wh.warehouseCode %>" data-name="<%= wh.ad || wh.name %>">
                        [<%= wh.depoKodu || wh.warehouseCode %>] <%= wh.ad || wh.name %> (<%= wh.tur || wh.type %> — <%= wh.sehir || wh.city || 'İstanbul' %>)
                      </option>
                    <% }); %>
                  <% } else { %>
                    <option value="1" data-code="DEP-001" data-name="Ana Hammadde & Üretim Ambarı">[DEP-001] Ana Hammadde & Üretim Ambarı (Hammadde — İstanbul)</option>
                    <option value="2" data-code="DEP-002" data-name="Gebze Sevkiyat & Lojistik Deposu">[DEP-002] Gebze Sevkiyat & Lojistik Deposu (Sevkiyat — Kocaeli)</option>
                  <% } %>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Depo İçi Lokasyon / Raf / Göz</span>
                  <span style="color: #818cf8; font-size: 0.72rem;">📍 LOKASYON HARİTASI</span>
                </label>
                <select id="locationSelect" name="locationSelect" class="aesthetic-input" style="cursor: pointer;" onchange="onLocationChange()">
                  <option value="">-- Önce Depo Seçiniz --</option>
                </select>
                <input type="hidden" id="warehouseLocation" name="warehouseLocation" value="">
                <input type="hidden" id="depoLokasyonu" name="depoLokasyonu" value="">
              </div>
            </div>
          </div>

          <!-- TAB 3: FİYAT & TEDARİK -->
          <div class="tab-content" id="tabContent-3">
            <div class="form-grid-2">
              <div class="aesthetic-group">
                <label class="aesthetic-label">Birim Alış Fiyatı (TL)</label>
                <input type="number" name="purchasePrice" value="0.00" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Birim Satış Fiyatı (TL)</label>
                <input type="number" name="salePrice" value="0.00" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">KDV Oranı (%)</label>
                <select name="taxRate" class="aesthetic-input" style="cursor: pointer;">
                  <option value="20">KDV %20 (Genel Standard)</option>
                  <option value="10">KDV %10 (Gıda / Hizmet)</option>
                  <option value="1">KDV %1 (İndirimli)</option>
                  <option value="0">KDV %0 (Muaf)</option>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Ana Tedarikçi / Üretici Kaynağı</span>
                  <span style="color: #38bdf8; font-size: 0.72rem;">🔗 OTOMATİK EŞLEŞME</span>
                </label>
                <div style="display: flex; gap: 10px;">
                  <input type="text" id="tab3SupplierDisplay" class="aesthetic-input" placeholder="Tedarikçi Seçilmedi" readonly style="flex: 1; cursor: pointer;" onclick="openSupplierModal()">
                  <button type="button" class="btn-nav-secondary" onclick="openSupplierModal()" style="padding: 10px 16px; white-space: nowrap;">
                    🔍 Değiştir
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 4: NOTLAR & AÇIKLAMA -->
          <div class="tab-content" id="tabContent-4">
            <div class="aesthetic-group">
              <label class="aesthetic-label">Malzeme Teknik Açıklaması & Spesifikasyonlar</label>
              <textarea name="description" class="aesthetic-input" rows="5" placeholder="Ürün teknik resim detayları, toleranslar veya imalat standartları..."></textarea>
            </div>
          </div>

          <!-- TAB FOOTER NAVIGATION -->
          <div class="tab-footer">
            <div style="display: flex; gap: 12px;">
              <button type="button" class="btn-nav-secondary" id="btnPrev" onclick="navigateTab(-1)" style="display: none;">← Önceki Adım</button>
              <button type="button" class="btn-nav-secondary" id="btnNext" onclick="navigateTab(1)">Sonraki Adım →</button>
            </div>

            <button type="submit" class="btn-submit-glow">
              <span>📦</span> Stok Kartını Kaydet ve Yayınla
            </button>
          </div>
        </div>
      </form>

      <!-- TEDARİKÇİ SEÇİM MODALI (TEK SEÇİMLİ CHECKBOX / RADIO KARTLARI) -->
      <div id="supplierModal" class="modal-overlay" style="display: none;">
        <div class="modal-card">
          <div class="modal-header">
            <div>
              <h2 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 8px;">
                <span>🏢</span> Tedarikçi & Üretici Seçimi
              </h2>
              <p style="color: #94a3b8; font-size: 0.85rem; margin-top: 4px;">
                Bu stok kartının bağlanacağı ana tedarikçiyi veya Fabrika İçi İmalat seçeneğini belirleyin (Yalnızca 1 adet seçilebilir).
              </p>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeSupplierModal()">✕</button>
          </div>

          <!-- Canlı Arama Kutusu -->
          <div class="modal-search-wrap">
            <input type="text" id="supplierSearchInput" class="aesthetic-input" placeholder="🔍 Tedarikçi kodu, firma adı, kategori veya şehre göre filtrele..." oninput="filterSuppliers(this.value)">
          </div>

          <!-- Kaydırılabilir Tedarikçi Listesi -->
          <div class="supplier-modal-list" id="supplierModalList">
            
            <!-- Seçenek 0: Fabrika İçi Üretim -->
            <div class="supplier-item-card" 
                 data-id="FABRIKA_ICI" 
                 data-code="FABRIKA" 
                 data-name="Fabrika İçi Üretim" 
                 data-trade="Fabrika İçi Üretim" 
                 data-type="production"
                 data-cat="Üretim / İmalat"
                 onclick="selectSupplierOption(this)">
              <div class="sic-radio-wrap">
                <input type="checkbox" class="sic-checkbox" name="supplierCheckbox" value="FABRIKA_ICI">
              </div>
              <div class="sic-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">⚙️</div>
              <div class="sic-content">
                <div class="sic-header">
                  <strong class="sic-title" style="color: #a5b4fc;">Fabrika İçi Üretim (Kendi Tesisimiz / İmalat)</strong>
                  <span class="badge" style="background: rgba(99, 102, 241, 0.2); color: #818cf8; font-weight: 800;">⚙️ Fabrika İmalatı</span>
                </div>
                <div class="sic-desc">Dış tedarikçi yoktur. Ürün kendi üretim hatlarımızda, ürün reçetesi ve iş emirlerine bağlı olarak imal edilir.</div>
                <div class="sic-badges">
                  <span class="sic-badge">🏭 Kendi İmalat Tesisimiz</span>
                  <span class="sic-badge">📜 Ürün Reçetesi & Rota</span>
                  <span class="sic-badge">⚡ Anlık Üretim Planlama</span>
                </div>
              </div>
            </div>

            <!-- Gerçek Tedarikçiler -->
            <% if (typeof suppliers !== 'undefined' && suppliers && suppliers.length > 0) { %>
              <% suppliers.forEach(sup => { %>
                <div class="supplier-item-card" 
                     data-id="<%= sup.id %>" 
                     data-code="<%= sup.tedarikciKodu %>" 
                     data-name="<%= sup.firmaAdi %>" 
                     data-trade="<%= sup.ticariAd || sup.firmaAdi %>" 
                     data-type="purchase" 
                     data-cat="<%= sup.kategori || 'Hammadde' %>"
                     data-lead="<%= sup.terminSuresi || 7 %>"
                     data-score="<%= sup.performansSkoru || 85 %>"
                     data-city="<%= sup.sehir || 'Türkiye' %>"
                     onclick="selectSupplierOption(this)">
                  <div class="sic-radio-wrap">
                    <input type="checkbox" class="sic-checkbox" name="supplierCheckbox" value="<%= sup.id %>">
                  </div>
                  <div class="sic-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">🏢</div>
                  <div class="sic-content">
                    <div class="sic-header">
                      <div class="sic-title-group">
                        <span class="sic-code"><%= sup.tedarikciKodu %></span>
                        <strong class="sic-title"><%= sup.ticariAd || sup.firmaAdi %></strong>
                        <span class="sic-official">(<%= sup.firmaAdi %>)</span>
                      </div>
                      <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 800;">🛒 Dış Tedarikçi</span>
                    </div>
                    <div class="sic-badges">
                      <span class="sic-badge">🔩 <%= sup.kategori || 'Hammadde Tedarikçisi' %></span>
                      <span class="sic-badge">⏱️ <%= sup.terminSuresi || 7 %> Gün Termin</span>
                      <span class="sic-badge">⭐ <%= parseFloat(sup.performansSkoru || 85).toFixed(1) %> / 100 Puan</span>
                      <span class="sic-badge">📍 <%= sup.sehir || 'Türkiye' %></span>
                      <span class="sic-badge">👤 <%= sup.ilgiliKisi || 'Satış Temsilcisi' %></span>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } %>

          </div>

          <!-- Modal Alt Kısım -->
          <div class="modal-footer">
            <div id="modalSelectedIndicator" style="font-size: 0.85rem; color: #94a3b8;">
              Henüz bir tedarikçi seçilmedi.
            </div>
            <div style="display: flex; gap: 12px;">
              <button type="button" class="btn-nav-secondary" onclick="closeSupplierModal()">İptal</button>
              <button type="button" class="btn-submit-glow" onclick="confirmSupplierSelection()" style="padding: 10px 24px; font-size: 0.9rem;">
                ✓ Seçimi Onayla
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    let currentTab = 1;
    const totalTabs = 4;

    function switchTab(tabIndex) {
      currentTab = tabIndex;
      for (let i = 1; i <= totalTabs; i++) {
        const btn = document.getElementById(`tabBtn-${i}`);
        const content = document.getElementById(`tabContent-${i}`);
        if (i === tabIndex) {
          btn.classList.add('active');
          content.classList.add('active');
        } else {
          btn.classList.remove('active');
          content.classList.remove('active');
        }
      }
      updateNavButtons();
    }

    function navigateTab(direction) {
      const next = currentTab + direction;
      if (next >= 1 && next <= totalTabs) {
        switchTab(next);
      }
    }

    function updateNavButtons() {
      const btnPrev = document.getElementById('btnPrev');
      const btnNext = document.getElementById('btnNext');
      if (btnPrev) btnPrev.style.display = currentTab === 1 ? 'none' : 'block';
      if (btnNext) btnNext.style.display = currentTab === totalTabs ? 'none' : 'block';
    }

    // --- MODAL & TEDARİKÇİ SEÇİM MANTIĞI ---
    let tempSelectedSupplier = null;

    function openSupplierModal() {
      const modal = document.getElementById('supplierModal');
      if (modal) {
        modal.style.display = 'flex';
        document.getElementById('supplierSearchInput').value = '';
        filterSuppliers('');
      }
    }

    function closeSupplierModal() {
      const modal = document.getElementById('supplierModal');
      if (modal) modal.style.display = 'none';
    }

    function selectSupplierOption(cardEl) {
      if (!cardEl) return;
      
      // Uncheck all other checkboxes and remove .selected class
      const allCards = document.querySelectorAll('.supplier-item-card');
      allCards.forEach(c => {
        c.classList.remove('selected');
        const chk = c.querySelector('.sic-checkbox');
        if (chk) chk.checked = false;
      });

      // Check clicked card
      cardEl.classList.add('selected');
      const clickedChk = cardEl.querySelector('.sic-checkbox');
      if (clickedChk) clickedChk.checked = true;

      // Store temp selection data
      tempSelectedSupplier = {
        id: cardEl.getAttribute('data-id'),
        code: cardEl.getAttribute('data-code'),
        name: cardEl.getAttribute('data-name'),
        trade: cardEl.getAttribute('data-trade'),
        type: cardEl.getAttribute('data-type'),
        cat: cardEl.getAttribute('data-cat'),
        lead: cardEl.getAttribute('data-lead'),
        score: cardEl.getAttribute('data-score'),
        city: cardEl.getAttribute('data-city')
      };

      const indicator = document.getElementById('modalSelectedIndicator');
      if (indicator) {
        if (tempSelectedSupplier.id === 'FABRIKA_ICI') {
          indicator.innerHTML = `<span style="color: #818cf8; font-weight: 700;">⚙️ Seçilen: Fabrika İçi Üretim</span> (Kendi İmalatımız)`;
        } else {
          indicator.innerHTML = `<span style="color: #34d399; font-weight: 700;">✓ Seçilen: [${tempSelectedSupplier.code}] ${tempSelectedSupplier.trade}</span> (${tempSelectedSupplier.name})`;
        }
      }
    }

    function confirmSupplierSelection() {
      if (!tempSelectedSupplier) {
        alert('Lütfen listeden bir tedarikçi veya Fabrika İçi Üretim seçeneğini işaretleyiniz.');
        return;
      }

      applySupplierSelection(tempSelectedSupplier);
      closeSupplierModal();
    }

    function applySupplierSelection(sup) {
      const inputId = document.getElementById('inputTedarikciId');
      const inputSup = document.getElementById('inputSupplierName');
      const inputTed = document.getElementById('inputTedarikciName');
      const inputBrand = document.getElementById('inputBrandName');
      const icon = document.getElementById('selectedSupplierIcon');
      const title = document.getElementById('selectedSupplierTitle');
      const sub = document.getElementById('selectedSupplierSub');
      const tab3Disp = document.getElementById('tab3SupplierDisplay');
      const procSelect = document.getElementById('procurementMethodSelect');

      if (sup.id === 'FABRIKA_ICI') {
        if (inputId) inputId.value = '';
        if (inputSup) inputSup.value = 'Fabrika İçi Üretim';
        if (inputTed) inputTed.value = 'Fabrika İçi Üretim';
        if (inputBrand) inputBrand.value = 'Fabrika İçi Üretim';
        if (icon) { icon.textContent = '⚙️'; icon.style.background = 'rgba(99, 102, 241, 0.15)'; icon.style.color = '#818cf8'; }
        if (title) title.innerHTML = '<span style="color: #a5b4fc;">⚙️ Fabrika İçi Üretim (Kendi İmalat Tesisimiz)</span>';
        if (sub) sub.textContent = 'Dış tedarikçi yoktur. Ürün reçetesine göre fabrikada iş emirleri ile üretilir.';
        if (tab3Disp) tab3Disp.value = '⚙️ Fabrika İçi Üretim (Kendi Tesisimiz)';
        if (procSelect) procSelect.value = 'Üretim';
      } else {
        if (inputId) inputId.value = sup.id;
        const displayName = sup.trade || sup.name;
        if (inputSup) inputSup.value = displayName;
        if (inputTed) inputTed.value = displayName;
        if (inputBrand) inputBrand.value = displayName;
        if (icon) { icon.textContent = '🏢'; icon.style.background = 'rgba(16, 185, 129, 0.15)'; icon.style.color = '#34d399'; }
        if (title) title.innerHTML = `<strong style="color: #34d399;">[${sup.code}] ${displayName}</strong> <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 500;">(${sup.name})</span>`;
        if (sub) sub.textContent = `${sup.cat || 'Hammadde Tedarikçisi'} • ⏱️ ${sup.lead || 7} Gün Termin • ⭐ ${parseFloat(sup.score || 85).toFixed(1)} Puan • 📍 ${sup.city || 'Türkiye'}`;
        if (tab3Disp) tab3Disp.value = `[${sup.code}] ${displayName}`;
        if (procSelect) procSelect.value = 'Satın Alma';
      }
    }

    function filterSuppliers(query) {
      const q = (query || '').toLowerCase().trim();
      const cards = document.querySelectorAll('.supplier-item-card');
      cards.forEach(card => {
        const text = card.textContent.toLowerCase();
        if (!q || text.includes(q)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function handleCategoryChange(selectEl) {
      const cat = selectEl ? selectEl.value : document.getElementById('categorySelect').value;
      const procSelect = document.getElementById('procurementMethodSelect');
      const optSatinalma = document.getElementById('optProcurementSatinalma');
      const optUretim = document.getElementById('optProcurementUretim');
      const hint = document.getElementById('procurementHint');

      if (cat === 'Mamul') {
        procSelect.value = 'Üretim';
        optUretim.disabled = false;
        optSatinalma.disabled = true;
        if (hint) hint.textContent = '🔒 MAMUL ÜRÜNLER YALNIZCA ÜRETİLİR';
        
        // Auto select Fabrika İçi
        applySupplierSelection({
          id: 'FABRIKA_ICI',
          code: 'FABRIKA',
          name: 'Fabrika İçi Üretim',
          trade: 'Fabrika İçi Üretim',
          type: 'production'
        });
      } else if (['Hammadde', 'Ticari_Mal', 'Ticari Mal'].includes(cat)) {
        procSelect.value = 'Satın Alma';
        optUretim.disabled = true;
        optSatinalma.disabled = false;
        if (hint) hint.textContent = '🔒 HAMMADDE/TİCARİ MAL SATIN ALINIR';

        // If Fabrika İçi was selected, set default prompt or first supplier
        const inputId = document.getElementById('inputTedarikciId');
        if (!inputId.value) {
          const firstSupCard = document.querySelector('.supplier-item-card[data-type="purchase"]');
          if (firstSupCard) {
            selectSupplierOption(firstSupCard);
            confirmSupplierSelection();
          }
        }
      } else if (['Yarı_Mamul', 'Yari_Mamul'].includes(cat)) {
        optUretim.disabled = false;
        optSatinalma.disabled = false;
        if (hint) hint.textContent = '🔄 ÜRETİM VEYA SATIN ALMA SEÇİLEBİLİR';
      } else {
        optUretim.disabled = false;
        optSatinalma.disabled = false;
        if (hint) hint.textContent = '🔄 SÜREÇ TÜRÜ';
      }
    }

    const warehousesData = <%- JSON.stringify(typeof warehouses !== 'undefined' && warehouses ? warehouses : []) %>;

    function onWarehouseChange() {
      const whSelect = document.getElementById('warehouseSelect');
      const locSelect = document.getElementById('locationSelect');
      if (!whSelect || !locSelect) return;

      const targetWhId = parseInt(whSelect.value, 10);
      locSelect.innerHTML = '';

      if (!targetWhId) {
        locSelect.innerHTML = '<option value="">-- Önce Depo Seçiniz --</option>';
        updateCompositeLocation();
        return;
      }

      const selectedWh = warehousesData.find(w => w.id === targetWhId);
      if (!selectedWh) {
        locSelect.innerHTML = '<option value="Genel Raf">Genel Depo Alanı / Raf</option>';
        updateCompositeLocation();
        return;
      }

      const locs = selectedWh.lokasyonlar || selectedWh.locations || [];

      // Add default general shelf
      const defaultOpt = document.createElement('option');
      defaultOpt.value = 'Genel Raf';
      defaultOpt.textContent = `[${selectedWh.depoKodu || selectedWh.warehouseCode || 'DEP'}] Genel Depo Alanı / Raf`;
      locSelect.appendChild(defaultOpt);

      if (Array.isArray(locs) && locs.length > 0) {
        locs.forEach(loc => {
          const opt = document.createElement('option');
          const code = loc.lokasyonKodu || loc.locationCode;
          const detailParts = [];
          if (loc.koridor || loc.aisle) detailParts.push(loc.koridor || loc.aisle);
          if (loc.raf || loc.shelf) detailParts.push(loc.raf || loc.shelf);
          if (loc.goz || loc.bin) detailParts.push(loc.goz || loc.bin);
          const detailStr = detailParts.join(' / ');

          opt.value = code;

          if (loc.isOccupied && loc.occupiedBy) {
            opt.disabled = true;
            opt.style.color = '#fb7185';
            opt.style.background = '#1e1b2e';
            opt.textContent = `🚫 [${code}] ${detailStr ? detailStr + ' ' : ''}— DOLU ([${loc.occupiedBy.stokKodu}] ${loc.occupiedBy.name})`;
          } else {
            opt.style.color = '#34d399';
            opt.textContent = `📍 [${code}] ${detailStr ? detailStr + ' ' : ''}— BOŞ (Kapasite: ${loc.kapasite || loc.capacity || 1000})`;
          }

          locSelect.appendChild(opt);
        });
      }

      updateCompositeLocation();
    }

    function onLocationChange() {
      updateCompositeLocation();
    }

    function updateCompositeLocation() {
      const whSelect = document.getElementById('warehouseSelect');
      const locSelect = document.getElementById('locationSelect');
      const hidden1 = document.getElementById('warehouseLocation');
      const hidden2 = document.getElementById('depoLokasyonu');

      if (!whSelect || !locSelect) return;

      const selectedOption = whSelect.options[whSelect.selectedIndex];
      if (!whSelect.value || !selectedOption || !selectedOption.value) {
        if (hidden1) hidden1.value = '';
        if (hidden2) hidden2.value = '';
        return;
      }

      const whCode = selectedOption.getAttribute('data-code') || '';
      const whName = selectedOption.getAttribute('data-name') || selectedOption.textContent.trim();
      const locVal = locSelect.value || 'Genel Raf';

      const compositeString = `${whCode ? '[' + whCode + '] ' : ''}${whName} / ${locVal}`;
      if (hidden1) hidden1.value = compositeString;
      if (hidden2) hidden2.value = compositeString;
    }

    window.addEventListener('DOMContentLoaded', () => {
      const catSelect = document.getElementById('categorySelect');
      if (catSelect) handleCategoryChange(catSelect);

      const whSelect = document.getElementById('warehouseSelect');
      if (whSelect && whSelect.value) onWarehouseChange();
    });
  </script>
</body>
</html>
