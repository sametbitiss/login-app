<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Stok Kartı Ekle — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>

      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>

      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link active">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>

      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a>
      </div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/stock/analytics" class="msn-link">📊 Analitik</a>
        <a href="/stock/alerts" class="msn-link">🚨 Kritik Stok</a>
        <a href="/stock/valuation" class="msn-link">💰 Maliyetlendirme</a>
        <a href="/stock/items" class="msn-link active">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="msn-link">🏬 Depolar</a>
        <a href="/stock/lots" class="msn-link">🏷️ Lot & Seri No</a>
        <a href="/stock/goods-receipt" class="msn-link">📥 Mal Kabul</a>
        <a href="/stock/dispatch" class="msn-link">📤 Sevkiyat</a>
        <a href="/stock/transfers" class="msn-link">🔄 Transferler</a>
        <a href="/stock/counting" class="msn-link">📋 Sayım</a>
        <a href="/stock/terminal" class="msn-link">📱 RF El Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Yeni Stok Kartı Oluştur</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Yeni malzeme, hammadde veya mamul ürün tanımlayın.</p>
        </div>
        <a href="/stock/items" class="btn btn-secondary">← Stok Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div style="background: var(--rose-soft); color: var(--rose); border: 1px solid var(--rose); padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-weight: 600;">⚠️ <%= error %></div>
      <% } %>

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; box-shadow: var(--shadow-md);">
        <form action="/stock/items/add" method="POST">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label">Stok Kodu</label>
              <input type="text" name="stockCode" value="<%= nextCode %>" class="form-control" readonly>
            </div>
            <div class="form-group">
              <label class="form-label">Barkod Numarası</label>
              <input type="text" name="barcode" placeholder="Örn: 8690123456789" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Malzeme / Ürün Adı *</label>
              <input type="text" name="name" placeholder="Örn: Paslanmaz Çelik Cıvata M8x50" class="form-control" required>
            </div>
            <div class="form-group">
              <label class="form-label">Kategori *</label>
              <select name="category" class="form-control" required>
                <% CATEGORIES.forEach(cat => { %>
                  <option value="<%= cat %>"><%= cat %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Ölçü Birimi *</label>
              <select name="unit" class="form-control" required>
                <option value="Adet">Adet</option>
                <option value="Kg">Kilogram (Kg)</option>
                <option value="Lt">Litre (Lt)</option>
                <option value="Mt">Metre (Mt)</option>
                <option value="M2">Metrekare (M²)</option>
                <option value="M3">Metreküp (M³)</option>
                <option value="Paket">Paket</option>
                <option value="Koli">Koli</option>
                <option value="Ton">Ton</option>
                <option value="Set">Set</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Marka / Üretici</label>
              <input type="text" name="brand" placeholder="Örn: Erdemir / Bosch" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Başlangıç Mevcut Stok</label>
              <input type="number" name="currentStock" value="0" min="0" step="0.01" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Asgari Stok (Min Alert)</label>
              <input type="number" name="minStock" value="10" min="0" step="0.01" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Azami Stok (Max)</label>
              <input type="number" name="maxStock" value="1000" min="0" step="0.01" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Birim Alış Fiyatı (TL)</label>
              <input type="number" name="purchasePrice" value="0.00" min="0" step="0.01" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Birim Satış Fiyatı (TL)</label>
              <input type="number" name="salePrice" value="0.00" min="0" step="0.01" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">KDV Oranı (%)</label>
              <select name="taxRate" class="form-control">
                <option value="20">KDV %20</option>
                <option value="10">KDV %10</option>
                <option value="1">KDV %1</option>
                <option value="0">KDV %0</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Varsayılan Depo / Raf Konumu</label>
              <input type="text" name="warehouseLocation" placeholder="Örn: Depo-A / Raf-04" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Ana Tedarikçi</label>
              <input type="text" name="supplier" placeholder="Örn: Norm Bağlantı Elemanları A.Ş." class="form-control">
            </div>
          </div>
          <div class="form-group" style="margin-top: 16px;">
            <label class="form-label">Malzeme Açıklaması / Notlar</label>
            <textarea name="description" class="form-control" rows="2" placeholder="Ürün teknik özellikleri..."></textarea>
          </div>
          <div style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="submit" class="btn">📦 Stok Kartını Kaydet</button>
            <a href="/stock/items" class="btn btn-secondary">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
