<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Stok Kartı Ekle — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Tab Container & Aesthetics */
    .form-tabs-container {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
    }

    .form-tabs-header {
      display: flex;
      gap: 12px;
      border-bottom: 2px solid var(--border);
      padding-bottom: 12px;
      margin-bottom: 28px;
    }

    .form-tab-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .form-tab-btn:hover {
      color: var(--text-primary);
      background: rgba(255, 255, 255, 0.05);
    }
    .form-tab-btn.active {
      color: #ffffff;
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
    }

    .tab-content {
      display: none;
      animation: fadeIn 0.3s ease;
    }
    .tab-content.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Ultra Aesthetic Input Styling */
    .aesthetic-group {
      margin-bottom: 22px;
    }
    .aesthetic-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      padding: 14px 16px;
      border-radius: 12px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }
    .aesthetic-input::placeholder {
      color: #475569;
    }
    .aesthetic-input[readonly] {
      background: #090d16;
      border-color: #334155;
      color: #818cf8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      cursor: not-allowed;
    }

    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .form-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

    /* Footer Buttons */
    .tab-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 32px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .btn-nav-secondary {
      background: #1e293b;
      color: #94a3b8;
      border: 1px solid #334155;
      padding: 12px 22px;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-nav-secondary:hover {
      color: #fff;
      background: #334155;
    }
    .btn-submit-glow {
      background: linear-gradient(135deg, #10b981, #059669);
      color: #ffffff;
      font-weight: 800;
      font-size: 1rem;
      padding: 14px 32px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .btn-submit-glow:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(16, 185, 129, 0.55);
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>

      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>

      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link active">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>

      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a>
      </div>
    </header>

    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Yeni Stok Kartı Oluştur</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Sisteme yeni malzeme, hammadde veya mamul ürün tanımlayın.</p>
        </div>
        <a href="/stock/items" class="btn btn-secondary" style="border-radius: 10px;">← Stok Kartları Listesi</a>
      </div>

      <% if (error) { %>
        <div style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3); padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= error %>
        </div>
      <% } %>

      <form action="/stock/items/add" method="POST" id="addStockForm">
        <div class="form-tabs-container">
          <!-- Interactive Tab Buttons Header -->
          <div class="form-tabs-header">
            <button type="button" class="form-tab-btn active" id="tabBtn-1" onclick="switchTab(1)">
              <span>📦</span> 1. Temel Tanım
            </button>
            <button type="button" class="form-tab-btn" id="tabBtn-2" onclick="switchTab(2)">
              <span>📊</span> 2. Stok Seviyeleri
            </button>
            <button type="button" class="form-tab-btn" id="tabBtn-3" onclick="switchTab(3)">
              <span>💰</span> 3. Fiyat & Tedarik
            </button>
            <button type="button" class="form-tab-btn" id="tabBtn-4" onclick="switchTab(4)">
              <span>📝</span> 4. Notlar & Açıklama
            </button>
          </div>

          <!-- TAB 1: TEMEL TANIM -->
          <div class="tab-content active" id="tabContent-1">
            <div class="form-grid-3">
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Stok Kodu (Otomatik)</span>
                  <span style="color: #6366f1; font-size: 0.72rem;">🔒 KİLİTLİ KOD</span>
                </label>
                <input type="text" name="stockCode" value="<%= nextCode %>" class="aesthetic-input" readonly>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Barkod Numarası</label>
                <input type="text" name="barcode" placeholder="Örn: 8690123456789" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Malzeme / Ürün Adı *</label>
                <input type="text" name="name" placeholder="Örn: Paslanmaz Çelik Cıvata M8x50" class="aesthetic-input" required>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Kategori *</label>
                <select name="category" id="categorySelect" class="aesthetic-input" onchange="handleCategoryChange(this)" required style="cursor: pointer;">
                  <% CATEGORIES.forEach(cat => { %>
                    <% const val = typeof cat === 'object' ? cat.value : cat; %>
                    <% const lbl = typeof cat === 'object' ? cat.label : cat; %>
                    <option value="<%= val %>"><%= lbl %></option>
                  <% }); %>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Ölçü Birimi *</label>
                <select name="unit" class="aesthetic-input" required style="cursor: pointer;">
                  <option value="Adet">Adet</option>
                  <option value="Kg">Kilogram (Kg)</option>
                  <option value="Lt">Litre (Lt)</option>
                  <option value="Mt">Metre (Mt)</option>
                  <option value="M2">Metrekare (M²)</option>
                  <option value="M3">Metreküp (M³)</option>
                  <option value="Paket">Paket</option>
                  <option value="Koli">Koli</option>
                  <option value="Ton">Ton</option>
                  <option value="Set">Set</option>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Tedarik Yöntemi *</span>
                  <span id="procurementHint" style="color: #818cf8; font-size: 0.72rem;">🔄 SÜREÇ TÜRÜ</span>
                </label>
                <select name="procurementMethod" id="procurementMethodSelect" class="aesthetic-input" required style="cursor: pointer;">
                  <option value="Satın Alma" id="optProcurementSatinalma" <%= (formData && formData.procurementMethod === 'Satın Alma') ? 'selected' : '' %>>🛒 Satın Alma (Dış Tedarikçiden Alınır)</option>
                  <option value="Üretim" id="optProcurementUretim" <%= (formData && formData.procurementMethod === 'Üretim') ? 'selected' : '' %>>⚙️ Üretim (Fabrikada İmal Edilir)</option>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Marka / Üretici</label>
                <input type="text" name="brand" placeholder="Örn: Erdemir / Bosch" class="aesthetic-input">
              </div>
            </div>
          </div>

          <!-- TAB 2: STOK SEVİYELERİ -->
          <div class="tab-content" id="tabContent-2">
            <div class="form-grid-2">
              <div class="aesthetic-group">
                <label class="aesthetic-label">Başlangıç Mevcut Stok Miktarı</label>
                <input type="number" name="currentStock" value="0" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Asgari Stok Seviyesi (Min Alert) *</span>
                  <span style="color: #f43f5e; font-size: 0.72rem;">🚨 UYARI LİMİTİ</span>
                </label>
                <input type="number" name="minStock" value="10" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Azami Stok Seviyesi (Max Limit)</label>
                <input type="number" name="maxStock" value="1000" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>Varsayılan Depo *</span>
                  <span style="color: #34d399; font-size: 0.72rem;">🏬 DİNAMİK DEPO LİSTESİ</span>
                </label>
                <select name="warehouseLocation" class="aesthetic-input" style="cursor: pointer;">
                  <option value="">-- Depolar Kartından Varsayılan Depoyu Seçiniz --</option>
                  <% if (typeof warehouses !== 'undefined' && warehouses && warehouses.length > 0) { %>
                    <% warehouses.forEach(wh => { %>
                      <option value="<%= wh.name %>">[<%= wh.warehouseCode %>] <%= wh.name %> (<%= wh.type %> — <%= wh.city || 'İstanbul' %>)</option>
                    <% }); %>
                  <% } else { %>
                    <option value="Ana Depo">Ana Depo (Merkez)</option>
                    <option value="Hammadde Deposu">Hammadde Deposu</option>
                    <option value="Mamul Deposu">Mamul Deposu</option>
                  <% } %>
                </select>
              </div>
            </div>
          </div>

          <!-- TAB 3: FİYAT & TEDARİK -->
          <div class="tab-content" id="tabContent-3">
            <div class="form-grid-2">
              <div class="aesthetic-group">
                <label class="aesthetic-label">Birim Alış Fiyatı (TL)</label>
                <input type="number" name="purchasePrice" value="0.00" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Birim Satış Fiyatı (TL)</label>
                <input type="number" name="salePrice" value="0.00" min="0" step="0.01" class="aesthetic-input">
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">KDV Oranı (%)</label>
                <select name="taxRate" class="aesthetic-input" style="cursor: pointer;">
                  <option value="20">KDV %20 (Genel Standard)</option>
                  <option value="10">KDV %10 (Gıda / Hizmet)</option>
                  <option value="1">KDV %1 (İndirimli)</option>
                  <option value="0">KDV %0 (Muaf)</option>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Ana Tedarikçi Firma</label>
                <input type="text" name="supplier" placeholder="Örn: Norm Bağlantı Elemanları A.Ş." class="aesthetic-input">
              </div>
            </div>
          </div>

          <!-- TAB 4: NOTLAR & AÇIKLAMA -->
          <div class="tab-content" id="tabContent-4">
            <div class="aesthetic-group">
              <label class="aesthetic-label">Malzeme Teknik Açıklaması & Spesifikasyonlar</label>
              <textarea name="description" class="aesthetic-input" rows="5" placeholder="Ürün teknik resim detayları, toleranslar veya imalat standartları..."></textarea>
            </div>
          </div>

          <!-- TAB FOOTER NAVIGATION -->
          <div class="tab-footer">
            <div style="display: flex; gap: 12px;">
              <button type="button" class="btn-nav-secondary" id="btnPrev" onclick="navigateTab(-1)" style="display: none;">← Önceki Adım</button>
              <button type="button" class="btn-nav-secondary" id="btnNext" onclick="navigateTab(1)">Sonraki Adım →</button>
            </div>

            <button type="submit" class="btn-submit-glow">
              <span>📦</span> Stok Kartını Kaydet ve Yayınla
            </button>
          </div>
        </div>
      </form>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    let currentTab = 1;
    const totalTabs = 4;

    function switchTab(tabIndex) {
      currentTab = tabIndex;
      for (let i = 1; i <= totalTabs; i++) {
        const btn = document.getElementById(`tabBtn-${i}`);
        const content = document.getElementById(`tabContent-${i}`);
        if (i === tabIndex) {
          btn.classList.add('active');
          content.classList.add('active');
        } else {
          btn.classList.remove('active');
          content.classList.remove('active');
        }
      }
      updateNavButtons();
    }

    function navigateTab(direction) {
      const next = currentTab + direction;
      if (next >= 1 && next <= totalTabs) {
        switchTab(next);
      }
    }

    function handleCategoryChange(selectEl) {
      const cat = selectEl ? selectEl.value : document.getElementById('categorySelect').value;
      const procSelect = document.getElementById('procurementMethodSelect');
      const optSatinalma = document.getElementById('optProcurementSatinalma');
      const optUretim = document.getElementById('optProcurementUretim');
      const hint = document.getElementById('procurementHint');

      if (['Hammadde', 'Ticari_Mal', 'Ticari Mal'].includes(cat)) {
        procSelect.value = 'Satın Alma';
        optUretim.disabled = true;
        optSatinalma.disabled = false;
        if (hint) hint.textContent = '🔒 HAMMADDE/TİCARİ MAL SATIN ALINIR';
      } else if (['Mamul', 'Yarı_Mamul', 'Yari_Mamul'].includes(cat)) {
        optUretim.disabled = false;
        optSatinalma.disabled = false;
        if (!procSelect.value) procSelect.value = 'Üretim';
        if (hint) hint.textContent = '🔄 ÜRETİM VEYA SATIN ALMA SEÇİLEBİLİR';
      } else {
        optUretim.disabled = false;
        optSatinalma.disabled = false;
        if (hint) hint.textContent = '🔄 SÜREÇ TÜRÜ';
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      const catSelect = document.getElementById('categorySelect');
      if (catSelect) handleCategoryChange(catSelect);
    });
  </script>
</body>
</html>
