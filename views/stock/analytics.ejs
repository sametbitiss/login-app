<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stok & Depo Analitik Dashboard — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    .card-metric { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow-md); }
    .card-metric span { font-size: 0.8rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block; margin-bottom: 8px; letter-spacing: 0.05em; }
    .card-metric strong { font-size: 1.6rem; font-weight: 800; color: var(--text-primary); }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 28px; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
    .chart-box { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: var(--shadow-md); }
    .chart-box h3 { font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin: 0 0 20px 0; }
  </style>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>

      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link active">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>

      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>

      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a>
      </div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/stock/analytics" class="msn-link active">📊 Analitik</a>
        <a href="/stock/alerts" class="msn-link">🚨 Kritik Stok</a>
        <a href="/stock/valuation" class="msn-link">💰 Maliyetlendirme</a>
        <a href="/stock/items" class="msn-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="msn-link">🏬 Depolar</a>
        <a href="/stock/lots" class="msn-link">🏷️ Lot & Seri No</a>
        <a href="/stock/goods-receipt" class="msn-link">📥 Mal Kabul</a>
        <a href="/stock/dispatch" class="msn-link">📤 Sevkiyat</a>
        <a href="/stock/transfers" class="msn-link">🔄 Transferler</a>
        <a href="/stock/counting" class="msn-link">📋 Sayım</a>
        <a href="/stock/terminal" class="msn-link">📱 RF El Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Stok & Depo Analitik Dashboard</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Toplu envanter değerleri, depo doluluk oranları, maliyet analizi ve kritik stok takibi.</p>
        </div>
      </div>

      <!-- KPI Grid -->
      <div class="grid-4">
        <div class="card-metric">
          <span>Toplam Stok Kartı</span>
          <strong style="color: var(--indigo);"><%= stats.totalItems %> Çeşit</strong>
        </div>
        <div class="card-metric">
          <span>Kritik Stok Uyarısı</span>
          <strong style="color: var(--rose);"><%= stats.lowStockCount %> Malzeme</strong>
        </div>
        <div class="card-metric">
          <span>Toplam Envanter Değeri (FIFO)</span>
          <strong style="color: var(--emerald);"><%= Number(valuationReport.totalFifoValuation).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> ₺</strong>
        </div>
        <div class="card-metric">
          <span>Aktif Depo Sayısı</span>
          <strong style="color: var(--cyan);"><%= warehouses.length %> Depo</strong>
        </div>
      </div>

      <!-- Charts -->
      <div class="grid-2">
        <div class="chart-box">
          <h3>📦 Kategori Bazlı Envanter Değeri (TL)</h3>
          <canvas id="categoryValuationChart" height="220"></canvas>
        </div>
        <div class="chart-box">
          <h3>🏬 Depo Bazlı Stok Dağılımı</h3>
          <canvas id="warehouseDistChart" height="220"></canvas>
        </div>
      </div>

      <!-- Tables -->
      <div class="grid-2">
        <div class="chart-box">
          <h3>🚨 Asgari Seviye Altındaki Malzemeler</h3>
          <div class="table-wrapper">
            <table class="table">
              <thead>
                <tr>
                  <th>Malzeme</th>
                  <th>Mevcut</th>
                  <th>Asgari (Min)</th>
                  <th>Aksiyon</th>
                </tr>
              </thead>
              <tbody>
                <% if (!lowStockItems || lowStockItems.length === 0) { %>
                  <tr><td colspan="4" class="text-center text-muted">Kritik seviyede malzeme yok.</td></tr>
                <% } else { %>
                  <% lowStockItems.slice(0, 5).forEach(item => { %>
                    <tr>
                      <td><strong style="color: var(--text-primary);"><%= item.name %></strong></td>
                      <td><span class="badge bg-danger" style="color: var(--rose);"><%= item.currentStock %> <%= item.unit %></span></td>
                      <td><%= item.minStock %> <%= item.unit %></td>
                      <td><a href="/stock/alerts" class="btn btn-sm btn-secondary">Talep Oluştur</a></td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="chart-box">
          <h3>📋 Son Stok Hareketleri</h3>
          <div class="table-wrapper">
            <table class="table">
              <thead>
                <tr>
                  <th>Hareket No</th>
                  <th>Malzeme</th>
                  <th>Miktar</th>
                  <th>Tip</th>
                </tr>
              </thead>
              <tbody>
                <% if (!movements || movements.length === 0) { %>
                  <tr><td colspan="4" class="text-center text-muted">Stok hareketi yok.</td></tr>
                <% } else { %>
                  <% movements.forEach(m => { %>
                    <tr>
                      <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= m.movementNo %></strong></td>
                      <td><%= m.stockItem ? m.stockItem.name : '—' %></td>
                      <td><strong><%= m.quantity %></strong></td>
                      <td>
                        <% if (m.movementType === 'Inbound') { %>
                          <span class="status-pill status-active">📥 Giriş</span>
                        <% } else if (m.movementType === 'Outbound') { %>
                          <span class="status-pill status-rejected">📤 Çıkış</span>
                        <% } else { %>
                          <span class="status-pill status-approved">🔄 Transfer</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    Chart.defaults.color = '#8896b0';
    Chart.defaults.font.family = 'Inter';

    // Category Valuation Chart
    const catSummary = <%- JSON.stringify(valuationReport.categorySummary || {}) %>;
    const cLabels = Object.keys(catSummary);
    const cValues = Object.values(catSummary);
    const ctxC = document.getElementById('categoryValuationChart').getContext('2d');
    new Chart(ctxC, {
      type: 'bar',
      data: {
        labels: cLabels.length > 0 ? cLabels : ['Veri Yok'],
        datasets: [{
          label: 'Envanter Değeri (TL)',
          data: cValues.length > 0 ? cValues : [0],
          backgroundColor: ['rgba(99, 102, 241, 0.75)', 'rgba(16, 185, 129, 0.75)', 'rgba(6, 182, 212, 0.75)', 'rgba(245, 158, 11, 0.75)'],
          borderColor: ['#6366f1', '#10b981', '#06b6d4', '#f59e0b'],
          borderWidth: 1,
          borderRadius: 8
        }]
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { x: { grid: { color: 'rgba(255,255,255,0.05)' } }, y: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true } } }
    });

    // Warehouse Distribution Chart
    const whNames = <%- JSON.stringify((warehouses || []).map(w => w.name)) %>;
    const whCounts = <%- JSON.stringify((warehouses || []).map(w => (w.locations ? w.locations.length : 1))) %>;
    const ctxW = document.getElementById('warehouseDistChart').getContext('2d');
    new Chart(ctxW, {
      type: 'doughnut',
      data: {
        labels: whNames.length > 0 ? whNames : ['Depo Yok'],
        datasets: [{
          data: whCounts.length > 0 ? whCounts : [1],
          backgroundColor: ['#6366f1', '#10b981', '#06b6d4', '#f59e0b', '#ec4899'],
          borderWidth: 0
        }]
      },
      options: { responsive: true, plugins: { legend: { position: 'right', labels: { color: '#f0f2f5' } } } }
    });
  </script>
</body>
</html>
