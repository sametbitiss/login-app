<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Çoklu Depo & Lokasyonlar — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#4f46e5"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">STOK & DEPO</div>
      <a href="/stock" class="mss-link active">Stok Yönetimi</a>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link active">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max Uyarısı</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= ALL_ROLES[user.role] || user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/stock/items" class="msn-link">📦 Malzeme Kartları</a>
        <a href="/stock/warehouses" class="msn-link active">🏬 Depolar & Lokasyonlar</a>
        <a href="/stock/lots" class="msn-link">🏷️ Lot / Parti & Seri No</a>
        <a href="/stock/transfers" class="msn-link">🔄 Transferler & Hareketler</a>
        <a href="/stock/goods-receipt" class="msn-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="msn-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/counting" class="msn-link">📋 Envanter Sayımı</a>
        <a href="/stock/alerts" class="msn-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="msn-link">💰 Stok Maliyetlendirme (FIFO)</a>
        <a href="/stock/terminal" class="msn-link">📱 RF El Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Çoklu Depo & Lokasyon Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Şirket bünyesindeki ambarlar ve ambar içi Koridor / Raf / Göz (Bin) detay takibi.</p>
        </div>
      </div>

      <!-- Add Warehouse Form Panel -->
      <div class="form-panel" style="margin-bottom: 1.75rem;">
        <h3 style="color: var(--indigo); font-size: 1.05rem; margin-bottom: 1rem;">🏬 Yeni Ambar / Depo Ekle</h3>
        
        <form action="/stock/warehouses/add" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="name">Depo / Ambar Adı <span class="req-star">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Örn: Ankara Bölge Sevkiyat Ambarı">
            </div>

            <div class="input-group">
              <label for="type">Depo Tipi <span class="req-star">*</span></label>
              <select id="type" name="type" required>
                <option value="Hammadde">Hammadde Deposu</option>
                <option value="Mamul">Nihai Ürün / Mamul Ambarı</option>
                <option value="Yedek_Parca">Yedek Parça Ambarı</option>
                <option value="Sevkiyat">Sevkiyat & Lojistik Deposu</option>
                <option value="General">Genel Depo</option>
              </select>
            </div>

            <div class="input-group">
              <label for="city">Şehir / Lokasyon</label>
              <input type="text" id="city" name="city" value="İstanbul" placeholder="Örn: Kocaeli">
            </div>
          </div>

          <div class="form-grid form-grid--2">
            <div class="input-group">
              <label for="managerName">Depo Sorumlusu</label>
              <input type="text" id="managerName" name="managerName" placeholder="Örn: Hasan Yılmaz">
            </div>

            <div class="input-group">
              <label for="address">Açık Adres</label>
              <input type="text" id="address" name="address" placeholder="Örn: Organize Sanayi Bölgesi 2. Cadde No: 4">
            </div>
          </div>

          <button type="submit" class="btn" style="align-self: flex-start;">
            Depoyu Kaydet
          </button>
        </form>
      </div>

      <!-- Add Location Form Panel -->
      <div class="form-panel" style="margin-bottom: 1.75rem;">
        <h3 style="color: var(--emerald); font-size: 1.05rem; margin-bottom: 1rem;">📍 Depo İçi Raf / Koridor / Göz Lokasyonu Tanımla</h3>
        
        <form action="/stock/locations/add" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="form-grid form-grid--4">
            <div class="input-group">
              <label for="warehouseId">Bağlı Olduğu Depo <span class="req-star">*</span></label>
              <select id="warehouseId" name="warehouseId" required>
                <option value="" disabled selected>-- Depo Seçiniz --</option>
                <% warehouses.forEach(wh => { %>
                  <option value="<%= wh.id %>">[<%= wh.warehouseCode %>] <%= wh.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="input-group">
              <label for="aisle">Koridor <span class="req-star">*</span></label>
              <input type="text" id="aisle" name="aisle" required placeholder="Örn: Koridor-B">
            </div>

            <div class="input-group">
              <label for="shelf">Raf No <span class="req-star">*</span></label>
              <input type="text" id="shelf" name="shelf" required placeholder="Örn: Raf-04">
            </div>

            <div class="input-group">
              <label for="bin">Göz / Bin <span class="req-star">*</span></label>
              <input type="text" id="bin" name="bin" required placeholder="Örn: Göz-02">
            </div>
          </div>

          <button type="submit" class="btn btn-success" style="align-self: flex-start;">
            Lokasyonu Tanımla
          </button>
        </form>
      </div>

      <!-- Warehouses Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">
        <% warehouses.forEach(wh => { %>
          <div class="stat-card" style="padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <div>
                <strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;"><%= wh.warehouseCode %></strong>
                <h3 style="font-size: 1.1rem; color: var(--text-main); font-weight: 700; margin-top: 2px;"><%= wh.name %></h3>
              </div>
              <span class="status-pill status-active"><%= wh.type %></span>
            </div>

            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;">
              <div>📍 <%= wh.city %> — <%= wh.address || 'Adres belirtilmedi' %></div>
              <div>👨‍💼 Sorumlu: <%= wh.managerName || 'Tüm Depo Ekibi' %></div>
            </div>

            <div style="border-top: 1px dashed var(--border); padding-top: 0.75rem;">
              <strong style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Tanımlı Lokasyonlar (<%= wh.locations ? wh.locations.length : 0 %>)</strong>
              <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px;">
                <% if (wh.locations && wh.locations.length > 0) { %>
                  <% wh.locations.forEach(loc => { %>
                    <span style="background: rgba(255,255,255,0.06); border: 1px solid var(--border); padding: 3px 8px; border-radius: 4px; font-size: 0.75rem; font-family: 'JetBrains Mono', monospace;">
                      <%= loc.locationCode %>
                    </span>
                  <% }) %>
                <% } else { %>
                  <span style="font-size: 0.775rem; color: var(--text-muted);">Henüz lokasyon eklenmedi</span>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
