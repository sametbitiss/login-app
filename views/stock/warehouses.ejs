<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Çoklu Depo & Lokasyon Yönetimi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* High-End Form Card Styling */
    .form-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
    }
    .form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
    }
    .form-card--indigo::before { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
    .form-card--emerald::before { background: linear-gradient(90deg, #10b981, #06b6d4); }

    .form-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }
    .form-card-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }
    .icon--indigo { background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); }
    .icon--emerald { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }

    .form-card-title { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); }
    .form-card-sub { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }

    /* Ultra Aesthetic Inputs */
    .aesthetic-group { margin-bottom: 16px; }
    .aesthetic-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 6px;
      display: block;
    }
    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      padding: 12px 14px;
      border-radius: 10px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }
    .aesthetic-input::placeholder { color: #475569; }

    .btn-indigo-gradient {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
      transition: all 0.2s ease;
      width: 100%;
    }
    .btn-indigo-gradient:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5); }

    .btn-emerald-gradient {
      background: linear-gradient(135deg, #10b981, #059669);
      color: #ffffff;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);
      transition: all 0.2s ease;
      width: 100%;
    }
    .btn-emerald-gradient:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5); }
    .wh-modal-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(12px);
      display: flex; align-items: center; justify-content: center;
      z-index: 9999; opacity: 0; visibility: hidden; transition: all 0.25s ease;
      padding: 20px;
    }
    .wh-modal-overlay.active {
      opacity: 1; visibility: visible;
    }
    .wh-modal-content {
      background: linear-gradient(160deg, #0f172a 0%, #1e293b 100%);
      border: 1.5px solid rgba(255, 255, 255, 0.15);
      border-radius: 24px; width: 100%; max-width: 950px; max-height: 88vh;
      overflow-y: auto; box-shadow: 0 30px 70px rgba(0,0,0,0.6); padding: 32px;
      position: relative; color: #f8fafc;
    }
    .wh-modal-close {
      position: absolute; top: 20px; right: 20px;
      background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
      color: #f8fafc; width: 36px; height: 36px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: 1.2rem; font-weight: 700; transition: all 0.2s ease;
    }
    .wh-modal-close:hover { background: rgba(244,63,94,0.2); color: #f43f5e; border-color: rgba(244,63,94,0.4); }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>
      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link active">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>
      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/stock/analytics" class="msn-link">📊 Analitik</a>
        <a href="/stock/alerts" class="msn-link">🚨 Kritik Stok</a>
        <a href="/stock/valuation" class="msn-link">💰 Maliyetlendirme</a>
        <a href="/stock/items" class="msn-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="msn-link active">🏬 Depolar</a>
        <a href="/stock/lots" class="msn-link">🏷️ Lot & Seri No</a>
        <a href="/stock/goods-receipt" class="msn-link">📥 Mal Kabul</a>
        <a href="/stock/dispatch" class="msn-link">📤 Sevkiyat</a>
        <a href="/stock/transfers" class="msn-link">🔄 Transferler</a>
        <a href="/stock/counting" class="msn-link">📋 Sayım</a>
        <a href="/stock/terminal" class="msn-link">📱 RF El Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Çoklu Depo ve Lokasyon Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Farklı şehir/şubelerdeki depolarınızı ve koridor, raf, göz detaylı lokasyon haritanızı yönetin.</p>
        </div>
      </div>

      <!-- Forms Grid -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
        <!-- 1. Form: Yeni Depo Tanımla -->
        <div class="form-card form-card--indigo">
          <div class="form-card-header">
            <div class="form-card-icon icon--indigo">🏬</div>
            <div>
              <div class="form-card-title">Yeni Depo Tanımla</div>
              <div class="form-card-sub">Şehir, ambar tipi ve sorumlu personel tanımı</div>
            </div>
          </div>

          <form action="/stock/warehouses/add" method="POST">
            <div class="aesthetic-group">
              <label class="aesthetic-label">Depo Adı *</label>
              <input type="text" name="name" placeholder="Örn: Ankara Merkez Lojistik Deposu" class="aesthetic-input" required>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
              <div class="aesthetic-group">
                <label class="aesthetic-label">Depo Tipi</label>
                <select name="type" class="aesthetic-input" style="cursor: pointer;">
                  <option value="Hammadde">Hammadde Ambarı</option>
                  <option value="Sevkiyat">Sevkiyat & Mamul Deposu</option>
                  <option value="Yedek_Parca">Yedek Parça Ambarı</option>
                  <option value="Genel">Genel Depo</option>
                </select>
              </div>

              <div class="aesthetic-group">
                <label class="aesthetic-label">Şehir</label>
                <input type="text" name="city" placeholder="Ankara" class="aesthetic-input">
              </div>
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Depo Sorumlusu</label>
              <input type="text" name="managerName" placeholder="Örn: Ahmet Yılmaz" class="aesthetic-input">
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Açık Adres</label>
              <textarea name="address" class="aesthetic-input" rows="2" placeholder="Ambar açık adresi..."></textarea>
            </div>

            <button type="submit" class="btn-indigo-gradient">🏬 Depoyu Kaydet ve Tanımla</button>
          </form>
        </div>

        <!-- 2. Form: Depo İçi Lokasyon Ekle -->
        <div class="form-card form-card--emerald">
          <div class="form-card-header">
            <div class="form-card-icon icon--emerald">📍</div>
            <div>
              <div class="form-card-title">Depo İçi Lokasyon Ekle</div>
              <div class="form-card-sub">Koridor, raf ve göz (bin) detaylı adres haritası</div>
            </div>
          </div>

          <form action="/stock/locations/add" method="POST">
            <div class="aesthetic-group">
              <label class="aesthetic-label">Hedef Depo Seçin *</label>
              <select name="warehouseId" class="aesthetic-input" required style="cursor: pointer;">
                <% warehouses.forEach(w => { %>
                  <option value="<%= w.id %>"><%= w.warehouseCode %> — <%= w.name %></option>
                <% }); %>
              </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
              <div class="aesthetic-group">
                <label class="aesthetic-label">Koridor *</label>
                <input type="text" name="aisle" placeholder="Koridor-A" class="aesthetic-input" required>
              </div>
              <div class="aesthetic-group">
                <label class="aesthetic-label">Raf *</label>
                <input type="text" name="shelf" placeholder="Raf-04" class="aesthetic-input" required>
              </div>
              <div class="aesthetic-group">
                <label class="aesthetic-label">Göz / Bin *</label>
                <input type="text" name="bin" placeholder="Göz-02" class="aesthetic-input" required>
              </div>
            </div>

            <div class="aesthetic-group">
              <label class="aesthetic-label">Kapasite Limit (Adet / Hacim)</label>
              <input type="number" name="capacity" value="1000" class="aesthetic-input">
            </div>

            <button type="submit" class="btn-emerald-gradient" style="margin-top: 24px;">📍 Lokasyonu Adrese Ekle</button>
          </form>
        </div>
      </div>

      <!-- Warehouse Cards & Location Table -->
      <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin-bottom: 16px;">📋 Mevcut Depolar ve Lokasyon Haritası</h3>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;">
        <% warehouses.forEach(wh => { %>
          <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: var(--shadow-md); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 16px;">
                <div>
                  <strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; background: rgba(99,102,241,0.1); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(99,102,241,0.2);"><%= wh.warehouseCode %></strong>
                  <h4 style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin-top: 6px;"><%= wh.name %></h4>
                  <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;"><%= wh.city %> | Tip: <%= wh.type %> • Sorumlu: <strong><%= wh.managerName || '—' %></strong></div>
                </div>
                <span class="status-pill status-active">● Active</span>
              </div>

              <!-- DEPO GİRİŞİ YAPILAN ÜRÜNLER CANLI LİSTESİ -->
              <div style="margin-bottom: 16px; background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                  <span style="font-size: 0.825rem; font-weight: 800; color: #34d399; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px;">
                    <span>📦</span> Depoya Girilen Ürünler & Stok Miktarları
                  </span>
                  <span style="font-size: 0.72rem; background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); padding: 2px 8px; border-radius: 10px; font-weight: 700;">
                    <%= wh.productSummary ? wh.productSummary.length : 0 %> Kalem Ürün
                  </span>
                </div>

                <% if (!wh.productSummary || wh.productSummary.length === 0) { %>
                  <div style="font-size: 0.8rem; color: var(--text-muted); padding: 10px 0; text-align: center;">
                    Henüz bu depoya mal kabul girişi yapılmamıştır.
                  </div>
                <% } else { %>
                  <div style="display: flex; flex-direction: column; gap: 6px; max-height: 140px; overflow-y: auto; padding-right: 4px;">
                    <% wh.productSummary.forEach(p => { %>
                      <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05); font-size: 0.825rem;">
                        <div>
                          <strong style="color: #f8fafc;"><%= p.name %></strong>
                          <span style="font-size: 0.72rem; color: #94a3b8; margin-left: 6px; font-family: 'JetBrains Mono', monospace;"><%= p.stockCode %></span>
                        </div>
                        <div style="text-align: right;">
                          <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;"><%= parseFloat(p.totalQuantity).toLocaleString('tr-TR') %> <%= p.unit %></strong>
                          <div style="font-size: 0.7rem; color: #64748b;">Son Giriş: <%= p.lastReceiptDate %></div>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } %>
              </div>

              <!-- SON MAL KABUL HAREKETLERİ ÖZETİ -->
              <% if (wh.receiptLogs && wh.receiptLogs.length > 0) { %>
                <div style="margin-bottom: 16px; background: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.15); border-radius: 12px; padding: 12px;">
                  <div style="font-size: 0.78rem; font-weight: 800; color: #818cf8; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                    <span>🚛</span> Son Mal Kabul Kayıtları (<%= wh.receiptLogs.length %> Giriş Fişi)
                  </div>
                  <div style="display: flex; flex-direction: column; gap: 4px; max-height: 90px; overflow-y: auto;">
                    <% wh.receiptLogs.slice(0, 3).forEach(log => { %>
                      <div style="font-size: 0.75rem; color: var(--text-secondary); display: flex; justify-content: space-between; background: rgba(0,0,0,0.2); padding: 5px 8px; border-radius: 6px; align-items: center;">
                        <span><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= log.orderNo %></strong> — <%= log.productName %></span>
                        <strong style="color: #34d399;"><%= log.quantity %> <%= log.unit %></strong>
                      </div>
                    <% }); %>
                  </div>
                </div>
              <% } %>

              <!-- DEPO İÇİ LOKASYONLAR -->
              <div style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Depo İçi Tanımlı Lokasyonlar (<%= wh.locations ? wh.locations.length : 0 %>)</div>
              <% if (!wh.locations || wh.locations.length === 0) { %>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 12px;">Henüz lokasyon tanımlanmamış.</div>
              <% } else { %>
                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px;">
                  <% wh.locations.forEach(loc => { %>
                    <span style="background: #0f172a; border: 1px solid #1e293b; padding: 4px 10px; border-radius: 6px; font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #f8fafc; display: inline-flex; align-items: center; gap: 4px;">
                      📍 <%= loc.locationCode %> <small style="color: #64748b;">(<%= loc.capacity %>)</small>
                    </span>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div style="margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--border); display: flex; justify-content: space-between; align-items: center;">
              <div>
                <div style="font-size: 0.85rem; font-weight: 800; color: #34d399;">
                  📦 <%= wh.productSummary ? wh.productSummary.length : 0 %> Çeşit Ürün Stokta
                </div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                  <%= wh.receiptLogs ? wh.receiptLogs.length : 0 %> Adet Mal Kabul İrsaliyesi
                </div>
              </div>
              <button type="button" onclick="openWhModal('<%= wh.id %>')" class="btn-indigo-gradient" style="width: auto; padding: 10px 18px; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 8px;">
                🔍 Tüm Ürün Detaylarını Göster
              </button>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- WAREHOUSE PRODUCT DETAILS MODALS -->
      <% warehouses.forEach(wh => { %>
        <div id="whModal-<%= wh.id %>" class="wh-modal-overlay">
          <div class="wh-modal-content">
            <button type="button" class="wh-modal-close" onclick="closeWhModal('<%= wh.id %>')">&times;</button>
            
            <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.1);">
              <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #6366f1, #4f46e5); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🏬</div>
              <div>
                <h3 style="font-size: 1.3rem; font-weight: 900; margin: 0; color: #f8fafc;"><%= wh.name %> — Depo Ürün Detayları & Giriş Kayıtları</h3>
                <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 2px;">
                  Depo Kodu: <strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= wh.warehouseCode %></strong> • Şehir: <strong><%= wh.city %></strong> • Sorumlu: <strong><%= wh.managerName || '—' %></strong>
                </div>
              </div>
            </div>

            <!-- Section 1: Depodaki Mevcut Ürünler -->
            <div style="margin-bottom: 28px;">
              <h4 style="font-size: 0.95rem; font-weight: 800; color: #34d399; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span>📦 DEPODAKİ GÜNCEL ÜRÜN KARTLARI VE STOK MİKTARLARI</span>
                <span style="font-size: 0.75rem; background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); padding: 2px 10px; border-radius: 12px;"><%= wh.productSummary ? wh.productSummary.length : 0 %> Kalem</span>
              </h4>

              <% if (!wh.productSummary || wh.productSummary.length === 0) { %>
                <div style="background: rgba(15, 23, 42, 0.6); padding: 18px; border-radius: 12px; text-align: center; color: #94a3b8; font-size: 0.88rem; border: 1px dashed rgba(255,255,255,0.1);">
                  Henüz bu depoya mal kabul veya stok girişi yapılmamıştır.
                </div>
              <% } else { %>
                <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden;">
                  <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
                    <thead>
                      <tr style="background: rgba(30, 41, 59, 0.85); color: #94a3b8; text-align: left; font-size: 0.75rem; text-transform: uppercase;">
                        <th style="padding: 12px 16px;">Stok Kodu</th>
                        <th style="padding: 12px 16px;">Ürün / Malzeme Adı</th>
                        <th style="padding: 12px 16px; text-align: right;">Depodaki Mevcut Miktar</th>
                        <th style="padding: 12px 16px; text-align: right;">Son Giriş Tarihi</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% wh.productSummary.forEach(ps => { %>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                          <td style="padding: 12px 16px; font-family: 'JetBrains Mono', monospace; color: #818cf8; font-weight: 700;"><%= ps.stockCode %></td>
                          <td style="padding: 12px 16px; color: #f8fafc; font-weight: 600;"><%= ps.name %></td>
                          <td style="padding: 12px 16px; text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399; font-size: 1rem;">
                            <%= parseFloat(ps.totalQuantity || 0).toLocaleString('tr-TR', {minimumFractionDigits: 0, maximumFractionDigits: 2}) %> <%= ps.unit %>
                          </td>
                          <td style="padding: 12px 16px; text-align: right; font-size: 0.8rem; color: #94a3b8;"><%= ps.lastReceiptDate || '—' %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>

            <!-- Section 2: Mal Kabul Giriş Geçmişi -->
            <div>
              <h4 style="font-size: 0.95rem; font-weight: 800; color: #818cf8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span>📥 DEPO GİRİŞ & MAL KABUL HAREKET GEÇMİŞİ</span>
                <span style="font-size: 0.75rem; background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); padding: 2px 10px; border-radius: 12px;"><%= wh.receiptLogs ? wh.receiptLogs.length : 0 %> Giriş Hareketi</span>
              </h4>

              <% if (!wh.receiptLogs || wh.receiptLogs.length === 0) { %>
                <div style="background: rgba(15, 23, 42, 0.6); padding: 18px; border-radius: 12px; text-align: center; color: #94a3b8; font-size: 0.88rem; border: 1px dashed rgba(255,255,255,0.1);">
                  Bu depoya ait geçmiş mal kabul kaydı bulunmamaktadır.
                </div>
              <% } else { %>
                <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden;">
                  <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                    <thead>
                      <tr style="background: rgba(30, 41, 59, 0.85); color: #94a3b8; text-align: left; font-size: 0.72rem; text-transform: uppercase;">
                        <th style="padding: 10px 14px;">Giriş Tarihi</th>
                        <th style="padding: 10px 14px;">İlişkili Sipariş No</th>
                        <th style="padding: 10px 14px;">Fiş / İrsaliye No</th>
                        <th style="padding: 10px 14px;">Tedarikçi Firma</th>
                        <th style="padding: 10px 14px;">Gelen Ürün / Malzeme</th>
                        <th style="padding: 10px 14px; text-align: right;">Gelen Miktar</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% wh.receiptLogs.forEach(log => { %>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                          <td style="padding: 10px 14px; color: #cbd5e1; font-weight: 600;"><%= log.receiptDate %></td>
                          <td style="padding: 10px 14px; font-family: 'JetBrains Mono', monospace; color: #6366f1; font-weight: 700;"><%= log.orderNo %></td>
                          <td style="padding: 10px 14px; font-size: 0.8rem; color: #94a3b8;">
                            <strong><%= log.grnNo %></strong>
                            <% if (log.deliveryNoteNo && log.deliveryNoteNo !== '—') { %>
                              <br><small style="color: #64748b;">İrs: <%= log.deliveryNoteNo %></small>
                            <% } %>
                          </td>
                          <td style="padding: 10px 14px; color: #f8fafc; font-weight: 500;"><%= log.supplierName %></td>
                          <td style="padding: 10px 14px;">
                            <strong style="color: #f8fafc;"><%= log.productName %></strong>
                            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #64748b; margin-left: 4px;">(<%= log.stockCode %>)</span>
                          </td>
                          <td style="padding: 10px 14px; text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399;">
                            +<%= parseFloat(log.quantity).toLocaleString('tr-TR') %> <%= log.unit %>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }); %>
    </main>
  </div>

  <script>
    function openWhModal(whId) {
      const modal = document.getElementById('whModal-' + whId);
      if (modal) modal.classList.add('active');
    }
    function closeWhModal(whId) {
      const modal = document.getElementById('whModal-' + whId);
      if (modal) modal.classList.remove('active');
    }

    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
