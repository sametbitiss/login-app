<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Önceki Mal Kabulleri — Sipariş: <%= order.orderNo %></title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .history-receipt-card {
      background: linear-gradient(160deg, rgba(15, 23, 42, 0.98) 0%, rgba(30, 41, 59, 0.95) 100%);
      backdrop-filter: blur(25px);
      border: 1.5px solid rgba(255, 255, 255, 0.14);
      border-radius: 22px;
      padding: 2rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      margin-bottom: 2rem;
      position: relative;
    }
    .history-receipt-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, #818cf8 0%, #34d399 100%);
      border-radius: 22px 22px 0 0;
    }

    .grn-history-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding-bottom: 18px; border-bottom: 1px dashed rgba(255, 255, 255, 0.12);
      margin-bottom: 20px;
    }

    .grn-photo-box {
      background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px; padding: 14px; text-align: center; margin-bottom: 20px;
    }
    .grn-photo-img {
      max-height: 280px; max-width: 100%; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.2);
      cursor: zoom-in; transition: transform 0.2s ease;
    }
    .grn-photo-img:hover { transform: scale(1.02); }

    .h-table { width: 100%; border-collapse: collapse; font-size: 0.86rem; margin-top: 10px; }
    .h-table th {
      background: rgba(15, 23, 42, 0.85); color: #94a3b8; font-size: 0.72rem;
      font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; padding: 12px 16px; text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .h-table td { padding: 14px 16px; color: #cbd5e1; font-weight: 500; border-bottom: 1px solid rgba(255, 255, 255, 0.04); }
    .h-table tr:last-child td { border-bottom: none; }
    .mono { font-family: 'JetBrains Mono', monospace; font-weight: 700; }
    .emerald { color: #34d399; }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>
      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link active">📥 Mal Kabul & Giriş</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/stock" class="mt-link active">Stok & Depo</a><a href="/purchase" class="mt-link">Satın Alma</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div style="margin-bottom: 20px;">
        <a href="/stock/goods-receipt" class="btn btn-secondary" style="border-radius: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
          ← Mal Kabul Listesine Dön
        </a>
      </div>

      <div class="page-header" style="margin-bottom: 24px;">
        <div>
          <h1>Önceki Mal Kabul Geçmişi Belgesi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            Sipariş No: <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;"><%= order.orderNo %></strong> • Tedarikçi: <strong style="color: #f8fafc;"><%= order.supplierName %></strong>
          </p>
        </div>
      </div>

      <% if (!receipts || receipts.length === 0) { %>
        <div style="background: rgba(15, 23, 42, 0.6); border: 1.5px solid rgba(255,255,255,0.1); padding: 3rem; text-align: center; border-radius: 20px; color: #94a3b8;">
          Bu sipariş için henüz yapılmış bir mal kabul işlemi bulunmamaktadır.
        </div>
      <% } else { %>
        <% receipts.forEach((gr, idx) => { %>
          <div class="history-receipt-card">
            <!-- HEADER -->
            <div class="grn-history-header">
              <div>
                <span style="font-size: 0.75rem; font-weight: 800; color: #818cf8; text-transform: uppercase; letter-spacing: 1px;">
                  MAL KABUL İŞLEMİ #<%= receipts.length - idx %>
                </span>
                <h3 style="font-size: 1.25rem; font-weight: 900; color: #f8fafc; margin: 4px 0 0 0; font-family: 'JetBrains Mono', monospace;">
                  FİŞ NO: <%= gr.grnNo %>
                </h3>
              </div>
              <div style="text-align: right; font-size: 0.85rem; color: #94a3b8;">
                <div>📅 İşlem Tarihi: <strong style="color: #f8fafc;"><%= gr.receiptDate %></strong></div>
                <div>🏢 Depo: <strong style="color: #34d399;"><%= gr.warehouseLocation || 'Ana Depo' %></strong></div>
                <div>👤 İşlemi Yapan: <strong style="color: #818cf8;"><%= gr.creator ? (gr.creator.firstName ? gr.creator.firstName + ' ' + gr.creator.lastName : gr.creator.username) : 'Sistem' %></strong></div>
              </div>
            </div>

            <!-- WAYBILL METADATA -->
            <div style="display: flex; gap: 24px; margin-bottom: 16px; font-size: 0.9rem; color: #cbd5e1; background: rgba(30, 41, 59, 0.6); padding: 12px 18px; border-radius: 12px;">
              <div>📄 İrsaliye No: <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;"><%= gr.deliveryNoteNo || '—' %></strong></div>
              <div>📅 İrsaliye Tarihi: <strong><%= gr.deliveryNoteDate || '—' %></strong></div>
              <div>📝 Notlar: <em><%= gr.notes || 'Not bulunmuyor' %></em></div>
            </div>

            <!-- UPLOADED WAYBILL PHOTO DISPLAY (BASE64) -->
            <% if (gr.deliveryNotePhoto) { %>
              <div class="grn-photo-box">
                <div style="font-size: 0.75rem; font-weight: 800; color: #34d399; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">
                  📸 YÜKLENEN RESMİ İRSALİYE FOTOĞRAFI (VERİTABANINDAN SAKLANAN BASE64 GÖRSELİ)
                </div>
                <img src="<%= gr.deliveryNotePhoto %>" class="grn-photo-img" alt="Yüklenen İrsaliye Görseli" onclick="openPhotoModal('<%= gr.deliveryNotePhoto %>')">
                <div style="font-size: 0.72rem; color: #64748b; margin-top: 6px;">(Büyütmek için fotoğrafa tıklayın)</div>
              </div>
            <% } else { %>
              <div style="background: rgba(15, 23, 42, 0.4); border: 1px dashed rgba(255,255,255,0.1); padding: 12px; text-align: center; border-radius: 12px; font-size: 0.8rem; color: #64748b; margin-bottom: 16px;">
                📷 Bu mal kabul işleminde irsaliye fotoğrafı yüklenmemiştir.
              </div>
            <% } %>

            <!-- ITEMS BREAKDOWN TABLE -->
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px; overflow: hidden;">
              <div style="padding: 10px 16px; font-size: 0.82rem; font-weight: 800; color: #f8fafc; background: rgba(30, 41, 59, 0.8);">
                📋 BU İŞLEMDE TESLİM ALINAN ÜRÜN KALEMLERİ
              </div>
              <table class="h-table">
                <thead>
                  <tr>
                    <th>Stok Kodu</th>
                    <th>Ürün Adı</th>
                    <th style="text-align: right;">Sipariş Miktarı</th>
                    <th style="text-align: right;">Önceki Teslim</th>
                    <th style="text-align: right; color: #34d399;">BU İŞLEMDE GELEN</th>
                    <th style="text-align: right;">Kalan Miktar</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (gr.itemsList && gr.itemsList.length > 0) { %>
                    <% gr.itemsList.forEach(it => { %>
                      <tr>
                        <td class="mono" style="color: #818cf8;"><%= it.stockCode %></td>
                        <td><strong style="color: #f8fafc;"><%= it.productName %></strong></td>
                        <td class="mono" style="text-align: right;"><%= (parseFloat(it.orderedQuantity) || 0).toLocaleString('tr-TR') %> <%= it.unit %></td>
                        <td class="mono" style="text-align: right; color: #94a3b8;"><%= (parseFloat(it.previouslyReceivedQuantity) || 0).toLocaleString('tr-TR') %> <%= it.unit %></td>
                        <td class="mono emerald" style="text-align: right; font-size: 0.95rem;"><%= (parseFloat(it.currentReceivedQuantity) || 0).toLocaleString('tr-TR') %> <%= it.unit %></td>
                        <td class="mono" style="text-align: right; color: #fb7185;"><%= (parseFloat(it.netRemainingQuantity) || 0).toLocaleString('tr-TR') %> <%= it.unit %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td class="mono" style="color: #818cf8;"><%= order.stockItem ? order.stockItem.stockCode : 'STK-001' %></td>
                      <td><strong style="color: #f8fafc;"><%= order.stockItem ? order.stockItem.name : 'Ürün Kalemi' %></strong></td>
                      <td class="mono" style="text-align: right;"><%= (parseFloat(gr.orderedQuantity) || parseFloat(order.quantity) || 0).toLocaleString('tr-TR') %></td>
                      <td class="mono" style="text-align: right; color: #94a3b8;">0</td>
                      <td class="mono emerald" style="text-align: right; font-size: 0.95rem;"><%= (parseFloat(gr.receivedQuantity) || 0).toLocaleString('tr-TR') %></td>
                      <td class="mono" style="text-align: right; color: #fb7185;">0</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

          </div>
        <% }); %>
      <% } %>
    </main>
  </div>

  <!-- PHOTO FULLSCREEN MODAL -->
  <div id="photoModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(10px);" onclick="this.style.display='none'">
    <img id="photoModalImg" style="max-width: 90%; max-height: 90%; border-radius: 16px; box-shadow: 0 25px 60px rgba(0,0,0,0.8); border: 2px solid rgba(255,255,255,0.2);">
  </div>

  <script>
    function openPhotoModal(src) {
      document.getElementById('photoModalImg').src = src;
      document.getElementById('photoModal').style.display = 'flex';
    }
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
