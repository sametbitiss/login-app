<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stok Maliyetlendirme ve Değerleme — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link active">💰 Stok Maliyetlendirme</a>
      </div>
      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>
      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Stok Maliyetlendirme ve Değerleme Yöntemleri (FIFO & Ağırlıklı Ortalama)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">FIFO (First In First Out) ve Ağırlıklı Ortalama Maliyet (Moving Average) yöntemleriyle stok değer hesabı.</p>
        </div>
      </div>

      <div class="kpi-strip">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">💰</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Ortalama Maliyetli Değer</span><span class="kpi-chip-value"><%= parseFloat(totalAvgValuation).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> ₺</span></div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">📈</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">FIFO Yöntemiyle Değer</span><span class="kpi-chip-value"><%= parseFloat(totalFifoValuation).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> ₺</span></div>
        </div>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Stok Kodu</th>
              <th>Malzeme Adı</th>
              <th>Kategori</th>
              <th>Mevcut Stok</th>
              <th>Ortalama Alış Fiyatı</th>
              <th>Ağırlıklı Ort. Değeri</th>
              <th>FIFO Stok Değeri</th>
            </tr>
          </thead>
          <tbody>
            <% if (!valuationItems || valuationItems.length === 0) { %>
              <tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">Henüz maliyetlendirilecek stok bulunmamaktadır.</td></tr>
            <% } else { %>
              <% valuationItems.forEach(item => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= item.stockCode %></strong></td>
                  <td><strong style="color: var(--text-primary);"><%= item.name %></strong></td>
                  <td><span class="status-pill status-approved"><%= item.category %></span></td>
                  <td><strong><%= item.currentStock %> <%= item.unit %></strong></td>
                  <td><%= parseFloat(item.avgUnitPrice).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</td>
                  <td><strong style="color: var(--cyan);"><%= parseFloat(item.avgTotalValue).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</strong></td>
                  <td><strong style="color: var(--emerald);"><%= parseFloat(item.fifoTotalValue).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</strong></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
