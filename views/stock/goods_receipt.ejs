<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Malzeme Kabul ve Stok Giriş İşlemleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .grn-badge {
      font-size: 0.72rem; font-weight: 800; padding: 4px 10px; border-radius: 20px;
      display: inline-block; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .grn-badge-pending { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .grn-badge-partial { background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); }
    
    .item-subtable {
      width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-top: 6px;
      background: rgba(15, 23, 42, 0.4); border-radius: 8px; overflow: hidden;
    }
    .item-subtable th {
      background: rgba(30, 41, 59, 0.6); color: #94a3b8; padding: 6px 10px; text-align: left;
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    }
    .item-subtable td { padding: 6px 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; }
    .item-subtable tr:last-child td { border-bottom: none; }

    .btn-grn-action {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #fff; font-size: 0.78rem; font-weight: 800; padding: 8px 16px; border-radius: 10px;
      text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); transition: all 0.2s ease;
    }
    .btn-grn-action:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(16, 185, 129, 0.45); }

    .btn-history-action {
      background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3);
      font-size: 0.75rem; font-weight: 700; padding: 8px 14px; border-radius: 10px;
      text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
      transition: all 0.2s ease;
    }
    .btn-history-action:hover { background: rgba(99, 102, 241, 0.25); color: #a5b4fc; }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>
      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>
      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link active">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/stock/analytics" class="msn-link">📊 Analitik</a>
        <a href="/stock/alerts" class="msn-link">🚨 Kritik Stok</a>
        <a href="/stock/valuation" class="msn-link">💰 Maliyetlendirme</a>
        <a href="/stock/items" class="msn-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="msn-link">🏬 Depolar</a>
        <a href="/stock/lots" class="msn-link">🏷️ Lot & Seri No</a>
        <a href="/stock/goods-receipt" class="msn-link active">📥 Mal Kabul</a>
        <a href="/stock/dispatch" class="msn-link">📤 Sevkiyat</a>
        <a href="/stock/transfers" class="msn-link">🔄 Transferler</a>
        <a href="/stock/counting" class="msn-link">📋 Sayım</a>
        <a href="/stock/terminal" class="msn-link">📱 RF El Terminali</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Malzeme Kabul ve Ambar Giriş İşlemleri</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Satın alma siparişlerine istinaden tedarikçiden gelen malların irsaliyeli muayenesi ve depo alımı.</p>
        </div>
      </div>

      <% if (typeof successMsg !== 'undefined' && successMsg) { %>
        <div style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1.5px solid rgba(16, 185, 129, 0.35); padding: 16px 22px; border-radius: 16px; margin-bottom: 24px; font-weight: 700; display: flex; align-items: center; gap: 12px; box-shadow: 0 8px 25px rgba(16, 185, 129, 0.15);">
          <span style="font-size: 1.3rem;">✅</span> <%= successMsg %>
        </div>
      <% } %>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Sipariş No & Tarih</th>
              <th>Tedarikçi Firma</th>
              <th>Sipariş Edilen Ürün Kalemleri & Miktarlar</th>
              <th>Teslimat Durumu</th>
              <th style="text-align: right;">Aksiyonlar</th>
            </tr>
          </thead>
          <tbody>
            <% if (!purchaseOrders || purchaseOrders.length === 0) { %>
              <tr>
                <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 3rem;">
                  <div style="font-size: 2.2rem; margin-bottom: 8px;">📦</div>
                  Mal kabul bekleyen veya kısmi teslimat aşamasında sipariş bulunmamaktadır.<br>
                  <span style="font-size: 0.8rem; color: #64748b;">(Tüm ürünleri %100 teslim alınan siparişler listeden otomatik olarak kaldırılmıştır.)</span>
                </td>
              </tr>
            <% } else { %>
              <% purchaseOrders.forEach(po => { %>
                <tr>
                  <td style="vertical-align: top; white-space: nowrap;">
                    <strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 1rem;"><%= po.orderNo %></strong>
                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">📅 <%= po.orderDate %></div>
                  </td>
                  <td style="vertical-align: top;">
                    <strong style="color: #f8fafc; font-size: 0.95rem;"><%= po.supplierName %></strong>
                    <% if (po.supplierTaxNo) { %>
                      <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">VN: <%= po.supplierTaxNo %></div>
                    <% } %>
                    <div style="font-size: 0.78rem; font-weight: 700; color: #818cf8; margin-top: 6px; background: rgba(99,102,241,0.12); border: 1px solid rgba(99,102,241,0.25); padding: 3px 8px; border-radius: 6px; display: inline-block;">
                      🏬 Mal Kabul Deposu: <%= po.deliveryWarehouse || 'Ana Depo-A' %>
                    </div>
                  </td>
                  <td style="vertical-align: top;">
                    <table class="item-subtable">
                      <thead>
                        <tr>
                          <th>Stok Kodu / Malzeme</th>
                          <th style="text-align: right;">Sipariş</th>
                          <th style="text-align: right;">Teslim Alınan</th>
                          <th style="text-align: right;">Kalan</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% po.items.forEach(it => { %>
                          <tr>
                            <td>
                              <strong style="color: #f8fafc;"><%= it.productName %></strong>
                              <span style="color: #64748b; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; margin-left: 4px;">(<%= it.stockCode %>)</span>
                            </td>
                            <td style="text-align: right; font-family: 'JetBrains Mono', monospace;"><%= it.orderedQuantity.toLocaleString('tr-TR') %> <%= it.unit %></td>
                            <td style="text-align: right; font-family: 'JetBrains Mono', monospace; color: #34d399; font-weight: 700;"><%= it.receivedQuantity.toLocaleString('tr-TR') %> <%= it.unit %></td>
                            <td style="text-align: right; font-family: 'JetBrains Mono', monospace; color: <%= it.remainingQuantity > 0 ? '#fb7185' : '#64748b' %>; font-weight: 700;">
                              <%= it.remainingQuantity.toLocaleString('tr-TR') %> <%= it.unit %>
                            </td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </td>
                  <td style="vertical-align: top; white-space: nowrap;">
                    <% if (po.status === 'Partial_Received') { %>
                      <span class="grn-badge grn-badge-partial">⌛ Kısmi Teslim Alındı</span>
                    <% } else { %>
                      <span class="grn-badge grn-badge-pending">📦 Mal Kabul Bekliyor</span>
                    <% } %>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 6px;">
                      Kalan: <strong><%= po.totalRemainingQty.toLocaleString('tr-TR') %></strong> birim
                    </div>
                  </td>
                  <td style="vertical-align: top; text-align: right; white-space: nowrap;">
                    <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px;">
                      <a href="/stock/goods-receipt/create?orderId=<%= po.id %>" class="btn-grn-action">
                        📥 Mal Kabul Et & Stok Girişi Yap
                      </a>
                      
                      <% if (po.receiptCount > 0) { %>
                        <a href="/stock/goods-receipt/history/<%= po.id %>" class="btn-history-action">
                          📜 Önceki Mal Kabulleri Gör (<%= po.receiptCount %>)
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
