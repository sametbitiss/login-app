<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mal Kabul Girişi Yap — Sipariş: <%= order.orderNo %></title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .grn-create-card {
      background: linear-gradient(160deg, rgba(15, 23, 42, 0.98) 0%, rgba(30, 41, 59, 0.95) 100%);
      backdrop-filter: blur(25px);
      border: 1.5px solid rgba(255, 255, 255, 0.14);
      border-radius: 24px;
      padding: 2.5rem;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      margin-bottom: 2rem;
      position: relative;
    }
    .grn-create-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5px;
      background: linear-gradient(90deg, #10b981 0%, #3b82f6 50%, #6366f1 100%);
      border-radius: 24px 24px 0 0;
    }

    .grn-header-grid {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding-bottom: 20px; border-bottom: 2px dashed rgba(255, 255, 255, 0.12);
      margin-bottom: 24px;
    }
    .grn-brand-icon {
      width: 52px; height: 52px;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border-radius: 16px; display: flex; align-items: center; justify-content: center;
      font-size: 1.7rem; color: #fff; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
    }

    .grn-form-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-bottom: 28px;
    }
    @media (max-width: 900px) { .grn-form-grid { grid-template-columns: 1fr; } }

    .grn-form-section {
      background: rgba(15, 23, 42, 0.65); border: 1.5px solid rgba(255, 255, 255, 0.09);
      border-radius: 20px; padding: 22px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .grn-section-title {
      font-size: 0.82rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;
      color: #34d399; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex; align-items: center; gap: 8px;
    }

    .aesthetic-field { margin-bottom: 16px; }
    .aesthetic-field:last-child { margin-bottom: 0; }
    .aesthetic-label { display: block; font-size: 0.82rem; font-weight: 700; color: #94a3b8; margin-bottom: 6px; }
    .aesthetic-input {
      width: 100%; background: rgba(15, 23, 42, 0.8); border: 1.5px solid rgba(255, 255, 255, 0.14);
      border-radius: 12px; padding: 10px 14px; color: #f8fafc; font-size: 0.9rem; font-weight: 600;
      outline: none; transition: all 0.2s ease; box-sizing: border-box;
    }
    .aesthetic-input:focus {
      border-color: #34d399; background: rgba(30, 41, 59, 0.95);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }

    /* Photo Upload Dropzone */
    .photo-upload-zone {
      border: 2px dashed rgba(52, 211, 153, 0.4);
      border-radius: 16px; padding: 20px; text-align: center;
      background: rgba(16, 185, 129, 0.04); transition: all 0.2s ease;
      cursor: pointer; position: relative;
    }
    .photo-upload-zone:hover { background: rgba(16, 185, 129, 0.09); border-color: #34d399; }
    .photo-preview-box {
      max-height: 180px; border-radius: 12px; margin-top: 12px;
      border: 1px solid rgba(255, 255, 255, 0.2); display: none; object-fit: contain;
    }

    /* Items Table */
    .items-table-section {
      background: rgba(15, 23, 42, 0.65); border: 1.5px solid rgba(255, 255, 255, 0.09);
      border-radius: 20px; overflow: hidden; margin-bottom: 28px;
    }
    .items-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .items-table th {
      background: rgba(15, 23, 42, 0.85); color: #94a3b8; font-size: 0.72rem;
      font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; padding: 14px 18px; text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .items-table td { padding: 16px 18px; color: #cbd5e1; font-weight: 500; border-bottom: 1px solid rgba(255, 255, 255, 0.04); }
    .items-table tr:last-child td { border-bottom: none; }
    .mono { font-family: 'JetBrains Mono', monospace; font-weight: 700; }
    .emerald { color: #34d399; }

    .btn-submit-grn {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #fff; font-size: 1rem; font-weight: 800; padding: 14px 32px; border-radius: 14px;
      border: none; cursor: pointer; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.35);
      display: inline-flex; align-items: center; gap: 10px; transition: all 0.2s ease;
    }
    .btn-submit-grn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px rgba(16, 185, 129, 0.5); }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">📦 STOK & DEPO YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & RAPORLAR</div>
      <div class="mss-sub">
        <a href="/stock/analytics" class="mss-sub-link">📊 Stok Analitiği</a>
        <a href="/stock/alerts" class="mss-sub-link">🚨 Min/Max & Kritik Stok</a>
        <a href="/stock/valuation" class="mss-sub-link">💰 Stok Maliyetlendirme</a>
      </div>
      <div class="mss-group-title">📦 MALZEME & LOKASYON</div>
      <div class="mss-sub">
        <a href="/stock/items" class="mss-sub-link">📦 Stok Kartları</a>
        <a href="/stock/warehouses" class="mss-sub-link">🏬 Depo & Lokasyonlar</a>
        <a href="/stock/lots" class="mss-sub-link">🏷️ Lot & Seri Numaraları</a>
      </div>
      <div class="mss-group-title">🔄 DEPO OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/stock/goods-receipt" class="mss-sub-link active">📥 Mal Kabul & Giriş</a>
        <a href="/stock/dispatch" class="mss-sub-link">📤 Sevkiyat & Çıkış</a>
        <a href="/stock/transfers" class="mss-sub-link">🔄 Transfer & Hareketler</a>
        <a href="/stock/counting" class="mss-sub-link">📋 Envanter Sayımı</a>
        <a href="/stock/terminal" class="mss-sub-link">📱 RF El Terminali</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link active">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link">Satın Alma</a>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/stock/analytics" class="msn-link">📊 Analitik</a>
        <a href="/stock/alerts" class="msn-link">🚨 Kritik Stok</a>
        <a href="/stock/goods-receipt" class="msn-link active">📥 Mal Kabul</a>
      </div>

      <div style="margin-bottom: 20px;">
        <a href="/stock/goods-receipt" class="btn btn-secondary" style="border-radius: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
          ← Mal Kabul Listesine Dön
        </a>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1.5px solid rgba(244,63,94,0.3); padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-weight: 600;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <form action="/stock/goods-receipt/create" method="POST" id="grnForm">
        <input type="hidden" name="purchaseOrderId" value="<%= order.id %>">
        <!-- Hidden Base64 string for photo payload -->
        <input type="hidden" name="deliveryNotePhoto" id="deliveryNotePhotoBase64">

        <div class="grn-create-card">
          <!-- HEADER -->
          <div class="grn-header-grid">
            <div style="display: flex; align-items: center; gap: 16px;">
              <div class="grn-brand-icon">📥</div>
              <div>
                <h2 style="font-size: 1.4rem; font-weight: 900; color: #f8fafc; margin: 0;">MAL KABUL & FİZİKSEL DEPO GİRİŞ FORMU</h2>
                <div style="font-size: 0.82rem; color: #94a3b8; margin-top: 4px;">
                  Sipariş No: <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;"><%= order.orderNo %></strong> • Tedarikçi: <strong style="color: #f8fafc;"><%= order.supplierName %></strong>
                </div>
              </div>
            </div>
            <div style="text-align: right;">
              <span style="font-size: 0.75rem; font-weight: 800; color: #818cf8; background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); padding: 5px 14px; border-radius: 20px;">
                FİŞ NO: <%= nextGrnNo %>
              </span>
            </div>
          </div>

          <!-- FORM GRID -->
          <div class="grn-form-grid">
            <!-- Left Box: Warehouse & Delivery Info -->
            <div class="grn-form-section">
              <div class="grn-section-title">
                <span>🏬 TESLİMAT VE HEDEF DEPO BİLGİLERİ</span>
              </div>
              <div class="aesthetic-field">
                <label class="aesthetic-label" style="color: #fbbf24;">🔒 Teslim Alınacak Hedef Depo (Siparişte Belirlenmiş — Değiştirilemez):</label>
                <% const targetWhName = (order && (order.deliveryWarehouse || order.deliveryPlace)) ? (order.deliveryWarehouse || order.deliveryPlace) : 'Ana Hammadde & Üretim Ambarı'; %>
                <div style="position: relative;">
                  <input type="text" value="🏬 <%= targetWhName %>" class="aesthetic-input" readonly style="background: rgba(15, 23, 42, 0.6); border-color: rgba(99, 102, 241, 0.4); color: #818cf8; font-weight: 800; cursor: not-allowed; padding-right: 35px;">
                  <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 0.9rem;">🔒</span>
                </div>
                <input type="hidden" name="warehouseLocation" value="<%= targetWhName %>">
              </div>

              <div class="aesthetic-field">
                <label class="aesthetic-label">İrsaliye Numarası:</label>
                <input type="text" name="deliveryNoteNo" class="aesthetic-input" placeholder="Örn: IRS-2026-99412" required>
              </div>

              <div class="aesthetic-field">
                <label class="aesthetic-label">İrsaliye Tarihi:</label>
                <input type="date" name="deliveryNoteDate" class="aesthetic-input" value="<%= new Date().toISOString().split('T')[0] %>" required>
              </div>
            </div>

            <!-- Right Box: Waybill Photo Upload (Base64) -->
            <div class="grn-form-section">
              <div class="grn-section-title">
                <span>📸 İRSALİYE FOTOĞRAFI YÜKLEME (GÖRSEL BELGE)</span>
              </div>

              <div class="photo-upload-zone" onclick="document.getElementById('irsaliyeFileInput').click()">
                <div style="font-size: 2rem; margin-bottom: 6px;">📷</div>
                <div style="font-size: 0.9rem; font-weight: 700; color: #34d399;" id="uploadStatusText">
                  İrsaliye Fotoğrafı Seçmek İçin Tıklayın
                </div>
                <div style="font-size: 0.75rem; color: #94a3b8; margin-top: 4px;">
                  (Fotoğraf veritabanında doğrudan sayısal Base64 formatında saklanacaktır)
                </div>
                <input type="file" id="irsaliyeFileInput" accept="image/*" style="display: none;" onchange="handlePhotoSelect(this)">
                <img id="photoPreview" class="photo-preview-box" alt="İrsaliye Önizleme">
              </div>

              <div class="aesthetic-field" style="margin-top: 14px;">
                <label class="aesthetic-label">Mal Kabul Notları & Muayene Açıklaması:</label>
                <textarea name="notes" class="aesthetic-input" rows="2" placeholder="Ambalaj durumu, muayene notları veya ek bilgiler..."></textarea>
              </div>
            </div>
          </div>

          <!-- LINE ITEMS TABLE -->
          <div class="items-table-section">
            <div style="padding: 16px 20px; font-size: 0.9rem; font-weight: 800; color: #f8fafc; background: rgba(30, 41, 59, 0.8); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
              📋 GELEN ÜRÜN KALEMLERİ VE FİZİKSEL SAYIM MİKTARLARI
            </div>
            <table class="items-table">
              <thead>
                <tr>
                  <th style="width: 40px; text-align: center;">#</th>
                  <th>Stok Kodu</th>
                  <th>Malzeme / Ürün Adı</th>
                  <th style="width: 120px; text-align: right;">Sipariş Miktarı</th>
                  <th style="width: 120px; text-align: right;">Önceki Teslim</th>
                  <th style="width: 120px; text-align: right;">Kalan Miktar</th>
                  <th style="width: 170px; text-align: right; color: #34d399;">BU TESLİMATTA GELEN</th>
                </tr>
              </thead>
              <tbody>
                <% items.forEach((it, idx) => { %>
                  <tr>
                    <td style="text-align: center; color: #64748b; font-weight: 800;"><%= idx + 1 %></td>
                    <td class="mono" style="color: #818cf8;"><%= it.stockCode %></td>
                    <td><strong style="color: #f8fafc;"><%= it.productName %></strong></td>
                    <td class="mono" style="text-align: right;"><%= it.orderedQuantity.toLocaleString('tr-TR') %> <%= it.unit %></td>
                    <td class="mono" style="text-align: right; color: #94a3b8;"><%= it.previouslyReceivedQuantity.toLocaleString('tr-TR') %> <%= it.unit %></td>
                    <td class="mono" style="text-align: right; color: #fb7185;"><%= it.remainingQuantity.toLocaleString('tr-TR') %> <%= it.unit %></td>
                    <td style="text-align: right;">
                      <!-- Hidden Item Inputs -->
                      <input type="hidden" name="itemStockItemId" value="<%= it.stockItemId %>">
                      <input type="hidden" name="itemProductName" value="<%= it.productName %>">
                      <input type="hidden" name="itemStockCode" value="<%= it.stockCode %>">
                      <input type="hidden" name="itemOrderedQty" value="<%= it.orderedQuantity %>">
                      <input type="hidden" name="itemPrevReceivedQty" value="<%= it.previouslyReceivedQuantity %>">
                      <input type="hidden" name="itemUnit" value="<%= it.unit %>">

                      <input type="number" step="0.01" min="0" max="<%= it.remainingQuantity %>" 
                             name="itemCurrentReceivedQty" value="<%= it.remainingQuantity %>" 
                             class="aesthetic-input mono emerald" style="width: 130px; text-align: right; font-size: 1.05rem;" required>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- SUBMIT ACTION -->
          <div style="display: flex; justify-content: flex-end; gap: 14px;">
            <button type="submit" class="btn-submit-grn">
              💾 Mal Kabulünü Tamamla ve Stoklara İşle
            </button>
          </div>

        </div>
      </form>
    </main>
  </div>

  <script>
    function handlePhotoSelect(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        const reader = new FileReader();
        reader.onload = function(e) {
          const base64Data = e.target.result;
          document.getElementById('deliveryNotePhotoBase64').value = base64Data;
          
          const preview = document.getElementById('photoPreview');
          preview.src = base64Data;
          preview.style.display = 'block';

          document.getElementById('uploadStatusText').textContent = '✅ İrsaliye Fotoğrafı Yüklendi (' + file.name + ')';
        };
        reader.readAsDataURL(file);
      }
    }

    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
