<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satın Alma Siparişi Düzenle — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#f59e0b"/><stop offset="100%" stop-color="#d97706"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">SATIN ALMA YÖNETİMİ</div>
      <a href="/purchase/orders" class="mss-link active">Tedarik Özellikleri</a>
      <div class="mss-sub">
        <a href="/purchase/orders" class="mss-sub-link">📋 Satın Alma Siparişleri Listesi</a>
        <a href="/purchase/orders/add" class="mss-sub-link">➕ Yeni Sipariş Ekle</a>
        <a href="/purchase/orders#requisitions" class="mss-sub-link">📩 Gelen Stok Talepleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Stock_Manager') { %>
          <a href="/stock" class="mt-link">Stok & Depo</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Sales_Manager') { %>
          <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Purchase_Manager') { %>
          <a href="/purchase" class="mt-link active">Satın Alma</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div class="page-header">
        <div>
          <h1>Satın Alma Siparişi Düzenle & Detaylar</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">[<%= order.orderNo %>] siparişinin tüm detaylarını görüntüleyin ve güncelleyin.</p>
        </div>
        <a href="/purchase/orders" class="btn btn-secondary">◀ Sipariş Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div class="error" style="margin-bottom: 1.5rem;"><%= error %></div>
      <% } %>

      <div class="form-panel">
        <form action="/purchase/orders/<%= order.id %>/edit" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;">
          
          <!-- Tedarikçi Bilgileri -->
          <div>
            <h3 style="color: var(--amber); font-size: 1.05rem; margin-bottom: 1rem;">🏢 Tedarikçi & İletişim Detayları</h3>
            <div class="form-grid form-grid--3">
              <div class="input-group">
                <label for="orderNo">Sipariş No <span class="req-star">*</span></label>
                <input type="text" id="orderNo" name="orderNo" value="<%= order.orderNo %>" required readonly style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(255,255,255,0.05);">
              </div>
              <div class="input-group">
                <label for="supplierName">Tedarikçi Unvanı <span class="req-star">*</span></label>
                <input type="text" id="supplierName" name="supplierName" value="<%= order.supplierName %>" required>
              </div>
              <div class="input-group">
                <label for="supplierTaxNo">Tedarikçi Vergi No</label>
                <input type="text" id="supplierTaxNo" name="supplierTaxNo" value="<%= order.supplierTaxNo || '' %>">
              </div>
              <div class="input-group">
                <label for="supplierContactPerson">Yetkili Kişi</label>
                <input type="text" id="supplierContactPerson" name="supplierContactPerson" value="<%= order.supplierContactPerson || '' %>">
              </div>
              <div class="input-group">
                <label for="supplierEmail">E-Posta</label>
                <input type="email" id="supplierEmail" name="supplierEmail" value="<%= order.supplierEmail || '' %>">
              </div>
              <div class="input-group">
                <label for="supplierPhone">Telefon</label>
                <input type="text" id="supplierPhone" name="supplierPhone" value="<%= order.supplierPhone || '' %>">
              </div>
            </div>
          </div>

          <!-- Sipariş Şartları ve Tarihler -->
          <div>
            <h3 style="color: var(--amber); font-size: 1.05rem; margin-bottom: 1rem;">📅 Durum, Tarihler ve Ödeme Şartı</h3>
            <div class="form-grid form-grid--4">
              <div class="input-group">
                <label for="status">Sipariş Durumu <span class="req-star">*</span></label>
                <select id="status" name="status" required>
                  <option value="Pending_Approval" <%= order.status === 'Pending_Approval' ? 'selected' : '' %>>Onay Bekliyor</option>
                  <option value="Ordered" <%= order.status === 'Ordered' ? 'selected' : '' %>>Sipariş Verildi</option>
                  <option value="Received" <%= order.status === 'Received' ? 'selected' : '' %>>Teslim Alındı (Mal Kabul)</option>
                  <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>İptal</option>
                </select>
              </div>
              <div class="input-group">
                <label for="priority">Aciliyet</label>
                <select id="priority" name="priority">
                  <option value="Normal" <%= order.priority === 'Normal' ? 'selected' : '' %>>Normal</option>
                  <option value="High" <%= order.priority === 'High' ? 'selected' : '' %>>Yüksek</option>
                  <option value="Urgent" <%= order.priority === 'Urgent' ? 'selected' : '' %>>Acil</option>
                </select>
              </div>
              <div class="input-group">
                <label for="paymentTerm">Ödeme Şartı</label>
                <select id="paymentTerm" name="paymentTerm">
                  <option value="Pesin" <%= order.paymentTerm === 'Pesin' ? 'selected' : '' %>>Peşin</option>
                  <option value="Vadeli_30" <%= order.paymentTerm === 'Vadeli_30' ? 'selected' : '' %>>30 Gün Vadeli</option>
                  <option value="Vadeli_60" <%= order.paymentTerm === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
                  <option value="Vadeli_90" <%= order.paymentTerm === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
                </select>
              </div>
              <div class="input-group">
                <label for="orderDate">Sipariş Tarihi</label>
                <input type="date" id="orderDate" name="orderDate" value="<%= order.orderDate %>" required>
              </div>
            </div>
          </div>

          <!-- Malzeme ve Fiyatlar -->
          <div>
            <h3 style="color: var(--amber); font-size: 1.05rem; margin-bottom: 1rem;">📦 Malzeme, Miktar ve Finansal Hesap</h3>
            <div class="form-grid form-grid--3">
              <div class="input-group">
                <label for="stockItemId">Satın Alınacak Malzeme (Hammadde/Girdi) <span class="req-star">*</span></label>
                <select id="stockItemId" name="stockItemId" required>
                  <% stockItems.forEach(item => { %>
                    <option value="<%= item.id %>" <%= order.stockItemId == item.id ? 'selected' : '' %>>
                      [<%= item.stockCode %>] <%= item.name %> (<%= item.category %>)
                    </option>
                  <% }) %>
                </select>
              </div>
              <div class="input-group">
                <label for="quantity">Sipariş Miktarı <span class="req-star">*</span></label>
                <input type="number" step="0.01" id="quantity" name="quantity" value="<%= order.quantity %>" required oninput="calcTotals()">
              </div>
              <div class="input-group">
                <label for="unitPrice">Birim Fiyat <span class="req-star">*</span></label>
                <input type="number" step="0.01" id="unitPrice" name="unitPrice" value="<%= order.unitPrice %>" required oninput="calcTotals()">
              </div>
              <div class="input-group">
                <label for="discountRate">İskonto (%)</label>
                <input type="number" step="0.01" id="discountRate" name="discountRate" value="<%= order.discountRate %>" oninput="calcTotals()">
              </div>
              <div class="input-group">
                <label for="taxRate">KDV Oranı (%)</label>
                <input type="number" step="0.01" id="taxRate" name="taxRate" value="<%= order.taxRate %>" oninput="calcTotals()">
              </div>
              <div class="input-group">
                <label for="currency">Para Birimi</label>
                <select id="currency" name="currency">
                  <option value="TRY" <%= order.currency === 'TRY' ? 'selected' : '' %>>TRY (₺)</option>
                  <option value="USD" <%= order.currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
                  <option value="EUR" <%= order.currency === 'EUR' ? 'selected' : '' %>>EUR (€)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Otomatik Hesaplanan Tutar Kartı -->
          <div style="background: rgba(15, 23, 42, 0.6); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border); display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center;">
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">Ara Toplam</span>
              <strong id="displaySubtotal" style="font-size: 1.1rem; color: #fff;"><%= order.subtotal %> TL</strong>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">İskonto Tutar</span>
              <strong id="displayDiscount" style="font-size: 1.1rem; color: var(--amber);"><%= order.discountAmount %> TL</strong>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">KDV Tutarı</span>
              <strong id="displayTax" style="font-size: 1.1rem; color: var(--indigo);"><%= order.taxAmount %> TL</strong>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">Genel Toplam</span>
              <strong id="displayTotal" style="font-size: 1.3rem; color: var(--emerald);"><%= order.totalAmount %> TL</strong>
            </div>
          </div>

          <div class="input-group">
            <label for="notes">Sipariş Notu / Açıklama</label>
            <textarea id="notes" name="notes" rows="3"><%= order.notes || '' %></textarea>
          </div>

          <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-warning">💾 Sipariş Değişikliklerini Kaydet</button>
            <a href="/purchase/orders" class="btn btn-secondary">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function calcTotals() {
      const q = parseFloat(document.getElementById('quantity').value) || 0;
      const p = parseFloat(document.getElementById('unitPrice').value) || 0;
      const d = parseFloat(document.getElementById('discountRate').value) || 0;
      const t = parseFloat(document.getElementById('taxRate').value) || 20;

      const sub = q * p;
      const disc = sub * (d / 100);
      const afterDisc = sub - disc;
      const tax = afterDisc * (t / 100);
      const tot = afterDisc + tax;

      document.getElementById('displaySubtotal').textContent = sub.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' TL';
      document.getElementById('displayDiscount').textContent = disc.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' TL';
      document.getElementById('displayTax').textContent = tax.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' TL';
      document.getElementById('displayTotal').textContent = tot.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' TL';
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
