<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satın Alma Siparişi Düzenle — <%= order.orderNo %></title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .form-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      box-shadow: var(--shadow-md);
      margin-bottom: 28px;
      position: relative;
      overflow: hidden;
    }
    .form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #6366f1, #8b5cf6);
    }

    .form-card-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }
    .form-card-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      background: rgba(99, 102, 241, 0.15);
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .form-card-title { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); }
    .form-card-sub { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }

    .aesthetic-group { margin-bottom: 16px; }
    .aesthetic-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 6px;
      display: block;
    }
    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      padding: 12px 14px;
      border-radius: 10px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }
    .aesthetic-input[readonly] {
      background: #090d16;
      border-color: #334155;
      color: #818cf8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      cursor: not-allowed;
    }
    .aesthetic-input::placeholder { color: #475569; }

    .btn-indigo-gradient {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 12px 28px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-indigo-gradient:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5); }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link active">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link">⚡ Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link">📩 Talepler</a><a href="/purchase/rfq" class="msn-link">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link active">📦 Siparişler</a><a href="/purchase/goods-receipt" class="msn-link">🚛 Mal Kabul</a>
        <a href="/purchase/suppliers" class="msn-link">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Satın Alma Siparişi Düzenle: <%= order.orderNo %></h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Sipariş detaylarını ve durum bilgisini güncelleyin.</p>
        </div>
        <a href="/purchase/orders" class="btn btn-secondary" style="border-radius: 10px;">← Sipariş Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3); padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= error %>
        </div>
      <% } %>

      <div class="form-card">
        <div class="form-card-header">
          <div class="form-card-icon">📦</div>
          <div>
            <div class="form-card-title">Satın Alma Siparişi Düzenleme Formu</div>
            <div class="form-card-sub">Sipariş miktarları, birim fiyat, tedarikçi ve durum güncellemesi</div>
          </div>
        </div>

        <form action="/purchase/orders/<%= order.id %>/edit" method="POST">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px;">
            <div class="aesthetic-group">
              <label class="aesthetic-label">Sipariş No</label>
              <input type="text" value="<%= order.orderNo %>" class="aesthetic-input" readonly>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Tedarikçi Unvanı *</label>
              <input type="text" name="supplierName" value="<%= order.supplierName %>" class="aesthetic-input" required>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Sipariş Durumu</label>
              <select name="status" class="aesthetic-input" style="cursor: pointer;">
                <option value="Ordered" <%= order.status === 'Ordered' ? 'selected' : '' %>>Ordered (Sipariş Verildi)</option>
                <option value="Pending_Approval" <%= order.status === 'Pending_Approval' ? 'selected' : '' %>>Pending_Approval (Onay Bekliyor)</option>
                <option value="Partial_Received" <%= order.status === 'Partial_Received' ? 'selected' : '' %>>Partial_Received (Kısmi Teslim)</option>
                <option value="Received" <%= order.status === 'Received' ? 'selected' : '' %>>Received (Teslim Alındı / Stok Güncelle)</option>
                <option value="Cancelled" <%= order.status === 'Cancelled' ? 'selected' : '' %>>Cancelled (İptal)</option>
              </select>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Malzeme / Stok Kartı *</label>
              <select name="stockItemId" class="aesthetic-input" required style="cursor: pointer;">
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>" <%= order.stockItemId === item.id ? 'selected' : '' %>><%= item.stockCode %> — <%= item.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Miktar *</label>
              <input type="number" name="quantity" value="<%= order.quantity %>" min="1" step="0.01" class="aesthetic-input" required>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Birim Alış Fiyatı (TL) *</label>
              <input type="number" name="unitPrice" value="<%= order.unitPrice %>" min="0" step="0.01" class="aesthetic-input" required>
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">İskonto Oranı (%)</label>
              <input type="number" name="discountRate" value="<%= order.discountRate %>" min="0" max="100" step="0.1" class="aesthetic-input">
            </div>
            <div class="aesthetic-group">
              <label class="aesthetic-label">Ödeme Koşulu</label>
              <select name="paymentTerm" class="aesthetic-input" style="cursor: pointer;">
                <option value="Vadeli_30" <%= order.paymentTerm === 'Vadeli_30' ? 'selected' : '' %>>30 Gün Vadeli</option>
                <option value="Vadeli_60" <%= order.paymentTerm === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
                <option value="Vadeli_90" <%= order.paymentTerm === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
                <option value="Pesin" <%= order.paymentTerm === 'Pesin' ? 'selected' : '' %>>Peşin Ödeme</option>
              </select>
            </div>
          </div>
          <div class="aesthetic-group" style="margin-top: 6px;">
            <label class="aesthetic-label">Notlar / Açıklama</label>
            <textarea name="notes" class="aesthetic-input" rows="3" placeholder="Sipariş revizyon notları..."><%= order.notes || '' %></textarea>
          </div>
          <div style="display: flex; gap: 14px; margin-top: 14px;">
            <button type="submit" class="btn-indigo-gradient">💾 Değişiklikleri Kaydet</button>
            <a href="/purchase/orders" class="btn btn-secondary" style="border-radius: 10px; padding: 12px 20px;">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
