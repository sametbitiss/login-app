<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teklif Yönetimi (RFQ) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .product-group-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      margin-bottom: 28px;
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }
    .product-group-header {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
      padding: 18px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .product-info-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .product-icon {
      width: 42px;
      height: 42px;
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.3);
      color: #818cf8;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }
    .winner-badge-header {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(5, 150, 105, 0.2) 100%);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #34d399;
      padding: 8px 16px;
      border-radius: 30px;
      font-size: 0.85rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
    }
    .recommendation-row {
      background: rgba(16, 185, 129, 0.05) !important;
      border-left: 4px solid #10b981 !important;
    }
    .fp-score-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 0.85rem;
      font-family: 'JetBrains Mono', monospace;
    }
    .score-high { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
    .score-mid { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
    .score-low { background: rgba(244, 63, 94, 0.2); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.4); }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link active">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link">⚡ Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link">📩 Talepler</a><a href="/purchase/rfq" class="msn-link active">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link">📦 Siparişler</a><a href="/purchase/goods-receipt" class="msn-link">🚛 Mal Kabul</a>
        <a href="/purchase/suppliers" class="msn-link">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Teklif Yönetimi & Fiyat/Performans Analiz Paneli (RFQ)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Gelen tedarikçi tekliflerini ürün bazlı karşılaştırın; sistemin önerdiği en uygun teklifi tek tıkla onaylayın.</p>
        </div>
        <a href="/purchase/rfq/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Teklif Kaydı
        </a>
      </div>

      <!-- KPI Strip -->
      <div class="kpi-strip">
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--indigo">📦</div><div class="kpi-chip-data"><span class="kpi-chip-label">Gruplanan Ürün Sayısı</span><span class="kpi-chip-value"><%= groupedRfqs.length %> Ürün</span></div></div>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--amber">📨</div><div class="kpi-chip-data"><span class="kpi-chip-label">Toplam Gelen Teklif</span><span class="kpi-chip-value"><%= rfqStats.totalRfqs %> Teklif</span></div></div>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--emerald">🏆</div><div class="kpi-chip-data"><span class="kpi-chip-label">Değerlendirilen Gruplar</span><span class="kpi-chip-value"><%= groupedRfqs.filter(g => g.recommendedOffer).length %> Grubun En İyisi Belirlendi</span></div></div>
      </div>

      <div class="filter-bar">
        <form method="GET" action="/purchase/rfq" class="filter-form">
          <div class="filter-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" placeholder="RFQ no, malzeme adı veya tedarikçiye göre ara..." value="<%= filterSearch %>" class="filter-input">
          </div>
          <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Durumlar</option>
            <option value="Draft" <%= filterStatus === 'Draft' ? 'selected' : '' %>>Taslak</option>
            <option value="Sent" <%= filterStatus === 'Sent' ? 'selected' : '' %>>Gönderildi</option>
            <option value="Received" <%= filterStatus === 'Received' ? 'selected' : '' %>>Teklif Alındı</option>
            <option value="Accepted" <%= filterStatus === 'Accepted' ? 'selected' : '' %>>Kabul Edildi</option>
            <option value="Rejected" <%= filterStatus === 'Rejected' ? 'selected' : '' %>>Reddedildi</option>
          </select>
          <button type="submit" class="btn btn-sm">Filtrele</button>
        </form>
      </div>

      <% if (groupedRfqs.length === 0) { %>
        <div class="table-wrapper" style="text-align: center; padding: 4rem; color: var(--text-muted);">
          <div style="font-size: 2.5rem; margin-bottom: 12px;">📨</div>
          Kayıtlı tedarikçi teklifi bulunmamaktadır.
          <br><a href="/purchase/rfq/add" style="color: var(--indigo); font-weight: 600; margin-top: 8px; display: inline-block;">Yeni teklif kaydı oluşturun →</a>
        </div>
      <% } else { %>
        <% groupedRfqs.forEach(group => { %>
          <div class="product-group-card">
            <!-- Group Header -->
            <div class="product-group-header">
              <div class="product-info-title">
                <div class="product-icon">📦</div>
                <div>
                  <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin: 0;">
                    <%= group.itemName %>
                  </h3>
                  <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">
                    Stok Kodu: <strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= group.stockCode %></strong>
                    • Birim: <strong><%= group.unit %></strong> • Kategori: <span class="status-pill status-approved"><%= group.category %></span>
                    • Toplam <strong><%= group.items.length %></strong> Tedarikçi Teklifi Alındı
                  </div>
                </div>
              </div>

              <% if (group.recommendedOffer) { %>
                <div class="winner-badge-header">
                  <span>🏆 <strong>SİSTEM ÖNERİSİ (EN UYGUN F/P TEKLİFİ):</strong></span>
                  <span style="color: #fff; background: #10b981; padding: 2px 8px; border-radius: 12px; font-family: 'JetBrains Mono', monospace;"><%= group.recommendedOffer.supplierName %> (%<%= group.recommendedOffer.fpScore %> F/P Skoru — Birim: <%= parseFloat(group.recommendedOffer.offeredUnitPrice || 0).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= group.recommendedOffer.currency %>)</span>
                </div>
              <% } %>
            </div>

            <!-- Group Offers Table -->
            <div class="table-wrapper" style="border: none; border-radius: 0; box-shadow: none;">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Tedarikçi Firması</th>
                    <th>Teklif No</th>
                    <th>Talep Miktarı</th>
                    <th>Birim Fiyat</th>
                    <th>Toplam Teklif Tutarı</th>
                    <th>Teslim Süresi & Vade</th>
                    <th>F/P Analiz Skoru</th>
                    <th>Durum</th>
                    <th>Aksiyon</th>
                  </tr>
                </thead>
                <tbody>
                  <% group.items.forEach(rfq => { %>
                    <% const isWinner = rfq.isRecommended; %>
                    <tr class="<%= isWinner ? 'recommendation-row' : '' %>">
                      <td>
                        <div style="display: flex; align-items: center; gap: 8px;">
                          <strong style="color: var(--text-primary); font-size: 0.95rem;"><%= rfq.supplierName %></strong>
                          <% if (isWinner) { %>
                            <span style="background: linear-gradient(135deg, #10b981, #059669); color: #fff; font-size: 0.7rem; font-weight: 800; padding: 2px 8px; border-radius: 20px;">🏆 EN UYGUN</span>
                          <% } %>
                        </div>
                        <% if (rfq.supplier) { %>
                          <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                            Kod: <%= rfq.supplier.supplierCode %> • Puan: <strong style="color: var(--emerald);"><%= rfq.supplier.performanceScore || rfq.supplier.qualityScore || 85 %>/100 ⭐</strong>
                          </div>
                        <% } %>
                      </td>
                      <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;"><%= rfq.rfqNo %></strong></td>
                      <td><strong><%= parseFloat(rfq.requestedQuantity).toLocaleString('tr-TR') %> <%= group.unit %></strong></td>
                      <td>
                        <strong style="font-size: 0.95rem; font-family: 'JetBrains Mono', monospace;">
                          <%= rfq.offeredUnitPrice ? parseFloat(rfq.offeredUnitPrice).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ' + rfq.currency : '—' %>
                        </strong>
                      </td>
                      <td>
                        <strong style="color: var(--emerald); font-size: 1rem; font-family: 'JetBrains Mono', monospace;">
                          <%= rfq.offeredTotalPrice ? parseFloat(rfq.offeredTotalPrice).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ' + rfq.currency : '—' %>
                        </strong>
                      </td>
                      <td style="font-size: 0.825rem;">
                        <div>⏱️ <strong><%= rfq.deliveryDays ? rfq.deliveryDays + ' Gün' : 'Hemen Teslim' %></strong></div>
                        <div style="color: var(--text-muted); font-size: 0.75rem;"><%= rfq.paymentTerm || 'Peşin Ödeme' %></div>
                      </td>
                      <td>
                        <% const score = rfq.fpScore || 75; %>
                        <% const scoreClass = score >= 85 ? 'score-high' : (score >= 70 ? 'score-mid' : 'score-low'); %>
                        <div class="fp-score-badge <%= scoreClass %>" title="Fiyat (%50) + Teslimat/Vade (%25) + Tedarikçi Kalite Puanı (%25)">
                          ⭐ %<%= score %> F/P Skoru
                        </div>
                      </td>
                      <td>
                        <% if (rfq.status === 'Accepted') { %>
                          <span class="status-pill status-active">✅ Kabul Edildi</span>
                        <% } else if (rfq.status === 'Rejected') { %>
                          <span class="status-pill status-rejected">❌ Reddedildi</span>
                        <% } else if (rfq.status === 'Received') { %>
                          <span class="status-pill status-approved">📩 Teklif Alındı</span>
                        <% } else if (rfq.status === 'Sent') { %>
                          <span class="status-pill status-pending">📤 Gönderildi</span>
                        <% } else { %>
                          <span class="status-pill status-pending">● <%= rfq.status %></span>
                        <% } %>
                      </td>
                      <td style="white-space: nowrap;">
                        <% if (rfq.status === 'Received' || rfq.status === 'Sent') { %>
                          <form action="/purchase/rfq/<%= rfq.id %>/accept" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-sm" style="<%= isWinner ? 'background: linear-gradient(135deg, #10b981, #059669); color: #fff; font-weight: 800; box-shadow: 0 4px 12px rgba(16,185,129,0.3);' : 'background: var(--emerald); color: #fff;' %>">
                              <%= isWinner ? '🏆 Bu Teklifi Onayla & Siparişe Dönüştür' : '✅ Kabul Et' %>
                            </button>
                          </form>
                          <form action="/purchase/rfq/<%= rfq.id %>/reject" method="POST" style="display: inline; margin-left: 4px;">
                            <button type="submit" class="btn btn-sm" style="background: var(--rose);">❌ Red</button>
                          </form>
                        <% } else { %>
                          <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% }); %>
      <% } %>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
