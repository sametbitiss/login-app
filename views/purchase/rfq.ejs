<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teklif Yönetimi (RFQ) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link active">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link">⚡ Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link">📩 Talepler</a><a href="/purchase/rfq" class="msn-link active">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link">📦 Siparişler</a><a href="/purchase/goods-receipt" class="msn-link">🚛 Mal Kabul</a>
        <a href="/purchase/suppliers" class="msn-link">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Satın Alma Teklif Listesi (RFQ)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tedarikçilerden gelen tüm teklif kayıtlarının listesi (Talepler Kartından oluşturulur).</p>
        </div>
      </div>

      <!-- KPI Strip -->
      <div class="kpi-strip">
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--indigo">📨</div><div class="kpi-chip-data"><span class="kpi-chip-label">Toplam Teklif Kaydı</span><span class="kpi-chip-value"><%= rfqs.length %> Teklif</span></div></div>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--amber">⏳</div><div class="kpi-chip-data"><span class="kpi-chip-label">Teklif Alınan</span><span class="kpi-chip-value"><%= rfqs.filter(r => r.status === 'Received').length %></span></div></div>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--emerald">✅</div><div class="kpi-chip-data"><span class="kpi-chip-label">Kabul Edilen</span><span class="kpi-chip-value"><%= rfqs.filter(r => r.status === 'Accepted').length %></span></div></div>
      </div>

      <!-- Filter Bar -->
      <div class="filter-bar">
        <form method="GET" action="/purchase/rfq" class="filter-form">
          <div class="filter-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" placeholder="Teklif no veya tedarikçi adına göre ara..." value="<%= filterSearch %>" class="filter-input">
          </div>
          <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Durumlar</option>
            <option value="Received" <%= filterStatus === 'Received' ? 'selected' : '' %>>Teklif Alındı</option>
            <option value="Draft" <%= filterStatus === 'Draft' ? 'selected' : '' %>>Taslak</option>
            <option value="Sent" <%= filterStatus === 'Sent' ? 'selected' : '' %>>Gönderildi</option>
            <option value="Accepted" <%= filterStatus === 'Accepted' ? 'selected' : '' %>>Kabul Edildi</option>
            <option value="Rejected" <%= filterStatus === 'Rejected' ? 'selected' : '' %>>Reddedildi</option>
          </select>
          <button type="submit" class="btn btn-sm">Filtrele</button>
        </form>
      </div>

      <div class="results-info"><span>Toplam <strong><%= rfqs.length %></strong> teklif kaydı listeleniyor</span></div>

      <!-- Flat Table View -->
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Teklif No</th>
              <th>Tedarikçi</th>
              <th>Teklif Tarihi</th>
              <th>Kalemler / Ürün Özeti</th>
              <th>Genel Toplam</th>
              <th>Ödeme & Teslimat</th>
              <th>KDV & Nakliye</th>
              <th>Durum</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (rfqs.length === 0) { %>
              <tr>
                <td colspan="9" style="text-align: center; padding: 4rem; color: var(--text-muted);">
                  <div style="font-size: 2.5rem; margin-bottom: 8px;">📨</div>
                  Henüz verilmiş veya kaydedilmiş teklif bulunmamaktadır.<br>
                  <a href="/purchase/rfq/add" style="color: var(--indigo); font-weight: 600; margin-top: 8px; display: inline-block;">Yeni teklif kaydı oluşturun →</a>
                </td>
              </tr>
            <% } else { %>
              <% rfqs.forEach(rfq => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;"><%= rfq.rfqNo %></strong></td>
                  <td>
                    <strong style="color: var(--text-primary); font-size: 0.925rem;"><%= rfq.supplierName %></strong>
                    <% if (rfq.supplier) { %><div style="font-size: 0.75rem; color: var(--text-muted);"><%= rfq.supplier.supplierCode %></div><% } %>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);">
                    <%= rfq.rfqDate ? new Date(rfq.rfqDate).toLocaleDateString('tr-TR') : new Date(rfq.createdAt).toLocaleDateString('tr-TR') %>
                    <% if (rfq.validUntil) { %><div style="font-size: 0.725rem; color: var(--amber);">Geçerlilik: <%= new Date(rfq.validUntil).toLocaleDateString('tr-TR') %></div><% } %>
                  </td>
                  <td>
                    <% if (rfq.itemsData && Array.isArray(rfq.itemsData) && rfq.itemsData.length > 0) { %>
                      <strong style="color: var(--text-primary); font-size: 0.85rem;"><%= rfq.itemsData.length %> Kalem Ürün</strong>
                      <div style="font-size: 0.75rem; color: var(--text-muted); text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 220px;">
                        <%= rfq.itemsData.map(i => i.productName || i.stockCode).join(', ') %>
                      </div>
                    <% } else if (rfq.stockItem) { %>
                      <strong style="color: var(--text-primary); font-size: 0.85rem;"><%= rfq.stockItem.name %></strong>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= rfq.requestedQuantity %> <%= rfq.stockItem.unit %></div>
                    <% } else { %>
                      <span style="color: var(--text-muted);">—</span>
                    <% } %>
                  </td>
                  <td>
                    <strong style="color: var(--emerald); font-size: 1rem; font-family: 'JetBrains Mono', monospace;">
                      <%= parseFloat(rfq.offeredTotalPrice || rfq.subtotal || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> <%= rfq.currency || 'TRY' %>
                    </strong>
                  </td>
                  <td style="font-size: 0.825rem;">
                    <div>⏱️ <strong><%= rfq.deliveryDays ? rfq.deliveryDays + ' Gün' : 'Hemen Teslim' %></strong></div>
                    <div style="color: var(--text-muted); font-size: 0.75rem;"><%= rfq.paymentTerm || 'Peşin Ödeme' %></div>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);">
                    <div>KDV: <%= rfq.vatStatus || 'Hariç' %></div>
                    <div style="font-size: 0.725rem;"><%= rfq.shippingStatus || 'Fiyata Dahil' %></div>
                  </td>
                  <td>
                    <% if (rfq.status === 'Accepted') { %>
                      <span class="status-pill status-active">✅ Kabul Edildi</span>
                    <% } else if (rfq.status === 'Rejected') { %>
                      <span class="status-pill status-rejected">❌ Reddedildi</span>
                    <% } else if (rfq.status === 'Received') { %>
                      <span class="status-pill status-approved">📩 Teklif Alındı</span>
                    <% } else if (rfq.status === 'Sent') { %>
                      <span class="status-pill status-pending">📤 Gönderildi</span>
                    <% } else { %>
                      <span class="status-pill status-pending">● <%= rfq.status %></span>
                    <% } %>
                  </td>
                  <td style="white-space: nowrap;">
                    <% if (rfq.status === 'Received' || rfq.status === 'Sent' || rfq.status === 'Draft') { %>
                      <form action="/purchase/rfq/<%= rfq.id %>/accept" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-sm btn-success">✅ Kabul</button>
                      </form>
                      <form action="/purchase/rfq/<%= rfq.id %>/reject" method="POST" style="display: inline; margin-left: 4px;">
                        <button type="submit" class="btn btn-sm" style="background: var(--rose);">❌ Red</button>
                      </form>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
