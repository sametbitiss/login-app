<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teklif Yönetimi (RFQ) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* View Navigation Tabs */
    .view-tab-nav {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(16px);
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      padding: 6px;
      border-radius: 16px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    }
    .view-tab-btn {
      flex: 1;
      background: transparent;
      border: none;
      color: #94a3b8;
      font-size: 0.9rem;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .view-tab-btn:hover { color: #f8fafc; background: rgba(255, 255, 255, 0.06); }
    .view-tab-btn.active {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #ffffff;
      font-weight: 800;
      box-shadow: 0 8px 24px rgba(99, 102, 241, 0.45);
    }

    .view-pane { display: none; }
    .view-pane.active { display: block; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

    /* Currency Rates Live Strip */
    .currency-live-bar {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(139, 92, 246, 0.15) 100%);
      border: 1.5px solid rgba(99, 102, 241, 0.3);
      border-radius: 14px;
      padding: 12px 20px;
      margin-bottom: 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .currency-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      color: #f8fafc;
      background: rgba(15, 23, 42, 0.7);
      padding: 4px 12px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 0.85rem;
    }

    /* Product Cards Grid — 2 per row */
    .product-cards-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
      margin-bottom: 2.5rem;
    }
    @media (max-width: 1100px) {
      .product-cards-grid { grid-template-columns: 1fr; }
    }

    .product-box-card {
      background: linear-gradient(145deg, rgba(15, 23, 42, 0.97) 0%, rgba(30, 41, 59, 0.92) 100%);
      backdrop-filter: blur(20px);
      border-radius: 22px;
      border: 1.5px solid rgba(255, 255, 255, 0.12);
      padding: 0;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease;
      position: relative;
      overflow: hidden;
    }
    .product-box-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 40%, #d946ef 70%, #10b981 100%);
    }
    .product-box-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 24px 55px rgba(0, 0, 0, 0.55);
      border-color: rgba(99, 102, 241, 0.4);
    }

    /* Product Box Header */
    .pbc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 24px 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .pbc-title-wrap { display: flex; align-items: center; gap: 12px; }
    .pbc-icon-box {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: rgba(99, 102, 241, 0.18);
      border: 1px solid rgba(99, 102, 241, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }
    .pbc-title { font-size: 1.08rem; font-weight: 800; color: #f8fafc; margin: 0; letter-spacing: -0.3px; }
    .pbc-code { font-size: 0.75rem; color: #818cf8; font-family: 'JetBrains Mono', monospace; font-weight: 600; }
    .pbc-count-badge {
      background: rgba(99, 102, 241, 0.18);
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.4);
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 800;
    }

    /* Recommended Offer Banner */
    .pbc-winner-banner {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(5, 150, 105, 0.25));
      border: 1.5px solid rgba(16, 185, 129, 0.4);
      border-radius: 14px;
      padding: 12px 16px;
      margin: 14px 20px 0;
    }
    .pbc-winner-tag { font-size: 0.7rem; color: #34d399; font-weight: 900; letter-spacing: 0.5px; text-transform: uppercase; }
    .pbc-winner-details { display: flex; justify-content: space-between; align-items: center; margin-top: 5px; font-size: 0.9rem; color: #ffffff; }
    .pbc-winner-price { color: #34d399; font-weight: 800; font-family: 'JetBrains Mono', monospace; font-size: 0.95rem; }
    .pbc-winner-score { font-size: 0.72rem; color: #a7f3d0; margin-top: 2px; }

    /* Offers List */
    .pbc-offers-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 16px 20px 20px;
    }

    /* Offer Item Card */
    .pbc-offer-item {
      background: rgba(30, 41, 59, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      overflow: hidden;
      transition: all 0.2s ease;
    }
    .pbc-offer-item:hover {
      border-color: rgba(99, 102, 241, 0.35);
      background: rgba(30, 41, 59, 0.7);
    }
    .pbc-offer-item.is-winner {
      background: rgba(16, 185, 129, 0.06);
      border-color: rgba(16, 185, 129, 0.35);
    }

    /* Offer Top Row */
    .pbc-oi-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 16px 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .pbc-oi-supplier { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .pbc-oi-supplier-name { font-size: 0.92rem; font-weight: 800; color: #f8fafc; }
    .pbc-oi-rfqno {
      font-size: 0.7rem;
      color: #818cf8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 600;
      background: rgba(99, 102, 241, 0.12);
      padding: 2px 8px;
      border-radius: 6px;
    }
    .pbc-winner-pill { background: #10b981; color: #fff; font-size: 0.65rem; font-weight: 800; padding: 2px 8px; border-radius: 6px; }
    .pbc-oi-total-price {
      font-size: 1.05rem;
      font-weight: 900;
      color: #34d399;
      font-family: 'JetBrains Mono', monospace;
      text-align: right;
    }

    /* Offer Item Lines Table */
    .offer-items-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }
    .offer-items-table th {
      background: rgba(15, 23, 42, 0.5);
      color: #64748b;
      font-weight: 800;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 8px 14px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .offer-items-table td {
      padding: 8px 14px;
      color: #cbd5e1;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      font-weight: 500;
    }
    .offer-items-table tr:last-child td { border-bottom: none; }
    .offer-items-table .item-price { color: #34d399; font-weight: 700; font-family: 'JetBrains Mono', monospace; }
    .offer-items-table .item-discount { color: #fb7185; font-weight: 700; font-family: 'JetBrains Mono', monospace; }
    .offer-items-table .item-net { color: #fbbf24; font-weight: 800; font-family: 'JetBrains Mono', monospace; }

    /* Offer Bottom */
    .pbc-oi-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 16px 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      flex-wrap: wrap;
      gap: 10px;
    }
    .pbc-oi-meta-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .pbc-oi-meta-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.75rem;
      color: #94a3b8;
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 3px 10px;
      border-radius: 8px;
      font-weight: 600;
    }
    .pbc-oi-meta-chip strong { color: #f8fafc; }

    .pbc-status-pill { font-size: 0.75rem; font-weight: 600; padding: 3px 10px; border-radius: 8px; }

    .btn-accept-order {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #fff;
      font-size: 0.8rem;
      font-weight: 800;
      padding: 8px 16px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35);
      transition: all 0.2s ease;
    }
    .btn-accept-order:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 22px rgba(16, 185, 129, 0.5);
    }
    .btn-delete-item {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #f87171;
      padding: 6px 10px;
      border-radius: 8px;
      font-size: 0.78rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-delete-item:hover {
      background: #ef4444;
      color: #fff;
    }

    /* Locked group */
    .product-box-card.is-locked { opacity: 0.8; }
    .product-box-card.is-locked::before {
      background: linear-gradient(90deg, #64748b 0%, #475569 50%, #64748b 100%);
    }
    .locked-banner {
      background: rgba(100, 116, 139, 0.15);
      border: 1.5px solid rgba(100, 116, 139, 0.4);
      border-radius: 12px;
      padding: 12px 16px;
      margin: 14px 20px 0;
      display: flex; align-items: center; gap: 10px;
      color: #94a3b8; font-size: 0.82rem; font-weight: 700;
    }
    .pbc-offer-item.is-disabled {
      opacity: 0.45;
      filter: grayscale(40%);
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>

<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link active">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %>
        <% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
          <h1 style="font-size: 1.6rem; font-weight: 900; color: #f8fafc; margin: 0; letter-spacing: -0.4px;">Satın Alma Teklif Yönetimi (RFQ)</h1>
          <p style="color: #94a3b8; font-size: 0.9rem; margin-top: 4px;">Talep edilen ürün kutucukları üzerinden teklifler ve kur normalizasyonlu Fiyat/Performans değerlendirmeleri.</p>
        </div>
        <div style="display: flex; gap: 12px;">
          <a href="/purchase/requisitions" class="btn btn-secondary" style="border-radius: 12px; font-weight: 700;">
            📋 Talepler Listesi
          </a>
          <a href="/purchase/rfq/add" class="btn" style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; font-weight: 800; padding: 10px 20px; border-radius: 12px; text-decoration: none; box-shadow: 0 4px 16px rgba(99, 102, 241, 0.4);">
            ➕ Yeni Teklif Ekle
          </a>
        </div>
      </div>

      <!-- Live Currency Rates Strip -->
      <div class="currency-live-bar">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 1.2rem;">💱</span>
          <div>
            <strong style="color: #f8fafc; font-size: 0.88rem;">Canlı Döviz Kurları Entegrasyonu (TCMB / Piyasa):</strong>
            <div style="font-size: 0.76rem; color: #cbd5e1;">Dolar ($) ve Euro (€) teklifler anlık kurlar üzerinden TL'ye çevrilerek adil F/P skoru hesaplanır.</div>
          </div>
        </div>
        <div style="display: flex; gap: 10px;">
          <div class="currency-tag">
            <span style="color: #38bdf8;">USD:</span> ₺ <%= (typeof liveRates !== 'undefined' && liveRates.USD ? liveRates.USD.toFixed(2) : '48.08') %>
          </div>
          <div class="currency-tag">
            <span style="color: #c084fc;">EUR:</span> ₺ <%= (typeof liveRates !== 'undefined' && liveRates.EUR ? liveRates.EUR.toFixed(2) : '56.09') %>
          </div>
        </div>
      </div>

      <!-- KPI Strip -->
      <div class="kpi-strip" style="display: flex; gap: 16px; margin-bottom: 24px;">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">📦</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Ürün Kart Kutucuğu</span>
            <span class="kpi-chip-value"><%= groupedRfqs.length %> Ürün</span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">📨</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Toplam Gelen Teklif</span>
            <span class="kpi-chip-value"><%= rfqs.length %> Teklif</span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">⭐</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Önerilen En Uygun</span>
            <span class="kpi-chip-value"><%= groupedRfqs.filter(g => g.recommendedOffer).length %> Teklif</span>
          </div>
        </div>
      </div>

      <!-- View Tabs -->
      <div class="view-tab-nav">
        <button type="button" class="view-tab-btn active" onclick="switchViewTab('grouped-view')" id="btn-grouped-view">
          📦 Ürün Kart Kutucukları (<%= groupedRfqs.length %> Ürün)
        </button>
        <button type="button" class="view-tab-btn" onclick="switchViewTab('flat-view')" id="btn-flat-view">
          📋 Tüm Teklifler (Düz Liste - <%= rfqs.length %> Teklif)
        </button>
      </div>

      <!-- VIEW 1: PRODUCT CARDS BOX GRID VIEW -->
      <div class="view-pane active" id="grouped-view">
        <% if (groupedRfqs.length === 0) { %>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border); border-radius: 16px; text-align: center; padding: 4rem; color: var(--text-muted);">
            <div style="font-size: 2.5rem; margin-bottom: 12px;">📦</div>
            Henüz kaydedilmiş ürün teklif kutucuğu bulunmamaktadır.<br>
            <a href="/purchase/requisitions" style="color: var(--indigo); font-weight: 700; margin-top: 10px; display: inline-block;">Satın Alma Talepleri Ekranına Git →</a>
          </div>
        <% } else { %>
          <div class="product-cards-grid">
            <% groupedRfqs.forEach(group => { %>
              <div class="product-box-card <%= group.isLocked ? 'is-locked' : '' %>">
                <!-- Product Header -->
                <div class="pbc-header">
                  <div class="pbc-title-wrap">
                    <div class="pbc-icon-box"><%= group.isLocked ? '🔒' : '📦' %></div>
                    <div>
                      <h3 class="pbc-title"><%= group.itemName %></h3>
                      <span class="pbc-code"><%= group.stockCode %> • <%= group.unit %></span>
                    </div>
                  </div>
                  <span class="pbc-count-badge"><%= group.items.length %> Teklif</span>
                </div>

                <% if (group.isLocked) { %>
                  <div class="locked-banner">
                    🔒 Bu ürün grubu kapatılmıştır — İlgili ürün için teklif kabul edilmiş ve sipariş oluşturulmuştur.
                  </div>
                <% } %>

                <% if (group.recommendedOffer && !group.isLocked) { 
                  const rec = group.recommendedOffer;
                  const recCurr = rec.currency || 'TRY';
                  const recPrice = parseFloat(rec.totalPrice || rec.offeredTotalPrice || 0);
                  const recPriceTRY = parseFloat(rec.totalPriceTRY || recPrice);
                %>
                  <div class="pbc-winner-banner">
                    <div class="pbc-winner-tag">⭐ EN UYGUN ÖNERİLEN TEKLİF (F/P LİDERİ)</div>
                    <div class="pbc-winner-details">
                      <strong><%= rec.supplierName %></strong>
                      <span class="pbc-winner-price">
                        <%= recPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= recCurr %>
                        <% if (recCurr !== 'TRY' && recCurr !== 'TL') { %>
                          <span style="font-size: 0.78rem; color: #a7f3d0; font-weight: 600;">(≈ ₺ <%= recPriceTRY.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %>)</span>
                        <% } %>
                      </span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
                      <% if (rec.fpScore) { %>
                        <div class="pbc-winner-score">Fiyat/Performans Skoru: <strong>%<%= rec.fpScore %></strong></div>
                      <% } %>
                      <% if (recCurr !== 'TRY' && recCurr !== 'TL') { %>
                        <div style="font-size: 0.7rem; color: #a7f3d0; font-family: 'JetBrains Mono', monospace;">
                          💱 1 <%= recCurr %> = ₺ <%= (liveRates[recCurr] || 1).toFixed(2) %>
                        </div>
                      <% } %>
                    </div>
                  </div>
                <% } %>

                <!-- Offers List -->
                <div class="pbc-offers-list">
                  <% group.items.forEach(item => {
                    const itemsArr = (item.itemsData && Array.isArray(item.itemsData)) ? item.itemsData : [];
                    const totalPrice = parseFloat(item.totalPrice || item.offeredTotalPrice || item.subtotal || 0);
                    const totalPriceTRY = parseFloat(item.totalPriceTRY || totalPrice);
                    const curr = item.currency || 'TRY';
                    const isForeign = curr !== 'TRY' && curr !== 'TL';
                    const currSymbol = curr === 'USD' ? '$' : (curr === 'EUR' ? '€' : '₺');
                    const isItemDisabled = group.isLocked && item.status !== 'Accepted';
                  %>
                    <div class="pbc-offer-item <%= item.isRecommended ? 'is-winner' : '' %> <%= isItemDisabled ? 'is-disabled' : '' %>">
                      <!-- Supplier & Total -->
                      <div class="pbc-oi-top">
                        <div class="pbc-oi-supplier">
                          <span class="pbc-oi-supplier-name"><%= item.supplierName %></span>
                          <span class="pbc-oi-rfqno"><%= item.rfqNo %></span>
                          <% if (item.isRecommended && !group.isLocked) { %><span class="pbc-winner-pill">⭐ Önerilen</span><% } %>
                        </div>
                        <div class="pbc-oi-total-price">
                          <div><%= totalPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= currSymbol %></div>
                          <% if (isForeign) { %>
                            <div style="font-size: 0.72rem; color: #818cf8; font-weight: 700; margin-top: 1px;">
                              ≈ ₺ <%= totalPriceTRY.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %>
                            </div>
                          <% } %>
                        </div>
                      </div>

                      <!-- Product Items Detail Table -->
                      <% if (itemsArr.length > 0) { %>
                        <table class="offer-items-table">
                          <thead>
                            <tr>
                              <th>Ürün Kalemi</th>
                              <th>Miktar</th>
                              <th>Birim Fiyat</th>
                              <th>İskonto</th>
                              <th>Net Tutar</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% itemsArr.forEach(line => {
                              const linePrice = parseFloat(line.birimFiyat || line.unitPrice || 0);
                              const lineQty = parseFloat(line.teklifEdilenMiktar || line.miktar || line.quantity || 1);
                              const lineDisc = parseFloat(line.iskontoOrani || line.discountRate || 0);
                              const lineNet = parseFloat(line.netAmount || line.netTutar || (lineQty * linePrice * (1 - lineDisc / 100)));
                            %>
                              <tr>
                                <td><strong style="color: #e2e8f0;"><%= line.ad || line.productName || line.stokKodu || '—' %></strong></td>
                                <td><%= lineQty.toLocaleString('tr-TR') %> <%= line.birim || line.unit || group.unit %></td>
                                <td class="item-price">
                                  <%= linePrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= currSymbol %>
                                  <% if (isForeign && liveRates[curr]) { %>
                                    <div style="font-size: 0.68rem; color: #818cf8; font-weight: 600;">≈ ₺ <%= (linePrice * liveRates[curr]).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %></div>
                                  <% } %>
                                </td>
                                <td class="item-discount"><%= lineDisc > 0 ? '%' + lineDisc.toFixed(1) : '—' %></td>
                                <td class="item-net">
                                  <%= lineNet.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= currSymbol %>
                                  <% if (isForeign && liveRates[curr]) { %>
                                    <div style="font-size: 0.68rem; color: #cbd5e1; font-weight: 600;">≈ ₺ <%= (lineNet * liveRates[curr]).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %></div>
                                  <% } %>
                                </td>
                              </tr>
                            <% }); %>
                          </tbody>
                        </table>
                      <% } else { %>
                        <!-- Fallback for single item -->
                        <table class="offer-items-table">
                          <thead>
                            <tr>
                              <th>Ürün Kalemi</th>
                              <th>Miktar</th>
                              <th>Birim Fiyat</th>
                              <th>İskonto</th>
                              <th>Net Tutar</th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr>
                              <td><strong style="color: #e2e8f0;"><%= group.itemName %></strong></td>
                              <td><%= item.itemQuantity || item.requestedQuantity || 1 %> <%= group.unit %></td>
                              <td class="item-price"><%= parseFloat(item.itemUnitPrice || item.offeredUnitPrice || 0).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= currSymbol %></td>
                              <td class="item-discount">—</td>
                              <td class="item-net"><%= totalPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= currSymbol %></td>
                            </tr>
                          </tbody>
                        </table>
                      <% } %>

                      <!-- Bottom: Meta chips + Actions -->
                      <div class="pbc-oi-bottom">
                        <div class="pbc-oi-meta-row">
                          <span class="pbc-oi-meta-chip">⏱️ Teslimat: <strong><%= item.deliveryDays ? item.deliveryDays + ' Gün' : '5 Gün' %></strong></span>
                          <span class="pbc-oi-meta-chip">💳 Vade: <strong><%= item.paymentTerm === 'Pesin' ? 'Peşin' : (item.paymentTerm === 'Vadeli_30' ? '30 Gün Vadeli' : item.paymentTerm) %></strong></span>
                          <% if (item.fpScore) { %>
                            <span class="pbc-oi-meta-chip" style="background: rgba(99, 102, 241, 0.15); border-color: rgba(99, 102, 241, 0.3); color: #818cf8;">
                              📊 F/P Skoru: <strong>%<%= item.fpScore %></strong>
                            </span>
                          <% } %>
                          <% if (isForeign && liveRates[curr]) { %>
                            <span class="pbc-oi-meta-chip" style="color: #38bdf8; font-family: 'JetBrains Mono', monospace;">
                              💱 1 <%= curr %> = ₺ <%= liveRates[curr].toFixed(2) %>
                            </span>
                          <% } %>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                          <% if (item.status === 'Accepted') { %>
                            <span class="pbc-status-pill status-active">✅ Kabul Edildi</span>
                          <% } else if (item.status === 'Rejected') { %>
                            <span class="pbc-status-pill status-rejected">❌ Pasif (Reddedildi)</span>
                          <% } else if (group.isLocked) { %>
                            <span class="pbc-status-pill status-rejected">🔒 Pasif (İlgili ürünler başka teklifte kabul edildi)</span>
                          <% } else { %>
                            <span class="pbc-status-pill status-approved">📩 Teklif Alındı</span>
                            <a href="/purchase/rfq/<%= item.id %>/accept" class="btn-accept-order" onclick="return confirm('Bu teklifi kabul edip otomatik Satın Alma Siparişi oluşturmak istediğinizden emin misiniz?');">
                              ✅ Kabul Et & Sipariş Oluştur
                            </a>
                            <a href="/purchase/rfq/<%= item.id %>/delete" class="btn-delete-item" onclick="return confirm('Bu teklifi silmek istediğinizden emin misiniz?');" title="Sil">
                              🗑️
                            </a>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- VIEW 2: FLAT LIST VIEW -->
      <div class="view-pane" id="flat-view">
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Teklif No</th>
                <th>Tedarikçi</th>
                <th>Teklif Tarihi</th>
                <th>Kalemler / Ürün Özeti</th>
                <th style="text-align: right;">Genel Toplam</th>
                <th>Ödeme & Teslimat</th>
                <th>KDV</th>
                <th>Durum</th>
                <th style="text-align: right;">Aksiyon</th>
              </tr>
            </thead>
            <tbody>
              <% if (rfqs.length === 0) { %>
                <tr>
                  <td colspan="9" style="text-align: center; padding: 4rem; color: var(--text-muted);">
                    <div style="font-size: 2.5rem; margin-bottom: 8px;">📨</div>
                    Henüz verilmiş veya kaydedilmiş teklif bulunmamaktadır.
                  </td>
                </tr>
              <% } else { %>
                <% rfqs.forEach(rfq => { 
                  const isForeign = rfq.currency !== 'TRY' && rfq.currency !== 'TL';
                %>
                  <tr>
                    <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.88rem;"><%= rfq.rfqNo %></strong></td>
                    <td>
                      <strong style="color: var(--text-primary); font-size: 0.925rem;"><%= rfq.supplierName %></strong>
                      <% if (rfq.supplierCode) { %>
                        <div style="font-size: 0.75rem; color: var(--text-muted);"><%= rfq.supplierCode %></div>
                      <% } %>
                    </td>
                    <td style="font-size: 0.8rem; color: var(--text-muted);">
                      <%= rfq.rfqDate ? new Date(rfq.rfqDate).toLocaleDateString('tr-TR') : new Date(rfq.createdAt).toLocaleDateString('tr-TR') %>
                      <% if (rfq.validUntil) { %>
                        <div style="font-size: 0.725rem; color: var(--amber);">Geçerlilik: <%= new Date(rfq.validUntil).toLocaleDateString('tr-TR') %></div>
                      <% } %>
                    </td>
                    <td>
                      <% if (rfq.itemsData && Array.isArray(rfq.itemsData) && rfq.itemsData.length > 0) { %>
                        <strong style="color: var(--text-primary); font-size: 0.85rem;"><%= rfq.itemsData.length %> Kalem Ürün</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted); text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 220px;">
                          <%= rfq.itemsData.map(i => i.ad || i.productName || i.stokKodu).join(', ') %>
                        </div>
                      <% } else if (rfq.stokKarti) { %>
                        <strong style="color: var(--text-primary); font-size: 0.85rem;"><%= rfq.stokKarti.ad %></strong>
                      <% } else { %>
                        <span style="color: var(--text-muted);">—</span>
                      <% } %>
                    </td>
                    <td style="text-align: right;">
                      <strong style="color: var(--emerald); font-size: 1rem; font-family: 'JetBrains Mono', monospace;">
                        <%= parseFloat(rfq.totalPrice || rfq.offeredTotalPrice || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> <%= rfq.currency || 'TRY' %>
                      </strong>
                      <% if (isForeign && rfq.totalPriceTRY) { %>
                        <div style="font-size: 0.72rem; color: #818cf8; font-weight: 700; font-family: 'JetBrains Mono', monospace;">
                          ≈ ₺ <%= parseFloat(rfq.totalPriceTRY).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %>
                        </div>
                      <% } %>
                    </td>
                    <td style="font-size: 0.825rem;">
                      <div>⏱️ <strong><%= rfq.deliveryDays ? rfq.deliveryDays + ' Gün' : '5 Gün' %></strong></div>
                      <div style="color: var(--text-muted); font-size: 0.75rem;"><%= rfq.paymentTerm === 'Pesin' ? 'Peşin' : rfq.paymentTerm %></div>
                    </td>
                    <td style="font-size: 0.8rem; color: var(--text-muted);">
                      <div><%= rfq.vatStatus || 'Hariç' %></div>
                    </td>
                    <td>
                      <% if (rfq.status === 'Accepted') { %>
                        <span class="status-pill status-active">✅ Kabul Edildi</span>
                      <% } else if (rfq.status === 'Rejected') { %>
                        <span class="status-pill status-rejected">❌ Reddedildi</span>
                      <% } else { %>
                        <span class="status-pill status-pending">⏳ Beklemede</span>
                      <% } %>
                    </td>
                    <td style="white-space: nowrap; text-align: right;">
                      <% if (rfq.status !== 'Accepted' && rfq.status !== 'Rejected') { %>
                        <a href="/purchase/rfq/<%= rfq.id %>/accept" class="btn-accept-order" style="font-size: 0.75rem; padding: 6px 14px;" onclick="return confirm('Bu teklifi kabul edip otomatik Satın Alma Siparişi oluşturmak istediğinizden emin misiniz?');">
                          ✅ Kabul Et
                        </a>
                      <% } %>
                      <a href="/purchase/rfq/<%= rfq.id %>/delete" class="btn-delete-item" onclick="return confirm('Bu teklifi silmek istediğinizden emin misiniz?');" style="margin-left: 4px;">
                        🗑️
                      </a>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    function switchViewTab(viewId) {
      document.querySelectorAll('.view-pane').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.view-tab-btn').forEach(el => el.classList.remove('active'));

      const targetPane = document.getElementById(viewId);
      const targetBtn = document.getElementById('btn-' + viewId);

      if (targetPane) targetPane.classList.add('active');
      if (targetBtn) targetBtn.classList.add('active');
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>