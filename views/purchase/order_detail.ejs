<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satın Alma Sipariş Formu — <%= order.orderNo %></title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .order-box { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 36px; box-shadow: var(--shadow-md); max-width: 900px; margin: 0 auto; }
    .order-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid var(--border); padding-bottom: 24px; margin-bottom: 24px; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px; }
    .info-label { font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 4px; }
    .info-val { font-size: 1rem; font-weight: 600; color: var(--text-primary); }
    @media print {
      .module-sidebar, .module-topbar, .module-subnav, .no-print { display: none !important; }
      .module-main { margin-left: 0 !important; padding: 0 !important; }
      body { background: #fff !important; color: #000 !important; }
      .order-box { border: 1px solid #ddd !important; box-shadow: none !important; color: #000 !important; background: #fff !important; }
      .info-val { color: #000 !important; }
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar no-print">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link active">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar no-print">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div style="display: flex; justify-content: space-between; align-items: center; max-width: 900px; margin: 0 auto 1rem auto;" class="no-print">
        <a href="/purchase/orders" class="btn btn-secondary">← Sipariş Listesine Dön</a>
        <button onclick="window.print()" class="btn">🖨️ Sipariş Formunu Yazdır / PDF</button>
      </div>

      <div class="order-box">
        <div class="order-header">
          <div>
            <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--indigo);">RESMİ SATIN ALMA SİPARİŞ FORMU</h2>
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 1rem; color: var(--text-secondary); margin-top: 4px;">Sipariş No: <strong><%= order.orderNo %></strong></div>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 0.85rem; color: var(--text-muted);">Sipariş Tarihi: <%= new Date(order.orderDate).toLocaleDateString('tr-TR') %></div>
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Beklenen Teslimat: <%= order.expectedDeliveryDate ? new Date(order.expectedDeliveryDate).toLocaleDateString('tr-TR') : '—' %></div>
            <div style="margin-top: 8px;"><span class="status-pill status-active">● <%= order.status %></span></div>
          </div>
        </div>

        <div class="grid-2">
          <div>
            <h4 style="font-size: 0.9rem; color: var(--indigo); margin-bottom: 8px;">🏢 TEDARİKÇİ BİLGİLERİ</h4>
            <div class="info-val"><%= order.supplierName %></div>
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;"><%= order.supplierTaxNo ? 'VN: ' + order.supplierTaxNo : '' %></div>
            <div style="font-size: 0.85rem; color: var(--text-secondary);"><%= order.supplierContactPerson ? 'İletişim: ' + order.supplierContactPerson : '' %></div>
            <div style="font-size: 0.85rem; color: var(--text-secondary);"><%= order.supplierEmail ? 'E-Posta: ' + order.supplierEmail : '' %></div>
          </div>
          <div>
            <h4 style="font-size: 0.9rem; color: var(--indigo); margin-bottom: 8px;">🚚 TESLİMAT & ÖDEME</h4>
            <div style="font-size: 0.88rem; color: var(--text-primary); background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); padding: 8px 12px; border-radius: 8px; margin-bottom: 8px;">
              Mal Kabulün Yapılacağı Depo: <strong style="color: var(--indigo); font-weight: 800;">🏬 <%= order.deliveryWarehouse || 'Ana Hammadde Ambarı' %></strong>
            </div>
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;">Ödeme Koşulu: <strong><%= order.paymentTerm %></strong></div>
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;">Satın Alma Sorumlusu: <strong><%= order.purchasingAgent || '—' %></strong></div>
          </div>
        </div>

        <div class="table-wrapper" style="margin-bottom: 24px;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Malzeme / Stok Kodu</th>
                <th>Açıklama</th>
                <th>Miktar</th>
                <th>Birim Fiyat</th>
                <th>İskonto</th>
                <th>KDV (%<%= order.taxRate %>)</th>
                <th>Toplam Tutar</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <strong><%= order.stockItem ? order.stockItem.name : 'Malzeme' %></strong>
                  <div style="font-size: 0.75rem; color: var(--text-muted);"><%= order.stockItem ? order.stockItem.stockCode : '' %></div>
                </td>
                <td style="font-size: 0.85rem; color: var(--text-secondary);"><%= order.notes || '—' %></td>
                <td><strong><%= parseFloat(order.quantity).toLocaleString('tr-TR') %> <%= order.stockItem ? order.stockItem.unit : '' %></strong></td>
                <td><%= parseFloat(order.unitPrice).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></td>
                <td>%<%= order.discountRate %></td>
                <td><%= parseFloat(order.taxAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></td>
                <td><strong style="color: var(--rose);"><%= parseFloat(order.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></strong></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div style="display: flex; justify-content: flex-end;">
          <div style="width: 300px; background: var(--bg-elevated); padding: 16px; border-radius: 10px; border: 1px solid var(--border);">
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 6px;"><span>Ara Toplam:</span><span><%= parseFloat(order.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></span></div>
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 6px;"><span>İskonto Tutar:</span><span>- <%= parseFloat(order.discountAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></span></div>
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 6px;"><span>KDV Tutar:</span><span>+ <%= parseFloat(order.taxAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></span></div>
            <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 800; border-top: 1px solid var(--border); padding-top: 8px; color: var(--rose);"><span>Genel Toplam:</span><span><%= parseFloat(order.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></span></div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
