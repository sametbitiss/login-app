<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satın Alma Talepleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link active">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a>
      </div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a>
      </div>
    </header>

    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>📩 Satın Alma Talepleri Kartı (Kritik Stok Uyarısı)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Stok & Depo Modülünde kritik seviyenin altına inen Hammadde ve Ticari Mal ürünleri için gönderilen talepler.</p>
        </div>
      </div>

      <% const stockAlertsCount = requisitions.filter(r => r.sourceModule === 'Stock' && r.status === 'Pending').length; %>
      <% if (stockAlertsCount > 0) { %>
        <div style="background: rgba(244, 63, 94, 0.12); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3); padding: 14px 18px; border-radius: 12px; margin-bottom: 20px; font-size: 0.95rem; display: flex; align-items: center; justify-content: space-between; font-weight: 600;">
          <span>🚨 <strong>Stok & Depo Modülünden UYARI!</strong> Depoda kritik stok seviyesine düşen <%= stockAlertsCount %> malzeme için acil satın alma talebi iletildi! Lütfen bu ürünleri tedarikçilerden acil satın alın.</span>
          <span style="background: #f43f5e; color: #fff; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 800;"><%= stockAlertsCount %> ACİL TALEP</span>
        </div>
      <% } %>

      <div class="kpi-strip">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">📩</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Toplam Satın Alma Talebi</span><span class="kpi-chip-value"><%= requisitions.length %></span></div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--rose">🚨</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Kritik Stok Talepleri</span><span class="kpi-chip-value"><%= requisitions.filter(r => r.sourceModule === 'Stock').length %></span></div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">⚡</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Bekleyen Talepler</span><span class="kpi-chip-value"><%= requisitions.filter(r => r.status === 'Pending').length %></span></div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">📦</div>
          <div class="kpi-chip-data"><span class="kpi-chip-label">Siparişe Dönüştürülen</span><span class="kpi-chip-value"><%= requisitions.filter(r => r.status === 'Ordered').length %></span></div>
        </div>
      </div>

      <!-- Filters -->
      <div class="filter-bar">
        <form method="GET" action="/purchase/requisitions" class="filter-form">
          <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Durumlar</option>
            <option value="Pending" <%= filterStatus === 'Pending' ? 'selected' : '' %>>Beklemede</option>
            <option value="Approved" <%= filterStatus === 'Approved' ? 'selected' : '' %>>Onaylandı</option>
            <option value="Ordered" <%= filterStatus === 'Ordered' ? 'selected' : '' %>>Siparişe Dönüştürüldü</option>
            <option value="Rejected" <%= filterStatus === 'Rejected' ? 'selected' : '' %>>Reddedildi</option>
          </select>
          <select name="sourceModule" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Kaynaklar</option>
            <option value="Stock" <%= filterSourceModule === 'Stock' ? 'selected' : '' %>>Stok Modülü</option>
            <option value="Production" <%= filterSourceModule === 'Production' ? 'selected' : '' %>>Üretim Modülü</option>
            <option value="Manual" <%= filterSourceModule === 'Manual' ? 'selected' : '' %>>Manuel Talep</option>
          </select>
          <button type="submit" class="btn btn-sm">Filtrele</button>
        </form>
      </div>

      <div class="results-info">
        <span>Toplam <strong><%= requisitions.length %></strong> satın alma talebi listeleniyor</span>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Talep No</th>
              <th>Kaynak</th>
              <th>Talep Edilen Malzeme</th>
              <th>Talep Miktarı</th>
              <th>İhtiyaç Tarihi (En Geç)</th>
              <th>Giriş Yapılacak Depo</th>
              <th>Aciliyet</th>
              <th>Talep Eden</th>
              <th>Durum</th>
              <th>Tarih</th>
              <th style="text-align: right;">Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (requisitions.length === 0) { %>
              <tr>
                <td colspan="11" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  <div style="font-size: 2rem; margin-bottom: 8px;">📩</div>
                  Henüz satın alma talebi bulunmamaktadır.
                </td>
              </tr>
            <% } else { %>
              <% requisitions.forEach(req => { %>
                <% 
                  const st = req.stokKarti || req.stockItem;
                  const reqNo = req.talepNo || req.requisitionNo;
                  const srcMod = req.kaynakModul || req.sourceModule;
                  const qty = req.talepEdilenMiktar !== undefined ? req.talepEdilenMiktar : (req.requestedQuantity || 0);
                  const unit = req.birim || req.unit || (st ? st.birim : 'Adet');
                  const urg = req.aciliyet || req.urgency || 'Normal';
                  const notes = req.notlar || req.notes || '';
                  const reqUser = req.talepEdenAdi || req.requesterName || (req.olusturan ? (req.olusturan.ad ? `${req.olusturan.ad} ${req.olusturan.soyad || ''}`.trim() : req.olusturan.kullaniciAdi) : 'Sistem');
                  const status = req.durum || req.status || 'Pending';
                  const isStockAlert = srcMod === 'Stock';
                  
                  // Hedef Depo
                  const rawWh = st && st.depoLokasyonu ? st.depoLokasyonu : '';
                  const whName = rawWh ? rawWh.split('/')[0].trim() : 'Ana Hammadde & Üretim Ambarı';
                  const subLoc = (rawWh && rawWh.includes('/')) ? rawWh.split('/')[1].trim() : null;

                  // İhtiyaç Tarihi parse
                  let reqDateStr = null;
                  const dateMatch = notes.match(/İhtiyaç Tarihi.*?:?\s*([0-9]{4}-[0-9]{2}-[0-9]{2})/i);
                  if (dateMatch) {
                    reqDateStr = dateMatch[1];
                  }
                %>
                <tr style="<%= isStockAlert ? 'background: rgba(244, 63, 94, 0.04);' : '' %>">
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= reqNo %></strong></td>
                  <td>
                    <% if (srcMod === 'Stock') { %>
                      <span class="status-pill status-rejected" style="background: rgba(244, 63, 94, 0.15); color: #f43f5e; border-color: rgba(244, 63, 94, 0.3);">🚨 Stok Uyarısı</span>
                    <% } else if (srcMod === 'Production') { %>
                      <span class="status-pill status-onleave" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border-color: rgba(99, 102, 241, 0.3);">🏭 Üretim (MRP)</span>
                    <% } else { %>
                      <span class="status-pill status-pending">✋ Manuel</span>
                    <% } %>
                  </td>
                  <td>
                    <strong style="color: var(--text-primary); font-size: 0.9rem;"><%= st ? (st.ad || st.name) : '—' %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                      <code><%= st ? (st.stokKodu || st.stockCode) : '' %></code> • <%= st ? (st.kategori || st.category || 'Hammadde') : '' %>
                    </div>
                  </td>
                  <td>
                    <strong style="font-size: 0.95rem; color: #fbbf24; font-family: 'JetBrains Mono', monospace;"><%= qty %> <%= unit %></strong>
                  </td>
                  <td>
                    <% if (reqDateStr) { %>
                      <div style="font-weight: 700; color: #38bdf8; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 4px;">
                        📅 <%= new Date(reqDateStr).toLocaleDateString('tr-TR') %>
                      </div>
                      <div style="font-size: 0.7rem; color: var(--text-muted);">Termin Hedefi</div>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.8rem;">—</span>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-size: 0.82rem; font-weight: 600; color: #cbd5e1; display: inline-flex; align-items: center; gap: 4px;">
                      🏢 <%= whName %>
                    </div>
                    <% if (subLoc) { %>
                      <div style="font-size: 0.7rem; color: var(--text-muted);"><%= subLoc %></div>
                    <% } %>
                  </td>
                  <td>
                    <% if (urg === 'Urgent') { %>
                      <span class="status-pill status-rejected">🚨 Acil</span>
                    <% } else if (urg === 'High') { %>
                      <span class="status-pill status-pending">⚠️ Yüksek</span>
                    <% } else { %>
                      <span class="status-pill status-approved">Normal</span>
                    <% } %>
                  </td>
                  <td style="font-size: 0.82rem; color: var(--text-primary);"><%= reqUser %></td>
                  <td>
                    <% if (status === 'Pending') { %>
                      <span class="status-pill status-pending">● Beklemede</span>
                    <% } else if (status === 'Approved') { %>
                      <span class="status-pill status-approved">● Onaylandı</span>
                    <% } else if (status === 'Ordered') { %>
                      <span class="status-pill status-active">● Siparişe Dönüştürüldü</span>
                    <% } else if (status === 'Rejected') { %>
                      <span class="status-pill status-rejected">● Reddedildi</span>
                    <% } else { %>
                      <span class="status-pill status-pending">● <%= status %></span>
                    <% } %>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(req.createdAt).toLocaleDateString('tr-TR') %></td>
                  <td style="text-align: right;">
                    <% const reqStockId = st ? st.id : (req.stokId || req.stockItemId || 0);
                       const isProductLocked = acceptedStockItemIds && acceptedStockItemIds.includes(parseInt(reqStockId, 10));
                    %>
                    <% if (isProductLocked) { %>
                      <span class="btn btn-sm" style="background: rgba(100, 116, 139, 0.25); color: #64748b; font-weight: 700; border: 1px solid rgba(100, 116, 139, 0.35); cursor: not-allowed; opacity: 0.7; display: inline-flex; align-items: center; gap: 4px;">
                        🔒 Teklif Kabul Edildi
                      </span>
                    <% } else { %>
                      <a href="/purchase/rfq/add?requisitionId=<%= req.id %>&stockItemId=<%= reqStockId %>" class="btn btn-sm" style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; font-weight: 700; border: none; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);">
                        📨 Teklif Ekle
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
