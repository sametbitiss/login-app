<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mal Kabul & Faturalandırma — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    /* Ultra-Premium Glassmorphism Modal System */
    .modal-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(4, 7, 15, 0.85); backdrop-filter: blur(14px) saturate(180%);
      display: flex; align-items: center; justify-content: center;
      z-index: 9999; opacity: 0; pointer-events: none; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-overlay.active { opacity: 1; pointer-events: auto; }
    .modal-card {
      background: linear-gradient(145deg, rgba(15, 23, 42, 0.98), rgba(11, 15, 25, 0.99));
      border: 1px solid rgba(99, 102, 241, 0.28);
      border-radius: 24px; width: 94%; max-width: 860px; max-height: 92vh;
      overflow-y: auto; box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.85), 0 0 40px rgba(99, 102, 241, 0.15);
      padding: 0; transform: scale(0.92) translateY(20px); transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-overlay.active .modal-card { transform: scale(1) translateY(0); }

    .modal-header-hero {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.08));
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 22px 30px; display: flex; justify-content: space-between; align-items: center;
    }
    .modal-hero-title { font-size: 1.35rem; font-weight: 900; color: #ffffff; display: flex; align-items: center; gap: 12px; letter-spacing: -0.3px; }
    .modal-hero-badge { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; font-size: 0.75rem; font-weight: 700; padding: 4px 12px; border-radius: 20px; }

    .modal-body-content { padding: 26px 30px; }

    .modal-section-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 16px; padding: 18px 20px; margin-bottom: 18px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .modal-section-card:hover { border-color: rgba(99, 102, 241, 0.35); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2); }
    .modal-section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .modal-section-title { font-size: 0.85rem; font-weight: 800; color: #818cf8; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 8px; }

    .glass-input-label { font-size: 0.775rem; font-weight: 700; color: #94a3b8; margin-bottom: 6px; display: block; }
    .glass-input {
      width: 100%; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px; color: #ffffff; padding: 10px 14px; font-size: 0.875rem;
      transition: all 0.2s ease; outline: none; box-sizing: border-box;
    }
    .glass-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2); background: rgba(15, 23, 42, 0.9); }

    .items-table-header { display: grid; grid-template-columns: 2.2fr 1fr 1.2fr 1.2fr; padding: 8px 14px; font-size: 0.725rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .invoice-item-row {
      display: grid; grid-template-columns: 2.2fr 1fr 1.2fr 1.2fr; gap: 10px;
      font-size: 0.85rem; padding: 10px 14px; background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 10px; margin-bottom: 6px;
      align-items: center; transition: background 0.2s ease;
    }
    .invoice-item-row:hover { background: rgba(255, 255, 255, 0.05); }

    .summary-gradient-card {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(99, 102, 241, 0.08));
      border: 1px solid rgba(16, 185, 129, 0.35); border-radius: 16px; padding: 20px;
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;
    }
    .summary-total-price { font-size: 1.5rem; font-weight: 900; color: #10b981; font-family: 'JetBrains Mono', monospace; text-shadow: 0 0 16px rgba(16, 185, 129, 0.35); }

    .btn-create-invoice {
      background: linear-gradient(135deg, #10b981, #059669); color: #ffffff;
      font-weight: 800; padding: 12px 26px; border-radius: 12px; border: none;
      font-size: 0.925rem; cursor: pointer; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
      transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-create-invoice:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5); }

    .modal-close-btn { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: #fff; width: 36px; height: 36px; border-radius: 50%; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease; }
    .modal-close-btn:hover { background: rgba(244,63,94,0.3); border-color: #f43f5e; color: #fff; }
    .photo-preview-box { background: #000; border-radius: 16px; overflow: hidden; display: flex; justify-content: center; align-items: center; max-height: 60vh; border: 1px solid rgba(255,255,255,0.1); }
    .photo-preview-box img { max-width: 100%; max-height: 55vh; object-fit: contain; }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link active">🚛 Mal Kabul & Faturalar</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link">⚡ Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link">📩 Talepler</a><a href="/purchase/rfq" class="msn-link">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link">📦 Siparişler</a><a href="/purchase/goods-receipt" class="msn-link active">🚛 Mal Kabul & Faturalar</a>
        <a href="/purchase/suppliers" class="msn-link">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>İrsaliye, Mal Kabul ve Fatura Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Depo kabulü yapılan siparişler, yüklenen irsaliyeler ve tamamlanan siparişlerin alış faturalandırma takibi.</p>
        </div>
        <a href="/stock/goods-receipt" class="btn btn-indigo-gradient">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Depo Mal Kabul Girişi Yap
        </a>
      </div>

      <% if (success === 'invoice_created') { %>
        <div style="background: rgba(16,185,129,0.15); color: #10b981; border: 1px solid rgba(16,185,129,0.3); padding: 14px 20px; border-radius: 12px; margin-bottom: 20px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
          <span>✅</span> Satın alma alış faturası başarıyla oluşturuldu ve ilgili sipariş için kaydedildi!
        </div>
      <% } %>

      <% if (error) { %>
        <div style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3); padding: 14px 20px; border-radius: 12px; margin-bottom: 20px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= error %>
        </div>
      <% } %>

      <div class="kpi-strip">
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--indigo">🚛</div><div class="kpi-chip-data"><span class="kpi-chip-label">Toplam Mal Kabul Fişi</span><span class="kpi-chip-value"><%= grnStats.totalReceipts %></span></div></div>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--amber">🔍</div><div class="kpi-chip-data"><span class="kpi-chip-label">Kalite Kontrol Bekleyen</span><span class="kpi-chip-value"><%= grnStats.pendingInspection %></span></div></div>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--rose">🧾</div><div class="kpi-chip-data"><span class="kpi-chip-label">Fatura Bekleyen Siparişler</span><span class="kpi-chip-value"><%= awaitingOrders.filter(o => !o.hasInvoice).length %></span></div></div>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--emerald">✅</div><div class="kpi-chip-data"><span class="kpi-chip-label">Kesilen Alış Faturası</span><span class="kpi-chip-value"><%= awaitingOrders.filter(o => o.hasInvoice).length %></span></div></div>
      </div>

      <!-- SECTION 1: FATURALANDIRILMAYI BEKLEYENLER (TESLİM ALINAN SİPARİŞLER) -->
      <div class="table-wrapper" style="margin-bottom: 2.5rem;">
        <div style="padding: 1.25rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h3 style="color: var(--indigo); font-size: 1.1rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
              <span>🧾</span> Faturalandırılmayı Bekleyenler (Teslim Alınan Siparişler)
            </h3>
            <p style="color: var(--text-secondary); font-size: 0.825rem; margin-top: 2px;">Fiziksel teslimatı %100 tamamlanan (durumu "Teslim Alındı" olan) siparişler burada listelenir. Her sipariş için sadece bir fatura kesilebilir.</p>
          </div>
          <span class="status-pill status-active">Toplam <%= awaitingOrders.length %> Sipariş</span>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Sipariş No</th>
              <th>Tedarikçi Unvanı</th>
              <th>Sipariş Tarihi</th>
              <th>Malzeme Kalemleri</th>
              <th>Genel Toplam (₺)</th>
              <th>Fatura Durumu</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (awaitingOrders.length === 0) { %>
              <tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2.5rem;"><div style="font-size: 2rem; margin-bottom: 8px;">📦</div>Henüz faturalandırılmayı bekleyen tamamlanmış sipariş bulunmamaktadır.<br><span style="font-size: 0.8rem;">Stok modülünde siparişlerin mal kabulü tamamlandıkça buraya düşecektir.</span></td></tr>
            <% } else { %>
              <% awaitingOrders.forEach(o => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= o.orderNo %></strong></td>
                  <td><strong><%= o.supplierName %></strong></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(o.orderDate).toLocaleDateString('tr-TR') %></td>
                  <td style="font-size: 0.825rem;">
                    <% if (o.items && o.items.length > 0) { %>
                      <%= o.items.map(it => it.productName || it.stockCode).join(', ') %>
                    <% } else { %>
                      <%= o.stockItem ? o.stockItem.name : '—' %>
                    <% } %>
                  </td>
                  <td><strong style="color: var(--emerald); font-family: 'JetBrains Mono', monospace;"><%= parseFloat(o.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= o.currency %></strong></td>
                  <td>
                    <% if (o.hasInvoice) { %>
                      <span class="status-pill status-active">✅ Fatura Kesildi (<%= o.existingInvoice ? o.existingInvoice.invoiceNo : '' %>)</span>
                    <% } else { %>
                      <span class="status-pill status-pending">⏳ Fatura Bekliyor</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (!o.hasInvoice) { %>
                      <button type="button" onclick='openInvoiceModal(<%- JSON.stringify(o) %>)' class="btn btn-sm btn-success" style="font-weight: 700;">🧾 Fatura Kes</button>
                    <% } else { %>
                      <button type="button" disabled class="btn btn-sm btn-secondary" style="opacity: 0.55; cursor: not-allowed; margin-right: 4px;">🔒 Fatura Kesildi</button>
                      <a href="/purchase/invoices/<%= o.existingInvoice.id %>/detail" class="btn btn-sm btn-secondary" style="background: rgba(99,102,241,0.2); color: #818cf8; border: 1px solid rgba(99,102,241,0.3);">🔍 Fatura Görüntüle</a>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- SECTION 2: GERÇEKLEŞTİRİLEN MAL KABUL VE İRSALİYE KAYITLARI (GRN) -->
      <div class="table-wrapper">
        <div style="padding: 1.25rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h3 style="color: var(--indigo); font-size: 1.1rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
              <span>🚛</span> Mal Kabul ve İrsaliye Kayıtları Detayı
            </h3>
            <p style="color: var(--text-secondary); font-size: 0.825rem; margin-top: 2px;">Depoda yapılan mal kabul fişleri, irsaliye numaraları ve irsaliye fotoğrafları.</p>
          </div>
          <div class="filter-input-wrap" style="width: 250px;">
            <input type="text" id="grnTableSearch" onkeyup="filterGrnTable()" placeholder="Tabloda ara..." class="filter-input" style="padding: 6px 12px; font-size: 0.8rem;">
          </div>
        </div>
        <table class="data-table" id="grnTable">
          <thead>
            <tr>
              <th>GRN Fiş No</th>
              <th>İrsaliye No & Tarih</th>
              <th>İrsaliye Fotoğrafı</th>
              <th>İlgili Sipariş No</th>
              <th>Tedarikçi Firma</th>
              <th>Kabul Edilen Miktar</th>
              <th>Depo Konumu</th>
              <th>Kabul Tarihi</th>
            </tr>
          </thead>
          <tbody>
            <% if (receipts.length === 0) { %>
              <tr><td colspan="8" style="text-align: center; padding: 3rem; color: var(--text-muted);"><div style="font-size: 2rem; margin-bottom: 8px;">🚛</div>Henüz kayıtlı mal kabul işlemi bulunmamaktadır.<br><a href="/stock/goods-receipt" style="color: var(--indigo); font-weight: 600;">Depo modülünden ilk mal kabulü yapın →</a></td></tr>
            <% } else { %>
              <% receipts.forEach(grn => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= grn.grnNo %></strong></td>
                  <td>
                    <div style="font-weight: 600;"><%= grn.deliveryNoteNo || '—' %></div>
                    <% if (grn.deliveryNoteDate) { %><div style="font-size: 0.75rem; color: var(--text-muted);"><%= grn.deliveryNoteDate %></div><% } %>
                  </td>
                  <td>
                    <% if (grn.deliveryNotePhoto) { %>
                      <button type="button" onclick="viewPhotoModal('<%= grn.grnNo %>', '<%= grn.deliveryNoteNo || "" %>', '<%= grn.deliveryNotePhoto %>')" class="btn btn-sm btn-secondary" style="background: rgba(16,185,129,0.15); color: #10b981; border: 1px solid rgba(16,185,129,0.3); font-weight: 600;">
                        🖼️ İrsaliye Fotoğrafı
                      </button>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.8rem;">— Fotoğraf Yok</span>
                    <% } %>
                  </td>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= grn.purchaseOrder ? grn.purchaseOrder.orderNo : '—' %></strong></td>
                  <td><%= grn.purchaseOrder ? grn.purchaseOrder.supplierName : (grn.supplier ? grn.supplier.companyName : '—') %></td>
                  <td><strong style="color: var(--emerald);"><%= parseFloat(grn.acceptedQuantity || grn.receivedQuantity).toLocaleString('tr-TR') %> <%= grn.stockItem ? grn.stockItem.unit : '' %></strong></td>
                  <td><span class="status-pill status-approved"><%= grn.warehouseLocation || 'Ana Depo' %></span></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(grn.receiptDate).toLocaleDateString('tr-TR') %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- MODAL 1: İRSALİYE FOTOĞRAFI GÖRÜNTÜLEME MODALI -->
  <div id="photoModal" class="modal-overlay">
    <div class="modal-card" style="max-width: 700px;">
      <div class="modal-header">
        <div class="modal-title">🖼️ İrsaliye Fotoğrafı — <span id="photoGrnTitle"></span></div>
        <button type="button" class="modal-close" onclick="closePhotoModal()">✕</button>
      </div>
      <div style="margin-bottom: 14px; color: var(--text-secondary); font-size: 0.85rem;" id="photoDeliveryNoteInfo"></div>
      <div class="photo-preview-box">
        <img id="photoModalImg" src="" alt="İrsaliye Fotoğrafı">
      </div>
      <div style="margin-top: 20px; display: flex; justify-content: flex-end;">
        <button type="button" onclick="closePhotoModal()" class="btn btn-secondary">Kapat</button>
      </div>
    </div>
  </div>

  <!-- MODAL 2: FATURA KESME MODALI (WORLD-CLASS GLASSMORPHISM DESIGN) -->
  <div id="invoiceModal" class="modal-overlay">
    <div class="modal-card">
      <div class="modal-header-hero">
        <div>
          <div class="modal-hero-title">
            <span>🧾 Satın Alma Alış Faturası Oluştur</span>
            <span class="modal-hero-badge">Resmi e-Fatura Senaryosu</span>
          </div>
          <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 4px;">
            Mal kabulü %100 tamamlanmış sipariş için 3'lü eşleştirmeli resmi alış faturası düzenleme paneli.
          </div>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeInvoiceModal()">✕</button>
      </div>

      <form id="modalInvoiceForm" action="" method="POST" class="modal-body-content">
        
        <!-- SECTION 1: FATURA VE SIPARIS KİMLİK KARTI -->
        <div class="modal-section-card">
          <div class="modal-section-header">
            <div class="modal-section-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              1. FATURA KİMLİĞİ VE SİPARİŞ REFERANSI
            </div>
            <span style="font-size: 0.725rem; font-weight: 700; color: #64748b; background: rgba(255,255,255,0.05); padding: 3px 8px; border-radius: 6px;">ADIM 1 / 4</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
            <div>
              <label class="glass-input-label">Fatura Numarası (Sistem Otomatik)</label>
              <input type="text" name="invoiceNo" id="invNoInput" value="<%= nextInvoiceNo %>" class="glass-input" readonly style="font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #818cf8;">
            </div>
            <div>
              <label class="glass-input-label">Fatura Düzenleme Tarihi *</label>
              <input type="date" name="invoiceDate" id="invDateInput" class="glass-input" required>
            </div>
          </div>

          <div style="background: rgba(99, 102, 241, 0.06); border: 1px dashed rgba(99, 102, 241, 0.25); border-radius: 12px; padding: 12px 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 0.825rem;">
            <div><span style="color: #94a3b8;">Tedarikçi Firma:</span> <strong id="invSupplierName" style="color: #ffffff; margin-left: 6px;"></strong></div>
            <div><span style="color: #94a3b8;">Sipariş Referans No:</span> <strong id="invOrderNo" style="color: #818cf8; font-family: 'JetBrains Mono', monospace; margin-left: 6px;"></strong></div>
            <div><span style="color: #94a3b8;">Vergi Dairesi & VKN:</span> <span id="invTaxInfo" style="color: #cbd5e1; margin-left: 6px; font-family: 'JetBrains Mono', monospace;"></span></div>
            <div><span style="color: #94a3b8;">Anlaşmalı Vade:</span> <span id="invPaymentTerm" style="color: #34d399; font-weight: 700; margin-left: 6px;"></span></div>
          </div>
        </div>

        <!-- SECTION 2: 3'LÜ EŞLEŞTİRME VE İRSALİYE BAĞLANTISI -->
        <div class="modal-section-card">
          <div class="modal-section-header">
            <div class="modal-section-title" style="color: #34d399;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              2. 3'LÜ EŞLEŞTİRME & İRSALİYE BAĞLANTISI (GRN MATCH)
            </div>
            <span style="font-size: 0.725rem; font-weight: 700; color: #34d399; background: rgba(16, 185, 129, 0.1); padding: 3px 8px; border-radius: 6px;">ADIM 2 / 4</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div>
              <label class="glass-input-label">Eşleşen Mal Kabul İrsaliye Numarası *</label>
              <input type="text" name="dispatchNo" id="invDispatchNoInput" class="glass-input" placeholder="Örn: IRS-2026-0001" required style="font-family: 'JetBrains Mono', monospace;">
            </div>
            <div>
              <label class="glass-input-label">İrsaliye Teslimat Tarihi *</label>
              <input type="date" name="dispatchDate" id="invDispatchDateInput" class="glass-input" required>
            </div>
          </div>
        </div>

        <!-- SECTION 3: BANKA VE IBAN BİLGİLERİ -->
        <div class="modal-section-card">
          <div class="modal-section-header">
            <div class="modal-section-title" style="color: #f59e0b;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              3. TEDARİKÇİ ÖDEME VE BANKA IBAN BİLGİLERİ
            </div>
            <span style="font-size: 0.725rem; font-weight: 700; color: #f59e0b; background: rgba(245, 158, 11, 0.1); padding: 3px 8px; border-radius: 6px;">ADIM 3 / 4</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 14px;">
            <div>
              <label class="glass-input-label">Tedarikçi Banka Adı & Şube</label>
              <input type="text" name="bankName" id="invBankNameInput" value="T.C. Ziraat Bankası A.Ş. - Maslak Kurumsal Şubesi" class="glass-input">
            </div>
            <div>
              <label class="glass-input-label">Tedarikçi IBAN Numarası</label>
              <input type="text" name="ibanNo" id="invIbanInput" value="TR62 0001 0000 0000 0000 1234 56" class="glass-input" style="font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fbbf24;">
            </div>
          </div>
        </div>

        <!-- SECTION 4: FATURA KALEMLERİ -->
        <div class="modal-section-card">
          <div class="modal-section-header">
            <div class="modal-section-title" style="color: #e0e7ff;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              4. FATURA FATURALANDIRILAN KALEMLER
            </div>
          </div>
          <div class="items-table-header">
            <div>Ürün / Malzeme Kodu & Adı</div>
            <div style="text-align: right;">Miktar / Birim</div>
            <div style="text-align: right;">Birim Fiyat (KDV Hariç)</div>
            <div style="text-align: right;">Satır Tutarı</div>
          </div>
          <div id="invItemsContainer" style="margin-top: 8px;"></div>
        </div>

        <!-- GLOWING SUMMARY CARD -->
        <div class="summary-gradient-card">
          <div>
            <div style="font-size: 0.775rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px;">MAL / HİZMET KDV HESAPLAMA DAĞILIMI</div>
            <div style="font-size: 0.9rem; color: #ffffff; margin-top: 4px;">
              Net Matrah: <strong id="invSubtotal" style="color: #818cf8; margin-right: 12px;">0.00 TL</strong>
              KDV (%20): <strong id="invTaxAmount" style="color: #f43f5e;">0.00 TL</strong>
            </div>
          </div>
          <div style="text-align: right;">
            <div style="font-size: 0.75rem; font-weight: 800; color: #34d399; text-transform: uppercase; letter-spacing: 0.5px;">FATURA GENEL TOPLAMI (ÖDENECEK)</div>
            <div id="invGrandTotal" class="summary-total-price">0.00 TL</div>
          </div>
        </div>

        <!-- NOTES -->
        <div style="margin-bottom: 24px;">
          <label class="glass-input-label">Fatura Açıklaması / Resmi Notlar</label>
          <textarea name="notes" id="invNotesInput" class="glass-input" rows="2" placeholder="Resmi fatura özel açıklamaları..."></textarea>
        </div>

        <!-- ACTIONS -->
        <div style="display: flex; gap: 14px; justify-content: flex-end; align-items: center;">
          <button type="button" onclick="closeInvoiceModal()" class="btn btn-secondary" style="padding: 12px 22px; border-radius: 12px;">İptal</button>
          <button type="submit" class="btn-create-invoice">
            <span>🧾 Faturayı Kaydet ve Resmi Olarak Kes</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    function viewPhotoModal(grnNo, noteNo, photoBase64) {
      document.getElementById('photoGrnTitle').textContent = grnNo;
      document.getElementById('photoDeliveryNoteInfo').textContent = noteNo ? ('İrsaliye Numarası: ' + noteNo) : 'İrsaliye Numarası Belirtilmemiş';
      document.getElementById('photoModalImg').src = photoBase64;
      document.getElementById('photoModal').classList.add('active');
    }

    function closePhotoModal() {
      document.getElementById('photoModal').classList.remove('active');
    }

    function openInvoiceModal(order) {
      const form = document.getElementById('modalInvoiceForm');
      if (form) form.action = '/purchase/invoices/create-from-order/' + order.id;

      const dateEl = document.getElementById('invDateInput');
      if (dateEl) dateEl.value = new Date().toISOString().split('T')[0];

      const dispNoEl = document.getElementById('invDispatchNoInput');
      if (dispNoEl) dispNoEl.value = 'IRS-' + order.orderNo;

      const dispDateEl = document.getElementById('invDispatchDateInput');
      if (dispDateEl) dispDateEl.value = new Date().toISOString().split('T')[0];

      const supNameEl = document.getElementById('invSupplierName');
      if (supNameEl) supNameEl.textContent = order.supplierName || 'Tedarikçi';

      const orderNoEl = document.getElementById('invOrderNo');
      if (orderNoEl) orderNoEl.textContent = order.orderNo;

      const taxInfoEl = document.getElementById('invTaxInfo');
      if (taxInfoEl) taxInfoEl.textContent = (order.supplierTaxNo ? ('VN: ' + order.supplierTaxNo) : 'Tanımsız');

      const payTermEl = document.getElementById('invPaymentTerm');
      if (payTermEl) payTermEl.textContent = order.paymentTerm === 'Pesin' ? 'Peşin' : 'Vadeli (30 Gün)';

      const notesEl = document.getElementById('invNotesInput');
      if (notesEl) notesEl.value = `[Satın Alma Siparişi No: ${order.orderNo}] Mal kabulü tamamlanan sipariş için kesilen alış faturasıdır.`;

      const totalAmount = parseFloat(order.totalAmount) || 0;
      const subtotal = parseFloat(order.subtotal) || (totalAmount / 1.2);
      const taxAmount = parseFloat(order.taxAmount) || (totalAmount - subtotal);

      const subEl = document.getElementById('invSubtotal');
      if (subEl) subEl.textContent = subtotal.toLocaleString('tr-TR', {minimumFractionDigits: 2}) + ' ' + (order.currency || 'TRY');

      const taxEl = document.getElementById('invTaxAmount');
      if (taxEl) taxEl.textContent = taxAmount.toLocaleString('tr-TR', {minimumFractionDigits: 2}) + ' ' + (order.currency || 'TRY');

      const grandEl = document.getElementById('invGrandTotal');
      if (grandEl) grandEl.textContent = totalAmount.toLocaleString('tr-TR', {minimumFractionDigits: 2}) + ' ' + (order.currency || 'TRY');

      const itemsContainer = document.getElementById('invItemsContainer');
      if (itemsContainer) {
        itemsContainer.innerHTML = '';

        const items = order.items && order.items.length > 0 ? order.items : [{
          productName: order.stockItem ? order.stockItem.name : 'Malzeme Kalemi',
          stockCode: order.stockItem ? order.stockItem.stockCode : 'STK-001',
          quantity: order.quantity || 1,
          unit: order.stockItem ? order.stockItem.unit : 'Adet',
          unitPrice: order.unitPrice || 0
        }];

        items.forEach(it => {
          const row = document.createElement('div');
          row.className = 'invoice-item-row';
          const q = parseFloat(it.quantity) || 1;
          const p = parseFloat(it.unitPrice) || 0;
          const tot = q * p;
          row.innerHTML = `
            <div><strong>${it.productName || it.stockCode}</strong> <span style="color: var(--text-muted); font-size: 0.75rem;">(${it.stockCode || 'STK'})</span></div>
            <div style="text-align: right;">${q.toLocaleString('tr-TR')} ${it.unit || 'Adet'}</div>
            <div style="text-align: right;">${p.toLocaleString('tr-TR', {minimumFractionDigits: 2})} ${order.currency || 'TRY'}</div>
            <div style="text-align: right; font-weight: 700; color: var(--emerald);">${tot.toLocaleString('tr-TR', {minimumFractionDigits: 2})} ${order.currency || 'TRY'}</div>
          `;
          itemsContainer.appendChild(row);
        });
      }

      const modalEl = document.getElementById('invoiceModal');
      if (modalEl) modalEl.classList.add('active');
    }

    function closeInvoiceModal() {
      document.getElementById('invoiceModal').classList.remove('active');
    }

    function filterGrnTable() {
      const input = document.getElementById('grnTableSearch');
      const filter = input.value.toUpperCase();
      const table = document.getElementById('grnTable');
      const tr = table.getElementsByTagName('tr');

      for (let i = 1; i < tr.length; i++) {
        let txtValue = tr[i].textContent || tr[i].innerText;
        if (txtValue.toUpperCase().indexOf(filter) > -1) {
          tr[i].style.display = '';
        } else {
          tr[i].style.display = 'none';
        }
      }
    }
  </script>
</body>
</html>
