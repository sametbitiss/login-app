<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yönetsel Onay Paneli — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link active">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link active">⚡ Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link">📩 Talepler</a><a href="/purchase/rfq" class="msn-link">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link">📦 Siparişler</a><a href="/purchase/goods-receipt" class="msn-link">🚛 Mal Kabul</a>
        <a href="/purchase/suppliers" class="msn-link">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Yönetsel Onay Paneli</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Bütçe limitini aşan veya özel onay gerektiren satın alma siparişleri ve talepleri.</p>
        </div>
      </div>

      <!-- Pending Orders Table -->
      <div class="table-wrapper" style="margin-bottom: 2rem;">
        <h3 style="color: var(--indigo); font-size: 1.05rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); font-weight: 700;">
          📦 Bütçe Limitini Aşan Bekleyen Satın Alma Siparişleri (<%= pendingOrders.length %>)
        </h3>
        <table class="data-table">
          <thead>
            <tr>
              <th>Sipariş No</th>
              <th>Tedarikçi</th>
              <th>Malzeme</th>
              <th>Miktar</th>
              <th>Genel Toplam</th>
              <th>Ödeme Vadesi</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (pendingOrders.length === 0) { %>
              <tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">Onay bekleyen satın alma siparişi bulunmamaktadır.</td></tr>
            <% } else { %>
              <% pendingOrders.forEach(o => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= o.orderNo %></strong></td>
                  <td><%= o.supplierName %></td>
                  <td><%= o.stockItem ? o.stockItem.name : '—' %></td>
                  <td><%= o.quantity %> <%= o.stockItem ? o.stockItem.unit : '' %></td>
                  <td><strong style="color: var(--rose);"><%= parseFloat(o.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= o.currency %></strong></td>
                  <td><%= o.paymentTerm %></td>
                  <td>
                    <form action="/purchase/approvals/order/<%= o.id %>/action" method="POST" style="display: inline;">
                      <input type="hidden" name="action" value="approve">
                      <button type="submit" class="btn btn-sm btn-success">⚡ Onayla</button>
                    </form>
                    <form action="/purchase/approvals/order/<%= o.id %>/action" method="POST" style="display: inline; margin-left: 4px;">
                      <input type="hidden" name="action" value="reject">
                      <button type="submit" class="btn btn-sm" style="background: var(--rose);">❌ Reddet</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Pending Requisitions Table -->
      <div class="table-wrapper">
        <h3 style="color: var(--indigo); font-size: 1.05rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); font-weight: 700;">
          📩 Onay Bekleyen Satın Alma Talepleri (<%= pendingRequisitions.length %>)
        </h3>
        <table class="data-table">
          <thead>
            <tr>
              <th>Talep No</th>
              <th>Kaynak Modül</th>
              <th>Malzeme</th>
              <th>Miktar</th>
              <th>Talep Eden</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (pendingRequisitions.length === 0) { %>
              <tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">Onay bekleyen malzeme talebi bulunmamaktadır.</td></tr>
            <% } else { %>
              <% pendingRequisitions.forEach(r => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= r.requisitionNo %></strong></td>
                  <td><span class="status-pill status-approved"><%= r.sourceModule %></span></td>
                  <td><%= r.stockItem ? r.stockItem.name : '—' %></td>
                  <td><%= r.requestedQuantity %> <%= r.unit || 'Adet' %></td>
                  <td><%= r.requesterName || '—' %></td>
                  <td>
                    <form action="/purchase/approvals/requisition/<%= r.id %>/action" method="POST" style="display: inline;">
                      <input type="hidden" name="action" value="approve">
                      <button type="submit" class="btn btn-sm btn-success">⚡ Onayla</button>
                    </form>
                    <form action="/purchase/approvals/requisition/<%= r.id %>/action" method="POST" style="display: inline; margin-left: 4px;">
                      <input type="hidden" name="action" value="reject">
                      <button type="submit" class="btn btn-sm" style="background: var(--rose);">❌ Reddet</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
