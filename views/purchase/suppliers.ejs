<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tedarikçi Kartları — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link active">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link">⚡ Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link">📩 Talepler</a><a href="/purchase/rfq" class="msn-link">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link">📦 Siparişler</a><a href="/purchase/goods-receipt" class="msn-link">🚛 Mal Kabul</a>
        <a href="/purchase/suppliers" class="msn-link active">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Tedarikçi (Vendor) Kartları</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tedarikçi iletişim, ödeme şartları, performans puanı ve cari bakiye yönetimi.</p>
        </div>
        <a href="/purchase/suppliers/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Tedarikçi Ekle
        </a>
      </div>

      <div class="kpi-strip">
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--indigo">🏢</div><div class="kpi-chip-data"><span class="kpi-chip-label">Toplam Tedarikçi</span><span class="kpi-chip-value"><%= supplierStats.totalSuppliers %></span></div></div>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--emerald">✅</div><div class="kpi-chip-data"><span class="kpi-chip-label">Aktif Tedarikçiler</span><span class="kpi-chip-value"><%= supplierStats.activeSuppliers %></span></div></div>
        <% 
          let avgScore = parseFloat(supplierStats.avgPerformance || 85); 
          if (avgScore <= 5) avgScore = avgScore * 20; 
          avgScore = Math.min(100, Math.round(avgScore)); 
        %>
        <div class="kpi-chip"><div class="kpi-chip-icon kpi-chip--amber">⭐</div><div class="kpi-chip-data"><span class="kpi-chip-label">Ort. Performans Puanı</span><span class="kpi-chip-value"><%= avgScore %> / 100</span></div></div>
      </div>

      <div class="filter-bar">
        <form method="GET" action="/purchase/suppliers" class="filter-form">
          <div class="filter-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" placeholder="Tedarikçi kodu, firma unvanı veya vergi no..." value="<%= filterSearch %>" class="filter-input">
          </div>
          <button type="submit" class="btn btn-sm">Filtrele</button>
        </form>
      </div>

      <div class="results-info"><span>Toplam <strong><%= suppliers.length %></strong> tedarikçi kartı listeleniyor</span></div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Tedarikçi Kodu</th>
              <th>Firma Unvanı</th>
              <th>İletişim Kişisi</th>
              <th>Ödeme Vadesi</th>
              <th>Performans</th>
              <th>Durum</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (suppliers.length === 0) { %>
              <tr><td colspan="7" style="text-align: center; padding: 3rem; color: var(--text-muted);"><div style="font-size: 2rem; margin-bottom: 8px;">🏢</div>Henüz kayıtlı tedarikçi kartı bulunmamaktadır.<br><a href="/purchase/suppliers/add" style="color: var(--indigo); font-weight: 600;">İlk tedarikçi kartını oluşturun →</a></td></tr>
            <% } else { %>
              <% suppliers.forEach(sup => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= sup.supplierCode %></strong></td>
                  <td>
                    <div style="font-weight: 600;"><%= sup.companyName %></div>
                    <% if (sup.taxNo) { %><div style="font-size: 0.75rem; color: var(--text-muted);">VN: <%= sup.taxNo %></div><% } %>
                  </td>
                  <td>
                    <div><%= sup.contactPerson || '—' %></div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);"><%= sup.phone || '' %></div>
                  </td>
                  <td>
                    <%
                      let score = parseFloat(sup.performanceScore || 85);
                      if (score <= 5) score = score * 20;
                      score = Math.min(100, Math.round(score));
                    %>
                    <strong style="color: var(--amber); font-family: 'JetBrains Mono', monospace;">⭐ <%= score %> / 100 Puan</strong>
                  </td>
                  <td>
                    <% if (sup.status === 'Active') { %>
                      <span class="status-pill status-active">● Aktif</span>
                    <% } else { %>
                      <span class="status-pill status-rejected">● <%= sup.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/purchase/suppliers/<%= sup.id %>/detail" class="btn btn-sm btn-secondary">🔍 Cari Detay</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
