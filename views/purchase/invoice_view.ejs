<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satın Alma Alış Faturası (<%= invoice ? invoice.invoiceNo : '' %>) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    @media print {
      body { background: #ffffff !important; color: #000000 !important; margin: 0 !important; padding: 0 !important; }
      .module-sidebar, .module-topbar, .module-subnav, .no-print { display: none !important; }
      .module-main { margin-left: 0 !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
      .paper-a4 { border: none !important; box-shadow: none !important; width: 100% !important; max-width: 100% !important; padding: 0 !important; margin: 0 !important; background: #ffffff !important; color: #000000 !important; }
    }
    
    body { background: #090d16; color: #000000; font-family: 'Inter', sans-serif; margin: 0; padding: 0; }
    .paper-a4 { 
      background: #ffffff; color: #000000; border: 2px solid #1e293b; 
      border-radius: 8px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); 
      width: 210mm; min-height: 280mm; margin: 20px auto 40px auto; box-sizing: border-box; position: relative;
    }
    .inv-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #1e293b; padding-bottom: 16px; margin-bottom: 20px; }
    .inv-title { font-size: 1.6rem; font-weight: 900; text-transform: uppercase; color: #0f172a; margin: 0; }
    .inv-sub { font-size: 0.85rem; font-weight: 700; color: #64748b; margin-top: 4px; }
    .inv-meta { text-align: right; }
    .inv-no { font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; font-weight: 800; color: #4338ca; }
    .inv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; font-size: 0.875rem; }
    .inv-box { background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 14px 18px; }
    .inv-box-title { font-weight: 800; font-size: 0.8rem; text-transform: uppercase; color: #475569; margin-bottom: 8px; border-bottom: 1px dashed #cbd5e1; padding-bottom: 4px; }
    .inv-table { width: 100%; border-collapse: collapse; margin-bottom: 24px; font-size: 0.85rem; }
    .inv-table th { background: #1e293b; color: #ffffff; text-align: left; padding: 10px 12px; font-weight: 700; }
    .inv-table td { border-bottom: 1px solid #e2e8f0; padding: 10px 12px; color: #1e293b; }
    .inv-totals { width: 300px; margin-left: auto; font-size: 0.9rem; }
    .inv-total-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #e2e8f0; }
    .inv-total-grand { font-weight: 900; font-size: 1.15rem; color: #0f172a; border-bottom: 2px solid #0f172a; border-top: 2px solid #0f172a; padding: 10px 0; margin-top: 6px; }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar no-print">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/goods-receipt" class="mss-sub-link active">🚛 Mal Kabul & Faturalar</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar no-print">
      <div class="mt-left"><a href="/purchase/goods-receipt" class="mt-link">← Mal Kabul & Fatura Listesine Dön</a></div>
      <div class="mt-right">
        <button onclick="window.print()" class="btn btn-sm btn-primary" style="background: #4338ca; border: none; font-weight: 700; padding: 8px 16px;">🖨️ Faturayı Yazdır / PDF İndir</button>
      </div>
    </header>

    <main class="module-content" style="padding: 1rem 0;">
      <div class="paper-a4">
        <div class="inv-header">
          <div>
            <h1 class="inv-title">SATIN ALMA ALIŞ FATURASI</h1>
            <div class="inv-sub">RESMİ TEDARİKÇİ ALIŞ FATURASI KAYDI</div>
          </div>
          <div class="inv-meta">
            <div class="inv-no"><%= invoice.invoiceNo %></div>
            <div style="font-size: 0.85rem; color: #475569; margin-top: 4px;">Tarih: <%= new Date(invoice.invoiceDate).toLocaleDateString('tr-TR') %></div>
          </div>
        </div>

        <div class="inv-grid">
          <div class="inv-box">
            <div class="inv-box-title">🏢 TEDARİKÇİ BİLGİLERİ</div>
            <div><strong><%= invoice.supplierName %></strong></div>
            <div>Vergi Dairesi / No: <%= invoice.supplierTaxOffice || '—' %> / <%= invoice.supplierTaxNo || '—' %></div>
            <div>Telefon: <%= invoice.supplierPhone || '—' %></div>
            <div>Adres: <%= invoice.billingAddress || '—' %></div>
          </div>
          <div class="inv-box">
            <div class="inv-box-title">📄 SİPARİŞ & FATURA DETAYLARI</div>
            <div>İlgili Sipariş No: <strong><%= invoice.orderNo || '—' %></strong></div>
            <div>Fatura Tipi: Satın Alma Alış Faturası</div>
            <div>Ödeme Vadesi: <%= invoice.paymentTerm === 'Pesin' ? 'Peşin Ödeme' : 'Vadeli (30 Gün)' %></div>
            <div>Durum: <strong style="color: #059669;">✅ Kesildi / İşlendi</strong></div>
          </div>
        </div>

        <table class="inv-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Malzeme / Ürün Açıklaması</th>
              <th style="text-align: right;">Miktar</th>
              <th style="text-align: right;">Birim Fiyat</th>
              <th style="text-align: right;">Toplam Tutar</th>
            </tr>
          </thead>
          <tbody>
            <% if (!items || items.length === 0) { %>
              <tr>
                <td>1</td>
                <td>Satın Alma Malzeme Kalemi</td>
                <td style="text-align: right;">1 Adet</td>
                <td style="text-align: right;"><%= parseFloat(invoice.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
                <td style="text-align: right;"><%= parseFloat(invoice.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
              </tr>
            <% } else { %>
              <% items.forEach((it, idx) => { %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td><strong><%= it.productName || it.stockCode %></strong> <% if (it.stockCode) { %><span style="color: #64748b; font-size: 0.75rem;">(<%= it.stockCode %>)</span><% } %></td>
                  <td style="text-align: right;"><%= parseFloat(it.quantity || 1).toLocaleString('tr-TR') %> <%= it.unit || 'Adet' %></td>
                  <td style="text-align: right;"><%= parseFloat(it.unitPrice || 0).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
                  <td style="text-align: right;"><%= (parseFloat(it.quantity || 1) * parseFloat(it.unitPrice || 0)).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>

        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 20px;">
          <div style="width: 55%; font-size: 0.85rem; color: #475569;">
            <strong>Açıklama & Notlar:</strong>
            <p style="margin-top: 4px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 10px; border-radius: 6px;"><%= invoice.notes || 'Herhangi bir özel not bulunmamaktadır.' %></p>
          </div>
          <div class="inv-totals">
            <div class="inv-total-row"><span>Ara Toplam (Matrah):</span><strong><%= parseFloat(invoice.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></strong></div>
            <div class="inv-total-row"><span>Hesaplanan KDV (%20):</span><strong><%= parseFloat(invoice.taxAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></strong></div>
            <div class="inv-total-row inv-total-grand"><span>GENEL TOPLAM:</span><strong><%= parseFloat(invoice.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></strong></div>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
