<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satın Alma Alış Faturası (<%= invoice ? invoice.invoiceNo : '' %>) — Resmi e-Fatura / e-Arşiv Belgesi</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    @media print {
      body { background: #ffffff !important; color: #000000 !important; margin: 0 !important; padding: 0 !important; }
      .module-sidebar, .module-topbar, .module-subnav, .no-print { display: none !important; }
      .module-main { margin-left: 0 !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
      .paper-a4 { border: none !important; box-shadow: none !important; width: 100% !important; max-width: 100% !important; padding: 0 !important; margin: 0 !important; background: #ffffff !important; color: #000000 !important; }
    }
    
    /* Strict Black & White A4 Official Invoice Canvas */
    body {
      background: #090d16;
      color: #000000;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 0;
    }

    .paper-a4 { 
      background: #ffffff; 
      color: #000000;
      border: 1px solid #000000; 
      border-radius: 0; 
      padding: 35px 40px; 
      box-shadow: 0 10px 30px rgba(0,0,0,0.4); 
      width: 210mm;
      min-height: 297mm;
      margin: 20px auto 40px auto; 
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      box-sizing: border-box;
      position: relative;
    }

    .inv-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #000000;
      padding-bottom: 14px;
      margin-bottom: 14px;
    }

    .inv-company {
      font-size: 1.2rem;
      font-weight: 900;
      line-height: 1.3;
      color: #000000;
    }

    .inv-title-box {
      text-align: right;
    }

    .inv-title-box h2 {
      font-size: 1.5rem;
      font-weight: 900;
      margin: 0;
      color: #000000;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .inv-title-box p {
      margin: 4px 0 0 0;
      font-size: 0.85rem;
      font-weight: 700;
      color: #000000;
    }

    .inv-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 14px;
    }

    .inv-section-box {
      border: 1px solid #000000;
      padding: 10px 14px;
    }

    .inv-section-title {
      font-size: 0.75rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid #000000;
      padding-bottom: 4px;
      margin-bottom: 6px;
      color: #000000;
    }

    .inv-info-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }

    .inv-info-table td {
      padding: 2px 0;
      vertical-align: top;
      color: #000000;
    }

    .inv-info-table td.lbl {
      font-weight: 700;
      width: 42%;
      color: #000000;
    }

    .inv-info-table td.val {
      font-weight: 500;
      color: #000000;
    }

    /* Items Table */
    .inv-items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 14px;
      font-size: 0.8rem;
    }

    .inv-items-table th {
      background: #ffffff;
      color: #000000;
      border: 1px solid #000000;
      padding: 8px 8px;
      font-size: 0.725rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .inv-items-table td {
      border: 1px solid #000000;
      padding: 7px 8px;
      color: #000000;
    }

    .inv-summary-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 16px;
      margin-bottom: 14px;
    }

    .inv-summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }

    .inv-summary-table td {
      padding: 4px 6px;
      border-bottom: 1px solid #cbd5e1;
      color: #000000;
    }

    .inv-summary-table tr.total-row td {
      border-top: 2px solid #000000;
      border-bottom: 2px solid #000000;
      font-weight: 900;
      font-size: 0.95rem;
    }

    .tax-breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.75rem;
    }

    .tax-breakdown-table th, .tax-breakdown-table td {
      border: 1px solid #000000;
      padding: 4px 6px;
      text-align: center;
      color: #000000;
    }

    .inv-signatures {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid #000000;
      font-size: 0.8rem;
      text-align: center;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <aside class="module-sidebar no-print">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/goods-receipt" class="mss-sub-link active">🚛 Mal Kabul & Faturalar</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a>
      </div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar no-print">
      <div class="mt-left">
        <a href="/purchase/goods-receipt" class="mt-link">← Mal Kabul & Fatura Listesine Dön</a>
      </div>
      <div class="mt-right">
        <button onclick="window.print()" class="btn btn-sm" style="background: #ffffff; color: #000000; font-weight: 800; border: 1px solid #000; border-radius: 6px; padding: 8px 18px; cursor: pointer;">🖨️ Faturayı Yazdır / Resmi PDF Al</button>
      </div>
    </header>

    <main class="module-content" style="padding: 1rem 0;">
      <!-- OFFICIAL A4 INVOICE CANVAS -->
      <div class="paper-a4">
        
        <!-- HEADER -->
        <div class="inv-header">
          <div>
            <div class="inv-company"><%= invoice.supplierName %></div>
            <div style="font-size: 0.8rem; margin-top: 4px;">
              <%= invoice.billingAddress || 'Organize Sanayi Bölgesi, No: 45 Kadıköy / İSTANBUL' %><br>
              Tel: <%= invoice.supplierPhone || '+90 (216) 555 0000' %> | E-Posta: <%= invoice.supplierEmail || 'muhasebe@tedarikci.com' %><br>
              <strong>Vergi Dairesi & VKN/TCKN:</strong> <%= invoice.supplierTaxOffice || 'Kadıköy V.D.' %> — <%= invoice.supplierTaxNo || '1234567890' %>
            </div>
          </div>
          <div class="inv-title-box">
            <h2>E-FATURA / SATIN ALMA ALIŞ FATURASI</h2>
            <p>Senaryo: TİCARİ FATURA | Fatura Tipi: SATIN ALMA (ALIŞ)</p>
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; margin-top: 6px; font-weight: 700;">
              No: <%= invoice.invoiceNo %>
            </div>
          </div>
        </div>

        <!-- 3-WAY MATCHING NOTIFICATION BANNER -->
        <div style="border: 1px solid #000000; background: #f8fafc; padding: 6px 12px; margin-bottom: 14px; font-size: 0.75rem; font-weight: 700; display: flex; justify-content: space-between; align-items: center;">
          <span>✅ 3'LÜ EŞLEŞTİRME DOĞRULANDI (SİPARİŞ + MAL KABUL İRSALİYESİ + ALIŞ FATURASI TAM EŞLEŞTİ)</span>
          <span>Sistem VKN Eşleşmesi: DOĞRULANDI</span>
        </div>

        <!-- SECTION 1 & 2: SATICI VE ALICI BİLGİLERİ -->
        <div class="inv-grid-2">
          <!-- 1. SATICI (TEDARİKÇİ) BİLGİLERİ -->
          <div class="inv-section-box">
            <div class="inv-section-title">1. SATICI (TEDARİKÇİ) BİLGİLERİ</div>
            <table class="inv-info-table">
              <tr><td class="lbl">Ticari Unvan:</td><td class="val"><strong><%= invoice.supplierName %></strong></td></tr>
              <tr><td class="lbl">Vergi Dairesi:</td><td class="val"><%= invoice.supplierTaxOffice || 'Kadıköy V.D.' %></td></tr>
              <tr><td class="lbl">VKN / TCKN:</td><td class="val"><strong style="font-family: 'JetBrains Mono', monospace;"><%= invoice.supplierTaxNo || '1234567890' %></strong></td></tr>
              <tr><td class="lbl">Açık Adres:</td><td class="val"><%= invoice.billingAddress || 'Organize Sanayi Bölgesi, Kadıköy / İSTANBUL' %></td></tr>
              <tr><td class="lbl">İletişim:</td><td class="val"><%= invoice.supplierPhone || '—' %> | <%= invoice.supplierEmail || '—' %></td></tr>
            </table>
          </div>

          <!-- 2. ALICI (FİRMA) BİLGİLERİ -->
          <div class="inv-section-box">
            <div class="inv-section-title">2. ALICI (FİRMA) BİLGİLERİ</div>
            <table class="inv-info-table">
              <tr><td class="lbl">Firma Unvanı:</td><td class="val"><strong>ENTERPRISE ERP SANAYİ VE TİCARET A.Ş.</strong></td></tr>
              <tr><td class="lbl">Vergi Dairesi:</td><td class="val">Maslak Vergi Dairesi</td></tr>
              <tr><td class="lbl">Vergi No (VKN):</td><td class="val"><strong style="font-family: 'JetBrains Mono', monospace;">3880491204</strong></td></tr>
              <tr><td class="lbl">Firma Adresi:</td><td class="val">Büyükdere Caddesi No:195 K:8, Maslak / İSTANBUL</td></tr>
              <tr><td class="lbl">Web & Destek:</td><td class="val">www.enterprise-erp.com | destek@enterprise.com</td></tr>
            </table>
          </div>
        </div>

        <!-- SECTION 3: FATURA TEMEL BİLGİLERİ (MALİ & 3'LÜ EŞLEŞTİRME KONTROLÜ) -->
        <div class="inv-section-box" style="margin-bottom: 14px;">
          <div class="inv-section-title">3. FATURA TEMEL BİLGİLERİ & 3'LÜ EŞLEŞTİRME BAĞLANTISI (MALİ BİLGİLER)</div>
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 10px; font-size: 0.8rem;">
            <div>
              <div style="font-weight: 700;">Fatura Numarası:</div>
              <div style="font-family: 'JetBrains Mono', monospace; font-weight: 800;"><%= invoice.invoiceNo %></div>
            </div>
            <div>
              <div style="font-weight: 700;">Fatura Tarihi:</div>
              <div><%= new Date(invoice.invoiceDate).toLocaleDateString('tr-TR') %></div>
            </div>
            <div>
              <div style="font-weight: 700;">Mal Kabul İrsaliye No & Tarihi:</div>
              <div style="font-weight: 800;"><%= invoice.dispatchNo || ('IRS-' + (invoice.orderNo || '001')) %> (<%= invoice.dispatchDate ? new Date(invoice.dispatchDate).toLocaleDateString('tr-TR') : new Date(invoice.invoiceDate).toLocaleDateString('tr-TR') %>)</div>
            </div>
            <div>
              <div style="font-weight: 700;">Sipariş Numarası (PO Ref):</div>
              <div style="font-weight: 800; font-family: 'JetBrains Mono', monospace;"><%= invoice.orderNo || '—' %> (<%= invoice.orderDate ? new Date(invoice.orderDate).toLocaleDateString('tr-TR') : '—' %>)</div>
            </div>
          </div>
        </div>

        <!-- SECTION 4: KALEM / ÜRÜN DETAYLARI -->
        <table class="inv-items-table">
          <thead>
            <tr>
              <th style="width: 30px;">#</th>
              <th>Malzeme / Ürün Adı ve Stok Kodu</th>
              <th style="text-align: right; width: 90px;">Miktar</th>
              <th style="text-align: right; width: 70px;">Birim</th>
              <th style="text-align: right; width: 110px;">Birim Fiyat (KDV Hariç)</th>
              <th style="text-align: right; width: 80px;">İskonto</th>
              <th style="text-align: right; width: 120px;">Satır Net Tutarı</th>
            </tr>
          </thead>
          <tbody>
            <% if (!items || items.length === 0) { %>
              <tr>
                <td>1</td>
                <td>Satın Alma Malzeme Kalemi</td>
                <td style="text-align: right;">1.00</td>
                <td style="text-align: right;">Adet</td>
                <td style="text-align: right;"><%= parseFloat(invoice.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
                <td style="text-align: right;">%0.00</td>
                <td style="text-align: right;"><strong><%= parseFloat(invoice.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></strong></td>
              </tr>
            <% } else { %>
              <% items.forEach((it, idx) => { %>
                <%
                  const q = parseFloat(it.quantity || 1);
                  const p = parseFloat(it.unitPrice || 0);
                  const disc = parseFloat(it.discountRate || 0);
                  const sub = q * p;
                  const discAmt = sub * (disc / 100);
                  const lineNet = sub - discAmt;
                %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td>
                    <strong><%= it.productName || it.stockCode %></strong>
                    <% if (it.stockCode) { %><br><span style="font-size: 0.725rem; font-family: 'JetBrains Mono', monospace;">Stok Kodu: <%= it.stockCode %></span><% } %>
                  </td>
                  <td style="text-align: right; font-weight: 700;"><%= q.toLocaleString('tr-TR') %></td>
                  <td style="text-align: right;"><%= it.unit || 'Adet' %></td>
                  <td style="text-align: right;"><%= p.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
                  <td style="text-align: right;"><%= disc > 0 ? ('%' + disc) : '—' %></td>
                  <td style="text-align: right;"><strong><%= lineNet.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></strong></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>

        <!-- SECTION 5: TOPLAMLAR VE VERGİLER -->
        <div class="inv-summary-grid">
          <div>
            <!-- KDV GRUPLARI DAĞILIMI -->
            <div style="font-weight: 800; font-size: 0.75rem; uppercase; margin-bottom: 4px;">KDV MATRAH DAĞILIM TABLOSU</div>
            <table class="tax-breakdown-table" style="margin-bottom: 12px;">
              <thead>
                <tr>
                  <th>KDV Oranı</th>
                  <th>KDV Matrahı (Net)</th>
                  <th>Hesaplanan KDV Tutarı</th>
                  <th>Toplam</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>%20</strong></td>
                  <td><%= parseFloat(invoice.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
                  <td><%= parseFloat(invoice.taxAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
                  <td><strong><%= parseFloat(invoice.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></strong></td>
                </tr>
              </tbody>
            </table>

            <div style="border: 1px solid #000000; padding: 8px 10px; font-size: 0.8rem; background: #f8fafc;">
              <strong>Yalnız (Yazıyla Fatura Tutarı):</strong><br>
              <span style="font-weight: 800; font-style: italic;"><%= wordsTotal %></span>
            </div>

            <!-- SECTION 6: ÖDEME VE BANKA BİLGİLERİ -->
            <div style="border: 1px solid #000000; padding: 8px 10px; font-size: 0.775rem; margin-top: 10px; background: #ffffff;">
              <div style="font-weight: 900; border-bottom: 1px solid #000; padding-bottom: 2px; margin-bottom: 4px;">6. ÖDEME VE BANKA BİLGİLERİ</div>
              <div><strong>Ödeme Vadesi:</strong> <%= invoice.paymentTerm === 'Pesin' ? 'Peşin Ödeme' : 'Vadeli (30 Gün Vadeli Ödeme)' %></div>
              <div><strong>Tedarikçi Bankası:</strong> <%= invoice.bankName || 'T.C. Ziraat Bankası A.Ş. - Maslak Kurumsal Şubesi' %></div>
              <div><strong>Tedarikçi IBAN No:</strong> <strong style="font-family: 'JetBrains Mono', monospace;"><%= invoice.ibanNo || 'TR62 0001 0000 0000 0000 1234 56' %></strong></div>
            </div>
          </div>

          <div>
            <table class="inv-summary-table">
              <tr>
                <td>Mal / Hizmet Ara Toplamı (Brüt):</td>
                <td style="text-align: right;"><strong><%= parseFloat(invoice.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></strong></td>
              </tr>
              <tr>
                <td>Toplam İskonto Tutarı:</td>
                <td style="text-align: right;"><%= parseFloat(invoice.discountAmount || 0).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
              </tr>
              <tr>
                <td>Net Matrah Tutarı:</td>
                <td style="text-align: right;"><%= parseFloat(invoice.subtotal).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
              </tr>
              <tr>
                <td>Hesaplanan KDV (%20):</td>
                <td style="text-align: right;"><%= parseFloat(invoice.taxAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></td>
              </tr>
              <tr class="total-row">
                <td>GENEL TOPLAM (ÖDENECEK):</td>
                <td style="text-align: right;"><strong><%= parseFloat(invoice.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice.currency %></strong></td>
              </tr>
            </table>

            <div style="font-size: 0.725rem; border: 1px solid #000; padding: 6px; margin-top: 10px; text-align: justify;">
              <strong>Fatura Açıklaması:</strong> <%= invoice.notes || 'Bu belge satın alma ve mal kabul irsaliye kayıtları ile birebir eşleştirilerek ERP sisteminde oluşturulan resmi alış faturası belgesidir.' %>
            </div>
          </div>
        </div>

        <!-- SIGNATURES -->
        <div class="inv-signatures">
          <div>
            <strong>Teslim Eden / Tedarikçi Firma</strong><br>
            (İmza / Kaşe)<br><br>
            .......................................................
          </div>
          <div>
            <strong>Teslim Alan / Enterprise ERP Şirketi</strong><br>
            (Satın Alma & Muhasebe Onayı)<br><br>
            .......................................................
          </div>
        </div>

      </div>
    </main>
  </div>
</body>
</html>
