<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Satın Alma Siparişi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link active">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link">⚡ Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link">📩 Talepler</a><a href="/purchase/rfq" class="msn-link">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link active">📦 Siparişler</a><a href="/purchase/goods-receipt" class="msn-link">🚛 Mal Kabul</a>
        <a href="/purchase/suppliers" class="msn-link">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Yeni Satın Alma Siparişi Oluştur</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Seçilen tedarikçiye verilmek üzere resmi satın alma siparişi hazırlayın.</p>
        </div>
        <a href="/purchase/orders" class="btn btn-secondary">← Sipariş Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div style="background: var(--rose-soft); color: var(--rose); border: 1px solid var(--rose); padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-weight: 600;">⚠️ <%= error %></div>
      <% } %>

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; box-shadow: var(--shadow-md);">
        <form action="/purchase/orders/add" method="POST">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label">Sipariş No</label>
              <input type="text" name="orderNo" value="<%= nextOrderNo %>" class="form-control" readonly>
            </div>
            <div class="form-group">
              <label class="form-label">Tedarikçi Seçin *</label>
              <select name="supplierId" class="form-control" id="supplierSelect" onchange="onSupplierChange(this)" required>
                <option value="">— Tedarikçi Kartı Seçin —</option>
                <% if (suppliers && suppliers.length > 0) { %>
                  <% suppliers.forEach(sup => { %>
                    <option value="<%= sup.id %>" data-name="<%= sup.companyName %>" data-tax="<%= sup.taxNo || '' %>" data-contact="<%= sup.contactPerson || '' %>" data-email="<%= sup.email || '' %>" data-phone="<%= sup.phone || '' %>">
                      <%= sup.supplierCode %> — <%= sup.companyName %>
                    </option>
                  <% }); %>
                <% } %>
              </select>
              <input type="hidden" name="supplierName" id="supplierNameInput">
            </div>
            <div class="form-group">
              <label class="form-label">Tedarikçi Vergi No</label>
              <input type="text" name="supplierTaxNo" id="supplierTaxNoInput" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Tedarikçi İletişim Kişisi</label>
              <input type="text" name="supplierContactPerson" id="supplierContactInput" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Satın Alınacak Malzeme / Stok Kartı *</label>
              <select name="stockItemId" class="form-control" id="stockSelect" onchange="onStockChange(this)" required>
                <option value="">— Stok Kartı Seçin —</option>
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>" data-price="<%= item.purchasePrice || 0 %>" data-unit="<%= item.unit %>"><%= item.stockCode %> — <%= item.name %> (<%= item.category %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Miktar *</label>
              <input type="number" name="quantity" id="quantityInput" value="100" min="1" step="0.01" class="form-control" required oninput="calcTotals()">
            </div>
            <div class="form-group">
              <label class="form-label">Birim Alış Fiyatı (TL) *</label>
              <input type="number" name="unitPrice" id="unitPriceInput" value="0.00" min="0" step="0.01" class="form-control" required oninput="calcTotals()">
            </div>
            <div class="form-group">
              <label class="form-label">İskonto Oranı (%)</label>
              <input type="number" name="discountRate" id="discountRateInput" value="0" min="0" max="100" step="0.1" class="form-control" oninput="calcTotals()">
            </div>
            <div class="form-group">
              <label class="form-label">KDV Oranı (%)</label>
              <select name="taxRate" id="taxRateSelect" class="form-control" onchange="calcTotals()">
                <option value="20">KDV %20</option>
                <option value="10">KDV %10</option>
                <option value="1">KDV %1</option>
                <option value="0">KDV %0 (Muaf)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Ödeme Koşulu</label>
              <select name="paymentTerm" class="form-control">
                <option value="Vadeli_30">30 Gün Vadeli</option>
                <option value="Vadeli_60">60 Gün Vadeli</option>
                <option value="Vadeli_90">90 Gün Vadeli</option>
                <option value="Pesin">Peşin Ödeme</option>
                <option value="Kredi_Karti">Kredi Kartı</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Sipariş Tarihi</label>
              <input type="date" name="orderDate" value="<%= new Date().toISOString().split('T')[0] %>" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Beklenen Teslimat Tarihi</label>
              <input type="date" name="expectedDeliveryDate" class="form-control">
            </div>
          </div>

          <!-- Total summary -->
          <div style="background: var(--bg-elevated); padding: 20px; border-radius: 12px; margin-top: 24px; border: 1px solid var(--border);">
            <div style="font-size: 0.9rem; color: var(--text-secondary);">Tahmini Genel Toplam: <strong id="totalPreview" style="font-size: 1.3rem; color: var(--rose); margin-left: 8px;">0.00 TL</strong></div>
            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">* 50.000 TL üzerindeki satın almalar otomatik olarak Yönetsel Onay Paneline düşer.</div>
          </div>

          <div style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="submit" class="btn">📦 Siparişi Oluştur</button>
            <a href="/purchase/orders" class="btn btn-secondary">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    function onSupplierChange(select) {
      const opt = select.options[select.selectedIndex];
      document.getElementById('supplierNameInput').value = opt.getAttribute('data-name') || '';
      document.getElementById('supplierTaxNoInput').value = opt.getAttribute('data-tax') || '';
      document.getElementById('supplierContactInput').value = opt.getAttribute('data-contact') || '';
    }

    function onStockChange(select) {
      const opt = select.options[select.selectedIndex];
      const p = opt.getAttribute('data-price');
      if (p) {
        document.getElementById('unitPriceInput').value = parseFloat(p).toFixed(2);
        calcTotals();
      }
    }

    function calcTotals() {
      const qty = parseFloat(document.getElementById('quantityInput').value) || 0;
      const unitP = parseFloat(document.getElementById('unitPriceInput').value) || 0;
      const discR = parseFloat(document.getElementById('discountRateInput').value) || 0;
      const taxR = parseFloat(document.getElementById('taxRateSelect').value) || 0;

      const subtotal = qty * unitP;
      const discAmt = subtotal * (discR / 100);
      const afterDisc = subtotal - discAmt;
      const taxAmt = afterDisc * (taxR / 100);
      const grandTotal = afterDisc + taxAmt;

      document.getElementById('totalPreview').textContent = grandTotal.toLocaleString('tr-TR', {minimumFractionDigits: 2}) + ' TL';
    }
  </script>
</body>
</html>
