<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Tedarikçi Kartı — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .form-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      box-shadow: var(--shadow-md);
      margin-bottom: 28px;
      position: relative;
      overflow: hidden;
    }
    .form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #6366f1, #8b5cf6);
    }

    .form-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }
    .form-card-header-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .form-card-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      background: rgba(99, 102, 241, 0.15);
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.3);
    }

    .form-card-title { font-size: 1.15rem; font-weight: 800; color: var(--text-primary); }
    .form-card-sub { font-size: 0.82rem; color: var(--text-muted); margin-top: 2px; }

    /* TAB NAVIGATION */
    .supplier-tabs {
      display: flex;
      gap: 8px;
      background: rgba(15, 23, 42, 0.6);
      padding: 6px;
      border-radius: 14px;
      border: 1px solid var(--border);
      margin-bottom: 24px;
      overflow-x: auto;
    }
    .tab-btn {
      flex: 1;
      min-width: 140px;
      padding: 10px 16px;
      border-radius: 10px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .tab-btn:hover {
      color: var(--text-primary);
      background: rgba(255, 255, 255, 0.04);
    }
    .tab-btn.active {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.25), rgba(139, 92, 246, 0.25));
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.4);
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.15);
    }

    .tab-pane {
      display: none;
      animation: fadeIn 0.25s ease forwards;
    }
    .tab-pane.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .form-grid-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 18px;
    }

    @media (max-width: 768px) {
      .form-grid-2, .form-grid-3 {
        grid-template-columns: 1fr;
      }
    }

    .aesthetic-group { margin-bottom: 16px; }
    .aesthetic-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .aesthetic-label .req { color: #f43f5e; margin-left: 2px; }
    .aesthetic-label .badge-tip { font-size: 0.72rem; color: #64748b; font-weight: normal; }

    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      padding: 11px 14px;
      border-radius: 10px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }
    .aesthetic-input[readonly] {
      background: rgba(15, 23, 42, 0.9);
      border-color: rgba(99, 102, 241, 0.3);
      color: #818cf8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      cursor: not-allowed;
    }
    .aesthetic-input::placeholder { color: #475569; }

    .score-range-wrap {
      display: flex;
      align-items: center;
      gap: 14px;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      padding: 10px 14px;
      border-radius: 10px;
    }
    .score-slider {
      flex: 1;
      accent-color: #f59e0b;
      cursor: pointer;
    }
    .score-badge {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      font-size: 0.95rem;
      color: #fbbf24;
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid rgba(245, 158, 11, 0.35);
      padding: 4px 10px;
      border-radius: 8px;
      min-width: 68px;
      text-align: center;
    }

    .form-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .btn-indigo-gradient {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 12px 28px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-indigo-gradient:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link active">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Yeni Tedarikçi Kartı Oluştur</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Sistemde kullanılacak tedarikçinin kurumsal, mali, iletişim ve operasyonel şartlarını eksiksiz tanımlayın.</p>
        </div>
        <a href="/purchase/suppliers" class="btn btn-secondary" style="border-radius: 10px;">← Tedarikçi Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1.5px solid rgba(244,63,94,0.35); padding: 14px 20px; border-radius: 14px; margin-bottom: 24px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= error %>
        </div>
      <% } %>

      <div class="form-card">
        <div class="form-card-header">
          <div class="form-card-header-left">
            <div class="form-card-icon">🏢</div>
            <div>
              <div class="form-card-title">Tedarikçi Kayıt Formu (17 Parametre)</div>
              <div class="form-card-sub">Form sekmelerini gezerek bilgileri doldurun veya doğrudan kaydet butonuna basın</div>
            </div>
          </div>
          <div>
            <span class="status-pill status-approved" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;">
              KOD: <%= nextCode %>
            </span>
          </div>
        </div>

        <!-- FORM TABS -->
        <div class="supplier-tabs">
          <button type="button" class="tab-btn active" onclick="switchSupplierTab('tab-general')">
            <span>🏢</span> Genel & Vergi
          </button>
          <button type="button" class="tab-btn" onclick="switchSupplierTab('tab-contact')">
            <span>📞</span> İletişim & Adres
          </button>
          <button type="button" class="tab-btn" onclick="switchSupplierTab('tab-commercial')">
            <span>💳</span> Ticari & Banka
          </button>
          <button type="button" class="tab-btn" onclick="switchSupplierTab('tab-performance')">
            <span>⏱️</span> Termin & Performans
          </button>
        </div>

        <form id="supplierForm" action="/purchase/suppliers/add" method="POST" onsubmit="return validateSupplierForm()">
          
          <!-- TAB 1: GENEL & VERGİ BİLGİLERİ -->
          <div id="tab-general" class="tab-pane active">
            <div class="form-grid-2">
              <!-- 1. Tedarikçi Kodu -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>1. Tedarikçi Kodu (Otomatik) <span class="req">*</span></span>
                  <span class="badge-tip">Değiştirilemez</span>
                </label>
                <input type="text" id="tedarikciKodu" name="tedarikciKodu" value="<%= formData.tedarikciKodu || formData.supplierCode || nextCode %>" class="aesthetic-input" readonly required>
              </div>

              <!-- 17. Durum -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>17. Tedarikçi Durumu</span>
                  <span class="badge-tip">Aktif / Pasif</span>
                </label>
                <select id="durum" name="durum" class="aesthetic-input" style="cursor: pointer;">
                  <option value="Active" <%= (formData.durum === 'Active' || !formData.durum) ? 'selected' : '' %>>● Aktif Tedarikçi</option>
                  <option value="Inactive" <%= formData.durum === 'Inactive' ? 'selected' : '' %>>● Pasif Tedarikçi</option>
                </select>
              </div>
            </div>

            <div class="form-grid-2">
              <!-- 2. Firma Unvanı -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>2. Firma Resmi Unvanı <span class="req">*</span></span>
                  <span class="badge-tip">Resmi Şirket Adı</span>
                </label>
                <input type="text" id="firmaAdi" name="firmaAdi" value="<%= formData.firmaAdi || formData.companyName || '' %>" placeholder="Örn: Demir Grup Taşımacılık San. ve Tic. A.Ş." class="aesthetic-input" required minlength="2">
              </div>

              <!-- 3. Ticari Ad (Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>3. Ticari Ad (Kısa Ad)</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <input type="text" id="ticariAd" name="ticariAd" value="<%= formData.ticariAd || formData.commercialName || '' %>" placeholder="Örn: Demir Grup" class="aesthetic-input">
              </div>
            </div>

            <div class="form-grid-3">
              <!-- 4. Tedarikçi Grubu / Kategori (Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>4. Tedarikçi Grubu / Kategori</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <select id="kategori" name="kategori" class="aesthetic-input" style="cursor: pointer;">
                  <option value="Hammadde" <%= (formData.kategori === 'Hammadde' || !formData.kategori) ? 'selected' : '' %>>🔩 Hammadde Tedarikçisi</option>
                  <option value="Yari_Mamul" <%= formData.kategori === 'Yari_Mamul' ? 'selected' : '' %>>⚙️ Yarı Mamul Tedarikçisi</option>
                  <option value="Hizmet" <%= formData.kategori === 'Hizmet' ? 'selected' : '' %>>🛠️ Fasoncu / Hizmet Sağlayıcı</option>
                  <option value="Yedek_Parca" <%= formData.kategori === 'Yedek_Parca' ? 'selected' : '' %>>🔧 Yedek Parça & Sarf</option>
                  <option value="Ambalaj" <%= formData.kategori === 'Ambalaj' ? 'selected' : '' %>>📦 Ambalaj & Paketleme</option>
                  <option value="Diger" <%= formData.kategori === 'Diger' ? 'selected' : '' %>>🏢 Genel / Diğer</option>
                </select>
              </div>

              <!-- 5. Vergi Dairesi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>5. Vergi Dairesi <span class="req">*</span></span>
                </label>
                <input type="text" id="vergiDairesi" name="vergiDairesi" value="<%= formData.vergiDairesi || formData.taxOffice || '' %>" placeholder="Örn: Kadıköy V.D." class="aesthetic-input" required>
              </div>

              <!-- 5. Vergi Numarası -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>5. Vergi No / T.C. No <span class="req">*</span></span>
                  <span class="badge-tip">10 veya 11 Hane</span>
                </label>
                <input type="text" id="vergiNo" name="vergiNo" value="<%= formData.vergiNo || formData.taxNo || '' %>" placeholder="10 Haneli VKN veya 11 Haneli TCKN" class="aesthetic-input" maxlength="11" required>
              </div>
            </div>
          </div>

          <!-- TAB 2: İLETİŞİM & FATURA ADRESİ -->
          <div id="tab-contact" class="tab-pane">
            <div class="form-grid-3">
              <!-- 10. İlgili Satış Temsilcisi (Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>10. İlgili Satış Temsilcisi</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <input type="text" id="ilgiliKisi" name="ilgiliKisi" value="<%= formData.ilgiliKisi || formData.contactPerson || '' %>" placeholder="Örn: Mehmet Kaplan" class="aesthetic-input">
              </div>

              <!-- 11. E-Posta Adresi (Zorunlu) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>11. E-Posta Adresi <span class="req">*</span></span>
                </label>
                <input type="email" id="eposta" name="eposta" value="<%= formData.eposta || formData.email || '' %>" placeholder="siparis@demirgrup.com" class="aesthetic-input" required>
              </div>

              <!-- 13. Web Sitesi (Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>13. Web Sitesi</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <input type="text" id="webSitesi" name="webSitesi" value="<%= formData.webSitesi || formData.website || '' %>" placeholder="https://www.demirgrup.com" class="aesthetic-input">
              </div>
            </div>

            <div class="form-grid-2">
              <!-- 12. Telefon (Sabit - Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>12. Sabit Telefon Numarası</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <input type="text" id="telefon" name="telefon" value="<%= formData.telefon || formData.phone || '' %>" placeholder="+90 (212) 555 0000" class="aesthetic-input">
              </div>

              <!-- 12. GSM / Cep Numarası (Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>12. GSM / Cep Telefon Numarası</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <input type="text" id="gsm" name="gsm" value="<%= formData.gsm || formData.mobilePhone || '' %>" placeholder="+90 (532) 123 4567" class="aesthetic-input">
              </div>
            </div>

            <div class="form-grid-3">
              <!-- 6. Fatura Adresi (Opsiyonel) -->
              <div class="aesthetic-group" style="grid-column: span 2;">
                <label class="aesthetic-label">
                  <span>6. Fatura & Merkez Şirket Adresi</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <input type="text" id="adres" name="adres" value="<%= formData.adres || formData.address || '' %>" placeholder="Örn: İkitelli OSB, Metal İş Sanayi Sitesi 12. Blok No:45" class="aesthetic-input">
              </div>

              <!-- 6. Şehir & Ülke (Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>6. Şehir / Ülke</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" id="sehir" name="sehir" value="<%= formData.sehir || formData.city || 'İstanbul' %>" placeholder="İstanbul" class="aesthetic-input" style="flex: 1;">
                  <input type="text" id="ulke" name="ulke" value="<%= formData.ulke || formData.country || 'Türkiye' %>" placeholder="Türkiye" class="aesthetic-input" style="width: 90px;">
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 3: TİCARİ ŞARTLAR & BANKA -->
          <div id="tab-commercial" class="tab-pane">
            <div class="form-grid-3">
              <!-- 8. Varsayılan Para Birimi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>8. Varsayılan Para Birimi</span>
                </label>
                <select id="paraBirimi" name="paraBirimi" class="aesthetic-input" style="cursor: pointer;">
                  <option value="TRY" <%= (formData.paraBirimi === 'TRY' || !formData.paraBirimi) ? 'selected' : '' %>>₺ TRY - Türk Lirası</option>
                  <option value="USD" <%= formData.paraBirimi === 'USD' ? 'selected' : '' %>>$ USD - Amerikan Doları</option>
                  <option value="EUR" <%= formData.paraBirimi === 'EUR' ? 'selected' : '' %>>€ EUR - Euro</option>
                </select>
              </div>

              <!-- 9. Varsayılan Ödeme Vadesi (Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>9. Varsayılan Ödeme Vadesi</span>
                  <span class="badge-tip">Opsiyonel</span>
                </label>
                <select id="odemeVadesi" name="odemeVadesi" class="aesthetic-input" style="cursor: pointer;">
                  <option value="Vadeli_30" <%= (formData.odemeVadesi === 'Vadeli_30' || !formData.odemeVadesi) ? 'selected' : '' %>>30 Gün Vadeli</option>
                  <option value="Vadeli_15" <%= formData.odemeVadesi === 'Vadeli_15' ? 'selected' : '' %>>15 Gün Vadeli</option>
                  <option value="Vadeli_45" <%= formData.odemeVadesi === 'Vadeli_45' ? 'selected' : '' %>>45 Gün Vadeli</option>
                  <option value="Vadeli_60" <%= formData.odemeVadesi === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
                  <option value="Vadeli_90" <%= formData.odemeVadesi === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
                  <option value="Pesin" <%= formData.odemeVadesi === 'Pesin' ? 'selected' : '' %>>Peşin Ödeme</option>
                  <option value="Kredi_Karti" <%= formData.odemeVadesi === 'Kredi_Karti' ? 'selected' : '' %>>Kredi Kartı / DBS</option>
                </select>
              </div>

              <!-- 14. Varsayılan Teslimat Şekli (Opsiyonel) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>14. Varsayılan Teslimat Şekli</span>
                  <span class="badge-tip">Opsiyonel (Incoterms)</span>
                </label>
                <select id="teslimatSekli" name="teslimatSekli" class="aesthetic-input" style="cursor: pointer;">
                  <option value="DAP - Adrese / Fabrikaya Teslim" <%= (formData.teslimatSekli === 'DAP - Adrese / Fabrikaya Teslim' || !formData.teslimatSekli) ? 'selected' : '' %>>DAP - Adrese / Fabrikaya Teslim</option>
                  <option value="EXW - Fabrika / Ambar Çıkışı" <%= formData.teslimatSekli === 'EXW - Fabrika / Ambar Çıkışı' ? 'selected' : '' %>>EXW - Fabrika / Ambar Çıkışı</option>
                  <option value="CIF - Sigorta ve Navlun Dahil" <%= formData.teslimatSekli === 'CIF - Sigorta ve Navlun Dahil' ? 'selected' : '' %>>CIF - Sigorta ve Navlun Dahil</option>
                  <option value="FOB - Limanda Teslim" <%= formData.teslimatSekli === 'FOB - Limanda Teslim' ? 'selected' : '' %>>FOB - Limanda / Gemide Teslim</option>
                  <option value="DDP - Gümrük ve Vergiler Dahil" <%= formData.teslimatSekli === 'DDP - Gümrük ve Vergiler Dahil' ? 'selected' : '' %>>DDP - Gümrük ve Vergiler Dahil</option>
                </select>
              </div>
            </div>

            <!-- 7. Banka Hesap Bilgileri (Opsiyonel) -->
            <div class="aesthetic-group">
              <label class="aesthetic-label">
                <span>7. Banka Hesap Bilgileri (Banka Adı, IBAN & Hesap No)</span>
                <span class="badge-tip">Opsiyonel</span>
              </label>
              <textarea id="bankaBilgileri" name="bankaBilgileri" class="aesthetic-input" rows="2" placeholder="Örn: Garanti BBVA - TR12 0006 2000 0001 2345 6789 01 / İkitelli Şubesi (Hesap Sahibi: Demir Grup A.Ş.)"><%= formData.bankaBilgileri || '' %></textarea>
            </div>
          </div>

          <!-- TAB 4: TERMİN & PERFORMANS PUANI -->
          <div id="tab-performance" class="tab-pane">
            <div class="form-grid-2">
              <!-- 15. Varsayılan Termin Süresi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>15. Varsayılan Termin Süresi (Gün) <span class="req">*</span></span>
                  <span class="badge-tip">Ortalama Teslim Süresi</span>
                </label>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <input type="number" id="terminSuresi" name="terminSuresi" value="<%= formData.terminSuresi || 7 %>" min="1" max="365" class="aesthetic-input" required style="font-family: 'JetBrains Mono', monospace; font-weight: 700;">
                  <span style="color: var(--text-muted); font-weight: 600; font-size: 0.9rem;">İş Günü</span>
                </div>
              </div>

              <!-- 16. Kalite / Performans Puanı (Otomatik Sistem Başlangıç Puanı) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>16. Kalite / Performans Puanı</span>
                  <span class="badge-tip">🚀 Sistem Başlangıç Puanı (85 / 100)</span>
                </label>
                <div style="background: rgba(15, 23, 42, 0.6); border: 1.5px solid rgba(245, 158, 11, 0.35); padding: 12px 16px; border-radius: 10px; display: flex; align-items: center; justify-content: space-between;">
                  <div>
                    <div style="font-size: 0.95rem; font-weight: 800; color: #fbbf24; display: flex; align-items: center; gap: 6px;">
                      <span>⭐</span> 85.0 / 100 Puan (Başlangıç)
                    </div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">
                      Tedarikçiden sipariş verildikçe ve gününde/kaliteli mal kabul yapıldıkça sistem puanı otomatik artırır veya düşürür.
                    </div>
                  </div>
                  <input type="hidden" id="performansSkoru" name="performansSkoru" value="85">
                </div>
              </div>
            </div>

            <!-- Özel Notlar (Opsiyonel) -->
            <div class="aesthetic-group">
              <label class="aesthetic-label">
                <span>Özel Notlar & Tedarikçi Değerlendirmesi</span>
                <span class="badge-tip">Opsiyonel</span>
              </label>
              <textarea id="notlar" name="notlar" class="aesthetic-input" rows="3" placeholder="Sözleşme şartları, kalite sertifikaları (ISO 9001 vb.), ambar kabul kuralları ve tedarikçi değerlendirme notları..."><%= formData.notlar || '' %></textarea>
            </div>
          </div>

          <!-- FORM ACTIONS -->
          <div class="form-actions">
            <div>
              <a href="/purchase/suppliers" class="btn btn-secondary" style="border-radius: 10px; padding: 11px 20px;">İptal</a>
            </div>
            <div style="display: flex; gap: 10px;">
              <button type="button" class="btn btn-secondary" id="btnPrevTab" onclick="navTab(-1)" style="border-radius: 10px; display: none;">← Önceki Sekme</button>
              <button type="button" class="btn btn-secondary" id="btnNextTab" onclick="navTab(1)" style="border-radius: 10px;">Sonraki Sekme →</button>
              <button type="submit" class="btn-indigo-gradient">
                <span>🏢</span> Tedarikçi Kartını Kaydet
              </button>
            </div>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    const tabs = ['tab-general', 'tab-contact', 'tab-commercial', 'tab-performance'];
    let currentTabIndex = 0;

    function switchSupplierTab(tabId) {
      currentTabIndex = tabs.indexOf(tabId);
      if (currentTabIndex === -1) currentTabIndex = 0;

      document.querySelectorAll('.tab-btn').forEach((btn, idx) => {
        btn.classList.toggle('active', idx === currentTabIndex);
      });
      document.querySelectorAll('.tab-pane').forEach((pane, idx) => {
        pane.classList.toggle('active', idx === currentTabIndex);
      });

      const btnPrev = document.getElementById('btnPrevTab');
      const btnNext = document.getElementById('btnNextTab');
      if (btnPrev) btnPrev.style.display = currentTabIndex === 0 ? 'none' : 'inline-flex';
      if (btnNext) btnNext.style.display = currentTabIndex === tabs.length - 1 ? 'none' : 'inline-flex';
    }

    function navTab(direction) {
      let newIdx = currentTabIndex + direction;
      if (newIdx >= 0 && newIdx < tabs.length) {
        switchSupplierTab(tabs[newIdx]);
      }
    }

    function validateSupplierForm() {
      // 1. Tedarikçi Kodu (Zorunlu)
      const tedarikciKodu = document.getElementById('tedarikciKodu').value.trim();
      if (!tedarikciKodu) {
        alert('Tedarikçi Kodu zorunludur.');
        switchSupplierTab('tab-general');
        document.getElementById('tedarikciKodu').focus();
        return false;
      }

      // 2. Firma Unvanı (Zorunlu)
      const firmaAdi = document.getElementById('firmaAdi').value.trim();
      if (!firmaAdi || firmaAdi.length < 2) {
        alert('Lütfen geçerli bir Firma Resmi Unvanı giriniz (en az 2 karakter zorunludur).');
        switchSupplierTab('tab-general');
        document.getElementById('firmaAdi').focus();
        return false;
      }

      // 5. Vergi Dairesi (Zorunlu)
      const vergiDairesi = document.getElementById('vergiDairesi').value.trim();
      if (!vergiDairesi) {
        alert('Vergi Dairesi alanı zorunludur.');
        switchSupplierTab('tab-general');
        document.getElementById('vergiDairesi').focus();
        return false;
      }

      // 5. Vergi Numarası (Zorunlu)
      const vergiNo = document.getElementById('vergiNo').value.trim();
      if (!vergiNo) {
        alert('Vergi Numarası / TCKN alanı zorunludur.');
        switchSupplierTab('tab-general');
        document.getElementById('vergiNo').focus();
        return false;
      }
      if (!/^[0-9]{10,11}$/.test(vergiNo.replace(/[\s-]/g, ''))) {
        alert('Vergi Numarası 10 haneli (Tüzel Kişi) veya 11 haneli (Şahıs) rakamlardan oluşmalıdır.');
        switchSupplierTab('tab-general');
        document.getElementById('vergiNo').focus();
        return false;
      }

      // 11. E-Posta (Zorunlu)
      const eposta = document.getElementById('eposta').value.trim();
      if (!eposta) {
        alert('E-Posta Adresi alanı zorunludur.');
        switchSupplierTab('tab-contact');
        document.getElementById('eposta').focus();
        return false;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(eposta)) {
        alert('Lütfen geçerli bir E-Posta adresi giriniz (örn: siparis@firma.com).');
        switchSupplierTab('tab-contact');
        document.getElementById('eposta').focus();
        return false;
      }

      // 15. Termin Süresi (Zorunlu)
      const termin = parseInt(document.getElementById('terminSuresi').value, 10);
      if (isNaN(termin) || termin < 1) {
        alert('Varsayılan termin süresi zorunludur ve en az 1 gün olmalıdır.');
        switchSupplierTab('tab-performance');
        document.getElementById('terminSuresi').focus();
        return false;
      }

      return true;
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
