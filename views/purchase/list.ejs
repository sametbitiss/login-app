<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satın Alma Siparişleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">SATIN ALMA YÖNETİMİ</div>
      <a href="/purchase/orders" class="mss-link active">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
        Satın Alma Siparişi
      </a>
      <div class="mss-sub">
        <a href="/purchase/orders" class="mss-sub-link active">📋 Satın Alma Siparişleri Listesi</a>
        <a href="/purchase/orders/add" class="mss-sub-link">➕ Yeni Sipariş Ekle</a>
        <a href="/purchase/orders#requisitions" class="mss-sub-link">📩 Gelen Stok Talepleri</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">
      <div class="page-header">
        <div>
          <h1>Satın Alma Siparişleri</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tedarikçi siparişlerini, hammadde girdilerini ve alış bütçenizi yönetin.</p>
        </div>
        <a href="/purchase/orders/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Satın Alma Ekle
        </a>
      </div>

      <!-- Purchase KPI Strip -->
      <div class="kpi-strip">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">📦</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Toplam Satın Alma</span>
            <span class="kpi-chip-value"><%= stats.totalOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">⏳</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Onay Bekleyen</span>
            <span class="kpi-chip-value"><%= stats.pendingOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">🚚</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Teslim Alınan</span>
            <span class="kpi-chip-value"><%= stats.receivedOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--rose">💳</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Toplam Harcama</span>
            <span class="kpi-chip-value"><%= parseFloat(stats.totalSpend).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> ₺</span>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="filter-bar">
        <form method="GET" action="/purchase/orders" class="filter-form">
          <div class="filter-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" placeholder="Sipariş no, tedarikçi unvanı veya vergi no..." value="<%= filterSearch %>" class="filter-input">
          </div>
          <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Sipariş Durumları</option>
            <option value="Draft" <%= filterStatus === 'Draft' ? 'selected' : '' %>>Taslak</option>
            <option value="Pending_Approval" <%= filterStatus === 'Pending_Approval' ? 'selected' : '' %>>Onay Bekliyor</option>
            <option value="Ordered" <%= filterStatus === 'Ordered' ? 'selected' : '' %>>Sipariş Verildi</option>
            <option value="Partial_Received" <%= filterStatus === 'Partial_Received' ? 'selected' : '' %>>Kısmi Teslim Alındı</option>
            <option value="Received" <%= filterStatus === 'Received' ? 'selected' : '' %>>Teslim Alındı</option>
            <option value="Cancelled" <%= filterStatus === 'Cancelled' ? 'selected' : '' %>>İptal</option>
          </select>
          <select name="paymentTerm" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Ödeme Koşulları</option>
            <option value="Pesin" <%= filterPaymentTerm === 'Pesin' ? 'selected' : '' %>>Peşin</option>
            <option value="Vadeli_30" <%= filterPaymentTerm === 'Vadeli_30' ? 'selected' : '' %>>30 Gün Vadeli</option>
            <option value="Vadeli_60" <%= filterPaymentTerm === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
            <option value="Vadeli_90" <%= filterPaymentTerm === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
            <option value="Kredi_Karti" <%= filterPaymentTerm === 'Kredi_Karti' ? 'selected' : '' %>>Kredi Kartı</option>
          </select>
          <button type="submit" class="btn btn-sm">Filtrele</button>
        </form>
      </div>

      <!-- Results Count -->
      <div class="results-info">
        <span>Toplam <strong><%= orders.length %></strong> satın alma siparişi listeleniyor</span>
      </div>

      <!-- Purchase Table -->
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Sipariş No</th>
              <th>Tedarikçi Unvanı</th>
              <th>Alınan Malzeme</th>
              <th>Miktar</th>
              <th>Birim Alış Fiyatı</th>
              <th>Genel Toplam</th>
              <th>Ödeme Koşulu</th>
              <th>Tarih</th>
              <th>Durum</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders.length === 0) { %>
              <tr>
                <td colspan="10" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  <div style="font-size: 2rem; margin-bottom: 8px;">🏭</div>
                  Henüz kayıtlı satın alma siparişi bulunmamaktadır.
                  <br><a href="/purchase/orders/add" style="color: var(--indigo); font-weight: 600;">İlk satın alma siparişinizi oluşturun →</a>
                </td>
              </tr>
            <% } else { %>
              <% orders.forEach(order => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= order.orderNo %></strong></td>
                  <td>
                    <div style="font-weight: 600;"><%= order.supplierName %></div>
                    <% if (order.supplierTaxNo) { %>
                      <div style="font-size: 0.75rem; color: var(--text-muted);">VN: <%= order.supplierTaxNo %></div>
                    <% } %>
                  </td>
                  <td>
                    <% if (order.stockItem) { %>
                      <span style="font-weight: 500;"><%= order.stockItem.name %></span>
                      <span style="font-size: 0.75rem; color: var(--text-muted); display: block;"><%= order.stockItem.stockCode %></span>
                    <% } else { %>
                      <span style="color: var(--text-muted);">—</span>
                    <% } %>
                  </td>
                  <td><strong><%= parseFloat(order.quantity).toLocaleString('tr-TR') %> <%= order.stockItem ? order.stockItem.unit : '' %></strong></td>
                  <td><%= parseFloat(order.unitPrice).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> <%= order.currency %></td>
                  <td><strong style="color: var(--rose);"><%= parseFloat(order.totalAmount).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> <%= order.currency %></strong></td>
                  <td style="font-size: 0.8rem;">
                    <%= order.paymentTerm === 'Pesin' ? 'Peşin' : order.paymentTerm === 'Vadeli_30' ? '30 Gün Vadeli' : order.paymentTerm === 'Vadeli_60' ? '60 Gün Vadeli' : order.paymentTerm === 'Vadeli_90' ? '90 Gün Vadeli' : 'Kredi Kartı' %>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(order.orderDate).toLocaleDateString('tr-TR') %></td>
                  <td>
                    <% if (order.status === 'Received') { %>
                      <span class="status-pill status-active">● Teslim Alındı</span>
                    <% } else if (order.status === 'Ordered') { %>
                      <span class="status-pill status-approved">● Sipariş Verildi</span>
                    <% } else if (order.status === 'Pending_Approval') { %>
                      <span class="status-pill status-pending">● Onay Bekliyor</span>
                    <% } else if (order.status === 'Partial_Received') { %>
                      <span class="status-pill status-onleave">● Kısmi Teslim</span>
                    <% } else if (order.status === 'Cancelled') { %>
                      <span class="status-pill status-rejected">● İptal</span>
                    <% } else { %>
                      <span class="status-pill status-pending">● <%= order.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/purchase/orders/<%= order.id %>/edit" class="btn btn-sm btn-secondary" style="white-space: nowrap;">✏️ Detay / Düzenle</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Incoming Requisitions Table -->
      <div class="table-wrapper" style="margin-top: 2rem;">
        <h3 style="color: var(--indigo); font-size: 1.05rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); font-weight: 700;">
          📨 Stok & Üretim Modüllerinden Gelen Satın Alma Talepleri (<%= requisitions ? requisitions.length : 0 %>)
        </h3>
        <table class="data-table">
          <thead>
            <tr>
              <th>Talep No</th>
              <th>Kaynak Modül</th>
              <th>Talep Edilen Malzeme</th>
              <th>Miktar</th>
              <th>Aciliyet</th>
              <th>Talep Eden</th>
              <th>Gerekçe / Not</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (requisitions && requisitions.length > 0) { %>
              <% requisitions.forEach(reqItem => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= reqItem.requisitionNo %></strong></td>
                  <td>
                    <% if (reqItem.sourceModule === 'Stock') { %>
                      <span class="status-pill status-approved">📦 Stok Modülü (Min/Max)</span>
                    <% } else { %>
                      <span class="status-pill status-onleave">🏭 Üretim Modülü (MRP)</span>
                    <% } %>
                  </td>
                  <td>
                    <strong style="color: var(--text-main);"><%= reqItem.stockItem ? reqItem.stockItem.name : '—' %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-muted);"><%= reqItem.stockItem ? reqItem.stockItem.stockCode : '' %></div>
                  </td>
                  <td><strong><%= reqItem.requestedQuantity %> <%= reqItem.stockItem ? reqItem.stockItem.unit : 'Adet' %></strong></td>
                  <td>
                    <% if (reqItem.urgency === 'Urgent') { %>
                      <span class="status-pill status-rejected">🚨 Acil</span>
                    <% } else { %>
                      <span class="status-pill status-approved">Normal</span>
                    <% } %>
                  </td>
                  <td><%= reqItem.requesterName %></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= reqItem.notes || '—' %></td>
                  <td>
                    <% if (reqItem.status !== 'Ordered') { %>
                      <form action="/purchase/requisitions/<%= reqItem.id %>/convert" method="POST">
                        <button type="submit" class="btn btn-sm btn-success">💳 Siparişe Dönüştür</button>
                      </form>
                    <% } else { %>
                      <span class="status-pill status-active">✓ Sipariş Olusturuldu</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                  Henüz onay bekleyen gelen satın alma talebi bulunmamaktadır.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
