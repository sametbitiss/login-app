<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tedarikçi Detayı — <%= supplier.companyName %></title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .card-detail { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: var(--shadow-md); margin-bottom: 24px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .info-label { font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 4px; }
    .info-val { font-size: 1.1rem; font-weight: 700; color: var(--text-primary); }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link active">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %><% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">

      <%
        const code = supplier.tedarikciKodu || supplier.supplierCode || '—';
        const name = supplier.firmaAdi || supplier.companyName || '—';
        const tradeName = supplier.ticariAd || supplier.commercialName;
        const taxOffice = supplier.vergiDairesi || supplier.taxOffice || '—';
        const taxNo = supplier.vergiNo || supplier.taxNo || '—';
        const contact = supplier.ilgiliKisi || supplier.contactPerson || '—';
        const email = supplier.eposta || supplier.email || '—';
        const phone = supplier.telefon || supplier.phone || '—';
        const gsm = supplier.gsm || supplier.mobilePhone || '—';
        const website = supplier.webSitesi || supplier.website || '—';
        const address = supplier.adres || supplier.address || '—';
        const city = supplier.sehir || supplier.city || '—';
        const country = supplier.ulke || supplier.country || 'Türkiye';
        const term = supplier.odemeVadesi || supplier.paymentTerm || 'Vadeli_30';
        const curr = supplier.paraBirimi || supplier.currency || 'TRY';
        const leadTime = supplier.terminSuresi || 7;
        const deliveryTerms = supplier.teslimatSekli || 'DAP - Adrese / Fabrikaya Teslim';
        const cat = supplier.kategori || supplier.category || 'Hammadde';
        const status = supplier.durum || supplier.status || 'Active';
        const bankInfo = supplier.bankaBilgileri || '—';
        const notes = supplier.notlar || supplier.notes || '';

        const termsMap = {
          'Pesin': 'Peşin',
          'Vadeli_15': '15 Gün Vadeli',
          'Vadeli_30': '30 Gün Vadeli',
          'Vadeli_45': '45 Gün Vadeli',
          'Vadeli_60': '60 Gün Vadeli',
          'Vadeli_90': '90 Gün Vadeli',
          'Kredi_Karti': 'Kredi Kartı / DBS'
        };
        const displayTerm = termsMap[term] || term;

        const catMap = {
          'Hammadde': 'Hammadde Tedarikçisi',
          'Yari_Mamul': 'Yarı Mamul Tedarikçisi',
          'Hizmet': 'Fasoncu / Hizmet Sağlayıcı',
          'Yedek_Parca': 'Yedek Parça & Sarf',
          'Ambalaj': 'Ambalaj & Paketleme',
          'Diger': 'Genel / Diğer'
        };
        const displayCat = catMap[cat] || cat;

        let scoreVal = parseFloat(supplier.performansSkoru !== undefined ? supplier.performansSkoru : (supplier.kaliteSkoru !== undefined ? supplier.kaliteSkoru : (supplier.performanceScore || 85)));
        if (scoreVal <= 5) scoreVal = scoreVal * 20;
        scoreVal = Math.min(100, Math.round(scoreVal));

        const ordersList = supplier.satinAlmaSiparisleri || supplier.purchaseOrders || [];
      %>

      <div class="page-header">
        <div>
          <h1>Tedarikçi Kartı: <%= name %></h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            <strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= code %></strong> • <%= displayCat %> • 
            <% if (status === 'Active') { %>
              <span class="status-pill status-active">● Aktif</span>
            <% } else { %>
              <span class="status-pill status-rejected">● Pasif</span>
            <% } %>
          </p>
        </div>
        <a href="/purchase/suppliers" class="btn btn-secondary">← Tedarikçi Listesine Dön</a>
      </div>

      <div class="card-detail">
        <div class="grid-3">
          <div><div class="info-label">Firma Resmi Unvanı</div><div class="info-val"><%= name %></div></div>
          <div><div class="info-label">Ticari / Kısa Ad</div><div class="info-val" style="color: #818cf8;"><%= tradeName || '—' %></div></div>
          <div><div class="info-label">Vergi Dairesi / No</div><div class="info-val"><%= taxOffice %> / <%= taxNo %></div></div>

          <div><div class="info-label">İlgili Satış Temsilcisi</div><div class="info-val"><%= contact %></div></div>
          <div><div class="info-label">E-Posta</div><div class="info-val" style="font-size: 0.95rem; color: #38bdf8;"><%= email %></div></div>
          <div><div class="info-label">Telefon & GSM</div><div class="info-val" style="font-size: 0.95rem;"><%= phone %> / <%= gsm %></div></div>

          <div><div class="info-label">Ödeme Vadesi & Para Birimi</div><div class="info-val" style="color: #fbbf24;"><%= displayTerm %> (<%= curr %>)</div></div>
          <div><div class="info-label">Teslimat Şekli & Termin</div><div class="info-val" style="font-size: 0.95rem;"><%= deliveryTerms.split('-')[0].trim() %> • <strong><%= leadTime %> Gün</strong></div></div>
          <div><div class="info-label">Performans Puanı</div><div class="info-val" style="color: var(--amber); font-family: 'JetBrains Mono', monospace;">⭐ <%= scoreVal %> / 100</div></div>

          <div style="grid-column: span 2;"><div class="info-label">Fatura & Şirket Adresi</div><div class="info-val" style="font-size: 0.9rem; font-weight: 500;"><%= address %> <%= city ? '(' + city + ' / ' + country + ')' : '' %></div></div>
          <div><div class="info-label">Web Sitesi</div><div class="info-val" style="font-size: 0.9rem;"><%= website %></div></div>

          <% if (bankInfo && bankInfo !== '—') { %>
            <div style="grid-column: span 3; background: rgba(15, 23, 42, 0.4); padding: 12px 16px; border-radius: 10px; border: 1px solid var(--border);">
              <div class="info-label">🏦 Banka Hesap Bilgileri (IBAN)</div>
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; color: #f8fafc; margin-top: 4px;"><%= bankInfo %></div>
            </div>
          <% } %>

          <% if (notes) { %>
            <div style="grid-column: span 3; background: rgba(15, 23, 42, 0.4); padding: 12px 16px; border-radius: 10px; border: 1px solid var(--border);">
              <div class="info-label">📝 Özel Değerlendirme & Sözleşme Notları</div>
              <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px; line-height: 1.4;"><%= notes %></div>
            </div>
          <% } %>
        </div>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: var(--shadow-md);">
        <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-primary); margin-bottom: 16px;">📋 Tedarikçiden Yapılan Satın Almalar</h3>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Sipariş No</th>
                <th>Alınan Ürün / Malzeme</th>
                <th>Miktar</th>
                <th>Genel Toplam</th>
                <th>Tarih</th>
                <th>Durum</th>
              </tr>
            </thead>
            <tbody>
              <% if (ordersList.length === 0) { %>
                <tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">Bu tedarikçiden henüz verilmiş sipariş bulunmamaktadır.</td></tr>
              <% } else { %>
                <% ordersList.forEach(o => { %>
                  <% 
                    const orderNo = o.siparisNo || o.orderNo;
                    const st = o.stokKarti || o.stockItem;
                    const qty = o.miktar !== undefined ? o.miktar : o.quantity;
                    const unit = o.birim || (st ? st.birim : '');
                    const total = parseFloat(o.toplamTutar !== undefined ? o.toplamTutar : o.totalAmount) || 0;
                    const oCurr = o.paraBirimi || o.currency || 'TRY';
                    const orderDate = o.siparisTarihi || o.orderDate || o.createdAt;
                    const oStatus = o.durum || o.status || 'Ordered';
                  %>
                  <tr>
                    <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= orderNo %></strong></td>
                    <td><%= st ? (st.ad || st.name) : '—' %></td>
                    <td><%= qty %> <%= unit %></td>
                    <td><strong style="color: var(--emerald);"><%= total.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= oCurr %></strong></td>
                    <td><%= new Date(orderDate).toLocaleDateString('tr-TR') %></td>
                    <td><span class="status-pill status-active">● <%= oStatus %></span></td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
