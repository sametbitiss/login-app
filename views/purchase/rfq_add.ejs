<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Satın Alma Teklifi Ekle (RFQ) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <style>
    .glass-form-card {
      background: rgba(15, 23, 42, 0.95);
      border-radius: 20px;
      border: 1px solid var(--border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
      padding: 2rem;
      position: relative;
      overflow: hidden;
      margin-bottom: 2.5rem;
    }

    .glass-form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 50%, #10b981 100%);
    }

    /* Tab Menu Navigation */
    .tab-nav {
      display: flex;
      gap: 12px;
      border-bottom: 2px solid #1e293b;
      margin-bottom: 24px;
      padding-bottom: 8px;
    }

    .tab-btn {
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #94a3b8;
      font-size: 0.95rem;
      font-weight: 700;
      padding: 12px 24px;
      border-radius: 12px 12px 0 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s ease;
    }

    .tab-btn:hover {
      color: #f8fafc;
      background: rgba(51, 65, 85, 0.8);
    }

    .tab-btn.active {
      color: #fff;
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      border-color: #6366f1;
      box-shadow: 0 -4px 16px rgba(99, 102, 241, 0.35);
    }

    .tab-pane {
      display: none;
      animation: fadeIn 0.3s ease-in-out;
    }

    .tab-pane.active {
      display: block;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .section-title {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 1.25rem;
      display: flex;
      align-items: center;
      gap: 10px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }

    .form-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .form-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .aesthetic-group {
      margin-bottom: 16px;
    }

    .aesthetic-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 6px;
      display: block;
    }

    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      padding: 12px 14px;
      border-radius: 10px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }

    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }

    .aesthetic-input[readonly] {
      background: #090d16;
      border-color: #334155;
      color: #818cf8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      cursor: not-allowed;
    }

    .min-stock-warning {
      font-size: 0.72rem;
      color: #f43f5e;
      font-weight: 700;
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .tab-footer-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid #1e293b;
    }
  </style>
</head>

<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32"
          fill="none">
          <rect width="32" height="32" rx="8" fill="url(#bGrad)" />
          <path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
          <defs>
            <linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32">
              <stop offset="0%" stop-color="#6366f1" />
              <stop offset="100%" stop-color="#8b5cf6" />
            </linearGradient>
          </defs>
        </svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link active">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar">
        <%= user.username.charAt(0).toUpperCase() %>
      </div>
      <div class="msu-meta"><strong>
          <%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %>
        </strong><span>
          <%= user.role %>
        </span></div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role==='Admin' ) { %><a href="/admin" class="mt-link">Sistem Yönetimi</a>
          <% } %>
            <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a
              href="/purchase" class="mt-link active">Satın Alma</a>
            <% if (user.role==='Admin' || user.role==='Production_Manager' ) { %><a href="/production"
                class="mt-link">Üretim Planlama</a>
              <% } %>
                <% if (user.role==='Admin' || user.role==='Quality_Manager' || user.role==='Production_Manager' ||
                  user.role==='Stock_Manager' || user.role==='Purchase_Manager' ) { %><a href="/quality"
                    class="mt-link">Kalite Kontrol</a>
                  <% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout"
          title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link">⚡
          Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link active">📩 Talepler</a><a href="/purchase/rfq"
          class="msn-link">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link">📦 Siparişler</a><a href="/purchase/goods-receipt"
          class="msn-link">🚛 Mal Kabul</a>
        <a href="/purchase/suppliers" class="msn-link">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>📨 Satın Alma Talebine Teklif Ekle</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Talep edilen ürün için
            tedarikçilerden gelen teklif detaylarını sekme menüler üzerinden adım adım tanımlayın.</p>
        </div>
        <a href="/purchase/requisitions" class="btn btn-secondary">← Talepler Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div
          style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3); padding: 14px 20px; border-radius: 12px; margin-bottom: 24px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span>
          <%= error %>
        </div>
        <% } %>

          <!-- TAB MENU BUTTONS -->
          <div class="tab-nav">
            <button type="button" class="tab-btn active" onclick="switchTab('tab-general')" id="btn-tab-general">
              <span>📝</span> 1. Teklif Genel Bilgileri
            </button>
            <button type="button" class="tab-btn" onclick="switchTab('tab-items')" id="btn-tab-items">
              <span>📦</span> 2. Teklif Kalemleri (Ürünler)
            </button>
            <button type="button" class="tab-btn" onclick="switchTab('tab-totals')" id="btn-tab-totals">
              <span>💰</span> 3. Toplamlar & Onay
            </button>
          </div>

          <form action="/purchase/rfq/add" method="POST" id="rfqForm">

            <!-- TAB 1: GENEL BİLGİLER -->
            <div class="tab-pane active" id="tab-general">
              <div class="glass-form-card">
                <div class="section-title">
                  <span>📝</span> 1. Teklif Genel Bilgileri
                </div>

                <div class="form-grid-4">
                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Teklif No (Otomatik)</label>
                    <input type="text" name="rfqNo" value="<%= nextRfqNo %>" class="aesthetic-input" readonly>
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Tedarikçi Firma *</label>
                    <select name="supplierId" id="supplierSelect" class="aesthetic-input" required
                      style="cursor: pointer;">
                      <option value="">-- Tedarikçi Seçin --</option>
                      <% suppliers.forEach(sup=> { %>
                        <option value="<%= sup.id %>" data-name="<%= sup.companyName %>">
                          <%= sup.supplierCode %> — <%= sup.companyName %>
                        </option>
                        <% }); %>
                    </select>
                    <input type="hidden" name="supplierName" id="supplierNameInput" value="">
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Teklif Tarihi *</label>
                    <input type="date" name="rfqDate" value="<%= new Date().toISOString().split('T')[0] %>"
                      class="aesthetic-input" required>
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Geçerlilik Tarihi</label>
                    <input type="date" name="validUntil" class="aesthetic-input">
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Para Birimi *</label>
                    <select name="currency" id="currencySelect" class="aesthetic-input" required
                      style="cursor: pointer;">
                      <option value="TRY">TRY (₺)</option>
                      <option value="USD">USD ($)</option>
                      <option value="EUR">EUR (€)</option>
                    </select>
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Ödeme Koşulu *</label>
                    <select name="paymentTerm" class="aesthetic-input" required style="cursor: pointer;">
                      <option value="Pesin">Peşin Ödeme</option>
                      <option value="Vadeli_30" selected>30 Gün Vadeli</option>
                      <option value="Vadeli_60">60 Gün Vadeli</option>
                      <option value="Vadeli_90">90 Gün Vadeli</option>
                      <option value="Kredi_Karti">Kredi Kartı</option>
                    </select>
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Teslimat Süresi (Gün)</label>
                    <input type="number" name="deliveryDays" value="5" min="1" class="aesthetic-input"
                      placeholder="Örn: 5">
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Teslimat Yeri</label>
                    <input type="text" name="deliveryPlace" value="Merkez Depo / İstanbul" class="aesthetic-input"
                      placeholder="Örn: Ankara Depo / Raf-02">
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Nakliye Durumu</label>
                    <select name="shippingStatus" class="aesthetic-input" style="cursor: pointer;">
                      <option value="Tedarikçi Karşılar">Tedarikçi Karşılar (Ücretsiz)</option>
                      <option value="Alıcı Karşılar">Alıcı Karşılar (Nakliye Alıcıya Ait)</option>
                      <option value="Dahil">Fiyata Dahil</option>
                    </select>
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">KDV Durumu</label>
                    <select name="vatStatus" class="aesthetic-input" style="cursor: pointer;">
                      <option value="Hariç" selected>Fiyatlara KDV Hariçtir</option>
                      <option value="Dahil">Fiyatlara KDV Dahildir</option>
                    </select>
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Teklif Durumu</label>
                    <select name="status" class="aesthetic-input" style="cursor: pointer;">
                      <option value="Received" selected>Teklif Alındı</option>
                      <option value="Draft">Taslak</option>
                      <option value="Sent">Gönderildi</option>
                    </select>
                  </div>

                  <div class="aesthetic-group">
                    <label class="aesthetic-label">Teklif Belgesi Ref / No</label>
                    <input type="text" name="documentRef" class="aesthetic-input"
                      placeholder="Örn: PDF-TEKLIF-2026-04.pdf">
                  </div>
                </div>

                <div class="aesthetic-group" style="margin-top: 6px;">
                  <label class="aesthetic-label">Teklif Açıklaması / Özel Şartlar</label>
                  <input type="text" name="notes" class="aesthetic-input"
                    placeholder="Örn: TSE sertifikalı ürün teklifidir. 30 gün geçerlidir.">
                </div>

                <div class="tab-footer-nav">
                  <div></div>
                  <button type="button" class="btn"
                    style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; font-weight: 700; padding: 10px 24px; border-radius: 10px; border: none; cursor: pointer;"
                    onclick="switchTab('tab-items')">
                    İleri: Teklif Kalemleri →
                  </button>
                </div>
              </div>
            </div>

            <!-- TAB 2: KALEMLER -->
            <div class="tab-pane" id="tab-items">
              <div class="glass-form-card">
                <div
                  style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 10px;">
                  <div class="section-title" style="margin-bottom: 0; border: none; padding: 0;">
                    <span>📦</span> 2. Teklif Kalemleri (Talep Edilen Ürünler)
                  </div>
                  <button type="button" class="btn btn-sm" id="addRowBtn"
                    style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; font-weight: 700; border: none; padding: 8px 16px; border-radius: 8px;">
                    ➕ Kalem Ekle
                  </button>
                </div>

                <div
                  style="background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.25); color: #818cf8; padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-size: 0.85rem; font-weight: 500;">
                  🔒 <strong>Kural Uyarısı:</strong> Ürünler talep oluşturulmuş ürünler arasından seçilebilir. Sipariş
                  adedi default olarak o ürünün minimum stok seviyesi gelir ve <strong>altına inilemez</strong>!
                </div>

                <div class="table-wrapper">
                  <table class="data-table" id="itemsTable">
                    <thead>
                      <tr>
                        <th style="width: 25%;">Ürün (Talep Oluşturulmuş) *</th>
                        <th style="width: 12%;">Talep Ref</th>
                        <th style="width: 12%;">Miktar *</th>
                        <th style="width: 8%;">Birim</th>
                        <th style="width: 11%;">Birim Fiyat *</th>
                        <th style="width: 8%;">İskonto %</th>
                        <th style="width: 8%;">KDV %</th>
                        <th style="width: 12%;">Net Tutar</th>
                        <th style="width: 4%;"></th>
                      </tr>
                    </thead>
                    <tbody id="itemsTableBody">
                      <!-- Lines injected dynamically by JavaScript -->
                    </tbody>
                  </table>
                </div>

                <div class="tab-footer-nav">
                  <button type="button" class="btn btn-secondary" onclick="switchTab('tab-general')">
                    ← Geri: Genel Bilgiler
                  </button>
                  <button type="button" class="btn"
                    style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: #fff; font-weight: 700; padding: 10px 24px; border-radius: 10px; border: none; cursor: pointer;"
                    onclick="switchTab('tab-totals')">
                    İleri: Toplamlar & Onay →
                  </button>
                </div>
              </div>
            </div>

            <!-- TAB 3: TOPLAMLAR -->
            <div class="tab-pane" id="tab-totals">
              <div class="glass-form-card">
                <div class="section-title">
                  <span>💰</span> 3. Teklif Toplamları & Onay
                </div>

                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
                  <div>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6;">
                      Girilen teklif kalemleri ve genel bilgiler kontrol edildi.<br>
                      Aynı satın alma talebi için farklı tedarikçilerden <strong>istediğiniz kadar teklif
                        ekleyebilirsiniz</strong>.<br>
                      Hesaplanan tutarlar seçtiğiniz para birimi cinsinden gösterilmektedir.
                    </p>
                  </div>

                  <div
                    style="background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border); border-radius: 14px; padding: 18px;">
                    <div
                      style="display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 8px;">
                      <span>Ara Toplam:</span>
                      <strong id="displaySubtotal">0.00 TL</strong>
                    </div>
                    <div
                      style="display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--rose); margin-bottom: 8px;">
                      <span>Toplam İskonto (-):</span>
                      <strong id="displayDiscount">0.00 TL</strong>
                    </div>
                    <div
                      style="display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--amber); margin-bottom: 12px;">
                      <span>Toplam KDV (+):</span>
                      <strong id="displayTax">0.00 TL</strong>
                    </div>
                    <div
                      style="display: flex; justify-content: space-between; font-size: 1.15rem; color: var(--emerald); font-weight: 800; border-top: 1.5px solid var(--border); padding-top: 12px;">
                      <span>Genel Toplam:</span>
                      <strong id="displayGrandTotal">0.00 TL</strong>
                    </div>
                  </div>
                </div>

                <!-- Hidden Summary Inputs -->
                <input type="hidden" name="subtotal" id="inputSubtotal" value="0">
                <input type="hidden" name="totalDiscount" id="inputTotalDiscount" value="0">
                <input type="hidden" name="totalTax" id="inputTotalTax" value="0">
                <input type="hidden" name="offeredTotalPrice" id="inputGrandTotal" value="0">

                <div class="tab-footer-nav" style="margin-top: 32px;">
                  <button type="button" class="btn btn-secondary" onclick="switchTab('tab-items')">
                    ← Geri: Teklif Kalemleri
                  </button>
                  <button type="submit" class="btn"
                    style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; font-size: 1rem; font-weight: 800; padding: 14px 36px; border-radius: 12px; border: none; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4); cursor: pointer;">
                    💾 Teklifi Sisteme Kaydet
                  </button>
                </div>
              </div>
            </div>
          </form>
    </main>
  </div>

  <!-- Requisitioned Products Data embedded for JS -->
  <script>
    const REQUISITIONED_PRODUCTS = <%- JSON.stringify(requisitionedProducts) %>;
    const TARGET_REQ_ID = <%= targetReqId ? targetReqId : 'null' %>;

    function switchTab(tabId) {
      document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

      const targetPane = document.getElementById(tabId);
      const targetBtn = document.getElementById('btn-' + tabId);

      if (targetPane) targetPane.classList.add('active');
      if (targetBtn) targetBtn.classList.add('active');
    }

    const supplierSelect = document.getElementById('supplierSelect');
    const supplierNameInput = document.getElementById('supplierNameInput');
    const currencySelect = document.getElementById('currencySelect');
    const itemsTableBody = document.getElementById('itemsTableBody');
    const addRowBtn = document.getElementById('addRowBtn');

    if (supplierSelect) {
      supplierSelect.addEventListener('change', function () {
        const opt = this.options[this.selectedIndex];
        supplierNameInput.value = opt ? (opt.getAttribute('data-name') || '') : '';
      });
    }

    let rowCount = 0;

    function addRow(preselectedStockItemId = null) {
      rowCount++;
      const tr = document.createElement('tr');
      tr.id = `row-${rowCount}`;

      let productOptions = '<option value="">-- Talep Edilen Ürün Seçin --</option>';
      REQUISITIONED_PRODUCTS.forEach(p => {
        const isSel = (preselectedStockItemId && parseInt(preselectedStockItemId, 10) === parseInt(p.stockItemId, 10)) ? 'selected' : '';
        productOptions += `<option value="${p.stockItemId}" data-stockcode="${p.stockCode}" data-name="${p.name}" data-unit="${p.unit}" data-minstock="${p.minStock}" data-price="${p.purchasePrice}" data-reqno="${p.requisitionNo}" ${isSel}>${p.stockCode} — ${p.name} (Min: ${p.minStock} ${p.unit})</option>`;
      });

      tr.innerHTML = `
        <td>
          <select name="itemStockItemId" class="aesthetic-input item-stock-select" onchange="onProductSelect(this, ${rowCount})" required style="font-size: 0.85rem;">
            ${productOptions}
          </select>
          <input type="hidden" name="itemStockCode" id="itemStockCode-${rowCount}" value="">
          <input type="hidden" name="itemProductName" id="itemProductName-${rowCount}" value="">
        </td>
        <td>
          <input type="text" name="itemRequisitionNo" id="itemRequisitionNo-${rowCount}" class="aesthetic-input" readonly style="font-size: 0.8rem; font-family: 'JetBrains Mono', monospace;">
        </td>
        <td>
          <input type="number" name="itemQuantity" id="itemQuantity-${rowCount}" class="aesthetic-input item-qty" oninput="validateMinStock(this, ${rowCount})" onchange="validateMinStock(this, ${rowCount})" required step="0.01" style="font-weight: 800; color: var(--emerald);">
          <div class="min-stock-warning" id="minWarn-${rowCount}">🔒 Min: <span id="minVal-${rowCount}">0</span></div>
        </td>
        <td>
          <input type="text" name="itemUnit" id="itemUnit-${rowCount}" class="aesthetic-input" readonly style="font-size: 0.8rem;">
        </td>
        <td>
          <input type="number" name="itemUnitPrice" id="itemUnitPrice-${rowCount}" class="aesthetic-input item-price" oninput="calculateTotals()" required step="0.01" value="0.00">
        </td>
        <td>
          <input type="number" name="itemDiscountRate" id="itemDiscountRate-${rowCount}" class="aesthetic-input item-disc" oninput="calculateTotals()" min="0" max="100" step="0.01" value="0">
        </td>
        <td>
          <select name="itemVatRate" id="itemVatRate-${rowCount}" class="aesthetic-input item-vat" onchange="calculateTotals()">
            <option value="20" selected>%20</option>
            <option value="10">%10</option>
            <option value="1">%1</option>
            <option value="0">%0</option>
          </select>
        </td>
        <td>
          <input type="text" name="itemNetAmount" id="itemNetAmount-${rowCount}" class="aesthetic-input item-net" readonly style="font-weight: 800; color: var(--emerald); font-family: 'JetBrains Mono', monospace;">
        </td>
        <td style="text-align: center;">
          ${rowCount === 1
          ? `<span title="Ana talep ürünü tekliften çıkarılamaz" style="color: #64748b; font-size: 1.1rem; cursor: not-allowed;" aria-label="Kilitli">🔒</span>`
          : `<button type="button" onclick="removeRow(${rowCount})" style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1px solid rgba(244,63,94,0.3); border-radius: 6px; padding: 6px 10px; cursor: pointer; font-weight: 800;">✕</button>`}
        </td>
      `;

      itemsTableBody.appendChild(tr);

      // Trigger change if preselected
      const selectEl = tr.querySelector('.item-stock-select');
      if (selectEl && selectEl.value) {
        onProductSelect(selectEl, rowCount);
      }
    }

    function onProductSelect(selectEl, rId) {
      const opt = selectEl.options[selectEl.selectedIndex];
      if (!opt || !opt.value) return;

      const minStock = parseFloat(opt.getAttribute('data-minstock')) || 10;
      const unit = opt.getAttribute('data-unit') || 'Adet';
      const price = parseFloat(opt.getAttribute('data-price')) || 0;
      const reqNo = opt.getAttribute('data-reqno') || '—';
      const code = opt.getAttribute('data-stockcode') || '';
      const pName = opt.getAttribute('data-name') || '';

      document.getElementById(`itemStockCode-${rId}`).value = code;
      document.getElementById(`itemProductName-${rId}`).value = pName;
      document.getElementById(`itemRequisitionNo-${rId}`).value = reqNo;
      document.getElementById(`itemUnit-${rId}`).value = unit;
      document.getElementById(`minVal-${rId}`).textContent = `${minStock} ${unit}`;

      const qtyInput = document.getElementById(`itemQuantity-${rId}`);
      qtyInput.setAttribute('data-minstock', minStock);
      qtyInput.setAttribute('min', minStock);
      qtyInput.value = minStock;

      const priceInput = document.getElementById(`itemUnitPrice-${rId}`);
      if (parseFloat(priceInput.value) === 0 && price > 0) {
        priceInput.value = price.toFixed(2);
      }

      calculateTotals();
    }

    function validateMinStock(inputEl, rId) {
      const minStock = parseFloat(inputEl.getAttribute('data-minstock')) || 0;
      let val = parseFloat(inputEl.value);

      if (isNaN(val) || val < minStock) {
        alert(`⚠️ UYARI: Bu ürünün minimum stok miktarı ${minStock} birimdir. Sipariş miktarı bu değerin altına düşürülemez!`);
        inputEl.value = minStock;
      }
      calculateTotals();
    }

    function removeRow(rId) {
      const tr = document.getElementById(`row-${rId}`);
      if (tr) {
        tr.remove();
        calculateTotals();
      }
    }

    function calculateTotals() {
      let subtotal = 0;
      let totalDiscount = 0;
      let totalTax = 0;

      const rows = itemsTableBody.querySelectorAll('tr');
      rows.forEach(tr => {
        const qtyEl = tr.querySelector('.item-qty');
        const priceEl = tr.querySelector('.item-price');
        const discEl = tr.querySelector('.item-disc');
        const vatEl = tr.querySelector('.item-vat');
        const netEl = tr.querySelector('.item-net');

        if (qtyEl && priceEl && netEl) {
          const qty = parseFloat(qtyEl.value) || 0;
          const price = parseFloat(priceEl.value) || 0;
          const discRate = parseFloat(discEl ? discEl.value : 0) || 0;
          const vatRate = parseFloat(vatEl ? vatEl.value : 20) || 0;

          const rawTotal = qty * price;
          const discAmt = rawTotal * (discRate / 100);
          const afterDisc = rawTotal - discAmt;
          const taxAmt = afterDisc * (vatRate / 100);
          const net = afterDisc + taxAmt;

          netEl.value = net.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

          subtotal += rawTotal;
          totalDiscount += discAmt;
          totalTax += taxAmt;
        }
      });

      const grandTotal = subtotal - totalDiscount + totalTax;
      const curr = currencySelect ? currencySelect.value : 'TRY';
      const currSymbol = curr === 'USD' ? '$' : (curr === 'EUR' ? '€' : 'TL');

      document.getElementById('displaySubtotal').textContent = `${subtotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${currSymbol}`;
      document.getElementById('displayDiscount').textContent = `${totalDiscount.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${currSymbol}`;
      document.getElementById('displayTax').textContent = `${totalTax.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${currSymbol}`;
      document.getElementById('displayGrandTotal').textContent = `${grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${currSymbol}`;

      document.getElementById('inputSubtotal').value = subtotal.toFixed(4);
      document.getElementById('inputTotalDiscount').value = totalDiscount.toFixed(4);
      document.getElementById('inputTotalTax').value = totalTax.toFixed(4);
      document.getElementById('inputGrandTotal').value = grandTotal.toFixed(4);
    }

    addRowBtn.addEventListener('click', () => addRow());

    // Initialize first row
    let defaultStockItemId = null;
    if (TARGET_REQ_ID) {
      const target = REQUISITIONED_PRODUCTS.find(p => parseInt(p.requisitionId, 10) === parseInt(TARGET_REQ_ID, 10));
      if (target) defaultStockItemId = target.stockItemId;
    }
    if (!defaultStockItemId && REQUISITIONED_PRODUCTS.length > 0) {
      defaultStockItemId = REQUISITIONED_PRODUCTS[0].stockItemId;
    }

    addRow(defaultStockItemId);

    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>

</html>