<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Teklif Kaydı (RFQ) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand"><a href="/" class="msb-logo"><svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg><span>Enterprise ERP</span></a></div>
    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/purchase/analytics" class="mss-sub-link">📊 Satın Alma Analitiği</a>
        <a href="/purchase/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIN ALMA OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/purchase/requisitions" class="mss-sub-link">📩 Satın Alma Talepleri</a>
        <a href="/purchase/rfq" class="mss-sub-link active">📨 Teklif Yönetimi (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
        <a href="/purchase/goods-receipt" class="mss-sub-link">🚛 Mal Kabul (GRN)</a>
      </div>
      <div class="mss-group-title">🏭 TEDARİKÇİ YÖNETİMİ</div>
      <div class="mss-sub"><a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a></div>
    </div>
    <div class="module-sidebar-user"><div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div><div class="msu-meta"><strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong><span><%= user.role %></span></div></div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a><a href="/sales" class="mt-link">Satış Yönetimi</a><a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %>
      </div>
      <div class="mt-right"><span class="mt-time" id="liveTime"></span><a href="/logout" class="mt-logout" title="Çıkış"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></a></div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/purchase/analytics" class="msn-link">📊 Analitik</a><a href="/purchase/approvals" class="msn-link">⚡ Onaylar</a>
        <a href="/purchase/requisitions" class="msn-link">📩 Talepler</a><a href="/purchase/rfq" class="msn-link active">📨 RFQ</a>
        <a href="/purchase/orders" class="msn-link">📦 Siparişler</a><a href="/purchase/goods-receipt" class="msn-link">🚛 Mal Kabul</a>
        <a href="/purchase/suppliers" class="msn-link">🏢 Tedarikçiler</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Yeni Teklif Kaydı (RFQ)</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tedarikçiden alınan fiyat, teslim süresi ve vadelendirme teklifini sisteme girin.</p>
        </div>
        <a href="/purchase/rfq" class="btn btn-secondary">← RFQ Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div style="background: var(--rose-soft); color: var(--rose); border: 1px solid var(--rose); padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; font-weight: 600;">⚠️ <%= error %></div>
      <% } %>

      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; box-shadow: var(--shadow-md);">
        <form action="/purchase/rfq/add" method="POST">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label">RFQ No</label>
              <input type="text" name="rfqNo" value="<%= nextRfqNo %>" class="form-control" readonly>
            </div>
            <div class="form-group">
              <label class="form-label">Tedarikçi Seçin *</label>
              <select name="supplierId" id="supplierSelect" class="form-control" onchange="updateSupplierName(this)">
                <option value="">— Kayıtlı Tedarikçi Seçin —</option>
                <% suppliers.forEach(sup => { %>
                  <option value="<%= sup.id %>" data-name="<%= sup.companyName %>"><%= sup.supplierCode %> — <%= sup.companyName %></option>
                <% }); %>
              </select>
              <input type="hidden" name="supplierName" id="supplierNameInput">
            </div>
            <div class="form-group">
              <label class="form-label">Teklif İstenecek / Alınacak Malzeme *</label>
              <select name="stockItemId" class="form-control" required>
                <option value="">— Stok Kartı Seçin —</option>
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>"><%= item.stockCode %> — <%= item.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Talep Edilen Miktar *</label>
              <input type="number" name="requestedQuantity" value="100" min="1" step="0.01" class="form-control" required>
            </div>
            <div class="form-group">
              <label class="form-label">Tedarikçinin Birim Fiyat Teklifi (TL)</label>
              <input type="number" name="offeredUnitPrice" value="0.00" min="0" step="0.01" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Para Birimi</label>
              <select name="currency" class="form-control">
                <option value="TRY">TRY (₺)</option>
                <option value="USD">USD ($)</option>
                <option value="EUR">EUR (€)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Teklif Edilen Teslim Süresi (Gün)</label>
              <input type="number" name="deliveryDays" value="7" min="1" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Ödeme Koşulu</label>
              <select name="paymentTerm" class="form-control">
                <option value="Vadeli_30">30 Gün Vadeli</option>
                <option value="Vadeli_60">60 Gün Vadeli</option>
                <option value="Vadeli_90">90 Gün Vadeli</option>
                <option value="Pesin">Peşin Ödeme</option>
                <option value="Kredi_Karti">Kredi Kartı</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Geçerlilik Tarihi</label>
              <input type="date" name="validUntil" class="form-control">
            </div>
            <div class="form-group">
              <label class="form-label">Teklif Durumu</label>
              <select name="status" class="form-control">
                <option value="Received">Teklif Alındı (Değerlendirmede)</option>
                <option value="Sent">Teklif İstendi (Beklemede)</option>
                <option value="Draft">Taslak</option>
              </select>
            </div>
          </div>
          <div class="form-group" style="margin-top: 16px;">
            <label class="form-label">Kalite / Şartname Notları</label>
            <textarea name="qualityNote" class="form-control" rows="2" placeholder="Garanti süresi, sertifikasyon, özel paketleme notları..."></textarea>
          </div>
          <div style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="submit" class="btn">📨 Teklifi Kaydet</button>
            <a href="/purchase/rfq" class="btn btn-secondary">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);

    function updateSupplierName(select) {
      const opt = select.options[select.selectedIndex];
      document.getElementById('supplierNameInput').value = opt.getAttribute('data-name') || '';
    }
  </script>
</body>
</html>
