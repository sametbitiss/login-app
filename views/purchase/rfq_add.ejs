<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Talebe Teklif Ekle — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* Hero Banner */
    .rfq-hero {
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.9) 100%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      padding: 24px 30px;
      margin-bottom: 24px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
      overflow: hidden;
    }
    .rfq-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 50%, #10b981 100%);
    }
    .rfq-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.35);
      color: #818cf8;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 20px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .rfq-hero-title {
      font-size: 1.5rem;
      font-weight: 900;
      color: #f8fafc;
      margin: 0;
      letter-spacing: -0.4px;
    }
    .rfq-hero-desc {
      color: #94a3b8;
      font-size: 0.88rem;
      margin-top: 4px;
    }

    /* Tabs Navigation */
    .tab-nav {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(16px);
      border: 1.5px solid rgba(255, 255, 255, 0.1);
      padding: 6px;
      border-radius: 16px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    }
    .tab-btn {
      flex: 1;
      background: transparent;
      border: none;
      color: #94a3b8;
      font-size: 0.9rem;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .tab-btn:hover {
      color: #f8fafc;
      background: rgba(255, 255, 255, 0.06);
    }
    .tab-btn.active {
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
      color: #ffffff;
      font-weight: 800;
      box-shadow: 0 8px 24px rgba(99, 102, 241, 0.45);
      transform: translateY(-1px);
    }
    .tab-pane {
      display: none;
      animation: fadeIn 0.3s ease;
    }
    .tab-pane.active {
      display: block;
    }

    /* Form Cards */
    .glass-form-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
      margin-bottom: 24px;
    }
    .section-title {
      font-size: 1.1rem;
      font-weight: 800;
      color: #f8fafc;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 12px;
    }
    .section-title-icon {
      font-size: 1.25rem;
    }

    /* Input Aesthetics */
    .aesthetic-group {
      margin-bottom: 20px;
    }
    .aesthetic-label {
      font-size: 0.84rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .aesthetic-input {
      width: 100%;
      background: #0f172a;
      border: 1.5px solid #1e293b;
      color: #f8fafc;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      padding: 12px 16px;
      border-radius: 12px;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }
    .aesthetic-input:focus {
      outline: none;
      border-color: #6366f1;
      background: #090e1a;
      box-shadow: 0 0 16px rgba(99, 102, 241, 0.35);
    }
    .aesthetic-input[readonly] {
      background: #090d16;
      border-color: #334155;
      color: #94a3b8;
      cursor: not-allowed;
    }
    .aesthetic-input.readonly-highlight {
      color: #818cf8;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
    }

    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .form-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .form-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

    /* Items Table */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    .items-table th {
      background: rgba(15, 23, 42, 0.9);
      color: #94a3b8;
      font-weight: 800;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 12px 14px;
      border-bottom: 2px solid #334155;
    }
    .items-table td {
      padding: 12px 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      vertical-align: middle;
    }
    .items-table tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }

    .table-input {
      width: 100%;
      background: #090e1a;
      border: 1px solid #334155;
      color: #f8fafc;
      font-size: 0.88rem;
      padding: 8px 10px;
      border-radius: 8px;
      font-family: 'JetBrains Mono', monospace;
      box-sizing: border-box;
      transition: all 0.2s;
    }
    .table-input:focus {
      outline: none;
      border-color: #6366f1;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.4);
    }
    .table-input[readonly] {
      background: rgba(15, 23, 42, 0.5);
      border-color: rgba(255, 255, 255, 0.08);
      color: #94a3b8;
      cursor: not-allowed;
    }
    .table-input.input-invalid {
      border-color: #ef4444 !important;
      background: rgba(239, 68, 68, 0.15) !important;
      color: #fca5a5 !important;
    }

    /* Modal Overlay & Card */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(10px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      animation: fadeIn 0.2s ease;
    }
    .modal-card {
      background: #0f172a;
      border: 1.5px solid #334155;
      border-radius: 20px;
      width: 94%;
      max-width: 980px;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.75);
      overflow: hidden;
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 22px 28px 16px 28px;
      border-bottom: 1px solid #1e293b;
    }
    .modal-close-btn {
      background: #1e293b;
      border: 1px solid #334155;
      color: #94a3b8;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      font-size: 1.1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .modal-close-btn:hover {
      color: #fff;
      background: #ef4444;
      border-color: #ef4444;
    }
    .modal-search-wrap {
      padding: 16px 28px 12px 28px;
      display: flex;
      gap: 12px;
    }
    .modal-body-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 10px 28px 20px 28px;
    }
    .modal-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 28px;
      border-top: 1px solid #1e293b;
      background: #090e1a;
    }

    /* Financial Summary Card */
    .summary-card {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
      border: 1.5px solid rgba(255, 255, 255, 0.12);
      border-radius: 18px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 0.95rem;
      color: #cbd5e1;
    }
    .summary-row.total-row {
      border-top: 2px solid #6366f1;
      border-bottom: none;
      margin-top: 10px;
      padding-top: 14px;
      font-size: 1.25rem;
      font-weight: 900;
      color: #ffffff;
    }

    /* Navigation Buttons */
    .tab-footer-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .btn-nav-secondary {
      background: #1e293b;
      color: #94a3b8;
      border: 1px solid #334155;
      padding: 12px 24px;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-nav-secondary:hover {
      color: #fff;
      background: #334155;
    }
    .btn-submit-glow {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      font-weight: 800;
      font-size: 1rem;
      padding: 14px 34px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      box-shadow: 0 6px 25px rgba(16, 185, 129, 0.45);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .btn-submit-glow:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(16, 185, 129, 0.6);
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>

<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛒 SATIN ALMA YÖNETİMİ</div>
      <div class="mss-group-title">📊 DASHBOARD & TALEP</div>
      <div class="mss-sub">
        <a href="/purchase" class="mss-sub-link">📊 Satın Alma Paneli</a>
        <a href="/purchase/requisitions" class="mss-sub-link">📋 Satın Alma Talepleri</a>
      </div>

      <div class="mss-group-title">📑 TEKLİF & SİPARİŞ</div>
      <div class="mss-sub">
        <a href="/purchase/rfq" class="mss-sub-link active">📨 Teklif Talepleri (RFQ)</a>
        <a href="/purchase/orders" class="mss-sub-link">📦 Satın Alma Siparişleri</a>
      </div>

      <div class="mss-group-title">🏢 TEDARİKÇİ İLİŞKİLERİ</div>
      <div class="mss-sub">
        <a href="/purchase/suppliers" class="mss-sub-link">🏢 Tedarikçi Kartları</a>
        <a href="/purchase/analytics" class="mss-sub-link">📈 Harcama & Performans</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link active">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><% } %>
        <% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <!-- Hero Header -->
      <div class="rfq-hero">
        <div>
          <div class="rfq-hero-badge">✨ SATIN ALMA TEKLİF YÖNETİMİ</div>
          <h1 class="rfq-hero-title">Satın Alma Talebine Teklif Ekle</h1>
          <p class="rfq-hero-desc">Tedarikçi teklif detaylarını sekmeler üzerinden girin, aynı anda birden fazla talebi tek teklifte toplayın.</p>
        </div>
        <a href="/purchase/requisitions" class="btn btn-secondary" style="border-radius: 12px; font-weight: 700;">← Talepler Listesine Dön</a>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: rgba(244,63,94,0.15); color: #f43f5e; border: 1.5px solid rgba(244,63,94,0.3); padding: 16px 22px; border-radius: 16px; margin-bottom: 24px; font-weight: 700; display: flex; align-items: center; gap: 12px; box-shadow: 0 8px 24px rgba(244,63,94,0.2);">
          <span style="font-size: 1.2rem;">⚠️</span> <%= error %>
        </div>
      <% } %>

      <!-- TAB MENU BUTTONS -->
      <div class="tab-nav">
        <button type="button" class="tab-btn active" onclick="switchTab(1)" id="tabBtn-1">
          <span>📋</span> 1. Teklif & Tedarikçi Bilgileri
        </button>
        <button type="button" class="tab-btn" onclick="switchTab(2)" id="tabBtn-2">
          <span>📦</span> 2. Teklif Kalemleri (Ürünler)
        </button>
        <button type="button" class="tab-btn" onclick="switchTab(3)" id="tabBtn-3">
          <span>📑</span> 3. Teslimat, Ticari Şartlar & Özet
        </button>
      </div>

      <form action="/purchase/rfq/add" method="POST" id="rfqForm" onsubmit="return validateFormBeforeSubmit()">

        <!-- ==================== TAB 1: TEKLİF & TEDARİKÇİ BİLGİLERİ ==================== -->
        <div class="tab-pane active" id="tabPane-1">
          <div class="glass-form-card">
            <div class="section-title">
              <span class="section-title-icon">📋</span> 1. Teklif ve Tedarikçi Kimlik Bilgileri
            </div>

            <div class="form-grid-3">
              <!-- 1. Teklif Numarası -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>1. Teklif Numarası *</span>
                  <span style="color: #6366f1; font-size: 0.72rem;">🔒 OTOMATİK / READONLY</span>
                </label>
                <input type="text" name="rfqNo" value="<%= nextRfqNo %>" class="aesthetic-input readonly-highlight" readonly>
              </div>

              <!-- 2. Talep ID -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>2. İlgili Talep ID / Ref *</span>
                  <span style="color: #818cf8; font-size: 0.72rem;">🔒 REFERANS TALEP</span>
                </label>
                <input type="text" id="displayPrimaryReq" value="<%= primaryRequisition ? ('#' + primaryRequisition.id + ' — ' + primaryRequisition.talepNo) : 'Seçili Talep Yok' %>" class="aesthetic-input readonly-highlight" readonly>
                <input type="hidden" name="primaryRequisitionId" id="primaryRequisitionId" value="<%= primaryRequisition ? primaryRequisition.id : '' %>">
              </div>

              <!-- 19. Teklif Durumu -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>19. Teklif Durumu *</span>
                  <span style="color: #fbbf24; font-size: 0.72rem;">🔒 BAŞLANGIÇ DURUMU</span>
                </label>
                <input type="text" value="⏳ Beklemede (Teklif Alındı)" class="aesthetic-input" readonly style="color: #fbbf24; font-weight: 700;">
                <input type="hidden" name="status" value="Received">
              </div>
            </div>

            <div class="section-title" style="margin-top: 10px;">
              <span class="section-title-icon">🏢</span> Tedarikçi Firma Bilgileri
            </div>

            <div class="form-grid-3">
              <!-- 3. Tedarikçi Adı -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>3. Tedarikçi Firma *</span>
                  <span style="color: #34d399; font-size: 0.72rem;">🏢 SEÇİLEBİLİR</span>
                </label>
                <select name="supplierId" id="supplierSelect" class="aesthetic-input" onchange="onSupplierChange(this)" required style="cursor: pointer;">
                  <option value="">-- Tedarikçi Seçiniz --</option>
                  <% suppliers.forEach(sup => { %>
                    <% 
                      const isDefault = defaultSupplier && (defaultSupplier.id === sup.id);
                    %>
                    <option value="<%= sup.id %>" <%= isDefault ? 'selected' : '' %>>
                      [<%= sup.tedarikciKodu %>] <%= sup.ticariAd || sup.firmaAdi %>
                    </option>
                  <% }); %>
                </select>
                <input type="hidden" name="supplierName" id="inputSupplierName" value="<%= defaultSupplier ? (defaultSupplier.ticariAd || defaultSupplier.firmaAdi) : '' %>">
              </div>

              <!-- 4. Vergi Numarası & Dairesi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>4. Vergi Dairesi / No</span>
                  <span style="color: #94a3b8; font-size: 0.72rem;">OPSİYONEL</span>
                </label>
                <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 8px;">
                  <input type="text" name="taxOffice" id="inputTaxOffice" value="<%= defaultSupplier ? (defaultSupplier.vergiDairesi || '') : '' %>" placeholder="Vergi Dairesi" class="aesthetic-input">
                  <input type="text" name="taxNo" id="inputTaxNo" value="<%= defaultSupplier ? (defaultSupplier.vergiNo || '') : '' %>" placeholder="Vergi Numarası" class="aesthetic-input">
                </div>
              </div>

              <!-- 5. İlgili Satış Temsilcisi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>5. İlgili Satış Temsilcisi</span>
                  <span style="color: #94a3b8; font-size: 0.72rem;">OPSİYONEL</span>
                </label>
                <input type="text" name="contactPerson" id="inputContactPerson" value="<%= defaultSupplier ? (defaultSupplier.ilgiliKisi || '') : '' %>" placeholder="Örn: Ahmet Yılmaz (Satış Müdürü)" class="aesthetic-input">
              </div>
            </div>

            <div class="form-grid-3">
              <!-- Teklif Tarihi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">Teklif Alma Tarihi *</label>
                <input type="date" name="rfqDate" value="<%= new Date().toISOString().split('T')[0] %>" class="aesthetic-input" required>
              </div>

              <!-- 18. Teklifin Geçerlilik Tarihi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>18. Teklifin Geçerlilik Tarihi *</span>
                  <span style="color: #f43f5e; font-size: 0.72rem;">📅 ZORUNLU</span>
                </label>
                <% 
                  const defaultValidDate = new Date();
                  defaultValidDate.setDate(defaultValidDate.getDate() + 30);
                  const validDateStr = defaultValidDate.toISOString().split('T')[0];
                %>
                <input type="date" name="validUntil" value="<%= validDateStr %>" class="aesthetic-input" required>
              </div>

              <div class="aesthetic-group" style="display: flex; align-items: flex-end;">
                <div style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 12px; padding: 10px 16px; width: 100%; box-sizing: border-box;">
                  <div style="font-size: 0.78rem; color: #818cf8; font-weight: 700;">💡 BİLGİLENDİRME</div>
                  <div style="font-size: 0.8rem; color: #cbd5e1; margin-top: 2px;">Tedarikçi değiştirildiğinde vade, termin ve vergi bilgileri otomatik güncellenir.</div>
                </div>
              </div>
            </div>

            <div class="tab-footer-nav">
              <div></div>
              <button type="button" class="btn" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff; font-weight: 800; padding: 12px 28px; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);" onclick="switchTab(2)">
                İleri: Teklif Kalemleri →
              </button>
            </div>
          </div>
        </div>

        <!-- ==================== TAB 2: TEKLİF EDİLEN ÜRÜNLER (KALEMLER) ==================== -->
        <div class="tab-pane" id="tabPane-2">
          <div class="glass-form-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 14px;">
              <div>
                <div class="section-title" style="margin-bottom: 2px; border: none; padding: 0;">
                  <span class="section-title-icon">📦</span> 2. Teklif Kalemleri ve Fiyatlandırma Tablosu
                </div>
                <div style="font-size: 0.82rem; color: #94a3b8;">
                  Ana talep ürünü kilitlidir ve silinemez. Dilerseniz modal ile başka satın alma taleplerini de bu teklife ekleyebilirsiniz.
                </div>
              </div>

              <!-- ÜRÜN SEÇİM MODALI BUTONU -->
              <button type="button" onclick="openProductSelectModal()" class="btn" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff; font-weight: 800; border: none; padding: 11px 22px; border-radius: 12px; box-shadow: 0 4px 18px rgba(99, 102, 241, 0.45); cursor: pointer; display: flex; align-items: center; gap: 8px;">
                <span>➕</span> Satın Alma Talepli Ürün Ekle (Modal)
              </button>
            </div>

            <!-- TABLO -->
            <div style="overflow-x: auto; border: 1px solid #1e293b; border-radius: 14px; background: #090e1a;">
              <table class="items-table" id="itemsTable">
                <thead>
                  <tr>
                    <th style="width: 40px; text-align: center;">Durum</th>
                    <th style="min-width: 120px;">Talep No</th>
                    <th style="min-width: 200px;">6. Malzeme Kodu & Adı</th>
                    <th style="min-width: 100px;">7. Talep Miktarı</th>
                    <th style="min-width: 120px;">8. Teklif Miktarı *</th>
                    <th style="min-width: 70px;">9. Birim</th>
                    <th style="min-width: 110px;">10. Birim Fiyat *</th>
                    <th style="min-width: 90px;">12. İskonto %</th>
                    <th style="min-width: 90px;">13. KDV %</th>
                    <th style="min-width: 130px; text-align: right;">14. Net Tutar</th>
                    <th style="width: 50px; text-align: center;">İşlem</th>
                  </tr>
                </thead>
                <tbody id="itemsTableBody">
                  <!-- Rendered dynamically by JS -->
                </tbody>
              </table>
            </div>

            <div style="margin-top: 14px; display: flex; justify-content: space-between; align-items: center;">
              <div style="font-size: 0.82rem; color: #818cf8; font-weight: 600;">
                ⚠️ <strong>Kural:</strong> Teklif edilen miktar, satın alma talebindeki miktardan az veya eşit olabilir, <u>fazla olamaz</u>!
              </div>
              <div style="font-size: 0.9rem; color: #f8fafc; font-weight: 700;">
                Kalem Sayısı: <span id="itemCountBadge" style="color: #6366f1; font-family: 'JetBrains Mono', monospace;">0</span>
              </div>
            </div>

            <div class="tab-footer-nav">
              <button type="button" class="btn-nav-secondary" onclick="switchTab(1)">← Önceki Adım</button>
              <button type="button" class="btn" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: #fff; font-weight: 800; padding: 12px 28px; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);" onclick="switchTab(3)">
                İleri: Ticari Şartlar & Özet →
              </button>
            </div>
          </div>
        </div>

        <!-- ==================== TAB 3: TESLİMAT, TİCARİ ŞARTLAR & ÖZET ==================== -->
        <div class="tab-pane" id="tabPane-3">
          <div class="glass-form-card">
            <div class="section-title">
              <span class="section-title-icon">📑</span> 3. Teslimat, Ticari Şartlar ve Finansal Özet
            </div>

            <div class="form-grid-3">
              <!-- 11. Para Birimi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>11. Para Birimi *</span>
                  <span style="color: #fbbf24; font-size: 0.72rem;">DÖVİZ CİNSİ</span>
                </label>
                <select name="currency" id="currencySelect" class="aesthetic-input" onchange="onCurrencyChange()" style="cursor: pointer;">
                  <option value="TRY" <%= defaultSupplier && defaultSupplier.paraBirimi === 'TRY' ? 'selected' : '' %>>TRY (₺ — Türk Lirası)</option>
                  <option value="USD" <%= defaultSupplier && defaultSupplier.paraBirimi === 'USD' ? 'selected' : '' %>>USD ($ — ABD Doları)</option>
                  <option value="EUR" <%= defaultSupplier && defaultSupplier.paraBirimi === 'EUR' ? 'selected' : '' %>>EUR (€ — Euro)</option>
                </select>
              </div>

              <!-- 13. KDV Durumu -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>13. KDV Dahil / Hariç Durumu *</span>
                  <span style="color: #34d399; font-size: 0.72rem;">ZORUNLU</span>
                </label>
                <select name="vatStatus" id="vatStatusSelect" class="aesthetic-input" onchange="recalcAllTotals()" style="cursor: pointer;">
                  <option value="Hariç" selected>Fiyatlara KDV Hariçtir (+ KDV Eklenecek)</option>
                  <option value="Dahil">Fiyatlara KDV Dahildir (İç KDV)</option>
                </select>
              </div>

              <!-- 15. Teslim Süresi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>15. Teslim Süresi (Termin / Gün) *</span>
                  <span style="color: #818cf8; font-size: 0.72rem;">⏱️ ZORUNLU</span>
                </label>
                <input type="number" name="deliveryDays" id="inputDeliveryDays" value="<%= defaultSupplier ? (defaultSupplier.terminSuresi || 5) : 5 %>" min="1" class="aesthetic-input" required>
              </div>
            </div>

            <div class="form-grid-2">
              <!-- 16. Malların Teslim Yeri (Depo) -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>16. Malların Teslim Yeri (Hedef Depo) *</span>
                  <span style="color: #6366f1; font-size: 0.72rem;">🔒 OTOMATİK / READONLY</span>
                </label>
                <input type="text" name="deliveryPlace" id="inputDeliveryPlace" value="<%= defaultDeliveryPlace %>" class="aesthetic-input readonly-highlight" readonly>
              </div>

              <!-- 17. Ödeme Tipi / Vadesi -->
              <div class="aesthetic-group">
                <label class="aesthetic-label">
                  <span>17. Ödeme Tipi / Vadesi *</span>
                  <span style="color: #38bdf8; font-size: 0.72rem;">ZORUNLU</span>
                </label>
                <select name="paymentTerm" id="paymentTermSelect" class="aesthetic-input" required style="cursor: pointer;">
                  <option value="Pesin" <%= defaultSupplier && defaultSupplier.odemeVadesi === 'Pesin' ? 'selected' : '' %>>Peşin Ödeme</option>
                  <option value="Vadeli_30" <%= defaultSupplier && defaultSupplier.odemeVadesi === 'Vadeli_30' ? 'selected' : (!defaultSupplier ? 'selected' : '') %>>30 Gün Vadeli</option>
                  <option value="Vadeli_60" <%= defaultSupplier && defaultSupplier.odemeVadesi === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
                  <option value="Vadeli_90" <%= defaultSupplier && defaultSupplier.odemeVadesi === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
                  <option value="Kredi_Karti" <%= defaultSupplier && defaultSupplier.odemeVadesi === 'Kredi_Karti' ? 'selected' : '' %>>Kredi Kartı ile Ödeme</option>
                </select>
              </div>
            </div>

            <!-- 20. Teklif Notu / Açıklama -->
            <div class="aesthetic-group">
              <label class="aesthetic-label">
                <span>20. Teklif Notu / Özel Açıklamalar</span>
                <span style="color: #94a3b8; font-size: 0.72rem;">OPSİYONEL</span>
              </label>
              <textarea name="notes" rows="3" class="aesthetic-input" placeholder="Tedarikçi özel şartları, nakliye detayları, garanti koşulları veya diğer açıklamalar..."></textarea>
            </div>

            <!-- FİNANSAL ÖZET KARTI -->
            <div class="summary-card" style="margin-top: 24px;">
              <div style="font-size: 1.05rem; font-weight: 800; color: #f8fafc; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span>💰</span> Teklif Genel Finansal Özeti
              </div>

              <div class="summary-row">
                <span>Ara Toplam (Kalem Toplamları):</span>
                <strong id="summarySubtotal" style="font-family: 'JetBrains Mono', monospace;">0.00 TRY</strong>
              </div>
              <div class="summary-row">
                <span>Toplam İskonto / İndirim:</span>
                <strong id="summaryDiscount" style="color: #fb7185; font-family: 'JetBrains Mono', monospace;">-0.00 TRY</strong>
              </div>
              <div class="summary-row">
                <span>Toplam KDV Tutarı:</span>
                <strong id="summaryVat" style="color: #818cf8; font-family: 'JetBrains Mono', monospace;">+0.00 TRY</strong>
              </div>
              <div class="summary-row total-row">
                <span>GENEL TOPLAM TUTAR:</span>
                <strong id="summaryGrandTotal" style="color: #34d399; font-family: 'JetBrains Mono', monospace;">0.00 TRY</strong>
              </div>
            </div>

            <div class="tab-footer-nav">
              <button type="button" class="btn-nav-secondary" onclick="switchTab(2)">← Önceki Adım</button>
              <button type="submit" class="btn-submit-glow">
                <span>📨</span> Teklifi Kaydet ve Sisteme Ekle
              </button>
            </div>
          </div>
        </div>

      </form>

      <!-- ==================== SATIN ALMA TALEPLİ ÜRÜN SEÇİM MODALI ==================== -->
      <div id="productSelectModal" class="modal-overlay" style="display: none;">
        <div class="modal-card">
          <!-- Modal Header -->
          <div class="modal-header">
            <div>
              <h2 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; display: flex; align-items: center; gap: 8px;">
                <span>📦</span> Satın Alma Talebi Bulunan Ürünleri Seç
              </h2>
              <p style="color: #94a3b8; font-size: 0.85rem; margin-top: 4px;">
                Sadece sistemde aktif satın alma talebi açılmış olan ürünler listelenmektedir. Teklife eklemek istediğiniz talepleri işaretleyin.
              </p>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeProductSelectModal()">✕</button>
          </div>

          <!-- Modal Search & Filter -->
          <div class="modal-search-wrap">
            <input type="text" id="modalSearchInput" class="aesthetic-input" placeholder="🔍 Talep no, malzeme kodu, ürün adı veya depoya göre ara..." oninput="filterModalRequisitions(this.value)">
            <select id="modalSortSelect" class="aesthetic-input" style="max-width: 220px; cursor: pointer;" onchange="sortModalRequisitions(this.value)">
              <option value="date_desc">Tarihe Göre (En Yeni)</option>
              <option value="name_asc">Ürün Adına Göre (A-Z)</option>
              <option value="qty_desc">Talep Miktarına Göre (Azalan)</option>
            </select>
          </div>

          <!-- Modal Table -->
          <div class="modal-body-scroll">
            <div style="overflow-x: auto; border: 1px solid #1e293b; border-radius: 12px; background: #090e1a;">
              <table class="items-table" id="modalRequisitionsTable">
                <thead>
                  <tr>
                    <th style="width: 40px; text-align: center;">
                      <input type="checkbox" id="modalSelectAllChk" onchange="toggleSelectAllModal(this)" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;">
                    </th>
                    <th>Talep No</th>
                    <th>Malzeme Kodu & Adı</th>
                    <th>Kategori</th>
                    <th>Talep Edilen Miktar</th>
                    <th>Hedef Depo</th>
                    <th>Önerilen Tedarikçi</th>
                    <th>Durum</th>
                  </tr>
                </thead>
                <tbody id="modalRequisitionsTbody">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Modal Footer -->
          <div class="modal-footer">
            <div id="modalSelectedCountBadge" style="font-size: 0.88rem; color: #94a3b8; font-weight: 600;">
              0 talep seçildi
            </div>
            <div style="display: flex; gap: 12px;">
              <button type="button" class="btn-nav-secondary" onclick="closeProductSelectModal()">İptal</button>
              <button type="button" class="btn" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; font-weight: 800; padding: 11px 24px; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 4px 18px rgba(16, 185, 129, 0.4);" onclick="addSelectedModalItemsToForm()">
                ✓ Seçilen Talepleri Teklife Ekle
              </button>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script>
    // Live Clock
    function updateClock() {
      const el = document.getElementById('liveTime');
      if (el) {
        const now = new Date();
        el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
      }
    }
    updateClock();
    setInterval(updateClock, 1000);

    // --- DATA STORE ---
    const allSuppliers = <%- JSON.stringify(typeof suppliers !== 'undefined' && suppliers ? suppliers : []) %>;
    const allAvailableRequisitions = <%- JSON.stringify(typeof availableRequisitions !== 'undefined' && availableRequisitions ? availableRequisitions : []) %>;
    const initialPrimaryReq = <%- JSON.stringify(typeof primaryRequisition !== 'undefined' && primaryRequisition ? primaryRequisition : null) %>;

    // Currently added items in the form table
    let formItems = [];

    // --- TAB SWITCHING ---
    let currentTab = 1;
    function switchTab(tabIndex) {
      currentTab = tabIndex;
      for (let i = 1; i <= 3; i++) {
        const btn = document.getElementById(`tabBtn-${i}`);
        const pane = document.getElementById(`tabPane-${i}`);
        if (i === tabIndex) {
          btn.classList.add('active');
          pane.classList.add('active');
        } else {
          btn.classList.remove('active');
          pane.classList.remove('active');
        }
      }
      recalcAllTotals();
    }

    // --- INITIALIZE PRIMARY ITEM ---
    window.addEventListener('DOMContentLoaded', () => {
      if (initialPrimaryReq) {
        const st = initialPrimaryReq.stokKarti || {};
        formItems.push({
          reqId: initialPrimaryReq.id,
          reqNo: initialPrimaryReq.talepNo,
          stockId: initialPrimaryReq.stokId || st.id,
          stockCode: st.stokKodu || 'STK-0001',
          name: st.ad || 'Demir Profil 40x40',
          category: st.kategori || 'Hammadde',
          requestedQty: parseFloat(initialPrimaryReq.talepEdilenMiktar) || 1,
          offeredQty: parseFloat(initialPrimaryReq.talepEdilenMiktar) || 1,
          unit: initialPrimaryReq.birim || st.birim || 'Adet',
          unitPrice: parseFloat(st.alisFiyati) || 120,
          discountRate: 0,
          vatRate: 20,
          isPrimary: true
        });
      } else if (allAvailableRequisitions.length > 0) {
        const first = allAvailableRequisitions[0];
        formItems.push({
          reqId: first.id,
          reqNo: first.requisitionNo,
          stockId: first.stockItemId,
          stockCode: first.stockCode,
          name: first.name,
          category: first.category,
          requestedQty: first.requestedQuantity,
          offeredQty: first.requestedQuantity,
          unit: first.unit,
          unitPrice: first.purchasePrice || 100,
          discountRate: 0,
          vatRate: 20,
          isPrimary: true
        });
      }

      renderItemsTable();
    });

    // --- RENDER MAIN FORM ITEMS TABLE ---
    function renderItemsTable() {
      const tbody = document.getElementById('itemsTableBody');
      const badge = document.getElementById('itemCountBadge');
      if (!tbody) return;

      tbody.innerHTML = '';
      badge.textContent = formItems.length;

      if (formItems.length === 0) {
        tbody.innerHTML = `<tr><td colspan="11" style="text-align: center; color: #94a3b8; padding: 2rem;">Teklife eklenmiş ürün bulunmamaktadır. Lütfen modal üzerinden talep seçiniz.</td></tr>`;
        recalcAllTotals();
        return;
      }

      formItems.forEach((item, index) => {
        const tr = document.createElement('tr');
        
        tr.innerHTML = `
          <!-- Durum / Kilit -->
          <td style="text-align: center;">
            ${item.isPrimary ? 
              '<span title="Ana Talep Ürünü (Silinemez)" style="font-size: 1rem; cursor: help;">🔒</span>' : 
              '<span title="Ek Talep Ürünü" style="font-size: 0.9rem; color: #34d399;">➕</span>'}
          </td>

          <!-- Talep No & ID -->
          <td>
            <input type="text" class="table-input" value="${item.reqNo ? item.reqNo : ('TALEP-#' + item.reqId)}" readonly style="color: #818cf8; font-weight: 700;">
            <input type="hidden" name="itemRequisitionId" value="${item.reqId || ''}">
            <input type="hidden" name="itemRequisitionNo" value="${item.reqNo || ''}">
          </td>

          <!-- Malzeme Kodu & Adı -->
          <td>
            <div style="font-weight: 800; color: #f8fafc;">${item.name}</div>
            <div style="font-size: 0.75rem; color: #818cf8; font-family: 'JetBrains Mono', monospace;">[${item.stockCode}]</div>
            <input type="hidden" name="itemStockItemId" value="${item.stockId}">
            <input type="hidden" name="itemStockCode" value="${item.stockCode}">
            <input type="hidden" name="itemProductName" value="${item.name}">
          </td>

          <!-- Talep Edilen Miktar -->
          <td>
            <input type="number" class="table-input" value="${item.requestedQty}" readonly style="font-weight: 700;">
            <input type="hidden" name="itemRequestedQty" value="${item.requestedQty}">
          </td>

          <!-- Teklif Edilen Miktar (ZORUNLU - TALEP MİKTARINI AŞAMAZ) -->
          <td>
            <input type="number" 
                   class="table-input" 
                   name="itemOfferedQty" 
                   id="offeredQty_${index}"
                   value="${item.offeredQty}" 
                   min="0.01" 
                   max="${item.requestedQty}" 
                   step="0.01" 
                   required
                   oninput="onOfferedQtyChange(${index}, this)">
            <div id="qtyError_${index}" style="display: none; color: #ef4444; font-size: 0.72rem; font-weight: 700; margin-top: 2px;">
              ⚠️ Maks: ${item.requestedQty}
            </div>
          </td>

          <!-- Birim -->
          <td>
            <input type="text" class="table-input" name="itemUnit" value="${item.unit}" readonly style="text-align: center;">
          </td>

          <!-- Birim Fiyat -->
          <td>
            <input type="number" 
                   class="table-input" 
                   name="itemUnitPrice" 
                   id="unitPrice_${index}"
                   value="${item.unitPrice || 0}" 
                   min="0.01" 
                   step="0.01" 
                   required
                   placeholder="0.00"
                   oninput="onItemPriceChange(${index}, this)">
          </td>

          <!-- İskonto % -->
          <td>
            <input type="number" 
                   class="table-input" 
                   name="itemDiscountRate" 
                   id="discountRate_${index}"
                   value="${item.discountRate || 0}" 
                   min="0" 
                   max="100" 
                   step="0.1" 
                   required
                   oninput="onItemDiscountChange(${index}, this)">
          </td>

          <!-- KDV % -->
          <td>
            <select class="table-input" name="itemVatRate" id="vatRate_${index}" onchange="onItemVatChange(${index}, this)" style="cursor: pointer;">
              <option value="20" ${item.vatRate == 20 ? 'selected' : ''}>%20</option>
              <option value="10" ${item.vatRate == 10 ? 'selected' : ''}>%10</option>
              <option value="1" ${item.vatRate == 1 ? 'selected' : ''}>%1</option>
              <option value="0" ${item.vatRate == 0 ? 'selected' : ''}>%0</option>
            </select>
          </td>

          <!-- Net Satır Tutarı -->
          <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399;" id="lineTotal_${index}">
            0.00
          </td>

          <!-- Silme Butonu -->
          <td style="text-align: center;">
            ${item.isPrimary ? 
              '<span style="color: #64748b; font-size: 0.75rem; font-weight: 700; cursor: not-allowed;" title="Ana talep silinemez">🔒 Kilit</span>' : 
              `<button type="button" onclick="removeItemFromForm(${index})" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; width: 28px; height: 28px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s;" title="Kalemi Sil">✕</button>`}
          </td>
        `;

        tbody.appendChild(tr);
      });

      recalcAllTotals();
    }

    // --- QUANTITY VALIDATION (CANNOT EXCEED REQUESTED QTY) ---
    function onOfferedQtyChange(index, inputEl) {
      const item = formItems[index];
      if (!item) return;

      const val = parseFloat(inputEl.value) || 0;
      const errorEl = document.getElementById(`qtyError_${index}`);

      if (val > item.requestedQty) {
        inputEl.classList.add('input-invalid');
        if (errorEl) errorEl.style.display = 'block';
        item.offeredQty = item.requestedQty;
        inputEl.value = item.requestedQty; // clamp to max requested quantity
      } else if (val <= 0) {
        inputEl.classList.add('input-invalid');
        if (errorEl) errorEl.style.display = 'block';
        item.offeredQty = 0;
      } else {
        inputEl.classList.remove('input-invalid');
        if (errorEl) errorEl.style.display = 'none';
        item.offeredQty = val;
      }

      recalcAllTotals();
    }

    function onItemPriceChange(index, inputEl) {
      const item = formItems[index];
      if (!item) return;
      item.unitPrice = parseFloat(inputEl.value) || 0;
      recalcAllTotals();
    }

    function onItemDiscountChange(index, inputEl) {
      const item = formItems[index];
      if (!item) return;
      item.discountRate = parseFloat(inputEl.value) || 0;
      recalcAllTotals();
    }

    function onItemVatChange(index, selectEl) {
      const item = formItems[index];
      if (!item) return;
      item.vatRate = parseFloat(selectEl.value) || 0;
      recalcAllTotals();
    }

    function removeItemFromForm(index) {
      const item = formItems[index];
      if (item && item.isPrimary) {
        alert('Ana talep ürünü tekliften silinemez veya kaldırılamaz!');
        return;
      }
      formItems.splice(index, 1);
      renderItemsTable();
    }

    // --- RECALCULATE ALL TOTALS ---
    function recalcAllTotals() {
      let subtotal = 0;
      let totalDiscount = 0;
      let totalVat = 0;
      let grandTotal = 0;

      const isVatIncluded = document.getElementById('vatStatusSelect')?.value === 'Dahil';
      const curr = document.getElementById('currencySelect')?.value || 'TRY';

      formItems.forEach((item, index) => {
        const qty = parseFloat(item.offeredQty) || 0;
        const price = parseFloat(item.unitPrice) || 0;
        const discRate = parseFloat(item.discountRate) || 0;
        const vatRate = parseFloat(item.vatRate) || 0;

        const raw = qty * price;
        const disc = raw * (discRate / 100);
        const discTotal = raw - disc;
        let vatAmt = 0;
        let lineNet = 0;

        if (isVatIncluded) {
          vatAmt = discTotal - (discTotal / (1 + (vatRate / 100)));
          lineNet = discTotal;
        } else {
          vatAmt = discTotal * (vatRate / 100);
          lineNet = discTotal + vatAmt;
        }

        subtotal += raw;
        totalDiscount += disc;
        totalVat += vatAmt;
        grandTotal += lineNet;

        const lineEl = document.getElementById(`lineTotal_${index}`);
        if (lineEl) {
          lineEl.textContent = lineNet.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + curr;
        }
      });

      // Update Summary Cards
      const subEl = document.getElementById('summarySubtotal');
      const discEl = document.getElementById('summaryDiscount');
      const vatEl = document.getElementById('summaryVat');
      const grandEl = document.getElementById('summaryGrandTotal');

      if (subEl) subEl.textContent = subtotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + curr;
      if (discEl) discEl.textContent = '-' + totalDiscount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + curr;
      if (vatEl) vatEl.textContent = '+' + totalVat.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + curr;
      if (grandEl) grandEl.textContent = grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + curr;
    }

    function onCurrencyChange() {
      recalcAllTotals();
    }

    // --- SUPPLIER SELECTION SYNC ---
    function onSupplierChange(selectEl) {
      const sId = parseInt(selectEl.value, 10);
      if (!sId) return;

      const sup = allSuppliers.find(s => s.id === sId);
      if (!sup) return;

      const nameInput = document.getElementById('inputSupplierName');
      const taxOfficeInput = document.getElementById('inputTaxOffice');
      const taxNoInput = document.getElementById('inputTaxNo');
      const contactInput = document.getElementById('inputContactPerson');
      const currSelect = document.getElementById('currencySelect');
      const daysInput = document.getElementById('inputDeliveryDays');
      const termSelect = document.getElementById('paymentTermSelect');

      if (nameInput) nameInput.value = sup.ticariAd || sup.firmaAdi;
      if (taxOfficeInput) taxOfficeInput.value = sup.vergiDairesi || '';
      if (taxNoInput) taxNoInput.value = sup.vergiNo || '';
      if (contactInput) contactInput.value = sup.ilgiliKisi || '';
      if (currSelect && sup.paraBirimi) currSelect.value = sup.paraBirimi;
      if (daysInput && sup.terminSuresi) daysInput.value = sup.terminSuresi;
      if (termSelect && sup.odemeVadesi) termSelect.value = sup.odemeVadesi;

      recalcAllTotals();
    }

    // --- MODAL: SATIN ALMA TALEPLİ ÜRÜN SEÇİMİ ---
    let modalFilteredList = [...allAvailableRequisitions];

    function openProductSelectModal() {
      const modal = document.getElementById('productSelectModal');
      if (!modal) return;

      document.getElementById('modalSearchInput').value = '';
      document.getElementById('modalSelectAllChk').checked = false;
      modalFilteredList = [...allAvailableRequisitions];
      modal.style.display = 'flex';
      renderModalRequisitions();
    }

    function closeProductSelectModal() {
      const modal = document.getElementById('productSelectModal');
      if (modal) modal.style.display = 'none';
    }

    function filterModalRequisitions(query) {
      const q = (query || '').toLowerCase().trim();
      if (!q) {
        modalFilteredList = [...allAvailableRequisitions];
      } else {
        modalFilteredList = allAvailableRequisitions.filter(r => 
          (r.requisitionNo && r.requisitionNo.toLowerCase().includes(q)) ||
          (r.stockCode && r.stockCode.toLowerCase().includes(q)) ||
          (r.name && r.name.toLowerCase().includes(q)) ||
          (r.deliveryPlace && r.deliveryPlace.toLowerCase().includes(q)) ||
          (r.supplierName && r.supplierName.toLowerCase().includes(q))
        );
      }
      renderModalRequisitions();
    }

    function sortModalRequisitions(sortVal) {
      if (sortVal === 'name_asc') {
        modalFilteredList.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
      } else if (sortVal === 'qty_desc') {
        modalFilteredList.sort((a, b) => b.requestedQuantity - a.requestedQuantity);
      } else {
        modalFilteredList.sort((a, b) => new Date(b.createdAt || 0) - new Date(a.createdAt || 0));
      }
      renderModalRequisitions();
    }

    function renderModalRequisitions() {
      const tbody = document.getElementById('modalRequisitionsTbody');
      if (!tbody) return;

      tbody.innerHTML = '';

      if (modalFilteredList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: #94a3b8; padding: 2rem;">Sistemde açık veya aramayla eşleşen satın alma talebi bulunamadı.</td></tr>`;
        updateModalSelectedCount();
        return;
      }

      modalFilteredList.forEach(r => {
        const tr = document.createElement('tr');
        const alreadyInForm = formItems.some(item => item.reqId === r.id || (item.stockId === r.stockItemId && item.isPrimary));

        tr.innerHTML = `
          <td style="text-align: center;">
            ${alreadyInForm ? 
              '<span title="Teklife Zaten Ekli" style="color: #10b981; font-weight: 800; font-size: 0.9rem;">✓</span>' : 
              `<input type="checkbox" class="modal-req-chk" data-req-id="${r.id}" onchange="updateModalSelectedCount()" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;">`}
          </td>
          <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;">${r.requisitionNo}</strong></td>
          <td>
            <div style="font-weight: 800; color: #f8fafc;">${r.name}</div>
            <div style="font-size: 0.75rem; color: #818cf8; font-family: 'JetBrains Mono', monospace;">[${r.stockCode}]</div>
          </td>
          <td><span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 0.74rem;">${r.category}</span></td>
          <td><strong style="font-family: 'JetBrains Mono', monospace; color: #f8fafc;">${r.requestedQuantity.toLocaleString('tr-TR')} ${r.unit}</strong></td>
          <td><span style="font-size: 0.78rem; color: #94a3b8;">${r.deliveryPlace}</span></td>
          <td><span style="font-size: 0.78rem; color: #34d399; font-weight: 600;">${r.supplierName || '—'}</span></td>
          <td>
            ${alreadyInForm ? 
              '<span class="status-pill status-active" style="font-size: 0.72rem;">● Teklifte Ekli</span>' : 
              '<span class="status-pill status-pending" style="font-size: 0.72rem;">● Beklemede</span>'}
          </td>
        `;

        tbody.appendChild(tr);
      });

      updateModalSelectedCount();
    }

    function toggleSelectAllModal(masterChk) {
      const checkboxes = document.querySelectorAll('.modal-req-chk');
      checkboxes.forEach(chk => chk.checked = masterChk.checked);
      updateModalSelectedCount();
    }

    function updateModalSelectedCount() {
      const checkedBoxes = document.querySelectorAll('.modal-req-chk:checked');
      const badge = document.getElementById('modalSelectedCountBadge');
      if (badge) {
        badge.textContent = `${checkedBoxes.length} talep seçildi`;
      }
    }

    function addSelectedModalItemsToForm() {
      const checkedBoxes = document.querySelectorAll('.modal-req-chk:checked');
      if (checkedBoxes.length === 0) {
        alert('Lütfen teklife eklemek için en az bir talep işaretleyiniz.');
        return;
      }

      checkedBoxes.forEach(chk => {
        const reqId = parseInt(chk.getAttribute('data-req-id'), 10);
        const reqObj = allAvailableRequisitions.find(r => r.id === reqId);
        if (!reqObj) return;

        // Check if already in formItems
        const exists = formItems.some(item => item.reqId === reqId);
        if (!exists) {
          formItems.push({
            reqId: reqObj.id,
            reqNo: reqObj.requisitionNo,
            stockId: reqObj.stockItemId,
            stockCode: reqObj.stockCode,
            name: reqObj.name,
            category: reqObj.category,
            requestedQty: reqObj.requestedQuantity,
            offeredQty: reqObj.requestedQuantity,
            unit: reqObj.unit,
            unitPrice: reqObj.purchasePrice || 0,
            discountRate: 0,
            vatRate: 20,
            isPrimary: false
          });
        }
      });

      closeProductSelectModal();
      renderItemsTable();
      switchTab(2);
    }

    // --- FORM VALIDATION BEFORE SUBMISSION ---
    function validateFormBeforeSubmit() {
      const sSelect = document.getElementById('supplierSelect');
      if (!sSelect || !sSelect.value) {
        alert('Lütfen teklifi veren tedarikçi firmayı seçiniz.');
        switchTab(1);
        return false;
      }

      if (formItems.length === 0) {
        alert('Teklifte en az bir adet satın alma talepli ürün bulunmalıdır.');
        switchTab(2);
        return false;
      }

      for (let i = 0; i < formItems.length; i++) {
        const item = formItems[i];
        if (!item.offeredQty || item.offeredQty <= 0) {
          alert(`[${item.stockCode}] ${item.name} için geçerli bir teklif miktarı girilmelidir.`);
          switchTab(2);
          document.getElementById(`offeredQty_${i}`)?.focus();
          return false;
        }

        if (item.offeredQty > item.requestedQty) {
          alert(`[${item.stockCode}] ${item.name} için teklif edilen miktar (${item.offeredQty}), talep edilen miktardan (${item.requestedQty}) fazla olamaz!`);
          switchTab(2);
          document.getElementById(`offeredQty_${i}`)?.focus();
          return false;
        }

        if (!item.unitPrice || item.unitPrice <= 0) {
          alert(`[${item.stockCode}] ${item.name} için birim fiyat zorunludur ve 0'dan büyük olmalıdır.`);
          switchTab(2);
          document.getElementById(`unitPrice_${i}`)?.focus();
          return false;
        }
      }

      const daysInput = document.getElementById('inputDeliveryDays');
      if (!daysInput || parseInt(daysInput.value, 10) < 1) {
        alert('Lütfen geçerli bir teslimat süresi (gün) giriniz.');
        switchTab(3);
        return false;
      }

      return true;
    }
  </script>
</body>
</html>