<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satış Faturası (<%= invoice ? invoice.invoiceNo : '' %>) — Resmi e-Fatura / e-Arşiv Belgesi</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    @media print {
      body { background: #ffffff !important; color: #000000 !important; margin: 0 !important; padding: 0 !important; }
      .module-sidebar, .module-topbar, .module-subnav, .no-print { display: none !important; }
      .module-main { margin-left: 0 !important; width: 100% !important; padding: 0 !important; margin: 0 !important; }
      .paper-a4 { border: none !important; box-shadow: none !important; width: 100% !important; max-width: 100% !important; padding: 0 !important; margin: 0 !important; background: #ffffff !important; color: #000000 !important; }
    }
    
    /* Strict Black & White A4 Official Invoice Canvas */
    body {
      background: #090d16;
      color: #000000;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 0;
    }

    .paper-a4 { 
      background: #ffffff; 
      color: #000000;
      border: 1px solid #000000; 
      border-radius: 0; 
      padding: 35px 40px; 
      box-shadow: 0 10px 30px rgba(0,0,0,0.4); 
      width: 210mm;
      min-height: 297mm;
      margin: 20px auto 40px auto; 
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      box-sizing: border-box;
      position: relative;
    }

    .inv-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #000000;
      padding-bottom: 16px;
      margin-bottom: 16px;
    }

    .inv-company {
      font-size: 1.2rem;
      font-weight: 900;
      line-height: 1.3;
      color: #000000;
    }

    .inv-title-box {
      text-align: right;
    }

    .inv-title-box h2 {
      font-size: 1.6rem;
      font-weight: 900;
      margin: 0;
      color: #000000;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .inv-title-box p {
      margin: 4px 0 0 0;
      font-size: 0.85rem;
      font-weight: 700;
      color: #000000;
    }

    .inv-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    .inv-section-box {
      border: 1px solid #000000;
      padding: 10px 14px;
    }

    .inv-section-title {
      font-size: 0.75rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid #000000;
      padding-bottom: 4px;
      margin-bottom: 6px;
      color: #000000;
    }

    .inv-info-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }

    .inv-info-table td {
      padding: 2px 0;
      vertical-align: top;
      color: #000000;
    }

    .inv-info-table td.lbl {
      font-weight: 700;
      width: 40%;
      color: #000000;
    }

    .inv-info-table td.val {
      font-weight: 500;
      color: #000000;
    }

    /* Items Table */
    .inv-items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 16px;
      font-size: 0.8rem;
    }

    .inv-items-table th {
      background: #ffffff;
      color: #000000;
      border: 1px solid #000000;
      padding: 8px 8px;
      font-size: 0.725rem;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .inv-items-table td {
      border: 1px solid #000000;
      padding: 7px 8px;
      color: #000000;
    }

    .inv-summary-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 16px;
      margin-bottom: 16px;
    }

    .inv-summary-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }

    .inv-summary-table td {
      padding: 4px 6px;
      border-bottom: 1px solid #cbd5e1;
      color: #000000;
    }

    .inv-summary-table tr.total-row td {
      border-top: 2px solid #000000;
      border-bottom: 2px solid #000000;
      font-weight: 900;
      font-size: 0.95rem;
    }

    .tax-breakdown-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.75rem;
    }

    .tax-breakdown-table th, .tax-breakdown-table td {
      border: 1px solid #000000;
      padding: 4px 6px;
      text-align: center;
      color: #000000;
    }

    .inv-signatures {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 24px;
      padding-top: 14px;
      border-top: 1px solid #000000;
      font-size: 0.8rem;
      text-align: center;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body>

  <!-- Floating Print Control Bar (Hidden during printing) -->
  <div class="no-print" style="position: sticky; top: 0; z-index: 999; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.1); padding: 12px 24px; display: flex; justify-content: space-between; align-items: center;">
    <div style="color: #fff; font-weight: 700; display: flex; align-items: center; gap: 10px;">
      <span>🧾 Resmi e-Fatura / e-Arşiv Fatura Belgesi</span>
      <span style="font-family: 'JetBrains Mono', monospace; color: #34d399; font-size: 0.85rem;"><%= invoice ? invoice.invoiceNo : '' %></span>
    </div>
    <div style="display: flex; gap: 10px;">
      <button onclick="window.print()" class="btn btn-primary" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; font-weight: 700; padding: 8px 18px; border-radius: 8px; font-size: 0.85rem; color: #fff; cursor: pointer;">
        🖨️ Faturayı Yazdır / PDF İndir
      </button>
      <button onclick="window.close()" class="btn btn-outline-secondary" style="border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 8px 14px; border-radius: 8px; font-size: 0.85rem; background: transparent; cursor: pointer;">
        ✕ Pencereyi Kapat
      </button>
    </div>
  </div>

  <%
    let itemsList = [];
    if (invoice && invoice.itemsJson) {
      try { itemsList = typeof invoice.itemsJson === 'string' ? JSON.parse(invoice.itemsJson) : invoice.itemsJson; } catch(e) { itemsList = []; }
    }
    if (!Array.isArray(itemsList) || itemsList.length === 0) {
      if (invoice && invoice.saleOrder) {
        itemsList = [{
          stockCode: invoice.saleOrder.stockItem ? invoice.saleOrder.stockItem.stockCode : 'STK-001',
          name: invoice.saleOrder.stockItem ? invoice.saleOrder.stockItem.name : 'Ürün Kalemi',
          quantity: invoice.saleOrder.quantity || 1,
          unit: invoice.saleOrder.stockItem ? invoice.saleOrder.stockItem.unit : 'Adet',
          unitPrice: invoice.saleOrder.unitPrice || 0,
          discountRate: invoice.saleOrder.discountRate || 0,
          taxRate: invoice.saleOrder.taxRate || 20,
          totalAmount: invoice.saleOrder.totalAmount || 0
        }];
      } else {
        itemsList = [{ name: 'Ürün / Hizmet Kalemi', quantity: 1, unit: 'Adet', unitPrice: invoice ? invoice.totalAmount : 0, discountRate: 0, taxRate: 20, totalAmount: invoice ? invoice.totalAmount : 0 }];
      }
    }

    // Compute Tax Breakdown by Tax Rate (%20, %10, %1, %0)
    let taxGroups = {};
    let calculatedSubtotal = 0;
    let calculatedDiscount = 0;
    let calculatedTaxableMatrah = 0;
    let calculatedTotalTax = 0;
    let calculatedGrandTotal = 0;

    itemsList.forEach((it, idx) => {
      const q = parseFloat(it.quantity) || 1;
      const p = parseFloat(it.unitPrice) || 0;
      const gross = q * p;
      const dRate = parseFloat(it.discountRate || it.discount) || 0;
      const dAmt = parseFloat(it.discountAmount) || (gross * (dRate / 100));
      const matrah = gross - dAmt;
      const tRate = parseFloat(it.taxRate) || 20;
      const tAmt = parseFloat(it.taxAmount) || (matrah * (tRate / 100));
      const lineTotal = matrah + tAmt;

      calculatedSubtotal += gross;
      calculatedDiscount += dAmt;
      calculatedTaxableMatrah += matrah;
      calculatedTotalTax += tAmt;
      calculatedGrandTotal += lineTotal;

      const key = `${tRate}%`;
      if (!taxGroups[key]) {
        taxGroups[key] = { rate: tRate, matrah: 0, taxAmt: 0 };
      }
      taxGroups[key].matrah += matrah;
      taxGroups[key].taxAmt += tAmt;
    });

    if (calculatedGrandTotal === 0 && invoice) {
      calculatedGrandTotal = parseFloat(invoice.totalAmount) || 0;
      calculatedSubtotal = parseFloat(invoice.subtotal) || calculatedGrandTotal;
      calculatedTotalTax = parseFloat(invoice.taxAmount) || 0;
      calculatedTaxableMatrah = calculatedSubtotal - (parseFloat(invoice.discountAmount) || 0);
    }
  %>

  <!-- A4 PRINTABLE CANVAS -->
  <div class="paper-a4">
    <!-- SECTION 1: FATURA BAŞLIK BİLGİLERİ -->
    <div class="inv-header">
      <div class="inv-company">
        ENTERPRISE ERP YAZILIM VE SANAYİ A.Ş.<br>
        <span style="font-size: 0.8rem; font-weight: 500;">Genel Merkez & Ar-Ge Kompleski</span>
      </div>
      <div class="inv-title-box">
        <h2><%= invoice && invoice.invoiceScenario === 'EFATURA' ? 'e-FATURA' : 'e-ARŞİV FATURA' %></h2>
        <p style="font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; color: #000;"><%= invoice ? invoice.invoiceNo : '' %></p>
        <p style="font-size: 0.75rem; font-weight: 600;">DÜZENLEME TARİHİ: <%= invoice ? new Date(invoice.invoiceDate).toLocaleDateString('tr-TR') : '' %> <%= invoice && invoice.invoiceTime ? invoice.invoiceTime : '10:30:00' %></p>
      </div>
    </div>

    <!-- ETTN & E-FATURA METADATA BOX -->
    <div style="border: 1px solid #000; padding: 6px 12px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; font-family: 'JetBrains Mono', monospace;">
      <div>
        <strong>ETTN (UUID):</strong> <%= invoice && invoice.ettnNo ? invoice.ettnNo : 'e7b8c9d0-1234-5678-9abc-def012345678' %>
      </div>
      <div>
        <strong>SENARYO:</strong> <%= invoice && invoice.invoiceScenario ? invoice.invoiceScenario : 'EARSIVFATURA' %> | 
        <strong>TİPİ:</strong> <%= invoice && invoice.invoiceType ? invoice.invoiceType : 'SATIS' %>
      </div>
    </div>

    <!-- SECTION 2 & 3: SATICI VE MÜŞTERİ BİLGİLERİ -->
    <div class="inv-grid-2">
      <!-- 2. SATICI BİLGİLERİ -->
      <div class="inv-section-box">
        <div class="inv-section-title">🏢 SATICI (TEDARİKÇİ) BİLGİLERİ</div>
        <table class="inv-info-table">
          <tr>
            <td class="lbl">Firma Unvanı:</td>
            <td class="val"><strong>ENTERPRISE ERP YAZILIM VE SANAYİ A.Ş.</strong></td>
          </tr>
          <tr>
            <td class="lbl">Vergi Dairesi / No:</td>
            <td class="val">Büyük Mükellefler V.D. / 1234567890</td>
          </tr>
          <tr>
            <td class="lbl">MERSİS No:</td>
            <td class="val">0123456789000014</td>
          </tr>
          <tr>
            <td class="lbl">Ticaret Sicil No:</td>
            <td class="val">345678-5</td>
          </tr>
          <tr>
            <td class="lbl">Adres:</td>
            <td class="val">Maslak Mah. Büyükdere Cad. No:123 Şişli / İSTANBUL</td>
          </tr>
          <tr>
            <td class="lbl">İletişim:</td>
            <td class="val">Tel: +90 (212) 555 0199 | E-Posta: fatura@enterprise-erp.com</td>
          </tr>
        </table>
      </div>

      <!-- 3. MÜŞTERİ BİLGİLERİ -->
      <div class="inv-section-box">
        <div class="inv-section-title">👤 MÜŞTERİ (ALICI) BİLGİLERİ</div>
        <table class="inv-info-table">
          <tr>
            <td class="lbl">Müşteri Unvanı:</td>
            <td class="val"><strong><%= invoice ? invoice.customerName : '' %></strong></td>
          </tr>
          <tr>
            <td class="lbl">Vergi Dairesi / No:</td>
            <td class="val"><%= invoice && invoice.customerTaxOffice ? invoice.customerTaxOffice : 'Maslak V.D.' %> / <%= invoice ? (invoice.customerTaxNo || '1234567890') : '' %></td>
          </tr>
          <tr>
            <td class="lbl">Fatura Adresi:</td>
            <td class="val"><%= invoice && invoice.billingAddress ? invoice.billingAddress : 'Maslak Mah. Büyükdere Cad. No:100 Şişli / İSTANBUL' %></td>
          </tr>
          <tr>
            <td class="lbl">Teslimat Adresi:</td>
            <td class="val"><%= invoice && invoice.shippingAddress ? invoice.shippingAddress : (invoice && invoice.billingAddress ? invoice.billingAddress : 'Teslimat Adresi Aynı') %></td>
          </tr>
          <tr>
            <td class="lbl">İletişim:</td>
            <td class="val">Tel: <%= invoice && invoice.customerPhone ? invoice.customerPhone : '+90 (212) 555 0100' %> | E-Posta: <%= invoice && invoice.customerEmail ? invoice.customerEmail : 'bilgi@musteri.com' %></td>
          </tr>
        </table>
      </div>
    </div>

    <!-- REFERANS BİLGİLERİ (SİPARİŞ & İRSALİYE BİLGİLERİ) -->
    <div style="border: 1px solid #000; padding: 8px 14px; margin-bottom: 16px; font-size: 0.8rem;">
      <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
        <div><strong>Satış Sipariş No:</strong> <%= invoice && (invoice.orderNo || (invoice.saleOrder ? invoice.saleOrder.orderNo : '')) ? (invoice.orderNo || invoice.saleOrder.orderNo) : '—' %></div>
        <div><strong>Sipariş Tarihi:</strong> <%= invoice && (invoice.orderDate || (invoice.saleOrder ? invoice.saleOrder.orderDate : '')) ? new Date(invoice.orderDate || invoice.saleOrder.orderDate).toLocaleDateString('tr-TR') : '—' %></div>
        <div><strong>Sevk İrsaliye No:</strong> <%= invoice && (invoice.dispatchNo || (invoice.dispatchNote ? invoice.dispatchNote.dispatchNo : '')) ? (invoice.dispatchNo || invoice.dispatchNote.dispatchNo) : '—' %></div>
        <div><strong>İrsaliye Tarihi:</strong> <%= invoice && (invoice.dispatchDate || (invoice.dispatchNote ? invoice.dispatchNote.dispatchDate : '')) ? new Date(invoice.dispatchDate || invoice.dispatchNote.dispatchDate).toLocaleDateString('tr-TR') : '—' %></div>
        <div><strong>Para Birimi / Kur:</strong> <%= invoice ? invoice.currency : 'TRY' %> (<%= invoice && invoice.exchangeRate ? parseFloat(invoice.exchangeRate).toFixed(4) : '1.0000' %>)</div>
      </div>
    </div>

    <!-- SECTION 4: FATURA KALEMLERİ TABLOSU -->
    <table class="inv-items-table">
      <thead>
        <tr>
          <th style="width: 30px; text-align: center;">#</th>
          <th>Ürün / Hizmet Açıklaması</th>
          <th style="width: 60px; text-align: center;">Miktar</th>
          <th style="width: 50px; text-align: center;">Birim</th>
          <th style="width: 90px; text-align: right;">Birim Fiyat</th>
          <th style="width: 70px; text-align: right;">İskonto</th>
          <th style="width: 80px; text-align: right;">Net Matrah</th>
          <th style="width: 50px; text-align: center;">KDV %</th>
          <th style="width: 75px; text-align: right;">KDV Tutarı</th>
          <th style="width: 100px; text-align: right;">Satır Toplamı</th>
        </tr>
      </thead>
      <tbody>
        <% itemsList.forEach((it, idx) => { %>
          <%
            const q = parseFloat(it.quantity) || 1;
            const p = parseFloat(it.unitPrice) || 0;
            const gross = q * p;
            const dRate = parseFloat(it.discountRate || it.discount) || 0;
            const dAmt = parseFloat(it.discountAmount) || (gross * (dRate / 100));
            const matrah = gross - dAmt;
            const tRate = parseFloat(it.taxRate) || 20;
            const tAmt = parseFloat(it.taxAmount) || (matrah * (tRate / 100));
            const lineTotal = matrah + tAmt;
          %>
          <tr>
            <td style="text-align: center; font-weight: 700;"><%= idx + 1 %></td>
            <td>
              <strong><%= it.name %></strong>
              <% if (it.stockCode) { %>
                <div style="font-size: 0.725rem; color: #475569; font-family: 'JetBrains Mono', monospace;">Stok Kodu: <%= it.stockCode %></div>
              <% } %>
            </td>
            <td style="text-align: center; font-weight: 700; font-family: 'JetBrains Mono', monospace;"><%= q.toLocaleString('tr-TR') %></td>
            <td style="text-align: center;"><%= it.unit || 'Adet' %></td>
            <td style="text-align: right; font-family: 'JetBrains Mono', monospace;"><%= p.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %></td>
            <td style="text-align: right; font-family: 'JetBrains Mono', monospace;">
              <%= dRate > 0 ? `%${dRate}` : (dAmt > 0 ? dAmt.toLocaleString('tr-TR', {minimumFractionDigits:2}) : '0.00') %>
            </td>
            <td style="text-align: right; font-weight: 600; font-family: 'JetBrains Mono', monospace;"><%= matrah.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %></td>
            <td style="text-align: center; font-weight: 700;">%<%= tRate %></td>
            <td style="text-align: right; font-family: 'JetBrains Mono', monospace;"><%= tAmt.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %></td>
            <td style="text-align: right; font-weight: 800; font-family: 'JetBrains Mono', monospace;"><%= lineTotal.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice ? invoice.currency : 'TL' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <!-- SECTION 5 & 6: MALİ ÖZET, KDV MATRAH AYRIMI VE ÖDEME BİLGİLERİ -->
    <div class="inv-summary-grid">
      <!-- SECTION 6: ÖDEME BİLGİLERİ & BANKA -->
      <div>
        <div class="inv-section-box" style="margin-bottom: 12px;">
          <div class="inv-section-title">💳 ÖDEME VE BANKA BİLGİLERİ</div>
          <table class="inv-info-table">
            <tr>
              <td class="lbl">Ödeme Şekli:</td>
              <td class="val"><strong><%= invoice && invoice.paymentType ? invoice.paymentType : 'Vadeli' %></strong></td>
            </tr>
            <tr>
              <td class="lbl">Vade Süresi:</td>
              <td class="val"><%= invoice && invoice.paymentTermDays ? invoice.paymentTermDays : 30 %> Gün</td>
            </tr>
            <tr>
              <td class="lbl">Son Vade Tarihi:</td>
              <td class="val"><strong><%= invoice ? new Date(invoice.dueDate).toLocaleDateString('tr-TR') : '' %></strong></td>
            </tr>
            <tr>
              <td class="lbl">Banka Adı:</td>
              <td class="val"><%= invoice && invoice.bankName ? invoice.bankName : 'Ziraat Bankası A.Ş. - Maslak Şubesi' %></td>
            </tr>
            <tr>
              <td class="lbl">IBAN No:</td>
              <td class="val"><strong style="font-family: 'JetBrains Mono', monospace;"><%= invoice && invoice.ibanNo ? invoice.ibanNo : 'TR56 0001 0002 0003 0004 0005 06' %></strong></td>
            </tr>
          </table>
        </div>

        <!-- KDV ORAN BAZINDA MATRAH VE KDV TABLOSU -->
        <div class="inv-section-box">
          <div class="inv-section-title">📊 KDV ORAN BAZINDA MATRAH / KDV DAĞILIMI</div>
          <table class="tax-breakdown-table">
            <thead>
              <tr style="background: #f8fafc;">
                <th>KDV Oranı</th>
                <th>KDV Matrahı (Net)</th>
                <th>Hesaplanan KDV</th>
              </tr>
            </thead>
            <tbody>
              <% Object.keys(taxGroups).forEach(k => { %>
                <tr>
                  <td><strong>%<%= taxGroups[k].rate %></strong></td>
                  <td style="font-family: 'JetBrains Mono', monospace;"><%= taxGroups[k].matrah.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice ? invoice.currency : 'TL' %></td>
                  <td style="font-family: 'JetBrains Mono', monospace;"><strong><%= taxGroups[k].taxAmt.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice ? invoice.currency : 'TL' %></strong></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SECTION 5: FATURANIN MALİ ÖZETİ -->
      <div class="inv-section-box" style="background: #ffffff;">
        <div class="inv-section-title">💰 FATURA MALİ ÖZETİ</div>
        <table class="inv-summary-table">
          <tr>
            <td>Mal/Hizmet Toplam Tutarı:</td>
            <td style="text-align: right; font-family: 'JetBrains Mono', monospace;">
              <%= calculatedSubtotal.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice ? invoice.currency : 'TL' %>
            </td>
          </tr>
          <tr>
            <td>Toplam İskonto Tutarı:</td>
            <td style="text-align: right; font-family: 'JetBrains Mono', monospace; color: #dc2626;">
              - <%= calculatedDiscount.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice ? invoice.currency : 'TL' %>
            </td>
          </tr>
          <tr>
            <td>Net KDV Matrahı:</td>
            <td style="text-align: right; font-weight: 700; font-family: 'JetBrains Mono', monospace;">
              <%= calculatedTaxableMatrah.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice ? invoice.currency : 'TL' %>
            </td>
          </tr>
          <tr>
            <td>Hesaplanan Toplam KDV:</td>
            <td style="text-align: right; font-weight: 700; font-family: 'JetBrains Mono', monospace;">
              + <%= calculatedTotalTax.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice ? invoice.currency : 'TL' %>
            </td>
          </tr>
          <tr class="total-row">
            <td>GENEL TOPLAM (ÖDENECEK):</td>
            <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; color: #000;">
              <%= calculatedGrandTotal.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= invoice ? invoice.currency : 'TL' %>
            </td>
          </tr>
        </table>

        <!-- NOTLAR VEYA AÇIKLAMA -->
        <% if (invoice && invoice.notes) { %>
          <div style="margin-top: 12px; padding-top: 8px; border-top: 1px solid #000; font-size: 0.75rem;">
            <strong>Fatura Notu / Açıklama:</strong>
            <p style="margin: 2px 0 0 0; color: #334155;"><%= invoice.notes %></p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- IMZA VE KAŞE BÖLÜMÜ -->
    <div class="inv-signatures">
      <div>
        <strong>Teslim Eden (Düzenleyen)</strong><br><br><br>
        ___________________________<br>
