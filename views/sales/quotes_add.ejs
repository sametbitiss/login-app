<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Satış Teklifi Oluştur — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <style>
    .glass-form-card {
      background: rgba(12, 17, 28, 0.85);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(20px);
      padding: 2rem;
      position: relative;
      overflow: hidden;
      margin-bottom: 2.5rem;
    }

    .glass-form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #f59e0b 0%, #8b5cf6 50%, #10b981 100%);
    }

    /* Tab Timeline / Step Progress Styling */
    .step-progress-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 2rem;
    }

    .step-progress-item {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 12px 16px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      user-select: none;
    }

    .step-progress-item:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.15);
      transform: translateY(-2px);
    }

    .step-progress-item.active {
      background: rgba(245, 158, 11, 0.12);
      border-color: #f59e0b;
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
    }

    .step-progress-item.completed {
      background: rgba(16, 185, 129, 0.08);
      border-color: rgba(16, 185, 129, 0.4);
    }

    .spi-badge {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.875rem;
      flex-shrink: 0;
      transition: all 0.3s ease;
    }

    .step-progress-item.active .spi-badge {
      background: #f59e0b;
      color: #000;
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    }

    .step-progress-item.completed .spi-badge {
      background: #10b981;
      color: #fff;
    }

    .spi-text {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .spi-text strong {
      font-size: 0.85rem;
      color: #fff;
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }

    .spi-text span {
      font-size: 0.725rem;
      color: var(--text-muted);
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }

    .step-progress-item.active .spi-text span {
      color: #fbbf24;
    }

    .tab-content-panel {
      display: none;
      animation: fadeInTab 0.35s ease-in-out;
    }

    .tab-content-panel.active {
      display: block;
    }

    @keyframes fadeInTab {
      from {
        opacity: 0;
        transform: translateY(6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 768px) {
      .step-progress-bar {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="8" fill="url(#bGrad)" />
          <path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
          <defs>
            <linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32">
              <stop offset="0%" stop-color="#6366f1" />
              <stop offset="100%" stop-color="#8b5cf6" />
            </linearGradient>
          </defs>
        </svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/quotes/add" class="mss-sub-link active">➕ Yeni Teklif Oluştur</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar">
        <%= user.username.charAt(0).toUpperCase() %>
      </div>
      <div class="msu-meta">
        <strong>
          <%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %>
        </strong>
        <span>
          <%= user.role %>
        </span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role==='Admin' ) { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a>
          <% } %>
            <% if (user.role==='Admin' || user.role==='Sales_Manager' ) { %>
              <a href="/sales" class="mt-link active">Satış Yönetimi</a>
              <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div class="page-header" style="margin-bottom: 1.5rem;">
        <div>
          <h1 style="font-weight: 900; letter-spacing: -0.02em;">Yeni Satış Teklifi Hazırla</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Müşteriye iletilecek teklif
            şartlarını, geçerlilik süresini ve özel iskonto oranını sekmeli menüden doldurun.</p>
        </div>
        <a href="/sales/quotes" class="btn btn-secondary" style="border-radius: 12px;">◀ Teklif Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div class="error" style="margin-bottom: 1.5rem;">
          <%= error %>
        </div>
        <% } %>

          <!-- GLASSFORM CARD WIZARD -->
          <div class="glass-form-card">
            <h3
              style="color: #f59e0b; font-size: 1.15rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="16" y1="13" x2="8" y2="13" />
                <line x1="16" y1="17" x2="8" y2="17" />
              </svg>
              📜 Satış Teklifi Oluşturma Sihirbazı
            </h3>

            <!-- STEP PROGRESS TIMELINE BAR -->
            <div class="step-progress-bar">
              <div class="step-progress-item active" onclick="switchQuoteTab(1)" id="tab-pill-1">
                <div class="spi-badge">1</div>
                <div class="spi-text">
                  <strong>Cari & Genel</strong>
                  <span>Teklif No & Müşteri Seçimi</span>
                </div>
              </div>
              <div class="step-progress-item" onclick="switchQuoteTab(2)" id="tab-pill-2">
                <div class="spi-badge">2</div>
                <div class="spi-text">
                  <strong>Ürün Kalemleri</strong>
                  <span>Fiyatlandırma & İskonto</span>
                </div>
              </div>
              <div class="step-progress-item" onclick="switchQuoteTab(3)" id="tab-pill-3">
                <div class="spi-badge">3</div>
                <div class="spi-text">
                  <strong>Teklif Şartları</strong>
                  <span>Ödeme, Teslimat & Notlar</span>
                </div>
              </div>
            </div>

            <form action="/sales/quotes/add" method="POST" id="quotationForm">
              <input type="hidden" name="itemsJson" id="itemsJsonInput" value="[]">

              <!-- TAB CONTENT 1: CARİ MÜŞTERİ VE GENEL BİLGİLER -->
              <div class="tab-content-panel active" id="quote-tab-1">
                <h4
                  style="font-size: 0.95rem; font-weight: 800; color: #818cf8; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
                  <span>📜</span> 1. Teklif ve Cari Müşteri Bilgileri
                </h4>

                <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
                  <div class="input-group">
                    <label for="quotationNo">Teklif No <span class="req-star">*</span></label>
                    <input type="text" id="quotationNo" name="quotationNo" value="<%= nextQuotationNo %>" required
                      readonly
                      style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(99, 102, 241, 0.1); color: #818cf8; border-color: rgba(99, 102, 241, 0.3);">
                  </div>
                  <div class="input-group">
                    <label for="customerId">Cari Müşteri Seçimi</label>
                    <select id="customerId" name="customerId" onchange="fillCustomerName(this)">
                      <option value="">-- Genel / Kayıtsız Müşteri --</option>
                      <% customers.forEach(c=> {
                        const score = c.customerScore !== undefined ? c.customerScore : 85;
                        const isBlocked = score < 50 || c.riskLevel==='High' || c.riskLevel==='Blocked' ||
                          c.riskLevel==='Critical' ; const cLimit=parseFloat(c.creditLimit) || 100000; const
                          cBal=parseFloat(c.currentBalance) || 0; %>
                          <option value="<%= c.id %>" data-name="<%= c.companyName %>" data-creditlimit="<%= cLimit %>"
                            data-currentbalance="<%= cBal %>" data-blocked="<%= isBlocked %>" <%=isBlocked
                            ? 'disabled style="color:#f43f5e;"' : '' %>>
                            [<%= c.customerCode %>] <%= c.companyName %>
                                <%= isBlocked ? `(Puan: ${score}/100 ⭐ - 🚫 RİSKLİ / TEKLİF ENGELLİ)` : `(Puan:
                                  ${score}/100 ⭐ - Risk Limiti: ${cLimit.toLocaleString('tr-TR')} TL)` %>
                          </option>
                          <% }); %>
                    </select>

                    <!-- Dynamic Customer Risk Card -->
                    <div id="customerRiskCard"
                      style="display: none; margin-top: 10px; padding: 10px 14px; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; font-size: 0.8rem;">
                      <div
                        style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                        <div><span style="color: var(--text-muted);">Toplam Risk Limiti:</span> <strong
                            id="cardCreditLimit" style="color: #818cf8; font-family: 'JetBrains Mono', monospace;">0.00
                            TL</strong></div>
                        <div><span style="color: var(--text-muted);">Güncel Borç:</span> <strong id="cardCurrentBalance"
                            style="color: #fbbf24; font-family: 'JetBrains Mono', monospace;">0.00 TL</strong></div>
                        <div><span style="color: var(--text-muted);">Kullanılabilir Limit:</span> <strong
                            id="cardAvailableCredit"
                            style="color: #34d399; font-family: 'JetBrains Mono', monospace;">0.00 TL</strong></div>
                      </div>
                    </div>
                  </div>
                  <div class="input-group">
                    <label for="customerName">Müşteri / Kurum Unvanı <span class="req-star">*</span></label>
                    <input type="text" id="customerName" name="customerName" required placeholder="Müşteri adını girin">
                  </div>
                </div>

                <div class="form-grid form-grid--3">
                  <div class="input-group">
                    <label for="quotationDate">Teklif Tarihi <small
                        style="color: var(--text-muted);">(Bugün)</small></label>
                    <input type="date" id="quotationDate" name="quotationDate"
                      value="<%= new Date().toISOString().split('T')[0] %>" required readonly
                      style="background: rgba(255, 255, 255, 0.05); color: var(--text-muted); cursor: not-allowed;">
                  </div>
                  <div class="input-group">
                    <label for="validUntil">Geçerlilik Son Tarihi <span class="req-star">*</span></label>
                    <input type="date" id="validUntil" name="validUntil" value=""
                      min="<%= new Date().toISOString().split('T')[0] %>" required>
                  </div>
                  <div class="input-group">
                    <label for="currency">Para Birimi</label>
                    <select id="currency" name="currency" onchange="recalculate()">
                      <option value="TRY">TRY (₺)</option>
                      <option value="USD">USD ($)</option>
                      <option value="EUR (€)">EUR (€)</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- TAB CONTENT 2: ÜRÜN KALEMLERİ VE FİYATLANDIRMA -->
              <div class="tab-content-panel" id="quote-tab-2">
                <!-- Warning Alert for Min 1 Product Rule -->
                <div id="minItemWarningAlert"
                  style="display: none; background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); padding: 14px 20px; border-radius: 12px; color: #f43f5e; font-size: 0.875rem; font-weight: 600; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                  </svg>
                  <span>⚠️ Teklifte en az 1 ürün bulunmalıdır. Son ürün kalemi silinemez.</span>
                </div>

                <!-- Risk Limit Exceeded Alert Banner -->
                <div id="riskLimitExceededAlert"
                  style="display: none; background: rgba(244, 63, 94, 0.18); border: 1px solid rgba(244, 63, 94, 0.5); padding: 14px 20px; border-radius: 12px; color: #f43f5e; font-size: 0.875rem; font-weight: 700; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path
                      d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                  </svg>
                  <span id="riskLimitExceededText">⚠️ Risk Limiti Aşımı! Müşterinin kalan kullanılabilir risk limiti
                    teklif tutarından azdır. Teklif oluşturulamaz.</span>
                </div>

                <!-- Special Price Violation Alert Banner -->
                <div id="specialPriceViolationAlert" style="display: none; background: rgba(244, 63, 94, 0.18); border: 1px solid rgba(244, 63, 94, 0.5); padding: 14px 20px; border-radius: 12px; color: #f43f5e; font-size: 0.875rem; font-weight: 700; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  <span id="specialPriceViolationText">⚠️ Müşteriye özel tanımlanmış birim fiyat arttırılamaz, özel iskonto oranı da düşürülemez!</span>
                </div>

                <div
                  style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 12px;">
                  <div>
                    <h3
                      style="font-size: 1.05rem; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 10px; margin: 0;">
                      <span
                        style="background: linear-gradient(135deg, #f59e0b, #ec4899); color: #fff; width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; font-family: 'JetBrains Mono', monospace;"
                        id="itemCountBadge">1</span>
                      2. Teklif Edilecek Ürün Kalemleri (Mamuller)
                    </h3>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Müşteriye teklif verilecek
                      tüm ürünleri ekleyin, miktar ve satır bazlı iskontoları belirtin.</p>
                  </div>

                  <button type="button" onclick="addNewRow()" class="btn btn-sm"
                    style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: #fff; border: none; font-weight: 600; padding: 10px 20px; border-radius: 10px; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3); gap: 8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                      stroke-linecap="round">
                      <line x1="12" y1="5" x2="12" y2="19" />
                      <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    + Yeni Ürün Kalemi Ekle
                  </button>
                </div>

                <!-- Table Container -->
                <div
                  style="overflow-x: auto; border-radius: 14px; border: 1px solid var(--border); background: rgba(6, 8, 15, 0.8); margin-bottom: 1.5rem;">
                  <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;"
                    id="itemsTable">
                    <thead>
                      <tr
                        style="background: rgba(19, 26, 43, 0.9); border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px;">
                        <th style="padding: 14px 16px; width: 45px; text-align: center;">#</th>
                        <th style="padding: 14px 16px; min-width: 260px;">Ürün / Mamul Kalemi</th>
                        <th style="padding: 14px 16px; width: 110px;">Miktar</th>
                        <th style="padding: 14px 16px; width: 140px;">Birim Fiyat</th>
                        <th style="padding: 14px 16px; width: 110px;">İskonto (%)</th>
                        <th style="padding: 14px 16px; width: 100px;">KDV (%)</th>
                        <th style="padding: 14px 16px; width: 150px; text-align: right;">Satır Toplamı</th>
                        <th style="padding: 14px 16px; width: 60px; text-align: center;">Sil</th>
                      </tr>
                    </thead>
                    <tbody id="itemsTbody">
                      <!-- Dynamic rows generated by JavaScript -->
                    </tbody>
                  </table>
                </div>

                <!-- Live Summary Card & Approval Alert -->
                <div
                  style="background: linear-gradient(135deg, rgba(19, 26, 43, 0.8) 0%, rgba(12, 17, 28, 0.9) 100%); border-radius: 16px; border: 1px solid var(--border); padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">

                  <div id="approvalWarningAlert"
                    style="display: none; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); padding: 12px 18px; border-radius: 10px; color: #fbbf24; font-size: 0.85rem; font-weight: 600; align-items: center; gap: 10px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="2.5">
                      <polygon
                        points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                    <span>⚡ Bu teklif yüksek iskonto (>%20) veya yüksek toplam tutar (>100.000 TL) içerdiği için
                      yönetsel onay gerektirecektir.</span>
                  </div>

                  <div
                    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; text-align: center;">
                    <div
                      style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                      <span
                        style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Ara
                        Toplam (Brüt)</span>
                      <strong id="displaySubtotal"
                        style="font-size: 1.25rem; color: #fff; font-family: 'JetBrains Mono', monospace;">0.00
                        ₺</strong>
                    </div>
                    <div
                      style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                      <span
                        style="font-size: 0.75rem; font-weight: 600; color: #fb7185; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Toplam
                        İskonto</span>
                      <strong id="displayDiscount"
                        style="font-size: 1.25rem; color: #fb7185; font-family: 'JetBrains Mono', monospace;">- 0.00
                        ₺</strong>
                    </div>
                    <div
                      style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                      <span
                        style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Hesaplanan
                        KDV</span>
                      <strong id="displayTax"
                        style="font-size: 1.25rem; color: #fff; font-family: 'JetBrains Mono', monospace;">0.00
                        ₺</strong>
                    </div>
                    <div
                      style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%); padding: 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.3);">
                      <span
                        style="font-size: 0.75rem; font-weight: 700; color: #818cf8; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">GENEL
                        TOPLAM</span>
                      <strong id="displayGrandTotal"
                        style="font-size: 1.35rem; color: #818cf8; font-family: 'JetBrains Mono', monospace;">0.00
                        ₺</strong>
                    </div>
                  </div>
                </div>
              </div>

              <!-- TAB CONTENT 3: TEKLİF ŞARTLARI VE NOTLAR -->
              <div class="tab-content-panel" id="quote-tab-3">
                <h4
                  style="font-size: 0.95rem; font-weight: 800; color: #10b981; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
                  <span>📝</span> 3. Teklif Koşulları, Teslimat Şartları ve Özel Notlar
                </h4>

                <div class="form-grid form-grid--2" style="margin-bottom: 1.25rem;">
                  <div class="input-group">
                    <label for="paymentTerm">Ödeme Koşulu</label>
                    <select id="paymentTerm" name="paymentTerm">
                      <option value="Peşin">Peşin (Ön Ödeme)</option>
                      <option value="30 Gün Vadeli" selected>30 Gün Vadeli</option>
                      <option value="60 Gün Vadeli">60 Gün Vadeli</option>
                      <option value="90 Gün Vadeli">90 Gün Vadeli</option>
                      <option value="%50 Peşin, %50 Teslimatta">%50 Peşin, %50 Teslimatta</option>
                    </select>
                  </div>
                  <div class="input-group">
                    <label for="deliveryTerm">Sevkiyat & Teslimat Süresi</label>
                    <input type="text" id="deliveryTerm" name="deliveryTerm"
                      placeholder="Örn: Sipariş onayından sonra 7 iş günü içinde adrese teslim."
                      value="Sipariş onayından sonra 7 iş günü içinde adrese teslim.">
                  </div>
                </div>

                <div class="input-group">
                  <label for="notes">Teklif Notları & Müşteriye Özel Şartlar</label>
                  <textarea id="notes" name="notes" rows="4"
                    placeholder="Teklife eklemek istediğiniz özel imalat şartları, kargo bilgileri veya banka IBAN detaylarını buraya yazabilirsiniz..."></textarea>
                </div>
              </div>

              <!-- BOTTOM TAB NAVIGATION BAR -->
              <div
                style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.08);">
                <button type="button" class="btn btn-outline-secondary" id="btnPrevStep" onclick="navigateQuoteStep(-1)"
                  style="display: none; font-weight: 600; padding: 10px 22px; border-radius: 10px;">
                  ← Önceki Adım
                </button>
                <div id="stepCounterBadge" style="font-size: 0.825rem; color: var(--text-muted); font-weight: 600;">
                  Adım 1 / 3
                </div>
                <div>
                  <button type="button" class="btn btn-primary" id="btnNextStep" onclick="navigateQuoteStep(1)"
                    style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); border: none; font-weight: 700; padding: 10px 24px; border-radius: 10px;">
                    Sonraki Adım →
                  </button>
                  <button type="submit" class="btn btn-lg" id="btnSubmitQuote"
                    style="display: none; background: linear-gradient(135deg, #f59e0b 0%, #ec4899 100%); color: #fff; border: none; font-weight: 700; padding: 12px 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(245, 158, 11, 0.35); gap: 10px;">
                    📜 Teklifi Kaydet ve Yönetsel Onaya Gönder
                  </button>
                </div>
              </div>

            </form>
          </div>
    </main>
  </div>

  <!-- Stock Item Master Catalog JSON Data -->
  <script id="stockCatalogData" type="application/json">
    <%- JSON.stringify(stockItems || []) %>
  </script>
  <!-- Customer Price Lists Master JSON Data -->
  <script id="priceListsData" type="application/json">
    <%- JSON.stringify(priceLists || []) %>
  </script>

  <script>
    const stockCatalog = JSON.parse(document.getElementById('stockCatalogData').textContent || '[]');
    let currentStep = 1;
    const totalSteps = 3;

    function switchQuoteTab(stepNum) {
      if (stepNum < 1 || stepNum > totalSteps) return;

      currentStep = stepNum;

      for (let i = 1; i <= totalSteps; i++) {
        const panel = document.getElementById(`quote-tab-${i}`);
        const pill = document.getElementById(`tab-pill-${i}`);
        if (panel) {
          if (i === stepNum) panel.classList.add('active');
          else panel.classList.remove('active');
        }
        if (pill) {
          if (i === stepNum) {
            pill.classList.add('active');
          } else {
            pill.classList.remove('active');
            if (i < stepNum) pill.classList.add('completed');
          }
        }
      }

      const btnPrev = document.getElementById('btnPrevStep');
      const btnNext = document.getElementById('btnNextStep');
      const btnSubmit = document.getElementById('btnSubmitQuote');
      const counterBadge = document.getElementById('stepCounterBadge');

      if (btnPrev) btnPrev.style.display = currentStep > 1 ? 'inline-flex' : 'none';

      if (currentStep === totalSteps) {
        if (btnNext) btnNext.style.display = 'none';
        if (btnSubmit) btnSubmit.style.display = 'inline-flex';
      } else {
        if (btnNext) btnNext.style.display = 'inline-flex';
        if (btnSubmit) btnSubmit.style.display = 'none';
      }

      if (counterBadge) counterBadge.textContent = `Adım ${currentStep} / ${totalSteps}`;
    }

    function navigateQuoteStep(direction) {
      if (direction === 1) {
        if (currentStep === 1) {
          const custNameInput = document.getElementById('customerName');
          const validUntilInput = document.getElementById('validUntil');
          if (!custNameInput || !custNameInput.value.trim()) {
            alert('⚠️ Lütfen önce Müşteri Unvanını giriniz veya Cari seçiniz.');
            if (custNameInput) custNameInput.focus();
            return;
          }
          if (!validUntilInput || !validUntilInput.value) {
            alert('⚠️ Lütfen Teklif Geçerlilik Son Tarihini seçiniz.');
            if (validUntilInput) validUntilInput.focus();
            return;
          }
        }
      }

      switchQuoteTab(currentStep + direction);
    }

    const priceListsCatalog = JSON.parse(document.getElementById('priceListsData').textContent || '[]');

    function getCustomerSpecialPrice(customerId, stockItemId) {
      if (!stockItemId) return null;
      const cId = parseInt(customerId, 10);
      const sId = parseInt(stockItemId, 10);

      if (cId) {
        const match = priceListsCatalog.find(p => p.customerId === cId && p.stockItemId === sId && p.status === 'Active');
        if (match) return match;
      }

      const globalMatch = priceListsCatalog.find(p => (!p.customerId || p.customerId === 0) && p.stockItemId === sId && p.status === 'Active');
      return globalMatch || null;
    }

    let selectedCustomerCreditLimit = 0;
    let selectedCustomerCurrentBalance = 0;

    function fillCustomerName(selectEl) {
      const selectedOption = selectEl.options[selectEl.selectedIndex];
      const isBlocked = selectedOption.getAttribute('data-blocked') === 'true';

      if (isBlocked) {
        alert('⛔ DİKKAT: Seçilen cari müşterinin risk seviyesi yüksek veya puanı kritik olduğu için yeni teklif/sipariş oluşturulamaz!');
        selectEl.value = '';
        document.getElementById('customerName').value = '';
        document.getElementById('customerRiskCard').style.display = 'none';
        selectedCustomerCreditLimit = 0;
        selectedCustomerCurrentBalance = 0;
        return;
      }

      const name = selectedOption.getAttribute('data-name');
      const cLimit = parseFloat(selectedOption.getAttribute('data-creditlimit')) || 0;
      const cBalance = parseFloat(selectedOption.getAttribute('data-currentbalance')) || 0;

      if (name) {
        document.getElementById('customerName').value = name;
      }

      const riskCard = document.getElementById('customerRiskCard');
      if (selectEl.value && cLimit > 0) {
        selectedCustomerCreditLimit = cLimit;
        selectedCustomerCurrentBalance = cBalance;
        const availableCredit = cLimit - cBalance;

        document.getElementById('cardCreditLimit').textContent = cLimit.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';
        document.getElementById('cardCurrentBalance').textContent = cBalance.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';
        document.getElementById('cardAvailableCredit').textContent = availableCredit.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';
        if (riskCard) riskCard.style.display = 'block';
      } else {
        selectedCustomerCreditLimit = 0;
        selectedCustomerCurrentBalance = 0;
        if (riskCard) riskCard.style.display = 'none';
      }

      // Re-trigger special price evaluation for all existing rows that have a selected product
      const rows = document.querySelectorAll('#itemsTbody tr');
      rows.forEach(tr => {
        const stockSelect = tr.querySelector('.item-stock-id');
        if (stockSelect && stockSelect.value) {
          const rowId = tr.id.replace('row-', '');
          onStockSelect(stockSelect, rowId);
        }
      });

      recalculate();
    }

    // Set Default Valid Until Date (+14 days)
    (function setInitialValidUntil() {
      const today = new Date();
      today.setDate(today.getDate() + 14);
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      const validUntilInput = document.getElementById('validUntil');
      if (validUntilInput && !validUntilInput.value) {
        validUntilInput.value = `${yyyy}-${mm}-${dd}`;
      }
    })();

    // Multi-Item Row Logic
    let rowIdCounter = 0;

    function addNewRow(initialData = null) {
      rowIdCounter++;
      const tbody = document.getElementById('itemsTbody');
      const tr = document.createElement('tr');
      tr.id = `row-${rowIdCounter}`;

      const stockItemsList = stockCatalog || [];
      const stockOptionsHtml = `<option value="">-- Ürün / Stok Kalemi Seçiniz --</option>` + stockItemsList.map(st => `
        <option value="${st.id}" data-code="${st.stockCode}" data-price="${st.salePrice}" data-tax="${st.taxRate || 20}">
          [${st.stockCode}] ${st.name} (${parseFloat(st.salePrice).toLocaleString('tr-TR')} ₺)
        </option>
      `).join('');

      const qty = initialData ? initialData.quantity : 1;
      const price = initialData ? initialData.unitPrice : 0;
      const discount = initialData ? initialData.discountRate : 0;
      const tax = initialData ? initialData.taxRate : 20;

      tr.innerHTML = `
        <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-muted);" class="row-index">1</td>
        <td style="padding: 12px 14px;">
          <select class="item-stock-id" onchange="onStockSelect(this, ${rowIdCounter})" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 8px; font-weight: 600;">
            ${stockOptionsHtml}
          </select>
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0.01" value="${qty}" class="item-qty" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 8px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0" value="${price}" class="item-price" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 8px; text-align: right; font-family: 'JetBrains Mono', monospace;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.1" min="0" max="100" value="${discount}" class="item-discount" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fb7185; padding: 8px 10px; border-radius: 8px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.1" min="0" max="100" value="${tax}" class="item-tax" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 8px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
        </td>
        <td style="padding: 12px 14px; text-align: right;">
          <strong class="item-total" style="font-family: 'JetBrains Mono', monospace; color: #fff; font-size: 0.95rem;">0.00 ₺</strong>
        </td>
        <td style="padding: 12px 14px; text-align: center;">
          <button type="button" onclick="removeRow(${rowIdCounter})" class="btn-delete-row" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.3); color: #f43f5e; width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;">
            ✕
          </button>
        </td>
      `;

      tbody.appendChild(tr);
      updateRowIndices();

      const selectEl = tr.querySelector('.item-stock-id');
      if (initialData && initialData.stockItemId) {
        if (selectEl) {
          selectEl.value = initialData.stockItemId;
          onStockSelect(selectEl, rowIdCounter);
        }
      } else {
        if (selectEl) selectEl.value = '';
        recalculate();
      }
    }

    function removeRow(id) {
      const tbody = document.getElementById('itemsTbody');
      if (tbody.children.length <= 1) {
        const warnEl = document.getElementById('minItemWarningAlert');
        if (warnEl) {
          warnEl.style.display = 'flex';
          setTimeout(() => { warnEl.style.display = 'none'; }, 4000);
        }
        return;
      }

      const tr = document.getElementById(`row-${id}`);
      if (tr) {
        tr.remove();
        updateRowIndices();
        recalculate();
      }
    }

    function updateRowIndices() {
      const rows = document.querySelectorAll('#itemsTbody tr');
      rows.forEach((tr, index) => {
        const indexTd = tr.querySelector('.row-index');
        if (indexTd) indexTd.textContent = index + 1;
      });

      const badge = document.getElementById('itemCountBadge');
      if (badge) badge.textContent = rows.length;
    }

    function onStockSelect(selectEl, rowId) {
      const tr = document.getElementById(`row-${rowId}`);
      if (!tr) return;

      const priceInput = tr.querySelector('.item-price');
      const discInput = tr.querySelector('.item-discount');
      const taxInput = tr.querySelector('.item-tax');

      if (!selectEl.value) {
        if (priceInput) priceInput.value = 0;
        if (discInput) discInput.value = 0;
        if (taxInput) taxInput.value = 20;
        if (priceInput) delete priceInput.dataset.specialMax;
        if (discInput) delete discInput.dataset.specialMin;
        recalculate();
        return;
      }

      const option = selectEl.options[selectEl.selectedIndex];
      const defaultPrice = parseFloat(option.getAttribute('data-price')) || 0;
      const tax = option.getAttribute('data-tax');

      if (tax !== null && taxInput) taxInput.value = tax;

      const custSelect = document.getElementById('customerId');
      const custId = custSelect ? custSelect.value : '';
      const stockItemId = selectEl.value;

      const sp = getCustomerSpecialPrice(custId, stockItemId);

      if (sp) {
        const specPrice = parseFloat(sp.specialPrice);
        const customDisc = parseFloat(sp.customDiscountRate);

        priceInput.value = specPrice;
        discInput.value = customDisc;
        priceInput.dataset.specialMax = specPrice;
        discInput.dataset.specialMin = customDisc;
      } else {
        priceInput.value = defaultPrice;
        discInput.value = 0;
        delete priceInput.dataset.specialMax;
        delete discInput.dataset.specialMin;
      }

      recalculate();
    }

    let globalSpecialPriceViolation = null;

    function recalculate() {
      const rows = document.querySelectorAll('#itemsTbody tr');
      const currency = document.getElementById('currency').value || 'TRY';
      let symbol = '₺';
      if (currency === 'USD') symbol = '$';
      if (currency === 'EUR (€)') symbol = '€';

      let grandSubtotal = 0;
      let grandDiscount = 0;
      let grandTax = 0;
      let grandTotal = 0;

      let maxDiscountRate = 0;
      const itemsPayload = [];
      globalSpecialPriceViolation = null;

      rows.forEach(tr => {
        const stockSelect = tr.querySelector('.item-stock-id');
        const stockItemId = stockSelect ? stockSelect.value : '';
        const selectedOpt = stockSelect ? stockSelect.options[stockSelect.selectedIndex] : null;
        const stockCode = selectedOpt ? (selectedOpt.getAttribute('data-code') || '') : '';
        const name = selectedOpt ? selectedOpt.text.split('] ')[1]?.split(' (')[0] || '' : '';

        const qty = parseFloat(tr.querySelector('.item-qty').value) || 0;
        const priceInput = tr.querySelector('.item-price');
        const discInput = tr.querySelector('.item-discount');

        const price = parseFloat(priceInput.value) || 0;
        const discountRate = parseFloat(discInput.value) || 0;
        const taxRate = parseFloat(tr.querySelector('.item-tax').value) || 0;

        // Mutation check: Fiyat arttırılamaz, İskonto düşürülemez
        const maxPrice = priceInput && priceInput.dataset.specialMax !== undefined ? parseFloat(priceInput.dataset.specialMax) : null;
        const minDisc = discInput && discInput.dataset.specialMin !== undefined ? parseFloat(discInput.dataset.specialMin) : null;

        if (maxPrice !== null && !isNaN(maxPrice) && price > maxPrice) {
          priceInput.style.borderColor = '#f43f5e';
          priceInput.style.color = '#f43f5e';
          globalSpecialPriceViolation = `⚠️ [${stockCode}] ürünü için müşteriye özel tanımlanmış birim fiyat (${maxPrice.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL) daha yüksek bir tutara arttırılamaz!`;
        } else if (priceInput) {
          priceInput.style.borderColor = 'var(--border)';
          priceInput.style.color = '#fff';
        }

        if (minDisc !== null && !isNaN(minDisc) && discountRate < minDisc) {
          discInput.style.borderColor = '#f43f5e';
          discInput.style.color = '#f43f5e';
          if (!globalSpecialPriceViolation) {
            globalSpecialPriceViolation = `⚠️ [${stockCode}] ürünü için müşteriye özel tanımlanmış iskonto oranı (%${minDisc}) daha düşük bir orana düşürülemez!`;
          }
        } else if (discInput) {
          discInput.style.borderColor = 'var(--border)';
          discInput.style.color = '#fb7185';
        }

        if (discountRate > maxDiscountRate) maxDiscountRate = discountRate;

        const subtotal = qty * price;
        const discountAmount = subtotal * (discountRate / 100);
        const netTotal = subtotal - discountAmount;
        const taxAmount = netTotal * (taxRate / 100);
        const lineTotal = netTotal + taxAmount;

        grandSubtotal += subtotal;
        grandDiscount += discountAmount;
        grandTax += taxAmount;
        grandTotal += lineTotal;

        const lineTotalEl = tr.querySelector('.item-total');
        if (lineTotalEl) lineTotalEl.textContent = lineTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;

        if (stockItemId) {
          itemsPayload.push({
            stockItemId,
            stockCode,
            name,
            quantity: qty,
            unitPrice: price,
            discountRate,
            taxRate,
            totalAmount: lineTotal
          });
        }
      });

      document.getElementById('itemsJsonInput').value = JSON.stringify(itemsPayload);

      document.getElementById('displaySubtotal').textContent = grandSubtotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;
      document.getElementById('displayDiscount').textContent = '- ' + grandDiscount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;
      document.getElementById('displayTax').textContent = grandTax.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;
      document.getElementById('displayGrandTotal').textContent = grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;

      const spAlert = document.getElementById('specialPriceViolationAlert');
      const spText = document.getElementById('specialPriceViolationText');
      if (globalSpecialPriceViolation) {
        if (spText) spText.textContent = globalSpecialPriceViolation;
        if (spAlert) spAlert.style.display = 'flex';
      } else {
        if (spAlert) spAlert.style.display = 'none';
      }

      const approvalAlert = document.getElementById('approvalWarningAlert');
      if (approvalAlert) {
        if (maxDiscountRate > 20 || grandTotal > 100000) {
          approvalAlert.style.display = 'flex';
        } else {
          approvalAlert.style.display = 'none';
        }
      }

      // Risk Limit Validation Alert
      const riskAlert = document.getElementById('riskLimitExceededAlert');
      const availableCredit = selectedCustomerCreditLimit - selectedCustomerCurrentBalance;
      if (selectedCustomerCreditLimit > 0 && grandTotal > availableCredit) {
        if (riskAlert) {
          const warnText = document.getElementById('riskLimitExceededText');
          if (warnText) warnText.textContent = `⚠️ Risk Limiti Aşımı! Müşterinin kalan kullanılabilir risk limiti (${availableCredit.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL), teklif tutarından (${grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${symbol}) azdır. Risk limiti aşılacağı için teklif oluşturulamaz.`;
          riskAlert.style.display = 'flex';
        }
      } else {
        if (riskAlert) riskAlert.style.display = 'none';
      }
    }

    // Initialize with 1 empty row on page load
    addNewRow();

    const form = document.getElementById('quotationForm');
    if (form) {
      form.addEventListener('submit', function (e) {
        recalculate();
        if (globalSpecialPriceViolation) {
          e.preventDefault();
          alert(globalSpecialPriceViolation);
          return false;
        }

        const payload = document.getElementById('itemsJsonInput').value;
        let arr = [];
        try { arr = JSON.parse(payload); } catch (err) { arr = []; }

        if (!arr || arr.length === 0) {
          e.preventDefault();
          alert('⚠️ Lütfen teklife en az 1 adet geçerli stok kalemi ekleyiniz!');
          switchQuoteTab(2);
          return false;
        }

        const grandTotal = parseFloat(document.getElementById('displayGrandTotal').textContent.replace(/[^0-9,-]+/g, "").replace(',', '.')) || 0;
        const availableCredit = selectedCustomerCreditLimit - selectedCustomerCurrentBalance;
        if (selectedCustomerCreditLimit > 0 && grandTotal > availableCredit) {
          e.preventDefault();
          alert(`⚠️ Risk Limiti Aşımı! Müşterinin kalan kullanılabilir risk limiti (${availableCredit.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL), teklif tutarından azdır. Teklif oluşturulamaz!`);
          return false;
        }
      });
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>

</html>