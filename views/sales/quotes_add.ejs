<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Satış Teklifi Oluştur — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/quotes/add" class="mss-sub-link active">➕ Yeni Teklif Oluştur</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Sales_Manager') { %>
          <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div class="page-header">
        <div>
          <h1>Yeni Satış Teklifi Hazırla</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Müşteriye iletilecek teklif şartlarını, geçerlilik süresini ve özel iskonto oranını girin.</p>
        </div>
        <a href="/sales/quotes" class="btn btn-secondary">◀ Teklif Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div class="error" style="margin-bottom: 1.5rem;"><%= error %></div>
      <% } %>

      <div class="form-panel">
        <form action="/sales/quotes/add" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;">
          
          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="quotationNo">Teklif No <span class="req-star">*</span></label>
              <input type="text" id="quotationNo" name="quotationNo" value="<%= nextQuotationNo %>" required readonly style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(255,255,255,0.05);">
            </div>
            <div class="input-group">
              <label for="customerId">Cari Müşteri Seçimi</label>
              <select id="customerId" name="customerId" onchange="fillCustomerName(this)">
                <option value="">-- Genel / Kayıtsız Müşteri --</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>" data-name="<%= c.companyName %>">[<%= c.customerCode %>] <%= c.companyName %> (Risk: <%= c.riskLevel %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="input-group">
              <label for="customerName">Müşteri / Kurum Unvanı <span class="req-star">*</span></label>
              <input type="text" id="customerName" name="customerName" required placeholder="Müşteri adını girin">
            </div>
          </div>

          <div class="form-grid form-grid--2">
            <div class="input-group">
              <label for="quotationDate">Teklif Tarihi</label>
              <input type="date" id="quotationDate" name="quotationDate" value="<%= new Date().toISOString().split('T')[0] %>" required>
            </div>
            <div class="input-group">
              <label for="validUntil">Geçerlilik Son Tarihi <span class="req-star">*</span></label>
              <input type="date" id="validUntil" name="validUntil" required>
            </div>
          </div>

          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="stockItemId">Teklif Verilecek Ürün (Mamul) <span class="req-star">*</span></label>
              <select id="stockItemId" name="stockItemId" required onchange="updatePrice(this)">
                <option value="" disabled selected>-- Ürün Seçiniz --</option>
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>" data-price="<%= item.salePrice %>">[<%= item.stockCode %>] <%= item.name %> (Fiyat: <%= item.salePrice %> <%= item.currency %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="input-group">
              <label for="quantity">Miktar <span class="req-star">*</span></label>
              <input type="number" step="0.01" id="quantity" name="quantity" value="1.0" required oninput="calcTotals()">
            </div>
            <div class="input-group">
              <label for="unitPrice">Birim Teklif Fiyatı <span class="req-star">*</span></label>
              <input type="number" step="0.01" id="unitPrice" name="unitPrice" value="0.00" required oninput="calcTotals()">
            </div>
          </div>

          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="discountRate">Özel İskonto Oranı (%) <small style="color: var(--amber);">(>%20 Yönetici Onayı İster)</small></label>
              <input type="number" step="0.01" id="discountRate" name="discountRate" value="0.00" oninput="calcTotals()">
            </div>
            <div class="input-group">
              <label for="taxRate">KDV Oranı (%)</label>
              <input type="number" step="0.01" id="taxRate" name="taxRate" value="20.00" oninput="calcTotals()">
            </div>
            <div class="input-group">
              <label for="currency">Para Birimi</label>
              <select id="currency" name="currency">
                <option value="TRY">TRY (₺)</option>
                <option value="USD">USD ($)</option>
                <option value="EUR">EUR (€)</option>
              </select>
            </div>
          </div>

          <div style="background: rgba(15, 23, 42, 0.6); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--border); display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center;">
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">Ara Toplam</span>
              <strong id="displaySubtotal" style="font-size: 1.1rem; color: #fff;">0.00 TL</strong>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">İskonto Tutarı</span>
              <strong id="displayDiscount" style="font-size: 1.1rem; color: var(--pink);">0.00 TL</strong>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">KDV Tutarı</span>
              <strong id="displayTax" style="font-size: 1.1rem; color: var(--indigo);">0.00 TL</strong>
            </div>
            <div>
              <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">Genel Toplam</span>
              <strong id="displayTotal" style="font-size: 1.3rem; color: var(--emerald);">0.00 TL</strong>
            </div>
          </div>

          <div class="input-group">
            <label for="notes">Teklif Şartları / Notlar</label>
            <textarea id="notes" name="notes" rows="3" placeholder="Örn: Fiyatlarımıza kargo dahil değildir. Teslim süresi 7 iş günüdür."></textarea>
          </div>

          <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-warning">📜 Teklifi Kaydet ve Oluştur</button>
            <a href="/sales/quotes" class="btn btn-secondary">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function fillCustomerName(sel) {
      const opt = sel.options[sel.selectedIndex];
      if (opt && opt.dataset.name) {
        document.getElementById('customerName').value = opt.dataset.name;
      }
      checkCustomerSpecialPrice();
    }

    function updatePrice(sel) {
      const opt = sel.options[sel.selectedIndex];
      if (opt && opt.dataset.price) {
        document.getElementById('unitPrice').value = opt.dataset.price;
        calcTotals();
      }
      checkCustomerSpecialPrice();
    }

    async function checkCustomerSpecialPrice() {
      const customerId = document.getElementById('customerId').value;
      const stockItemId = document.getElementById('stockItemId').value;

      if (customerId && stockItemId) {
        try {
          const res = await fetch(`/sales/api/customer-price?customerId=${customerId}&stockItemId=${stockItemId}`);
          const data = await res.json();
          if (data.success && data.hasSpecialPrice) {
            document.getElementById('unitPrice').value = data.specialPrice;
            if (data.customDiscountRate > 0) {
              document.getElementById('discountRate').value = data.customDiscountRate;
            }
            if (data.currency) {
              document.getElementById('currency').value = data.currency;
            }
            calcTotals();
          }
        } catch (e) {
          console.error(e);
        }
      }
    }

    function calcTotals() {
      const q = parseFloat(document.getElementById('quantity').value) || 0;
      const p = parseFloat(document.getElementById('unitPrice').value) || 0;
      const d = parseFloat(document.getElementById('discountRate').value) || 0;
      const t = parseFloat(document.getElementById('taxRate').value) || 20;

      const sub = q * p;
      const disc = sub * (d / 100);
      const afterDisc = sub - disc;
      const tax = afterDisc * (t / 100);
      const tot = afterDisc + tax;

      document.getElementById('displaySubtotal').textContent = sub.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' TL';
      document.getElementById('displayDiscount').textContent = disc.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' TL';
      document.getElementById('displayTax').textContent = tax.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' TL';
      document.getElementById('displayTotal').textContent = tot.toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' TL';
    }

    // Default valid until date set to +15 days
    const future = new Date();
    future.setDate(future.getDate() + 15);
    document.getElementById('validUntil').value = future.toISOString().split('T')[0];

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
