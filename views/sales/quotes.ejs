<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teklif ve Fiyatlandırma Yönetimi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link active">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/quotes/add" class="mss-sub-link">➕ Yeni Teklif Oluştur</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/sales/analytics" class="msn-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="msn-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/quotes" class="msn-link active">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="msn-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="msn-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="msn-link">🧾 Satış Faturaları</a>
        <a href="/sales/customers" class="msn-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="msn-link">💰 Özel Fiyat Listeleri</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Teklif ve Fiyatlandırma Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Müşterilere sunulan özel fiyat listeleri, iskonto oranları ve dövizli satış teklifleri.</p>
        </div>
        <a href="/sales/quotes/add" class="btn btn-warning">➕ Yeni Satış Teklifi Oluştur</a>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Teklif No</th>
              <th>Müşteri / Firma</th>
              <th>Teklif Verilen Ürünler</th>
              <th>Miktar</th>
              <th>Toplam İskonto</th>
              <th>Genel Toplam</th>
              <th>Geçerlilik Tarihi</th>
              <th>Durum</th>
              <th>İşlem</th>
            </tr>
          </thead>
          <tbody>
            <% if (quotations.length === 0) { %>
              <tr>
                <td colspan="9" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  Henüz kayıtlı satış teklifi bulunmamaktadır.
                </td>
              </tr>
            <% } else { %>
              <% quotations.forEach(q => { 
                let itemsList = [];
                if (q.itemsJson) {
                  try { itemsList = JSON.parse(q.itemsJson); } catch (e) { itemsList = []; }
                }
                if (!Array.isArray(itemsList) || itemsList.length === 0) {
                  itemsList = [{
                    stockCode: q.stockItem ? q.stockItem.stockCode : '-',
                    name: q.stockItem ? q.stockItem.name : 'Ürün Kalemi',
                    quantity: q.quantity,
                    unitPrice: q.unitPrice,
                    discountRate: q.discountRate,
                    taxRate: q.taxRate,
                    subtotal: q.subtotal,
                    totalAmount: q.totalAmount
                  }];
                }
              %>
                <tr>
                  <td><strong style="color: var(--pink); font-family: 'JetBrains Mono', monospace;"><%= q.quotationNo %></strong></td>
                  <td><strong><%= q.customerName %></strong></td>
                  <td>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                      <% itemsList.forEach(it => { %>
                        <div style="font-weight: 500; color: var(--text-primary); font-size: 0.875rem;"><%= it.name %></div>
                      <% }); %>
                    </div>
                  </td>
                  <td>
                    <div style="display: flex; flex-direction: column; gap: 4px; font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: var(--text-secondary);">
                      <% itemsList.forEach(it => { %>
                        <div><%= parseFloat(it.quantity).toLocaleString('tr-TR') %> Adet</div>
                      <% }); %>
                    </div>
                  </td>
                  <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #fb7185; font-weight: 600;">
                    <%= parseFloat(q.discountAmount || 0).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= q.currency %>
                  </td>
                  <td><strong style="color: var(--emerald); font-family: 'JetBrains Mono', monospace;"><%= parseFloat(q.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= q.currency %></strong></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(q.validUntil).toLocaleDateString('tr-TR') %></td>
                  <td>
                    <% if (q.status === 'Converted') { %>
                      <span class="status-pill status-active">● Siparişe Dönüştü</span>
                    <% } else if (q.status === 'Approved') { %>
                      <span class="status-pill status-approved">● Onaylandı</span>
                    <% } else if (q.status === 'Pending_Approval') { %>
                      <span class="status-pill status-pending">● Yönetsel Onay Bekliyor</span>
                    <% } else if (q.status === 'Rejected') { %>
                      <span class="status-pill status-rejected">● Reddedildi</span>
                    <% } else { %>
                      <span class="status-pill status-pending">● <%= q.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <div style="display:flex; gap: 4px; align-items: center;">
                      <a href="/sales/quotes/<%= q.id %>" class="btn btn-sm btn-outline-info" style="font-size: 0.75rem;">👁️ Gör</a>
                      <% if (q.status === 'Approved') { %>
                        <form action="/sales/quotes/<%= q.id %>/convert" method="POST" style="display:inline;">
                          <button type="submit" class="btn btn-sm btn-success" style="font-size: 0.75rem;">🛍️ Dönüştür</button>
                        </form>
                      <% } else if (q.status === 'Pending_Approval') { %>
                        <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 600;" title="Yönetsel Onay Ekranından Onay Verilmelidir">
                          ⏳ Onay Bekliyor
                        </span>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
