<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teklif ve Fiyatlandırma Yönetimi — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <!-- Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link active">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/quotes/add" class="mss-sub-link">➕ Yeni Teklif Oluştur</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Teklif ve Fiyatlandırma Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Müşterilere sunulan özel fiyat listeleri, iskonto oranları ve dövizli satış teklifleri.</p>
        </div>
        <a href="/sales/quotes/add" class="btn btn-warning">➕ Yeni Satış Teklifi Oluştur</a>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Teklif No</th>
              <th>Müşteri / Firma</th>
              <th>Teklif Verilen Ürünler</th>
              <th>Miktar</th>
              <th>Toplam İskonto</th>
              <th>Genel Toplam</th>
              <th>Geçerlilik Tarihi</th>
              <th>Durum</th>
              <th>İşlem</th>
            </tr>
          </thead>
          <tbody>
            <% if (quotations.length === 0) { %>
              <tr>
                <td colspan="9" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  Henüz kayıtlı satış teklifi bulunmamaktadır.
                </td>
              </tr>
            <% } else { %>
              <% 
                const safeFloat = (val, defaultVal = 0) => {
                  if (val === null || val === undefined || val === '' || val === 'null' || val === 'undefined' || val === 'NaN') return defaultVal;
                  const n = parseFloat(val);
                  return Number.isNaN(n) ? defaultVal : n;
                };

                quotations.forEach(q => { 
                  const qNo = q.teklifNo || q.quotationNo || 'TEKLIF-000';
                  const cName = q.musteriAdi || q.customerName || (q.musteri ? (q.musteri.firmaAdi || q.musteri.companyName) : 'Müşteri');
                  const tTotal = safeFloat(q.toplamTutar !== undefined ? q.toplamTutar : q.totalAmount, 0);
                  const dAmount = safeFloat(q.iskontoTutari !== undefined ? q.iskontoTutari : q.discountAmount, 0);
                  const curr = q.paraBirimi || q.currency || 'TRY';
                  const vUntil = q.gecerlilikBitis || q.validUntil;
                  const st = q.durum || q.status || 'Draft';

                  let itemsList = [];
                  const rawJson = q.kalemlerJson || q.itemsJson;
                  if (rawJson) {
                    try {
                      const parsed = typeof rawJson === 'string' ? JSON.parse(rawJson) : rawJson;
                      if (Array.isArray(parsed)) {
                        itemsList = parsed.filter(it => it && (it.ad || it.name || it.stokId || it.stockItemId));
                      }
                    } catch (e) { itemsList = []; }
                  }
                  if (!Array.isArray(itemsList) || itemsList.length === 0) {
                    const sObj = q.stokKarti || q.stockItem;
                    itemsList = [{
                      stockCode: sObj ? (sObj.stokKodu || sObj.stockCode || '-') : '-',
                      stokKodu: sObj ? (sObj.stokKodu || sObj.stockCode || '-') : '-',
                      name: sObj ? (sObj.ad || sObj.name || 'Ürün Kalemi') : 'Ürün Kalemi',
                      ad: sObj ? (sObj.ad || sObj.name || 'Ürün Kalemi') : 'Ürün Kalemi',
                      birim: sObj ? (sObj.birim || 'Adet') : 'Adet',
                      unit: sObj ? (sObj.birim || 'Adet') : 'Adet',
                      quantity: q.miktar || q.quantity || 1,
                      unitPrice: q.birimFiyat || q.unitPrice || 0,
                      discountRate: q.iskontoOrani || q.discountRate || 0,
                      taxRate: q.kdvOrani || q.taxRate || 20,
                      subtotal: q.araToplam || q.subtotal || 0,
                      totalAmount: tTotal
                    }];
                  }
              %>
                <tr>
                  <td><strong style="color: var(--pink); font-family: 'JetBrains Mono', monospace;"><%= qNo %></strong></td>
                  <td><strong><%= cName %></strong></td>
                  <td>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                      <% itemsList.forEach(it => { 
                        let name = (it.ad || it.name || '').trim();
                        let code = (it.stokKodu || it.stockCode || '').trim();

                        if (!name || name === 'Ürün Kalemi' || name === 'Seçilen Ürün') {
                          if (it.stokKarti && it.stokKarti.ad) name = it.stokKarti.ad;
                        }
                        if (!code || code === '—' || code === 'STOK-N/A') {
                          if (it.stokKarti && it.stokKarti.stokKodu) code = it.stokKarti.stokKodu;
                        }
                        if (!name) name = 'Ürün Kalemi';
                      %>
                        <div style="font-weight: 600; color: var(--text-primary); font-size: 0.85rem;">
                          <% if (code) { %><span style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: #f472b6; font-weight: 700;">[<%= code %>]</span> <% } %>
                          <%= name %>
                        </div>
                      <% }); %>
                    </div>
                  </td>
                  <td>
                    <div style="display: flex; flex-direction: column; gap: 4px; font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: var(--text-secondary);">
                      <% itemsList.forEach(it => { 
                        const qty = safeFloat(it.quantity !== undefined ? it.quantity : it.miktar, 1);
                        const unit = it.birim || it.unit || 'Adet';
                      %>
                        <div><strong><%= qty.toLocaleString('tr-TR') %></strong> <%= unit %></div>
                      <% }); %>
                    </div>
                  </td>
                  <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #fb7185; font-weight: 600;">
                    <%= dAmount.toLocaleString('tr-TR', {minimumFractionDigits:2, maximumFractionDigits:2}) %> <%= curr %>
                  </td>
                  <td><strong style="color: var(--emerald); font-family: 'JetBrains Mono', monospace;"><%= tTotal.toLocaleString('tr-TR', {minimumFractionDigits:2, maximumFractionDigits:2}) %> <%= curr %></strong></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= vUntil ? new Date(vUntil).toLocaleDateString('tr-TR') : 'Süresiz' %></td>
                  <td>
                    <% if (st === 'Converted' || st === 'Siparişe Dönüştü') { %>
                      <span class="status-pill status-active">● Siparişe Dönüştü</span>
                    <% } else if (st === 'Approved') { %>
                      <span class="status-pill status-approved">● Yönetsel Onaylı</span>
                    <% } else if (st === 'Pending_Approval' || st === 'Onay Bekliyor') { %>
                      <span class="status-pill status-pending" title="<%= q.onayNedeni || 'İskonto veya tutar limiti nedeniyle onay bekliyor' %>">
                        ● Yönetsel Onay Bekliyor
                      </span>
                    <% } else if (st === 'Rejected' || st === 'Reddedildi') { %>
                      <span class="status-pill status-rejected">● Reddedildi</span>
                    <% } else { %>
                      <span class="status-pill status-approved">● Onaylı</span>
                    <% } %>
                  </td>
                  <td>
                    <div style="display:flex; gap: 4px; align-items: center;">
                      <a href="/sales/quotes/<%= q.id %>" class="btn btn-sm btn-outline-info" style="font-size: 0.75rem;">👁️ Gör</a>

                      <% if (st === 'Approved') { %>
                        <!-- ACTIVE & CLICKABLE DISPATCH BUTTON ONLY IF APPROVED -->
                        <form action="/sales/quotes/<%= q.id %>/convert" method="POST" style="display:inline;">
                          <button type="submit" class="btn btn-sm btn-success" style="font-size: 0.75rem; font-weight: 700;">🛍️ Siparişe Dönüştür</button>
                        </form>
                      <% } else if (st === 'Pending_Approval' || st === 'Onay Bekliyor') { %>
                        <!-- DISABLED / NON-CLICKABLE IF PENDING APPROVAL (e.g. Discount > 20%) -->
                        <button type="button" class="btn btn-sm" disabled style="background: rgba(245, 158, 11, 0.12); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); font-size: 0.75rem; font-weight: 600; cursor: not-allowed; opacity: 0.7;" title="İskonto oranı %20'den yüksek olduğu için Yönetsel Onaylar ekranından onaylanmadan siparişe dönüştürülemez!">
                          ⏳ Onay Bekliyor (%20+ İskonto)
                        </button>
                      <% } else if (st === 'Converted' || st === 'Siparişe Dönüştü') { %>
                        <span style="font-size: 0.75rem; color: var(--emerald); font-weight: 600; padding: 4px 8px; background: rgba(16, 185, 129, 0.1); border-radius: 6px;">
                          ✓ Siparişte
                        </span>
                      <% } else { %>
                        <form action="/sales/quotes/<%= q.id %>/convert" method="POST" style="display:inline;">
                          <button type="submit" class="btn btn-sm btn-success" style="font-size: 0.75rem; font-weight: 700;">🛍️ Siparişe Dönüştür</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
