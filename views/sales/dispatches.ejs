<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sevkiyat ve Teslimat (Dağıtım) Planlaması — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .glass-form-card {
      background: rgba(12, 17, 28, 0.75);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(16px);
      padding: 1.75rem;
      position: relative;
      overflow: hidden;
      margin-bottom: 2rem;
    }
    .glass-form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #ec4899 0%, #8b5cf6 50%, #10b981 100%);
    }
    .section-divider {
      font-size: 0.8rem;
      font-weight: 800;
      color: #818cf8;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin: 1rem 0 0.5rem 0;
      padding-bottom: 4px;
      border-bottom: 1px dashed rgba(255,255,255,0.1);
      display: flex;
      align-items: center;
      gap: 8px;
    }
  </style>
</head>
<body class="module-body">

  <!-- Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link active">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a>
        <% } %>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/sales/analytics" class="msn-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="msn-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/quotes" class="msn-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="msn-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="msn-link active">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="msn-link">🧾 Satış Faturaları</a>
        <a href="/sales/customers" class="msn-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="msn-link">💰 Özel Fiyat Listeleri</a>
      </div>

      <div class="page-header" style="margin-bottom: 1.5rem;">
        <div>
          <h1 style="font-weight: 900;">Sevkiyat ve Teslimat (Sevk İrsaliyesi) Planlaması</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Resmi 8 ana standart bölümü içeren, A4 siyah-beyaz baskıya uygun Sevk İrsaliyesi oluşturma paneli.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="error" style="margin-bottom: 1.5rem;"><%= error %></div>
      <% } %>

      <!-- Quick Dispatch Creation Form -->
      <div class="glass-form-card">
        <h3 style="color: #ec4899; font-size: 1.1rem; font-weight: 800; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          🚚 Yeni Resmi Sevk İrsaliyesi Oluştur
        </h3>
        
        <form action="/sales/dispatches/add" method="POST" id="dispatchForm" style="display: flex; flex-direction: column; gap: 1rem;">
          <input type="hidden" name="itemsJson" id="dispatchItemsJsonInput" value="[]">

          <!-- 1. İRSALİYE BAŞLIK & SİPARİŞ SEÇİMİ -->
          <div class="section-divider">📌 1. İRSALİYE VE SİPARİŞ BAŞLIK BİLGİLERİ</div>
          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="saleOrderId">Sevkiyat Yapılacak Sipariş <span class="req-star">*</span></label>
              <select id="saleOrderId" name="saleOrderId" required onchange="onOrderSelect(this)">
                <option value="" disabled selected>-- Durumu Tamamlandı Olmayan Siparişi Seçiniz --</option>
                <% openOrders.forEach(o => { 
                  let itemCount = 1;
                  if (o.itemsJson) {
                    try { const arr = JSON.parse(o.itemsJson); if (Array.isArray(arr)) itemCount = arr.length; } catch (e) {}
                  }
                %>
                  <option value="<%= o.id %>">
                    [<%= o.orderNo %>] <%= o.customerName %> — <%= Number(o.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= o.currency %> (<%= itemCount %> Kalem Ürün • Statü: <%= o.status === 'Pending_Approval' ? 'Onay Bekliyor' : o.status === 'Approved' ? 'Onaylandı' : o.status === 'Preparing' ? 'Hazırlanıyor' : o.status %>)
                  </option>
                <% }); %>
              </select>
            </div>
            <div class="input-group">
              <label for="dispatchType">İrsaliye Türü <span class="req-star">*</span></label>
              <select id="dispatchType" name="dispatchType" required>
                <option value="Satış İrsaliyesi" selected>Satış İrsaliyesi</option>
                <option value="Transfer İrsaliyesi">Transfer İrsaliyesi</option>
                <option value="Alış İrsaliyesi">Alış İrsaliyesi</option>
                <option value="İade İrsaliyesi">İade İrsaliyesi</option>
              </select>
            </div>
            <div class="input-group">
              <label for="shipmentDate">Sevk Tarihi <span class="req-star">*</span></label>
              <input type="date" id="shipmentDate" name="shipmentDate" value="<%= new Date().toISOString().split('T')[0] %>" required>
            </div>
          </div>

          <!-- 2. TESLİMAT & DEPO BİLGİLERİ -->
          <div class="section-divider">🏠 2. TESLİMAT VE DEPO BİLGİLERİ</div>
          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="exitWarehouse">Çıkış Deposu <span class="req-star">*</span></label>
              <select id="exitWarehouse" name="exitWarehouse" required>
                <option value="Merkez Lojistik Deposu" selected>Merkez Lojistik Deposu</option>
                <option value="Mamul Ürün Deposu">Mamul Ürün Deposu</option>
                <option value="Kadıköy Sevkiyat Deposu">Kadıköy Sevkiyat Deposu</option>
                <option value="Yedek Parça Deposu">Yedek Parça Deposu</option>
              </select>
            </div>
            <div class="input-group">
              <label for="recipientPerson">Teslim Alan Kişi / Yetkili</label>
              <input type="text" id="recipientPerson" name="recipientPerson" placeholder="Örn: Ahmet Yılmaz (Satın Alma Müdürü)">
            </div>
            <div class="input-group">
              <label for="deliveryType">Teslim Şekli</label>
              <select id="deliveryType" name="deliveryType">
                <option value="Adrese Teslim / Sevkiyat" selected>Adrese Teslim / Sevkiyat</option>
                <option value="Kargo ile Gönderim">Kargo ile Gönderim</option>
                <option value="Ambar Teslim">Ambar Teslim</option>
                <option value="Müşteri Depodan Teslim Alacak">Müşteri Depodan Teslim Alacak</option>
              </select>
            </div>
          </div>

          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="deliveryCity">Teslimat İli</label>
              <input type="text" id="deliveryCity" name="deliveryCity" placeholder="Örn: İstanbul">
            </div>
            <div class="input-group">
              <label for="deliveryDistrict">Teslimat İlçesi</label>
              <input type="text" id="deliveryDistrict" name="deliveryDistrict" placeholder="Örn: Ümraniye">
            </div>
            <div class="input-group">
              <label for="projectNo">Proje / Referans No (Varsa)</label>
              <input type="text" id="projectNo" name="projectNo" placeholder="Örn: PRJ-2026-99">
            </div>
          </div>

          <!-- 3. SEVKİYAT VE LOJİSTİK BİLGİLERİ -->
          <div class="section-divider">🚛 3. SEVKİYAT VE TAŞIYICI BİLGİLERİ</div>
          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="carrierCompany">Lojistik / Kargo Firması</label>
              <input type="text" id="carrierCompany" name="carrierCompany" placeholder="Örn: Horoz Lojistik / Kendi Aracımız">
            </div>
            <div class="input-group">
              <label for="vehiclePlate">Araç Plakası</label>
              <input type="text" id="vehiclePlate" name="vehiclePlate" placeholder="Örn: 34 ABC 789">
            </div>
            <div class="input-group">
              <label for="driverName">Sürücü Adı / TCKN</label>
              <input type="text" id="driverName" name="driverName" placeholder="Örn: Mustafa Kılıç / 12345678901">
            </div>
          </div>

          <div class="form-grid form-grid--2">
            <div class="input-group">
              <label for="trackingNo">Lojistik Takip No <small style="color: var(--text-muted);">(Otomatik)</small></label>
              <input type="text" id="trackingNo" name="trackingNo" value="<%= nextTrackingNo %>" readonly required style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(99, 102, 241, 0.1); color: #818cf8; border-color: rgba(99, 102, 241, 0.3); cursor: not-allowed;">
            </div>
            <div class="input-group">
              <label for="notes">İrsaliye Notu / Açıklama</label>
              <input type="text" id="notes" name="notes" placeholder="Örn: Parçalı sevkiyat: Kargo ile gönderildi. Eksik ürün daha sonra sevk edilecektir.">
            </div>
          </div>

          <!-- DYNAMIC DISPATCH PRODUCTS TABLE -->
          <div id="dispatchItemsCard" style="display: none; margin-top: 0.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <h4 style="font-size: 0.95rem; font-weight: 800; color: #fff; margin: 0; display: flex; align-items: center; gap: 8px;">
                <span>📦</span> Siparişteki Ürünler ve Parçalı Sevk Miktarı Belirleme
              </h4>
              <span style="font-size: 0.75rem; color: #fbbf24; font-weight: 600;">💡 Fiyatsız Mal Teslim Belgesi: Tekil ürünler 0 girilebilir. Tüm ürünler 0 olamaz.</span>
            </div>

            <div style="overflow-x: auto; border-radius: 12px; border: 1px solid var(--border); background: rgba(6, 8, 15, 0.8);">
              <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="dispatchItemsTable">
                <thead>
                  <tr style="background: rgba(19, 26, 43, 0.9); border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px;">
                    <th style="padding: 12px 14px; width: 40px; text-align: center;">#</th>
                    <th style="padding: 12px 14px; min-width: 220px;">Ürün / Mamul Kalemi</th>
                    <th style="padding: 12px 14px; width: 140px; text-align: center;">Sipariş Miktarı</th>
                    <th style="padding: 12px 14px; width: 180px; text-align: center;">Sevk Edilecek Miktar</th>
                    <th style="padding: 12px 14px; min-width: 200px;">Miktar Doğrulama Durumu</th>
                  </tr>
                </thead>
                <tbody id="dispatchItemsTbody">
                  <!-- Dynamic rows generated on order selection -->
                </tbody>
              </table>
            </div>
          </div>

          <div style="margin-top: 0.75rem;">
            <button type="submit" class="btn btn-lg" style="background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%); border: none; font-weight: 700; padding: 12px 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(236, 72, 153, 0.35); gap: 10px;">
              📜 Resmi Sevk İrsaliyesini Kes ve Stoktan Düş
            </button>
          </div>
        </form>
      </div>

      <!-- Dispatch Notes Table -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: #fff; margin: 0;">📜 Kesilmiş Sevk İrsaliyeleri Listesi</h3>
        <span style="font-size: 0.85rem; color: var(--text-muted);">Toplam <%= dispatches.length %> İrsaliye Kaydı</span>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>İrsaliye No</th>
              <th>Tür</th>
              <th>Sipariş No</th>
              <th>Müşteri / Kurum</th>
              <th>Sevk Tarihi</th>
              <th>Çıkış Deposu</th>
              <th>Lojistik / Plaka</th>
              <th>Takip No</th>
              <th>Durum</th>
              <th>İşlem</th>
            </tr>
          </thead>
          <tbody>
            <% if (dispatches.length === 0) { %>
              <tr>
                <td colspan="10" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  Henüz kesilmiş sevk irsaliyesi bulunmamaktadır.
                </td>
              </tr>
            <% } else { %>
              <% dispatches.forEach(d => { %>
                <tr>
                  <td><strong style="color: #ec4899; font-family: 'JetBrains Mono', monospace;"><%= d.dispatchNo %></strong></td>
                  <td><span class="status-pill" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;"><%= d.dispatchType || 'Satış İrsaliyesi' %></span></td>
                  <td><span style="font-family: 'JetBrains Mono', monospace; color: #818cf8;"><%= d.saleOrder ? d.saleOrder.orderNo : '—' %></span></td>
                  <td><strong><%= d.customerName %></strong></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(d.dispatchDate).toLocaleDateString('tr-TR') %></td>
                  <td style="font-size: 0.85rem; color: #cbd5e1;"><%= d.exitWarehouse || 'Merkez Depo' %></td>
                  <td><%= (d.carrierCompany || 'Kendi Aracımız') + (d.vehiclePlate ? ' (' + d.vehiclePlate + ')' : '') %></td>
                  <td><strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= d.trackingNo || '—' %></strong></td>
                  <td>
                    <span class="status-pill status-active">● Sevk Edildi</span>
                  </td>
                  <td>
                    <a href="/sales/dispatches/<%= d.id %>" class="btn btn-sm btn-outline-info" style="font-size: 0.75rem;">📄 Resmi A4 İrsaliye Gör</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    window.openOrdersCatalog = <%- JSON.stringify(openOrders || []) %>;

    function onOrderSelect(sel) {
      const orderId = parseInt(sel.value, 10);
      const itemsCard = document.getElementById('dispatchItemsCard');
      const tbody = document.getElementById('dispatchItemsTbody');

      if (!orderId || isNaN(orderId)) {
        if (itemsCard) itemsCard.style.display = 'none';
        return;
      }

      const order = window.openOrdersCatalog.find(o => o.id === orderId);
      if (!order) {
        if (itemsCard) itemsCard.style.display = 'none';
        return;
      }

      // Auto-fill delivery recipient if present
      if (order.customerName && document.getElementById('recipientPerson')) {
        document.getElementById('recipientPerson').value = order.customerName;
      }

      let itemsList = [];
      if (order.itemsJson) {
        try { itemsList = JSON.parse(order.itemsJson); } catch (e) { itemsList = []; }
      }

      if (!Array.isArray(itemsList) || itemsList.length === 0) {
        itemsList = [{
          stockItemId: order.stockItemId,
          stockCode: order.stockItem ? order.stockItem.stockCode : '-',
          name: order.stockItem ? order.stockItem.name : 'Ürün Kalemi',
          quantity: order.quantity || 1,
          unitPrice: order.unitPrice || 0
        }];
      }

      tbody.innerHTML = '';

      itemsList.forEach((it, idx) => {
        const orderedQty = parseFloat(it.quantity) || 1;
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid var(--border)';

        tr.innerHTML = `
          <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-muted);">${idx + 1}</td>
          <td style="padding: 12px 14px;">
            <strong style="color: #fff; font-size: 0.9rem;">${it.name}</strong>
            ${it.stockCode ? `<div style="font-size: 0.75rem; color: var(--text-muted); font-family: 'JetBrains Mono', monospace;">Kod: ${it.stockCode}</div>` : ''}
            <input type="hidden" class="item-stock-id" value="${it.stockItemId || ''}">
            <input type="hidden" class="item-stock-code" value="${it.stockCode || ''}">
            <input type="hidden" class="item-name" value="${it.name || ''}">
            <input type="hidden" class="item-unit-price" value="${it.unitPrice || 0}">
            <input type="hidden" class="item-ordered-qty" value="${orderedQty}">
          </td>
          <td style="padding: 12px 14px; text-align: center;">
            <span style="background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 4px 10px; border-radius: 8px; font-weight: 700; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; border: 1px solid rgba(99, 102, 241, 0.3);">
              ${orderedQty.toLocaleString('tr-TR')} Adet
            </span>
          </td>
          <td style="padding: 12px 14px; text-align: center;">
            <input type="number" step="0.01" min="0" max="${orderedQty}" value="${orderedQty}" class="dispatch-qty-input" oninput="validateRowQty(this, ${orderedQty})" style="width: 120px; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-size: 0.9rem; font-weight: 700; text-align: center;">
          </td>
          <td style="padding: 12px 14px;" class="row-status-col">
            <span class="status-valid-badge" style="color: #34d399; font-weight: 600; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 4px;">
              ✓ Uygundur (Max: ${orderedQty} Adet)
            </span>
          </td>
        `;

        tbody.appendChild(tr);
      });

      if (itemsCard) itemsCard.style.display = 'block';
      updateDispatchItemsPayload();
    }

    function validateRowQty(inputEl, maxOrderedQty) {
      const val = parseFloat(inputEl.value);
      const tr = inputEl.closest('tr');
      const statusCol = tr ? tr.querySelector('.row-status-col') : null;

      if (isNaN(val) || val < 0) {
        inputEl.style.borderColor = '#f59e0b';
        inputEl.style.boxShadow = 'none';
        if (statusCol) {
          statusCol.innerHTML = `
            <span style="color: #fbbf24; font-weight: 600; font-size: 0.8rem;">
              ⚠️ Miktar 0 veya daha büyük olmalıdır.
            </span>
          `;
        }
      } else if (val > maxOrderedQty) {
        inputEl.style.borderColor = '#f43f5e';
        inputEl.style.boxShadow = '0 0 10px rgba(244, 63, 94, 0.4)';
        if (statusCol) {
          statusCol.innerHTML = `
            <span style="color: #f43f5e; font-weight: 700; font-size: 0.8rem; background: rgba(244, 63, 94, 0.1); padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(244, 63, 94, 0.3);">
              ⚠️ Miktar Aşımı! Max ${maxOrderedQty} Adet sevk edilebilir.
            </span>
          `;
        }
      } else if (val === 0) {
        inputEl.style.borderColor = '#f59e0b';
        inputEl.style.boxShadow = 'none';
        if (statusCol) {
          statusCol.innerHTML = `
            <span style="color: #fbbf24; font-weight: 600; font-size: 0.8rem; background: rgba(245, 158, 11, 0.1); padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(245, 158, 11, 0.3);">
              ● 0 Adet (Bu sevkiyatta gönderilmeyecek)
            </span>
          `;
        }
      } else {
        inputEl.style.borderColor = 'var(--border)';
        inputEl.style.boxShadow = 'none';
        if (statusCol) {
          statusCol.innerHTML = `
            <span style="color: #34d399; font-weight: 600; font-size: 0.8rem;">
              ✓ Uygundur (Max: ${maxOrderedQty} Adet)
            </span>
          `;
        }
      }

      updateDispatchItemsPayload();
    }

    function updateDispatchItemsPayload() {
      const rows = document.querySelectorAll('#dispatchItemsTbody tr');
      const itemsPayload = [];

      rows.forEach(tr => {
        const sId = tr.querySelector('.item-stock-id').value;
        const sCode = tr.querySelector('.item-stock-code').value;
        const name = tr.querySelector('.item-name').value;
        const uPrice = parseFloat(tr.querySelector('.item-unit-price').value) || 0;
        const oQty = parseFloat(tr.querySelector('.item-ordered-qty').value) || 0;
        const dInput = tr.querySelector('.dispatch-qty-input');
        const dQty = dInput ? parseFloat(dInput.value) || 0 : 0;

        itemsPayload.push({
          stockItemId: sId,
          stockCode: sCode,
          name: name,
          unitPrice: uPrice,
          orderedQuantity: oQty,
          dispatchQuantity: dQty
        });
      });

      document.getElementById('dispatchItemsJsonInput').value = JSON.stringify(itemsPayload);
    }

    const dForm = document.getElementById('dispatchForm');
    if (dForm) {
      dForm.addEventListener('submit', function(e) {
        updateDispatchItemsPayload();
        const sel = document.getElementById('saleOrderId');
        if (!sel || !sel.value) {
          e.preventDefault();
          alert('⚠️ Lütfen sevkiyat yapılacak siparişi seçiniz.');
          return false;
        }

        const rows = document.querySelectorAll('#dispatchItemsTbody tr');
        let hasExceedError = false;
        let grandTotalDispatched = 0;

        rows.forEach(tr => {
          const name = tr.querySelector('.item-name').value;
          const oQty = parseFloat(tr.querySelector('.item-ordered-qty').value) || 0;
          const dInput = tr.querySelector('.dispatch-qty-input');
          const dQty = dInput ? parseFloat(dInput.value) || 0 : 0;

          if (dQty > oQty) {
            hasExceedError = true;
            alert(`⚠️ HATA: "${name}" ürünü için girilen sevk miktarı (${dQty} Adet), sipariş miktarını (${oQty} Adet) geçemez!`);
            if (dInput) dInput.focus();
          }

          grandTotalDispatched += dQty;
        });

        if (hasExceedError) {
          e.preventDefault();
          return false;
        }

        if (grandTotalDispatched <= 0) {
          e.preventDefault();
          alert('⚠️ HATA: Tüm ürünlerin sevk miktarı 0 olamaz. İrsaliye kesmek için en az 1 üründen sevk miktarı girilmelidir!');
          return false;
        }
      });
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
