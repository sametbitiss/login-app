<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satış Teklifini Düzenle <%= quote.teklifNo || quote.quotationNo %> — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <style>
    .glass-form-card {
      background: rgba(12, 17, 28, 0.85);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(20px);
      padding: 2rem;
      position: relative;
      overflow: hidden;
      margin-bottom: 2.5rem;
    }

    .glass-form-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #f59e0b 0%, #8b5cf6 50%, #10b981 100%);
    }

    /* Tab Timeline / Step Progress Styling */
    .step-progress-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 2rem;
    }

    .step-progress-item {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 12px 16px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      user-select: none;
    }

    .step-progress-item:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.15);
      transform: translateY(-2px);
    }

    .step-progress-item.active {
      background: rgba(245, 158, 11, 0.12);
      border-color: #f59e0b;
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
    }

    .step-progress-item.completed {
      background: rgba(16, 185, 129, 0.08);
      border-color: rgba(16, 185, 129, 0.4);
    }

    .spi-badge {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.875rem;
      flex-shrink: 0;
      transition: all 0.3s ease;
    }

    .step-progress-item.active .spi-badge {
      background: #f59e0b;
      color: #000;
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    }

    .step-progress-item.completed .spi-badge {
      background: #10b981;
      color: #fff;
    }

    .spi-text {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .spi-text strong {
      font-size: 0.85rem;
      color: #fff;
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }

    .spi-text span {
      font-size: 0.725rem;
      color: var(--text-muted);
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }

    .step-progress-item.active .spi-text span {
      color: #fbbf24;
    }

    .tab-content-panel {
      display: none;
      animation: fadeInTab 0.35s ease-in-out;
    }

    .tab-content-panel.active {
      display: block;
    }

    @keyframes fadeInTab {
      from {
        opacity: 0;
        transform: translateY(6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 768px) {
      .step-progress-bar {
        grid-template-columns: 1fr;
      }
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>

<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="8" fill="url(#bGrad)" />
          <path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
          <defs>
            <linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32">
              <stop offset="0%" stop-color="#6366f1" />
              <stop offset="100%" stop-color="#8b5cf6" />
            </linearGradient>
          </defs>
        </svg>
        <span>Enterprise ERP</span>
      </a>
    </div>
    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>
      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>
      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link active">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/quotes/add" class="mss-sub-link">➕ Yeni Teklif Oluştur</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>
      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %><a href="/admin" class="mt-link">Sistem Yönetimi</a><% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %><a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a><% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
            <a href="/sales/quotes" style="color: var(--text-muted); text-decoration: none;">📜 Teklif Yönetimi</a>
            <span>/</span>
            <span style="color: #f59e0b; font-weight: 600;">Teklif Düzenleme</span>
          </div>
          <h1 style="font-size: 1.75rem; font-weight: 900; color: #fff; margin: 0;">
            ✏️ [<%= quote.teklifNo || quote.quotationNo %>] Teklif Düzenleme
          </h1>
        </div>
        <div style="display: flex; gap: 10px;">
          <a href="/sales/quotes/<%= quote.id %>" class="btn btn-secondary" style="border-radius: 10px; font-weight: 600;">
            👁️ Teklifi İncele
          </a>
          <a href="/sales/quotes" class="btn btn-secondary" style="border-radius: 10px; font-weight: 600;">
            ← Listeye Dön
          </a>
        </div>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem; padding: 14px 20px; border-radius: 12px; font-weight: 600; display: flex; align-items: center; gap: 10px; background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); color: #f43f5e;">
          <span style="font-size: 1.25rem;">⚠️</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <div class="glass-form-card">
        <!-- 3-STEP PROGRESS TIMELINE -->
        <div class="step-progress-bar">
          <div class="step-progress-item active" id="tab-pill-1" onclick="switchQuoteTab(1)">
            <div class="spi-badge">1</div>
            <div class="spi-text">
              <strong>Müşteri & Şartlar</strong>
              <span>Cari, Sevkiyat, Vade</span>
            </div>
          </div>
          <div class="step-progress-item" id="tab-pill-2" onclick="switchQuoteTab(2)">
            <div class="spi-badge">2</div>
            <div class="spi-text">
              <strong>Mamul Kalemleri</strong>
              <span>Mamul Ürünler, Fiyat & İskonto</span>
            </div>
          </div>
          <div class="step-progress-item" id="tab-pill-3" onclick="switchQuoteTab(3)">
            <div class="spi-badge">3</div>
            <div class="spi-text">
              <strong>Teklif Koşulları</strong>
              <span>Teslimat & Genel Şartlar</span>
            </div>
          </div>
        </div>

        <form action="/sales/quotes/<%= quote.id %>/edit" method="POST" id="quotationForm">
          <input type="hidden" name="itemsJson" id="itemsJsonInput" value="">
          <input type="hidden" name="teklifNo" value="<%= quote.teklifNo || quote.quotationNo %>">

          <!-- TAB CONTENT 1: MÜŞTERİ VE TEMEL BİLGİLER -->
          <div class="tab-content-panel active" id="quote-tab-1">
            <h4 style="font-size: 0.95rem; font-weight: 800; color: #f59e0b; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
              <span>🏢</span> 1. Müşteri (Cari Hesap) ve İletişim Bilgileri
            </h4>

            <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
              <div class="input-group">
                <label for="customerId">Kayıtlı Cari Hesap Seçimi</label>
                <select id="customerId" name="customerId" onchange="fillCustomerName(this)">
                  <option value="">— Genel / Yeni Müşteri —</option>
                  <% (customers || []).forEach(c => { 
                    const score = c.musteriSkoru !== undefined ? c.musteriSkoru : 85;
                    const riskLvl = c.riskSeviyesi || c.riskLevel || 'Normal';
                    const isBlocked = score < 50 || riskLvl === 'High' || riskLvl === 'Blocked' || riskLvl === 'Critical';
                    const isSelected = String(quote.musteriId) === String(c.id);
                  %>
                    <option value="<%= c.id %>" <%= isSelected ? 'selected' : '' %>
                      data-name="<%= c.firmaAdi || c.companyName %>"
                      data-contactperson="<%= c.yetkiliKisi || c.contactPerson || '' %>"
                      data-phone="<%= c.telefon || c.phone || '' %>"
                      data-email="<%= c.eposta || c.email || '' %>"
                      data-address="<%= c.adres || c.address || '' %>"
                      data-score="<%= score %>"
                      data-risk="<%= riskLvl %>"
                      data-blocked="<%= isBlocked %>"
                      data-creditlimit="<%= c.krediLimiti || c.creditLimit || 0 %>"
                      data-currentbalance="<%= c.guncelBakiye || c.currentBalance || 0 %>">
                      [<%= c.musteriKodu || c.customerCode %>] <%= c.firmaAdi || c.companyName %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="input-group">
                <label for="customerName">Müşteri / Firma Unvanı <span style="color: #f43f5e;">*</span></label>
                <input type="text" id="customerName" name="customerName" value="<%= quote.musteriAdi || quote.customerName || '' %>" required>
              </div>

              <div class="input-group">
                <label for="contactPerson">Yetkili / İlgili Kişi</label>
                <input type="text" id="contactPerson" name="contactPerson" value="<%= quote.ilgiliKisi || quote.contactPerson || '' %>">
              </div>
            </div>

            <div class="form-grid form-grid--2" style="margin-bottom: 1.25rem;">
              <div class="input-group">
                <label for="billingAddress">Fatura Adresi</label>
                <input type="text" id="billingAddress" name="billingAddress" value="<%= quote.faturaAdresi || quote.billingAddress || '' %>">
              </div>

              <div class="input-group">
                <label for="shippingAddress">Teslimat / Sevk Adresi</label>
                <input type="text" id="shippingAddress" name="shippingAddress" value="<%= quote.sevkAdresi || quote.shippingAddress || '' %>">
              </div>
            </div>

            <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
              <div class="input-group">
                <label for="quotationDate">Teklif Tarihi <span style="color: #f43f5e;">*</span></label>
                <input type="date" id="quotationDate" name="quotationDate" value="<%= quote.teklifTarihi || new Date().toISOString().split('T')[0] %>" required>
              </div>

              <div class="input-group">
                <label for="validUntil">Geçerlilik Bitiş Tarihi <span style="color: #f43f5e;">*</span></label>
                <input type="date" id="validUntil" name="validUntil" value="<%= quote.gecerlilikBitis || '' %>" required>
              </div>

              <div class="input-group">
                <label for="currency">Teklif Para Birimi <span style="color: #f43f5e;">*</span></label>
                <select id="currency" name="currency" onchange="recalculate()">
                  <option value="TRY" <%= (quote.paraBirimi || 'TRY') === 'TRY' ? 'selected' : '' %>>TRY (₺) - Türk Lirası</option>
                  <option value="USD" <%= (quote.paraBirimi || 'TRY') === 'USD' ? 'selected' : '' %>>USD ($) - Amerikan Doları</option>
                  <option value="EUR" <%= (quote.paraBirimi || 'TRY') === 'EUR' ? 'selected' : '' %>>EUR (€) - Euro</option>
                </select>
              </div>
            </div>
          </div>

          <!-- TAB CONTENT 2: MAMUL ÜRÜN KALEMLERİ -->
          <div class="tab-content-panel" id="quote-tab-2">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 10px;">
              <div>
                <h4 style="font-size: 0.95rem; font-weight: 800; color: #818cf8; margin: 0; display: flex; align-items: center; gap: 8px;">
                  <span>📦</span> 2. Teklif Edilen Mamul Ürünler
                </h4>
                <p style="font-size: 0.78rem; color: var(--text-muted); margin: 3px 0 0 0;">
                  Satış modülünde sadece <strong style="color: #818cf8;">Mamul</strong> türündeki ürünler listelenir ve tekliflendirilir.
                </p>
              </div>
              <button type="button" class="btn btn-primary" onclick="openProductSelectModal()" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: #fff; font-weight: 700; border: none; padding: 9px 18px; border-radius: 10px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);">
                <span>🔍</span> Mamul Ürün Seç (Modal)
              </button>
            </div>

            <div class="table-wrapper" style="margin-bottom: 1.5rem; background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px solid var(--border);">
              <table class="data-table" id="itemsTable" style="width: 100%;">
                <thead>
                  <tr style="background: rgba(30, 41, 59, 0.6);">
                    <th style="width: 45px; text-align: center;">#</th>
                    <th>Ürün Adı & Stok Kodu</th>
                    <th style="width: 110px;">Miktar</th>
                    <th style="width: 130px;">Birim Fiyat</th>
                    <th style="width: 105px;">Döviz</th>
                    <th style="width: 100px;">İskonto (%)</th>
                    <th style="width: 90px;">KDV (%)</th>
                    <th style="width: 140px; text-align: right;">Satır Toplamı</th>
                    <th style="width: 50px; text-align: center;">İşlem</th>
                  </tr>
                </thead>
                <tbody id="itemsTbody">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
            </div>

            <!-- SUMMARY TOTALS BOX -->
            <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 20px; margin-top: 1.5rem;">
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; text-align: center;">
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 6px;">Ara Toplam (Brüt)</span>
                  <strong id="displaySubtotal" style="font-size: 1.25rem; color: #fff; font-family: 'JetBrains Mono', monospace;">0.00 ₺</strong>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: #fb7185; text-transform: uppercase; display: block; margin-bottom: 6px;">Toplam İskonto</span>
                  <strong id="displayDiscount" style="font-size: 1.25rem; color: #fb7185; font-family: 'JetBrains Mono', monospace;">- 0.00 ₺</strong>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 6px;">Hesaplanan KDV</span>
                  <strong id="displayTax" style="font-size: 1.25rem; color: #fff; font-family: 'JetBrains Mono', monospace;">0.00 ₺</strong>
                </div>
                <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%); padding: 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.3);">
                  <span style="font-size: 0.75rem; font-weight: 700; color: #818cf8; text-transform: uppercase; display: block; margin-bottom: 6px;">GENEL TOPLAM</span>
                  <strong id="displayGrandTotal" style="font-size: 1.35rem; color: #818cf8; font-family: 'JetBrains Mono', monospace;">0.00 ₺</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB CONTENT 3: TEKLİF ŞARTLARI VE NOTLAR -->
          <div class="tab-content-panel" id="quote-tab-3">
            <h4 style="font-size: 0.95rem; font-weight: 800; color: #10b981; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
              <span>📝</span> 3. Teklif Koşulları, Teslimat Şartları ve Özel Notlar
            </h4>

            <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
              <div class="input-group">
                <label for="paymentTerm">Ödeme Koşulu</label>
                <select id="paymentTerm" name="paymentTerm">
                  <option value="Peşin" <%= quote.odemeVadesi === 'Peşin' ? 'selected' : '' %>>Peşin (Ön Ödeme)</option>
                  <option value="30 Gün Vadeli" <%= (!quote.odemeVadesi || quote.odemeVadesi === '30 Gün Vadeli') ? 'selected' : '' %>>30 Gün Vadeli</option>
                  <option value="60 Gün Vadeli" <%= quote.odemeVadesi === '60 Gün Vadeli' ? 'selected' : '' %>>60 Gün Vadeli</option>
                  <option value="90 Gün Vadeli" <%= quote.odemeVadesi === '90 Gün Vadeli' ? 'selected' : '' %>>90 Gün Vadeli</option>
                  <option value="%50 Peşin, %50 Teslimatta" <%= quote.odemeVadesi === '%50 Peşin, %50 Teslimatta' ? 'selected' : '' %>>%50 Peşin, %50 Teslimatta</option>
                </select>
              </div>
              <div class="input-group">
                <label for="deliveryTerm">Sevkiyat & Teslimat Süresi</label>
                <input type="text" id="deliveryTerm" name="deliveryTerm" value="<%= quote.istenenTerminTarihi || 'Sipariş onayından sonra 7 iş günü içinde adrese teslim.' %>">
              </div>
              <div class="input-group">
                <label for="deliveryTerms">Teslimat Şekli</label>
                <input type="text" id="deliveryTerms" name="deliveryTerms" value="<%= quote.teslimatSekli || 'Fabrika Teslim (EXW)' %>">
              </div>
            </div>

            <div class="input-group">
              <label for="notes">Teklif Notları & Müşteriye Özel Şartlar</label>
              <textarea id="notes" name="notes" rows="4"><%= quote.notlar || quote.notes || '' %></textarea>
            </div>
          </div>

          <!-- BOTTOM TAB NAVIGATION BAR -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.08);">
            <button type="button" class="btn btn-outline-secondary" id="btnPrevStep" onclick="navigateQuoteStep(-1)" style="display: none; font-weight: 600; padding: 10px 22px; border-radius: 10px;">
              ← Önceki Adım
            </button>
            <div id="stepCounterBadge" style="font-size: 0.825rem; color: var(--text-muted); font-weight: 600;">
              Adım 1 / 3
            </div>
            <div>
              <button type="button" class="btn btn-primary" id="btnNextStep" onclick="navigateQuoteStep(1)" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); border: none; font-weight: 700; padding: 10px 24px; border-radius: 10px;">
                Sonraki Adım →
              </button>
              <button type="submit" class="btn btn-lg" id="btnSubmitQuote" style="display: none; background: linear-gradient(135deg, #f59e0b 0%, #ec4899 100%); color: #fff; border: none; font-weight: 700; padding: 12px 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(245, 158, 11, 0.35); gap: 10px;">
                💾 Güncellenmiş Teklifi Kaydet
              </button>
            </div>
          </div>

        </form>
      </div>
    </main>
  </div>

  <!-- Stock Item Master Catalog JSON Data (ONLY MAMUL) -->
  <script id="stockCatalogData" type="application/json">
    <%- JSON.stringify(stockItems || []) %>
  </script>
  <!-- Initial Items Data -->
  <script id="initialItemsData" type="application/json">
    <%- JSON.stringify(items || []) %>
  </script>
  <!-- Customer Price Lists Master JSON Data -->
  <script id="priceListsData" type="application/json">
    <%- JSON.stringify(priceLists || []) %>
  </script>

  <script>
    const stockCatalog = JSON.parse(document.getElementById('stockCatalogData').textContent || '[]');
    const initialItems = JSON.parse(document.getElementById('initialItemsData').textContent || '[]');
    const priceListsCatalog = JSON.parse(document.getElementById('priceListsData').textContent || '[]');

    let currentStep = 1;
    const totalSteps = 3;
    let rowIdCounter = 0;

    function switchQuoteTab(stepNum) {
      if (stepNum < 1 || stepNum > totalSteps) return;
      currentStep = stepNum;

      for (let i = 1; i <= totalSteps; i++) {
        const panel = document.getElementById(`quote-tab-${i}`);
        const pill = document.getElementById(`tab-pill-${i}`);
        if (panel) {
          if (i === stepNum) panel.classList.add('active');
          else panel.classList.remove('active');
        }
        if (pill) {
          if (i === stepNum) pill.classList.add('active');
          else {
            pill.classList.remove('active');
            if (i < stepNum) pill.classList.add('completed');
          }
        }
      }

      const btnPrev = document.getElementById('btnPrevStep');
      const btnNext = document.getElementById('btnNextStep');
      const btnSubmit = document.getElementById('btnSubmitQuote');
      const counterBadge = document.getElementById('stepCounterBadge');

      if (btnPrev) btnPrev.style.display = currentStep > 1 ? 'inline-flex' : 'none';

      if (currentStep === totalSteps) {
        if (btnNext) btnNext.style.display = 'none';
        if (btnSubmit) btnSubmit.style.display = 'inline-flex';
      } else {
        if (btnNext) btnNext.style.display = 'inline-flex';
        if (btnSubmit) btnSubmit.style.display = 'none';
      }

      if (counterBadge) counterBadge.textContent = `Adım ${currentStep} / ${totalSteps}`;
    }

    function navigateQuoteStep(direction) {
      if (direction === 1 && currentStep === 1) {
        const custNameInput = document.getElementById('customerName');
        if (!custNameInput || !custNameInput.value.trim()) {
          alert('⚠️ Lütfen önce Müşteri Unvanını giriniz veya Cari seçiniz.');
          if (custNameInput) custNameInput.focus();
          return;
        }
      }
      switchQuoteTab(currentStep + direction);
    }

    function fillCustomerName(selectEl) {
      const selectedOption = selectEl.options[selectEl.selectedIndex];
      if (!selectedOption || !selectedOption.value) return;

      const name = selectedOption.getAttribute('data-name') || '';
      const contactPerson = selectedOption.getAttribute('data-contactperson') || '';
      const address = selectedOption.getAttribute('data-address') || '';

      if (name) document.getElementById('customerName').value = name;
      if (contactPerson) document.getElementById('contactPerson').value = contactPerson;
      if (address) {
        document.getElementById('billingAddress').value = address;
        document.getElementById('shippingAddress').value = address;
      }
    }

    function addNewRow(initialData = null) {
      rowIdCounter++;
      const tbody = document.getElementById('itemsTbody');

      const tr = document.createElement('tr');
      tr.id = `row-${rowIdCounter}`;

      const stockId = initialData ? (initialData.stockItemId || initialData.stokId) : null;
      const st = (stockCatalog || []).find(s => String(s.id) === String(stockId));
      const code = initialData ? (initialData.stockCode || initialData.stokKodu || (st ? st.stokKodu : '')) : (st ? st.stokKodu : '');
      const name = initialData ? (initialData.name || initialData.ad || (st ? st.ad : '')) : (st ? st.ad : '');

      const qty = initialData ? (initialData.quantity !== undefined ? initialData.quantity : initialData.miktar) : 1;
      const price = initialData ? (initialData.unitPrice !== undefined ? initialData.unitPrice : initialData.birimFiyat) : (st ? parseFloat(st.satisFiyati || 0) : 0);
      const itemCurr = initialData ? (initialData.currency || initialData.paraBirimi || 'TRY') : (st ? (st.paraBirimi || 'TRY') : 'TRY');
      const discount = initialData ? (initialData.discountRate !== undefined ? initialData.discountRate : initialData.iskontoOrani) : 0;
      const tax = initialData ? (initialData.taxRate !== undefined ? initialData.taxRate : initialData.kdvOrani) : (st ? (st.kdvOrani || 20) : 20);

      tr.innerHTML = `
        <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-muted);" class="row-index">1</td>
        <td style="padding: 12px 14px;">
          <input type="hidden" class="item-stock-id" value="${stockId || ''}" data-code="${code}" data-name="${name}">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.775rem; color: #818cf8; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.25); padding: 4px 10px; border-radius: 8px; font-weight: 700; flex-shrink: 0;">
              ${code || 'STOK-N/A'}
            </span>
            <strong style="color: #fff; font-size: 0.925rem; font-weight: 600; line-height: 1.3;">${name || 'Seçilen Ürün'}</strong>
          </div>
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0.01" value="${qty}" class="item-qty" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 8px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0" value="${price}" class="item-price" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 8px; text-align: right; font-family: 'JetBrains Mono', monospace;">
        </td>
        <td style="padding: 12px 14px;">
          <select class="item-currency" onchange="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #818cf8; padding: 8px 10px; border-radius: 8px; font-weight: 700; font-family: 'JetBrains Mono', monospace; outline: none; cursor: pointer;">
            <option value="TRY" ${itemCurr === 'TRY' ? 'selected' : ''}>TRY (₺)</option>
            <option value="USD" ${itemCurr === 'USD' ? 'selected' : ''}>USD ($)</option>
            <option value="EUR" ${itemCurr === 'EUR' ? 'selected' : ''}>EUR (€)</option>
          </select>
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.1" min="0" max="100" value="${discount}" class="item-discount" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fb7185; padding: 8px 10px; border-radius: 8px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.1" min="0" max="100" value="${tax}" class="item-tax" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 8px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
        </td>
        <td style="padding: 12px 14px; text-align: right;">
          <strong class="item-total" style="font-family: 'JetBrains Mono', monospace; color: #fff; font-size: 0.95rem;">0.00 ₺</strong>
        </td>
        <td style="padding: 12px 14px; text-align: center;">
          <button type="button" onclick="removeRow(${rowIdCounter})" class="btn-delete-row" title="Ürünü Tekliften Çıkar" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.3); color: #f43f5e; width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;">
            ✕
          </button>
        </td>
      `;

      tbody.appendChild(tr);
      updateRowIndices();
      recalculate();
    }

    function removeRow(rowId) {
      const row = document.getElementById(`row-${rowId}`);
      if (row) row.remove();
      updateRowIndices();
      recalculate();
    }

    function updateRowIndices() {
      const rows = document.querySelectorAll('#itemsTbody tr');
      rows.forEach((r, idx) => {
        const idxCell = r.querySelector('.row-index');
        if (idxCell) idxCell.textContent = idx + 1;
      });
    }

    function recalculate() {
      const rows = document.querySelectorAll('#itemsTbody tr');
      let grandSubtotal = 0;
      let grandDiscount = 0;
      let grandTax = 0;
      let grandTotal = 0;
      const itemsArr = [];

      rows.forEach(r => {
        const stockInput = r.querySelector('.item-stock-id');
        const qtyInput = r.querySelector('.item-qty');
        const priceInput = r.querySelector('.item-price');
        const discInput = r.querySelector('.item-discount');
        const taxInput = r.querySelector('.item-tax');
        const currSelect = r.querySelector('.item-currency');
        const totalDisplay = r.querySelector('.item-total');

        const stockId = stockInput ? stockInput.value : '';
        const qty = parseFloat(qtyInput?.value) || 0;
        const price = parseFloat(priceInput?.value) || 0;
        const discount = parseFloat(discInput?.value) || 0;
        const tax = parseFloat(taxInput?.value) || 0;
        const curr = currSelect ? currSelect.value : 'TRY';

        const rowSubtotal = qty * price;
        const rowDiscount = rowSubtotal * (discount / 100);
        const rowTaxable = rowSubtotal - rowDiscount;
        const rowTax = rowTaxable * (tax / 100);
        const rowTotal = rowTaxable + rowTax;

        if (totalDisplay) {
          totalDisplay.textContent = `${rowTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ₺`;
        }

        grandSubtotal += rowSubtotal;
        grandDiscount += rowDiscount;
        grandTax += rowTax;
        grandTotal += rowTotal;

        if (stockId) {
          itemsArr.push({
            stockItemId: parseInt(stockId, 10),
            stokId: parseInt(stockId, 10),
            stockCode: stockInput.dataset.code || '',
            stokKodu: stockInput.dataset.code || '',
            name: stockInput.dataset.name || '',
            ad: stockInput.dataset.name || '',
            quantity: qty,
            miktar: qty,
            unitPrice: price,
            birimFiyat: price,
            discountRate: discount,
            iskontoOrani: discount,
            taxRate: tax,
            kdvOrani: tax,
            subtotal: rowSubtotal,
            araToplam: rowSubtotal,
            discountAmount: rowDiscount,
            iskontoTutari: rowDiscount,
            taxAmount: rowTax,
            kdvTutari: rowTax,
            totalAmount: rowTotal,
            toplamTutar: rowTotal,
            currency: curr
          });
        }
      });

      document.getElementById('displaySubtotal').textContent = `${grandSubtotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ₺`;
      document.getElementById('displayDiscount').textContent = `- ${grandDiscount.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ₺`;
      document.getElementById('displayTax').textContent = `${grandTax.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ₺`;
      document.getElementById('displayGrandTotal').textContent = `${grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ₺`;

      document.getElementById('itemsJsonInput').value = JSON.stringify(itemsArr);
    }

    // --- PRODUCT SELECTION MODAL (STRICTLY MAMUL) ---
    function openProductSelectModal() {
      const modal = document.getElementById('productSelectModal');
      if (!modal) return;
      document.getElementById('modalProductSearch').value = '';
      document.getElementById('modalProductSort').value = 'ad_asc';
      document.getElementById('modalSelectAllChk').checked = false;
      modal.style.display = 'flex';
      renderModalProducts();
      setTimeout(() => {
        const searchInput = document.getElementById('modalProductSearch');
        if (searchInput) searchInput.focus();
      }, 100);
    }

    function closeProductSelectModal() {
      const modal = document.getElementById('productSelectModal');
      if (modal) modal.style.display = 'none';
    }

    function getAlreadyAddedStockIds() {
      const stockInputs = document.querySelectorAll('#itemsTbody .item-stock-id');
      const ids = [];
      stockInputs.forEach(inp => {
        const val = parseInt(inp.value, 10);
        if (val && !isNaN(val)) ids.push(val);
      });
      return ids;
    }

    function renderModalProducts() {
      const tbody = document.getElementById('modalProductsTbody');
      if (!tbody) return;

      const alreadyAddedIds = getAlreadyAddedStockIds();
      const searchVal = (document.getElementById('modalProductSearch')?.value || '').toLowerCase().trim();
      const sortVal = document.getElementById('modalProductSort')?.value || 'ad_asc';

      // Strictly filter only MAMUL products AND EXCLUDE already added items!
      let items = (stockCatalog || []).filter(item => {
        const isMamul = (item.kategori || '').toLowerCase() === 'mamul';
        if (!isMamul) return false;
        const itemId = parseInt(item.id, 10);
        if (alreadyAddedIds.includes(itemId)) return false;
        const code = (item.stokKodu || item.stockCode || '').toLowerCase();
        const name = (item.ad || item.name || '').toLowerCase();
        return code.includes(searchVal) || name.includes(searchVal);
      });

      items.sort((a, b) => {
        const codeA = (a.stokKodu || a.stockCode || '').toLowerCase();
        const codeB = (b.stokKodu || b.stockCode || '').toLowerCase();
        const nameA = (a.ad || a.name || '').toLowerCase();
        const nameB = (b.ad || b.name || '').toLowerCase();

        if (sortVal === 'stokKodu_asc') return codeA.localeCompare(codeB, 'tr', { numeric: true });
        if (sortVal === 'stokKodu_desc') return codeB.localeCompare(codeA, 'tr', { numeric: true });
        if (sortVal === 'ad_desc') return nameB.localeCompare(nameA, 'tr');
        return nameA.localeCompare(nameB, 'tr');
      });

      if (items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="padding: 40px; text-align: center; color: var(--text-muted);">
              🔍 Arama kriterlerine uygun mamul stok ürünü bulunamadı.
            </td>
          </tr>
        `;
        updateModalSelectedCount();
        return;
      }

      tbody.innerHTML = items.map(st => {
        const code = st.stokKodu || st.stockCode || '';
        const name = st.ad || st.name || '';
        const category = st.kategori || 'Mamul';
        const price = parseFloat(st.satisFiyati || st.salePrice || 0);
        const stock = parseFloat(st.mevcutStok || st.currentStock || 0);
        const unit = st.birim || 'Adet';

        return `
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.04)'" onmouseout="this.style.background='transparent'">
            <td style="padding: 10px 14px; text-align: center;">
              <input type="checkbox" class="modal-product-chk" data-id="${st.id}" onchange="updateModalSelectedCount()" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;">
            </td>
            <td style="padding: 10px 14px; font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: #818cf8; font-weight: 600;">
              ${code}
            </td>
            <td style="padding: 10px 14px; font-weight: 600; color: #fff;">
              ${name}
            </td>
            <td style="padding: 10px 14px;">
              <span style="background: rgba(99, 102, 241, 0.12); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.2); padding: 2px 8px; border-radius: 8px; font-size: 0.75rem; font-weight: 600;">
                ${category}
              </span>
            </td>
            <td style="padding: 10px 14px; text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fff;">
              ${price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ₺
            </td>
            <td style="padding: 10px 14px; text-align: center; font-size: 0.8rem; color: ${stock > 0 ? '#34d399' : '#fb7185'}; font-weight: 600;">
              ${stock} ${unit}
            </td>
            <td style="padding: 10px 14px; text-align: center;">
              <input type="number" min="0.01" step="1" value="1" class="modal-product-qty" data-id="${st.id}" style="width: 75px; background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 4px 8px; border-radius: 6px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
            </td>
          </tr>
        `;
      }).join('');

      updateModalSelectedCount();
    }

    function toggleSelectAllModalProducts(mainChk) {
      const checkboxes = document.querySelectorAll('.modal-product-chk');
      checkboxes.forEach(chk => chk.checked = mainChk.checked);
      updateModalSelectedCount();
    }

    function updateModalSelectedCount() {
      const checkedCount = document.querySelectorAll('.modal-product-chk:checked').length;
      const badge = document.getElementById('modalSelectedCountBadge');
      if (badge) badge.textContent = `${checkedCount} Ürün Seçildi`;
    }

    function addSelectedProductsToQuote() {
      const checkedChks = document.querySelectorAll('.modal-product-chk:checked');
      if (checkedChks.length === 0) {
        alert('⚠️ Lütfen teklife eklemek istediğiniz en az 1 ürün işaretleyiniz.');
        return;
      }

      checkedChks.forEach(chk => {
        const stockId = chk.getAttribute('data-id');
        const item = (stockCatalog || []).find(s => String(s.id) === String(stockId));
        if (!item) return;

        const qtyInput = document.querySelector(`.modal-product-qty[data-id="${stockId}"]`);
        const qty = qtyInput ? (parseFloat(qtyInput.value) || 1) : 1;

        addNewRow({
          stockItemId: item.id,
          stokId: item.id,
          stockCode: item.stokKodu || '',
          stokKodu: item.stokKodu || '',
          name: item.ad || '',
          ad: item.ad || '',
          quantity: qty,
          unitPrice: parseFloat(item.satisFiyati || 0),
          discountRate: 0,
          taxRate: parseFloat(item.kdvOrani || 20)
        });
      });

      closeProductSelectModal();
      recalculate();
    }

    // Load initial items
    if (initialItems && initialItems.length > 0) {
      initialItems.forEach(it => addNewRow(it));
    }

    const form = document.getElementById('quotationForm');
    if (form) {
      form.addEventListener('submit', function (e) {
        recalculate();
        const payload = document.getElementById('itemsJsonInput').value;
        let arr = [];
        try { arr = JSON.parse(payload); } catch (err) { arr = []; }

        if (!arr || arr.length === 0) {
          e.preventDefault();
          alert('⚠️ Lütfen teklife en az 1 adet geçerli stok kalemi ekleyiniz!');
          switchQuoteTab(2);
          return false;
        }
      });
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>

  <!-- PRODUCT ITEM SELECTION MODAL -->
  <div id="productSelectModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(12px); z-index: 9999; display: none; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; width: 100%; max-width: 950px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7); position: relative;">
      
      <!-- Modal Header -->
      <div style="padding: 20px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: space-between; background: rgba(15, 23, 42, 0.95);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 1.5rem; background: rgba(99, 102, 241, 0.15); width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(99, 102, 241, 0.3);">📦</span>
          <div>
            <h2 style="font-size: 1.25rem; font-weight: 800; color: #fff; margin: 0;">Stok Kartlarından Mamul Ürün Seçimi</h2>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">Teklife eklemek istediğiniz mamul ürünleri arayabilir ve çoklu seçim ile ekleyebilirsiniz.</p>
          </div>
        </div>
        <button type="button" onclick="closeProductSelectModal()" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: var(--text-muted); width: 36px; height: 36px; border-radius: 10px; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; cursor: pointer;">✕</button>
      </div>

      <!-- Modal Search & Filter Controls -->
      <div style="padding: 16px 24px; background: rgba(30, 41, 59, 0.5); border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
        <div style="flex: 1; min-width: 250px; position: relative;">
          <input type="text" id="modalProductSearch" oninput="renderModalProducts()" placeholder="🔍 Ürün adı veya stok numarası ile arayın..." style="width: 100%; padding: 10px 14px 10px 38px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.875rem; outline: none;">
          <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;">🔍</span>
        </div>

        <div style="width: 320px;">
          <select id="modalProductSort" onchange="renderModalProducts()" style="width: 100%; padding: 10px 14px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.85rem; outline: none; font-weight: 600;">
            <option value="ad_asc" selected>🔤 Ürün İsmine Göre: A'dan Z'ye</option>
            <option value="ad_desc">🔤 Ürün İsmine Göre: Z'den A'ya</option>
            <option value="stokKodu_asc">🔢 Stok Numarasına Göre: Küçükten Büyüğe</option>
            <option value="stokKodu_desc">🔢 Stok Numarasına Göre: Büyükten Küçüğe</option>
          </select>
        </div>
      </div>

      <!-- Modal Product List Table -->
      <div style="flex: 1; overflow-y: auto; padding: 16px 24px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="modalProductsTable">
          <thead>
            <tr style="background: rgba(30, 41, 59, 0.8); border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; position: sticky; top: 0; z-index: 10;">
              <th style="padding: 12px 14px; width: 45px; text-align: center;">
                <input type="checkbox" id="modalSelectAllChk" onchange="toggleSelectAllModalProducts(this)" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;">
              </th>
              <th style="padding: 12px 14px; width: 150px;">Stok Kodu</th>
              <th style="padding: 12px 14px;">Ürün / Mamul Adı</th>
              <th style="padding: 12px 14px; width: 110px;">Kategori</th>
              <th style="padding: 12px 14px; width: 120px; text-align: right;">Birim Fiyat</th>
              <th style="padding: 12px 14px; width: 110px; text-align: center;">Stok</th>
              <th style="padding: 12px 14px; width: 110px; text-align: center;">Eklenecek Miktar</th>
            </tr>
          </thead>
          <tbody id="modalProductsTbody">
            <!-- Rendered dynamically -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div style="padding: 16px 24px; border-top: 1px solid rgba(255, 255, 255, 0.1); background: rgba(15, 23, 42, 0.95); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;" id="modalSelectedCountBadge">
          0 Ürün Seçildi
        </div>
        <div style="display: flex; gap: 12px;">
          <button type="button" class="btn btn-secondary" onclick="closeProductSelectModal()" style="padding: 10px 20px; border-radius: 10px;">İptal</button>
          <button type="button" class="btn btn-primary" onclick="addSelectedProductsToQuote()" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 700; padding: 10px 24px; border-radius: 10px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);">
            ✅ Seçilen Ürünleri Teklife Ekle
          </button>
        </div>
      </div>

    </div>
  </div>
</body>

</html>
