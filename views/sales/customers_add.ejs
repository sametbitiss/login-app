<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Müşteri Kartı Ekle — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/customers/add" class="mss-sub-link active">➕ Yeni Müşteri Ekle</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a>
        <% } %>
        <% if (user.role === 'Admin' || user.role === 'Sales_Manager') { %>
          <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div class="page-header">
        <div>
          <h1>Yeni Cari Müşteri Kartı Oluştur</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Müşteri unvanı, iletişim bilgileri, vergi dairesi ve kredi risk limitlerini tanımlayın.</p>
        </div>
        <a href="/sales/customers" class="btn btn-secondary">◀ Müşteri Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div class="error" style="margin-bottom: 1.5rem;"><%= error %></div>
      <% } %>

      <div class="form-panel">
        <form action="/sales/customers/add" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;">
          
          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="customerCode">Cari Kodu <span class="req-star">*</span></label>
              <input type="text" id="customerCode" name="customerCode" value="<%= nextCode %>" required readonly style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(255,255,255,0.05);">
            </div>
            <div class="input-group">
              <label for="companyName">Firma / Kurum Ticari Unvanı <span class="req-star">*</span></label>
              <input type="text" id="companyName" name="companyName" required placeholder="Örn: ABC Sanayi ve Ticaret A.Ş.">
            </div>
            <div class="input-group">
              <label for="contactPerson">Yetkili Kişi (İsim Soyisim)</label>
              <input type="text" id="contactPerson" name="contactPerson" placeholder="Örn: Selin Demir">
            </div>
          </div>

          <div class="form-grid form-grid--4">
            <div class="input-group">
              <label for="taxOffice">Vergi Dairesi</label>
              <input type="text" id="taxOffice" name="taxOffice" placeholder="Örn: Maslak Vergi Dairesi">
            </div>
            <div class="input-group">
              <label for="taxNo">Vergi No / TCKN</label>
              <input type="text" id="taxNo" name="taxNo" placeholder="Örn: 1234567890">
            </div>
            <div class="input-group">
              <label for="email">E-Posta Adresi</label>
              <input type="email" id="email" name="email" placeholder="satinalma@firma.com">
            </div>
            <div class="input-group">
              <label for="phone">Telefon Numarası</label>
              <input type="text" id="phone" name="phone" placeholder="+90 (212) 555 0000">
            </div>
          </div>

          <div class="form-grid form-grid--3">
            <div class="input-group">
              <label for="creditLimit">Müşteri Risk Kredi Limiti (TL) <span class="req-star">*</span></label>
              <input type="number" step="0.01" id="creditLimit" name="creditLimit" value="100000.00" required>
            </div>
            <div class="input-group">
              <label for="paymentTermDays">Varsayılan Ödeme Vadesi (Gün)</label>
              <input type="number" id="paymentTermDays" name="paymentTermDays" value="30" required>
            </div>
            <div class="input-group">
              <label for="riskLevel">Değerlendirilen Risk Seviyesi</label>
              <select id="riskLevel" name="riskLevel">
                <option value="Low">Düşük Risk (Güvenilir)</option>
                <option value="Medium">Orta Risk</option>
                <option value="High">Yüksek Risk</option>
                <option value="Blocked">Engellenmiş / Pasif</option>
              </select>
            </div>
          </div>

          <div class="form-grid form-grid--2">
            <div class="input-group">
              <label for="address">Açık Adres</label>
              <textarea id="address" name="address" rows="2" placeholder="Fatura ve sevkiyat adresi"></textarea>
            </div>
            <div class="input-group">
              <label for="notes">Özel Notlar</label>
              <textarea id="notes" name="notes" rows="2" placeholder="Müşteriye dair özel anlaşmalar, indirim sözleşmeleri"></textarea>
            </div>
          </div>

          <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-warning">👥 Müşteri Kartını Kaydet</button>
            <a href="/sales/customers" class="btn btn-secondary">İptal</a>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
