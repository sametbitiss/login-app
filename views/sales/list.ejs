<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satış Siparişleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link active">📋 Satış Siparişleri</a>
        <a href="/sales/orders/add" class="mss-sub-link">➕ Yeni Sipariş Oluştur</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/sales/analytics" class="msn-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="msn-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/quotes" class="msn-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="msn-link active">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="msn-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="msn-link">🧾 Satış Faturaları</a>
        <a href="/sales/customers" class="msn-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="msn-link">💰 Özel Fiyat Listeleri</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Satış Siparişleri ve Karşılama Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Alınan müşteri siparişlerinin takibi, anlık stok kontrolleri ve sevk durumları.</p>
        </div>
        <a href="/sales/orders/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Sipariş Ekle
        </a>
      </div>

      <!-- Sales KPI Strip -->
      <div class="kpi-strip">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">🛍️</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Toplam Sipariş</span>
            <span class="kpi-chip-value"><%= stats.totalOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">⏳</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Onay Bekleyen</span>
            <span class="kpi-chip-value"><%= stats.pendingOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">✅</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Tamamlanan</span>
            <span class="kpi-chip-value"><%= stats.completedOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--cyan">💵</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Toplam Satış Ciro</span>
            <span class="kpi-chip-value"><%= parseFloat(stats.totalRevenue).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> ₺</span>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="filter-bar">
        <form method="GET" action="/sales/orders" class="filter-form">
          <div class="filter-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" placeholder="Sipariş no, müşteri unvanı veya vergi no..." value="<%= filterSearch %>" class="filter-input">
          </div>
          <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Sipariş Durumları</option>
            <option value="Draft" <%= filterStatus === 'Draft' ? 'selected' : '' %>>Taslak</option>
            <option value="Pending_Approval" <%= filterStatus === 'Pending_Approval' ? 'selected' : '' %>>Onay Bekliyor</option>
            <option value="Approved" <%= filterStatus === 'Approved' ? 'selected' : '' %>>Onaylandı</option>
            <option value="Preparing" <%= filterStatus === 'Preparing' ? 'selected' : '' %>>Hazırlanıyor</option>
            <option value="Shipped" <%= filterStatus === 'Shipped' ? 'selected' : '' %>>Sevk Edildi</option>
            <option value="Completed" <%= filterStatus === 'Completed' ? 'selected' : '' %>>Tamamlandı</option>
            <option value="Cancelled" <%= filterStatus === 'Cancelled' ? 'selected' : '' %>>İptal</option>
          </select>
          <select name="paymentTerm" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Ödeme Koşulları</option>
            <option value="Pesin" <%= filterPaymentTerm === 'Pesin' ? 'selected' : '' %>>Peşin</option>
            <option value="Vadeli_30" <%= filterPaymentTerm === 'Vadeli_30' ? 'selected' : '' %>>30 Gün Vadeli</option>
            <option value="Vadeli_60" <%= filterPaymentTerm === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
            <option value="Vadeli_90" <%= filterPaymentTerm === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
            <option value="Kredi_Karti" <%= filterPaymentTerm === 'Kredi_Karti' ? 'selected' : '' %>>Kredi Kartı</option>
          </select>
          <button type="submit" class="btn btn-sm">Filtrele</button>
        </form>
      </div>

      <!-- Results Count -->
      <div class="results-info">
        <span>Toplam <strong><%= orders.length %></strong> satış siparişi listeleniyor</span>
      </div>

      <!-- Sales Table -->
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Sipariş No</th>
              <th>Müşteri Unvanı</th>
              <th>Satılan Ürün</th>
              <th>Miktar</th>
              <th>Birim Satış Fiyatı</th>
              <th>Genel Toplam</th>
              <th>Ödeme Koşulu</th>
              <th>Tarih</th>
              <th>Durum</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders.length === 0) { %>
              <tr>
                <td colspan="10" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  <div style="font-size: 2rem; margin-bottom: 8px;">🛒</div>
                  Henüz kayıtlı satış siparişi bulunmamaktadır.
                  <br><a href="/sales/orders/add" style="color: var(--indigo); font-weight: 600;">İlk satış siparişinizi oluşturun →</a>
                </td>
              </tr>
            <% } else { %>
              <% orders.forEach(order => { %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= order.orderNo %></strong></td>
                  <td>
                    <div style="font-weight: 600;"><%= order.customerName %></div>
                    <% if (order.customerTaxNo) { %>
                      <div style="font-size: 0.75rem; color: var(--text-muted);">VN: <%= order.customerTaxNo %></div>
                    <% } %>
                  </td>
                  <td>
                    <% if (order.stockItem) { %>
                      <span style="font-weight: 500;"><%= order.stockItem.name %></span>
                      <span style="font-size: 0.75rem; color: var(--text-muted); display: block;"><%= order.stockItem.stockCode %></span>
                    <% } else { %>
                      <span style="color: var(--text-muted);">—</span>
                    <% } %>
                  </td>
                  <td><strong><%= parseFloat(order.quantity).toLocaleString('tr-TR') %> <%= order.stockItem ? order.stockItem.unit : '' %></strong></td>
                  <td><%= parseFloat(order.unitPrice).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> <%= order.currency %></td>
                  <td><strong style="color: var(--emerald);"><%= parseFloat(order.totalAmount).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> <%= order.currency %></strong></td>
                  <td style="font-size: 0.8rem;">
                    <%= order.paymentTerm === 'Pesin' ? 'Peşin' : order.paymentTerm === 'Vadeli_30' ? '30 Gün Vadeli' : order.paymentTerm === 'Vadeli_60' ? '60 Gün Vadeli' : order.paymentTerm === 'Vadeli_90' ? '90 Gün Vadeli' : 'Kredi Kartı' %>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(order.orderDate).toLocaleDateString('tr-TR') %></td>
                  <td>
                    <% if (order.status === 'Completed') { %>
                      <span class="status-pill status-active">● Tamamlandı</span>
                    <% } else if (order.status === 'Approved') { %>
                      <span class="status-pill status-approved">● Onaylandı</span>
                    <% } else if (order.status === 'Pending_Approval') { %>
                      <span class="status-pill status-pending">● Onay Bekliyor</span>
                    <% } else if (order.status === 'Shipped') { %>
                      <span class="status-pill status-onleave">● Sevk Edildi</span>
                    <% } else if (order.status === 'Cancelled') { %>
                      <span class="status-pill status-rejected">● İptal</span>
                    <% } else { %>
                      <span class="status-pill status-pending">● <%= order.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <div style="display:flex; gap:4px;">
                      <a href="/sales/orders/<%= order.id %>/detail" class="btn btn-sm btn-outline-info" style="white-space: nowrap; font-size: 0.75rem;">👁️ Gör</a>
                      <a href="/sales/orders/<%= order.id %>/edit" class="btn btn-sm btn-secondary" style="white-space: nowrap; font-size: 0.75rem;">✏️ Düzenle</a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
