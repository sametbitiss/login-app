<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satış Siparişleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link active">📋 Satış Siparişleri</a>
        <a href="/sales/orders/add" class="mss-sub-link">➕ Yeni Sipariş Oluştur</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">

      <div class="page-header">
        <div>
          <h1>Satış Siparişleri ve Karşılama Yönetimi</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Alınan müşteri siparişlerinin takibi, anlık stok kontrolleri ve sevk durumları.</p>
        </div>
        <a href="/sales/orders/add" class="btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Yeni Sipariş Ekle
        </a>
      </div>

      <!-- Sales KPI Strip -->
      <div class="kpi-strip">
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--indigo">🛍️</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Toplam Sipariş</span>
            <span class="kpi-chip-value"><%= stats.totalOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--amber">⏳</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Onay Bekleyen</span>
            <span class="kpi-chip-value"><%= stats.pendingOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--emerald">✅</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Tamamlanan</span>
            <span class="kpi-chip-value"><%= stats.completedOrders %></span>
          </div>
        </div>
        <div class="kpi-chip">
          <div class="kpi-chip-icon kpi-chip--cyan">💵</div>
          <div class="kpi-chip-data">
            <span class="kpi-chip-label">Toplam Satış Ciro</span>
            <span class="kpi-chip-value"><%= (parseFloat(stats.totalRevenue) || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> ₺</span>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="filter-bar">
        <form method="GET" action="/sales/orders" class="filter-form">
          <div class="filter-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" placeholder="Sipariş no, müşteri unvanı veya vergi no..." value="<%= filterSearch %>" class="filter-input">
          </div>
          <select name="status" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Sipariş Durumları</option>
            <option value="Pending_Approval" <%= filterStatus === 'Pending_Approval' ? 'selected' : '' %>>Onay Bekliyor</option>
            <option value="Approved" <%= filterStatus === 'Approved' ? 'selected' : '' %>>Onaylandı</option>
            <option value="Preparing" <%= filterStatus === 'Preparing' ? 'selected' : '' %>>Hazırlanıyor</option>
            <option value="Shipped" <%= filterStatus === 'Shipped' ? 'selected' : '' %>>Sevk Edildi</option>
            <option value="Completed" <%= filterStatus === 'Completed' ? 'selected' : '' %>>Tamamlandı</option>
            <option value="Rejected" <%= filterStatus === 'Rejected' ? 'selected' : '' %>>Reddedildi</option>
          </select>
          <select name="paymentTerm" class="filter-select" onchange="this.form.submit()">
            <option value="">Tüm Ödeme Koşulları</option>
            <option value="Pesin" <%= filterPaymentTerm === 'Pesin' ? 'selected' : '' %>>Peşin</option>
            <option value="Vadeli_30" <%= filterPaymentTerm === 'Vadeli_30' ? 'selected' : '' %>>30 Gün Vadeli</option>
            <option value="Vadeli_60" <%= filterPaymentTerm === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
            <option value="Vadeli_90" <%= filterPaymentTerm === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
            <option value="Kredi_Karti" <%= filterPaymentTerm === 'Kredi_Karti' ? 'selected' : '' %>>Kredi Kartı</option>
          </select>
          <button type="submit" class="btn btn-sm">Filtrele</button>
        </form>
      </div>

      <!-- Results Count -->
      <div class="results-info">
        <span>Toplam <strong><%= orders.length %></strong> satış siparişi listeleniyor</span>
      </div>

      <!-- Sales Table -->
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Sipariş No</th>
              <th>Müşteri Unvanı</th>
              <th>Sipariş Edilen Ürünler</th>
              <th>Miktar</th>
              <th>Toplam İskonto</th>
              <th>Genel Toplam</th>
              <th>Ödeme Koşulu</th>
              <th>Tarih</th>
              <th>Durum</th>
              <th>Aksiyon</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders.length === 0) { %>
              <tr>
                <td colspan="10" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  <div style="font-size: 2rem; margin-bottom: 8px;">🛒</div>
                  Henüz kayıtlı satış siparişi bulunmamaktadır.
                  <br><a href="/sales/orders/add" style="color: var(--indigo); font-weight: 600;">İlk satış siparişinizi oluşturun →</a>
                </td>
              </tr>
            <% } else { %>
              <% 
                const safeFloat = (val, defaultVal = 0) => {
                  if (val === null || val === undefined || val === '' || val === 'null' || val === 'undefined' || val === 'NaN') return defaultVal;
                  const n = parseFloat(val);
                  return Number.isNaN(n) ? defaultVal : n;
                };

                orders.forEach(order => { 
                  const orderNo = order.orderNo || order.siparisNo || 'SAT-000';
                  const custName = order.customerName || order.musteriAdi || (order.musteri ? order.musteri.firmaAdi : 'Müşteri');
                  const custTax = order.customerTaxNo || order.musteriVergiNo || '';
                  const orderCurr = order.currency || order.paraBirimi || 'TRY';
                  const orderDate = order.orderDate || order.siparisTarihi || new Date();
                  const pTerm = order.paymentTerm || order.odemeVadesi || 'Vadeli_30';
                  const orderStatus = order.status || order.durum || 'Preparing';

                  let itemsList = [];
                  const rawJson = order.itemsJson || order.kalemlerJson;
                  if (rawJson) {
                    try { itemsList = typeof rawJson === 'string' ? JSON.parse(rawJson) : rawJson; } catch (e) { itemsList = []; }
                  }
                  if (!Array.isArray(itemsList) || itemsList.length === 0) {
                    const sObj = order.stockItem || order.stokKarti;
                    itemsList = [{
                      stockCode: sObj ? (sObj.stockCode || sObj.stokKodu || '-') : '-',
                      name: sObj ? (sObj.name || sObj.ad || 'Ürün Kalemi') : 'Ürün Kalemi',
                      quantity: safeFloat(order.quantity !== undefined ? order.quantity : order.miktar, 1),
                      unitPrice: safeFloat(order.unitPrice !== undefined ? order.unitPrice : order.birimFiyat, 0),
                      discountRate: safeFloat(order.discountRate !== undefined ? order.discountRate : order.iskontoOrani, 0),
                      taxRate: safeFloat(order.taxRate !== undefined ? order.taxRate : order.kdvOrani, 20),
                      subtotal: safeFloat(order.subtotal !== undefined ? order.subtotal : order.araToplam, 0),
                      totalAmount: safeFloat(order.totalAmount !== undefined ? order.totalAmount : order.toplamTutar, 0)
                    }];
                  }

                  let totalDiscountVal = safeFloat(order.discountAmount !== undefined ? order.discountAmount : order.iskontoTutari, 0);
                  if (totalDiscountVal === 0 && itemsList.length > 0) {
                    itemsList.forEach(it => {
                      const q = safeFloat(it.quantity !== undefined ? it.quantity : it.miktar, 1);
                      const p = safeFloat(it.unitPrice !== undefined ? it.unitPrice : it.birimFiyat, 0);
                      const d = safeFloat(it.discountRate !== undefined ? it.discountRate : it.iskontoOrani, 0);
                      totalDiscountVal += (q * p) * (d / 100);
                    });
                  }

                  const grandTotalVal = safeFloat(order.totalAmount !== undefined ? order.totalAmount : order.toplamTutar, 0);
              %>
                <tr>
                  <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace; font-size: 0.825rem;"><%= orderNo %></strong></td>
                  <td>
                    <div style="font-weight: 600;"><%= custName %></div>
                    <% if (custTax) { %>
                      <div style="font-size: 0.75rem; color: var(--text-muted);">VN: <%= custTax %></div>
                    <% } %>
                  </td>
                  <td>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                      <% itemsList.forEach(it => { %>
                        <div style="font-weight: 500; color: var(--text-primary); font-size: 0.875rem;"><%= it.name || it.ad || 'Ürün Kalemi' %></div>
                      <% }); %>
                    </div>
                  </td>
                  <td>
                    <div style="display: flex; flex-direction: column; gap: 4px; font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: var(--text-secondary);">
                      <% itemsList.forEach(it => { %>
                        <div><%= safeFloat(it.quantity !== undefined ? it.quantity : it.miktar, 1).toLocaleString('tr-TR') %> Adet</div>
                      <% }); %>
                    </div>
                  </td>
                  <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #fb7185; font-weight: 600;">
                    <% if (totalDiscountVal > 0) { %>
                      - <%= totalDiscountVal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> <%= orderCurr %>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.8rem;">-</span>
                    <% } %>
                  </td>
                  <td><strong style="color: var(--emerald); font-family: 'JetBrains Mono', monospace;"><%= grandTotalVal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> <%= orderCurr %></strong></td>
                  <td style="font-size: 0.8rem;">
                    <%= pTerm === 'Pesin' ? 'Peşin' : pTerm === 'Vadeli_30' ? '30 Gün Vadeli' : pTerm === 'Vadeli_60' ? '60 Gün Vadeli' : pTerm === 'Vadeli_90' ? '90 Gün Vadeli' : 'Kredi Kartı' %>
                  </td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(orderDate).toLocaleDateString('tr-TR') %></td>
                  <td>
                    <% if (orderStatus === 'Pending_Approval') { %>
                      <span class="status-pill status-pending">● Onay Bekliyor</span>
                    <% } else if (orderStatus === 'Approved') { %>
                      <span class="status-pill status-approved">● Onaylandı</span>
                    <% } else if (orderStatus === 'Hazırlanıyor' || orderStatus === 'Preparing') { %>
                      <span class="status-pill status-approved" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3);">
                        ● Hazırlanıyor
                      </span>
                    <% } else if (orderStatus === 'Shipped') { %>
                      <span class="status-pill status-onleave">● Sevk Edildi</span>
                    <% } else if (orderStatus === 'Completed') { %>
                      <span class="status-pill status-active">● Tamamlandı</span>
                    <% } else if (orderStatus === 'Rejected') { %>
                      <span class="status-pill" style="background: rgba(244, 63, 94, 0.15); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3);">
                        ✕ Reddedildi
                      </span>
                    <% } else { %>
                      <span class="status-pill status-pending">● <%= orderStatus %></span>
                    <% } %>
                  </td>
                  <td>
                    <div style="display:flex; gap:4px;">
                      <a href="/sales/orders/<%= order.id %>/detail" class="btn btn-sm btn-outline-info" style="white-space: nowrap; font-size: 0.75rem;">👁️ Gör</a>
                      <a href="/sales/orders/<%= order.id %>/edit" class="btn btn-sm btn-secondary" style="white-space: nowrap; font-size: 0.75rem;">✏️ Düzenle</a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
