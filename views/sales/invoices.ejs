<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faturalandırma ve Muhasebe Entegrasyonu — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link active">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/sales/analytics" class="msn-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="msn-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/quotes" class="msn-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="msn-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="msn-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="msn-link active">🧾 Satış Faturaları</a>
        <a href="/sales/customers" class="msn-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="msn-link">💰 Özel Fiyat Listeleri</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Faturalandırma ve Muhasebe Entegrasyonu</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tamamlanan satışların ve kesilen irsaliyelerin otomatik olarak faturaya dönüştürülüp muhasebeye aktarılması.</p>
        </div>
      </div>

      <!-- Quick Invoice Generation Panel -->
      <div class="form-panel" style="margin-bottom: 1.75rem;">
        <h3 style="color: var(--emerald); font-size: 1.05rem; margin-bottom: 1rem;">🧾 Tamamlanan Siparişlerden Tek Tıkla Satış Faturası Kes</h3>
        
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <% if (completedOrders.length === 0) { %>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Faturaya dönüştürülmeyi bekleyen tamamlanmış sipariş bulunmamaktadır.</p>
          <% } else { %>
            <% completedOrders.forEach(o => { %>
              <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); padding: 1rem; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: space-between; width: 100%;">
                <div>
                  <strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= o.orderNo %></strong>
                  <span style="margin-left: 12px; font-weight: 600;"><%= o.customerName %></span>
                  <span style="margin-left: 12px; color: var(--text-muted); font-size: 0.85rem;"><%= o.stockItem ? o.stockItem.name : '' %> (<%= o.quantity %> Adet)</span>
                  <strong style="margin-left: 12px; color: var(--emerald);"><%= parseFloat(o.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= o.currency %></strong>
                </div>
                <form action="/sales/invoices/create-from-order/<%= o.id %>" method="POST">
                  <button type="submit" class="btn btn-sm btn-success">🧾 Faturayı Kes & Cari Bakiyeye İşle</button>
                </form>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Invoices List Table -->
      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Fatura No</th>
              <th>Müşteri Unvanı</th>
              <th>Vergi No</th>
              <th>Fatura Tarihi</th>
              <th>Son Vade Tarihi</th>
              <th>Genel Toplam</th>
              <th>Ödeme Durumu</th>
              <th>Fatura Durumu</th>
              <th>Baskı / Detay</th>
            </tr>
          </thead>
          <tbody>
            <% if (invoices.length === 0) { %>
              <tr>
                <td colspan="9" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  Henüz kesilmiş satış faturası bulunmamaktadır.
                </td>
              </tr>
            <% } else { %>
              <% invoices.forEach(inv => { %>
                <tr>
                  <td><strong style="color: var(--emerald); font-family: 'JetBrains Mono', monospace;"><%= inv.invoiceNo %></strong></td>
                  <td><strong><%= inv.customerName %></strong></td>
                  <td style="font-size: 0.8rem;"><%= inv.customerTaxNo || '—' %></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(inv.invoiceDate).toLocaleDateString('tr-TR') %></td>
                  <td style="font-size: 0.8rem; color: var(--amber);"><%= new Date(inv.dueDate).toLocaleDateString('tr-TR') %></td>
                  <td><strong style="color: var(--emerald);"><%= parseFloat(inv.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= inv.currency %></strong></td>
                  <td>
                    <% if (inv.paymentStatus === 'Paid') { %>
                      <span class="status-pill status-active">● Ödendi</span>
                    <% } else { %>
                      <span class="status-pill status-rejected">● Ödenmedi</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-pill status-approved">● <%= inv.status %></span>
                  </td>
                  <td>
                    <a href="/sales/invoices/<%= inv.id %>" class="btn btn-sm btn-secondary" target="_blank">🖨️ Yazdır / Gör</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
