<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faturalandırma ve Muhasebe Entegrasyonu — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link active">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/sales/analytics" class="msn-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="msn-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/quotes" class="msn-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="msn-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="msn-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="msn-link active">🧾 Satış Faturaları</a>
        <a href="/sales/customers" class="msn-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="msn-link">💰 Özel Fiyat Listeleri</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Faturalandırma ve Muhasebe Entegrasyonu</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tamamlanan satışların ve kesilen irsaliyelerin otomatik olarak faturaya dönüştürülüp muhasebeye aktarılması.</p>
        </div>
      </div>

      <!-- Flash Alert Messages -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); color: #f43f5e; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 1.5rem; font-weight: 600; font-size: 0.9rem; display: flex; align-items: center; gap: 10px;">
          <span>⚠️</span> <%= error %>
        </div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); color: #34d399; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 1.5rem; font-weight: 600; font-size: 0.9rem; display: flex; align-items: center; gap: 10px;">
          <span>✅</span> <%= success %>
        </div>
      <% } %>

      <!-- Quick Invoice Generation Panel -->
      <div style="background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 1.5rem; margin-bottom: 2rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 1rem;">
          <div>
            <h3 style="color: #34d399; font-size: 1.1rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
              <span>🧾</span> Tamamlanan Siparişlerden Tek Tıkla Satış Faturası Kes
            </h3>
            <p style="color: var(--text-muted); font-size: 0.825rem; margin: 4px 0 0 0;">
              Aşağıda tüm ürün teslimatları gerçekleşmiş ve henüz faturası kesilmemiş siparişler listelenir. Her sipariş için yalnızca 1 adet satış faturası kesilebilir.
            </p>
          </div>
          <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 5px 14px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; font-family: 'JetBrains Mono', monospace;">
            <%= completedOrders.length %> Sipariş Faturaya Hazır
          </span>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
          <% if (completedOrders.length === 0) { %>
            <div style="padding: 2.25rem; text-align: center; color: var(--text-muted); background: rgba(255,255,255,0.02); border-radius: 12px; border: 1px dashed rgba(255,255,255,0.1);">
              <span style="font-size: 1.8rem; display: block; margin-bottom: 8px;">✓</span>
              <strong style="color: #34d399; font-size: 0.95rem;">Faturaya dönüştürülmeyi bekleyen tamamlanmış sipariş bulunmamaktadır.</strong>
              <p style="font-size: 0.825rem; color: var(--text-muted); margin-top: 4px;">Tamamlanan tüm satış siparişlerinin faturaları başarıyla kesilmiştir.</p>
            </div>
          <% } else { %>
            <% completedOrders.forEach(o => { %>
              <div style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); padding: 1.15rem 1.35rem; border-radius: 12px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; transition: all 0.2s ease;">
                <div style="display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
                  <div>
                    <strong style="color: #818cf8; font-family: 'JetBrains Mono', monospace; font-size: 1rem;"><%= o.orderNo %></strong>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">Tarih: <%= new Date(o.orderDate).toLocaleDateString('tr-TR') %></div>
                  </div>

                  <div style="height: 32px; width: 1px; background: rgba(255,255,255,0.1);"></div>

                  <div>
                    <strong style="color: #fff; font-size: 0.95rem; display: block;"><%= o.customerName %></strong>
                    <span style="color: var(--text-muted); font-size: 0.825rem;">
                      <%= o.stockItem ? o.stockItem.name : 'Çoklu Ürün Kalemi' %> (<%= o.quantity %> Adet)
                    </span>
                  </div>

                  <div style="height: 32px; width: 1px; background: rgba(255,255,255,0.1);"></div>

                  <div>
                    <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">Fatura Tutarı</span>
                    <strong style="color: #34d399; font-family: 'JetBrains Mono', monospace; font-size: 1.1rem;">
                      <%= parseFloat(o.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= o.currency || 'TL' %>
                    </strong>
                  </div>
                </div>

                <div style="display: flex; gap: 8px; align-items: center;">
                  <button type="button" onclick='openInvoiceModal(<%- JSON.stringify(o) %>)' class="btn" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 700; padding: 10px 22px; border-radius: 10px; box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35); font-size: 0.875rem; display: inline-flex; align-items: center; gap: 8px; cursor: pointer;">
                    🧾 Satış Faturası Oluştur
                  </button>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>

      <!-- Invoices List Table -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: #fff; margin: 0;">🧾 Resmi Satış Faturaları Listesi</h3>
        <span style="font-size: 0.85rem; color: var(--text-muted);">Toplam <%= invoices.length %> Fatura Kaydı</span>
      </div>

      <div class="table-wrapper">
        <table class="data-table">
          <thead>
            <tr>
              <th>Fatura No</th>
              <th>Bağlı Sipariş No</th>
              <th>Müşteri Unvanı</th>
              <th>Vergi Dairesi / No</th>
              <th>Fatura Tarihi</th>
              <th>Son Vade Tarihi</th>
              <th>Genel Toplam</th>
              <th>Ödeme Durumu</th>
              <th>Fatura Durumu</th>
              <th>İşlem</th>
            </tr>
          </thead>
          <tbody>
            <% if (invoices.length === 0) { %>
              <tr>
                <td colspan="10" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                  Henüz kesilmiş satış faturası bulunmamaktadır.
                </td>
              </tr>
            <% } else { %>
              <% invoices.forEach(inv => { %>
                <tr>
                  <td><strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;"><%= inv.invoiceNo %></strong></td>
                  <td>
                    <% if (inv.saleOrder) { %>
                      <span style="font-family: 'JetBrains Mono', monospace; color: #818cf8; font-weight: 600;"><%= inv.saleOrder.orderNo %></span>
                    <% } else { %>
                      <span style="color: var(--text-muted);">—</span>
                    <% } %>
                  </td>
                  <td><strong><%= inv.customerName %></strong></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= inv.customerTaxNo || '—' %></td>
                  <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(inv.invoiceDate).toLocaleDateString('tr-TR') %></td>
                  <td style="font-size: 0.8rem; color: #fbbf24; font-weight: 600;"><%= new Date(inv.dueDate).toLocaleDateString('tr-TR') %></td>
                  <td><strong style="color: #34d399; font-family: 'JetBrains Mono', monospace;"><%= parseFloat(inv.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= inv.currency || 'TL' %></strong></td>
                  <td>
                    <% if (inv.paymentStatus === 'Paid') { %>
                      <span class="status-pill status-active">● Ödendi</span>
                    <% } else { %>
                      <span class="status-pill status-rejected">● Ödenmedi</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-pill status-approved">● <%= inv.status === 'Issued' ? 'Kesildi' : inv.status %></span>
                  </td>
                  <td>
                    <a href="/sales/invoices/<%= inv.id %>" target="_blank" class="btn btn-sm btn-outline-info" style="font-size: 0.75rem; display: inline-flex; align-items: center; gap: 4px;">📄 Resmi A4 Fatura Gör ↗</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- STUNNING GLASSMORPHIC INVOICE CREATION & CONFIGURATION MODAL -->
  <div id="invoiceConfigModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(6, 9, 18, 0.85); backdrop-filter: blur(16px); z-index: 9999; justify-content: center; align-items: center; padding: 20px; overflow-y: auto;">
    <div style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.98) 0%, rgba(30, 41, 59, 0.95) 100%); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; width: 100%; max-width: 780px; padding: 28px; box-shadow: 0 25px 60px rgba(0,0,0,0.6); color: #fff; max-height: 90vh; overflow-y: auto;">
      
      <!-- Modal Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 14px;">
        <div>
          <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: #34d399; display: flex; align-items: center; gap: 10px;">
            <span>🧾</span> Resmi Satış Faturası Oluşturma Modalı
          </h3>
          <p style="color: var(--text-muted); font-size: 0.825rem; margin: 4px 0 0 0;">Lütfen fatura senaryosu, cari adres ve ödeme vade parametrelerini onaylayarak faturayı oluşturun.</p>
        </div>
        <button type="button" onclick="closeInvoiceModal()" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: #fff; width: 36px; height: 36px; border-radius: 50%; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center;">✕</button>
      </div>

      <!-- Order Summary Card inside Modal -->
      <div style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Bağlı Sipariş & Müşteri</span>
          <div style="font-size: 1rem; font-weight: 800; color: #fff; margin-top: 2px;">
            <span id="modalOrderNo" style="font-family: 'JetBrains Mono', monospace; color: #818cf8;">—</span> • <span id="modalCustomerName">—</span>
          </div>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Fatura Tutarı</span>
          <div id="modalTotalAmount" style="font-size: 1.25rem; font-weight: 900; color: #34d399; font-family: 'JetBrains Mono', monospace; margin-top: 2px;">0.00 TL</div>
        </div>
      </div>

      <form id="modalInvoiceForm" action="" method="POST">
        
        <!-- SECTION 1: BELGE & SENARYO BİLGİLERİ -->
        <div style="margin-bottom: 18px;">
          <h4 style="font-size: 0.85rem; font-weight: 800; color: #818cf8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
            <span>📄</span> 1. Fatura Belge & Senaryo Parametreleri
          </h4>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Fatura Senaryosu <span style="color: #f43f5e;">*</span></label>
              <select name="invoiceScenario" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 10px 14px; border-radius: 10px; font-weight: 600;">
                <option value="EARSIVFATURA" selected>e-Arşiv Fatura (GİB Standart)</option>
                <option value="EFATURA">e-Fatura (Ticari Senaryo)</option>
                <option value="EFATURA_TEMEL">e-Fatura (Temel Senaryo)</option>
              </select>
            </div>
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Fatura Türü / Tipi <span style="color: #f43f5e;">*</span></label>
              <select name="invoiceType" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 10px 14px; border-radius: 10px; font-weight: 600;">
                <option value="SATIS" selected>Satış Faturası</option>
                <option value="IADE">İade Faturası</option>
                <option value="ISTISNA">İstisna Faturası (%0 KDV)</option>
                <option value="OZELMATRAH">Özel Matrah Faturası</option>
              </select>
            </div>
          </div>
        </div>

        <!-- SECTION 2: CARİ & ADRES BİLGİLERİ -->
        <div style="margin-bottom: 18px;">
          <h4 style="font-size: 0.85rem; font-weight: 800; color: #818cf8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
            <span>🏢</span> 2. Müşteri (Cari) & Fatura Adresi Bilgileri
          </h4>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 10px;">
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Vergi Dairesi</label>
              <input type="text" id="modalTaxOffice" name="customerTaxOffice" placeholder="Örn: Maslak V.D." style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px;">
            </div>
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Vergi No / TCKN</label>
              <input type="text" id="modalTaxNo" name="customerTaxNo" placeholder="Örn: 1234567890" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace;">
            </div>
          </div>

          <div class="input-group" style="margin-bottom: 10px;">
            <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Fatura & Teslimat Adresi</label>
            <input type="text" id="modalAddress" name="billingAddress" placeholder="Örn: Maslak Mah. Büyükdere Cad. No:100 Şişli / İstanbul" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px;">
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Telefon</label>
              <input type="text" id="modalPhone" name="customerPhone" placeholder="+90 212 555 0100" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px;">
            </div>
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">E-Posta (e-Fatura Gönderim)</label>
              <input type="email" id="modalEmail" name="customerEmail" placeholder="fatura@musteri.com" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px;">
            </div>
          </div>
        </div>

        <!-- SECTION 3: ÖDEME & BANKA BİLGİLERİ -->
        <div style="margin-bottom: 18px;">
          <h4 style="font-size: 0.85rem; font-weight: 800; color: #818cf8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
            <span>💳</span> 3. Ödeme Vadesi & Banka IBAN Bilgileri
          </h4>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 10px;">
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Ödeme Şekli & Vade Süresi</label>
              <select name="paymentTermDays" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px; font-weight: 600;">
                <option value="0">Peşin (Nakit / Kredi Kartı)</option>
                <option value="15">15 Gün Vadeli</option>
                <option value="30" selected>30 Gün Vadeli</option>
                <option value="60">60 Gün Vadeli</option>
                <option value="90">90 Gün Vadeli</option>
              </select>
            </div>
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Döviz Kuru</label>
              <input type="number" step="0.0001" name="exchangeRate" value="1.0000" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace;">
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Banka Adı & Şubesi</label>
              <input type="text" name="bankName" value="Ziraat Bankası A.Ş. - Maslak Şubesi" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px;">
            </div>
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">IBAN Numarası</label>
              <input type="text" name="ibanNo" value="TR56 0001 0002 0003 0004 0005 06" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px; font-family: 'JetBrains Mono', monospace;">
            </div>
          </div>
        </div>

        <!-- SECTION 4: NOTLAR & AÇIKLAMA -->
        <div class="input-group" style="margin-bottom: 22px;">
          <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Fatura Notu / Açıklama</label>
          <input type="text" id="modalNotesInput" name="notes" placeholder="Örn: 30 gün vadeli teslimat faturasıdır." style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 10px 14px; border-radius: 10px;">
        </div>

        <!-- Modal Footer Actions -->
        <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px;">
          <button type="button" onclick="closeInvoiceModal()" class="btn btn-outline-secondary" style="padding: 10px 20px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.2); color: #fff; background: transparent; cursor: pointer; font-weight: 600;">
            İptal
          </button>
          <button type="submit" class="btn" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 800; padding: 12px 28px; border-radius: 10px; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4); font-size: 0.95rem; cursor: pointer;">
            🧾 Resmi Faturayı Kes & Cari Bakiyeye İşle
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openInvoiceModal(order) {
      const modal = document.getElementById('invoiceConfigModal');
      const form = document.getElementById('modalInvoiceForm');

      if (form) form.action = `/sales/invoices/create-from-order/${order.id}`;

      document.getElementById('modalOrderNo').textContent = order.orderNo || '—';
      document.getElementById('modalCustomerName').textContent = order.customerName || 'Müşteri';
      document.getElementById('modalTotalAmount').textContent = parseFloat(order.totalAmount || 0).toLocaleString('tr-TR', {minimumFractionDigits:2}) + ' ' + (order.currency || 'TL');

      if (order.customer) {
        document.getElementById('modalTaxOffice').value = order.customer.taxOffice || 'Maslak V.D.';
        document.getElementById('modalTaxNo').value = order.customer.taxNo || order.customerTaxNo || '';
        document.getElementById('modalAddress').value = order.customer.address || order.billingAddress || '';
        document.getElementById('modalPhone').value = order.customer.phone || order.customerPhone || '';
        document.getElementById('modalEmail').value = order.customer.email || order.customerEmail || '';
      } else {
        document.getElementById('modalTaxOffice').value = 'Maslak V.D.';
        document.getElementById('modalTaxNo').value = order.customerTaxNo || '';
        document.getElementById('modalAddress').value = order.billingAddress || '';
        document.getElementById('modalPhone').value = order.customerPhone || '';
        document.getElementById('modalEmail').value = order.customerEmail || '';
      }

      document.getElementById('modalNotesInput').value = `[Sipariş No: ${order.orderNo}] numaralı tamamlanan satış siparişi faturaya dönüştürüldü.`;

      if (modal) {
        modal.style.display = 'flex';
      }
    }

    function closeInvoiceModal() {
      const modal = document.getElementById('invoiceConfigModal');
      if (modal) modal.style.display = 'none';
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
