<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satış Raporlama ve Analiz Gösterge Paneli — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    .card-metric { 
      background: var(--bg-surface); 
      border: 1px solid var(--border); 
      border-radius: 16px; 
      padding: 24px; 
      box-shadow: var(--shadow-md); 
    }
    .card-metric span { font-size: 0.8rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; display: block; margin-bottom: 8px; letter-spacing: 0.05em; }
    .card-metric strong { font-size: 1.6rem; font-weight: 800; color: var(--text-primary); }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 28px; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 28px; }
    .chart-box { 
      background: var(--bg-surface); 
      border: 1px solid var(--border); 
      border-radius: 16px; 
      padding: 28px; 
      box-shadow: var(--shadow-md); 
    }
    .chart-box h3 { font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin: 0 0 20px 0; }
  </style>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link active">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/sales/analytics" class="msn-link active">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="msn-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/quotes" class="msn-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="msn-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="msn-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="msn-link">🧾 Satış Faturaları</a>
        <a href="/sales/customers" class="msn-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="msn-link">💰 Özel Fiyat Listeleri</a>
      </div>
      <div class="page-header">
        <div>
          <h1>Satış Raporlama ve Kârlılık Analiz Paneli</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Satış temsilcisi bazlı cirolar, dönemsel trendler, en çok satan ürünler ve kârlılık marjları.</p>
        </div>
      </div>

      <!-- KPI Grid -->
      <div class="grid-4">
        <div class="card-metric">
          <span>Toplam Satış Cirosu</span>
          <strong style="color: var(--indigo);"><%= Number(totalRevenue).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</strong>
        </div>
        <div class="card-metric">
          <span>Tahmini Ürün Maliyeti (COGS)</span>
          <strong style="color: var(--amber);"><%= Number(totalCost).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</strong>
        </div>
        <div class="card-metric">
          <span>Tahmini Brüt Satış Kârı</span>
          <strong style="color: var(--emerald);"><%= Number(grossProfit).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</strong>
        </div>
        <div class="card-metric">
          <span>Kârlılık Marjı (%)</span>
          <strong style="color: var(--cyan);">%<%= profitMargin %></strong>
        </div>
      </div>

      <!-- Charts Row 1 -->
      <div class="grid-2">
        <div class="chart-box">
          <h3>📊 Satış Temsilcisi Bazlı Cirolar (TL)</h3>
          <canvas id="salesRepChart" height="220"></canvas>
        </div>
        <div class="chart-box">
          <h3>🏆 En Çok Satan 5 Ürün (Ciro Bazlı)</h3>
          <canvas id="topProductsChart" height="220"></canvas>
        </div>
      </div>

      <!-- Sales Rep Table & Top Products List -->
      <div class="grid-2">
        <div class="chart-box">
          <h3>👤 Satış Temsilcisi Performans Tablosu</h3>
          <div class="table-wrapper">
            <table class="table">
              <thead>
                <tr>
                  <th>Temsilci</th>
                  <th>Sipariş Adedi</th>
                  <th class="text-end">Toplam Ciro (TL)</th>
                </tr>
              </thead>
              <tbody>
                <% if (!salesRepData || salesRepData.length === 0) { %>
                  <tr><td colspan="3" class="text-center text-muted">Veri bulunamadı.</td></tr>
                <% } else { %>
                  <% salesRepData.forEach(r => { %>
                    <tr>
                      <td><strong style="color: var(--text-primary);"><%= r.salesRep || 'Temsilci Belirtilmedi' %></strong></td>
                      <td><span class="badge bg-secondary"><%= r.orderCount %> Sipariş</span></td>
                      <td class="text-end font-weight-bold" style="color: var(--emerald);"><%= Number(r.totalRevenue).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="chart-box">
          <h3>📋 Son Gerçekleşen Satış İşlemleri</h3>
          <div class="table-wrapper">
            <table class="table">
              <thead>
                <tr>
                  <th>Sipariş No</th>
                  <th>Müşteri</th>
                  <th>Tutar</th>
                  <th>Durum</th>
                </tr>
              </thead>
              <tbody>
                <% if (!recentOrders || recentOrders.length === 0) { %>
                  <tr><td colspan="4" class="text-center text-muted">Henüz sipariş kaydı yok.</td></tr>
                <% } else { %>
                  <% recentOrders.slice(0, 5).forEach(o => { %>
                    <tr>
                      <td><strong style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= o.orderNo %></strong></td>
                      <td><%= o.customerName %></td>
                      <td class="font-weight-bold" style="color: var(--emerald);"><%= Number(o.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= o.currency %></td>
                      <td><span class="badge bg-primary"><%= o.status %></span></td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Chart.js Global Dark Defaults
    Chart.defaults.color = '#8896b0';
    Chart.defaults.font.family = 'Inter';

    // 1. Sales Rep Chart
    const repLabels = <%- JSON.stringify((salesRepData || []).map(r => r.salesRep || 'Diğer')) %>;
    const repValues = <%- JSON.stringify((salesRepData || []).map(r => parseFloat(r.totalRevenue || 0))) %>;

    const ctxRep = document.getElementById('salesRepChart').getContext('2d');
    new Chart(ctxRep, {
      type: 'bar',
      data: {
        labels: repLabels.length > 0 ? repLabels : ['Henüz Veri Yok'],
        datasets: [{
          label: 'Toplam Ciro (TL)',
          data: repValues.length > 0 ? repValues : [0],
          backgroundColor: ['rgba(99, 102, 241, 0.75)', 'rgba(16, 185, 129, 0.75)', 'rgba(6, 182, 212, 0.75)', 'rgba(245, 158, 11, 0.75)'],
          borderColor: ['#6366f1', '#10b981', '#06b6d4', '#f59e0b'],
          borderWidth: 1,
          borderRadius: 8
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          x: { grid: { color: 'rgba(255, 255, 255, 0.05)' } },
          y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, beginAtZero: true }
        }
      }
    });

    // 2. Top Products Chart
    const prodLabels = <%- JSON.stringify((topProducts || []).map(p => p.name)) %>;
    const prodValues = <%- JSON.stringify((topProducts || []).map(p => parseFloat(p.revenue || 0))) %>;

    const ctxProd = document.getElementById('topProductsChart').getContext('2d');
    new Chart(ctxProd, {
      type: 'doughnut',
      data: {
        labels: prodLabels.length > 0 ? prodLabels : ['Henüz Veri Yok'],
        datasets: [{
          data: prodValues.length > 0 ? prodValues : [1],
          backgroundColor: [
            '#6366f1',
            '#10b981',
            '#06b6d4',
            '#f59e0b',
            '#ec4899'
          ],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'right', labels: { color: '#f0f2f5' } }
        }
      }
    });
  </script>
</body>
</html>
