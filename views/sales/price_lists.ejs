<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Özel Fiyat Listeleri — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .pl-card { 
      background: var(--bg-surface); 
      border: 1px solid var(--border); 
      border-radius: 16px; 
      padding: 28px; 
      box-shadow: var(--shadow-md); 
      margin-bottom: 24px; 
    }
    .pl-title { font-size: 1.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
    .badge-special { background: var(--indigo-soft); color: var(--indigo); font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; border: 1px solid rgba(99, 102, 241, 0.2); }
    .badge-global { background: var(--bg-elevated); color: var(--text-secondary); font-weight: 700; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; border: 1px solid var(--border); }
    .price-tag { font-weight: 800; color: var(--emerald); font-size: 1.05rem; font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link active">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar: Matching Sidebar Order exactly -->
      <div class="module-subnav">
        <a href="/sales/analytics" class="msn-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="msn-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/quotes" class="msn-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="msn-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="msn-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="msn-link">🧾 Satış Faturaları</a>
        <a href="/sales/customers" class="msn-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="msn-link active">💰 Özel Fiyat Listeleri</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Müşteriye Özel Fiyat Listeleri ve İskonto Tanımları</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Müşterilere özel ürün satış fiyatları, özel iskonto oranları ve geçerlilik süreleri yönetimi.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger mb-4"><%= error %></div>
      <% } %>

      <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 24px;">
        <!-- New Price List Form -->
        <div class="pl-card">
          <h2 class="pl-title">➕ Yeni Özel Fiyat Tanımla</h2>
          <form action="/sales/price-lists/add" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
            <div class="input-group">
              <label>Liste / Kampanya Adı</label>
              <input type="text" name="listName" placeholder="ör. VIP Müşteri Fiyat Listesi" required>
            </div>

            <div class="input-group">
              <label>Müşteri (Boş ise tüm müşteriler için geçerli)</label>
              <select name="customerId">
                <option value="">-- Tüm Müşteriler (Genel İskonto) --</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.customerCode %> - <%= c.companyName %></option>
                <% }); %>
              </select>
            </div>

            <div class="input-group">
              <label>Stok Ürünü</label>
              <select name="stockItemId" required>
                <option value="">-- Ürün Seçin --</option>
                <% stockItems.forEach(s => { %>
                  <option value="<%= s.id %>"><%= s.stockCode %> - <%= s.name %> (Liste: <%= Number(s.salePrice).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL)</option>
                <% }); %>
              </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div class="input-group">
                <label>Özel Birim Fiyat</label>
                <input type="number" step="0.01" name="specialPrice" placeholder="0.00" required>
              </div>
              <div class="input-group">
                <label>Özel İskonto (%)</label>
                <input type="number" step="0.01" name="customDiscountRate" value="0.00">
              </div>
            </div>

            <div class="input-group">
              <label>Para Birimi</label>
              <select name="currency">
                <option value="TRY">TRY (₺)</option>
                <option value="USD">USD ($)</option>
                <option value="EUR">EUR (€)</option>
              </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div class="input-group">
                <label>Başlangıç Tarihi</label>
                <input type="date" name="validFrom">
              </div>
              <div class="input-group">
                <label>Bitiş Tarihi</label>
                <input type="date" name="validUntil">
              </div>
            </div>

            <div class="input-group">
              <label>Açıklama / Notlar</label>
              <textarea name="notes" rows="2" placeholder="Sözleşme notları veya kampanya detayları..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 8px;">Fiyat Listesi Kaydet</button>
          </form>
        </div>

        <!-- Price Lists Table -->
        <div class="pl-card">
          <h2 class="pl-title">📋 Aktif Özel Fiyat Listeleri (<%= priceLists.length %>)</h2>
          <div class="table-wrapper">
            <table class="table">
              <thead>
                <tr>
                  <th>Liste Adı</th>
                  <th>Müşteri</th>
                  <th>Ürün</th>
                  <th>Özel Fiyat</th>
                  <th>İskonto</th>
                  <th>Para Birimi</th>
                  <th>Geçerlilik</th>
                </tr>
              </thead>
              <tbody>
                <% if (priceLists.length === 0) { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted" style="padding: 32px;">Henüz özel fiyat listesi tanımlanmamış.</td>
                  </tr>
                <% } else { %>
                  <% priceLists.forEach(pl => { %>
                    <tr>
                      <td><strong style="color: var(--text-primary);"><%= pl.listName %></strong></td>
                      <td>
                        <% if (pl.customer) { %>
                          <span class="badge-special"><%= pl.customer.companyName %></span>
                        <% } else { %>
                          <span class="badge-global">Tüm Müşteriler</span>
                        <% } %>
                      </td>
                      <td><span style="color: var(--text-primary); font-weight: 600;"><%= pl.stockItem ? pl.stockItem.name : '-' %></span></td>
                      <td><span class="price-tag"><%= Number(pl.specialPrice).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %></span></td>
                      <td><strong style="color: var(--rose);">%<%= pl.customDiscountRate %></strong></td>
                      <td><span class="badge bg-secondary" style="font-family: 'JetBrains Mono', monospace;"><%= pl.currency %></span></td>
                      <td>
                        <small style="color: var(--text-secondary); font-size: 0.8rem;">
                          <%= pl.validFrom ? pl.validFrom : 'Her zaman' %> — <%= pl.validUntil ? pl.validUntil : 'Süresiz' %>
                        </small>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
