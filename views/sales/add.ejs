<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sipariş Ekle — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/orders/add" class="mss-sub-link active">➕ Yeni Sipariş Oluştur</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">
      <div class="page-header">
        <div>
          <h1>Yeni Satış Siparişi Oluştur</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Tüm sipariş matrah ve müşteri bilgilerini sekmelerden eksiksiz doldurun (* zorunludur).</p>
        </div>
        <a href="/sales/orders" class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Listeye Dön
        </a>
      </div>

      <% if (error) { %>
        <div class="error" id="serverErrorBanner"><%= error %></div>
      <% } %>

      <!-- Dynamic Form Client-side Error Alert Banner -->
      <div class="error" id="clientErrorBanner" style="display: none; margin-bottom: 1.25rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span id="clientErrorMessage">Kayıt Yapılamadı! Lütfen eksik olan zorunlu (*) alanları doldurunuz.</span>
      </div>

      <!-- Form Container with Tab Navigation -->
      <form action="/sales/orders/add" method="POST" class="stock-form-container" id="saleAddForm" novalidate>

        <!-- Tab Header Bar -->
        <div class="form-tabs-header">
          <button type="button" class="tab-btn active" data-tab="tab-customer" id="tab-btn-customer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>1. Müşteri & Sipariş</span>
            <span class="tab-badge tab-badge--req">*</span>
          </button>

          <button type="button" class="tab-btn" data-tab="tab-product" id="tab-btn-product">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            <span>2. Ürün & Miktar</span>
            <span class="tab-badge tab-badge--req">*</span>
          </button>

          <button type="button" class="tab-btn" data-tab="tab-finance" id="tab-btn-finance">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>3. Ödeme & Matrah</span>
            <span class="tab-badge tab-badge--req">*</span>
          </button>

          <button type="button" class="tab-btn" data-tab="tab-shipping" id="tab-btn-shipping">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>4. Adres & Teslimat</span>
          </button>

          <button type="button" class="tab-btn" data-tab="tab-notes" id="tab-btn-notes">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span>5. Notlar & Temsilci</span>
          </button>
        </div>

        <!-- Tab Body Panes -->
        <div class="form-tabs-body">

          <!-- Tab 1: Müşteri & Sipariş -->
          <div class="tab-pane active" id="tab-customer">
            <div class="tab-pane-title">👤 Müşteri & Temel Sipariş Bilgileri</div>
            <div class="form-grid form-grid--3">
              <div class="input-group">
                <label for="orderNo">Sipariş No <span class="req-star">*</span></label>
                <input type="text" id="orderNo" name="orderNo" value="<%= formData.orderNo || nextOrderNo %>" required placeholder="SAT-2026-0001">
                <span class="field-error-msg">Sipariş numarası zorunludur.</span>
              </div>
              <div class="input-group">
                <label for="orderDate">Sipariş Tarihi <span class="req-star">*</span></label>
                <input type="date" id="orderDate" name="orderDate" value="<%= formData.orderDate || new Date().toISOString().split('T')[0] %>" required>
                <span class="field-error-msg">Sipariş tarihi zorunludur.</span>
              </div>
              <div class="input-group">
                <label for="deliveryDate">Tahmini Teslimat Tarihi</label>
                <input type="date" id="deliveryDate" name="deliveryDate" value="<%= formData.deliveryDate || '' %>">
              </div>
            </div>

            <div class="form-grid form-grid--3">
              <div class="input-group">
                <label for="customerName">Müşteri Ticari Unvanı / Adı <span class="req-star">*</span></label>
                <input type="text" id="customerName" name="customerName" value="<%= formData.customerName || '' %>" required placeholder="Örn: Mega İnşaat A.Ş.">
                <span class="field-error-msg">Müşteri unvanı zorunludur.</span>
              </div>
              <div class="input-group">
                <label for="customerTaxNo">Vergi / TC Kimlik No</label>
                <input type="text" id="customerTaxNo" name="customerTaxNo" value="<%= formData.customerTaxNo || '' %>" placeholder="1234567890">
              </div>
              <div class="input-group">
                <label for="customerPhone">Müşteri Telefon</label>
                <input type="text" id="customerPhone" name="customerPhone" value="<%= formData.customerPhone || '' %>" placeholder="+90 (5xx) xxx xx xx">
              </div>
            </div>

            <div class="form-grid form-grid--2">
              <div class="input-group">
                <label for="status">Sipariş Durumu <span class="req-star">*</span></label>
                <select id="status" name="status" required>
                  <option value="" disabled <%= !formData.status ? 'selected' : '' %>>-- Durum Seçiniz --</option>
                  <option value="Draft" <%= formData.status === 'Draft' ? 'selected' : '' %>>Taslak</option>
                  <option value="Pending_Approval" <%= formData.status === 'Pending_Approval' || !formData.status ? 'selected' : '' %>>Onay Bekliyor</option>
                  <option value="Approved" <%= formData.status === 'Approved' ? 'selected' : '' %>>Onaylandı</option>
                  <option value="Preparing" <%= formData.status === 'Preparing' ? 'selected' : '' %>>Hazırlanıyor</option>
                  <option value="Shipped" <%= formData.status === 'Shipped' ? 'selected' : '' %>>Sevk Edildi</option>
                  <option value="Completed" <%= formData.status === 'Completed' ? 'selected' : '' %>>Tamamlandı</option>
                </select>
                <span class="field-error-msg">Durum seçilmesi zorunludur.</span>
              </div>
              <div class="input-group">
                <label for="priority">Sipariş Önceliği</label>
                <select id="priority" name="priority">
                  <option value="Low" <%= formData.priority === 'Low' ? 'selected' : '' %>>Düşük</option>
                  <option value="Normal" <%= formData.priority === 'Normal' || !formData.priority ? 'selected' : '' %>>Normal</option>
                  <option value="High" <%= formData.priority === 'High' ? 'selected' : '' %>>Yüksek</option>
                  <option value="Urgent" <%= formData.priority === 'Urgent' ? 'selected' : '' %>>Acil</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Tab 2: Ürün & Miktar -->
          <div class="tab-pane" id="tab-product">
            <div class="tab-pane-title">📦 Stok Ürünü Seçimi & Fiyat Bilgileri</div>
            <div class="form-grid form-grid--1">
              <div class="input-group">
                <label for="stockItemId">Satılan Ürün (Mamul / Ticari Mal) <span class="req-star">*</span></label>
                <select id="stockItemId" name="stockItemId" required onchange="onStockChange(this)">
                  <option value="" disabled <%= !formData.stockItemId ? 'selected' : '' %>>-- Satılacak Ürün Seçiniz --</option>
                  <% stockItems.forEach(item => { %>
                    <option value="<%= item.id %>" data-price="<%= item.salePrice %>" data-unit="<%= item.unit %>" data-currency="<%= item.currency %>" data-stock="<%= item.currentStock %>" <%= String(formData.stockItemId) === String(item.id) ? 'selected' : '' %>>
                      [<%= item.stockCode %>] <%= item.name %> — Mevcut Stok: <%= parseFloat(item.currentStock).toLocaleString('tr-TR') %> <%= item.unit %> — Fiyat: <%= parseFloat(item.salePrice).toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> <%= item.currency %>
                    </option>
                  <% }); %>
                </select>
                <span class="field-error-msg">Stok kartı seçilmesi zorunludur.</span>
              </div>
            </div>

            <!-- Instant Stock Availability Alert Box -->
            <div id="stockAvailabilityWarning" style="display: none; background: rgba(245, 158, 11, 0.15); border: 1px solid var(--amber); color: #f59e0b; padding: 0.85rem 1rem; border-radius: var(--radius-sm); margin-top: 0.75rem; font-size: 0.85rem; font-weight: 500;">
              ⚠️ <strong>STOK YETERSİZ UYARISI:</strong> Girilen sipariş miktarı (<span id="warnReqQty">0</span>) depodaki mevcut stoktan (<span id="warnCurrStock">0</span>) fazladır! Sipariş "Açık Sipariş" (Open Fulfillment) olarak kaydedilecek ve üretim planlamasına sevk edilecektir.
            </div>

            <div class="form-grid form-grid--4" style="margin-top: 1rem;">
              <div class="input-group">
                <label for="quantity">Sipariş Miktarı <span class="req-star">*</span></label>
                <input type="number" step="0.01" id="quantity" name="quantity" value="<%= formData.quantity || '1' %>" required placeholder="1" oninput="checkStockFulfillment()">
                <span class="field-error-msg">Miktar sıfırdan büyük olmalıdır.</span>
              </div>
              <div class="input-group">
                <label for="unitPrice">Birim Satış Fiyatı <span class="req-star">*</span></label>
                <input type="number" step="0.01" id="unitPrice" name="unitPrice" value="<%= formData.unitPrice || '0' %>" required placeholder="0.00">
                <span class="field-error-msg">Birim fiyat zorunludur.</span>
              </div>
              <div class="input-group">
                <label for="discountRate">İskonto Oranı (%)</label>
                <input type="number" step="0.01" id="discountRate" name="discountRate" value="<%= formData.discountRate || '0' %>" placeholder="0">
              </div>
              <div class="input-group">
                <label for="taxRate">KDV Oranı (%)</label>
                <input type="number" step="0.01" id="taxRate" name="taxRate" value="<%= formData.taxRate || '20' %>" placeholder="20">
              </div>
            </div>
          </div>

          <!-- Tab 3: Ödeme & Matrah -->
          <div class="tab-pane" id="tab-finance">
            <div class="tab-pane-title">💰 Ödeme Koşulları & Matrah Canlı Hesaplama</div>
            <div class="form-grid form-grid--2">
              <div class="input-group">
                <label for="paymentTerm">Ödeme Koşulu <span class="req-star">*</span></label>
                <select id="paymentTerm" name="paymentTerm" required>
                  <option value="" disabled <%= !formData.paymentTerm ? 'selected' : '' %>>-- Ödeme Koşulu Seçiniz --</option>
                  <option value="Pesin" <%= formData.paymentTerm === 'Pesin' ? 'selected' : '' %>>Peşin Ödeme</option>
                  <option value="Vadeli_30" <%= formData.paymentTerm === 'Vadeli_30' ? 'selected' : '' %>>30 Gün Vadeli</option>
                  <option value="Vadeli_60" <%= formData.paymentTerm === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
                  <option value="Vadeli_90" <%= formData.paymentTerm === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
                  <option value="Kredi_Karti" <%= formData.paymentTerm === 'Kredi_Karti' ? 'selected' : '' %>>Kredi Kartı</option>
                </select>
                <span class="field-error-msg">Ödeme koşulu seçilmesi zorunludur.</span>
              </div>
              <div class="input-group">
                <label for="currency">Para Birimi <span class="req-star">*</span></label>
                <select id="currency" name="currency" required>
                  <option value="" disabled <%= !formData.currency ? 'selected' : '' %>>-- Para Birimi Seçiniz --</option>
                  <option value="TRY" <%= formData.currency === 'TRY' ? 'selected' : '' %>>₺ TRY</option>
                  <option value="USD" <%= formData.currency === 'USD' ? 'selected' : '' %>>$ USD</option>
                  <option value="EUR" <%= formData.currency === 'EUR' ? 'selected' : '' %>>€ EUR</option>
                </select>
                <span class="field-error-msg">Para birimi seçilmesi zorunludur.</span>
              </div>
            </div>

            <!-- Live Matrah Breakdown Box -->
            <div style="margin-top: 20px; padding: 20px; background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--radius-lg);">
              <h4 style="color: var(--indigo); font-size: 0.95rem; margin-bottom: 12px;">📊 Otomatik Hesaplanan Sipariş Matrahı</h4>
              <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
                <div>
                  <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">Ara Toplam (Brüt)</span>
                  <strong id="calcSubtotal" style="font-size: 1.1rem;">0.00 ₺</strong>
                </div>
                <div>
                  <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">İskonto Tutarı</span>
                  <strong id="calcDiscount" style="font-size: 1.1rem; color: var(--rose);">0.00 ₺</strong>
                </div>
                <div>
                  <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">KDV Tutarı</span>
                  <strong id="calcTax" style="font-size: 1.1rem; color: var(--amber);">0.00 ₺</strong>
                </div>
                <div>
                  <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">Genel Toplam (Net)</span>
                  <strong id="calcTotal" style="font-size: 1.2rem; color: var(--emerald);">0.00 ₺</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- Tab 4: Adres & Teslimat -->
          <div class="tab-pane" id="tab-shipping">
            <div class="tab-pane-title">🚚 Teslimat & Fatura Adres Bilgileri</div>
            <div class="form-grid form-grid--2">
              <div class="input-group">
                <label for="shippingAddress">Teslimat Adresi</label>
                <textarea id="shippingAddress" name="shippingAddress" rows="3" placeholder="Ürünlerin teslim edileceği tam adres..."><%= formData.shippingAddress || '' %></textarea>
              </div>
              <div class="input-group">
                <label for="billingAddress">Fatura Adresi</label>
                <textarea id="billingAddress" name="billingAddress" rows="3" placeholder="Resmi fatura adresi..."><%= formData.billingAddress || '' %></textarea>
              </div>
            </div>
          </div>

          <!-- Tab 5: Notlar & Temsilci -->
          <div class="tab-pane" id="tab-notes">
            <div class="tab-pane-title">📝 Satış Temsilcisi & Özel Notlar</div>
            <div class="form-grid form-grid--2">
              <div class="input-group">
                <label for="salesRep">Satış Temsilcisi</label>
                <input type="text" id="salesRep" name="salesRep" value="<%= formData.salesRep || (user.firstName ? user.firstName + ' ' + user.lastName : user.username) %>" placeholder="Siparişi alan personel">
              </div>
              <div class="input-group">
                <label for="notes">Sipariş Notları</label>
                <textarea id="notes" name="notes" rows="3" placeholder="Özel teslimat talimatı, müşteri notları..."><%= formData.notes || '' %></textarea>
              </div>
            </div>
          </div>

        </div>

        <!-- Form Actions Footer -->
        <div class="form-tabs-footer">
          <div class="tab-step-btns">
            <button type="button" class="btn btn-secondary btn-sm" id="btnPrevTab" style="display: none;">
              ← Önceki Sekme
            </button>
            <button type="button" class="btn btn-secondary btn-sm" id="btnNextTab">
              Sonraki Sekme →
            </button>
          </div>

          <div class="form-submit-btns">
            <button type="submit" class="btn btn-lg" id="btnSubmitForm">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              Satış Siparişini Kaydet
            </button>
            <a href="/sales/orders" class="btn btn-secondary btn-lg">İptal</a>
          </div>
        </div>

      </form>
    </main>
  </div>

  <script>
    // Live Clock
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Elements & State
    const form = document.getElementById('saleAddForm');
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');
    const btnPrev = document.getElementById('btnPrevTab');
    const btnNext = document.getElementById('btnNextTab');
    const clientErrorBanner = document.getElementById('clientErrorBanner');
    const clientErrorMessage = document.getElementById('clientErrorMessage');

    let currentTabIndex = 0;

    function switchTab(index) {
      if (index < 0 || index >= tabBtns.length) return;
      currentTabIndex = index;

      tabBtns.forEach((btn, i) => {
        btn.classList.toggle('active', i === index);
      });

      tabPanes.forEach((pane, i) => {
        pane.classList.toggle('active', i === index);
      });

      // Update Prev/Next buttons
      btnPrev.style.display = index === 0 ? 'none' : 'inline-flex';
      btnNext.style.display = index === tabBtns.length - 1 ? 'none' : 'inline-flex';
    }

    tabBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => switchTab(idx));
    });

    btnPrev.addEventListener('click', () => switchTab(currentTabIndex - 1));

    // Validate a specific tab pane by index
    function validateTab(paneIndex) {
      const pane = tabPanes[paneIndex];
      if (!pane) return true;

      const requiredInputs = pane.querySelectorAll('[required]');
      let isValid = true;

      requiredInputs.forEach(input => {
        const val = input.value ? input.value.trim() : '';
        if (!val) {
          isValid = false;
          input.classList.add('is-invalid');
        } else {
          input.classList.remove('is-invalid');
        }
      });

      return isValid;
    }

    // Update tab badges
    function updateTabBadges() {
      tabPanes.forEach((pane, i) => {
        const requiredInputs = pane.querySelectorAll('[required]');
        if (requiredInputs.length === 0) return;

        let paneValid = true;
        requiredInputs.forEach(input => {
          if (!input.value || !input.value.trim()) paneValid = false;
        });

        const badge = tabBtns[i].querySelector('.tab-badge');
        if (badge) {
          if (paneValid) {
            badge.classList.remove('tab-badge--err');
            badge.classList.add('tab-badge--ok');
            badge.textContent = '✓';
          } else {
            badge.classList.remove('tab-badge--ok');
            badge.classList.add('tab-badge--err');
            badge.textContent = '!';
          }
        }
      });
    }

    // Input blur/change event to clear invalid styling
    form.querySelectorAll('input, select, textarea').forEach(input => {
      input.addEventListener('input', () => {
        if (input.value && input.value.trim()) {
          input.classList.remove('is-invalid');
        }
        updateTabBadges();
        calcMatrah();
      });
      input.addEventListener('change', () => {
        if (input.value && input.value.trim()) {
          input.classList.remove('is-invalid');
        }
        updateTabBadges();
        calcMatrah();
      });
    });

    // Next step button validates current tab first
    btnNext.addEventListener('click', () => {
      const isCurrentValid = validateTab(currentTabIndex);
      if (!isCurrentValid) {
        clientErrorMessage.textContent = 'Lütfen bu sekmedeki zorunlu (*) alanları doldurunuz.';
        clientErrorBanner.style.display = 'flex';
        return;
      }
      clientErrorBanner.style.display = 'none';
      switchTab(currentTabIndex + 1);
    });

    // Global Form Submission Validation across ALL tabs
    form.addEventListener('submit', (e) => {
      form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

      let firstInvalidPaneIndex = -1;
      let firstInvalidInput = null;
      let missingFieldLabels = [];

      tabPanes.forEach((pane, paneIndex) => {
        const requiredInputs = pane.querySelectorAll('[required]');
        requiredInputs.forEach(input => {
          const val = input.value ? input.value.trim() : '';
          if (!val) {
            input.classList.add('is-invalid');
            if (firstInvalidPaneIndex === -1) {
              firstInvalidPaneIndex = paneIndex;
              firstInvalidInput = input;
            }
            const label = input.closest('.input-group') ? input.closest('.input-group').querySelector('label') : null;
            if (label) {
              const labelClean = label.textContent.replace('*', '').trim();
              if (!missingFieldLabels.includes(labelClean)) {
                missingFieldLabels.push(labelClean);
              }
            }
          }
        });
      });

      updateTabBadges();

      if (firstInvalidPaneIndex !== -1) {
        e.preventDefault(); // STOP form submission!
        switchTab(firstInvalidPaneIndex);
        clientErrorMessage.textContent = `Kayıt Yapılamadı! Lütfen eksik olan zorunlu (*) alanları doldurunuz: ${missingFieldLabels.join(', ')}`;
        clientErrorBanner.style.display = 'flex';

        if (firstInvalidInput) {
          setTimeout(() => firstInvalidInput.focus(), 150);
        }
      } else {
        clientErrorBanner.style.display = 'none';
      }
    });

    // Stock Change & Instant Stock Availability Check
    function onStockChange(select) {
      const selectedOpt = select.options[select.selectedIndex];
      if (selectedOpt && selectedOpt.dataset.price) {
        unitPriceInput.value = selectedOpt.dataset.price;
        if (selectedOpt.dataset.currency) {
          currencySelect.value = selectedOpt.dataset.currency;
        }
        calcMatrah();
        updateTabBadges();
      }
      checkStockFulfillment();
    }

    function checkStockFulfillment() {
      const select = document.getElementById('stockItemId');
      const quantityInput = document.getElementById('quantity');
      const warnBox = document.getElementById('stockAvailabilityWarning');
      const warnReq = document.getElementById('warnReqQty');
      const warnCurr = document.getElementById('warnCurrStock');

      if (!select || !quantityInput || !warnBox) return;

      const selectedOpt = select.options[select.selectedIndex];
      if (selectedOpt && selectedOpt.dataset.stock !== undefined) {
        const currStock = parseFloat(selectedOpt.dataset.stock) || 0;
        const reqQty = parseFloat(quantityInput.value) || 0;

        if (reqQty > currStock) {
          warnReq.textContent = reqQty.toLocaleString('tr-TR');
          warnCurr.textContent = currStock.toLocaleString('tr-TR');
          warnBox.style.display = 'block';
        } else {
          warnBox.style.display = 'none';
        }
      } else {
        warnBox.style.display = 'none';
      }
    }

    // Live Matrah Breakdown Calculation
    function calcMatrah() {
      const qty = parseFloat(document.getElementById('quantity').value) || 0;
      const price = parseFloat(document.getElementById('unitPrice').value) || 0;
      const disc = parseFloat(document.getElementById('discountRate').value) || 0;
      const tax = parseFloat(document.getElementById('taxRate').value) || 20;
      const curr = document.getElementById('currency').value || '₺';

      const subtotal = qty * price;
      const discountAmt = subtotal * (disc / 100);
      const afterDiscount = subtotal - discountAmt;
      const taxAmt = afterDiscount * (tax / 100);
      const total = afterDiscount + taxAmt;

      const symbol = curr === 'USD' ? '$' : curr === 'EUR' ? '€' : '₺';

      document.getElementById('calcSubtotal').textContent = `${subtotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${symbol}`;
      document.getElementById('calcDiscount').textContent = `${discountAmt.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${symbol}`;
      document.getElementById('calcTax').textContent = `${taxAmt.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${symbol}`;
      document.getElementById('calcTotal').textContent = `${total.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ${symbol}`;
    }

    updateTabBadges();
    calcMatrah();
  </script>
</body>
</html>
