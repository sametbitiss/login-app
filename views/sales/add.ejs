<!DOCTYPE html>
<html lang="tr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Satış Siparişi Oluştur — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .glass-form-card {
      background: rgba(12, 17, 28, 0.85);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(20px);
      padding: 2rem;
      position: relative;
      overflow: hidden;
      margin-bottom: 2.5rem;
    }

    .glass-form-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 50%, #10b981 100%);
    }

    /* Tab Timeline / Step Progress Styling */
    .step-progress-bar {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 2rem;
    }

    .step-progress-item {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 12px 16px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      user-select: none;
    }

    .step-progress-item:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.15);
      transform: translateY(-2px);
    }

    .step-progress-item.active {
      background: rgba(99, 102, 241, 0.12);
      border-color: #6366f1;
      box-shadow: 0 0 20px rgba(99, 102, 241, 0.25);
    }

    .step-progress-item.completed {
      background: rgba(16, 185, 129, 0.08);
      border-color: rgba(16, 185, 129, 0.4);
    }

    .spi-badge {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.875rem;
      flex-shrink: 0;
      transition: all 0.3s ease;
    }

    .step-progress-item.active .spi-badge {
      background: #6366f1;
      color: #fff;
      box-shadow: 0 0 10px rgba(99, 102, 241, 0.5);
    }

    .step-progress-item.completed .spi-badge {
      background: #10b981;
      color: #fff;
    }

    .spi-text {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .spi-text strong {
      font-size: 0.85rem;
      color: #fff;
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }

    .spi-text span {
      font-size: 0.725rem;
      color: var(--text-muted);
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }

    .tab-content-panel {
      display: none;
      animation: fadeInTab 0.35s ease-in-out;
    }

    .tab-content-panel.active {
      display: block;
    }

    @keyframes fadeInTab {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 768px) {
      .step-progress-bar { grid-template-columns: 1fr; }
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>

<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="8" fill="url(#bGrad)" />
          <path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
          <defs>
            <linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32">
              <stop offset="0%" stop-color="#6366f1" />
              <stop offset="100%" stop-color="#8b5cf6" />
            </linearGradient>
          </defs>
        </svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link active">📋 Satış Siparişleri</a>
        <a href="/sales/orders/add" class="mss-sub-link">➕ Yeni Sipariş Oluştur</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div class="page-header" style="margin-bottom: 1.5rem;">
        <div>
          <h1 style="font-weight: 900; letter-spacing: -0.02em;">Yeni Satış Siparişi Hazırla</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Alınan sipariş şartlarını, teslimat tarihini ve satılan ürün kalemlerini sekmeli sihirbazdan doldurun.</p>
        </div>
        <a href="/sales/orders" class="btn btn-secondary" style="border-radius: 12px;">◀ Sipariş Listesine Dön</a>
      </div>

      <% if (error) { %>
        <div class="error" style="margin-bottom: 1.5rem;"><%= error %></div>
      <% } %>

      <!-- GLASSFORM CARD WIZARD -->
      <div class="glass-form-card">
        <h3 style="color: #6366f1; font-size: 1.15rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 10px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
          </svg>
          📋 Satış Siparişi Oluşturma Sihirbazı
        </h3>

        <!-- STEP PROGRESS TIMELINE BAR -->
        <div class="step-progress-bar">
          <div class="step-progress-item active" onclick="switchOrderTab(1)" id="tab-pill-1">
            <div class="spi-badge">1</div>
            <div class="spi-text">
              <strong>Cari & Genel</strong>
              <span>Sipariş No & Müşteri Seçimi</span>
            </div>
          </div>
          <div class="step-progress-item" onclick="switchOrderTab(2)" id="tab-pill-2">
            <div class="spi-badge">2</div>
            <div class="spi-text">
              <strong>Ürün Kalemleri</strong>
              <span>Fiyatlandırma & İskonto</span>
            </div>
          </div>
          <div class="step-progress-item" onclick="switchOrderTab(3)" id="tab-pill-3">
            <div class="spi-badge">3</div>
            <div class="spi-text">
              <strong>Sipariş Şartları</strong>
              <span>Ödeme, Teslimat & Notlar</span>
            </div>
          </div>
        </div>

        <form action="/sales/orders/add" method="POST" id="orderForm">
          <input type="hidden" name="itemsJson" id="itemsJsonInput" value="[]">
          <input type="hidden" name="currency" id="currency" value="TRY">

          <!-- TAB CONTENT 1: CARİ MÜŞTERİ VE GENEL BİLGİLER -->
          <div class="tab-content-panel active" id="order-tab-1">
            <h4 style="font-size: 0.95rem; font-weight: 800; color: #818cf8; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
              <span>📋</span> 1. Sipariş ve Cari Müşteri Bilgileri
            </h4>

            <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
              <div class="input-group">
                <label for="orderNo">Sipariş No <span class="req-star">*</span></label>
                <input type="text" id="orderNo" name="orderNo" value="<%= nextOrderNo %>" required readonly
                  style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(99, 102, 241, 0.1); color: #818cf8; border-color: rgba(99, 102, 241, 0.3);">
              </div>
              <div class="input-group">
                <label for="customerId">Cari Müşteri Seçimi</label>
                <select id="customerId" name="customerId" onchange="fillCustomerName(this)">
                  <option value="">-- Genel / Kayıtsız Müşteri --</option>
                  <% (customers || []).forEach(c => {
                    const score = c.customerScore !== undefined ? c.customerScore : (c.musteriSkoru !== undefined ? c.musteriSkoru : 85);
                    const isBlocked = score < 50 || c.riskLevel==='High' || c.riskLevel==='Blocked' || c.riskLevel==='Critical' || c.riskSeviyesi==='Yuksek' || c.riskSeviyesi==='Kritik';
                    const cLimit = parseFloat(c.creditLimit || c.krediLimiti) || 100000;
                    const cBal = parseFloat(c.currentBalance || c.guncelBakiye) || 0;
                    const cPerson = c.contactPerson || c.ilgiliKisi || '';
                    const cPhone = c.phone || c.telefon || '';
                    const cEmail = c.email || c.eposta || '';
                    const cAddress = c.address || c.adres || '';
                    const cTax = c.taxNumber || c.vergiNo || '';
                  %>
                    <option value="<%= c.id %>" data-name="<%= c.companyName || c.firmaAdi %>" data-creditlimit="<%= cLimit %>"
                      data-currentbalance="<%= cBal %>" data-blocked="<%= isBlocked %>"
                      data-contactperson="<%= cPerson %>" data-phone="<%= cPhone %>" data-email="<%= cEmail %>" data-address="<%= cAddress %>" data-tax="<%= cTax %>"
                      <%= isBlocked ? 'disabled style="color:#f43f5e;"' : '' %>>
                      [<%= c.customerCode || c.musteriKodu %>] <%= c.companyName || c.firmaAdi %>
                      <%= isBlocked ? `(Puan: ${score}/100 ⭐ - 🚫 RİSKLİ / SİPARİŞ ENGELLİ)` : `(Puan: ${score}/100 ⭐ - Risk Limiti: ${cLimit.toLocaleString('tr-TR')} TL)` %>
                    </option>
                  <% }); %>
                </select>

                <!-- Dynamic Customer Risk Card -->
                <div id="customerRiskCard"
                  style="display: none; margin-top: 10px; padding: 10px 14px; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; font-size: 0.8rem;">
                  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                    <div><span style="color: var(--text-muted);">Toplam Risk Limiti:</span> <strong id="cardCreditLimit" style="color: #818cf8; font-family: 'JetBrains Mono', monospace;">0.00 TL</strong></div>
                    <div><span style="color: var(--text-muted);">Güncel Borç:</span> <strong id="cardCurrentBalance" style="color: #fbbf24; font-family: 'JetBrains Mono', monospace;">0.00 TL</strong></div>
                    <div><span style="color: var(--text-muted);">Kullanılabilir Limit:</span> <strong id="cardAvailableCredit" style="color: #34d399; font-family: 'JetBrains Mono', monospace;">0.00 TL</strong></div>
                  </div>
                </div>
              </div>
              <div class="input-group">
                <label for="customerName">Müşteri / Kurum Unvanı <span class="req-star">*</span></label>
                <input type="text" id="customerName" name="customerName" required placeholder="Müşteri adını girin">
              </div>
            </div>

            <!-- Readonly Customer Contact Info Grid -->
            <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
              <div class="input-group">
                <label for="customerTaxNo">Müşteriye Ait Vergi / Sicil No <small style="color: var(--text-muted);">(Cari Karttan Otomatik)</small></label>
                <input type="text" id="customerTaxNo" name="customerTaxNo" placeholder="— Cari seçildiğinde otomatik kilitlenir —" readonly style="background: rgba(255, 255, 255, 0.05); color: var(--text-muted); cursor: not-allowed; font-weight: 600;">
              </div>
              <div class="input-group">
                <label for="contactPerson">Müşteriye Ait İlgili Kişi <small style="color: var(--text-muted);">(Cari Karttan Otomatik)</small></label>
                <input type="text" id="contactPerson" name="contactPerson" placeholder="— Cari seçildiğinde otomatik gelir —" readonly style="background: rgba(255, 255, 255, 0.05); color: var(--text-muted); cursor: not-allowed; font-weight: 600;">
              </div>
              <div class="input-group">
                <label for="contactInfo">Müşteriye Ait İletişim (Tel / E-Posta) <small style="color: var(--text-muted);">(Değiştirilemez)</small></label>
                <input type="text" id="contactInfo" name="contactInfo" placeholder="— Cari seçildiğinde otomatik gelir —" readonly style="background: rgba(255, 255, 255, 0.05); color: var(--text-muted); cursor: not-allowed; font-weight: 600;">
              </div>
            </div>

            <!-- Address Inputs Grid -->
            <div class="form-grid form-grid--2" style="margin-bottom: 1.25rem;">
              <div class="input-group">
                <label for="billingAddress">Fatura Adresi</label>
                <textarea id="billingAddress" name="billingAddress" rows="2" placeholder="Fatura adresi (Cari kartından otomatik doldurulur)" style="width:100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 10px 12px; border-radius: 10px; font-size: 0.875rem;"></textarea>
              </div>
              <div class="input-group">
                <label for="shippingAddress">Sevk Adresi</label>
                <textarea id="shippingAddress" name="shippingAddress" rows="2" placeholder="Sevkiyat adresi (Cari kartından otomatik doldurulur)" style="width:100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 10px 12px; border-radius: 10px; font-size: 0.875rem;"></textarea>
              </div>
            </div>

            <div class="form-grid form-grid--3">
              <div class="input-group">
                <label for="orderDate">Sipariş Tarihi <small style="color: var(--text-muted);">(Bugün)</small></label>
                <input type="date" id="orderDate" name="orderDate" value="<%= new Date().toISOString().split('T')[0] %>" required>
              </div>
              <div class="input-group">
                <label for="requestedDeliveryDate">İstenen Termin Tarihi</label>
                <input type="date" id="requestedDeliveryDate" name="requestedDeliveryDate" min="<%= new Date().toISOString().split('T')[0] %>">
              </div>
              <div class="input-group">
                <label for="priority">Aciliyet Seviyesi</label>
                <select id="priority" name="priority">
                  <option value="Normal" selected>Normal</option>
                  <option value="High">Yüksek</option>
                  <option value="Urgent">Acil</option>
                </select>
              </div>
            </div>
          </div>

          <!-- TAB CONTENT 2: ÜRÜN KALEMLERİ VE FİYATLANDIRMA -->
          <div class="tab-content-panel" id="order-tab-2">
            <!-- Warning Alert for Min 1 Product Rule -->
            <div id="minItemWarningAlert"
              style="display: none; background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); padding: 14px 20px; border-radius: 12px; color: #f43f5e; font-size: 0.875rem; font-weight: 600; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              <span>⚠️ Siparişte en az 1 ürün bulunmalıdır. Son ürün kalemi silinemez.</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 12px;">
              <div>
                <h3 style="font-size: 1.05rem; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 10px; margin: 0;">
                  <span style="background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; font-family: 'JetBrains Mono', monospace;" id="itemCountBadge">0</span>
                  2. Sipariş Edilecek Ürün Kalemleri (Mamuller)
                </h3>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Siparişe eklenecek tüm mamul ürünleri stok kataloğundan çoklu seçimle ekleyin.</p>
              </div>

              <div>
                <button type="button" onclick="openProductSelectModal()" class="btn btn-sm"
                  style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 700; padding: 10px 20px; border-radius: 10px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3); gap: 8px;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                  📦 Stok Kartından Ürün Seç (Modal)
                </button>
              </div>
            </div>

            <!-- Table Container -->
            <div style="overflow-x: auto; border-radius: 14px; border: 1px solid var(--border); background: rgba(6, 8, 15, 0.8); margin-bottom: 1.5rem;">
              <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="itemsTable">
                <thead>
                  <tr style="background: rgba(19, 26, 43, 0.9); border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px;">
                    <th style="padding: 14px 16px; width: 45px; text-align: center;">#</th>
                    <th style="padding: 14px 16px; min-width: 240px;">Ürün / Mamul Kalemi</th>
                    <th style="padding: 14px 16px; width: 100px;">Miktar</th>
                    <th style="padding: 14px 16px; width: 140px;">Birim Fiyat</th>
                    <th style="padding: 14px 16px; width: 120px;">Para Birimi</th>
                    <th style="padding: 14px 16px; width: 110px;">İskonto (%)</th>
                    <th style="padding: 14px 16px; width: 90px;">KDV (%)</th>
                    <th style="padding: 14px 16px; width: 150px; text-align: right;">Satır Toplamı</th>
                    <th style="padding: 14px 16px; width: 60px; text-align: center;">Sil</th>
                  </tr>
                </thead>
                <tbody id="itemsTbody">
                  <tr id="emptyItemsPlaceholder">
                    <td colspan="9" style="padding: 35px; text-align: center; color: var(--text-muted);">
                      📦 Henüz sipariş kalemi eklenmedi.<br>
                      <span style="font-size: 0.8rem; margin-top: 6px; display: inline-block; color: #818cf8;">Yukarıdaki <strong>'📦 Stok Kartından Ürün Seç (Modal)'</strong> butonuna tıklayarak siparişe çoklu ürün seçebilirsiniz.</span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Live Summary Card -->
            <div style="background: linear-gradient(135deg, rgba(19, 26, 43, 0.8) 0%, rgba(12, 17, 28, 0.9) 100%); border-radius: 16px; border: 1px solid var(--border); padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; text-align: center;">
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Ara Toplam (Brüt)</span>
                  <strong id="displaySubtotal" style="font-size: 1.25rem; color: #fff; font-family: 'JetBrains Mono', monospace;">0.00 ₺</strong>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: #fb7185; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Toplam İskonto</span>
                  <strong id="displayDiscount" style="font-size: 1.25rem; color: #fb7185; font-family: 'JetBrains Mono', monospace;">- 0.00 ₺</strong>
                </div>
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Hesaplanan KDV</span>
                  <strong id="displayTax" style="font-size: 1.25rem; color: #fff; font-family: 'JetBrains Mono', monospace;">0.00 ₺</strong>
                </div>
                <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%); padding: 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.3);">
                  <span style="font-size: 0.75rem; font-weight: 700; color: #818cf8; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">GENEL TOPLAM</span>
                  <strong id="displayGrandTotal" style="font-size: 1.35rem; color: #818cf8; font-family: 'JetBrains Mono', monospace;">0.00 ₺</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB CONTENT 3: SİPARİŞ ŞARTLARI VE NOTLAR -->
          <div class="tab-content-panel" id="order-tab-3">
            <h4 style="font-size: 0.95rem; font-weight: 800; color: #10b981; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 8px;">
              <span>📝</span> 3. Sipariş Koşulları, Teslimat Şartları ve Özel Notlar
            </h4>

            <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
              <div class="input-group">
                <label for="paymentTerm">Ödeme Koşulu</label>
                <select id="paymentTerm" name="paymentTerm">
                  <option value="Pesin">Peşin (Ön Ödeme)</option>
                  <option value="Vadeli_30" selected>30 Gün Vadeli</option>
                  <option value="Vadeli_60">60 Gün Vadeli</option>
                  <option value="Vadeli_90">90 Gün Vadeli</option>
                  <option value="Kredi_Karti">Kredi Kartı</option>
                </select>
              </div>
              <div class="input-group">
                <label for="deliveryTerm">Sevkiyat & Teslimat Süresi</label>
                <input type="text" id="deliveryTerm" name="deliveryTerm"
                  placeholder="Örn: Sipariş onayından sonra 7 iş günü içinde adrese teslim."
                  value="Sipariş onayından sonra 7 iş günü içinde adrese teslim.">
              </div>
              <div class="input-group">
                <label for="deliveryTerms">Teslimat Şekli</label>
                <input type="text" id="deliveryTerms" name="deliveryTerms"
                  placeholder="Örn: Fabrika Teslim (EXW) veya Adrese Teslim (DDP)"
                  value="Fabrika Teslim (EXW)">
              </div>
            </div>

            <div class="input-group">
              <label for="notes">Sipariş Notları & Müşteriye Özel Şartlar</label>
              <textarea id="notes" name="notes" rows="4"
                placeholder="Siparişe eklemek istediğiniz özel imalat şartları, kargo bilgileri veya banka IBAN detaylarını buraya yazabilirsiniz..."></textarea>
            </div>
          </div>

          <!-- BOTTOM TAB NAVIGATION BAR -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.08);">
            <button type="button" class="btn btn-outline-secondary" id="btnPrevStep" onclick="navigateOrderStep(-1)"
              style="display: none; font-weight: 600; padding: 10px 22px; border-radius: 10px;">
              ← Önceki Adım
            </button>
            <div id="stepCounterBadge" style="font-size: 0.825rem; color: var(--text-muted); font-weight: 600;">
              Adım 1 / 3
            </div>
            <div>
              <button type="button" class="btn btn-primary" id="btnNextStep" onclick="navigateOrderStep(1)"
                style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); border: none; font-weight: 700; padding: 10px 24px; border-radius: 10px;">
                Sonraki Adım →
              </button>
              <button type="submit" class="btn btn-lg" id="btnSubmitOrder"
                style="display: none; background: linear-gradient(135deg, #6366f1 0%, #10b981 100%); color: #fff; border: none; font-weight: 700; padding: 12px 30px; border-radius: 12px; box-shadow: 0 4px 20px rgba(99, 102, 241, 0.35); gap: 10px;">
                📋 Siparişi Kaydet & Oluştur
              </button>
            </div>
          </div>

        </form>
      </div>
    </main>
  </div>

  <!-- PRODUCT SELECTION MODAL (CHECKBOX PARITY WITH QUOTES_ADD) -->
  <div id="productSelectModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(12px); z-index: 9999; display: none; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; width: 100%; max-width: 950px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7); position: relative;">
      
      <!-- Modal Header -->
      <div style="padding: 20px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: space-between; background: rgba(15, 23, 42, 0.95);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 1.5rem; background: rgba(99, 102, 241, 0.15); width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(99, 102, 241, 0.3);">📦</span>
          <div>
            <h2 style="font-size: 1.25rem; font-weight: 800; color: #fff; margin: 0;">Stok Kartlarından Mamul Ürün Seçimi</h2>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">Siparişe eklemek istediğiniz mamul ürünleri arayabilir ve çoklu seçim kutuları (checkbox) ile ekleyebilirsiniz.</p>
          </div>
        </div>
        <button type="button" onclick="closeProductSelectModal()" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: var(--text-muted); width: 36px; height: 36px; border-radius: 10px; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; cursor: pointer;">✕</button>
      </div>

      <!-- Modal Search & Filter Controls -->
      <div style="padding: 16px 24px; background: rgba(30, 41, 59, 0.5); border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
        <div style="flex: 1; min-width: 250px; position: relative;">
          <input type="text" id="modalProductSearch" oninput="renderModalProducts()" placeholder="🔍 Ürün adı veya stok numarası ile arayın..." style="width: 100%; padding: 10px 14px 10px 38px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.875rem; outline: none;">
          <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;">🔍</span>
        </div>

        <div style="width: 320px;">
          <select id="modalProductSort" onchange="renderModalProducts()" style="width: 100%; padding: 10px 14px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.85rem; outline: none; font-weight: 600;">
            <option value="ad_asc" selected>🔤 Ürün İsmine Göre: A'dan Z'ye</option>
            <option value="ad_desc">🔤 Ürün İsmine Göre: Z'den A'ya</option>
            <option value="stokKodu_asc">🔢 Stok Numarasına Göre: Küçükten Büyüğe</option>
            <option value="stokKodu_desc">🔢 Stok Numarasına Göre: Büyükten Küçüğe</option>
          </select>
        </div>
      </div>

      <!-- Modal Product List Table -->
      <div style="flex: 1; overflow-y: auto; padding: 16px 24px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="modalProductsTable">
          <thead>
            <tr style="background: rgba(30, 41, 59, 0.8); border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; position: sticky; top: 0; z-index: 10;">
              <th style="padding: 12px 14px; width: 45px; text-align: center;">
                <input type="checkbox" id="modalSelectAllChk" onchange="toggleSelectAllModalProducts(this)" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;">
              </th>
              <th style="padding: 12px 14px; width: 150px;">Stok Kodu</th>
              <th style="padding: 12px 14px;">Ürün / Mamul Adı</th>
              <th style="padding: 12px 14px; width: 110px;">Kategori</th>
              <th style="padding: 12px 14px; width: 120px; text-align: right;">Birim Fiyat</th>
              <th style="padding: 12px 14px; width: 110px; text-align: center;">Stok</th>
              <th style="padding: 12px 14px; width: 110px; text-align: center;">Eklenecek Miktar</th>
            </tr>
          </thead>
          <tbody id="modalProductsTbody">
            <!-- Rendered dynamically by renderModalProducts() -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div style="padding: 16px 24px; border-top: 1px solid rgba(255, 255, 255, 0.1); background: rgba(15, 23, 42, 0.95); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;" id="modalSelectedCountBadge">
          0 Ürün Seçildi
        </div>
        <div style="display: flex; gap: 12px;">
          <button type="button" class="btn btn-secondary" onclick="closeProductSelectModal()" style="padding: 10px 20px; border-radius: 10px;">İptal</button>
          <button type="button" class="btn btn-primary" onclick="addSelectedProductsToOrder()" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 700; padding: 10px 24px; border-radius: 10px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);">
            ✅ Seçilen Ürünleri Siparişe Ekle
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Master JSON Data -->
  <script id="stockCatalogData" type="application/json"><%- JSON.stringify(stockItems || []) %></script>

  <script>
    const stockCatalog = JSON.parse(document.getElementById('stockCatalogData').textContent || '[]');

    let currentStep = 1;
    const totalSteps = 3;

    function switchOrderTab(stepNum) {
      if (stepNum < 1 || stepNum > totalSteps) return;
      currentStep = stepNum;

      for (let i = 1; i <= totalSteps; i++) {
        const panel = document.getElementById(`order-tab-${i}`);
        const pill = document.getElementById(`tab-pill-${i}`);
        if (panel) {
          if (i === stepNum) panel.classList.add('active');
          else panel.classList.remove('active');
        }
        if (pill) {
          if (i === stepNum) pill.classList.add('active');
          else {
            pill.classList.remove('active');
            if (i < stepNum) pill.classList.add('completed');
          }
        }
      }

      const btnPrev = document.getElementById('btnPrevStep');
      const btnNext = document.getElementById('btnNextStep');
      const btnSubmit = document.getElementById('btnSubmitOrder');
      const counterBadge = document.getElementById('stepCounterBadge');

      if (btnPrev) btnPrev.style.display = currentStep > 1 ? 'inline-flex' : 'none';

      if (currentStep === totalSteps) {
        if (btnNext) btnNext.style.display = 'none';
        if (btnSubmit) btnSubmit.style.display = 'inline-flex';
      } else {
        if (btnNext) btnNext.style.display = 'inline-flex';
        if (btnSubmit) btnSubmit.style.display = 'none';
      }

      if (counterBadge) counterBadge.textContent = `Adım ${currentStep} / ${totalSteps}`;
    }

    function navigateOrderStep(direction) {
      if (direction === 1) {
        if (currentStep === 1) {
          const custNameInput = document.getElementById('customerName');
          if (!custNameInput || !custNameInput.value.trim()) {
            alert('⚠️ Lütfen önce Müşteri Unvanını giriniz veya Cari seçiniz.');
            if (custNameInput) custNameInput.focus();
            return;
          }
        }
      }
      switchOrderTab(currentStep + direction);
    }

    function openProductSelectModal() {
      const modal = document.getElementById('productSelectModal');
      if (!modal) return;
      document.getElementById('modalProductSearch').value = '';
      document.getElementById('modalProductSort').value = 'ad_asc';
      document.getElementById('modalSelectAllChk').checked = false;
      modal.style.display = 'flex';
      renderModalProducts();
    }

    function closeProductSelectModal() {
      const modal = document.getElementById('productSelectModal');
      if (modal) modal.style.display = 'none';
    }

    function getAlreadyAddedStockIds() {
      const rows = document.querySelectorAll('#itemsTbody .item-stock-id');
      const ids = [];
      rows.forEach(inp => {
        const val = parseInt(inp.value, 10);
        if (val && !isNaN(val)) ids.push(val);
      });
      return ids;
    }

    function renderModalProducts() {
      const tbody = document.getElementById('modalProductsTbody');
      if (!tbody) return;

      const alreadyAddedIds = getAlreadyAddedStockIds();
      const searchVal = (document.getElementById('modalProductSearch')?.value || '').toLowerCase().trim();
      const sortVal = document.getElementById('modalProductSort')?.value || 'ad_asc';

      let items = (stockCatalog || []).filter(item => {
        const code = (item.stokKodu || item.stockCode || '').toLowerCase();
        const name = (item.ad || item.name || '').toLowerCase();
        return code.includes(searchVal) || name.includes(searchVal);
      });

      items.sort((a, b) => {
        const codeA = (a.stokKodu || a.stockCode || '').toLowerCase();
        const codeB = (b.stokKodu || b.stockCode || '').toLowerCase();
        const nameA = (a.ad || a.name || '').toLowerCase();
        const nameB = (b.ad || b.name || '').toLowerCase();

        if (sortVal === 'stokKodu_asc') return codeA.localeCompare(codeB, 'tr', { numeric: true });
        if (sortVal === 'stokKodu_desc') return codeB.localeCompare(codeA, 'tr', { numeric: true });
        if (sortVal === 'ad_desc') return nameB.localeCompare(nameA, 'tr');
        return nameA.localeCompare(nameB, 'tr');
      });

      if (items.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" style="padding: 40px; text-align: center; color: var(--text-muted);">🔍 Kriterlere uygun mamul ürün bulunamadı.</td></tr>`;
        updateModalSelectedCount();
        return;
      }

      tbody.innerHTML = items.map(st => {
        const code = st.stokKodu || st.stockCode || '';
        const name = st.ad || st.name || '';
        const category = st.kategori || 'Mamul';
        const price = parseFloat(st.satisFiyati || st.salePrice || 0);
        const stock = parseFloat(st.mevcutStok || st.currentStock || 0);
        const unit = st.birim || 'Adet';
        const isAdded = alreadyAddedIds.includes(st.id);

        return `
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); opacity: ${isAdded ? '0.6' : '1'};">
            <td style="padding: 10px 14px; text-align: center;">
              <input type="checkbox" class="modal-product-chk" data-id="${st.id}" ${isAdded ? 'disabled checked' : ''} onchange="updateModalSelectedCount()" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;">
            </td>
            <td style="padding: 10px 14px; font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: #818cf8; font-weight: 600;">${code}</td>
            <td style="padding: 10px 14px; font-weight: 600; color: #fff;">
              ${name}
              ${isAdded ? '<span style="margin-left: 8px; font-size: 0.725rem; background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 2px 6px; border-radius: 4px;">✓ Zaten Ekli</span>' : ''}
            </td>
            <td style="padding: 10px 14px;"><span style="background: rgba(99, 102, 241, 0.12); color: #818cf8; padding: 2px 8px; border-radius: 8px; font-size: 0.75rem; font-weight: 600;">${category}</span></td>
            <td style="padding: 10px 14px; text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fff;">${price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ₺</td>
            <td style="padding: 10px 14px; text-align: center; font-size: 0.8rem; color: ${stock > 0 ? '#34d399' : '#fb7185'}; font-weight: 600;">${stock} ${unit}</td>
            <td style="padding: 10px 14px; text-align: center;">
              <input type="number" min="0.01" step="1" value="1" class="modal-product-qty" data-id="${st.id}" ${isAdded ? 'disabled' : ''} style="width: 75px; background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 4px 8px; border-radius: 6px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
            </td>
          </tr>
        `;
      }).join('');

      updateModalSelectedCount();
    }

    function toggleSelectAllModalProducts(mainChk) {
      const checkboxes = document.querySelectorAll('.modal-product-chk:not([disabled])');
      checkboxes.forEach(chk => chk.checked = mainChk.checked);
      updateModalSelectedCount();
    }

    function updateModalSelectedCount() {
      const checkedCount = document.querySelectorAll('.modal-product-chk:checked:not([disabled])').length;
      const badge = document.getElementById('modalSelectedCountBadge');
      if (badge) badge.textContent = `${checkedCount} Yeni Ürün Seçildi`;
    }

    function addSelectedProductsToOrder() {
      const checkedChks = document.querySelectorAll('.modal-product-chk:checked:not([disabled])');
      if (checkedChks.length === 0) {
        alert('⚠️ Lütfen siparişe eklemek istediğiniz en az 1 ürün işaretleyiniz.');
        return;
      }

      const tbody = document.getElementById('itemsTbody');
      const placeholder = document.getElementById('emptyItemsPlaceholder');
      if (placeholder) placeholder.remove();

      const existingRows = tbody.querySelectorAll('tr:not(#emptyItemsPlaceholder)');
      if (existingRows.length === 1) {
        const firstStockInput = existingRows[0].querySelector('.item-stock-id');
        if (firstStockInput && (!firstStockInput.value || firstStockInput.value === 'null' || firstStockInput.value === 'NaN')) {
          existingRows[0].remove();
        }
      }

      checkedChks.forEach(chk => {
        const stockId = chk.getAttribute('data-id');
        const item = (stockCatalog || []).find(s => String(s.id) === String(stockId));
        if (!item) return;

        const qtyInput = document.querySelector(`.modal-product-qty[data-id="${stockId}"]`);
        const qty = qtyInput ? (parseFloat(qtyInput.value) || 1) : 1;
        const unitPrice = parseFloat(item.satisFiyati || item.salePrice || 0);
        const taxRate = parseFloat(item.kdvOrani || item.taxRate || 20);

        addNewRow({
          stockItemId: item.id,
          stokId: item.id,
          stockCode: item.stokKodu || item.stockCode || '',
          stokKodu: item.stokKodu || item.stockCode || '',
          name: item.ad || item.name || '',
          ad: item.ad || item.name || '',
          quantity: qty,
          unitPrice: unitPrice,
          discountRate: 0,
          taxRate: taxRate
        });
      });

      closeProductSelectModal();
      recalculate();
    }

    function fillCustomerName(selectEl) {
      const selectedOption = selectEl.options[selectEl.selectedIndex];
      const name = selectedOption.getAttribute('data-name') || '';
      const contactPerson = selectedOption.getAttribute('data-contactperson') || '—';
      const phone = selectedOption.getAttribute('data-phone') || '';
      const email = selectedOption.getAttribute('data-email') || '';
      const address = selectedOption.getAttribute('data-address') || '';
      const taxNo = selectedOption.getAttribute('data-tax') || '';

      let contactInfoStr = '—';
      if (phone && email) contactInfoStr = `${phone} / ${email}`;
      else if (phone) contactInfoStr = phone;
      else if (email) contactInfoStr = email;

      const cLimit = parseFloat(selectedOption.getAttribute('data-creditlimit')) || 0;
      const cBalance = parseFloat(selectedOption.getAttribute('data-currentbalance')) || 0;

      document.getElementById('customerName').value = name;
      document.getElementById('customerTaxNo').value = taxNo;
      document.getElementById('contactPerson').value = selectEl.value ? contactPerson : '';
      document.getElementById('contactInfo').value = selectEl.value ? contactInfoStr : '';
      document.getElementById('billingAddress').value = selectEl.value ? address : '';
      document.getElementById('shippingAddress').value = selectEl.value ? address : '';

      const riskCard = document.getElementById('customerRiskCard');
      if (selectEl.value && cLimit > 0) {
        const availableCredit = cLimit - cBalance;
        document.getElementById('cardCreditLimit').textContent = cLimit.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';
        document.getElementById('cardCurrentBalance').textContent = cBalance.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';
        document.getElementById('cardAvailableCredit').textContent = availableCredit.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';
        if (riskCard) riskCard.style.display = 'block';
      } else {
        if (riskCard) riskCard.style.display = 'none';
      }

      recalculate();
    }

    let rowIdCounter = 0;

    function addNewRow(initialData = null) {
      rowIdCounter++;
      const tbody = document.getElementById('itemsTbody');
      const placeholder = document.getElementById('emptyItemsPlaceholder');
      if (placeholder) placeholder.remove();

      const tr = document.createElement('tr');
      tr.id = `row-${rowIdCounter}`;

      const stockId = initialData ? (initialData.stockItemId || initialData.stokId) : null;
      const st = (stockCatalog || []).find(s => String(s.id) === String(stockId));
      const code = initialData ? (initialData.stockCode || initialData.stokKodu || (st ? (st.stokKodu || st.stockCode || '') : '')) : (st ? (st.stokKodu || st.stockCode || '') : '');
      const name = initialData ? (initialData.name || initialData.ad || (st ? (st.ad || st.name || '') : '')) : (st ? (st.ad || st.name || '') : '');

      const qty = initialData ? parseFloat(initialData.quantity || initialData.miktar || 1) : 1;
      const price = initialData ? parseFloat(initialData.unitPrice || initialData.birimFiyat || 0) : (st ? parseFloat(st.satisFiyati || st.salePrice || 0) : 0);
      const itemCurr = initialData ? (initialData.currency || initialData.paraBirimi || 'TRY') : (st ? (st.paraBirimi || st.currency || 'TRY') : 'TRY');
      const discount = initialData ? parseFloat(initialData.discountRate || initialData.iskontoOrani || 0) : 0;
      const tax = initialData ? parseFloat(initialData.taxRate || initialData.kdvOrani || 20) : (st ? parseFloat(st.kdvOrani || st.taxRate || 20) : 20);

      tr.innerHTML = `
        <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-muted);" class="row-index">1</td>
        <td style="padding: 12px 14px;">
          <input type="hidden" class="item-stock-id" value="${stockId || ''}" data-code="${code}" data-name="${name}">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.775rem; color: #818cf8; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.25); padding: 4px 10px; border-radius: 8px; font-weight: 700; flex-shrink: 0;">
              ${code || 'STOK-N/A'}
            </span>
            <strong style="color: #fff; font-size: 0.925rem; font-weight: 600; line-height: 1.3;">${name || 'Seçilen Ürün'}</strong>
          </div>
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0.01" value="${qty}" class="item-qty" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; text-align: center; font-weight: 600;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0" value="${price}" class="item-price" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; text-align: right; font-weight: 600;">
        </td>
        <td style="padding: 12px 14px;">
          <select class="item-currency" onchange="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #818cf8; padding: 8px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
            <option value="TRY" ${itemCurr === 'TRY' ? 'selected' : ''}>TRY (₺)</option>
            <option value="USD" ${itemCurr === 'USD' ? 'selected' : ''}>USD ($)</option>
            <option value="EUR" ${itemCurr === 'EUR' ? 'selected' : ''}>EUR (€)</option>
          </select>
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0" max="100" value="${discount}" class="item-discount" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fb7185; padding: 8px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; text-align: center; font-weight: 600;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0" max="100" value="${tax}" class="item-tax" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px; border-radius: 8px; font-family: 'JetBrains Mono', monospace; text-align: center;">
        </td>
        <td style="padding: 12px 14px; text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #34d399;" class="item-linetotal">
          0.00 ₺
        </td>
        <td style="padding: 12px 14px; text-align: center;">
          <button type="button" onclick="removeRow('${tr.id}')" style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.3); color: #f43f5e; border-radius: 8px; width: 32px; height: 32px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;">✕</button>
        </td>
      `;

      tbody.appendChild(tr);
      updateRowIndices();
      recalculate();
    }

    function removeRow(trId) {
      const tbody = document.getElementById('itemsTbody');
      const rows = tbody.querySelectorAll('tr:not(#emptyItemsPlaceholder)');
      if (rows.length <= 1) {
        const warn = document.getElementById('minItemWarningAlert');
        if (warn) warn.style.display = 'flex';
        return;
      }

      const tr = document.getElementById(trId);
      if (tr) tr.remove();
      updateRowIndices();
      recalculate();
    }

    function updateRowIndices() {
      const rows = document.querySelectorAll('#itemsTbody tr:not(#emptyItemsPlaceholder)');
      rows.forEach((tr, index) => {
        const idxTd = tr.querySelector('.row-index');
        if (idxTd) idxTd.textContent = index + 1;
      });
      const badge = document.getElementById('itemCountBadge');
      if (badge) badge.textContent = rows.length;
    }

    function recalculate() {
      const rows = document.querySelectorAll('#itemsTbody tr:not(#emptyItemsPlaceholder)');
      let grandSubtotal = 0;
      let grandDiscount = 0;
      let grandTax = 0;
      let grandTotal = 0;

      const itemsData = [];

      rows.forEach(tr => {
        const stockIdInput = tr.querySelector('.item-stock-id');
        if (!stockIdInput) return;
        const stockItemId = parseInt(stockIdInput.value, 10);
        if (isNaN(stockItemId) || stockItemId <= 0) return;

        let stockCode = stockIdInput.getAttribute('data-code') || '';
        let stockName = stockIdInput.getAttribute('data-name') || '';

        if (!stockName || stockName === 'Seçilen Ürün' || stockName === 'Ürün Kalemi') {
          const st = (stockCatalog || []).find(s => String(s.id) === String(stockItemId));
          if (st) {
            stockName = st.ad || st.name || '';
            stockCode = st.stokKodu || st.stockCode || '';
            stockIdInput.setAttribute('data-name', stockName);
            stockIdInput.setAttribute('data-code', stockCode);
          }
        }

        const qtyInput = tr.querySelector('.item-qty');
        const priceInput = tr.querySelector('.item-price');
        const currSelect = tr.querySelector('.item-currency');
        const discInput = tr.querySelector('.item-discount');
        const taxInput = tr.querySelector('.item-tax');
        const linetotalTd = tr.querySelector('.item-linetotal');

        const qty = parseFloat(qtyInput.value) || 1;
        const price = parseFloat(priceInput.value) || 0;
        const currencyVal = currSelect ? currSelect.value : 'TRY';
        const discRate = parseFloat(discInput.value) || 0;
        const taxRate = parseFloat(taxInput.value) || 20;

        const subtotal = qty * price;
        const discAmount = subtotal * (discRate / 100);
        const afterDisc = subtotal - discAmount;
        const taxAmount = afterDisc * (taxRate / 100);
        const total = afterDisc + taxAmount;

        grandSubtotal += subtotal;
        grandDiscount += discAmount;
        grandTax += taxAmount;
        grandTotal += total;

        linetotalTd.textContent = total.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + currencyVal;

        itemsData.push({
          stokId: stockItemId,
          stockItemId: stockItemId,
          stockCode,
          stokKodu: stockCode,
          name: stockName,
          ad: stockName,
          quantity: qty,
          miktar: qty,
          unitPrice: price,
          birimFiyat: price,
          currency: currencyVal,
          paraBirimi: currencyVal,
          discountRate: discRate,
          iskontoOrani: discRate,
          taxRate: taxRate,
          kdvOrani: taxRate,
          subtotal: subtotal,
          araToplam: subtotal,
          discountAmount: discAmount,
          iskontoTutari: discAmount,
          taxAmount: taxAmount,
          kdvTutari: taxAmount,
          totalAmount: total,
          toplamTutar: total
        });
      });

      document.getElementById('displaySubtotal').textContent = grandSubtotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺';
      document.getElementById('displayDiscount').textContent = '- ' + grandDiscount.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺';
      document.getElementById('displayTax').textContent = grandTax.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺';
      document.getElementById('displayGrandTotal').textContent = grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' ₺';

      document.getElementById('itemsJsonInput').value = JSON.stringify(itemsData);
    }

    const orderForm = document.getElementById('orderForm');
    if (orderForm) {
      orderForm.addEventListener('submit', function(e) {
        recalculate();
        const payload = document.getElementById('itemsJsonInput').value;
        let arr = [];
        try { arr = JSON.parse(payload); } catch(err) { arr = []; }
        if (!arr || arr.length === 0) {
          e.preventDefault();
          alert('⚠️ Lütfen siparişe en az 1 adet geçerli stok kalemi ekleyiniz!');
          switchOrderTab(2);
          return false;
        }
      });
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>