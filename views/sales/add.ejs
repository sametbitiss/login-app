<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Satış Siparişi Oluştur — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    @keyframes fadeInTab {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .tab-pane.active {
      animation: fadeInTab 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .step-pill {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 14px 20px;
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }
    .step-pill:hover {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(99, 102, 241, 0.3);
      color: #fff;
    }
    .step-pill.active {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.2) 0%, rgba(139, 92, 246, 0.15) 100%);
      border: 1px solid rgba(99, 102, 241, 0.5);
      color: #fff;
      font-weight: 700;
      box-shadow: 0 4px 20px rgba(99, 102, 241, 0.25);
    }
    .step-badge {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 800;
      transition: all 0.3s ease;
    }
    .step-pill.active .step-badge {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      color: #fff;
      box-shadow: 0 2px 10px rgba(99, 102, 241, 0.4);
    }
    .glass-hero-card {
      background: rgba(12, 17, 28, 0.75);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(16px);
      padding: 1.75rem;
      position: relative;
      overflow: hidden;
    }
    .glass-hero-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #6366f1 0%, #8b5cf6 50%, #10b981 100%);
    }
  </style>
</head>
<body class="module-body">

  <!-- Module Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/orders/add" class="mss-sub-link active">➕ Yeni Sipariş Oluştur</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <!-- Sidebar User -->
    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <!-- Main Area -->
  <div class="module-main">
    <!-- Top Navbar -->
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <!-- Content -->
    <main class="module-content">
      <div class="page-header" style="margin-bottom: 1.5rem;">
        <div>
          <h1 style="font-weight: 900; letter-spacing: -0.02em;">Yeni Satış Siparişi Oluştur</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Sipariş numarası otomatik atanır. Sekmeli menüyü takip ederek adımları tamamlayın.</p>
        </div>
        <a href="/sales/orders" class="btn btn-secondary" style="border-radius: 12px; gap: 8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Listeye Dön
        </a>
      </div>

      <% if (error) { %>
        <div class="error" style="margin-bottom: 1.5rem;"><%= error %></div>
      <% } %>

      <!-- STEP PROGRESS TAB NAVIGATION TIMELINE -->
      <div style="display: flex; gap: 12px; margin-bottom: 1.75rem; flex-wrap: wrap;">
        <div class="step-pill active" onclick="switchTab(1)" id="tabBtn1">
          <span class="step-badge" id="badge1">1</span>
          <span>📋 Cari Müşteri & Genel Bilgiler</span>
        </div>
        <div class="step-pill" onclick="switchTab(2)" id="tabBtn2">
          <span class="step-badge" id="badge2">2</span>
          <span>📦 Ürün & Mamul Kalemleri</span>
        </div>
        <div class="step-pill" onclick="switchTab(3)" id="tabBtn3">
          <span class="step-badge" id="badge3">3</span>
          <span>🚚 Sevkiyat, Ödeme & Notlar</span>
        </div>
      </div>

      <div class="glass-hero-card">
        <form action="/sales/orders/add" method="POST" id="orderForm" style="display: flex; flex-direction: column; gap: 1.5rem;">
          
          <input type="hidden" name="itemsJson" id="itemsJsonInput" value="[]">

          <!-- TAB 1: Cari Müşteri & Genel Bilgiler -->
          <div id="tabContent1" class="tab-pane active" style="display: block;">
            <div>
              <h3 style="font-size: 1.05rem; font-weight: 800; color: #818cf8; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                1. Sipariş & Cari Müşteri Bilgileri
              </h3>
              
              <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
                <div class="input-group">
                  <label for="orderNo">Sipariş No <small style="color: var(--text-muted);">(Otomatik)</small></label>
                  <input type="text" id="orderNo" name="orderNo" value="<%= nextOrderNo %>" required readonly style="font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(99, 102, 241, 0.1); color: #818cf8; border-color: rgba(99, 102, 241, 0.3); cursor: not-allowed;">
                </div>
                <div class="input-group">
                  <label for="customerId">Cari Müşteri Seçimi</label>
                  <select id="customerId" name="customerId" onchange="fillCustomerName(this)">
                    <option value="">-- Genel / Kayıtsız Müşteri --</option>
                    <% customers.forEach(c => { 
                      const score = c.customerScore !== undefined ? c.customerScore : 85;
                      const isBlocked = score < 50 || c.riskLevel === 'High' || c.riskLevel === 'Blocked' || c.riskLevel === 'Critical';
                    %>
                      <option value="<%= c.id %>" data-name="<%= c.companyName %>" data-tax="<%= c.taxNo || '' %>" data-phone="<%= c.phone || '' %>" data-blocked="<%= isBlocked %>" <%= isBlocked ? 'disabled style="color:#f43f5e;"' : '' %>>
                        [<%= c.customerCode %>] <%= c.companyName %> <%= isBlocked ? `(Puan: ${score}/100 ⭐ - 🚫 RİSKLİ / SİPARİŞ ENGELLİ)` : `(Puan: ${score}/100 ⭐)` %>
                      </option>
                    <% }); %>
                  </select>
                </div>
                <div class="input-group">
                  <label for="customerName">Müşteri / Kurum Unvanı <span class="req-star">*</span></label>
                  <input type="text" id="customerName" name="customerName" value="<%= formData.customerName || '' %>" required placeholder="Müşteri unvanını girin">
                </div>
              </div>

              <div class="form-grid form-grid--3">
                <div class="input-group">
                  <label for="orderDate">Sipariş Tarihi <small style="color: var(--text-muted);">(Bugün)</small></label>
                  <input type="date" id="orderDate" name="orderDate" value="<%= new Date().toISOString().split('T')[0] %>" required readonly style="background: rgba(255, 255, 255, 0.05); color: var(--text-muted); cursor: not-allowed;">
                </div>
                <div class="input-group">
                  <label for="deliveryDate">Tahmini Teslimat Tarihi</label>
                  <input type="date" id="deliveryDate" name="deliveryDate" value="<%= formData.deliveryDate || '' %>" min="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="input-group">
                  <label for="priority">Sipariş Önceliği</label>
                  <select id="priority" name="priority">
                    <option value="Low" <%= formData.priority === 'Low' ? 'selected' : '' %>>Düşük</option>
                    <option value="Normal" <%= formData.priority === 'Normal' || !formData.priority ? 'selected' : '' %>>Normal</option>
                    <option value="High" <%= formData.priority === 'High' ? 'selected' : '' %>>Yüksek</option>
                    <option value="Urgent" <%= formData.priority === 'Urgent' ? 'selected' : '' %>>Acil</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Tab 1 Next Action -->
            <div style="display: flex; justify-content: flex-end; margin-top: 2rem;">
              <button type="button" onclick="goToTab(2)" class="btn btn-primary" style="padding: 12px 28px; border-radius: 12px; font-weight: 700; gap: 10px; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);">
                2. Adım: Ürün Kalemlerine Geç ➔
              </button>
            </div>
          </div>

          <!-- TAB 2: Ürün & Mamul Kalemleri -->
          <div id="tabContent2" class="tab-pane" style="display: none;">
            <div>
              <!-- Red Warning Alert for Min 1 Product Rule -->
              <div id="minItemWarningAlert" style="display: none; background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); padding: 14px 20px; border-radius: 12px; color: #f43f5e; font-size: 0.875rem; font-weight: 600; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>⚠️ Siparişte en az 1 ürün bulunmalıdır. Son ürün kalemi silinemez.</span>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 12px;">
                <div>
                  <h3 style="font-size: 1.05rem; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 10px;">
                    <span style="background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; font-family: 'JetBrains Mono', monospace;" id="itemCountBadge">1</span>
                    2. Sipariş Edilecek Ürün Kalemleri (Mamuller)
                  </h3>
                  <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Siparişe dahil edilecek ürünleri ekleyin, miktar ve satır bazlı iskontoları belirtin.</p>
                </div>

                <button type="button" onclick="addNewRow()" class="btn btn-sm" style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); color: #fff; border: none; font-weight: 600; padding: 10px 20px; border-radius: 10px; box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3); gap: 8px; transition: all 0.25s ease;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  + Yeni Ürün Kalemi Ekle
                </button>
              </div>

              <!-- Table Container -->
              <div style="overflow-x: auto; border-radius: 14px; border: 1px solid var(--border); background: rgba(6, 8, 15, 0.8); margin-bottom: 1.5rem;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="itemsTable">
                  <thead>
                    <tr style="background: rgba(19, 26, 43, 0.9); border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px;">
                      <th style="padding: 14px 16px; width: 45px; text-align: center;">#</th>
                      <th style="padding: 14px 16px; min-width: 260px;">Ürün / Mamul Kalemi</th>
                      <th style="padding: 14px 16px; width: 110px;">Miktar</th>
                      <th style="padding: 14px 16px; width: 140px;">Birim Fiyat</th>
                      <th style="padding: 14px 16px; width: 110px;">İskonto (%)</th>
                      <th style="padding: 14px 16px; width: 100px;">KDV (%)</th>
                      <th style="padding: 14px 16px; width: 150px; text-align: right;">Satır Toplamı</th>
                      <th style="padding: 14px 16px; width: 60px; text-align: center;">Sil</th>
                    </tr>
                  </thead>
                  <tbody id="itemsTbody">
                    <!-- Dynamic rows generated by JavaScript -->
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Live Summary Cards -->
            <div style="background: linear-gradient(135deg, rgba(19, 26, 43, 0.8) 0%, rgba(12, 17, 28, 0.9) 100%); border-radius: 16px; border: 1px solid var(--border); padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
              
              <div id="approvalWarningAlert" style="display: none; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); padding: 12px 18px; border-radius: 10px; color: #fbbf24; font-size: 0.85rem; font-weight: 600; align-items: center; gap: 10px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>⚡ Bu sipariş yüksek iskonto (>%20) veya yüksek toplam tutar (>100.000 TL) içerdiği için otomatik olarak "Onay Bekliyor" statüsüne düşecektir.</span>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; text-align: center;">
                <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Ara Toplam (Brüt)</span>
                  <strong id="displaySubtotal" style="font-size: 1.25rem; color: #fff; font-family: 'JetBrains Mono', monospace;">0.00 ₺</strong>
                </div>
                
                <div style="background: rgba(244, 63, 94, 0.05); padding: 16px; border-radius: 12px; border: 1px solid rgba(244, 63, 94, 0.15);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: #f43f5e; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Toplam Sipariş İskontosu</span>
                  <strong id="displayDiscount" style="font-size: 1.25rem; color: #fb7185; font-family: 'JetBrains Mono', monospace;">- 0.00 ₺</strong>
                </div>

                <div style="background: rgba(99, 102, 241, 0.05); padding: 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.15);">
                  <span style="font-size: 0.75rem; font-weight: 600; color: #818cf8; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Toplam KDV Tutarı</span>
                  <strong id="displayTax" style="font-size: 1.25rem; color: #a5b4fc; font-family: 'JetBrains Mono', monospace;">+ 0.00 ₺</strong>
                </div>

                <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(6, 182, 212, 0.1) 100%); padding: 16px; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.3); box-shadow: 0 0 25px rgba(16, 185, 129, 0.1);">
                  <span style="font-size: 0.75rem; font-weight: 700; color: #34d399; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">GENEL SİPARİŞ TOPLAMI</span>
                  <strong id="displayTotal" style="font-size: 1.45rem; color: #10b981; font-family: 'JetBrains Mono', monospace; text-shadow: 0 0 10px rgba(16, 185, 129, 0.3);">0.00 ₺</strong>
                </div>
              </div>
            </div>

            <!-- Tab 2 Navigation -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
              <button type="button" onclick="goToTab(1)" class="btn btn-secondary" style="padding: 12px 22px; border-radius: 12px;">
                ⬅ 1. Müşteri Bilgilerine Dön
              </button>
              <button type="button" onclick="goToTab(3)" class="btn btn-primary" style="padding: 12px 28px; border-radius: 12px; font-weight: 700; gap: 10px; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);">
                3. Adım: Sevkiyat ve Ödemeye Geç ➔
              </button>
            </div>
          </div>

          <!-- TAB 3: Sevkiyat, Ödeme & Notlar -->
          <div id="tabContent3" class="tab-pane" style="display: none;">
            <div>
              <h3 style="font-size: 1.05rem; font-weight: 800; color: #818cf8; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 10px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                3. Ödeme & Sevkiyat Koşulları
              </h3>
              
              <div class="form-grid form-grid--3" style="margin-bottom: 1.25rem;">
                <div class="input-group">
                  <label for="paymentTerm">Ödeme Şekli / Vade</label>
                  <select id="paymentTerm" name="paymentTerm">
                    <option value="Pesin" <%= formData.paymentTerm === 'Pesin' ? 'selected' : '' %>>Peşin Ödeme</option>
                    <option value="Vadeli_30" <%= formData.paymentTerm === 'Vadeli_30' || !formData.paymentTerm ? 'selected' : '' %>>30 Gün Vadeli</option>
                    <option value="Vadeli_60" <%= formData.paymentTerm === 'Vadeli_60' ? 'selected' : '' %>>60 Gün Vadeli</option>
                    <option value="Vadeli_90" <%= formData.paymentTerm === 'Vadeli_90' ? 'selected' : '' %>>90 Gün Vadeli</option>
                    <option value="Kredi_Karti" <%= formData.paymentTerm === 'Kredi_Karti' ? 'selected' : '' %>>Kredi Kartı</option>
                  </select>
                </div>

                <div class="input-group">
                  <label for="currency">Para Birimi</label>
                  <select id="currency" name="currency" onchange="recalculate()">
                    <option value="TRY">TRY (₺)</option>
                    <option value="USD">USD ($)</option>
                    <option value="EUR">EUR (€)</option>
                  </select>
                </div>

                <div class="input-group">
                  <label for="salesRep">Satış Temsilcisi</label>
                  <input type="text" id="salesRep" name="salesRep" value="<%= formData.salesRep || (user.firstName ? `${user.firstName} ${user.lastName}` : user.username) %>" placeholder="Temsilci adı">
                </div>
              </div>

              <div class="form-grid form-grid--2" style="margin-bottom: 1.25rem;">
                <div class="input-group">
                  <label for="shippingAddress">Teslimat Adresi</label>
                  <textarea id="shippingAddress" name="shippingAddress" rows="2" placeholder="Sevkiyat yapılacak detaylı adres..."><%= formData.shippingAddress || '' %></textarea>
                </div>
                <div class="input-group">
                  <label for="billingAddress">Fatura Adresi</label>
                  <textarea id="billingAddress" name="billingAddress" rows="2" placeholder="Fatura kesilecek şirket adresi..."><%= formData.billingAddress || '' %></textarea>
                </div>
              </div>

              <div class="input-group">
                <label for="notes">Sipariş Notları / Özel Talimatlar</label>
                <textarea id="notes" name="notes" rows="3" placeholder="Örn: Sevkiyat haftası teslimat öncesi müşteri aransın. Taşıma ücreti alıcıya aittir."><%= formData.notes || '' %></textarea>
              </div>
            </div>

            <!-- Tab 3 Navigation & Final Submit Button -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem;">
              <button type="button" onclick="goToTab(2)" class="btn btn-secondary" style="padding: 12px 22px; border-radius: 12px;">
                ⬅ 2. Ürün Kalemlerine Dön
              </button>
              <button type="submit" class="btn btn-primary btn-lg" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; font-weight: 700; padding: 14px 36px; border-radius: 12px; box-shadow: 0 6px 25px rgba(16, 185, 129, 0.35); gap: 12px; font-size: 1rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 15 11 17 15 13"/></svg>
                📋 Satış Siparişini Kaydet ve Oluştur
              </button>
            </div>
          </div>

        </form>
      </div>
    </main>
  </div>

  <script>
    // Available stock items catalog passed from backend
    window.stockCatalog = <%- JSON.stringify(stockItems || []) %>;

    let rowCounter = 0;

    function switchTab(tabIndex) {
      for (let i = 1; i <= 3; i++) {
        const pane = document.getElementById(`tabContent${i}`);
        const btn = document.getElementById(`tabBtn${i}`);
        if (pane) pane.style.display = 'none';
        if (btn) btn.classList.remove('active');
      }

      const targetPane = document.getElementById(`tabContent${tabIndex}`);
      const targetBtn = document.getElementById(`tabBtn${tabIndex}`);
      if (targetPane) targetPane.style.display = 'block';
      if (targetBtn) targetBtn.classList.add('active');
    }

    function goToTab(tabIndex) {
      if (tabIndex === 2) {
        const cName = document.getElementById('customerName');
        if (!cName || !cName.value.trim()) {
          alert('⚠️ Lütfen devam etmeden önce Müşteri / Kurum Unvanı alanını doldurunuz.');
          switchTab(1);
          if (cName) cName.focus();
          return;
        }
      }
      if (tabIndex === 3) {
        recalculate();
        const rows = document.querySelectorAll('#itemsTbody tr');
        let validCount = 0;
        rows.forEach(r => {
          const sel = r.querySelector('.item-select');
          if (sel && sel.value && sel.value !== '') validCount++;
        });
        if (validCount === 0) {
          alert('⚠️ Lütfen devam etmeden önce en az 1 adet ürün/mamul kalemi seçiniz.');
          switchTab(2);
          return;
        }
      }
      switchTab(tabIndex);
    }

    function fillCustomerName(sel) {
      const opt = sel.options[sel.selectedIndex];
      if (opt && opt.dataset.name) {
        document.getElementById('customerName').value = opt.dataset.name;
      }
      checkAllCustomerPrices();
    }

    function addNewRow(initialData = null) {
      rowCounter++;
      const tbody = document.getElementById('itemsTbody');
      const tr = document.createElement('tr');
      tr.id = `row-${rowCounter}`;
      tr.style.borderBottom = '1px solid var(--border)';
      tr.style.transition = 'background 0.2s ease';
      tr.onmouseenter = () => tr.style.background = 'rgba(255, 255, 255, 0.02)';
      tr.onmouseleave = () => tr.style.background = 'transparent';

      let optionsHtml = `<option value="" disabled ${!initialData ? 'selected' : ''}>-- Ürün Seçiniz --</option>`;
      window.stockCatalog.forEach(st => {
        const isSel = initialData && initialData.stockItemId == st.id ? 'selected' : '';
        optionsHtml += `<option value="${st.id}" data-price="${st.salePrice}" data-code="${st.stockCode}" ${isSel}>[${st.stockCode}] ${st.name} (Fiyat: ${st.salePrice} ${st.currency})</option>`;
      });

      const qty = initialData ? initialData.quantity : 1;
      const price = initialData ? initialData.unitPrice : 0.00;
      const disc = initialData ? initialData.discountRate : 0.00;
      const tax = initialData ? initialData.taxRate : 20.00;

      tr.innerHTML = `
        <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-muted);" class="row-index">1</td>
        <td style="padding: 12px 14px;">
          <select class="item-select" onchange="onItemSelect(this, ${rowCounter})" style="width: 100%; background: rgba(6, 8, 15, 0.8); border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-size: 0.875rem;">
            ${optionsHtml}
          </select>
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0.01" value="${qty}" class="item-qty" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.8); border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-size: 0.875rem; text-align: center;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0" value="${price}" class="item-price" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.8); border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-size: 0.875rem; text-align: right; font-family: 'JetBrains Mono', monospace;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.1" min="0" max="100" value="${disc}" class="item-disc" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.8); border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-size: 0.875rem; text-align: center;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="1" min="0" max="100" value="${tax}" class="item-tax" oninput="recalculate()" style="width: 100%; background: rgba(6, 8, 15, 0.8); border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; font-size: 0.875rem; text-align: center;">
        </td>
        <td style="padding: 12px 14px; text-align: right; font-weight: 700; color: #10b981; font-family: 'JetBrains Mono', monospace;" class="item-line-total">
          0.00
        </td>
        <td style="padding: 12px 14px; text-align: center;">
          <button type="button" onclick="removeRow(${rowCounter})" style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.25); color: #f43f5e; width: 34px; height: 34px; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s ease;" title="Satırı Sil">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          </button>
        </td>
      `;

      tbody.appendChild(tr);
      const minWarn = document.getElementById('minItemWarningAlert');
      if (minWarn) minWarn.style.display = 'none';
      updateRowIndices();
      recalculate();
    }

    function removeRow(rowId) {
      const tbody = document.getElementById('itemsTbody');
      const rows = tbody.querySelectorAll('tr');
      const minWarn = document.getElementById('minItemWarningAlert');
      if (rows.length <= 1) {
        if (minWarn) minWarn.style.display = 'flex';
        return;
      }
      if (minWarn) minWarn.style.display = 'none';
      const tr = document.getElementById(`row-${rowId}`);
      if (tr) {
        tr.remove();
        updateRowIndices();
        recalculate();
      }
    }

    function updateRowIndices() {
      const rows = document.querySelectorAll('#itemsTbody tr');
      rows.forEach((row, idx) => {
        const indexTd = row.querySelector('.row-index');
        if (indexTd) indexTd.textContent = idx + 1;
      });
      const badge = document.getElementById('itemCountBadge');
      if (badge) badge.textContent = rows.length;
    }

    function onItemSelect(sel, rowId) {
      const opt = sel.options[sel.selectedIndex];
      const row = document.getElementById(`row-${rowId}`);
      if (!row) return;

      if (opt && opt.dataset.price) {
        const priceInput = row.querySelector('.item-price');
        if (priceInput) priceInput.value = parseFloat(opt.dataset.price).toFixed(2);
      }

      const customerId = document.getElementById('customerId').value;
      const stockItemId = sel.value;
      if (customerId && stockItemId) {
        fetch(`/sales/api/customer-price?customerId=${customerId}&stockItemId=${stockItemId}`)
          .then(r => r.json())
          .then(data => {
            if (data.success && data.hasSpecialPrice) {
              const priceInput = row.querySelector('.item-price');
              const discInput = row.querySelector('.item-disc');
              if (priceInput) priceInput.value = parseFloat(data.specialPrice).toFixed(2);
              if (discInput && data.customDiscountRate > 0) discInput.value = parseFloat(data.customDiscountRate).toFixed(2);
              recalculate();
            }
          }).catch(e => console.error(e));
      }

      recalculate();
    }

    function checkAllCustomerPrices() {
      const customerId = document.getElementById('customerId').value;
      if (!customerId) return;

      const rows = document.querySelectorAll('#itemsTbody tr');
      rows.forEach(row => {
        const sel = row.querySelector('.item-select');
        if (sel && sel.value) {
          onItemSelect(sel, parseInt(row.id.replace('row-', ''), 10));
        }
      });
    }

    function recalculate() {
      const rows = document.querySelectorAll('#itemsTbody tr');
      const currency = document.getElementById('currency').value || 'TRY';
      const symbol = currency === 'USD' ? '$' : (currency === 'EUR' ? '€' : '₺');

      let grandSubtotal = 0;
      let grandDiscount = 0;
      let grandTax = 0;
      let grandTotal = 0;
      let maxDiscRate = 0;

      const itemsPayload = [];

      rows.forEach(row => {
        const sel = row.querySelector('.item-select');
        const qtyInput = row.querySelector('.item-qty');
        const priceInput = row.querySelector('.item-price');
        const discInput = row.querySelector('.item-disc');
        const taxInput = row.querySelector('.item-tax');
        const lineTotalTd = row.querySelector('.item-line-total');

        const stockItemId = sel ? sel.value : '';
        const opt = sel && sel.selectedIndex >= 0 ? sel.options[sel.selectedIndex] : null;
        const stockCode = opt && opt.dataset.code ? opt.dataset.code : '';
        const name = opt ? opt.text.split('] ')[1] || opt.text : '';

        const qty = parseFloat(qtyInput ? qtyInput.value : 0) || 0;
        const price = parseFloat(priceInput ? priceInput.value : 0) || 0;
        const discRate = parseFloat(discInput ? discInput.value : 0) || 0;
        const taxRate = parseFloat(taxInput ? taxInput.value : 0) || 0;

        const sub = qty * price;
        const discAmt = sub * (discRate / 100);
        const afterDisc = sub - discAmt;
        const taxAmt = afterDisc * (taxRate / 100);
        const tot = afterDisc + taxAmt;

        grandSubtotal += sub;
        grandDiscount += discAmt;
        grandTax += taxAmt;
        grandTotal += tot;

        if (discRate > maxDiscRate) maxDiscRate = discRate;

        if (lineTotalTd) {
          lineTotalTd.textContent = tot.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;
        }

        const parsedStockId = parseInt(stockItemId, 10);
        if (!isNaN(parsedStockId) && parsedStockId > 0) {
          itemsPayload.push({
            stockItemId: parsedStockId,
            stockCode,
            name,
            quantity: qty,
            unitPrice: price,
            discountRate: discRate,
            taxRate: taxRate,
            subtotal: sub,
            discountAmount: discAmt,
            taxAmount: taxAmt,
            totalAmount: tot
          });
        }
      });

      document.getElementById('itemsJsonInput').value = JSON.stringify(itemsPayload);

      document.getElementById('displaySubtotal').textContent = grandSubtotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;
      document.getElementById('displayDiscount').textContent = '- ' + grandDiscount.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;
      document.getElementById('displayTax').textContent = '+ ' + grandTax.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;
      document.getElementById('displayTotal').textContent = grandTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ' + symbol;

      const warningAlert = document.getElementById('approvalWarningAlert');
      if (warningAlert) {
        if (maxDiscRate > 20 || grandTotal > 100000) {
          warningAlert.style.display = 'flex';
        } else {
          warningAlert.style.display = 'none';
        }
      }
    }

    addNewRow();

    const oForm = document.getElementById('orderForm');
    if (oForm) {
      oForm.addEventListener('submit', function(e) {
        recalculate();

        const cName = document.getElementById('customerName');
        if (!cName || !cName.value.trim()) {
          e.preventDefault();
          alert('⚠️ Lütfen Müşteri / Kurum Unvanı alanını doldurunuz.');
          switchTab(1);
          if (cName) cName.focus();
          return false;
        }

        const rows = document.querySelectorAll('#itemsTbody tr');
        let validItemsCount = 0;
        rows.forEach(row => {
          const sel = row.querySelector('.item-select');
          if (sel && sel.value && sel.value !== '') {
            validItemsCount++;
          }
        });

        if (validItemsCount === 0) {
          e.preventDefault();
          alert('⚠️ Lütfen siparişe en az 1 adet geçerli ürün kalemi seçiniz.');
          switchTab(2);
          return false;
        }
      });
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
