<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sipariş Detayı (<%= order ? order.orderNo : '' %>) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .order-card { 
      background: rgba(15, 23, 42, 0.6); 
      border: 1px solid var(--border); 
      border-radius: 20px; 
      padding: 32px; 
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3); 
      margin-bottom: 24px; 
      backdrop-filter: blur(16px);
    }
    .order-header { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      border-bottom: 1px solid var(--border); 
      padding-bottom: 20px; 
      margin-bottom: 24px; 
    }
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 28px; }
    .info-tile { 
      background: rgba(255, 255, 255, 0.03); 
      padding: 20px; 
      border-radius: 14px; 
      border: 1px solid var(--border); 
    }
    .info-tile span { font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 6px; letter-spacing: 0.08em; }
    .info-tile strong { font-size: 1.15rem; color: #fff; font-weight: 800; }
    .table-dark-custom { width: 100%; border-collapse: collapse; margin-bottom: 24px; font-size: 0.9rem; }
    .table-dark-custom th { background: rgba(19, 26, 43, 0.9); color: var(--text-secondary); font-weight: 700; text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; }
    .table-dark-custom td { padding: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: var(--text-primary); }
  </style>
</head>
<body class="module-body">

  <!-- Sidebar -->
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/orders" class="mss-sub-link active">📋 Satış Siparişleri Listesi</a>
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/customers" class="mss-sub-link">👥 Cari & Müşteri Kartları</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Faturalandırma</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/sales/orders" class="btn btn-outline-secondary btn-sm" style="display: flex; align-items: center; gap: 6px; border-radius: 8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Sipariş Listesine Dön
        </a>
      </div>
      <div class="mt-right" style="display: flex; gap: 10px;">
        <% if (order && (order.status === 'Approved' || order.status === 'Preparing' || order.status === 'Hazırlanıyor')) { %>
          <a href="/sales/dispatches" class="btn btn-primary btn-sm">🚚 Sevkiyat / İrsaliye Kes</a>
        <% } %>
        <% if (order && order.status === 'Completed') { %>
          <form action="/sales/invoices/create-from-order/<%= order.id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-success btn-sm">🧾 Fatura Oluştur</button>
          </form>
        <% } %>
      </div>
    </header>

    <main class="module-content">
      <% if (!order) { %>
        <div class="error">Sipariş bulunamadı.</div>
      <% } else { 
        let itemsList = [];
        if (order.itemsJson) {
          try { itemsList = JSON.parse(order.itemsJson); } catch (e) { itemsList = []; }
        }
        if (!Array.isArray(itemsList) || itemsList.length === 0) {
          itemsList = [{
            stockCode: order.stockItem ? order.stockItem.stockCode : '-',
            name: order.stockItem ? order.stockItem.name : 'Ürün Kalemi',
            quantity: order.quantity,
            unitPrice: order.unitPrice,
            discountRate: order.discountRate,
            taxRate: order.taxRate,
            subtotal: order.subtotal,
            discountAmount: order.discountAmount,
            taxAmount: order.taxAmount,
            totalAmount: order.totalAmount
          }];
        }
      %>
        <div class="order-card">
          <div class="order-header">
            <div>
              <h2 style="margin: 0; font-size: 1.6rem; color: #fff; font-weight: 800; display: flex; align-items: center; gap: 12px;">
                Sipariş No: <span style="color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= order.orderNo %></span>
              </h2>
              <p style="color: var(--text-muted); font-size: 0.9rem; margin: 8px 0 0 0;">
                Sipariş Tarihi: <strong><%= order.orderDate %></strong> | Satış Temsilcisi: <strong><%= order.salesRep || 'Sistem' %></strong>
              </p>
            </div>
            <div>
              <% if (order.status === 'Preparing' || order.status === 'Hazırlanıyor') { %>
                <span style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); font-size: 0.9rem; padding: 8px 18px; border-radius: 20px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                  ● Hazırlanıyor
                </span>
              <% } else if (order.status === 'Pending_Approval') { %>
                <span style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); font-size: 0.9rem; padding: 8px 18px; border-radius: 20px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                  ⚡ Yönetsel Onay Bekliyor
                </span>
              <% } else if (order.status === 'Approved') { %>
                <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.9rem; padding: 8px 18px; border-radius: 20px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                  ✓ Onaylandı
                </span>
              <% } else { %>
                <span style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-size: 0.9rem; padding: 8px 18px; border-radius: 20px; font-weight: 700;">
                  ● <%= order.status %>
                </span>
              <% } %>
            </div>
          </div>

          <!-- Quick Info Grid -->
          <div class="grid-4">
            <div class="info-tile">
              <span>Cari Müşteri Unvanı</span>
              <strong><%= order.customerName %></strong>
              <% if (order.customerTaxNo) { %>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">VN: <%= order.customerTaxNo %></div>
              <% } %>
            </div>
            <div class="info-tile">
              <span>Ödeme Vadesi / Şekli</span>
              <strong><%= order.paymentTerm === 'Pesin' ? 'Peşin Ödeme' : order.paymentTerm === 'Vadeli_30' ? '30 Gün Vadeli' : order.paymentTerm === 'Vadeli_60' ? '60 Gün Vadeli' : order.paymentTerm === 'Vadeli_90' ? '90 Gün Vadeli' : 'Kredi Kartı' %></strong>
            </div>
            <div class="info-tile" style="background: rgba(16, 185, 129, 0.05); border-color: rgba(16, 185, 129, 0.2);">
              <span style="color: #34d399;">Genel Sipariş Tutarı</span>
              <strong style="color: #10b981; font-family: 'JetBrains Mono', monospace;"><%= Number(order.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></strong>
            </div>
            <div class="info-tile" style="background: rgba(244, 63, 94, 0.05); border-color: rgba(244, 63, 94, 0.2);">
              <span style="color: #f43f5e;">Toplam İskonto Tutarı</span>
              <strong style="color: #fb7185; font-family: 'JetBrains Mono', monospace;">- <%= Number(order.discountAmount || 0).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></strong>
            </div>
          </div>

          <!-- Multi-Item Products Table -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 style="font-size: 1.1rem; font-weight: 800; margin: 0; color: #fff; display: flex; align-items: center; gap: 8px;">
              <span>📦</span> Sipariş Edilen Ürün Kalemleri (<%= itemsList.length %> Kalem)
            </h3>
          </div>

          <div style="overflow-x: auto; border-radius: 14px; border: 1px solid var(--border); background: rgba(6, 8, 15, 0.8); margin-bottom: 2rem;">
            <table class="table-dark-custom" style="margin-bottom: 0;">
              <thead>
                <tr>
                  <th style="width: 40px; text-align: center;">#</th>
                  <th>Ürün / Mamul Kalemi</th>
                  <th style="width: 110px;">Miktar</th>
                  <th style="width: 140px;">Birim Fiyat</th>
                  <th style="width: 140px;">Satır İskontosu</th>
                  <th style="width: 100px;">KDV (%)</th>
                  <th style="text-align: right; width: 160px;">Satır Toplamı</th>
                </tr>
              </thead>
              <tbody>
                <% itemsList.forEach((it, idx) => { 
                  const q = parseFloat(it.quantity) || 1;
                  const p = parseFloat(it.unitPrice) || 0;
                  const d = parseFloat(it.discountRate) || 0;
                  const t = parseFloat(it.taxRate) || 20;
                  const sub = q * p;
                  const discAmt = sub * (d / 100);
                  const tot = parseFloat(it.totalAmount) || (sub - discAmt) * (1 + t / 100);
                %>
                  <tr style="border-bottom: 1px solid var(--border);">
                    <td style="text-align: center; font-weight: 700; color: var(--text-muted);"><%= idx + 1 %></td>
                    <td>
                      <strong style="font-size: 0.95rem; color: #fff;"><%= it.name %></strong>
                      <% if (it.stockCode) { %>
                        <div style="color: var(--text-muted); font-size: 0.8rem; font-family: 'JetBrains Mono', monospace; margin-top: 2px;">Kod: <%= it.stockCode %></div>
                      <% } %>
                    </td>
                    <td>
                      <strong style="font-size: 1rem; font-family: 'JetBrains Mono', monospace;"><%= q.toLocaleString('tr-TR') %></strong> Adet
                    </td>
                    <td style="font-family: 'JetBrains Mono', monospace;">
                      <%= p.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %>
                    </td>
                    <td>
                      <% if (d > 0) { %>
                        <span style="color: #fb7185; font-weight: 700; font-family: 'JetBrains Mono', monospace; background: rgba(244, 63, 94, 0.1); padding: 4px 8px; border-radius: 6px;">
                          %<%= d %> (-<%= discAmt.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %>)
                        </span>
                      <% } else { %>
                        <span style="color: var(--text-muted); font-size: 0.85rem;">%0 (İskontosuz)</span>
                      <% } %>
                    </td>
                    <td style="font-family: 'JetBrains Mono', monospace;">%<%= t %></td>
                    <td style="text-align: right; font-weight: 800; color: #10b981; font-family: 'JetBrains Mono', monospace; font-size: 1rem;">
                      <%= tot.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Bottom Financial Breakdown Cards -->
          <div style="background: linear-gradient(135deg, rgba(19, 26, 43, 0.8) 0%, rgba(12, 17, 28, 0.9) 100%); border-radius: 16px; border: 1px solid var(--border); padding: 1.5rem; margin-bottom: 2rem;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; text-align: center;">
              <div style="background: rgba(255, 255, 255, 0.03); padding: 16px; border-radius: 12px; border: 1px solid var(--border);">
                <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Ara Toplam (Brüt)</span>
                <strong style="font-size: 1.25rem; color: #fff; font-family: 'JetBrains Mono', monospace;"><%= Number(order.subtotal || 0).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></strong>
              </div>
              
              <div style="background: rgba(244, 63, 94, 0.05); padding: 16px; border-radius: 12px; border: 1px solid rgba(244, 63, 94, 0.15);">
                <span style="font-size: 0.75rem; font-weight: 600; color: #f43f5e; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Toplam Sipariş İskontosu</span>
                <strong style="font-size: 1.25rem; color: #fb7185; font-family: 'JetBrains Mono', monospace;">- <%= Number(order.discountAmount || 0).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></strong>
              </div>

              <div style="background: rgba(99, 102, 241, 0.05); padding: 16px; border-radius: 12px; border: 1px solid rgba(99, 102, 241, 0.15);">
                <span style="font-size: 0.75rem; font-weight: 600; color: #818cf8; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Toplam KDV Tutarı</span>
                <strong style="font-size: 1.25rem; color: #a5b4fc; font-family: 'JetBrains Mono', monospace;">+ <%= Number(order.taxAmount || 0).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></strong>
              </div>

              <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(6, 182, 212, 0.1) 100%); padding: 16px; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.3); box-shadow: 0 0 25px rgba(16, 185, 129, 0.1);">
                <span style="font-size: 0.75rem; font-weight: 700; color: #34d399; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">GENEL SİPARİŞ TOPLAMI</span>
                <strong style="font-size: 1.45rem; color: #10b981; font-family: 'JetBrains Mono', monospace; text-shadow: 0 0 10px rgba(16, 185, 129, 0.3);"><%= Number(order.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></strong>
              </div>
            </div>
          </div>

          <!-- Connected Operations Grid -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div style="background: rgba(15, 23, 42, 0.4); padding: 20px; border-radius: 14px; border: 1px solid var(--border);">
              <h4 style="font-size: 1rem; font-weight: 800; color: #fff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span>🚚</span> Bağlı Sevkiyat / İrsaliyeler
              </h4>
              <% if (dispatches.length === 0) { %>
                <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Henüz sevk irsaliyesi oluşturulmamış.</p>
              <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <% dispatches.forEach(d => { %>
                    <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(6, 8, 15, 0.8); padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border);">
                      <div>
                        <strong style="color: #fff;"><%= d.dispatchNo %></strong> — <span style="color: var(--text-muted); font-size: 0.85rem;"><%= d.dispatchDate %></span>
                        <br><small style="color: var(--text-muted);">Taşıyıcı: <%= d.carrierCompany || 'Kendi Aracımız' %> (<%= d.vehiclePlate || '-' %>)</small>
                      </div>
                      <a href="/sales/dispatches/<%= d.id %>" class="btn btn-sm btn-outline-info">İrsaliye Gör</a>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div style="background: rgba(15, 23, 42, 0.4); padding: 20px; border-radius: 14px; border: 1px solid var(--border);">
              <h4 style="font-size: 1rem; font-weight: 800; color: #fff; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span>🧾</span> Bağlı Fatura İşlemleri
              </h4>
              <% if (invoices.length === 0) { %>
                <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Henüz faturalandırılmamış.</p>
              <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <% invoices.forEach(inv => { %>
                    <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(6, 8, 15, 0.8); padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border);">
                      <div>
                        <strong style="color: #fff;"><%= inv.invoiceNo %></strong> — <span style="color: var(--text-muted); font-size: 0.85rem;"><%= inv.invoiceDate %></span>
                        <br><small style="color: var(--text-muted);">Tutar: <%= Number(inv.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</small>
                      </div>
                      <a href="/sales/invoices/<%= inv.id %>" class="btn btn-sm btn-outline-success">Fatura Gör</a>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
