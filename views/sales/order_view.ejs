<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sipariş Detayı (<%= order ? order.orderNo : '' %>) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .order-card { 
      background: var(--bg-surface); 
      border: 1px solid var(--border); 
      border-radius: 16px; 
      padding: 32px; 
      box-shadow: var(--shadow-md); 
      margin-bottom: 24px; 
    }
    .order-header { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      border-bottom: 1px solid var(--border); 
      padding-bottom: 20px; 
      margin-bottom: 24px; 
    }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 28px; }
    .info-tile { 
      background: var(--bg-elevated); 
      padding: 18px; 
      border-radius: 12px; 
      border: 1px solid var(--border); 
    }
    .info-tile span { font-size: 0.8rem; color: var(--text-secondary); font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 6px; letter-spacing: 0.05em; }
    .info-tile strong { font-size: 1.15rem; color: var(--text-primary); font-weight: 800; }
    .table-dark-custom { width: 100%; border-collapse: collapse; margin-bottom: 28px; }
    .table-dark-custom th { background: var(--bg-elevated); color: var(--text-secondary); font-weight: 700; text-align: left; padding: 14px 16px; border-bottom: 2px solid var(--border); font-size: 0.85rem; text-transform: uppercase; }
    .table-dark-custom td { padding: 16px; border-bottom: 1px solid var(--border); font-size: 0.95rem; color: var(--text-primary); }
  </style>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">SATIŞ YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/orders" class="mss-sub-link active">📋 Satış Siparişleri Listesi</a>
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/customers" class="mss-sub-link">👥 Cari & Müşteri Kartları</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Faturalandırma</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/sales/orders" class="btn btn-outline-secondary btn-sm">← Sipariş Listesine Dön</a>
      </div>
      <div class="mt-right" style="display: flex; gap: 10px;">
        <% if (order && order.status === 'Approved') { %>
          <a href="/sales/dispatches" class="btn btn-primary btn-sm">🚚 Sevkiyat / İrsaliye Kes</a>
        <% } %>
        <% if (order && order.status === 'Completed') { %>
          <form action="/sales/invoices/create-from-order/<%= order.id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-success btn-sm">🧾 Fatura Oluştur</button>
          </form>
        <% } %>
      </div>
    </header>

    <main class="module-content">
      <% if (!order) { %>
        <div class="alert alert-danger">Sipariş bulunamadı.</div>
      <% } else { %>
        <div class="order-card">
          <div class="order-header">
            <div>
              <h2 style="margin: 0; font-size: 1.6rem; color: var(--text-primary); font-weight: 800;">
                Sipariş Kodu: <span style="color: var(--indigo); font-family: 'JetBrains Mono', monospace;"><%= order.orderNo %></span>
              </h2>
              <p style="color: var(--text-secondary); font-size: 0.9rem; margin: 6px 0 0 0;">Tarih: <%= order.orderDate %> | Satış Temsilcisi: <strong><%= order.salesRep %></strong></p>
            </div>
            <div>
              <span class="badge bg-primary" style="font-size: 0.95rem; padding: 8px 18px; font-weight: 700;"><%= order.status %></span>
            </div>
          </div>

          <div class="grid-4">
            <div class="info-tile">
              <span>Müşteri Unvanı</span>
              <strong><%= order.customerName %></strong>
            </div>
            <div class="info-tile">
              <span>Ödeme Vadesi</span>
              <strong><%= order.paymentTerm %></strong>
            </div>
            <div class="info-tile">
              <span>Toplam Sipariş Tutarı</span>
              <strong style="color: var(--emerald);"><%= Number(order.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></strong>
            </div>
            <div class="info-tile">
              <span>Karşılama Durumu</span>
              <strong style="color: var(--cyan);"><%= order.fulfillmentStatus || 'Açık Sipariş' %></strong>
            </div>
          </div>

          <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 16px; color: var(--text-primary);">Ürün & Miktar Kalemleri</h3>
          <table class="table-dark-custom">
            <thead>
              <tr>
                <th>Stok Kartı</th>
                <th>Miktar</th>
                <th>Birim Fiyat</th>
                <th>İskonto (%)</th>
                <th>KDV (%)</th>
                <th class="text-end">Toplam Tutar</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <strong style="font-size: 1rem; color: var(--text-primary);"><%= order.stockItem ? order.stockItem.name : 'Ürün' %></strong><br>
                  <span style="color: var(--text-secondary); font-size: 0.85rem; font-family: 'JetBrains Mono', monospace;"><%= order.stockItem ? order.stockItem.stockCode : '' %></span>
                </td>
                <td><strong style="font-size: 1.05rem;"><%= order.quantity %></strong> <%= order.stockItem ? order.stockItem.unit : 'Adet' %></td>
                <td><%= Number(order.unitPrice).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></td>
                <td><strong style="color: var(--rose);">%<%= order.discountRate %></strong></td>
                <td>%<%= order.taxRate %></td>
                <td class="text-end" style="font-size: 1.1rem; font-weight: 800; color: var(--indigo);"><%= Number(order.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= order.currency %></td>
              </tr>
            </tbody>
          </table>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div style="background: var(--bg-elevated); padding: 20px; border-radius: 12px; border: 1px solid var(--border);">
              <h4 style="font-size: 1rem; font-weight: 800; color: var(--text-primary); margin-bottom: 12px;">🚚 Bağlı Sevkiyat / İrsaliyeler</h4>
              <% if (dispatches.length === 0) { %>
                <p style="color: var(--text-secondary); font-size: 0.9rem;">Henüz sevk irsaliyesi oluşturulmamış.</p>
              <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <% dispatches.forEach(d => { %>
                    <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-surface); padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border);">
                      <div>
                        <strong style="color: var(--text-primary);"><%= d.dispatchNo %></strong> — <span style="color: var(--text-secondary); font-size: 0.85rem;"><%= d.dispatchDate %></span>
                        <br><small style="color: var(--text-muted);">Taşıyıcı: <%= d.carrierCompany || 'Kendi Aracımız' %> (<%= d.vehiclePlate || '-' %>)</small>
                      </div>
                      <a href="/sales/dispatches/<%= d.id %>" class="btn btn-sm btn-outline-info">İrsaliye Gör</a>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div style="background: var(--bg-elevated); padding: 20px; border-radius: 12px; border: 1px solid var(--border);">
              <h4 style="font-size: 1rem; font-weight: 800; color: var(--text-primary); margin-bottom: 12px;">🧾 Bağlı Fatura İşlemleri</h4>
              <% if (invoices.length === 0) { %>
                <p style="color: var(--text-secondary); font-size: 0.9rem;">Henüz faturalandırılmamış.</p>
              <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  <% invoices.forEach(inv => { %>
                    <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-surface); padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border);">
                      <div>
                        <strong style="color: var(--text-primary);"><%= inv.invoiceNo %></strong> — <span style="color: var(--text-secondary); font-size: 0.85rem;"><%= inv.invoiceDate %></span>
                        <br><small style="color: var(--text-muted);">Tutar: <%= Number(inv.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> TL</small>
                      </div>
                      <a href="/sales/invoices/<%= inv.id %>" class="btn btn-sm btn-outline-success">Fatura Gör</a>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
