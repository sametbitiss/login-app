<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Satış Teklifi <%= quote ? (quote.teklifNo || quote.quotationNo) : '' %> — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    @media print {
      body { background: #fff !important; color: #000 !important; font-size: 11pt !important; }
      .module-sidebar, .module-topbar, .no-print { display: none !important; }
      .module-main { margin-left: 0 !important; width: 100% !important; padding: 0 !important; background: transparent !important; }
      .pdf-paper { border: none !important; box-shadow: none !important; padding: 0 !important; margin: 0 !important; width: 100% !important; max-width: 100% !important; background: #fff !important; }
      .pdf-table th { background: #f1f5f9 !important; color: #0f172a !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }

    .pdf-paper {
      background: #ffffff;
      color: #0f172a;
      border: 1px solid #cbd5e1;
      border-radius: 16px;
      padding: 44px 48px;
      box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.4);
      max-width: 900px;
      margin: 1.5rem auto 3rem auto;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .pdf-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #0f172a;
      padding-bottom: 24px;
      margin-bottom: 24px;
    }

    .company-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 6px;
    }

    .company-title {
      font-size: 1.4rem;
      font-weight: 900;
      color: #0f172a;
      letter-spacing: -0.02em;
      margin: 0;
    }

    .company-details {
      font-size: 0.8rem;
      color: #475569;
      line-height: 1.5;
      font-weight: 600;
    }

    .pdf-doc-info {
      text-align: right;
    }

    .pdf-doc-badge {
      display: inline-block;
      background: #0f172a;
      color: #fff;
      font-size: 1.2rem;
      font-weight: 900;
      padding: 6px 18px;
      border-radius: 8px;
      letter-spacing: 1px;
      margin-bottom: 12px;
    }

    .info-table {
      font-size: 0.85rem;
      margin-left: auto;
    }

    .info-table td {
      padding: 3px 0;
      text-align: right;
    }

    .info-table td.lbl {
      color: #64748b;
      font-weight: 600;
      padding-right: 10px;
    }

    .info-table td.val {
      font-weight: 700;
      color: #0f172a;
    }

    .pdf-section-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .pdf-card-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 18px;
    }

    .pdf-card-title {
      font-size: 0.775rem;
      font-weight: 800;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 10px;
      border-bottom: 1px solid #cbd5e1;
      padding-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .pdf-card-body {
      font-size: 0.85rem;
      color: #1e293b;
      line-height: 1.6;
    }

    .pdf-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 24px;
    }

    .pdf-table th {
      background: #0f172a;
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      padding: 10px 12px;
      text-align: left;
      border: 1px solid #0f172a;
    }

    .pdf-table td {
      padding: 11px 12px;
      border-bottom: 1px solid #e2e8f0;
      border-left: 1px solid #e2e8f0;
      border-right: 1px solid #e2e8f0;
      font-size: 0.85rem;
      color: #0f172a;
    }

    .totals-container {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 28px;
      gap: 20px;
    }

    .notes-box {
      flex: 1;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 16px 20px;
      font-size: 0.825rem;
    }

    .totals-box {
      width: 320px;
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 16px 20px;
    }

    .tot-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      font-size: 0.85rem;
      color: #475569;
      border-bottom: 1px solid #e2e8f0;
      font-weight: 600;
    }

    .tot-row strong {
      color: #0f172a;
      font-family: 'JetBrains Mono', monospace;
    }

    .tot-row.grand {
      border-top: 2px solid #0f172a;
      border-bottom: none;
      padding-top: 12px;
      margin-top: 6px;
      font-size: 1.1rem;
      font-weight: 900;
      color: #0f172a;
    }

    .signature-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-top: 35px;
      padding-top: 24px;
      border-top: 1px dashed #cbd5e1;
    }

    .sig-box {
      text-align: center;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px;
      background: #fff;
    }

    .sig-title {
      font-size: 0.8rem;
      font-weight: 800;
      color: #475569;
      text-transform: uppercase;
      margin-bottom: 45px;
    }

    .sig-line {
      border-top: 1px solid #94a3b8;
      width: 70%;
      margin: 0 auto 6px auto;
    }

    .sig-sub {
      font-size: 0.75rem;
      color: #64748b;
      font-weight: 600;
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <aside class="module-sidebar no-print">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link active">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/quotes/add" class="mss-sub-link">➕ Yeni Teklif Oluştur</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar no-print">
      <div class="mt-left">
        <a href="/sales/quotes" class="btn btn-outline-secondary btn-sm" style="font-weight: 600; border-radius: 8px;">
          ← Teklif Listesine Dön
        </a>
      </div>
      <div class="mt-right" style="display: flex; gap: 10px;">
        <button onclick="window.print()" class="btn btn-primary btn-sm" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none; font-weight: 700; border-radius: 8px; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
          🖨️ Teklifi Yazdır / PDF İndir
        </button>
        <% if (quote && (quote.durum === 'Approved' || quote.status === 'Approved' || quote.durum === 'Active' || quote.durum === 'Draft')) { %>
          <form action="/sales/quotes/<%= quote.id %>/convert" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-warning btn-sm" style="font-weight: 700; border-radius: 8px;">
              🛍️ Siparişe Dönüştür
            </button>
          </form>
        <% } %>
      </div>
    </header>

    <main class="module-content">
      <% if (!quote) { %>
        <div style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); color: #f43f5e; padding: 1.5rem; border-radius: 12px; font-weight: 700; text-align: center;">
          ⚠️ Teklif kaydı bulunamadı veya silinmiş.
        </div>
      <% } else { 
        const qNo = quote.teklifNo || quote.quotationNo || '—';
        const cName = quote.musteriAdi || quote.customerName || (quote.musteri ? (quote.musteri.firmaAdi || quote.musteri.companyName) : '—');
        const cCode = quote.musteri ? (quote.musteri.musteriKodu || quote.musteri.customerCode || '—') : '—';
        const cTaxNo = quote.musteri ? (quote.musteri.vergiNo || quote.musteri.taxNo || '') : '';
        const cTaxOffice = quote.musteri ? (quote.musteri.vergiDairesi || quote.musteri.taxOffice || '') : '';

        const contactPerson = quote.ilgiliKisi || quote.contactPerson || (quote.musteri ? (quote.musteri.ilgiliKisi || quote.musteri.contactPerson) : '') || '—';
        const contactInfo = quote.iletisimBilgisi || quote.contactInfo || (quote.musteri ? `${quote.musteri.telefon || quote.musteri.phone || ''} ${quote.musteri.eposta || quote.musteri.email || ''}`.trim() : '') || '—';
        const billingAddr = quote.faturaAdresi || quote.billingAddress || (quote.musteri ? (quote.musteri.adres || quote.musteri.address) : '') || '—';
        const shippingAddr = quote.sevkAdresi || quote.shippingAddress || (quote.musteri ? (quote.musteri.adres || quote.musteri.address) : '') || '—';

        const qDate = quote.teklifTarihi || quote.quotationDate || '—';
        const vUntil = quote.gecerlilikBitis || quote.validUntil || '—';
        const reqDelivery = quote.istenenTerminTarihi || quote.requestedDeliveryDate || '—';

        const paymentTerm = quote.paymentTerm || quote.odemeVadesi || '—';
        const deliveryTerm = quote.deliveryTerm || quote.teslimatSuresi || '—';
        const delTerms = quote.teslimatSekli || quote.deliveryTerms || '—';
        const quoteNotes = quote.notes || quote.notlar || '—';

        const mainCurrency = quote.paraBirimi || quote.currency || 'TRY';
        const mainCurrSign = mainCurrency === 'USD' ? '$' : (mainCurrency === 'EUR' ? '€' : '₺');

        let itemsList = [];
        const rawJson = quote.kalemlerJson || quote.itemsJson;
        if (rawJson) {
          try {
            const parsed = typeof rawJson === 'string' ? JSON.parse(rawJson) : rawJson;
            if (Array.isArray(parsed)) {
              itemsList = parsed.filter(it => it && (it.ad || it.name || it.stokId || it.stockItemId));
            }
          } catch (e) { itemsList = []; }
        }
        if (!Array.isArray(itemsList) || itemsList.length === 0) {
          const sObj = quote.stokKarti || quote.stockItem;
          itemsList = [{
            stockCode: sObj ? (sObj.stokKodu || sObj.stockCode || '-') : '-',
            stokKodu: sObj ? (sObj.stokKodu || sObj.stockCode || '-') : '-',
            name: sObj ? (sObj.ad || sObj.name || 'Ürün Kalemi') : 'Ürün Kalemi',
            ad: sObj ? (sObj.ad || sObj.name || 'Ürün Kalemi') : 'Ürün Kalemi',
            birim: sObj ? (sObj.birim || 'Adet') : 'Adet',
            unit: sObj ? (sObj.birim || 'Adet') : 'Adet',
            quantity: quote.miktar || quote.quantity || 1,
            unitPrice: quote.birimFiyat || quote.unitPrice || 0,
            discountRate: quote.iskontoOrani || quote.discountRate || 0,
            taxRate: quote.kdvOrani || quote.taxRate || 20,
            totalAmount: quote.toplamTutar || quote.totalAmount || 0
          }];
        }

        const subtotal = parseFloat(quote.araToplam !== undefined ? quote.araToplam : (quote.subtotal !== undefined ? quote.subtotal : 0)) || 0;
        const discountAmount = parseFloat(quote.iskontoTutari !== undefined ? quote.iskontoTutari : (quote.discountAmount !== undefined ? quote.discountAmount : 0)) || 0;
        const taxAmount = parseFloat(quote.kdvTutari !== undefined ? quote.kdvTutari : (quote.taxAmount !== undefined ? quote.taxAmount : 0)) || 0;
        const totalAmount = parseFloat(quote.toplamTutar !== undefined ? quote.toplamTutar : (quote.totalAmount !== undefined ? quote.totalAmount : 0)) || 0;

        const statusStr = quote.durum || quote.status || 'Draft';
        let statusBadge = `<span style="background: #3b82f6; color: #fff; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 0.775rem;">Aktif Teklif</span>`;
        if (statusStr === 'Converted' || statusStr === 'Siparişe Dönüştü') {
          statusBadge = `<span style="background: #10b981; color: #fff; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 0.775rem;">✓ Siparişe Dönüştü</span>`;
        } else if (statusStr === 'Pending_Approval' || statusStr === 'Onay Bekliyor') {
          statusBadge = `<span style="background: #f59e0b; color: #fff; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 0.775rem;">⏳ Yönetsel Onay Bekliyor</span>`;
        } else if (statusStr === 'Rejected' || statusStr === 'Reddedildi') {
          statusBadge = `<span style="background: #ef4444; color: #fff; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 0.775rem;">✕ Reddedildi</span>`;
        }

        const creatorName = quote.olusturan ? (quote.olusturan.ad ? `${quote.olusturan.ad} ${quote.olusturan.soyad}` : quote.olusturan.kullaniciAdi) : (user ? (user.firstName ? `${user.firstName} ${user.lastName}` : user.username) : 'Satış Temsilcisi');
        const cProf = (typeof companyProfile !== 'undefined' && companyProfile) ? companyProfile : {};
        const compTitle = cProf.unvan || cProf.markaAdi || 'ENTERPRISE ERP';
      %>
        <!-- A4 OFFICIAL PDF OFFER SHEET -->
        <div class="pdf-paper">
          
          <!-- PDF Header -->
          <div class="pdf-header">
            <div>
              <div class="company-brand">
                <svg width="34" height="34" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="#0f172a"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/></svg>
                <h1 class="company-title"><%= compTitle %></h1>
              </div>
              <div class="company-details">
                <% if (cProf.adres) { %><div><%= cProf.adres %></div><% } %>
                <% if (cProf.telefon || cProf.eposta) { %><div>Tel: <%= cProf.telefon || '—' %> | E-Posta: <%= cProf.eposta || '—' %> <%= cProf.webSitesi ? `| Web: ${cProf.webSitesi}` : '' %></div><% } %>
                <% if (cProf.vergiDairesi || cProf.vergiNo || cProf.mersisNo) { %><div>Vergi Dairesi/No: <%= cProf.vergiDairesi || '—' %> <%= cProf.vergiNo ? `V.N: ${cProf.vergiNo}` : '' %> <%= cProf.mersisNo ? `| Mersis No: ${cProf.mersisNo}` : '' %></div><% } %>
                <% if (!cProf.adres && !cProf.telefon && !cProf.eposta && !cProf.vergiNo) { %>
                  Satış & Pazarlama Departmanı | Kurumsal Satış Teklif Belgesi
                <% } %>
              </div>
            </div>

            <div class="pdf-doc-info">
              <div class="pdf-doc-badge">SATIŞ TEKLİFİ</div>
              <table class="info-table">
                <tr><td class="lbl">Teklif No:</td><td class="val" style="font-family: 'JetBrains Mono', monospace; color: #4338ca;"><%= qNo %></td></tr>
                <tr><td class="lbl">Teklif Tarihi:</td><td class="val"><%= qDate %></td></tr>
                <tr><td class="lbl">Geçerlilik Sonu:</td><td class="val"><%= vUntil %></td></tr>
                <tr><td class="lbl">İstenen Termin:</td><td class="val"><%= reqDelivery %></td></tr>
                <tr><td class="lbl">Teklif Statüsü:</td><td class="val" style="padding-top: 4px;"><%- statusBadge %></td></tr>
              </table>
            </div>
          </div>

          <!-- Section Grid: Customer & Delivery Addresses -->
          <div class="pdf-section-grid">
            <div class="pdf-card-box">
              <div class="pdf-card-title">
                🏢 Cari Müşteri & İletişim Bilgileri
              </div>
              <div class="pdf-card-body">
                <strong style="font-size: 1rem; color: #0f172a; display: block; margin-bottom: 4px;"><%= cName %></strong>
                <div><strong>Müşteri Kodu:</strong> <span style="font-family: 'JetBrains Mono', monospace; color: #4338ca;"><%= cCode %></span></div>
                <% if (cTaxOffice || cTaxNo) { %>
                  <div><strong>Vergi Dairesi / No:</strong> <%= cTaxOffice || '—' %> / <%= cTaxNo || '—' %></div>
                <% } %>
                <div><strong>İlgili Kişi:</strong> <%= contactPerson %></div>
                <div><strong>İletişim Bilgisi:</strong> <%= contactInfo %></div>
              </div>
            </div>

            <div class="pdf-card-box">
              <div class="pdf-card-title">
                🚚 Fatura & Sevkiyat Adres Bilgileri
              </div>
              <div class="pdf-card-body">
                <div style="margin-bottom: 8px;">
                  <strong style="color: #475569; font-size: 0.775rem; text-transform: uppercase; display: block;">Fatura Adresi:</strong>
                  <span style="color: #0f172a;"><%= billingAddr %></span>
                </div>
                <div>
                  <strong style="color: #475569; font-size: 0.775rem; text-transform: uppercase; display: block;">Sevk Adresi:</strong>
                  <span style="color: #0f172a;"><%= shippingAddr %></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Products Table with Dedicated Para Birimi Column -->
          <table class="pdf-table">
            <thead>
              <tr>
                <th style="width: 35px; text-align: center;">#</th>
                <th style="width: 110px;">Stok Kodu</th>
                <th>Ürün / Mamul Kalemi Açıklaması</th>
                <th style="width: 80px; text-align: center;">Miktar</th>
                <th style="width: 110px; text-align: right;">Birim Fiyat</th>
                <th style="width: 90px; text-align: center;">Para Birimi</th>
                <th style="width: 75px; text-align: center;">İsk. %</th>
                <th style="width: 70px; text-align: center;">KDV %</th>
                <th style="width: 125px; text-align: right;">Satır Toplamı</th>
              </tr>
            </thead>
            <tbody>
              <% if (itemsList && itemsList.length > 0) { %>
                <% itemsList.forEach((it, idx) => { 
                  let stCode = (it.stokKodu || it.stockCode || '').trim();
                  let stName = (it.ad || it.name || '').trim();

                  if (!stName || stName === 'Ürün Kalemi' || stName === 'Seçilen Ürün') {
                    if (it.stokKarti && it.stokKarti.ad) stName = it.stokKarti.ad;
                  }
                  if (!stCode || stCode === '—' || stCode === 'STOK-N/A' || stCode === 'STK') {
                    if (it.stokKarti && it.stokKarti.stokKodu) stCode = it.stokKarti.stokKodu;
                  }
                  if (!stName) stName = 'Ürün Kalemi';
                  if (!stCode) stCode = '—';

                  const uName = it.birim || it.unit || (quote.stokKarti ? quote.stokKarti.birim : 'Adet');
                  const qty = parseFloat(it.quantity !== undefined ? it.quantity : (it.miktar !== undefined ? it.miktar : 1)) || 1;
                  const price = parseFloat(it.unitPrice !== undefined ? it.unitPrice : (it.birimFiyat !== undefined ? it.birimFiyat : 0)) || 0;
                  const itemCurr = it.currency || it.paraBirimi || mainCurrency;
                  const itemSign = itemCurr === 'USD' ? '$' : (itemCurr === 'EUR' ? '€' : '₺');
                  const disc = parseFloat(it.discountRate !== undefined ? it.discountRate : (it.iskontoOrani !== undefined ? it.iskontoOrani : 0)) || 0;
                  const tax = parseFloat(it.taxRate !== undefined ? it.taxRate : (it.kdvOrani !== undefined ? it.kdvOrani : 20)) || 20;

                  const lineSubtotal = qty * price;
                  const lineDiscount = lineSubtotal * (disc / 100);
                  const lineNet = lineSubtotal - lineDiscount;
                  const lineTax = lineNet * (tax / 100);
                  const lineTotal = parseFloat(it.totalAmount !== undefined ? it.totalAmount : (lineNet + lineTax)) || (lineNet + lineTax);
                %>
                  <tr>
                    <td style="text-align: center; font-weight: 700; color: #64748b;"><%= idx + 1 %></td>
                    <td style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; font-weight: 700; color: #4338ca;"><%= stCode %></td>
                    <td><strong style="color: #0f172a;"><%= stName %></strong></td>
                    <td style="text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;"><%= qty.toLocaleString('tr-TR') %> <%= uName %></td>
                    <td style="text-align: right; font-family: 'JetBrains Mono', monospace;"><%= price.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= itemSign %></td>
                    <td style="text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #4338ca;"><%= itemCurr %></td>
                    <td style="text-align: center; font-weight: 700; color: <%= disc > 0 ? '#ef4444' : '#64748b' %>;">%<%= disc %></td>
                    <td style="text-align: center; color: #475569;">%<%= tax %></td>
                    <td style="text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800; color: #0f172a;"><%= lineTotal.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= itemSign %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="9" style="text-align: center; padding: 20px; color: #64748b;">
                    Bu teklife henüz ürün kalemi eklenmedi.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>

          <!-- Totals & Terms Section -->
          <div class="totals-container">
            <div class="notes-box">
              <strong style="font-size: 0.85rem; color: #0f172a; display: block; margin-bottom: 8px;">📝 Teklif Şartları, Teslimat & Özel Notlar:</strong>
              <div style="line-height: 1.6; color: #334155;">
                <div>• <strong>Ödeme Koşulu:</strong> <%= paymentTerm %></div>
                <div>• <strong>Sevkiyat Süresi:</strong> <%= deliveryTerm %></div>
                <div>• <strong>Teslimat Şekli:</strong> <%= delTerms %></div>
                <% if (quoteNotes !== '—') { %>
                  <div style="margin-top: 8px; border-top: 1px solid #e2e8f0; padding-top: 6px; font-style: italic; color: #475569;">
                    "<%= quoteNotes %>"
                  </div>
                <% } %>
                <% if (cProf.bankaBilgileri) { %>
                  <div style="margin-top: 8px; border-top: 1px solid #cbd5e1; padding-top: 6px; font-size: 0.775rem; color: #475569;">
                    <strong>🏦 Kurumsal Banka & IBAN:</strong> <%= cProf.bankaBilgileri %>
                  </div>
                <% } %>
              </div>
            </div>

            <div class="totals-box">
              <div class="tot-row">
                <span>Ara Toplam (Brüt):</span>
                <strong><%= subtotal.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= mainCurrSign %></strong>
              </div>
              <div class="tot-row">
                <span>Toplam İskonto:</span>
                <strong style="color: #ef4444;">- <%= discountAmount.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= mainCurrSign %></strong>
              </div>
              <div class="tot-row">
                <span>Hesaplanan KDV:</span>
                <strong><%= taxAmount.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= mainCurrSign %></strong>
              </div>
              <div class="tot-row grand">
                <span>GENEL TOPLAM:</span>
                <span><%= totalAmount.toLocaleString('tr-TR', {minimumFractionDigits: 2}) %> <%= mainCurrSign %></span>
              </div>
            </div>
          </div>

          <!-- Formal Corporate Signature Blocks -->
          <div class="signature-grid">
            <div class="sig-box">
              <div class="sig-title">Teklifi Hazırlayan & Satan</div>
              <div class="sig-line"></div>
              <div class="sig-sub">
                <strong><%= creatorName %></strong><br>
                Satış Temsilcisi
              </div>
            </div>

            <div class="sig-box">
              <div class="sig-title">Müşteri Onayı & Firma Kaşesi</div>
              <div class="sig-line"></div>
              <div class="sig-sub">
                <strong><%= cName %></strong><br>
                Yetkili İmza & Kaşe
              </div>
            </div>
          </div>

        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
