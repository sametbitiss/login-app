<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni Özel Fiyat Listesi Tanımla — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .pl-card { 
      background: rgba(15, 23, 42, 0.75); 
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08); 
      border-radius: 20px; 
      padding: 28px; 
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25); 
      margin-bottom: 24px; 
    }
    .pl-title { 
      font-size: 1.2rem; 
      font-weight: 800; 
      color: #fff; 
      margin: 0 0 16px 0; 
      display: flex; 
      align-items: center; 
      gap: 10px; 
    }
  </style>
  <script src="/sidebar.js" defer></script>
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link active">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a><a href="/quality" class="mt-link">Kalite Kontrol</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">

      <div class="page-header" style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h1 style="font-size: 1.5rem; font-weight: 900; color: #fff; margin: 0;">➕ Yeni Müşteri Özel Fiyat Listesi Tanımla</h1>
          <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 4px;">Seçilen müşteriye tek seferde dilediğiniz kadar ürün için özel fiyat ve iskonto oranı tanımlayabilirsiniz.</p>
        </div>
        <a href="/sales/price-lists" class="btn btn-outline-secondary btn-sm" style="font-weight: 600; border-radius: 10px; padding: 8px 16px;">
          ← Özel Fiyat Listelerine Dön
        </a>
      </div>

      <% if (error) { %>
        <div style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); color: #f43f5e; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 1.5rem; font-weight: 600; font-size: 0.9rem;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <!-- NEW MULTI-PRODUCT PRICE LIST DEFINITION CARD -->
      <div class="pl-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 1rem;">
          <div>
            <h2 class="pl-title" style="margin: 0;">
              <span style="background: linear-gradient(135deg, #10b981, #059669); color: #fff; width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.9rem;">➕</span>
              Liste & Müşteri Detayları
            </h2>
          </div>

          <div>
            <button type="button" onclick="openProductSelectModal()" class="btn btn-sm"
              style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 700; padding: 10px 20px; border-radius: 10px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3); display: inline-flex; align-items: center; gap: 8px; cursor: pointer;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
              📦 Stok Kartından Ürün Seç (Modal)
            </button>
          </div>
        </div>

        <form action="/sales/price-lists/add" method="POST" id="priceListForm">
          <input type="hidden" name="itemsJson" id="itemsJsonInput" value="[]">

          <!-- Header Inputs Grid -->
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 14px; margin-bottom: 1.25rem;">
            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Liste / Sözleşme Adı <span style="color: #f43f5e;">*</span></label>
              <input type="text" name="listName" value="" placeholder="ör. VIP Müşteri Fiyat Listesi" required style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px;">
            </div>

            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Cari Müşteri Seçimi</label>
              <select name="customerId" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px; font-weight: 600;">
                <option value="">-- Tüm Müşteriler (Genel Fiyat Listesi) --</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>">[<%= c.musteriKodu || c.customerCode %>] <%= c.firmaAdi || c.companyName %></option>
                <% }); %>
              </select>
            </div>

            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Geçerlilik Başlangıç Tarihi</label>
              <input type="date" name="validFrom" id="validFromInput" value="" min="<%= new Date().toISOString().split('T')[0] %>" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px;">
            </div>

            <div class="input-group">
              <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Geçerlilik Bitiş Tarihi</label>
              <input type="date" name="validUntil" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 9px 12px; border-radius: 8px;">
            </div>
          </div>

          <!-- Price Limit Warning Alert Banner -->
          <div id="priceLimitExceededAlert" style="display: none; background: rgba(244, 63, 94, 0.18); border: 1px solid rgba(244, 63, 94, 0.5); padding: 12px 18px; border-radius: 12px; color: #f43f5e; font-size: 0.85rem; font-weight: 700; align-items: center; gap: 10px; margin-bottom: 1.25rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span id="priceLimitExceededText">⚠️ Girilen özel fiyat, ürünün piyasa liste satış fiyatından daha yüksek olamaz!</span>
          </div>

          <!-- Multi-Product Table -->
          <div style="overflow-x: auto; border-radius: 14px; border: 1px solid var(--border); background: rgba(6, 8, 15, 0.8); margin-bottom: 1.25rem;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="itemsTable">
              <thead>
                <tr style="background: rgba(19, 26, 43, 0.9); border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px;">
                  <th style="padding: 12px 14px; width: 40px; text-align: center;">#</th>
                  <th style="padding: 12px 14px;">Stok / Ürün Kalemi</th>
                  <th style="padding: 12px 14px; width: 150px; text-align: right;">Liste Satış Fiyatı</th>
                  <th style="padding: 12px 14px; width: 170px; text-align: right;">Müşteriye Özel Fiyat</th>
                  <th style="padding: 12px 14px; width: 130px; text-align: center;">Özel İskonto (%)</th>
                  <th style="padding: 12px 14px; width: 110px; text-align: center;">Para Birimi</th>
                  <th style="padding: 12px 14px; width: 50px; text-align: center;">Sil</th>
                </tr>
              </thead>
              <tbody id="itemsTbody">
                <tr id="emptyItemsPlaceholder">
                  <td colspan="7" style="padding: 35px; text-align: center; color: var(--text-muted);">
                    📦 Henüz özel fiyatlı ürün kalemi eklenmedi.<br>
                    <span style="font-size: 0.8rem; margin-top: 6px; display: inline-block; color: #818cf8;">Yukarıdaki <strong>'📦 Stok Kartından Ürün Seç (Modal)'</strong> butonuna tıklayarak özel fiyat listesine ürünler ekleyebilirsiniz.</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 0.825rem; color: var(--text-muted);">
              💡 <em>Not: Bir müşteri için özel fiyat belirlenirken ürünün liste fiyatının üzerinde fiyat girilemez.</em>
            </div>
            <button type="submit" class="btn" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 800; padding: 11px 24px; border-radius: 10px; box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35); font-size: 0.9rem; cursor: pointer;">
              💾 Müşteri Özel Fiyat Listesini Kaydet
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <!-- Stock Item Master Catalog JSON Data -->
  <script id="stockCatalogData" type="application/json">
    <%- JSON.stringify(stockItems || []) %>
  </script>

  <script>
    const stockCatalog = JSON.parse(document.getElementById('stockCatalogData').textContent || '[]');
    let rowIdCounter = 0;

    function addNewRow(initialData = null) {
      rowIdCounter++;
      const tbody = document.getElementById('itemsTbody');
      const placeholder = document.getElementById('emptyItemsPlaceholder');
      if (placeholder) {
        placeholder.remove();
      }

      const tr = document.createElement('tr');
      tr.id = `row-${rowIdCounter}`;

      const stockId = initialData ? initialData.stockItemId : null;
      const st = (stockCatalog || []).find(s => s.id === parseInt(stockId, 10));
      const code = st ? (st.stokKodu || st.stockCode || '') : '';
      const name = st ? (st.ad || st.name || '') : '';

      const listPrice = st ? parseFloat(st.satisFiyati || st.salePrice || 0) : (initialData ? parseFloat(initialData.salePrice || 0) : 0);
      const price = initialData && initialData.specialPrice !== undefined ? initialData.specialPrice : listPrice;
      const discount = initialData && initialData.customDiscountRate !== undefined ? initialData.customDiscountRate : 0;
      const currency = initialData && initialData.currency ? initialData.currency : 'TRY';
      const refText = listPrice > 0 ? listPrice.toLocaleString('tr-TR', {minimumFractionDigits: 2}) + ' TL' : '—';

      tr.innerHTML = `
        <td style="padding: 12px 14px; text-align: center; font-weight: 700; color: var(--text-muted);" class="row-index">1</td>
        <td style="padding: 12px 14px;">
          <input type="hidden" class="item-stock-id" value="${stockId || ''}" data-code="${code}" data-name="${name}" data-price="${listPrice}">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.775rem; color: #818cf8; background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.25); padding: 4px 10px; border-radius: 8px; font-weight: 700; flex-shrink: 0;">
              ${code || 'STOK-N/A'}
            </span>
            <strong style="color: #fff; font-size: 0.925rem; font-weight: 600; line-height: 1.3;">${name || 'Seçilen Ürün'}</strong>
          </div>
        </td>
        <td style="padding: 12px 14px; text-align: right;">
          <span class="item-ref-price" style="font-family: 'JetBrains Mono', monospace; color: var(--text-muted); font-size: 0.85rem;">${refText}</span>
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.01" min="0" max="${listPrice > 0 ? listPrice : ''}" value="${price}" placeholder="0.00" class="item-special-price" oninput="validateRowPrice(this, ${rowIdCounter})" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #34d399; padding: 8px 10px; border-radius: 8px; text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 800;">
        </td>
        <td style="padding: 12px 14px;">
          <input type="number" step="0.1" min="0" max="100" value="${discount}" class="item-discount" oninput="updateItemsPayload()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fb7185; padding: 8px 10px; border-radius: 8px; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 700;">
        </td>
        <td style="padding: 12px 14px;">
          <select class="item-currency" onchange="updateItemsPayload()" style="width: 100%; background: rgba(6, 8, 15, 0.9); border: 1px solid var(--border); color: #fff; padding: 8px 10px; border-radius: 8px; text-align: center;">
            <option value="TRY" ${currency === 'TRY' ? 'selected' : ''}>TRY (₺)</option>
            <option value="USD" ${currency === 'USD' ? 'selected' : ''}>USD ($)</option>
            <option value="EUR" ${currency === 'EUR' ? 'selected' : ''}>EUR (€)</option>
          </select>
        </td>
        <td style="padding: 12px 14px; text-align: center;">
          <button type="button" onclick="removeRow(${rowIdCounter})" title="Ürünü Listeden Çıkar" style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.3); color: #f43f5e; width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;">
            ✕
          </button>
        </td>
      `;

      tbody.appendChild(tr);
      updateRowIndices();
      updateItemsPayload();
    }

    function removeRow(id) {
      const tbody = document.getElementById('itemsTbody');
      const tr = document.getElementById(`row-${id}`);
      if (tr) {
        tr.remove();
      }

      const remainingRows = tbody.querySelectorAll('tr:not(#emptyItemsPlaceholder)');
      if (remainingRows.length === 0) {
        tbody.innerHTML = `
          <tr id="emptyItemsPlaceholder">
            <td colspan="7" style="padding: 35px; text-align: center; color: var(--text-muted);">
              📦 Henüz özel fiyatlı ürün kalemi eklenmedi.<br>
              <span style="font-size: 0.8rem; margin-top: 6px; display: inline-block; color: #818cf8;">Yukarıdaki <strong>'📦 Stok Kartından Ürün Seç (Modal)'</strong> butonuna tıklayarak özel fiyat listesine ürünler ekleyebilirsiniz.</span>
            </td>
          </tr>
        `;
      }

      updateRowIndices();
      updateItemsPayload();
    }

    function updateRowIndices() {
      const rows = document.querySelectorAll('#itemsTbody tr:not(#emptyItemsPlaceholder)');
      rows.forEach((tr, index) => {
        const indexTd = tr.querySelector('.row-index');
        if (indexTd) indexTd.textContent = index + 1;
      });
    }

    function validateRowPrice(inputEl, rowId) {
      const tr = document.getElementById(`row-${rowId}`);
      if (!tr) return;
      const stockInput = tr.querySelector('.item-stock-id');
      const listPrice = stockInput ? (parseFloat(stockInput.getAttribute('data-price')) || 0) : 0;
      const val = parseFloat(inputEl.value) || 0;

      const alertEl = document.getElementById('priceLimitExceededAlert');
      const alertText = document.getElementById('priceLimitExceededText');

      if (listPrice > 0 && val > listPrice) {
        inputEl.style.borderColor = '#f43f5e';
        inputEl.style.color = '#f43f5e';
        if (alertEl && alertText) {
          const stockCode = stockInput ? stockInput.getAttribute('data-code') : '';
          alertText.textContent = `⚠️ [${stockCode}] ürünü için girilen özel fiyat (${val.toLocaleString('tr-TR', {minimumFractionDigits:2})} TL), ürünün standart liste satış fiyatından (${listPrice.toLocaleString('tr-TR', {minimumFractionDigits:2})} TL) daha yüksek olamaz!`;
          alertEl.style.display = 'flex';
        }
      } else {
        inputEl.style.borderColor = 'var(--border)';
        inputEl.style.color = '#34d399';
        if (alertEl) alertEl.style.display = 'none';
      }

      updateItemsPayload();
    }

    function updateItemsPayload() {
      const rows = document.querySelectorAll('#itemsTbody tr:not(#emptyItemsPlaceholder)');
      const itemsPayload = [];

      rows.forEach(tr => {
        const stockInput = tr.querySelector('.item-stock-id');
        const stockItemId = stockInput ? stockInput.value : '';
        const specialPrice = parseFloat(tr.querySelector('.item-special-price').value) || 0;
        const customDiscountRate = parseFloat(tr.querySelector('.item-discount').value) || 0;
        const currency = tr.querySelector('.item-currency').value || 'TRY';

        if (stockItemId) {
          itemsPayload.push({
            stockItemId,
            specialPrice,
            customDiscountRate,
            currency
          });
        }
      });

      document.getElementById('itemsJsonInput').value = JSON.stringify(itemsPayload);
    }

    // --- PRODUCT SELECTION MODAL LOGIC ---
    function openProductSelectModal() {
      const modal = document.getElementById('productSelectModal');
      if (!modal) return;
      document.getElementById('modalProductSearch').value = '';
      document.getElementById('modalProductSort').value = 'ad_asc';
      document.getElementById('modalSelectAllChk').checked = false;
      modal.style.display = 'flex';
      renderModalProducts();
      setTimeout(() => {
        const searchInput = document.getElementById('modalProductSearch');
        if (searchInput) searchInput.focus();
      }, 100);
    }

    function closeProductSelectModal() {
      const modal = document.getElementById('productSelectModal');
      if (modal) modal.style.display = 'none';
    }

    function renderModalProducts() {
      const tbody = document.getElementById('modalProductsTbody');
      if (!tbody) return;

      const searchVal = (document.getElementById('modalProductSearch')?.value || '').toLowerCase().trim();
      const sortVal = document.getElementById('modalProductSort')?.value || 'ad_asc';

      let items = (stockCatalog || []).filter(item => {
        const code = (item.stokKodu || item.stockCode || '').toLowerCase();
        const name = (item.ad || item.name || '').toLowerCase();
        return code.includes(searchVal) || name.includes(searchVal);
      });

      items.sort((a, b) => {
        const codeA = (a.stokKodu || a.stockCode || '').toLowerCase();
        const codeB = (b.stokKodu || b.stockCode || '').toLowerCase();
        const nameA = (a.ad || a.name || '').toLowerCase();
        const nameB = (b.ad || b.name || '').toLowerCase();

        if (sortVal === 'stokKodu_asc') return codeA.localeCompare(codeB, 'tr', { numeric: true });
        if (sortVal === 'stokKodu_desc') return codeB.localeCompare(codeA, 'tr', { numeric: true });
        if (sortVal === 'ad_desc') return nameB.localeCompare(nameA, 'tr');
        return nameA.localeCompare(nameB, 'tr');
      });

      if (items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="padding: 40px; text-align: center; color: var(--text-muted);">
              🔍 Arama kriterlerine uygun stok ürünü bulunamadı.
            </td>
          </tr>
        `;
        updateModalSelectedCount();
        return;
      }

      tbody.innerHTML = items.map(st => {
        const code = st.stokKodu || st.stockCode || '';
        const name = st.ad || st.name || '';
        const category = st.kategori || 'Mamul';
        const price = parseFloat(st.satisFiyati || st.salePrice || 0);
        const stock = parseFloat(st.mevcutStok || st.currentStock || 0);
        const unit = st.birim || 'Adet';

        return `
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.04)'" onmouseout="this.style.background='transparent'">
            <td style="padding: 10px 14px; text-align: center;">
              <input type="checkbox" class="modal-product-chk" data-id="${st.id}" onchange="updateModalSelectedCount()" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;">
            </td>
            <td style="padding: 10px 14px; font-family: 'JetBrains Mono', monospace; font-size: 0.825rem; color: #818cf8; font-weight: 600;">
              ${code}
            </td>
            <td style="padding: 10px 14px; font-weight: 600; color: #fff;">
              ${name}
            </td>
            <td style="padding: 10px 14px;">
              <span style="background: rgba(99, 102, 241, 0.12); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.2); padding: 2px 8px; border-radius: 8px; font-size: 0.75rem; font-weight: 600;">
                ${category}
              </span>
            </td>
            <td style="padding: 10px 14px; text-align: right; font-family: 'JetBrains Mono', monospace; font-weight: 700; color: #fff;">
              ${price.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} ₺
            </td>
            <td style="padding: 10px 14px; text-align: center; font-size: 0.8rem; color: ${stock > 0 ? '#34d399' : '#fb7185'}; font-weight: 600;">
              ${stock} ${unit}
            </td>
            <td style="padding: 10px 14px; text-align: center;">
              <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">1 Adet</span>
            </td>
          </tr>
        `;
      }).join('');

      updateModalSelectedCount();
    }

    function toggleSelectAllModalProducts(mainChk) {
      const checkboxes = document.querySelectorAll('.modal-product-chk');
      checkboxes.forEach(chk => chk.checked = mainChk.checked);
      updateModalSelectedCount();
    }

    function updateModalSelectedCount() {
      const checkedCount = document.querySelectorAll('.modal-product-chk:checked').length;
      const badge = document.getElementById('modalSelectedCountBadge');
      if (badge) badge.textContent = `${checkedCount} Ürün Seçildi`;
    }

    function addSelectedProductsToPriceList() {
      const checkedChks = document.querySelectorAll('.modal-product-chk:checked');
      if (checkedChks.length === 0) {
        alert('⚠️ Lütfen listeye eklemek istediğiniz en az 1 ürün işaretleyiniz.');
        return;
      }

      const tbody = document.getElementById('itemsTbody');
      const placeholder = document.getElementById('emptyItemsPlaceholder');
      if (placeholder) {
        placeholder.remove();
      }

      checkedChks.forEach(chk => {
        const stockId = parseInt(chk.getAttribute('data-id'), 10);
        const item = (stockCatalog || []).find(s => s.id === stockId);
        if (!item) return;

        const listPrice = parseFloat(item.satisFiyati || item.salePrice || 0);

        addNewRow({
          stockItemId: item.id,
          specialPrice: listPrice,
          customDiscountRate: 0,
          currency: 'TRY'
        });
      });

      closeProductSelectModal();
      updateItemsPayload();
    }

    const form = document.getElementById('priceListForm');
    if (form) {
      form.addEventListener('submit', function(e) {
        updateItemsPayload();

        const validFromInput = document.getElementById('validFromInput');
        const todayStr = new Date().toISOString().split('T')[0];
        if (validFromInput && validFromInput.value && validFromInput.value < todayStr) {
          e.preventDefault();
          alert('⚠️ Geçerlilik başlangıç tarihi bugünden eski bir tarih olamaz!');
          validFromInput.focus();
          return false;
        }

        const rows = document.querySelectorAll('#itemsTbody tr:not(#emptyItemsPlaceholder)');
        let hasError = false;

        rows.forEach(tr => {
          const stockInput = tr.querySelector('.item-stock-id');
          const listPrice = stockInput ? (parseFloat(stockInput.getAttribute('data-price')) || 0) : 0;
          const specPrice = parseFloat(tr.querySelector('.item-special-price').value) || 0;

          if (!stockInput || !stockInput.value) {
            hasError = true;
            alert('⚠️ Lütfen tüm eklenen satırlar için ürün seçimi yapınız!');
          } else if (listPrice > 0 && specPrice > listPrice) {
            hasError = true;
            alert(`⚠️ Girilen özel fiyat (${specPrice} TL), ürünün standart liste satış fiyatından (${listPrice} TL) daha yüksek olamaz!`);
          }
        });

        if (hasError) {
          e.preventDefault();
          return false;
        }

        const payload = document.getElementById('itemsJsonInput').value;
        let arr = [];
        try { arr = JSON.parse(payload); } catch(err) { arr = []; }

        if (!arr || arr.length === 0) {
          e.preventDefault();
          alert('⚠️ Lütfen en az 1 adet stok ürünü için özel fiyat giriniz!');
          return false;
        }
      });
    }

    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>

  <!-- PRODUCT ITEM SELECTION MODAL -->
  <div id="productSelectModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(12px); z-index: 9999; display: none; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; width: 100%; max-width: 950px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7); position: relative;">
      
      <!-- Modal Header -->
      <div style="padding: 20px 24px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: space-between; background: rgba(15, 23, 42, 0.95);">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="font-size: 1.5rem; background: rgba(99, 102, 241, 0.15); width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(99, 102, 241, 0.3);">📦</span>
          <div>
            <h2 style="font-size: 1.25rem; font-weight: 800; color: #fff; margin: 0;">Stok Kartlarından Ürün Seçimi</h2>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">Özel fiyat listesine eklemek istediğiniz stok ürünlerini arayabilir, sıralayabilir ve çoklu seçim ile ekleyebilirsiniz.</p>
          </div>
        </div>
        <button type="button" onclick="closeProductSelectModal()" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: var(--text-muted); width: 36px; height: 36px; border-radius: 10px; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">✕</button>
      </div>

      <!-- Modal Search & Filter Controls -->
      <div style="padding: 16px 24px; background: rgba(30, 41, 59, 0.5); border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
        <!-- Search Input -->
        <div style="flex: 1; min-width: 250px; position: relative;">
          <input type="text" id="modalProductSearch" oninput="renderModalProducts()" placeholder="🔍 Ürün adı veya stok numarası (stok kodu) ile arayın..." style="width: 100%; padding: 10px 14px 10px 38px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.875rem; outline: none;">
          <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;">🔍</span>
        </div>

        <!-- Sort Select Dropdown -->
        <div style="width: 320px;">
          <select id="modalProductSort" onchange="renderModalProducts()" style="width: 100%; padding: 10px 14px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 10px; color: #fff; font-size: 0.85rem; outline: none; font-weight: 600;">
            <option value="ad_asc" selected>🔤 Ürün İsmine Göre: A'dan Z'ye</option>
            <option value="ad_desc">🔤 Ürün İsmine Göre: Z'den A'ya</option>
            <option value="stokKodu_asc">🔢 Stok Numarasına Göre: Küçükten Büyüğe (A-Z)</option>
            <option value="stokKodu_desc">🔢 Stok Numarasına Göre: Büyükten Küçüğe (Z-A)</option>
          </select>
        </div>
      </div>

      <!-- Modal Product List Table -->
      <div style="flex: 1; overflow-y: auto; padding: 16px 24px;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;" id="modalProductsTable">
          <thead>
            <tr style="background: rgba(30, 41, 59, 0.8); border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.8px; position: sticky; top: 0; z-index: 10;">
              <th style="padding: 12px 14px; width: 45px; text-align: center;">
                <input type="checkbox" id="modalSelectAllChk" onchange="toggleSelectAllModalProducts(this)" style="cursor: pointer; width: 16px; height: 16px; accent-color: #6366f1;">
              </th>
              <th style="padding: 12px 14px; width: 150px;">Stok Kodu</th>
              <th style="padding: 12px 14px;">Ürün / Mamul Adı</th>
              <th style="padding: 12px 14px; width: 110px;">Kategori</th>
              <th style="padding: 12px 14px; width: 120px; text-align: right;">Birim Fiyat</th>
              <th style="padding: 12px 14px; width: 110px; text-align: center;">Stok</th>
              <th style="padding: 12px 14px; width: 110px; text-align: center;">Seçim</th>
            </tr>
          </thead>
          <tbody id="modalProductsTbody">
            <!-- Rendered dynamically by renderModalProducts() -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div style="padding: 16px 24px; border-top: 1px solid rgba(255, 255, 255, 0.1); background: rgba(15, 23, 42, 0.95); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;" id="modalSelectedCountBadge">
          0 Ürün Seçildi
        </div>
        <div style="display: flex; gap: 12px;">
          <button type="button" class="btn btn-secondary" onclick="closeProductSelectModal()" style="padding: 10px 20px; border-radius: 10px;">İptal</button>
          <button type="button" class="btn btn-primary" onclick="addSelectedProductsToPriceList()" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; font-weight: 700; padding: 10px 24px; border-radius: 10px; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.35);">
            ✅ Seçilen Ürünleri Özel Fiyat Listesine Ekle
          </button>
        </div>
      </div>

    </div>
  </div>
</body>
</html>
