<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yönetsel Onay ve Yetkilendirme Mekanizması — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="module-body">

  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">💼 SATIŞ & PAZARLAMA</div>

      <div class="mss-group-title">📊 DASHBOARD & ONAY</div>
      <div class="mss-sub">
        <a href="/sales/analytics" class="mss-sub-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="mss-sub-link active">⚡ Yönetsel Onaylar</a>
      </div>

      <div class="mss-group-title">📋 SATIŞ OPERASYONLARI</div>
      <div class="mss-sub">
        <a href="/sales/quotes" class="mss-sub-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="mss-sub-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="mss-sub-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="mss-sub-link">🧾 Satış Faturaları</a>
      </div>

      <div class="mss-group-title">👥 MÜŞTERİ & FİYAT YÖNETİMİ</div>
      <div class="mss-sub">
        <a href="/sales/customers" class="mss-sub-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="mss-sub-link">💰 Özel Fiyat Listeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <% if (user.role === 'Admin') { %>
          <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <% } %>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link active">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <% if (user.role === 'Admin' || user.role === 'Production_Manager') { %>
          <a href="/production" class="mt-link">Üretim Planlama</a>
        <% } %>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <!-- Sub-Nav Bar -->
      <div class="module-subnav">
        <a href="/sales/analytics" class="msn-link">📊 Satış Analitiği</a>
        <a href="/sales/approvals" class="msn-link active">⚡ Yönetsel Onaylar</a>
        <a href="/sales/quotes" class="msn-link">📜 Teklif & Fiyatlandırma</a>
        <a href="/sales/orders" class="msn-link">📋 Satış Siparişleri</a>
        <a href="/sales/dispatches" class="msn-link">🚚 Sevkiyat & İrsaliye</a>
        <a href="/sales/invoices" class="msn-link">🧾 Satış Faturaları</a>
        <a href="/sales/customers" class="msn-link">👥 Cari Müşteri Kartları</a>
        <a href="/sales/price-lists" class="msn-link">💰 Özel Fiyat Listeleri</a>
      </div>

      <div class="page-header">
        <div>
          <h1>Onay ve Yetkilendirme Mekanizması</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Özel indirim oranları (>&percnt;20) veya yüksek tutarlı teklif ve siparişlerin yönetici onay paneli.</p>
        </div>
      </div>

      <!-- Pending Quotations Approval Section -->
      <div style="margin-bottom: 2rem;">
        <h3 style="color: var(--pink); font-size: 1.1rem; margin-bottom: 1rem;">📜 Onay Bekleyen Satış Teklifleri</h3>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Teklif No</th>
                <th>Müşteri</th>
                <th>Ürün</th>
                <th>İskonto (%)</th>
                <th>Genel Toplam</th>
                <th>Neden Onay Bekliyor?</th>
                <th>Karar</th>
              </tr>
            </thead>
            <tbody>
              <% if (pendingQuotes.length === 0) { %>
                <tr><td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">Onay bekleyen satış teklifi bulunmamaktadır.</td></tr>
              <% } else { %>
                <% pendingQuotes.forEach(q => { %>
                  <tr>
                    <td><strong style="font-family: monospace; color: var(--pink);"><%= q.quotationNo %></strong></td>
                    <td><strong><%= q.customerName %></strong></td>
                    <td><%= q.stockItem ? q.stockItem.name : '' %></td>
                    <td><strong style="color: var(--amber);">%<%= q.discountRate %></strong></td>
                    <td><strong><%= parseFloat(q.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= q.currency %></strong></td>
                    <td><span class="status-pill status-pending">● Yüksek İskonto / Tutar</span></td>
                    <td>
                      <div style="display:flex; gap:0.5rem;">
                        <form action="/sales/approvals/quote/<%= q.id %>/action" method="POST">
                          <input type="hidden" name="action" value="approve">
                          <button type="submit" class="btn btn-sm btn-success">✓ Onayla</button>
                        </form>
                        <form action="/sales/approvals/quote/<%= q.id %>/action" method="POST">
                          <input type="hidden" name="action" value="reject">
                          <button type="submit" class="btn btn-sm btn-danger">✕ Reddet</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pending Sales Orders Approval Section -->
      <div>
        <h3 style="color: var(--indigo); font-size: 1.1rem; margin-bottom: 1rem;">📋 Onay Bekleyen Satış Siparişleri</h3>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Sipariş No</th>
                <th>Müşteri</th>
                <th>Ürün</th>
                <th>İskonto (%)</th>
                <th>Genel Toplam</th>
                <th>Neden Onay Bekliyor?</th>
                <th>Karar</th>
              </tr>
            </thead>
            <tbody>
              <% if (pendingOrders.length === 0) { %>
                <tr><td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-muted);">Onay bekleyen satış siparişi bulunmamaktadır.</td></tr>
              <% } else { %>
                <% pendingOrders.forEach(o => { %>
                  <tr>
                    <td><strong style="font-family: monospace; color: var(--indigo);"><%= o.orderNo %></strong></td>
                    <td><strong><%= o.customerName %></strong></td>
                    <td><%= o.stockItem ? o.stockItem.name : '' %></td>
                    <td><strong style="color: var(--amber);">%<%= o.discountRate %></strong></td>
                    <td><strong><%= parseFloat(o.totalAmount).toLocaleString('tr-TR', {minimumFractionDigits:2}) %> <%= o.currency %></strong></td>
                    <td><span class="status-pill status-pending">● <%= o.approvalReason || 'Yüksek İskonto / Risk Limiti / Tutar' %></span></td>
                    <td>
                      <div style="display:flex; gap:0.5rem;">
                        <form action="/sales/approvals/order/<%= o.id %>/action" method="POST">
                          <input type="hidden" name="action" value="approve">
                          <button type="submit" class="btn btn-sm btn-success">✓ Onayla</button>
                        </form>
                        <form action="/sales/approvals/order/<%= o.id %>/action" method="POST">
                          <input type="hidden" name="action" value="reject">
                          <button type="submit" class="btn btn-sm btn-danger">✕ Reddet</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    function updateClock() {
      const now = new Date();
      const el = document.getElementById('liveTime');
      if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
    }
    updateClock();
    setInterval(updateClock, 1000);
  </script>
</body>
</html>
