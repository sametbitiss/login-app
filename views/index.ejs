          <p class="mod-card-desc">Bu modüle erişmek için Satış Yöneticisi veya Admin yetkisi gerekmektedir.</p>
        </div>
      <% } %>

      <!-- 4. Satın Alma Yönetimi -->
      <% if (user.role === 'Admin' || user.role === 'Purchase_Manager' || user.role === 'Stock_Manager') { %>
