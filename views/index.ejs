            <span class="mod-card-action">Modüle Git <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </a>
      <% } else { %>
        <div class="mod-card mod-card--locked" data-status="locked" id="card-purchase">
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--neutral">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </div>
            <span class="mod-badge mod-badge--locked">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              KISITLI
            </span>
          </div>
          <h3 class="mod-card-title">Satın Alma Yönetimi</h3>
          <p class="mod-card-desc">Bu modüle erişmek için Satın Alma Yöneticisi veya Admin yetkisi gerekmektedir.</p>
        </div>
      <% } %>

      <!-- 5. Üretim Planlama (AKTİF) -->
      <% if (user.role === 'Admin' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Sales_Manager' || user.role === 'Purchase_Manager' || user.role === 'Quality_Manager' || user.role === 'Employee' || user.role === 'Ozel_Saha_Uzmani') { %>
        <a href="/production" class="mod-card mod-card--active" data-status="active" id="card-production">
          <div class="mod-card-glow mod-card-glow--emerald"></div>
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--emerald">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M5 20V10l4-4 4 4v10"/><path d="M13 20V4l6 6v10"/></svg>
            </div>
            <span class="mod-badge mod-badge--active">
              <span class="mod-badge-dot"></span>AKTİF
            </span>
          </div>
          <h3 class="mod-card-title">Üretim Planlama</h3>
          <p class="mod-card-desc">Üretim hatları, iş emirleri, reçeteler (BOM), istasyon takibi ve kaynak planlama</p>
          <div class="mod-card-footer">
            <span class="mod-card-action">Modüle Git <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </a>
      <% } else { %>
        <div class="mod-card mod-card--locked" data-status="locked" id="card-production">
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--neutral">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M5 20V10l4-4 4 4v10"/><path d="M13 20V4l6 6v10"/></svg>
            </div>
            <span class="mod-badge mod-badge--locked">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              KISITLI
            </span>
          </div>
          <h3 class="mod-card-title">Üretim Planlama</h3>
          <p class="mod-card-desc">Bu modüle erişmek için Üretim Yöneticisi veya Admin yetkisi gerekmektedir.</p>
        </div>
      <% } %>

      <!-- 6. Kalite Kontrol Yönetimi (AKTİF) -->
      <% if (user.role === 'Admin' || user.role === 'Quality_Manager' || user.role === 'Production_Manager' || user.role === 'Stock_Manager' || user.role === 'Purchase_Manager') { %>
        <a href="/quality" class="mod-card mod-card--active" data-status="active" id="card-quality">
          <div class="mod-card-glow mod-card-glow--indigo"></div>
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--indigo">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <span class="mod-badge mod-badge--active">
              <span class="mod-badge-dot"></span>AKTİF
            </span>
          </div>
          <h3 class="mod-card-title">Kalite Kontrol</h3>
          <p class="mod-card-desc">Giriş/Proses/Final muayeneleri, NCR uygunsuzluk, CAPA aksiyon, lot izlenebilirliği ve kalibrasyon</p>
          <div class="mod-card-footer">
            <span class="mod-card-action">Modüle Git <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </div>
        </a>
      <% } else { %>
        <div class="mod-card mod-card--locked" data-status="locked" id="card-quality">
          <div class="mod-card-header">
            <div class="mod-card-icon mod-card-icon--neutral">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <span class="mod-badge mod-badge--locked">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              KISITLI
            </span>
          </div>
          <h3 class="mod-card-title">Kalite Kontrol</h3>
          <p class="mod-card-desc">Bu modüle erişmek için Kalite Yöneticisi veya Admin yetkisi gerekmektedir.</p>
        </div>
      <% } %>

    </div>

    <!-- Footer -->
    <footer class="dashboard-footer">
      <div class="footer-left">
        <span>© 2026 Enterprise ERP Suite</span>
        <span class="footer-dot">·</span>
        <span>v2.0.0</span>
      </div>
      <div class="footer-right">
        <span class="footer-status">
          <span class="footer-status-dot"></span>
          Tüm Sistemler Aktif
        </span>
      </div>
    </footer>

  </main>

  <script>
    // Live Clock
    function updateClock() {
      const now = new Date();
      const opts = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
      const dateOpts = { day: 'numeric', month: 'long', year: 'numeric' };
      const timeEl = document.getElementById('liveTime');
      if (timeEl) {
        timeEl.textContent = now.toLocaleDateString('tr-TR', dateOpts) + '  •  ' + now.toLocaleTimeString('tr-TR', opts);
      }
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Count active modules
    const activeCards = document.querySelectorAll('.mod-card--active');
    const activeCount = activeCards.length;
    const countEl = document.getElementById('activeModuleCount');
    const kpiEl = document.getElementById('kpiActiveCount');
    if (countEl) countEl.textContent = activeCount;
    if (kpiEl) kpiEl.textContent = activeCount;

    // Animate ring
    const ringProgress = document.querySelector('.stat-ring-progress');
    if (ringProgress) {
      const total = 6;
      const pct = activeCount / total;
      const circumference = 2 * Math.PI * 52;
      const offset = circumference * (1 - pct);
      setTimeout(() => {
        ringProgress.style.strokeDashoffset = offset;
      }, 400);
    }

    // Mobile menu toggle
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const navLinks = document.getElementById('navLinks');
    if (mobileBtn && navLinks) {
      mobileBtn.addEventListener('click', () => {
        navLinks.classList.toggle('open');
        mobileBtn.classList.toggle('active');
      });
    }

    // Filter buttons
    const filterBtns = document.querySelectorAll('.filter-btn');
    const allCards = document.querySelectorAll('.mod-card');
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter;
        allCards.forEach(card => {
          if (filter === 'all') {
            card.style.display = '';
          } else if (filter === 'active') {
            card.style.display = card.classList.contains('mod-card--active') ? '' : 'none';
          } else {
            card.style.display = !card.classList.contains('mod-card--active') ? '' : 'none';
          }
        });
      });
    });

    // Staggered card entrance animation
    allCards.forEach((card, i) => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(24px)';
      setTimeout(() => {
        card.style.transition = 'opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
      }, 150 + i * 80);
    });
  </script>
</body>
</html>
