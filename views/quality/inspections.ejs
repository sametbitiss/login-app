<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kalite Muayene Kayıtları — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .badge-accepted { background: rgba(16,185,129,0.15); color: #34d399; border: 1px solid rgba(16,185,129,0.3); padding: 4px 10px; border-radius: 20px; font-weight: 700; font-size: 0.75rem; }
    .badge-rejected { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.3); padding: 4px 10px; border-radius: 20px; font-weight: 700; font-size: 0.75rem; }
    .badge-conditional { background: rgba(245,158,11,0.15); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); padding: 4px 10px; border-radius: 20px; font-weight: 700; font-size: 0.75rem; }

    .filter-tabs { display: flex; gap: 10px; margin-bottom: 20px; }
    .ft-tab { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px 18px; color: var(--text-secondary); text-decoration: none; font-weight: 700; font-size: 0.85rem; }
    .ft-tab.active { background: #6366f1; color: #fff; border-color: #6366f1; }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ KALİTE KONTROL & GÜVENCE</div>

      <div class="mss-group-title">📊 KONTROL PANELİ</div>
      <div class="mss-sub">
        <a href="/quality/analytics" class="mss-sub-link">📊 Kalite Analitiği & Özet</a>
      </div>

      <div class="mss-group-title">🔍 MUAYENE & KONTROL</div>
      <div class="mss-sub">
        <a href="/quality/inspections" class="mss-sub-link active">📥 Giriş / Proses / Final Muayeneleri</a>
        <a href="/quality/inspections/add" class="mss-sub-link">➕ Yeni Muayene Kaydı</a>
      </div>

      <div class="mss-group-title">⚠️ UYGUNSUZLUK & AKSİYON</div>
      <div class="mss-sub">
        <a href="/quality/ncr" class="mss-sub-link">⚠️ Uygunsuzluk Yönetimi (NCR)</a>
        <a href="/quality/capa" class="mss-sub-link">🛠️ Düzeltici & Önleyici Faaliyet (CAPA)</a>
      </div>

      <div class="mss-group-title">🌳 İZLENEBİLİRLİK & KALİBRASYON</div>
      <div class="mss-sub">
        <a href="/quality/traceability" class="mss-sub-link">🌳 Lot/Seri Soyağacı İzlenebilirlik</a>
        <a href="/quality/equipment" class="mss-sub-link">📏 Ölçüm Cihazı Kalibrasyon Takibi</a>
        <a href="/quality/documents" class="mss-sub-link">📜 ISO Kalite Belgeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link active">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/quality/analytics" class="msn-link">📊 Özet Panel</a>
        <a href="/quality/inspections" class="msn-link active">🔍 Muayene Kayıtları</a>
        <a href="/quality/ncr" class="msn-link">⚠️ Uygunsuzluk (NCR)</a>
        <a href="/quality/capa" class="msn-link">🛠️ Aksiyon (CAPA)</a>
        <a href="/quality/traceability" class="msn-link">🌳 Lot İzlenebilirlik</a>
        <a href="/quality/equipment" class="msn-link">📏 Kalibrasyon Takibi</a>
        <a href="/quality/documents" class="msn-link">📜 ISO Belgeleri</a>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
          <h1>Giriş, Proses ve Final Kalite Muayene Kayıtları</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">Lot/Seri bazında kabul, şartlı kabul ve ret işlemleri.</p>
        </div>
        <a href="/quality/inspections/add" class="btn-indigo-gradient" style="text-decoration: none; padding: 10px 20px; font-weight: 700; border-radius: 10px; color: #fff; background: linear-gradient(135deg, #6366f1, #4f46e5);">
          ➕ Yeni Muayene Kaydı Oluştur
        </a>
      </div>

      <!-- Filter Tabs -->
      <div class="filter-tabs">
        <a href="/quality/inspections" class="ft-tab <%= !currentType ? 'active' : '' %>">Tüm Muayeneler (<%= inspections.length %>)</a>
        <a href="/quality/inspections?type=Incoming" class="ft-tab <%= currentType === 'Incoming' ? 'active' : '' %>">📥 Giriş Kalite (IQC)</a>
        <a href="/quality/inspections?type=InProcess" class="ft-tab <%= currentType === 'InProcess' ? 'active' : '' %>">🔄 Proses Kontrol (IPQC)</a>
        <a href="/quality/inspections?type=Final" class="ft-tab <%= currentType === 'Final' ? 'active' : '' %>">🏁 Final Kontrol (FQC)</a>
      </div>

      <!-- Inspections Table -->
      <div style="background: var(--bg-surface); border: 1px solid var(--border); border-radius: 18px; padding: 24px; box-shadow: var(--shadow-sm);">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border); color: var(--text-muted); font-size: 0.8rem;">
              <th style="padding: 12px 10px;">Muayene Kodu</th>
              <th style="padding: 12px 10px;">Kontrol Tipi</th>
              <th style="padding: 12px 10px;">Malzeme / Ürün</th>
              <th style="padding: 12px 10px;">Lot / Parti No</th>
              <th style="padding: 12px 10px;">Numune / Kabul / Ret</th>
              <th style="padding: 12px 10px;">Uzman / Kontrolör</th>
              <th style="padding: 12px 10px;">Karar</th>
            </tr>
          </thead>
          <tbody>
            <% inspections.forEach(insp => { %>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.86rem;">
                <td style="padding: 14px 10px; font-weight: 800; color: #818cf8; font-family: 'JetBrains Mono', monospace;"><%= insp.inspectionNo %></td>
                <td style="padding: 14px 10px;">
                  <% if (insp.type === 'Incoming') { %><span style="color: #38bdf8; font-weight: 700;">📥 Giriş (IQC)</span><% } %>
                  <% if (insp.type === 'InProcess') { %><span style="color: #a78bfa; font-weight: 700;">🔄 Proses (IPQC)</span><% } %>
                  <% if (insp.type === 'Final') { %><span style="color: #34d399; font-weight: 700;">🏁 Final (FQC)</span><% } %>
                </td>
                <td style="padding: 14px 10px; font-weight: 600;"><%= insp.stockItem ? insp.stockItem.name : '-' %></td>
                <td style="padding: 14px 10px; font-family: 'JetBrains Mono', monospace;"><%= insp.lotNumber || '-' %></td>
                <td style="padding: 14px 10px;">
                  <strong><%= insp.sampleSize %></strong> N. / <span style="color: #34d399; font-weight: 700;"><%= insp.passedQuantity %> K.</span> / <span style="color: #f87171; font-weight: 700;"><%= insp.rejectedQuantity %> R.</span>
                </td>
                <td style="padding: 14px 10px;"><%= insp.inspectorName || '-' %></td>
                <td style="padding: 14px 10px;">
                  <% if (insp.decision === 'Accepted') { %><span class="badge-accepted">✓ Kabul</span><% } %>
                  <% if (insp.decision === 'Conditional_Accept') { %><span class="badge-conditional">⚡ Şartlı Kabul</span><% } %>
                  <% if (insp.decision === 'Rejected') { %><span class="badge-rejected">✕ Red</span><% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
