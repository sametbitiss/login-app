<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeni NCR Uygunsuzluk Raporu — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    .form-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 28px;
      box-shadow: var(--shadow-sm);
      max-width: 900px;
    }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-bottom: 20px;
    }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group.full-width { grid-column: span 2; }
    .form-group label { font-size: 0.82rem; font-weight: 700; color: var(--text-secondary); }
    .form-group input, .form-group select, .form-group textarea {
      background: #090e1a;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 14px;
      color: var(--text-primary);
      font-size: 0.88rem;
      outline: none;
    }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ KALİTE KONTROL & GÜVENCE</div>

      <div class="mss-group-title">📊 KONTROL PANELİ</div>
      <div class="mss-sub">
        <a href="/quality/analytics" class="mss-sub-link">📊 Kalite Analitiği & Özet</a>
      </div>

      <div class="mss-group-title">🔍 MUAYENE & KONTROL</div>
      <div class="mss-sub">
        <a href="/quality/inspections" class="mss-sub-link">📥 Giriş / Proses / Final Muayeneleri</a>
        <a href="/quality/inspections/add" class="mss-sub-link">➕ Yeni Muayene Kaydı</a>
      </div>

      <div class="mss-group-title">⚠️ UYGUNSUZLUK & AKSİYON</div>
      <div class="mss-sub">
        <a href="/quality/ncr" class="mss-sub-link">⚠️ Uygunsuzluk Yönetimi (NCR)</a>
        <a href="/quality/ncr/add" class="mss-sub-link active">➕ Yeni NCR Kaydı</a>
        <a href="/quality/capa" class="mss-sub-link">🛠️ Düzeltici & Önleyici Faaliyet (CAPA)</a>
      </div>

      <div class="mss-group-title">🌳 İZLENEBİLİRLİK & KALİBRASYON</div>
      <div class="mss-sub">
        <a href="/quality/traceability" class="mss-sub-link">🌳 Lot/Seri Soyağacı İzlenebilirlik</a>
        <a href="/quality/equipment" class="mss-sub-link">📏 Ölçüm Cihazı Kalibrasyon Takibi</a>
        <a href="/quality/documents" class="mss-sub-link">📜 ISO Kalite Belgeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link">Sistem Yönetimi</a><a href="/admin/logs" class="mt-link">📜 İşlem Logları</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link active">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div class="page-header">
        <div>
          <h1>Yeni NCR Uygunsuzluk Raporu Aç</h1>
          <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">Hatalı ürün, malzeme veya süreç sapmalarını kaydet ve fiziki karantina kararı belirle.</p>
        </div>
      </div>

      <div class="form-card">
        <form action="/quality/ncr/add" method="POST">
          <div class="form-grid">
            <div class="form-group full-width">
              <label>Uygunsuzluk Başlığı *</label>
              <input type="text" name="title" placeholder="Örn: Tedarikçi Hammadde Tolerans Aşımı" required>
            </div>

            <div class="form-group">
              <label>Uygunsuzluk Tipi *</label>
              <select name="type" required>
                <option value="Supplier_Defect">🏭 Tedarikçi Hatası (Gelen Parça)</option>
                <option value="Process">🔄 Üretim Süreç Hasılası</option>
                <option value="Material">📦 Depo / Stok Malzeme Hasarı</option>
                <option value="Customer_Return">🚗 Müşteri Şikayeti / İadesi</option>
              </select>
            </div>

            <div class="form-group">
              <label>Şiddet / Etki Derecesi *</label>
              <select name="severity" required>
                <option value="Major">🟡 Majör (Süreç Durdurucu / Yeniden İşleme)</option>
                <option value="Critical">🔴 Kritik (Sevk Riski / Güvenlik)</option>
                <option value="Minor">🔵 Minör (Hafif Sapma)</option>
              </select>
            </div>

            <div class="form-group">
              <label>Stok Malzemesi</label>
              <select name="stockItemId">
                <option value="">-- Seçiniz --</option>
                <% stockItems.forEach(item => { %>
                  <option value="<%= item.id %>"><%= item.stockCode %> — <%= item.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="form-group">
              <label>Lot / Parti No</label>
              <input type="text" name="lotNumber" placeholder="Örn: LOT-2026-A101">
            </div>

            <div class="form-group">
              <label>Etkilenen Miktar *</label>
              <input type="number" name="quantityAffected" value="10" min="1" required>
            </div>

            <div class="form-group">
              <label>Karar / Aksiyon (Disposition) *</label>
              <select name="disposition" required>
                <option value="ReturnToSupplier">Tedarikçiye İade Et</option>
                <option value="Rework">Yeniden İşle (Rework / Düzeltme)</option>
                <option value="Scrap">Hurdaya Ayır / İptal Et</option>
                <option value="UseAsIs">Sapmalı Kullanım (Şartlı)</option>
              </select>
            </div>

            <div class="form-group">
              <label>Tespit Eden Personel *</label>
              <input type="text" name="detectedBy" value="<%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %>" required>
            </div>

            <div class="form-group">
              <label>Atanan Sorumlu Birim / Kişi *</label>
              <input type="text" name="assignedTo" placeholder="Örn: Satın Alma & Kalite Güvence" required>
            </div>

            <div class="form-group full-width">
              <label>Detaylı Hata / Sapma Açıklaması *</label>
              <textarea name="description" rows="3" placeholder="Uygunsuzluğun kök neden taslağı ve fiziki durumu..." required></textarea>
            </div>
          </div>

          <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <a href="/quality/ncr" class="btn-secondary" style="text-decoration: none; padding: 10px 20px;">İptal</a>
            <button type="submit" class="btn-indigo-gradient" style="padding: 10px 24px; font-weight: 700; border-radius: 10px; color: #fff; background: linear-gradient(135deg, #ef4444, #dc2626); border: none; cursor: pointer;">
              ⚠️ NCR Kaydını Kaydet
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
