<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Düzeltici ve Önleyici Faaliyetler (CAPA) — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .capa-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 20px;
    }
    .capa-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border);
    }
    .capa-title { font-size: 1.1rem; font-weight: 800; color: var(--text-primary); }
    .capa-code { font-family: 'JetBrains Mono', monospace; color: #a78bfa; font-weight: 800; }
    .capa-box {
      background: #090e1a;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 12px;
    }
    .capa-box-title { font-size: 0.8rem; font-weight: 800; color: #818cf8; margin-bottom: 4px; text-transform: uppercase; }
    .capa-box-text { font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5; }
  </style>
</head>
<body class="module-body">
  <aside class="module-sidebar">
    <div class="module-sidebar-brand">
      <a href="/" class="msb-logo">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="url(#bGrad)"/><path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><defs><linearGradient id="bGrad" x1="0" y1="0" x2="32" y2="32"><stop offset="0%" stop-color="#6366f1"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs></svg>
        <span>Enterprise ERP</span>
      </a>
    </div>

    <div class="module-sidebar-section">
      <div class="mss-label">🛡️ KALİTE KONTROL & GÜVENCE</div>

      <div class="mss-group-title">📊 KONTROL PANELİ</div>
      <div class="mss-sub">
        <a href="/quality/analytics" class="mss-sub-link">📊 Kalite Analitiği & Özet</a>
      </div>

      <div class="mss-group-title">🔍 MUAYENE & KONTROL</div>
      <div class="mss-sub">
        <a href="/quality/inspections" class="mss-sub-link">📥 Giriş / Proses / Final Muayeneleri</a>
        <a href="/quality/inspections/add" class="mss-sub-link">➕ Yeni Muayene Kaydı</a>
      </div>

      <div class="mss-group-title">⚠️ UYGUNSUZLUK & AKSİYON</div>
      <div class="mss-sub">
        <a href="/quality/ncr" class="mss-sub-link">⚠️ Uygunsuzluk Yönetimi (NCR)</a>
        <a href="/quality/ncr/add" class="mss-sub-link">➕ Yeni NCR Kaydı</a>
        <a href="/quality/capa" class="mss-sub-link active">🛠️ Düzeltici & Önleyici Faaliyet (CAPA)</a>
      </div>

      <div class="mss-group-title">🌳 İZLENEBİLİRLİK & KALİBRASYON</div>
      <div class="mss-sub">
        <a href="/quality/traceability" class="mss-sub-link">🌳 Lot/Seri Soyağacı İzlenebilirlik</a>
        <a href="/quality/equipment" class="mss-sub-link">📏 Ölçüm Cihazı Kalibrasyon Takibi</a>
        <a href="/quality/documents" class="mss-sub-link">📜 ISO Kalite Belgeleri</a>
      </div>
    </div>

    <div class="module-sidebar-user">
      <div class="msu-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <div class="msu-meta">
        <strong><%= user.firstName ? user.firstName + ' ' + user.lastName : user.username %></strong>
        <span><%= user.role %></span>
      </div>
    </div>
  </aside>

  <div class="module-main">
    <header class="module-topbar">
      <div class="mt-left">
        <a href="/" class="mt-link">Ana Sayfa</a>
        <a href="/admin" class="mt-link">Sistem Yönetimi</a>
        <a href="/stock" class="mt-link">Stok & Depo</a>
        <a href="/sales" class="mt-link">Satış Yönetimi</a>
        <a href="/purchase" class="mt-link">Satın Alma</a>
        <a href="/production" class="mt-link">Üretim Planlama</a>
        <a href="/quality" class="mt-link active">Kalite Kontrol</a>
      </div>
      <div class="mt-right">
        <span class="mt-time" id="liveTime"></span>
        <a href="/logout" class="mt-logout" title="Çıkış">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
      </div>
    </header>

    <main class="module-content">
      <div class="module-subnav">
        <a href="/quality/analytics" class="msn-link">📊 Özet Panel</a>
        <a href="/quality/inspections" class="msn-link">🔍 Muayene Kayıtları</a>
        <a href="/quality/ncr" class="msn-link">⚠️ Uygunsuzluk (NCR)</a>
        <a href="/quality/capa" class="msn-link active">🛠️ Aksiyon (CAPA)</a>
        <a href="/quality/traceability" class="msn-link">🌳 Lot İzlenebilirlik</a>
        <a href="/quality/equipment" class="msn-link">📏 Kalibrasyon Takibi</a>
        <a href="/quality/documents" class="msn-link">📜 ISO Belgeleri</a>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
          <h1>Düzeltici ve Önleyici Faaliyetler (CAPA)</h1>
          <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 4px;">5-Why kök neden analizi, kalıcı aksiyon planları ve tekrarlamayı önleme takibi.</p>
        </div>
      </div>

      <% capas.forEach(capa => { %>
        <div class="capa-card">
          <div class="capa-header">
            <div>
              <span class="capa-code"><%= capa.capaNo %></span>
              <span style="font-size: 0.8rem; color: var(--text-muted); margin-left: 8px;">(İlişkili NCR: <%= capa.ncr ? capa.ncr.ncrNo : 'Genel' %>)</span>
              <div class="capa-title" style="margin-top: 4px;"><%= capa.title %></div>
            </div>
            <div style="text-align: right;">
              <span style="background: rgba(139,92,246,0.15); color: #a78bfa; border: 1px solid rgba(139,92,246,0.3); padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.8rem;">
                <%= capa.status %>
              </span>
              <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 6px;">Hedef Tarih: <strong><%= capa.targetDate || 'Belirtilmedi' %></strong></div>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;">
            <div class="capa-box">
              <div class="capa-box-title">🔍 Kök Neden Analizi (<%= capa.rootCauseMethod %>)</div>
              <div class="capa-box-text"><%= capa.rootCauseDescription || 'Analiz aşamasında...' %></div>
            </div>

            <div class="capa-box">
              <div class="capa-box-title">⚡ Düzeltici Aksiyon (Immediate Action)</div>
              <div class="capa-box-text"><%= capa.correctiveAction || 'Aksiyon tanımlanmadı.' %></div>
            </div>

            <div class="capa-box">
              <div class="capa-box-title">🛡️ Önleyici Faaliyet (Preventive Action)</div>
              <div class="capa-box-text"><%= capa.preventiveAction || 'Uzun vadeli önlem belirlenmedi.' %></div>
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 12px; font-size: 0.82rem; color: var(--text-muted);">
            <div>Sorumlu: <strong><%= capa.assignedTo %></strong></div>
            <div>Doğrulayan Kalite Yöneticisi: <strong><%= capa.verifiedBy %></strong></div>
          </div>
        </div>
      <% }); %>
    </main>
  </div>

  <script>
    function updateClock() { const now = new Date(); const el = document.getElementById('liveTime'); if (el) el.textContent = now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long' }) + ' • ' + now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }); }
    updateClock(); setInterval(updateClock, 1000);
  </script>
</body>
</html>
