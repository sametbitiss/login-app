<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Doğrulama Kodu — Enterprise ERP</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    .otp-inputs-wrapper {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin: 1.5rem 0 1.25rem 0;
    }
    .otp-digit {
      width: 48px;
      height: 58px;
      font-size: 1.6rem;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 800;
      text-align: center;
      color: #fff;
      background: rgba(15, 23, 42, 0.85);
      border: 2px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      outline: none;
    }
    .otp-digit:focus {
      border-color: #818cf8;
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
      background: rgba(30, 41, 59, 0.95);
      transform: translateY(-2px);
    }
    .otp-digit.filled {
      border-color: #6366f1;
      background: rgba(99, 102, 241, 0.1);
    }
    .otp-digit:disabled {
      background: rgba(15, 23, 42, 0.5);
      border-color: rgba(255, 255, 255, 0.05);
      color: var(--text-muted);
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }
    .timer-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 10px 18px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }
    .timer-badge {
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700;
      font-size: 1.05rem;
      color: #34d399;
      letter-spacing: 1px;
    }
    .timer-badge.warning {
      color: #fbbf24;
    }
    .timer-badge.danger {
      color: #f43f5e;
      animation: pulse 1s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .progress-bar-bg {
      width: 100%;
      height: 4px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 6px;
    }
    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #10b981, #6366f1);
      width: 100%;
      transition: width 1s linear, background 0.3s ease;
    }
  </style>
</head>
<body class="login-body">

  <!-- Animated Background Mesh -->
  <div class="bg-mesh" aria-hidden="true">
    <div class="mesh-orb mesh-orb--1"></div>
    <div class="mesh-orb mesh-orb--2"></div>
    <div class="mesh-orb mesh-orb--3"></div>
    <div class="mesh-grid"></div>
  </div>

  <div class="login-wrapper">
    <div class="login-card" style="max-width: 460px;">

      <!-- Header Icon -->
      <div class="login-header">
        <div class="login-brand-icon" style="background: linear-gradient(135deg, #10b981 0%, #6366f1 100%); box-shadow: 0 0 30px rgba(16, 185, 129, 0.35);">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h1 class="login-title" style="letter-spacing: -0.5px;">Güvenlik Doğrulaması</h1>
        <p class="login-subtitle">
          Doğrulama kodu <strong><%= maskedEmail %></strong> adresinize iletildi.
        </p>
      </div>

      <!-- Success Notification Alert -->
      <div id="resendSuccessAlert" style="<%= (typeof success !== 'undefined' && success) ? 'display: flex;' : 'display: none;' %> background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); border-radius: 12px; padding: 12px 16px; margin-bottom: 1.25rem; align-items: center; gap: 10px; font-size: 0.85rem; color: #34d399; font-weight: 600;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span id="resendSuccessText">Yeni 6 haneli doğrulama kodu e-postanıza gönderildi!</span>
      </div>

      <!-- Error Alert -->
      <% if (error) { %>
        <div class="error" id="errorAlertBox" style="margin-bottom: 1.25rem; border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; gap: 10px; font-size: 0.85rem; font-weight: 600;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="errorAlertText"><%= error %></span>
        </div>
      <% } %>

      <!-- Expired Notice Banner -->
      <div id="expiredWarningBanner" style="display: none; background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 12px; padding: 12px 16px; margin-bottom: 1.25rem; align-items: center; gap: 10px; font-size: 0.85rem; color: #f43f5e; font-weight: 700;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>⏱️ 1 dakikalık doğrulama süreniz doldu! Lütfen aşağıdaki butondan yeni kod talep ediniz.</span>
      </div>

      <!-- Verification Form -->
      <form action="/login/verify" method="POST" id="verifyOtpForm">
        <input type="hidden" name="userId" id="userIdInput" value="<%= userId %>">
        <input type="hidden" name="code" id="fullCodeInput" value="">

        <!-- 6 OTP Input Boxes -->
        <div class="otp-inputs-wrapper">
          <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" id="otp-1" data-index="1" autofocus autocomplete="off">
          <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" id="otp-2" data-index="2" autocomplete="off">
          <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" id="otp-3" data-index="3" autocomplete="off">
          <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" id="otp-4" data-index="4" autocomplete="off">
          <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" id="otp-5" data-index="5" autocomplete="off">
          <input type="text" maxlength="1" inputmode="numeric" class="otp-digit" id="otp-6" data-index="6" autocomplete="off">
        </div>

        <!-- 60-Second Live Countdown Widget -->
        <div class="timer-container">
          <div style="display: flex; align-items: center; gap: 8px; flex: 1;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--text-muted);"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Kalan Süre:</span>
            <span class="timer-badge" id="timerDisplay">01:00</span>
          </div>
          <div style="font-size: 0.75rem; color: var(--text-muted);" id="timerStatusLabel">Geçerli</div>
        </div>
        <div class="progress-bar-bg" style="margin-top: -1rem; margin-bottom: 1.5rem;">
          <div class="progress-bar-fill" id="timerProgressBar"></div>
        </div>

        <!-- Confirm Login Button -->
        <button type="submit" id="btnSubmitVerify" class="btn btn-lg" style="width: 100%; padding: 13px; font-size: 0.95rem; font-weight: 700; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #fff; border: none; border-radius: 12px; box-shadow: 0 4px 20px rgba(16, 185, 129, 0.35); gap: 10px; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Girişi Onayla</span>
        </button>
      </form>

      <!-- Resend Code Form / Button -->
      <div style="margin-top: 1.25rem; text-align: center;">
        <button type="button" id="btnResendCode" onclick="handleResendCode()" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15); color: #818cf8; font-weight: 700; font-size: 0.85rem; padding: 10px 18px; border-radius: 10px; cursor: pointer; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 8px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          <span>Tekrar Doğrulama Kodu Gönder</span>
        </button>
      </div>

      <!-- Back to Login Navigation -->
      <div style="margin-top: 1.75rem; text-align: center; border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 1.25rem;">
        <a href="/login" style="color: var(--text-muted); font-size: 0.825rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 600;" onmouseover="this.style.color='#fff';" onmouseout="this.style.color='var(--text-muted)';">
          <span>←</span> Farklı bir kullanıcı adı ile giriş yap
        </a>
      </div>

    </div>
  </div>

  <script>
    let timeLeft = parseInt('<%= typeof remainingSeconds !== "undefined" ? remainingSeconds : 60 %>', 10);
    if (isNaN(timeLeft) || timeLeft <= 0) timeLeft = 0;

    const totalDuration = 60; // 1 Dakika
    let timerInterval = null;

    const timerDisplay = document.getElementById('timerDisplay');
    const timerProgressBar = document.getElementById('timerProgressBar');
    const timerStatusLabel = document.getElementById('timerStatusLabel');
    const expiredBanner = document.getElementById('expiredWarningBanner');
    const btnSubmit = document.getElementById('btnSubmitVerify');
    const btnResend = document.getElementById('btnResendCode');
    const otpInputs = document.querySelectorAll('.otp-digit');
    const fullCodeInput = document.getElementById('fullCodeInput');
    const verifyForm = document.getElementById('verifyOtpForm');

    // 1. Timer Logic
    function updateTimerUI() {
      const minutes = Math.floor(timeLeft / 60);
      const seconds = timeLeft % 60;
      const formattedTime = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
      
      if (timerDisplay) timerDisplay.textContent = formattedTime;

      const progressPercent = Math.max(0, (timeLeft / totalDuration) * 100);
      if (timerProgressBar) timerProgressBar.style.width = `${progressPercent}%`;

      if (timeLeft <= 0) {
        // Süre Doldu Durumu
        if (timerDisplay) {
          timerDisplay.textContent = '00:00';
          timerDisplay.className = 'timer-badge danger';
        }
        if (timerStatusLabel) timerStatusLabel.textContent = 'Süre Doldu ❌';
        if (expiredBanner) expiredBanner.style.display = 'flex';
        
        // Inputları ve Giriş Butonunu Kilitle
        otpInputs.forEach(inp => inp.disabled = true);
        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.style.opacity = '0.5';
          btnSubmit.style.cursor = 'not-allowed';
        }

        // Tekrar Kod Gönder Butonunu Parlat
        if (btnResend) {
          btnResend.style.background = 'linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)';
          btnResend.style.color = '#fff';
          btnResend.style.boxShadow = '0 0 20px rgba(99, 102, 241, 0.4)';
          btnResend.style.borderColor = 'transparent';
        }

        clearInterval(timerInterval);
      } else if (timeLeft <= 15) {
        if (timerDisplay) timerDisplay.className = 'timer-badge danger';
        if (timerProgressBar) timerProgressBar.style.background = 'linear-gradient(90deg, #f43f5e, #fb7185)';
        if (timerStatusLabel) timerStatusLabel.textContent = 'Bitiyor ⚠️';
      } else if (timeLeft <= 30) {
        if (timerDisplay) timerDisplay.className = 'timer-badge warning';
        if (timerProgressBar) timerProgressBar.style.background = 'linear-gradient(90deg, #fbbf24, #f59e0b)';
        if (timerStatusLabel) timerStatusLabel.textContent = 'Geçerli';
      } else {
        if (timerDisplay) timerDisplay.className = 'timer-badge';
        if (timerProgressBar) timerProgressBar.style.background = 'linear-gradient(90deg, #10b981, #6366f1)';
        if (timerStatusLabel) timerStatusLabel.textContent = 'Geçerli';
      }
    }

    function startCountdown() {
      if (timerInterval) clearInterval(timerInterval);
      updateTimerUI();
      if (timeLeft > 0) {
        timerInterval = setInterval(() => {
          timeLeft--;
          updateTimerUI();
        }, 1000);
      }
    }

    // 2. OTP Input Navigation & Paste Handling
    otpInputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value;
        // Sadece rakam kabul et
        if (!/^\d$/.test(val)) {
          e.target.value = '';
          return;
        }

        e.target.classList.add('filled');

        // Otomatik bir sonraki kutuya geç
        if (index < otpInputs.length - 1) {
          otpInputs[index + 1].focus();
        }

        syncFullCode();
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace') {
          if (!input.value && index > 0) {
            otpInputs[index - 1].focus();
            otpInputs[index - 1].value = '';
            otpInputs[index - 1].classList.remove('filled');
          } else {
            input.value = '';
            input.classList.remove('filled');
          }
          syncFullCode();
        } else if (e.key === 'ArrowLeft' && index > 0) {
          otpInputs[index - 1].focus();
        } else if (e.key === 'ArrowRight' && index < otpInputs.length - 1) {
          otpInputs[index + 1].focus();
        }
      });

      // Yapıştırma (Paste) Desteği
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim();
        if (/^\d{6}$/.test(pasteData)) {
          pasteData.split('').forEach((char, i) => {
            if (otpInputs[i]) {
              otpInputs[i].value = char;
              otpInputs[i].classList.add('filled');
            }
          });
          otpInputs[otpInputs.length - 1].focus();
          syncFullCode();
        }
      });
    });

    function syncFullCode() {
      let code = '';
      otpInputs.forEach(inp => code += inp.value);
      if (fullCodeInput) fullCodeInput.value = code;

      // 6 hane dolduğunda otomatik submit opsiyonu
      if (code.length === 6 && timeLeft > 0) {
        verifyForm.submit();
      }
    }

    if (verifyForm) {
      verifyForm.addEventListener('submit', (e) => {
        syncFullCode();
        if (timeLeft <= 0) {
          e.preventDefault();
          alert('⏱️ Doğrulama kodunuzun süresi dolmuştur. Lütfen yeni kod isteyiniz.');
          return false;
        }
        if (!fullCodeInput.value || fullCodeInput.value.length !== 6) {
          e.preventDefault();
          alert('⚠️ Lütfen 6 haneli doğrulama kodunu eksiksiz giriniz.');
          return false;
        }
      });
    }

    // 3. Tekrar Kod Gönder AJAX
    async function handleResendCode() {
      const userId = document.getElementById('userIdInput').value;
      if (!userId) return;

      btnResend.disabled = true;
      btnResend.innerHTML = `<span>Gönderiliyor...</span>`;

      try {
        const response = await fetch('/login/resend', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ userId })
        });

        const data = await response.json();
        if (data.success) {
          // Başarı Uyarısı Göster
          const successBox = document.getElementById('resendSuccessAlert');
          const successText = document.getElementById('resendSuccessText');
          if (successBox) {
            if (successText) successText.textContent = data.message || 'Yeni doğrulama kodu e-postanıza iletildi!';
            successBox.style.display = 'flex';
          }
          if (expiredBanner) expiredBanner.style.display = 'none';

          // Inputları ve butonu tekrar aktif et
          otpInputs.forEach(inp => {
            inp.disabled = false;
            inp.value = '';
            inp.classList.remove('filled');
          });
          if (otpInputs[0]) otpInputs[0].focus();

          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.style.opacity = '1';
            btnSubmit.style.cursor = 'pointer';
          }

          // Sayacı 60 saniyeye sıfırla ve yeniden başlat
          timeLeft = 60;
          startCountdown();

          btnResend.style.background = 'rgba(255, 255, 255, 0.05)';
          btnResend.style.color = '#818cf8';
          btnResend.style.boxShadow = 'none';
          btnResend.style.borderColor = 'rgba(255, 255, 255, 0.15)';
          btnResend.innerHTML = `
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            <span>Tekrar Doğrulama Kodu Gönder</span>
          `;
          btnResend.disabled = false;
        } else {
          alert('Hata: ' + (data.message || 'Kod gönderilemedi.'));
          btnResend.disabled = false;
          btnResend.innerHTML = `<span>Tekrar Dene</span>`;
        }
      } catch (err) {
        alert('Bağlantı hatası oluştu. Lütfen sayfayı yenileyiniz.');
        btnResend.disabled = false;
        btnResend.innerHTML = `<span>Tekrar Dene</span>`;
      }
    }

    // Başlangıçta sayacı ve ilk input odağını tetikle
    window.addEventListener('DOMContentLoaded', () => {
      startCountdown();
      if (otpInputs[0] && !otpInputs[0].disabled) {
        otpInputs[0].focus();
      }
    });
  </script>
</body>
</html>
